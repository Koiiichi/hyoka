# ==========================================
# hyōka — .gitignore
# ==========================================

# --- OS Artifacts ---
.DS_Store
Thumbs.db
*.swp

# --- Python Artifacts ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# --- Environments & Secrets ---
.venv/
venv/
ENV/
env/
.env
.env.local
.env.*
*.pem
*.key
credentials.json

# --- IDEs ---
.vscode/
.idea/

# --- Harbor raw job output (large; curated pilots kept in logs/) ---
archive/
jobs/

# --- Agent-internal guidance files (not for public consumption) ---
assets/BRAND.md
docs/AGENT_DELEGATION.md
docs/SETUP_GUIDE.md
report/OUTLINE.md

# --- Reference PDFs (copyright; not redistributable) ---
docs/Task_ref.pdf
docs/reference-reports/

# --- Temporary local test artifacts ---
samples/**/environment/data/generated_logs/
/tmp/
