           malicious_ids.add(eid)\n            continue\n            \n    # 3. PowerShell Operational logs on WS-05\n    if code in (800, 4103, 4104):\n        if host == \'WS-05.corp.example\':\n            malicious_ids.add(eid)\n            continue\n            \n    # 4. Security auditing logs & WMI logs\n    # We match using hex PIDs (for Security logs) or dec PIDs (for other logs like WMI / WFP)\n    if host == \'WS-05.corp.example\':\n        text_to_search = "\\n".join(filter(None, [\n            row[\'message\'],\n            row[\'details\'],\n            row[\'command_line\']\n        ]))\n        if hex_pat.search(text_to_search) or dec_pat.search(text_to_search):\n            malicious_ids.add(eid)\n            continue\n\n# Sort findings\nfindings_list = sorted(list(malicious_ids))\nprint(f"Total findings: {len(findings_list)}")\n\nwith open(\'/root/findings.json\', \'w\') as f:\n    json.dump(findings_list, f)\n\nEOF\npython3 /tmp/compile_findings.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
