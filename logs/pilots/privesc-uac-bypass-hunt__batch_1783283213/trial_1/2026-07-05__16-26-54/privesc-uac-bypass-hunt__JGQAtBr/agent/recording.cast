[324.363276, "i", "cat << 'EOF' > /tmp/check_4689.py\nimport sqlite3\nimport re\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE event_code = 4689 AND host = 'WS-05.corp.example';\")\naudit_events = cursor.fetchall()\n\nmal_pids_hex = {'0x560', '0x1468', '0x1b6c', '0x1e8c', '0xf60', '0x1a24', '0xe40', '0x1350', '0x1968'}\nhex_pat = re.compile(r'\\b(' + '|'.join(mal_pids_hex) + r')\\b', re.IGNORECASE)\n\nfor row in audit_events:\n    msg = row['message'] if row['message'] else ''\n    if not hex_pat.search(msg):\n        continue\n    pname = None\n    for line in msg.split('\\n'):\n        if 'Process Name:' in line:\n            pname = line.split('Process Name:')[1].strip()\n    print(f\"4689 Match: {row['event_id']} | Process: {pname}\")\n\nEOF\npython3 /tmp/check_4689.py\n"]
