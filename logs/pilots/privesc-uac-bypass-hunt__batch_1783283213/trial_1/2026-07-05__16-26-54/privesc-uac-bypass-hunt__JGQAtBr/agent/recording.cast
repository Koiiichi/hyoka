[152.00664, "i", "cat << 'EOF' >> /tmp/hunt_all.py\n\n# Let's check PowerShell events (800, 4103, 4104)\nps_events = [row for row in all_events if row['event_code'] in (800, 4103, 4104)]\nprint(f\"Total PowerShell events: {len(ps_events)}\")\n\n# Let's inspect their host applications or context to see if any are benign\nbenign_ps_events = []\nfor row in ps_events:\n    msg = row['message'] if row['message'] else ''\n    # Check if this event does NOT contain our malicious indicators\n    # Every single one we saw earlier had the stager command line, or was part of the stager execution.\n    # Let's print out unique HostApplication lines in these logs\n    pass\n\nEOF\npython3 /tmp/hunt_all.py\n"]
