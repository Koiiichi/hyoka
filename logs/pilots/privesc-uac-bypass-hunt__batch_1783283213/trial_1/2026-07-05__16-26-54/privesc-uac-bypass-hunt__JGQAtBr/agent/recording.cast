[223.718347, "i", "cat << 'EOF' > /tmp/get_pids.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmalicious_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}',\n    '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    '{3ddc5665-ed06-5f51-f202-000000000500}',\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\n# Let's search all events of code 1 and find their PIDs\ncursor.execute(\"SELECT event_id, process_guid, image, message FROM events WHERE event_code = 1;\")\nfor row in cursor.fetchall():\n    guid = row['process_guid']\n    if guid in malicious_guids:\n        # Parse ProcessId from message\n        msg = row['message']\n        pid = None\n        for line in msg.split('\\n'):\n            if line.startswith('ProcessId:'):\n                pid = int(line.split(':')[1].strip())\n        print(f\"{guid} | {row['image']} | PID: {pid} (Hex: {hex(pid) if pid else 'None'})\")\n\nEOF\npython3 /tmp/get_pids.py\n"]
[223.72036, "o", "cat << 'EOF' > /tmp/get_pids.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> malicious_guids = {\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-e80d-5f51-2501-000000000500}',\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed05-5f51-ed02-000000000500}',\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed05-5f51-f002-000000000500}',\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed06-5f51-f102-000000000500}',\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed08-5f51-f302-000000000500}',\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed04-5f51-eb02-000000000500}',\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed04-5f51-ec02-000000000500}',\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed06-5f51-f202-000000000500}',\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed2e-5f51-fc02-000000000500}'\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's search all events of code 1 and find their PIDs\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, process_guid, image, message FROM events WHERE event_code = 1;\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     guid = row['process_guid']\r\n\u001b[?2004l\r\u001b[?2004h>     if guid in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h>         # Parse ProcessId from message\r\n\u001b[?2004l\r\u001b[?2004h>         msg = row['message']\r\n\u001b[?2004l\r\u001b[?2004h>         pid = None\r\n\u001b[?2004l\r\u001b[?2004h>         for line in msg.split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h>             if line.startswith('ProcessId:'):\r\n\u001b[?2004l\r\u001b[?2004h>                 pid = int(line.split(':')[1].strip())\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"{guid} | {row['image']} | PID: {pid} (Hex: {hex(pid) if pid else 'None'})\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
