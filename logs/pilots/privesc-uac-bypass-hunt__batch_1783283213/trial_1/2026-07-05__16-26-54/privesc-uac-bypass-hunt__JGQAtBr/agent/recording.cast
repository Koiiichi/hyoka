[261.425442, "i", "cat << 'EOF' > /tmp/check_4703.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmal_pids_dec = {1376, 5224, 7020, 7820, 3936, 6692, 3648, 4944, 6504}\nmal_pids_hex = {'0x560', '0x1468', '0x1b6c', '0x1e8c', '0xf60', '0x1a24', '0xe40', '0x1350', '0x1968'}\n\nhex_pat = re.compile(r'\\b(' + '|'.join(mal_pids_hex) + r')\\b', re.IGNORECASE)\ndec_pat = re.compile(r'\\b(' + '|'.join(map(str, mal_pids_dec)) + r')\\b')\n\ncursor.execute(\"SELECT * FROM events WHERE event_code = 4703 AND host = 'WS-05.corp.example';\")\nfor row in cursor.fetchall():\n    text = \"\\n\".join(filter(None, [row['message'], row['details'], row['command_line']]))\n    if hex_pat.search(text) or dec_pat.search(text):\n        print(f\"Matched 4703: {row['event_id']} | {row['message'][:200]}\")\n\nEOF\npython3 /tmp/check_4703.py\n"]
