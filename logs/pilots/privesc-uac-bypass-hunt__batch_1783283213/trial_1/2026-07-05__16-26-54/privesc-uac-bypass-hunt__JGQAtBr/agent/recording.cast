[329.393721, "i", "cat << 'EOF' > /tmp/check_wfp.py\nimport sqlite3\nimport re\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE event_code IN (5156, 5158) AND host = 'WS-05.corp.example';\")\naudit_events = cursor.fetchall()\n\nmal_pids_dec = {1376, 5224, 7020, 7820, 3936, 6692, 3648, 4944, 6504}\ndec_pat = re.compile(r'\\b(' + '|'.join(map(str, mal_pids_dec)) + r')\\b')\n\nfor row in audit_events:\n    msg = row['message'] if row['message'] else ''\n    if dec_pat.search(msg):\n        print(f\"WFP Match: {row['event_id']} | {row['message'][:200]}\")\n\nEOF\npython3 /tmp/check_wfp.py\n"]
[329.394031, "o", "cat << 'EOF' > /tmp/check_wfp.py\r\n\u001b[?2004l\r"]
