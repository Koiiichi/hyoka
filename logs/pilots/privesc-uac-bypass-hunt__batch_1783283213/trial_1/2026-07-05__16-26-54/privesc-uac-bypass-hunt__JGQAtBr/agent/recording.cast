[274.309457, "i", "cat << 'EOF' > /tmp/check_event10.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmal_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}',\n    '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    '{3ddc5665-ed06-5f51-f202-000000000500}',\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\ncursor.execute(\"SELECT event_id, image, target_image, process_guid, parent_process_guid FROM events WHERE event_code = 10 AND host = 'WS-05.corp.example';\")\nevents10 = cursor.fetchall()\n\n# Let's count how many Event 10s have a malicious source vs target\nsrc_mal = 0\ntgt_mal = 0\nboth_mal = 0\nneither_mal = 0\n\nfor row in events10:\n    # In Event 10, 'image' is the Source Image, and 'target_image' is the Target Image.\n    # Let's check their GUIDs (or if they match the malicious processes)\n    # Wait, in Sysmon Event 10, 'process_guid' is the source process GUID, and there is also 'target_process_guid' which is in the message.\n    # Let's parse 'SourceProcessGuid' and 'TargetProcessGuid' from message.\n    msg = row['message']\n    src_guid = None\n    tgt_guid = None\n    for line in msg.split('\\n'):\n        if 'SourceProcessGuid:' in line:\n            src_guid = line.split(':')[1].strip()\n        if 'TargetProcessGuid:' in line:\n            tgt_guid = line.split(':')[1].strip()\n            \n    is_src_mal = src_guid in mal_guids\n    is_tgt_mal = tgt_guid in mal_guids\n    \n    if is_src_mal and is_tgt_mal:\n        both_mal += 1\n    elif is_src_mal:\n        src_mal += 1\n    elif is_tgt_mal:\n        tgt_mal += 1\n        # Print some to see who is accessing our malicious processes\n        print(f\"Benign-to-Mal: {row['event_id']} | Source: {row['image']} ({src_guid}) -> Target: {row['target_image']} ({tgt_guid})\")\n    else:\n        neither_mal += 1\n\nprint(f\"Src Malicious: {src_mal} | Tgt Malicious: {tgt_mal} | Both Malicious: {both_mal} | Neither Malicious: {neither_mal}\")\n\nEOF\npython3 /tmp/check_event10.py\n"]
