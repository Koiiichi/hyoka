[338.138901, "i", "sqlite3 /root/data/eventlogs.db \"SELECT event_id, host, event_code, message FROM events WHERE event_code IN (800, 4103, 4104) AND host != 'WS-05.corp.example';\"\n"]
[338.139837, "o", "sqlite3 /root/data/eventlogs.db \"SELECT event_id, host, event_code, message FROM events WHERE event_code IN (800, 4103, 4104) AND host != 'WS-05.corp.example';\"\r\n\u001b[?2004l\r"]
[338.146619, "o", "\u001b[?2004hroot@a99c1704c660:~# "]
[348.793668, "i", "cat << 'EOF' > /tmp/compile_findings.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Malicious GUIDs\nmal_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}',\n    '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    '{3ddc5665-ed06-5f51-f202-000000000500}',\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\n# Malicious PIDs\nmal_pids_dec = {1376, 5224, 7020, 7820, 3936, 6692, 3648, 4944, 6504}\nmal_pids_hex = {'0x560', '0x1468', '0x1b6c', '0x1e8c', '0xf60', '0x1a24', '0xe40', '0x1350', '0x1968'}\n\nhex_pat = re.compile(r'\\b(' + '|'.join(mal_pids_hex) + r')\\b', re.IGNORECASE)\ndec_pat = re.compile(r'\\b(' + '|'.join(map(str, mal_pids_dec)) + r')\\b')\n\ncursor.execute(\"SELECT * FROM events;\")\nall_events = cursor.fetchall()\n\nmalicious_ids = set()\n\nfor row in all_events:\n    eid = row['event_id']\n    code = row['event_code']\n    host = row['host']\n    channel = row['channel']\n    msg = row['message'] if row['message'] else ''\n    guid = row['process_guid']\n    parent_guid = row['parent_process_guid']\n    \n    # 1. Sysmon events (except 10)\n    if guid or parent_guid:\n        if code != 10:\n            if (guid in mal_guids) or (parent_guid in mal_guids):\n                malicious_ids.add(eid)\n                continue\n                \n    # 2. Sysmon Event 10 (Process Access) where Source is malicious\n    if code == 10:\n        src_guid = None\n        for line in msg.split('\\n'):\n            if 'SourceProcessGUID:' in line:\n                src_guid = line.split(':')[1].strip()\n        if src_guid in mal_guids:\n            malicious_ids.add(eid)\n            continue\n            \n    # 3. PowerShell Operational logs on WS-05\n    if code in (800, 4103, 4104):\n        if host == 'WS-05.corp.example':\n            malicious_ids.add(eid)\n            continue\n            \n    # 4. Security auditing logs & WMI logs\n    # We match using hex PIDs (for Security logs) or dec PIDs (for other logs like WMI / WFP)\n    if host == 'WS-05.corp.example':\n        text_to_search = \"\\n\".join(filter(None, [\n            row['message'],\n            row['details'],\n            row['command_line']\n        ]))\n        if hex_pat.search(text_to_search) or dec_pat.search(text_to_search):\n            malicious_ids.add(eid)\n            continue\n\n# Sort findings\nfindings_list = sorted(list(malicious_ids))\nprint(f\"Total findings: {len(findings_list)}\")\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(findings_list, f)\n\nEOF\npython3 /tmp/compile_findings.py\n"]
