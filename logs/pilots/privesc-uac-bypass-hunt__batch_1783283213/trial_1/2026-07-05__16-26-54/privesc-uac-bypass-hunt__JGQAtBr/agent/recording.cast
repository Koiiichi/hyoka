[165.444092, "i", "cat << 'EOF' > /tmp/hunt_all.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmalicious_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}'\n}\n\n# Recursively find child processes\ncursor.execute(\"SELECT * FROM events WHERE event_code = 1;\")\nproc_events = cursor.fetchall()\n\nadded = True\nwhile added:\n    added = False\n    for row in proc_events:\n        guid = row['process_guid']\n        parent = row['parent_process_guid']\n        if parent in malicious_guids and guid not in malicious_guids:\n            malicious_guids.add(guid)\n            added = True\n\n# Fetch all events\ncursor.execute(\"SELECT * FROM events;\")\nall_events = cursor.fetchall()\n\nsysmon_malicious_event_ids = set()\n\nfor row in all_events:\n    guid = row['process_guid']\n    parent = row['parent_process_guid']\n    if (guid in malicious_guids) or (parent in malicious_guids):\n        sysmon_malicious_event_ids.add(row['event_id'])\n\nprint(f\"Found {len(sysmon_malicious_event_ids)} Sysmon events via GUID correlation.\")\n\npowershell_malicious = set()\nfor row in all_events:\n    code = row['event_code']\n    eid = row['event_id']\n    if code in (800, 4103, 4104):\n        if row['host'] == 'WS-05.corp.example':\n            powershell_malicious.add(eid)\n\nprint(f\"PowerShell malicious events count: {len(powershell_malicious)}\")\nEOF\npython3 /tmp/hunt_all.py\n"]
