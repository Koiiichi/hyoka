[228.777533, "i", "cat << 'EOF' > /tmp/get_parent_pid.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, message FROM events WHERE process_guid = '{3ddc5665-e80d-5f51-2501-000000000500}' AND message IS NOT NULL AND message != '';\")\nfor row in cursor.fetchall():\n    msg = row['message']\n    for line in msg.split('\\n'):\n        if 'ProcessId:' in line or 'Process ID:' in line:\n            print(f\"{row['event_id']} | {line}\")\n\nEOF\npython3 /tmp/get_parent_pid.py\n"]
