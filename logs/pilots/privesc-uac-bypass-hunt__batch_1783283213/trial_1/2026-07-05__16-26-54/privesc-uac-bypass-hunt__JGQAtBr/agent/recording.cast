[295.264219, "i", "cat << 'EOF' > /tmp/check_mal_src_event10.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmal_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}',\n    '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    '{3ddc5665-ed06-5f51-f202-000000000500}',\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\ncursor.execute(\"SELECT event_id, image, target_image, message FROM events WHERE event_code = 10 AND host = 'WS-05.corp.example';\")\nevents10 = cursor.fetchall()\n\nfor row in events10:\n    msg = row['message'] if row['message'] else ''\n    src_guid, tgt_guid = None, None\n    for line in msg.split('\\n'):\n        if 'SourceProcessGUID:' in line:\n            src_guid = line.split(':')[1].strip()\n        if 'TargetProcessGUID:' in line:\n            tgt_guid = line.split(':')[1].strip()\n            \n    if src_guid in mal_guids:\n        print(f\"{row['event_id']} | Src: {row['image']} ({src_guid}) -> Tgt: {row['target_image']} ({tgt_guid})\")\n\nEOF\npython3 /tmp/check_mal_src_event10.py\n"]
