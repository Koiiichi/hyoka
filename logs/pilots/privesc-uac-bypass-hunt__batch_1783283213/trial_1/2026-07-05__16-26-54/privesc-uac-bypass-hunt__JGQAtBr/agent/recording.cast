[309.898241, "i", "cat << 'EOF' > /tmp/check_sec_audit.py\nimport sqlite3\nimport re\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE event_code IN (4656, 4658, 4663, 4690) AND host = 'WS-05.corp.example';\")\naudit_events = cursor.fetchall()\n\nmal_pids_hex = {'0x560', '0x1468', '0x1b6c', '0x1e8c', '0xf60', '0x1a24', '0xe40', '0x1350', '0x1968'}\nhex_pat = re.compile(r'\\b(' + '|'.join(mal_pids_hex) + r')\\b', re.IGNORECASE)\n\nproc_names = set()\n\nfor row in audit_events:\n    msg = row['message'] if row['message'] else ''\n    # Let's see if this event contains one of our PIDs\n    if not hex_pat.search(msg):\n        continue\n    # Parse Process Name from message\n    pname = None\n    for line in msg.split('\\n'):\n        if 'Process Name:' in line:\n            pname = line.split(':')[1].strip()\n    if pname:\n        proc_names.add(pname)\n\nprint(\"Unique process names in matched Security auditing events:\", proc_names) \nEOF\npython3 /tmp/check_sec_audit.py\n"]
[309.898922, "o", "cat << 'EOF' > /tmp/check_sec_audit.py\r\n"]
