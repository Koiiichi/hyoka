[136.050295, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's define the root malicious process GUIDs we know\nmalicious_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}', # Parent powershell\n    '{3ddc5665-ed05-5f51-ed02-000000000500}', # fodhelper 1\n    '{3ddc5665-ed05-5f51-f002-000000000500}', # fodhelper 2\n    '{3ddc5665-ed06-5f51-f102-000000000500}', # elevated powershell 1\n    '{3ddc5665-ed08-5f51-f302-000000000500}'  # elevated powershell 2\n}\n\n# Let's recursively find all child processes\n# We will query all process creation events (event_code 1)\ncursor.execute(\"SELECT event_id, process_guid, parent_process_guid, image, command_line FROM events WHERE event_code = 1;\")\nproc_events = cursor.fetchall()\n\nadded = True\nwhile added:\n    added = False\n    for row in proc_events:\n        guid = row['process_guid']\n        parent = row['parent_process_guid']\n        if parent in malicious_guids and guid not in malicious_guids:\n            print(f\"Adding child process: {row['image']} ({guid}) parent: {parent}\")\n            malicious_guids.add(guid)\n            added = True\n\nprint(f\"Total malicious process GUIDs: {len(malicious_guids)}\")\nfor g in malicious_guids:\n    print(g)\n\nEOF\npython3 /tmp/hunt.py\n"]
[136.052733, "o", "cat << 'EOF' > /tmp/hunt.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's define the root malicious process GUIDs we know\r\n\u001b[?2004l\r\u001b[?2004h> malicious_guids = {\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-e80d-5f51-2501-000000000500}', # Parent powershell\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed05-5f51-ed02-000000000500}', # fodhelper 1\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed05-5f51-f002-000000000500}', # fodhelper 2\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed06-5f51-f102-000000000500}', # elevated powershell 1\r\n\u001b[?2004l\r\u001b[?2004h>     '{3ddc5665-ed08-5f51-f302-000000000500}'  # elevated powershell 2\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's recursively find all child processes\r\n\u001b[?2004l\r\u001b[?2004h> # We will query all process creation events (event_code 1)\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, process_guid, parent_process_guid, image, command_line FROM events WHERE event_code = 1;\")\r\n\u001b[?2004l\r\u001b[?2004h> proc_events = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> added = True\r\n\u001b[?2004l\r\u001b[?2004h> while added:\r\n\u001b[?2004l\r\u001b[?2004h>     added = False\r\n\u001b[?2004l\r\u001b[?2004h>     for row in proc_events:\r\n\u001b[?2004l\r\u001b[?2004h>         guid = row['process_guid']\r\n\u001b[?2004l\r\u001b[?2004h>         parent = row['parent_process_guid']\r\n\u001b[?2004l\r\u001b[?2004h>         if parent in malicious_guids and guid not in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"Adding child process: {row['image']} ({guid}) parent: {parent}\")\r\n\u001b[?2004l\r\u001b[?2004h>             malicious_guids.add(guid)\r\n\u001b[?2004l\r\u001b[?2004h>             added = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total malicious process GUIDs: {len(malicious_guids)}\")\r\n\u001b[?2004l\r\u001b[?2004h> for g in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h>     print(g)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
