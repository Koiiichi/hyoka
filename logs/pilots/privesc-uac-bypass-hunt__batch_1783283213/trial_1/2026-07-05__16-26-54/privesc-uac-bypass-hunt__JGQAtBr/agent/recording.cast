[240.571617, "i", "cat << 'EOF' > /tmp/match_all.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmal_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}',\n    '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    '{3ddc5665-ed06-5f51-f202-000000000500}',\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\nmal_pids_dec = {1376, 5224, 7020, 7820, 3936, 6692, 3648, 4944, 6504}\nmal_pids_hex = {'0x560', '0x1468', '0x1b6c', '0x1e8c', '0xf60', '0x1a24', '0xe40', '0x1350', '0x1968'}\n\n# Also let's compile regexes for case insensitive matching of hex PIDs\nhex_pat = re.compile(r'\\b(' + '|'.join(mal_pids_hex) + r')\\b', re.IGNORECASE)\ndec_pat = re.compile(r'\\b(' + '|'.join(map(str, mal_pids_dec)) + r')\\b')\n\ncursor.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example';\")\nws05_events = cursor.fetchall()\n\nmatched_events = []\n\nfor row in ws05_events:\n    eid = row['event_id']\n    guid = row['process_guid']\n    parent_guid = row['parent_process_guid']\n    \n    # Check 1: Guid matches\n    if (guid in mal_guids) or (parent_guid in mal_guids):\n        matched_events.append(row)\n        continue\n        \n    # Check 2: Text matching in message, details, or command line\n    # We want to be careful not to match random substrings, so we use word boundaries\n    text_to_search = \"\\n\".join(filter(None, [\n        row['message'],\n        row['details'],\n        row['command_line']\n    ]))\n    \n    if hex_pat.search(text_to_search) or dec_pat.search(text_to_search):\n        matched_events.append(row)\n        continue\n\nprint(f\"Total matched events on WS-05: {len(matched_events)}\")\nfrom collections import Counter\nc = Counter()\nfor row in matched_events:\n    c[row['event_code']] += 1\nprint(\"Matched Event counts:\", sorted(c.items()))\n\nEOF\npython3 /tmp/match_all.py\n"]
