[247.99121, "i", "cat << 'EOF' > /tmp/check_fp.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Check 53504\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE event_code = 53504;\")\nfor row in cursor.fetchall():\n    print(f\"53504: {row['event_id']} | {row['message']}\")\n\n# Check 4703\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE event_code = 4703;\")\nfor row in cursor.fetchall():\n    print(f\"4703: {row['event_id']} | {row['message']}\")\n\nEOF\npython3 /tmp/check_fp.py\n"]
