[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> mal_guids = {
[?2004l[?2004h>     '{3ddc5665-e80d-5f51-2501-000000000500}',
[?2004l[?2004h>     '{3ddc5665-ed05-5f51-ed02-000000000500}',
[?2004l[?2004h>     '{3ddc5665-ed05-5f51-f002-000000000500}',
[?2004l[?2004h>     '{3ddc5665-ed06-5f51-f102-000000000500}',
[?2004l[?2004h>     '{3ddc5665-ed08-5f51-f302-000000000500}',
[?2004l[?2004h>     '{3ddc5665-ed04-5f51-eb02-000000000500}',
[?2004l[?2004h>     '{3ddc5665-ed04-5f51-ec02-000000000500}',
[?2004l[?2004h>     '{3ddc5665-ed06-5f51-f202-000000000500}',
[?2004l[?2004h>     '{3ddc5665-ed2e-5f51-fc02-000000000500}'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> mal_pids_dec = {1376, 5224, 7020, 7820, 3936, 6692, 3648, 4944, 6504}
[?2004l[?2004h> mal_pids_hex = {'0x560', '0x1468', '0x1b6c', '0x1e8c', '0xf60', '0x1a24', '0xe40', '0x1350', '0x1968'}
[?2004l[?2004h> 
[?2004l[?2004h> # Also let's compile regexes for case insensitive matching of hex PIDs
[?2004l[?2004h> hex_pat = re.compile(r'\b(' + '|'.join(mal_pids_hex) + r')\b', re.IGNORECASE)
[?2004l[?2004h> dec_pat = re.compile(r'\b(' + '|'.join(map(str, mal_pids_dec)) + r')\b')
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT * FROM events WHERE host = 'WS-05.corp.example';")
[?2004l[?2004h> ws05_events = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> matched_events = []
[?2004l[?2004h> 
[?2004l[?2004h> for row in ws05_events:
[?2004l[?2004h>     eid = row['event_id']
[?2004l[?2004h>     guid = row['process_guid']
[?2004l[?2004h>     parent_guid = row['parent_process_guid']
[?2004l[?2004h>     
[?2004l[?2004h>     # Check 1: Guid matches
[?2004l[?2004h>     if (guid in mal_guids) or (parent_guid in mal_guids):
[?2004l[?2004h>         matched_events.append(row)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # Check 2: Text matching in message, details, or command line
[?2004l[?2004h>     # We want to be careful not to match random substrings, so we use word boundaries
[?2004l[?2004h>     text_to_search = "\n".join(filter(None, [
[?2004l[?2004h>         row['message'],
[?2004l[?2004h>         row['details'],
[?2004l[?2004h>         row['command_line']
[?2004l[?2004h>     ]))
[?2004l[?2004h>     
[?2004l[?2004h>     if hex_pat.search(text_to_search) or dec_pat.search(text_to_search):
[?2004l[?2004h>         matched_events.append(row)
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total matched events on WS-05: {len(matched_events)}")
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> c = Counter()
[?2004l[?2004h> for row in matched_events:
[?2004l[?2004h>     c[row['event_code']] += 1
[?2004l[?2004h> print("Matched Event counts:", sorted(c.items()))
