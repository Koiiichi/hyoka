000500} and not in lifecycle yet, add it\n        if pguid == \'{3ddc5665-e80d-5f51-2501-000000000500}\' and pguid not in proc_lifecycle:\n            proc_lifecycle[pguid] = {\n                \'pid\': pid, # wait, we can find its true PID from parent process ID of its children\n                \'ppid\': None,\n                \'image\': pimg,\n                \'start_time\': \'2026-05-06T00:00:00Z\',\n                \'end_time\': None,\n                \'hex_pid\': None\n            }\n            if ppid is not None:\n                proc_lifecycle[pguid][\'pid\'] = ppid\n                proc_lifecycle[pguid][\'hex_pid\'] = f"0x{ppid:x}"\n\n# Now let\'s print proc_lifecycle for verification\nprint("Process Lifecycle Mapping:")\nfor g, info in proc_lifecycle.items():\n    if g in malicious_guids:\n        print(f"{g} -> {info}")\n\nEOF\npython3 trace_all_events.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
