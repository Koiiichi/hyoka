[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Query for network events connected to our processes of interest
[?2004l[?2004h> cursor.execute("""SELECT event_id, event_code, timestamp, image, src_ip, dst_ip, dst_port, process_guid 
[?2004l[?2004h>                   FROM events 
[?2004l[?2004h>                   WHERE event_code IN (3, 5156, 5158) 
[?2004l[?2004h>                     AND (process_guid='{3ddc5665-e80d-5f51-2501-000000000500}' 
[?2004l[?2004h>                          OR process_guid='{3ddc5665-ed06-5f51-f102-000000000500}' 
[?2004l[?2004h>                          OR process_guid='{3ddc5665-ed08-5f51-f302-000000000500}'
[?2004l[?2004h>                          OR image LIKE '%powershell%' OR image LIKE '%whoami%' OR image LIKE '%fodhelper%')
[?2004l[?2004h>                   ORDER BY timestamp""")
[?2004l[?2004h> print("Network events:")
[?2004l[?2004h> for r in cursor.fetchall():
