[?2004l[?2004h>                      OR target_object LIKE '%Windows Update%'
[?2004l[?2004h>                      OR details LIKE '%ms-settings%'
[?2004l[?2004h>                      OR details LIKE '%Windows Update%')
[?2004l[?2004h>                      AND event_code != 7
[?2004l[?2004h>                   ORDER BY timestamp""")
