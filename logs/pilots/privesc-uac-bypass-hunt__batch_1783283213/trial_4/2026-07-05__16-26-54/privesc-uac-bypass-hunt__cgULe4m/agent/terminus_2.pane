[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Let's map process creations to build the process lifecycle:
[?2004l[?2004h> # For each process, we need:
[?2004l[?2004h> # - GUID
[?2004l[?2004h> # - Image Name
[?2004l[?2004h> # - Decimal PID
[?2004l[?2004h> # - Hex PID
[?2004l[?2004h> # - Start time
[?2004l[?2004h> # - End time (if known)
[?2004l[?2004h> 
[?2004l[?2004h> proc_lifecycle = {}
[?2004l[?2004h> 
[?2004l[?2004h> # We will populate initial info about the parent process which was already running
[?2004l[?2004h> # PID of {3ddc5665-e80d-5f51-2501-000000000500} can be found by looking at its children's parent PID
[?2004l[?2004h> # Let's search all Sysmon events (EC 1) to build this mapping
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, timestamp, process_guid, parent_process_guid, image, parent_image, message FROM events")
[?2004l[?2004h> all_rows = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> for r in all_rows:
[?2004l[?2004h>     eid, ec, ts, guid, pguid, img, pimg, msg = r
[?2004l[?2004h>     if ec == 1:
[?2004l[?2004h>         # Process creation (Sysmon)
[?2004l[?2004h>         m_pid = re.search(r'ProcessId:\s*(\d+)', msg)
[?2004l[?2004h>         m_ppid = re.search(r'ParentProcessId:\s*(\d+)', msg)
[?2004l[?2004h>         pid = int(m_pid.group(1)) if m_pid else None
[?2004l[?2004h>         ppid = int(m_ppid.group(1)) if m_ppid else None
[?2004l[?2004h>         
[?2004l[?2004h>         proc_lifecycle[guid] = {
[?2004l[?2004h>             'pid': pid,
[?2004l[?2004h>             'ppid': ppid,
[?2004l[?2004h>             'image': img,
