[?2004hroot@95468b3f6b03:~# cat << 'EOF' > trace_proc.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Find the command line of process '{3ddc5665-e80d-5f51-2501-000000000500}'
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, timestamp, image, command_line, parent_image FROM events WHERE process_guid='{3ddc5665-e80d-5f51-2501-000000000500}' AND event_code IN (1, 4688)")
[?2004l[?2004h> print("Process {3ddc5665-e80d-5f51-2501-000000000500}:")
[?2004l[?2004h> print(cursor.fetchall())
[?2004l[?2004h> 
[?2004l[?2004h> # Also let's print ALL process creations (EC 1) in the db with their GUIDs to construct the full timeline
[?2004l[?2004h> cursor.execute("SELECT event_id, timestamp, host, user, image, command_line, process_guid, parent_process_guid FROM events WHERE event_code=1 ORDER BY timestamp")
[?2004l[?2004h> print("\nAll EC 1 (Process Creations):")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(r)
[?2004l[?2004h> EOF
