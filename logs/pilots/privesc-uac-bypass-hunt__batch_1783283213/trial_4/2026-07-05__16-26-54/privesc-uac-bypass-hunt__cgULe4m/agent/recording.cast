[25.989371, "o", "\u001b[?2004hroot@95468b3f6b03:~# "]
[31.998929, "i", "cat << 'EOF' > trace_reg.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Query for registry events related to ms-settings or Windows Update\ncursor.execute(\"\"\"SELECT event_id, event_code, timestamp, image, target_object, details, process_guid \n                  FROM events \n                  WHERE event_code IN (12, 13, 14) \n                    AND (target_object LIKE '%ms-settings%' OR target_object LIKE '%Windows Update%' \n                         OR details LIKE '%ms-settings%' OR details LIKE '%Windows Update%')\n                  ORDER BY timestamp\"\"\")\nprint(\"Registry events:\")\nfor r in cursor.fetchall():\n    print(r)\nEOF\npython3 trace_reg.py\n"]
