[193.769467, "i", "cat << 'EOF' > map_pids.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Map from decimal PID to process GUID\npid_to_guid = {}\nguid_to_name = {}\n\n# Query Sysmon process creation\ncursor.execute(\"SELECT process_guid, image, message FROM events WHERE event_code=1\")\nfor guid, img, msg in cursor.fetchall():\n    m = re.search(r'ProcessId:\\s*(\\d+)', msg)\n    if m:\n        pid_dec = int(m.group(1))\n        pid_to_guid[pid_dec] = guid\n        guid_to_name[guid] = img\n\n# Let's inspect all 4663 events and see if they were caused by our malicious processes\ncursor.execute(\"SELECT event_id, timestamp, message FROM events WHERE event_code=4663\")\nmalicious_4663 = []\nfor eid, ts, msg in cursor.fetchall():\n    m_proc = re.search(r'Process ID:\\s*(0x[0-9a-fA-F]+)', msg)\n    if m_proc:\n        pid_hex = m_proc.group(1)\n        pid_dec = int(pid_hex, 16)\n        if pid_dec in pid_to_guid:\n            guid = pid_to_guid[pid_dec]\n            # Check if this guid is in our malicious set\n            malicious_guids = {\n                '{3ddc5665-e80d-5f51-2501-000000000500}',\n                '{3ddc5665-ed04-5f51-eb02-000000000500}',\n                '{3ddc5665-ed04-5f51-ec02-000000000500}',\n                '{3ddc5665-ed05-5f51-ed02-000000000500}',\n                '{3ddc5665-ed05-5f51-f002-000000000500}',\n                '{3ddc5665-ed06-5f51-f102-000000000500}',\n                '{3ddc5665-ed06-5f51-f202-000000000500}',\n                '{3ddc5665-ed08-5f51-f302-000000000500}',\n                '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n            }\n            if guid in malicious_guids:\n                m_obj = re.search(r'Object Name:\\s*(.*)', msg)\n                obj_name = m_obj.group(1) if m_obj else \"\"\n                print(f\"Malicious 4663: {eid} | TS: {ts} | GUID: {guid} | Name: {guid_to_name[guid]} | Object: {obj_name}\")\n                malicious_4663.append(eid)\n\nprint(f\"Total malicious 4663: {len(malicious_4663)}\")\nEOF\npython3 map_pids.py\n"]
