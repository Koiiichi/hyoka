[203.313814, "i", "cat << 'EOF' > trace_all_events.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# We have our set of 9 malicious GUIDs\nmalicious_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed06-5f51-f202-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}',\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\n# Let's map process creations to build the process lifecycle:\n# For each process, we need:\n# - GUID\n# - Image Name\n# - Decimal PID\n# - Hex PID\n# - Start time\n# - End time (if known)\n\nproc_lifecycle = {}\n\n# We will populate initial info about the parent process which was already running\n# PID of {3ddc5665-e80d-5f51-2501-000000000500} can be found by looking at its children's parent PID\n# Let's search all Sysmon events (EC 1) to build this mapping\ncursor.execute(\"SELECT event_id, event_code, timestamp, process_guid, parent_process_guid, image, parent_image, message FROM events\")\nall_rows = cursor.fetchall()\n\nfor r in all_rows:\n    eid, ec, ts, guid, pguid, img, pimg, msg = r\n    if ec == 1:\n        # Process creation (Sysmon)\n        m_pid = re.search(r'ProcessId:\\s*(\\d+)', msg)\n        m_ppid = re.search(r'ParentProcessId:\\s*(\\d+)', msg)\n        pid = int(m_pid.group(1)) if m_pid else None\n        ppid = int(m_ppid.group(1)) if m_ppid else None\n        \n        proc_lifecycle[guid] = {\n            'pid': pid,\n            'ppid': ppid,\n            'image': img,\n            'start_time': ts,\n            'end_time': None,\n            'hex_pid': f\"0x{pid:x}\" if pid is not None else None\n        }\n        \n        # If parent is {3ddc5665-e80d-5f51-2501-000000000500} and not in lifecycle yet, add it\n        if pguid == '{3ddc5665-e80d-5f51-2501-000000000500}' and pguid not in proc_lifecycle:\n            proc_lifecycle[pguid] = {\n                'pid': pid, # wait, we can find its true PID from parent process ID of its children\n                'ppid': None,\n                'image': pimg,\n                'start_time': '2026-05-06T00:00:00Z',\n                'end_time': None,\n                'hex_pid': None\n            }\n            if ppid is not None:\n                proc_lifecycle[pguid]['pid'] = ppid\n                proc_lifecycle[pguid]['hex_pid'] = f\"0x{ppid:x}\"\n\n# Now let's print proc_lifecycle for verification\nprint(\"Process Lifecycle Mapping:\")\nfor g, info in proc_lifecycle.items():\n    if g in malicious_guids:\n        print(f\"{g} -> {info}\")\n\nEOF\npython3 trace_all_events.py\n"]
