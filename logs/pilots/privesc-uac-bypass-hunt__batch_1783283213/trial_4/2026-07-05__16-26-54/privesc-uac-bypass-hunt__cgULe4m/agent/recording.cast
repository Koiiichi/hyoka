[182.122687, "i", "cat << 'EOF' > trace_4663.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"SELECT event_id, timestamp, user, target_object, details, message \n                  FROM events \n                  WHERE event_code=4663 \n                  ORDER BY timestamp\"\"\")\n\nprint(\"Security 4663 (Object Access) events:\")\nfor r in cursor.fetchall():\n    print(f\"ID: {r[0]} | TS: {r[1]} | USR: {r[2]} | OBJ: {r[3]} | DET: {r[4]}\")\nEOF\npython3 trace_4663.py\n"]
