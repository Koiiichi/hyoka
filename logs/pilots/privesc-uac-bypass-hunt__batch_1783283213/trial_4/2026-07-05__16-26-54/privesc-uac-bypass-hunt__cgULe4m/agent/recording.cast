[64.195087, "i", "cat << 'EOF' > list_all_related.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# We have a list of GUIDs we care about\nguids = [\n    '{3ddc5665-e80d-5f51-2501-000000000500}', # parent powershell (initial shell)\n    '{3ddc5665-ed04-5f51-eb02-000000000500}', # whoami 1\n    '{3ddc5665-ed04-5f51-ec02-000000000500}', # whoami 2\n    '{3ddc5665-ed05-5f51-ed02-000000000500}', # fodhelper 1\n    '{3ddc5665-ed05-5f51-f002-000000000500}', # fodhelper 2\n    '{3ddc5665-ed06-5f51-f102-000000000500}', # elevated powershell 1\n    '{3ddc5665-ed06-5f51-f202-000000000500}', # conhost\n    '{3ddc5665-ed08-5f51-f302-000000000500}', # elevated powershell 2 (runner)\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}', # whoami 3\n]\n\n# Let's find any event where process_guid is in our list OR parent_process_guid is in our list\nplaceholders = ','.join('?' for _ in guids)\ncursor.execute(f\"\"\"SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, target_object, details, process_guid, parent_process_guid \n                  FROM events \n                  WHERE process_guid IN ({placeholders}) \n                     OR parent_process_guid IN ({placeholders})\n                  ORDER BY timestamp\"\"\", guids + guids)\n\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} events directly associated with our GUIDs.\")\nfor r in rows[:100]:\n    # print first 100\n    print(r[:8])\nEOF\npython3 list_all_related.py\n"]
