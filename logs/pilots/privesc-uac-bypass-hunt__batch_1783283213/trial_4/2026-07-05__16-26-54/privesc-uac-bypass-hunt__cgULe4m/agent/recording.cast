[7.618765, "o", "\u001b[?2004hroot@95468b3f6b03:~# "]
[14.572893, "i", "cat << 'EOF' > hunt.py\nimport sqlite3\nimport json\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's inspect all events for WS-05.corp.example\ncursor.execute(\"SELECT event_id, timestamp, event_code, channel, user, image, parent_image, command_line, target_object, details FROM events ORDER BY timestamp\")\nrows = cursor.fetchall()\n\nfor r in rows:\n    eid, ts, ec, chan, usr, img, pimg, cmd, tgt_obj, details = r\n    # If it's a registry key event related to ms-settings or Windows Update, or contains suspect commands\n    suspicious = False\n    if cmd and ('fodhelper' in cmd or 'whoami' in cmd or 'powershell' in cmd):\n        suspicious = True\n    if tgt_obj and ('ms-settings' in tgt_obj or 'Windows Update' in tgt_obj):\n        suspicious = True\n    if img and ('fodhelper' in img or 'whoami' in img):\n        suspicious = True\n    \n    if suspicious:\n        print(f\"{eid} | {ts} | EC:{ec} | {usr} | IMG:{img} | PIMG:{pimg} | CMD:{cmd} | TGT:{tgt_obj} | DET:{details}\")\n\nEOF\npython3 hunt.py > /tmp/suspicious_events.txt\nhead -n 50 /tmp/suspicious_events.txt\n"]
[14.573315, "o", "cat << 'EOF' > hunt.py\r\n\u001b[?2004l\r"]
[14.573413, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
