[114.154848, "i", "cat << 'EOF' > trace_ps_logs.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Query for any PowerShell script block or module logging events that contain our keywords\ncursor.execute(\"\"\"SELECT event_id, event_code, timestamp, host, message \n                  FROM events \n                  WHERE event_code IN (4104, 4103, 800) \n                    AND (message LIKE '%fodhelper%' OR message LIKE '%whoami%' OR message LIKE '%DelegateExecute%'\n                         OR message LIKE '%Update%' OR message LIKE '%Internet Settings%')\n                  ORDER BY timestamp\"\"\")\n\nprint(\"PowerShell Event Logs:\")\nfor r in cursor.fetchall():\n    print(f\"ID: {r[0]} | EC: {r[1]} | TS: {r[2]} | MSG: {r[4][:300]}...\")\nEOF\npython3 trace_ps_logs.py\n"]
