[231.966545, "i", "cat << 'EOF' > test_subsets.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Malicious Process GUIDs\nmalicious_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed06-5f51-f202-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}',\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\npid_map = {\n    1376: '{3ddc5665-e80d-5f51-2501-000000000500}',\n    6692: '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    3648: '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    5224: '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    7020: '{3ddc5665-ed05-5f51-f002-000000000500}',\n    7820: '{3ddc5665-ed06-5f51-f102-000000000500}',\n    4944: '{3ddc5665-ed06-5f51-f202-000000000500}',\n    3936: '{3ddc5665-ed08-5f51-f302-000000000500}',\n    6504: '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\ncursor.execute(\"SELECT event_id, event_code, timestamp, channel, image, parent_image, parent_process_guid, command_line, target_object, details, process_guid, message FROM events\")\nrows = cursor.fetchall()\n\n# Let's group all identified malicious events by event code and print details of each category\ncore_malicious = [] # Process creation, network connection, explicit registry modification, PowerShell logs\nsecondary_malicious = [] # Object access, handle closed/duplicated, file creations, etc.\n\nfor r in rows:\n    eid, ec, ts, chan, img, pimg, pguid, cmd, tobj, det, guid, msg = r\n    \n    is_mal = False\n    if guid in malicious_guids or pguid in malicious_guids:\n        is_mal = True\n    elif chan == 'security':\n        m_pid = re.search(r'Process ID:\\s*(0x[0-9a-fA-F]+)', msg or '')\n        if not m_pid:\n            m_pid = re.search(r'Creator Process ID:\\s*(0x[0-9a-fA-F]+)', msg or '')\n        if m_pid:\n            pid_hex = m_pid.group(1)\n            pid_dec = int(pid_hex, 16)\n            if pid_dec in pid_map:\n                is_mal = True\n                \n    if tobj and ('ms-settings' in tobj or 'Windows Update' in tobj):\n        is_mal = True\n        \n    if is_mal:\n        # Exclude noisy EC 7 (Image Load) and EC 10 (Process Access) completely from core malicious\n        if ec in (7, 10):\n            secondary_malicious.append((eid, ec, ts, img, cmd, tobj, \"Noisy Sysmon\"))\n        elif ec in (4656, 4658, 4690):\n            secondary_malicious.append((eid, ec, ts, img, cmd, tobj, \"Noisy Security ObjectAccess\"))\n        else:\n            core_malicious.append((eid, ec, ts, img, cmd, tobj, det))\n\nprint(f\"Core Malicious size: {len(core_malicious)}\")\nprint(f\"Secondary Malicious size: {len(secondary_malicious)}\")\n\n# Group core by EC\nfrom collections import Counter\nc = Counter(item[1] for item in core_malicious)\nfor ec, count in sorted(c.items()):\n    print(f\"Core Malicious EC: {ec} -> {count}\")\n\nEOF\npython3 test_subsets.py\n"]
