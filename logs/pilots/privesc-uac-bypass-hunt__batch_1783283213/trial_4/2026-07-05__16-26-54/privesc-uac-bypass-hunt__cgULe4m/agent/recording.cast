[134.760801, "i", "cat << 'EOF' > list_non_noisy.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, target_object, details \n                  FROM events \n                  WHERE host='WS-05.corp.example' \n                    AND event_code NOT IN (7, 10, 4656, 4658, 4690)\n                  ORDER BY timestamp\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total non-noisy events: {len(rows)}\")\nfor r in rows:\n    print(f\"ID: {r[0]} | EC: {r[1]} | TS: {r[2]} | USR: {r[3]} | IMG: {r[4]} | PIMG: {r[5]} | CMD: {r[6]} | OBJ: {r[7]} | DET: {r[8]}\")\nEOF\npython3 list_non_noisy.py > /tmp/non_noisy_events.txt\nwc -l /tmp/non_noisy_events.txt\n"]
