[37.802751, "i", "cat << 'EOF' > trace_proc_reg.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Query for all registry events by the suspect process\ncursor.execute(\"\"\"SELECT event_id, event_code, timestamp, target_object, details \n                  FROM events \n                  WHERE process_guid='{3ddc5665-e80d-5f51-2501-000000000500}' \n                    AND event_code IN (12, 13, 14)\n                  ORDER BY timestamp\"\"\")\nprint(\"Registry events by {3ddc5665-e80d-5f51-2501-000000000500}:\")\nfor r in cursor.fetchall():\n    print(r)\nEOF\npython3 trace_proc_reg.py\n"]
