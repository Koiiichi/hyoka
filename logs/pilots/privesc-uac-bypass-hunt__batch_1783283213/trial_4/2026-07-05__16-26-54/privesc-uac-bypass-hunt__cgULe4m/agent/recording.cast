[250.410013, "i", "cat << 'EOF' > trace_sec_net.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\npid_map = {\n    1376: '{3ddc5665-e80d-5f51-2501-000000000500}',\n    7820: '{3ddc5665-ed06-5f51-f102-000000000500}',\n    3936: '{3ddc5665-ed08-5f51-f302-000000000500}'\n}\n\ncursor.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE event_code IN (5156, 5158)\")\nfor eid, ec, ts, msg in cursor.fetchall():\n    m_pid = re.search(r'Process ID:\\s*(\\d+)', msg or '')\n    if m_pid:\n        pid = int(m_pid.group(1))\n        if pid in pid_map:\n            print(f\"Malicious Security Net Event: {eid} | EC: {ec} | TS: {ts} | PID: {pid} | GUID: {pid_map[pid]}\")\nEOF\npython3 trace_sec_net.py\n"]
[250.410455, "o", "cat << 'EOF' > trace_sec_net.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
