[90.474053, "i", "cat << 'EOF' > list_proc_creations.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"SELECT event_id, event_code, timestamp, image, parent_image, command_line, user \n                  FROM events \n                  WHERE (event_code IN (1, 4688)) \n                    AND (image LIKE '%whoami%' OR image LIKE '%fodhelper%' OR image LIKE '%powershell%' \n                         OR command_line LIKE '%whoami%' OR command_line LIKE '%fodhelper%' OR command_line LIKE '%powershell%')\n                  ORDER BY timestamp\"\"\")\n\nfor r in cursor.fetchall():\n    print(f\"ID: {r[0]} | EC: {r[1]} | TS: {r[2]} | IMG: {r[3]} | Parent: {r[4]} | CMD: {r[5]} | User: {r[6]}\")\nEOF\npython3 list_proc_creations.py\n"]
[90.474404, "o", "cat << 'EOF' > list_proc_creations.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> "]
