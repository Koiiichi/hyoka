[20.391981, "i", "cat << 'EOF' > hunt_filtered.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's inspect all events for WS-05.corp.example except EC 7 (Image Loaded) unless it's unusual\ncursor.execute(\"\"\"SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, details, src_ip, dst_ip, dst_port, process_guid \n                  FROM events \n                  WHERE (image LIKE '%whoami%' \n                     OR image LIKE '%fodhelper%' \n                     OR image LIKE '%powershell%' \n                     OR parent_image LIKE '%fodhelper%'\n                     OR command_line LIKE '%whoami%'\n                     OR command_line LIKE '%fodhelper%'\n                     OR command_line LIKE '%powershell%'\n                     OR target_object LIKE '%ms-settings%'\n                     OR target_object LIKE '%Windows Update%'\n                     OR details LIKE '%ms-settings%'\n                     OR details LIKE '%Windows Update%')\n                     AND event_code != 7\n                  ORDER BY timestamp\"\"\")\nrows = cursor.fetchall()\nfor r in rows:\n    print(r)\nEOF\npython3 hunt_filtered.py\n"]
[20.3924, "o", "cat << 'EOF' > hunt_filtered.py\r\n\u001b[?2004l\r"]
[20.39251, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
