[169.711995, "i", "cat << 'EOF' > count_mal_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nmalicious_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed06-5f51-f202-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}',\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\nplaceholders = ','.join('?' for _ in malicious_guids)\ncursor.execute(f\"\"\"SELECT event_code, COUNT(*) \n                  FROM events \n                  WHERE process_guid IN ({placeholders}) \n                     OR parent_process_guid IN ({placeholders})\n                  GROUP BY event_code \n                  ORDER BY 2 DESC\"\"\", list(malicious_guids) + list(malicious_guids))\n\nprint(\"Event Code Counts for Malicious GUIDs:\")\nfor r in cursor.fetchall():\n    print(r)\nEOF\npython3 count_mal_events.py\n"]
