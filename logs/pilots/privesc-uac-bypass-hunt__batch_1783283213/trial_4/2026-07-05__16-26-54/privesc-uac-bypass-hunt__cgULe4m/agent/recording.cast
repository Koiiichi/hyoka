[156.806059, "i", "cat << 'EOF' > find_all_procs.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# We start with the initial parent GUID\nmalicious_guids = {'{3ddc5665-e80d-5f51-2501-000000000500}'}\n\nqueue = ['{3ddc5665-e80d-5f51-2501-000000000500}']\nwhile queue:\n    curr = queue.pop(0)\n    # Find all children of this process\n    cursor.execute(\"SELECT process_guid, image, command_line FROM events WHERE parent_process_guid=? AND event_code IN (1, 4688)\", (curr,))\n    for r in cursor.fetchall():\n        child_guid = r[0]\n        if child_guid and child_guid not in malicious_guids:\n            malicious_guids.add(child_guid)\n            queue.append(child_guid)\n            print(f\"Spawned: {child_guid} | IMG: {r[1]} | CMD: {r[2]}\")\n\nprint(f\"All malicious GUIDs: {malicious_guids}\")\nEOF\npython3 find_all_procs.py\n"]
