[243.287864, "i", "cat << 'EOF' > trace_all_ps_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (800, 4103, 4104)\")\nrows = cursor.fetchall()\nprint(f\"Total PowerShell events on WS-05: {len(rows)}\")\nEOF\npython3 trace_all_ps_events.py\n"]
