[48.935576, "i", "cat << 'EOF' > trace_net.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Query for network events connected to our processes of interest\ncursor.execute(\"\"\"SELECT event_id, event_code, timestamp, image, src_ip, dst_ip, dst_port, process_guid \n                  FROM events \n                  WHERE event_code IN (3, 5156, 5158) \n                    AND (process_guid='{3ddc5665-e80d-5f51-2501-000000000500}' \n                         OR process_guid='{3ddc5665-ed06-5f51-f102-000000000500}' \n                         OR process_guid='{3ddc5665-ed08-5f51-f302-000000000500}'\n                         OR image LIKE '%powershell%' OR image LIKE '%whoami%' OR image LIKE '%fodhelper%')\n                  ORDER BY timestamp\"\"\")\nprint(\"Network events:\")\nfor r in cursor.fetchall():\n    print(r)\nEOF\npython3 trace_net.py\n"]
