[216.019997, "i", "cat << 'EOF' > categorize_events.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Malicious Process GUIDs\nmalicious_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed06-5f51-f202-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}',\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\n# Mapping PID -> GUID\npid_map = {\n    1376: '{3ddc5665-e80d-5f51-2501-000000000500}',\n    6692: '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    3648: '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    5224: '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    7020: '{3ddc5665-ed05-5f51-f002-000000000500}',\n    7820: '{3ddc5665-ed06-5f51-f102-000000000500}',\n    4944: '{3ddc5665-ed06-5f51-f202-000000000500}',\n    3936: '{3ddc5665-ed08-5f51-f302-000000000500}',\n    6504: '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\n# We will pull all events\ncursor.execute(\"SELECT event_id, event_code, timestamp, channel, provider, host, user, target_user, image, parent_image, parent_process_guid, command_line, target_object, details, process_guid, message FROM events\")\nrows = cursor.fetchall()\n\nmalicious_events = []\n\nfor r in rows:\n    eid, ec, ts, chan, prov, host, usr, tusr, img, pimg, pguid, cmd, tobj, det, guid, msg = r\n    \n    is_mal = False\n    reason = \"\"\n    \n    # 1. Direct Sysmon correlation\n    if guid in malicious_guids or pguid in malicious_guids:\n        is_mal = True\n        reason = \"Sysmon GUID match\"\n        \n    # 2. Security Log correlation via Process ID\n    if not is_mal and chan == 'security':\n        # Parse process ID from message\n        m_pid = re.search(r'Process ID:\\s*(0x[0-9a-fA-F]+)', msg or '')\n        if not m_pid:\n            m_pid = re.search(r'Creator Process ID:\\s*(0x[0-9a-fA-F]+)', msg or '')\n        if m_pid:\n            pid_hex = m_pid.group(1)\n            pid_dec = int(pid_hex, 16)\n            if pid_dec in pid_map:\n                is_mal = True\n                reason = f\"Security PID match ({pid_map[pid_dec]})\"\n        \n        # Also handle special cases like logon events or system modifications if they refer to m.ward\n        # Wait, was m.ward's logon malicious? Let's check when logon occurred.\n        \n    # 3. Registry ms-settings / Windows Update explicit keywords\n    if not is_mal:\n        # Check if it mentions our bypass registry key\n        if tobj and ('ms-settings' in tobj or 'Windows Update' in tobj):\n            is_mal = True\n            reason = \"Registry keyword match\"\n            \n    if is_mal:\n        malicious_events.append((eid, ec, ts, host, reason))\n\nprint(f\"Total identified potentially malicious events: {len(malicious_events)}\")\n# Group by event_code and reason\nfrom collections import Counter\nc = Counter((ec, reason) for _, ec, _, _, reason in malicious_events)\nfor k, v in sorted(c.items()):\n    print(f\"EC: {k[0]} | Reason: {k[1]} | Count: {v}\")\n\nEOF\npython3 categorize_events.py\n"]
