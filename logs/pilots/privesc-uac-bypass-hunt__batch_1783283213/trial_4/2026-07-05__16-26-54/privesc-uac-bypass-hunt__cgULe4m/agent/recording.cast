[20.414475, "o", ")\r\n('evt-04041', '2026-05-06T00:01:17.260Z', 12, '', 'C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe', '', '', 'HKU\\\\S-1-5-21-3125456671-949036322-3048627137-1104\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings\\\\Connections', '', None, None, None, '{3ddc5665-e80d-5f51-2501-000000000500}')\r\n('evt-04062', '2026-05-06T00:01:18.282Z', 12, '', 'C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe', '', '', 'HKU\\\\S-1-5-21-3125456671-949036322-3048627137-1104\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings\\\\Connections', '', None, None, None, '{3ddc5665-ed08-5f51-f302-000000000500}')\r\n('evt-04097', '2026-05-06T00:01:22.328Z', 12, '', 'C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe', '', '', 'HKU\\\\S-1-5-21-3125456671-949036322-3048627137-1104\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings\\\\Connections', '', None, None, None, '{3ddc5665-e80d-5f51-2501-000000000500}')\r\n('evt-04115', '2026-05-06T00:01:24.327Z', 12, '', 'C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe', '', '', 'HKU\\\\S-1-5-21-3125456671-949036322-3048627137-1104\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings\\\\Connections', '', None, None, None, '{3ddc5665-ed08-5f51-f302-000000000500}')\r\n"]
[20.415537, "o", "\u001b[?2004hroot@95468b3f6b03:~# "]
[25.97479, "i", "cat << 'EOF' > trace_proc.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Find the command line of process '{3ddc5665-e80d-5f51-2501-000000000500}'\ncursor.execute(\"SELECT event_id, event_code, timestamp, image, command_line, parent_image FROM events WHERE process_guid='{3ddc5665-e80d-5f51-2501-000000000500}' AND event_code IN (1, 4688)\")\nprint(\"Process {3ddc5665-e80d-5f51-2501-000000000500}:\")\nprint(cursor.fetchall())\n\n# Also let's print ALL process creations (EC 1) in the db with their GUIDs to construct the full timeline\ncursor.execute(\"SELECT event_id, timestamp, host, user, image, command_line, process_guid, parent_process_guid FROM events WHERE event_code=1 ORDER BY timestamp\")\nprint(\"\\nAll EC 1 (Process Creations):\")\nfor r in cursor.fetchall():\n    print(r)\nEOF\npython3 trace_proc.py\n"]
[25.975029, "o", "cat << 'EOF' > trace_proc.py\r\n\u001b[?2004l\r"]
[25.975059, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
