[?2004l[?2004h>     if related or code in (1, 4688, 3, 11, 12, 13, 17, 18):
[?2004l[?2004h>         print(f"{r['timestamp']} | {r['event_id']} | Code: {code} | User: {r['user']}")
[?2004l[?2004h>         if r['image']:
