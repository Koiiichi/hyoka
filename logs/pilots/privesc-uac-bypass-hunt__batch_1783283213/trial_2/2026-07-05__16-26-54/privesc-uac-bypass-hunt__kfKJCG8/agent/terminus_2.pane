[?2004l[?2004h>     img = (r['image'] or '').lower()
[?2004l[?2004h>     parent = (r['parent_image'] or '').lower()
[?2004l[?2004h>     cmd = (r['command_line'] or '').lower()
[?2004l[?2004h>     to = (r['target_object'] or '').lower()
[?2004l[?2004h>     det = (r['details'] or '').lower()
