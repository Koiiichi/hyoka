[?2004hroot@2e35b535a405:~# cat << 'EOF' > /tmp/analyze.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> 
[?2004l[?2004h> print("--- PROCESS CREATION EVENTS (1 & 4688) ---")
[?2004l[?2004h> rows = conn.execute("SELECT event_id, event_code, host, timestamp, user, image, parent_image, command_line FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp").fetchall()
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     print(f"{r['timestamp']} | {r['event_id']} | {r['host']} | {r['user']} | Code: {r['event_code']}")
[?2004l[?2004h>     print(f"  Image:  {r['image']}")
[?2004l[?2004h>     print(f"  Parent: {r['parent_image']}")
[?2004l[?2004h>     print(f"  Cmd:    {r['command_line'][:200]}")
[?2004l[?2004h>     print("-" * 40)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@2e35b535a405:~# python3 /tmp/analyze.py > /tmp/processes.txt
[?2004l[?2004hroot@2e35b535a405:~# head -n 100 /tmp/processes.txt
[?2004l--- PROCESS CREATION EVENTS (1 & 4688) ---
