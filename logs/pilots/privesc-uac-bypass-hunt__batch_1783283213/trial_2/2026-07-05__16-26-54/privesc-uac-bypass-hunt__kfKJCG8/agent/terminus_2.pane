[?2004l[?2004h> 
[?2004l[?2004h> query = """
[?2004l[?2004h> SELECT event_id, event_code, timestamp, image, process_guid, parent_process_guid, command_line
[?2004l[?2004h> FROM events
[?2004l[?2004h> WHERE host LIKE '%WS-05%'
[?2004l[?2004h>   AND event_code IN (1, 4688)
[?2004l[?2004h>   AND (command_line LIKE '%Update%' OR command_line LIKE '%enc SQBGAC%')
[?2004l[?2004h> """
[?2004l[?2004h> rows = conn.execute(query).fetchall()
[?2004l[?2004h> guids = set()
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     if r['process_guid']:
[?2004l[?2004h>         guids.add(r['process_guid'])
[?2004l[?2004h>     if r['parent_process_guid']:
[?2004l[?2004h>         guids.add(r['parent_process_guid'])
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Malicious process GUIDs found: {guids}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search for any network connection (Code 3) or DNS (Code 22) or file (Code 11) associated with these GUIDs
[?2004l[?2004h> for guid in guids:
[?2004l[?2004h>     events = conn.execute("SELECT event_id, event_code, timestamp, image, user, message, src_ip, dst_ip, dst_port FROM events WHERE process_guid = ? OR parent_process_guid = ? ORDER BY timestamp", (guid, guid)).fetchall()
[?2004l[?2004h>     print(f"\n=== Events for GUID {guid} ===")
[?2004l[?2004h>     for e in events:
[?2004l[?2004h>         # Skip Image Load (7) and Process Access (10) for now as they are too numerous
[?2004l[?2004h>         if e['event_code'] in (7, 10):
[?2004l[?2004h>             continue
[?2004l[?2004h>         print(f"  {e['timestamp']} | {e['event_id']} | Code: {e['event_code']} | Img: {e['image']} | Src: {e['src_ip']} -> Dst: {e['dst_ip']}:{e['dst_port']}")
[?2004l[?2004h>         if e['message']:
