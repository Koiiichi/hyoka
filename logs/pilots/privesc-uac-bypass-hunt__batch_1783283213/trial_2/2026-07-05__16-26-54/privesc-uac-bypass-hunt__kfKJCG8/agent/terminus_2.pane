[?2004l[?2004h>   AND timestamp <= '2026-05-06T00:01:10Z'
[?2004l[?2004h> ORDER BY timestamp
[?2004l[?2004h> """
[?2004l[?2004h> rows = conn.execute(query).fetchall()
