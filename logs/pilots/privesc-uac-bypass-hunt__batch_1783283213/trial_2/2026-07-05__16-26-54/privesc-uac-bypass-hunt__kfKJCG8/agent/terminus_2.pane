[?2004hroot@2e35b535a405:~# cat << 'EOF' > /tmp/trace_parent.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> 
[?2004l[?2004h> # Let's get the GUID of powershell that spawned whoami (evt-00305)
[?2004l[?2004h> whoami_ev = conn.execute("SELECT * FROM events WHERE event_id = 'evt-00305'").fetchone()
[?2004l[?2004h> parent_guid = whoami_ev['parent_process_guid']
[?2004l[?2004h> print(f"Parent GUID of whoami: {parent_guid}")
[?2004l[?2004h> 
[?2004l[?2004h> # Find the process creation event of that parent
[?2004l[?2004h> parent_ev = conn.execute("SELECT * FROM events WHERE process_guid = ? AND event_code IN (1, 4688)", (parent_guid,)).fetchone()
[?2004l[?2004h> if parent_ev:
[?2004l[?2004h>     print(f"Parent event found: {parent_ev['event_id']} | {parent_ev['timestamp']}")
[?2004l[?2004h>     print(f"  Img: {parent_ev['image']} | Cmd: {parent_ev['command_line']}")
[?2004l[?2004h> else:
[?2004l[?2004h>     print("Parent process creation event not found in DB (it might have been started before the logging window).")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@2e35b535a405:~# python3 /tmp/trace_parent.py
[?2004lParent GUID of whoami: {3ddc5665-e80d-5f51-2501-000000000500}
Parent process creation event not found in DB (it might have been started before the logging window).
[?2004hroot@2e35b535a405:~# cat << 'EOF' > /tmp/trace_guid.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> 
[?2004l[?2004h> guid = '{3ddc5665-e80d-5f51-2501-000000000500}'
[?2004l[?2004h> rows = conn.execute("SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, message FROM events WHERE process_guid = ? OR parent_process_guid = ? ORDER BY timestamp", (guid, guid)).fetchall()
[?2004l[?2004h> print(f"Total events related to {guid}: {len(rows)}")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     print(f"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']}")
[?2004l[?2004h>     print(f"  Img: {r['image']} | Parent: {r['parent_image']}")
[?2004l[?2004h>     print(f"  Cmd: {r['command_line'][:150] if r['command_line'] else ''}")
