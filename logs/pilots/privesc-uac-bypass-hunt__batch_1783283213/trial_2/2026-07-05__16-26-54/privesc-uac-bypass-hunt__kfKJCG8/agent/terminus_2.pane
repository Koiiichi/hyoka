[?2004l[?2004h> # Let's query events on WS-05 in the specific window
[?2004l[?2004h> query = """
[?2004l[?2004h> SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, target_object, details, message
[?2004l[?2004h> FROM events
[?2004l[?2004h> WHERE host LIKE '%WS-05%'
