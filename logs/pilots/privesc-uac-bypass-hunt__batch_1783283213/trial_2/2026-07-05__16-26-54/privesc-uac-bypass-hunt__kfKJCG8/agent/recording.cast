[98.946519, "i", "cat << 'EOF' > /tmp/query_ws06.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\nprint(\"=== WS-06 EVENTS ===\")\nquery = \"\"\"\nSELECT event_id, event_code, timestamp, user, target_user, logon_type, service_name, service_file_name, target_object, message\nFROM events\nWHERE host LIKE '%WS-06%'\n  AND event_code IN (1, 4688, 4624, 4672, 5140, 5145, 4697, 7045, 18, 4627)\nORDER BY timestamp\n\"\"\"\rows = conn.execute(query).fetchall()\nfor r in rows:\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | User: {r['user']} | TargetUser: {r['target_user']}\")\n    if r['logon_type']:\n        print(f\"  LogonType: {r['logon_type']}\")\n    if r['service_name']:\n        print(f\"  Service: {r['service_name']} | File: {r['service_file_name']}\")\n    if r['target_object']:\n        print(f\"  Object/Share: {r['target_object']}\")\n    # check message\n    msg = r['message'] or ''\n    for line in msg.split('\\n'):\n        if 'Share Name:' in line or 'Relative Target Name:' in line or 'IpAddress' in line or 'Workstation Name' in line:\n            print(f\"  Msg: {line.strip()}\")\n    print(\"-\" * 40)\nEOF\npython3 /tmp/query_ws06.py\n"]
