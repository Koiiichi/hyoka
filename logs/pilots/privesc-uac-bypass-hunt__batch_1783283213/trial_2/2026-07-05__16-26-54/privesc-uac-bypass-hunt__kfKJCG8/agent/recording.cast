[41.615266, "i", "cat << 'EOF' > /tmp/analyze_dc01.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\nrows = conn.execute(\"SELECT * FROM events WHERE host LIKE '%DC01%' ORDER BY timestamp\").fetchall()\nfor r in rows:\n    to_print = False\n    # filter out most boring noise or print all since there are only 94 DC01 events\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | User: {r['user']} | TargetUser: {r['target_user']}\")\n    print(f\"  Img: {r['image']} | Parent: {r['parent_image']} | Cmd: {r['command_line']}\")\n    print(f\"  Src: {r['src_ip']}:{r['dst_port']} -> Dst: {r['dst_ip']}:{r['dst_port']}\")\n    print(f\"  Serv: {r['service_name']} | ServFile: {r['service_file_name']}\")\n    print(f\"  Share/Object: {r['target_object']} | Details: {r['details']}\")\n    print(f\"  Msg: {r['message'][:300] if r['message'] else ''}\")\n    print(\"=\"*50)\nEOF\npython3 /tmp/analyze_dc01.py > /tmp/dc01_all.txt\ncat /tmp/dc01_all.txt | head -n 150\n"]
