[46.284003, "i", "cat << 'EOF' > /tmp/filter_dc01.py\nimport re\nwith open('/tmp/dc01_all.txt') as f:\n    content = f.read()\n\nevents = content.split('=' * 50)\nfor ev in events:\n    if not ev.strip():\n        continue\n    # check timestamp\n    m = re.search(r'2026-05-06T00:0[0-9]:[0-9][0-9]', ev)\n    if m:\n        ts = m.group(0)\n        # Let's extract seconds\n        sec_m = re.search(r'2026-05-06T00:00:([0-9][0-9])', ev)\n        if sec_m:\n            sec = int(sec_m.group(1))\n            if sec < 26:\n                continue\n        print(\"=\"*50)\n        print(ev.strip())\nEOF\npython3 /tmp/filter_dc01.py\n"]
