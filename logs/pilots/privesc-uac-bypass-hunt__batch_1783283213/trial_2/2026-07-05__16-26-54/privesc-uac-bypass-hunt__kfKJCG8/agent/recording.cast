[166.611572, "i", "cat << 'EOF' > /tmp/trace_guid.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\nguid = '{3ddc5665-e80d-5f51-2501-000000000500}'\nrows = conn.execute(\"SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, message FROM events WHERE process_guid = ? OR parent_process_guid = ? ORDER BY timestamp\", (guid, guid)).fetchall()\nprint(f\"Total events related to {guid}: {len(rows)}\")\nfor r in rows:\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']}\")\n    print(f\"  Img: {r['image']} | Parent: {r['parent_image']}\")\n    print(f\"  Cmd: {r['command_line'][:150] if r['command_line'] else ''}\")\n    print(\"-\" * 40)\nEOF\npython3 /tmp/trace_guid.py\n"]
[166.611794, "o", "cat << 'EOF' > /tmp/trace_guid.py\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.612845, "o", "> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> guid = '{3ddc5665-e80d-5f51-2501-000000000500}'\r\n\u001b[?2004l\r\u001b[?2004h> rows = conn.execute(\"SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, message FROM events WHERE process_guid = ? OR parent_process_guid = ? ORDER BY timestamp\", (guid, guid)).fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total events related to {guid}: {len(rows)}\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Img: {r['image']} | Parent: {r['parent_image']}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Cmd: {r['command_line'][:150] if r['command_line'] else ''}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"-\" * 40)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
