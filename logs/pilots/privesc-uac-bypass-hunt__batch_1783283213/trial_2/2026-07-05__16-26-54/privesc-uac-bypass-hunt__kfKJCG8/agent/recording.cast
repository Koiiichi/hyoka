[20.390679, "i", "cat << 'EOF' > /tmp/analyze_registry.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\nprint(\"--- REGISTRY EVENTS (12 & 13) ---\")\nrows = conn.execute(\"SELECT event_id, event_code, host, timestamp, user, target_object, details FROM events WHERE event_code IN (12, 13) AND timestamp LIKE '2026-05-06%' ORDER BY timestamp\").fetchall()\nfor r in rows:\n    # Only print registry events that seem related to the attack or are generally interesting\n    to = r['target_object'] or ''\n    det = r['details'] or ''\n    if 'ms-settings' in to or 'Windows Update' in to or 'HKCU' in to or 'Environment' in to or 'Run' in to or 'Shell' in to:\n        print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | {r['host']} | {r['user']}\")\n        print(f\"  Target: {to}\")\n        print(f\"  Details: {det}\")\n        print(\"-\" * 40)\nEOF\npython3 /tmp/analyze_registry.py | head -n 100\n"]
