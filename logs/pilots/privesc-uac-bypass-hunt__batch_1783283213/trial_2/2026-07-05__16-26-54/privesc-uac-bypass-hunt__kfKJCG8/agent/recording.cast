[222.382005, "i", "cat << 'EOF' > /tmp/check_logons.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\nrows = conn.execute(\"SELECT event_id, event_code, timestamp, user, target_user, logon_type, message FROM events WHERE host LIKE '%WS-05%' AND event_code = 4624 ORDER BY timestamp\").fetchall()\nprint(f\"Total: {len(rows)}\")\nfor r in rows:\n    print(f\"  {r['timestamp']} | {r['event_id']} | User: {r['user']} | Target: {r['target_user']} | Type: {r['logon_type']}\")\n    msg = r['message'] or ''\n    for line in msg.split('\\n'):\n        if 'Workstation Name:' in line or 'Source Network Address:' in line:\n            print(f\"    {line.strip()}\")\nEOF\npython3 /tmp/check_logons.py\n"]
