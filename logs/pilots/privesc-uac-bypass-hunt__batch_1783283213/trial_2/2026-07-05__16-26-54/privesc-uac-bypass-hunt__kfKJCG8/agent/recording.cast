[161.968699, "i", "cat << 'EOF' > /tmp/trace_parent.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\n# Let's get the GUID of powershell that spawned whoami (evt-00305)\nwhoami_ev = conn.execute(\"SELECT * FROM events WHERE event_id = 'evt-00305'\").fetchone()\nparent_guid = whoami_ev['parent_process_guid']\nprint(f\"Parent GUID of whoami: {parent_guid}\")\n\n# Find the process creation event of that parent\nparent_ev = conn.execute(\"SELECT * FROM events WHERE process_guid = ? AND event_code IN (1, 4688)\", (parent_guid,)).fetchone()\nif parent_ev:\n    print(f\"Parent event found: {parent_ev['event_id']} | {parent_ev['timestamp']}\")\n    print(f\"  Img: {parent_ev['image']} | Cmd: {parent_ev['command_line']}\")\nelse:\n    print(\"Parent process creation event not found in DB (it might have been started before the logging window).\")\nEOF\npython3 /tmp/trace_parent.py\n"]
[161.969105, "o", "cat << 'EOF' > /tmp/trace_parent.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
