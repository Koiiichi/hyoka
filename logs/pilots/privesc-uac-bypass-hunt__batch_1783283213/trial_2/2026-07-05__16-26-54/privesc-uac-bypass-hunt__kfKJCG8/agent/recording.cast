[138.453652, "i", "cat << 'EOF' > /tmp/filter_code1.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\nrows = conn.execute(\"SELECT event_id, timestamp, user, image, parent_image, command_line FROM events WHERE host LIKE '%WS-05%' AND event_code = 1 ORDER BY timestamp\").fetchall()\nprint(f\"Total Code 1 events: {len(rows)}\")\nfor r in rows:\n    cmd = (r['command_line'] or '').lower()\n    img = (r['image'] or '').lower()\n    parent = (r['parent_image'] or '').lower()\n    # Identify typical benign noise\n    is_noise = False\n    for noise in ['logonui.exe', 'tstheme.exe', 'taskhostw.exe', 'dxgiadaptercache.exe', 'trustedinstaller.exe', 'tiworker.exe']:\n        if noise in img or noise in parent:\n            is_noise = True\n    if 'svchost.exe' in img and ('appmodel' in cmd or 'netsvcs' in cmd):\n        is_noise = True\n    \n    if not is_noise:\n        print(f\"{r['timestamp']} | {r['event_id']} | User: {r['user']}\")\n        print(f\"  Img: {r['image']}\")\n        print(f\"  Parent: {r['parent_image']}\")\n        print(f\"  Cmd: {r['command_line'][:300]}\")\n        print(\"-\" * 40)\nEOF\npython3 /tmp/filter_code1.py\n"]
