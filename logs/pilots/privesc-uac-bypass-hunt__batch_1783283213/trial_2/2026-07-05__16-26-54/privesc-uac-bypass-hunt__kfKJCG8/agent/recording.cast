[8.389087, "o", "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           \r\n\u001b[?2004hroot@2e35b535a405:~# "]
[12.618473, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\nprint(\"--- PROCESS CREATION EVENTS (1 & 4688) ---\")\nrows = conn.execute(\"SELECT event_id, event_code, host, timestamp, user, image, parent_image, command_line FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp\").fetchall()\nfor r in rows:\n    print(f\"{r['timestamp']} | {r['event_id']} | {r['host']} | {r['user']} | Code: {r['event_code']}\")\n    print(f\"  Image:  {r['image']}\")\n    print(f\"  Parent: {r['parent_image']}\")\n    print(f\"  Cmd:    {r['command_line'][:200]}\")\n    print(\"-\" * 40)\n\nEOF\npython3 /tmp/analyze.py > /tmp/processes.txt\nhead -n 100 /tmp/processes.txt\n"]
[12.61888, "o", "cat << 'EOF' > /tmp/analyze.py\r\n\u001b[?2004l\r"]
[12.619054, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[12.619243, "o", "\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> "]
