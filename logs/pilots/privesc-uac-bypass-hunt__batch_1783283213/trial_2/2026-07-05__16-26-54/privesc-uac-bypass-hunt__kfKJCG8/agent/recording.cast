[175.925829, "i", "cat << 'EOF' > /tmp/check_update_reg.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\nrows = conn.execute(\"SELECT event_id, event_code, timestamp, target_object, details FROM events WHERE host LIKE '%WS-05%' AND (target_object LIKE '%Windows Update%' OR details LIKE '%Windows Update%') ORDER BY timestamp\").fetchall()\nprint(f\"Total: {len(rows)}\")\nfor r in rows:\n    print(f\"  {r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | Target: {r['target_object']} | Details: {r['details'][:150] if r['details'] else ''}\")\nEOF\npython3 /tmp/check_update_reg.py\n"]
