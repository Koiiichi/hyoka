[180.666236, "i", "cat << 'EOF' > /tmp/check_all_reg.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\nrows = conn.execute(\"SELECT event_id, event_code, timestamp, target_object, details FROM events WHERE host LIKE '%WS-05%' AND event_code IN (12, 13) AND timestamp >= '2026-05-06T00:00:25Z' AND timestamp <= '2026-05-06T00:00:27Z' ORDER BY timestamp\").fetchall()\nprint(f\"Total: {len(rows)}\")\nfor r in rows:\n    to = r['target_object'] or ''\n    det = r['details'] or ''\n    if any(x in to.lower() or x in det.lower() for x in ['ms-settings', 'update', 'classes', 'command', 'delegateexecute']):\n        print(f\"  {r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | Target: {to} | Details: {det[:100]}\")\nEOF\npython3 /tmp/check_all_reg.py\n"]
