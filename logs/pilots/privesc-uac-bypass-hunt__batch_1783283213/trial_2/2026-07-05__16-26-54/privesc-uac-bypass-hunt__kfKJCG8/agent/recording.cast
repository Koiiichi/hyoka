[150.581929, "i", "cat << 'EOF' > /tmp/correlate.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\n# Let's query events on WS-05 in the specific window\nquery = \"\"\"\nSELECT event_id, event_code, timestamp, user, image, parent_image, command_line, target_object, details, message\nFROM events\nWHERE host LIKE '%WS-05%'\n  AND timestamp >= '2026-05-06T00:00:25Z'\n  AND timestamp <= '2026-05-06T00:01:10Z'\nORDER BY timestamp\n\"\"\"\nrows = conn.execute(query).fetchall()\n\nprint(f\"Total events in window: {len(rows)}\")\nfor r in rows:\n    code = r['event_code']\n    # filter out known super-noisy benign ones like image load (7), process access (10), handle stuff, if they don't involve malicious processes\n    img = (r['image'] or '').lower()\n    parent = (r['parent_image'] or '').lower()\n    cmd = (r['command_line'] or '').lower()\n    to = (r['target_object'] or '').lower()\n    det = (r['details'] or '').lower()\n    \n    # check if related to attacker processes: whoami, powershell, fodhelper, conhost, or specific registry keys\n    related = False\n    if any(x in img or x in parent or x in cmd for x in ['whoami', 'powershell', 'fodhelper']):\n        related = True\n    if any(x in to or x in det for x in ['ms-settings', 'windows update']):\n        related = True\n    \n    if related or code in (1, 4688, 3, 11, 12, 13, 17, 18):\n        print(f\"{r['timestamp']} | {r['event_id']} | Code: {code} | User: {r['user']}\")\n        if r['image']:\n            print(f\"  Img: {r['image']} | Parent: {r['parent_image']}\")\n        if r['command_line']:\n            print(f\"  Cmd: {r['command_line'][:200]}\")\n        if r['target_object']:\n            print(f\"  Reg Target: {r['target_object']} | Details: {r['details']}\")\n        print(\"-\" * 50)\n\nEOF\npython3 /tmp/correlate.py > /tmp/ws05_correlated.txt\ncat /tmp/ws05_correlated.txt\n"]
[150.582932, "o", "cat << 'EOF' > /tmp/correlate.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's query events on WS-05 in the specific window\r\n\u001b[?2004l\r\u001b[?2004h> query = \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
