[108.71861, "o", "query = \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> SELECT event_id, event_code, timestamp, user, image, parent_image, command_line\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.718632, "o", "> FROM events\r\n\u001b[?2004l\r\u001b[?2004h> WHERE host LIKE '%WS-05%'\r\n\u001b[?2004l\r\u001b[?2004h>   AND event_code IN (1, 4688)\r\n\u001b[?2004l\r"]
[108.71878, "o", "\u001b[?2004h> ORDER BY timestamp\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> rows = conn.execute(query).fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r"]
[108.718862, "o", "\u001b[?2004h> "]
[108.71898, "o", "    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | User: {r['user']}\")\r\n\u001b[?2004l\r"]
[108.719062, "o", "\u001b[?2004h>     print(f\"  Img: {r['image']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.719188, "o", "    print(f\"  Parent: {r['parent_image']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.719269, "o", "    print(f\"  Cmd: {r['command_line']}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"-\" * 40)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.719442, "o", "EOF\r\n\u001b[?2004l\r"]
