[213.844284, "i", "cat << 'EOF' > /tmp/check_network.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\nrows = conn.execute(\"SELECT event_id, event_code, timestamp, host, image, src_ip, dst_ip, dst_port, message FROM events WHERE event_code IN (3, 5156) ORDER BY timestamp\").fetchall()\nprint(f\"Total network events: {len(rows)}\")\nfor r in rows:\n    dip = r['dst_ip'] or ''\n    dport = str(r['dst_port'] or '')\n    msg = r['message'] or ''\n    img = r['image'] or ''\n    if '10.10.10.5' in dip or '10.10.10.5' in msg or dport == '80' or dport == '443' or 'powershell' in img.lower():\n        print(f\"  {r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | Host: {r['host']} | Img: {img} | {r['src_ip']} -> {dip}:{dport}\")\nEOF\npython3 /tmp/check_network.py\n"]
[213.844531, "o", "cat << 'EOF' > /tmp/check_network.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
