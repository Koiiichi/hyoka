[170.719842, "i", "cat << 'EOF' > /tmp/save_trace.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\nguid = '{3ddc5665-e80d-5f51-2501-000000000500}'\nrows = conn.execute(\"SELECT event_id, event_code, timestamp, image, parent_image, command_line FROM events WHERE process_guid = ? OR parent_process_guid = ? ORDER BY timestamp\", (guid, guid)).fetchall()\nprint(f\"Total: {len(rows)}\")\nfor r in rows:\n    print(f\"  {r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | Img: {r['image']} | Cmd: {r['command_line'][:100] if r['command_line'] else ''}\")\nEOF\npython3 /tmp/save_trace.py > /tmp/trace_summary.txt\ncat /tmp/trace_summary.txt\n"]
