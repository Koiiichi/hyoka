[33.402991, "i", "cat << 'EOF' > /tmp/analyze_all.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\nprint(\"=== WS-06 events ===\")\nrows = conn.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host LIKE '%WS-06%' GROUP BY event_code\").fetchall()\nfor r in rows:\n    print(f\"Code {r[0]}: {r[1]}\")\n\nprint(\"=== DC01 events ===\")\nrows = conn.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host LIKE '%DC01%' GROUP BY event_code\").fetchall()\nfor r in rows:\n    print(f\"Code {r[0]}: {r[1]}\")\n\nprint(\"=== WS-06 all events timeline ===\")\nrows = conn.execute(\"SELECT event_id, event_code, timestamp, user, image, command_line, target_object, details, message FROM events WHERE host LIKE '%WS-06%' ORDER BY timestamp\").fetchall()\nfor r in rows:\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | User: {r['user']}\")\n    if r['image'] or r['command_line']:\n        print(f\"  Img: {r['image']} | Cmd: {r['command_line']}\")\n    if r['target_object'] or r['details']:\n        print(f\"  Reg: {r['target_object']} | {r['details']}\")\n    if r['message']:\n        print(f\"  Msg: {r['message'][:200]}\")\n    print(\"-\" * 40)\n\nprint(\"=== DC01 all events timeline ===\")\nrows = conn.execute(\"SELECT event_id, event_code, timestamp, user, image, command_line, target_object, details, message FROM events WHERE host LIKE '%DC01%' ORDER BY timestamp\").fetchall()\nfor r in rows:\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | User: {r['user']}\")\n    if r['image'] or r['command_line']:\n        print(f\"  Img: {r['image']} | Cmd: {r['command_line']}\")\n    if r['target_object'] or r['details']:\n        print(f\"  Reg: {r['target_object']} | {r['details']}\")\n    if r['message']:\n        print(f\"  Msg: {r['message'][:200]}\")\n    print(\"-\" * 40)\n\nEOF\npython3 /tmp/analyze_all.py > /tmp/ws06_dc01.txt\nhead -n 120 /tmp/ws06_dc01.txt\n"]
[33.404133, "o", "cat << 'EOF' > /tmp/analyze_all.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row"]
