[193.400578, "i", "cat << 'EOF' > /tmp/trace_malicious_activities.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\n# Find the process GUIDs of our malicious powershells:\n# 1) Powershell with stager (evt-01812 / evt-01614)\n# 2) Powershell with update cmd (evt-01186 / evt-01020)\n\nquery = \"\"\"\nSELECT event_id, event_code, timestamp, image, process_guid, parent_process_guid, command_line\nFROM events\nWHERE host LIKE '%WS-05%'\n  AND event_code IN (1, 4688)\n  AND (command_line LIKE '%Update%' OR command_line LIKE '%enc SQBGAC%')\n\"\"\"\nrows = conn.execute(query).fetchall()\nguids = set()\nfor r in rows:\n    if r['process_guid']:\n        guids.add(r['process_guid'])\n    if r['parent_process_guid']:\n        guids.add(r['parent_process_guid'])\n\nprint(f\"Malicious process GUIDs found: {guids}\")\n\n# Let's search for any network connection (Code 3) or DNS (Code 22) or file (Code 11) associated with these GUIDs\nfor guid in guids:\n    events = conn.execute(\"SELECT event_id, event_code, timestamp, image, user, message, src_ip, dst_ip, dst_port FROM events WHERE process_guid = ? OR parent_process_guid = ? ORDER BY timestamp\", (guid, guid)).fetchall()\n    print(f\"\\n=== Events for GUID {guid} ===\")\n    for e in events:\n        # Skip Image Load (7) and Process Access (10) for now as they are too numerous\n        if e['event_code'] in (7, 10):\n            continue\n        print(f\"  {e['timestamp']} | {e['event_id']} | Code: {e['event_code']} | Img: {e['image']} | Src: {e['src_ip']} -> Dst: {e['dst_ip']}:{e['dst_port']}\")\n        if e['message']:\n            print(f\"    Msg: {e['message'][:150].strip()}\")\nEOF\npython3 /tmp/trace_malicious_activities.py\n"]
[193.401651, "o", "cat << 'EOF' > /tmp/trace_malicious_activities.py\r\n"]
