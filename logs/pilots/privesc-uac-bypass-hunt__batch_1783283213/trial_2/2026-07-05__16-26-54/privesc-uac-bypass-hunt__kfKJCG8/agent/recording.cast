[108.717565, "i", "cat << 'EOF' > /tmp/query_ws05.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\nprint(\"=== WS-05 ALL PROCESS CREATION EVENTS (1 & 4688) ===\")\nquery = \"\"\"\nSELECT event_id, event_code, timestamp, user, image, parent_image, command_line\nFROM events\nWHERE host LIKE '%WS-05%'\n  AND event_code IN (1, 4688)\nORDER BY timestamp\n\"\"\"\nrows = conn.execute(query).fetchall()\nfor r in rows:\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | User: {r['user']}\")\n    print(f\"  Img: {r['image']}\")\n    print(f\"  Parent: {r['parent_image']}\")\n    print(f\"  Cmd: {r['command_line']}\")\n    print(\"-\" * 40)\nEOF\npython3 /tmp/query_ws05.py > /tmp/ws05_processes.txt\ncat /tmp/ws05_processes.txt\n"]
