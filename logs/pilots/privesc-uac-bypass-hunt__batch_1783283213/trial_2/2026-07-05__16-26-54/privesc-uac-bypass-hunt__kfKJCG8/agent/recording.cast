[156.056709, "i", "cat << 'EOF' > /tmp/check_all_powershell.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\nrows = conn.execute(\"SELECT event_id, event_code, timestamp, user, image, parent_image, command_line FROM events WHERE (image LIKE '%powershell%' OR command_line LIKE '%powershell%') AND host LIKE '%WS-05%' ORDER BY timestamp\").fetchall()\nfor r in rows:\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']}\")\n    print(f\"  Img: {r['image']} | Parent: {r['parent_image']}\")\n    print(f\"  Cmd: {r['command_line'][:250]}\")\n    print(\"-\" * 40)\nEOF\npython3 /tmp/check_all_powershell.py\n"]
[156.057101, "o", "cat << 'EOF' > /tmp/check_all_powershell.py\r\n\u001b[?2004l\r"]
[156.058056, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> rows = conn.execute(\"SELECT event_id, event_code, timestamp, user, image, parent_image, command_line FROM events WHERE (image LIKE '%powershell%' OR command_line LIKE '%powershell%') AND host LIKE '%WS-05%' ORDER BY timestamp\").fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Img: {r['image']} | Parent: {r['parent_image']}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Cmd: {r['command_line'][:250]}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"-\" * 40)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
