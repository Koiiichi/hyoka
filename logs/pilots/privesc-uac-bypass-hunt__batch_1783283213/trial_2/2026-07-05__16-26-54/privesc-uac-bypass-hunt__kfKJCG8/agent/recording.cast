[88.321335, "i", "cat << 'EOF' > /tmp/summarize_dc01.py\nwith open('/tmp/interesting_dc01.txt') as f:\n    content = f.read()\n\nevents = content.split('=' * 50)\nprint(f\"Total interesting events: {len(events)}\")\nfor ev in events:\n    lines = ev.strip().split('\\n')\n    if not lines or not lines[0]:\n        continue\n    header = lines[0]\n    # find service/share details\n    serv_line = \"\"\n    share_line = \"\"\n    for l in lines:\n        if \"Serv:\" in l or \"Share/Object:\" in l:\n            print(f\"  {l.strip()}\")\n    print(header)\nEOF\npython3 /tmp/summarize_dc01.py\n"]
[88.321628, "o", "cat << 'EOF' > /tmp/summarize_dc01.py\r\n\u001b[?2004l\r"]
