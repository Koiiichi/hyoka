[61.491455, "i", "cat << 'EOF' > /tmp/filter_interesting.py\nimport re\nwith open('/tmp/dc01_all.txt') as f:\n    content = f.read()\n\nevents = content.split('=' * 50)\nfor ev in events:\n    if not ev.strip():\n        continue\n    m = re.search(r'Code: (\\d+)', ev)\n    if m:\n        code = int(m.group(1))\n        if code in (5156, 5158, 3, 7):\n            continue\n        # Let's check the timestamp as well to only see the ones on 2026-05-06 after 00:00:26\n        ts_m = re.search(r'2026-05-06T00:00:([0-9][0-9])', ev)\n        if ts_m:\n            sec = int(ts_m.group(1))\n            if sec < 26:\n                continue\n        print(\"=\"*50)\n        print(ev.strip())\nEOF\npython3 /tmp/filter_interesting.py\n"]
