Sending keys: ['cat << \'EOF\' > /tmp/collect_malicious.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\n\nmalicious_ids = set()\n\n# Helper to add IDs and print them\ndef add_malicious(event_id, desc):\n    malicious_ids.add(event_id)\n    # print(f"Adding: {event_id} ({desc})")\n\n# 1. Process Creations\n# We know the attacker ran whoami, fodhelper, and powershell\n# Let\'s find all process creation events (1, 4688) on WS-05 with these names\nrows = conn.execute("SELECT event_id, event_code, image, command_line, parent_image FROM events WHERE host LIKE \'%WS-05%\' AND event_code IN (1, 4688)").fetchall()\nfor r in rows:\n    cmd = (r[\'command_line\'] or \'\').lower()\n    img = (r[\'image\'] or \'\').lower()\n    parent = (r[\'parent_image\'] or \'\').lower()\n    \n    # check whoami\n    if \'whoami\' in img or \'whoami\' in cmd:\n        add_malicious(r[\'event_id\'], f"whoami command line: {cmd}")\n        \n    # check fodhelper\n    if \'fodhelper\' in img or \'fodhelper\' in cmd:\n        add_malicious(r[\'event_id\'], f"fodhelper command line: {cmd}")\n        \n    # check powershell\n    # The attacker\'s powershells are:\n    # - the parent powershell running whoami /groups (we don\'t have its creation event, but let\'s check if we have other powershells)\n    # - the powershell spawned by fodhelper to run the update command: $x=$((gp HKCU:Software\\Microsoft\\Windows Update).Update); ...\n    # - the powershell running the encoded stager: -enc SQBGACgAJABQAFM...\n    if \'powershell\' in img or \'powershell\' in cmd:\n        if \'update\' in cmd or \'sqbgacgajabqafm\' in cmd:\n            add_malicious(r[\'event_id\'], f"powershell command line: {cmd[:100]}")\n\n# 2. Registry Events (12, 13)\n# The attacker wrote to and deleted \'ms-settings\' (fodhelper bypass) and \'Software\\Microsoft\\Windows\\Update\'\nrows = conn.execute("SELECT event_id, event_code, target_object, details F