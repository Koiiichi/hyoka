[?2004hroot@d7430fea749f:~# cat << 'EOF' > /tmp/find_malicious_sysmon10.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious source processes we know
[?2004l[?2004h> suspicious_images = ['powershell.exe', 'fodhelper.exe', 'whoami.exe']
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, image, details, message
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example' AND event_code = 10
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> all_10 = cursor.fetchall()
[?2004l[?2004h> print(f"Total Sysmon 10 events on WS-05: {len(all_10)}")
[?2004l[?2004h> 
[?2004l[?2004h> malicious_10 = []
[?2004l[?2004h> for r in all_10:
[?2004l[?2004h>     msg = r['message'] or ""
[?2004l[?2004h>     # We can check SourceImage or target image in message
[?2004l[?2004h>     # Usually message contains: SourceImage: ... TargetImage: ...
[?2004l[?2004h>     source_img = ""
[?2004l[?2004h>     target_img = ""
[?2004l[?2004h>     for line in msg.split('\n'):
[?2004l[?2004h>         if "SourceImage:" in line:
[?2004l[?2004h>             source_img = line.replace("SourceImage:", "").strip()
[?2004l[?2004h>         if "TargetImage:" in line:
[?2004l[?2004h>             target_img = line.replace("TargetImage:", "").strip()
[?2004l[?2004h>     
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     if any(x in source_img.lower() for x in suspicious_images):
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     if any(x in target_img.lower() for x in suspicious_images):
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h> 
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         malicious_10.append(r)
[?2004l[?2004h>         print(f"{r['event_id']} | {r['timestamp']} | Src={source_img} | Target={target_img} | Msg={msg[:120].replace('\n', ' ')}")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total malicious Sysmon 10 events: {len(malicious_10)}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
