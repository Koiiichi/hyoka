[?2004hroot@d7430fea749f:~# cat << 'EOF' > /tmp/dump_clean.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, target_object, details, message, dst_ip, dst_port, src_ip
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> with open('/tmp/clean_all.txt', 'w') as f:
[?2004l[?2004h>     for r in cursor.fetchall():
[?2004l[?2004h>         eid = r['event_id']
[?2004l[?2004h>         ts = r['timestamp']
[?2004l[?2004h>         ec = r['event_code']
[?2004l[?2004h>         host = r['host']
[?2004l[?2004h>         user = r['user'] or ""
[?2004l[?2004h>         img = r['image'] or ""
[?2004l[?2004h>         parent = r['parent_image'] or ""
[?2004l[?2004h>         cl = (r['command_line'] or "").replace('\n', ' ').replace('\r', ' ')
[?2004l[?2004h>         to = (r['target_object'] or "").replace('\n', ' ').replace('\r', ' ')
[?2004l[?2004h>         det = (r['details'] or "").replace('\n', ' ').replace('\r', ' ')
[?2004l[?2004h>         msg = (r['message'] or "").replace('\n', ' ').replace('\r', ' ')
[?2004l[?2004h>         dst_ip = r['dst_ip'] or ""
[?2004l[?2004h>         dst_port = r['dst_port'] or ""
[?2004l[?2004h>         src_ip = r['src_ip'] or ""
[?2004l[?2004h> 
[?2004l[?2004h>         # Standard filters
[?2004l[?2004h>         # Let's filter out standard Windows Defender / svchost / guestagent etc. to make it easier
[?2004l[?2004h>         if ec == 7: # Image load
[?2004l[?2004h>             continue
[?2004l[?2004h>         if ec == 10 and ("svchost.exe" in msg.lower() or "runtimebroker.exe" in msg.lower()):
[?2004l[?2004h>             continue
[?2004l[?2004h>         if "guestagent_" in img.lower() or "guestagent_" in msg.lower():
[?2004l[?2004h>             continue
[?2004l[?2004h>         if "networkwatcher" in img.lower() or "networkwatcher" in msg.lower():
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h>         f.write(f"{eid}|{ts}|{host}|{ec}|{user}|{img}|{parent}|{cl}|{to}|{det}|{msg[:150]}|{dst_ip}:{dst_port}|{src_ip}\n")
[?2004l[?2004h> 
