[?2004l[?2004h>     host = r['host']
[?2004l[?2004h>     user = r['user'] or ""
[?2004l[?2004h>     img = r['image'] or ""
[?2004l[?2004h>     parent = r['parent_image'] or ""
[?2004l[?2004h>     cl = r['command_line'] or ""
[?2004l[?2004h>     to = r['target_object'] or ""
[?2004l[?2004h>     det = r['details'] or ""
[?2004l[?2004h>     msg = r['message'] or ""
[?2004l[?2004h> 
[?2004l[?2004h>     # Filtering known noise
[?2004l[?2004h>     if ec == 7: # Image loaded
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     if ec == 10: # Process access
[?2004l[?2004h>         # Let's ignore if source process is svchost.exe accessing something benign
