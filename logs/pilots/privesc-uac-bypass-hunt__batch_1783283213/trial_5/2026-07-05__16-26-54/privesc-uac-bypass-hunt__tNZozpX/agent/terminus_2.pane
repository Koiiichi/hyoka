[?2004hroot@d7430fea749f:~# cat << 'EOF' > /tmp/get_net_details.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, host, event_code, image, user, src_ip, dst_ip, dst_port, details, message
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE event_code IN (3, 5156, 5158)
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     cl = r['message'] or ""
[?2004l[?2004h>     # Let's filter out known guestagent/networkwatcher/camsvc/cameraupload/etc
[?2004l[?2004h>     if any(x in cl.lower() for x in ['guestagent', 'networkwatcher', 'camsvc', 'monitoring', 'microsoftedge', 'onedrive']):
[?2004l[?2004h>         continue
[?2004l[?2004h>     print(f"{r['event_id']} | {r['timestamp']} | Host={r['host']} | EC={r['event_code']} | Img={r['image']} | Src={r['src_ip']} | Dst={r['dst_ip']}:{r['dst_port']} | Msg={cl.replace('\n', ' ')}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@d7430fea749f:~# python3 /tmp/get_net_details.py
