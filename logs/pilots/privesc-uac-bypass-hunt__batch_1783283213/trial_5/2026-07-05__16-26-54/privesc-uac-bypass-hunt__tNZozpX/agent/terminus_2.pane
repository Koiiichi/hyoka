[?2004hroot@d7430fea749f:~# cat << 'EOF' > /tmp/parse_malicious.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's get all process creations first to find suspicious ones
[?2004l[?2004h> cursor.execute("""
[?2004lthon3 /[?2004h>     SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, process_guid, parent_process_guid
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE event_code IN (1, 4688)
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> processes = cursor.fetchall()
[?2004l[?2004h> suspicious_guids = set()
[?2004l[?2004h> suspicious_images = ['whoami.exe', 'fodhelper.exe', 'powershell.exe', 'cmd.exe', 'conhost.exe']
[?2004l[?2004h> 
[?2004l[?2004h> print("=== PROCESS CREATION EVENTS ===")
[?2004l[?2004h> for p in processes:
[?2004l[?2004h>     img = p['image'] or ""
[?2004l[?2004h>     cl = p['command_line'] or ""
[?2004l[?2004h>     is_suspicious = False
[?2004l[?2004h>     if any(x in img.lower() for x in suspicious_images):
[?2004l[?2004h>         # Filter out standard non-interactive powershell if it's not our target, but wait,
[?2004l[?2004h>         # our malicious stagers are powershell.
[?2004l[?2004h>         is_suspicious = True
[?2004l[?2004h>     
[?2004l[?2004h>     # Any powershell running with -enc, -NoP, or gp HKCU is suspicious
[?2004l[?2004h>     if "powershell" in cl.lower() or "whoami" in cl.lower() or "fodhelper" in cl.lower():
[?2004l[?2004h>         is_suspicious = True
[?2004l[?2004h> 
[?2004l[?2004h>     if is_suspicious:
[?2004l[?2004h>         suspicious_guids.add(p['process_guid'])
[?2004l[?2004h>         print(f"{p['event_id']} | {p['timestamp']} | GUID={p['process_guid']} | ParentGUID={p['parent_process_guid']} | User={p['user']} | Img={img} | CMD={cl[:200]}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== SUSPICIOUS GUIDS PROCESS TREE / RELATED EVENTS ===")
[?2004l[?2004h> # Now, let's select all events matching these suspicious process GUIDs or their parent GUIDs
[?2004l[?2004h> # Also let's include event code 3 (network connections) from these GUIDs or other processes
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, target_object, details, message, process_guid, parent_process_guid, dst_ip, dst_port
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example'
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> all_ws05 = cursor.fetchall()
[?2004l[?2004h> malicious_event_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> for r in all_ws05:
[?2004l[?2004h>     ec = r['event_code']
[?2004l[?2004h>     guid = r['process_guid']
[?2004l[?2004h>     pguid = r['parent_process_guid']
[?2004l[?2004h>     img = r['image'] or ""
[?2004l[?2004h>     cl = r['command_line'] or ""
[?2004l[?2004h>     msg = r['message'] or ""
[?2004l[?2004h>     to = r['target_object'] or ""
[?2004l[?2004h> 
[?2004l[?2004h>     # If the event is directly related to a suspicious GUID
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h> 
[?2004l[?2004h>     if guid in suspicious_guids or pguid in suspicious_guids:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     
[?2004l[?2004h>     # Check network connections (EC=3 or 5156/5158)
[?2004l[?2004h>     if ec in [3, 5156, 5158]:
[?2004l[?2004h>         # Let's see if the destination port/IP is not standard (e.g. not local or azure)
[?2004l[?2004h>         dst_ip = r['dst_ip'] or ""
[?2004l[?2004h>         dst_port = r['dst_port'] or ""
[?2004l[?2004h>         # If it's a connection to port 80/443 or unusual ports from powershell/whoami/fodhelper
[?2004l[?2004h>         if "powershell.exe" in img.lower() or "conhost.exe" in img.lower():
[?2004l[?2004h>             is_malicious = True
[?2004l[?2004h>         if any(x in msg.lower() for x in ['powershell', 'whoami', 'fodhelper']):
[?2004l[?2004h>             is_malicious = True
[?2004l[?2004h> 
[?2004l[?2004h>     # PowerShell script blocks (800, 4103, 4104)
[?2004l[?2004h>     # If they contain the payload strings
[?2004l[?2004h>     if ec in [800, 4103, 4104]:
[?2004l[?2004h>         # Any script block from the user 'CORP\m.ward' or referencing the malicious stager variables
[?2004l[?2004h>         # Wait, how to check user? Let's check context in message or details
[?2004l[?2004h>         # Let's search if the message contains m.ward, or specific malicious terms like '$f94e', 'fodhelper', 'Update', 'GBfR', etc.
[?2004l[?2004h>         if any(x in msg for x in ['$f94e', 'fodhelper', 'Update', 'GBfR', '$script:Headers', '$taskURI', 'Start-Sleep']):
[?2004l[?2004h>             is_malicious = True
[?2004l[?2004h>         if "m.ward" in msg:
[?2004l[?2004h>             is_malicious = True
[?2004l[?2004h> 
[?2004l[?2004h>     # Registry edits (11, 12, 13, 14, 4657)
[?2004l[?2004h>     # If registry target is the UAC bypass registry keys or Windows Update
[?2004l[?2004h>     if ec in [11, 12, 13, 14]:
[?2004l[?2004h>         if any(x in to.lower() for x in ['fodhelper', 'ms-settings', 'windows update', 'software\\microsoft\\windows\\currentversion\\app paths']):
[?2004l[?2004h>             is_malicious = True
[?2004l[?2004h>         if "powershell" in img.lower():
[?2004l[?2004h>             is_malicious = True
[?2004l[?2004h> 
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         malicious_event_ids.add(r['event_id'])
[?2004l[?2004h>         print(f"MALICIOUS: {r['event_id']} | {r['timestamp']} | EC={ec} | GUID={guid} | Img={img} | CMD={cl[:100]} | TO={to[:50]} | Msg={msg[:150]}")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nTotal identified malicious events so far: {len(malicious_event_ids)}")
[?2004l[?2004h> EOF
