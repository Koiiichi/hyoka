[?2004hroot@d7430fea749f:~# cat << 'EOF' > /tmp/ws06_events.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, details, message
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-06.corp.example'
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Total events on WS-06: {len(rows)}")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     ec = r['event_code']
[?2004l[?2004h>     cl = r['command_line'] or ""
[?2004l[?2004h>     to = r['target_object'] or ""
[?2004l[?2004h>     msg = r['message'] or ""
[?2004l[?2004h>     print(f"{r['event_id']} | {r['timestamp']} | EC={ec} | Img={r['image']} | Parent={r['parent_image']} | CMD={cl[:80]} | TO={to[:50]} | Msg={msg[:150].replace('\n', ' ')}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
