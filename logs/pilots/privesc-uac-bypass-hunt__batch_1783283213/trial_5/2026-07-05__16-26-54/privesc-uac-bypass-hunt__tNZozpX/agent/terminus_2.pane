[?2004hroot@d7430fea749f:~# cat << 'EOF' > /tmp/trace_ws05.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's list some key events on WS-05
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, details, message, dst_ip, dst_port, src_ip
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example'
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> events = cursor.fetchall()
[?2004l[?2004h> print(f"Total events on WS-05: {len(events)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's group them or filter for interesting events
[?2004l[?2004h> # Interested in: Process creation (1, 4688), network connection (3, 5156, 5158), registry (11, 12, 13, 14, 4656, 4663, 4658, 4690), PowerShell (4103, 4104, 800, 400), WMI/Service/Privileges
[?2004l[?2004h> 
[?2004l[?2004h> with open('/tmp/ws05_filtered.txt', 'w') as f:
[?2004l[?2004h>     for ev in events:
[?2004l[?2004h>         ec = ev['event_code']
[?2004l[?2004h>         # Let's ignore very noisy events unless they are related
[?2004l[?2004h>         # Event code 7 is image load, 10 is process access (very common for lsass/svchost)
[?2004l[?2004h>         # Event code 4656/4658/4663/4690 is file/object access, can be noisy but let's see
[?2004l[?2004h>         # Let's print process creation, network, registry (if not standard noise), and powershell
[?2004l[?2004h>         img = ev['image'] or ""
[?2004l[?2004h>         cl = ev['command_line'] or ""
[?2004l[?2004h>         to = ev['target_object'] or ""
[?2004l[?2004h>         det = ev['details'] or ""
[?2004l[?2004h>         msg = ev['message'] or ""
[?2004l[?2004h> 
[?2004l[?2004h>         # Filter out obvious benign noise from C:\Windows\System32\svchost.exe, C:\Windows\servicing\TrustedInstaller.exe, TiWorker.exe etc
[?2004l[?2004h>         if ec in [7]:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if ec == 10 and "lsass.exe" in msg:
[?2004l[?2004h>             # Process access on lsass is interesting, but let's only write if source is not standard
[?2004l[?2004h>             if "SourceImage: C:\Windows\System32\svchost.exe" in msg:
[?2004l[?2004h>                 continue
[?2004l[?2004h>         
[?2004l[?2004h>         f.write(f"{ev['event_id']} | {ev['timestamp']} | EC={ec} | User={ev['user']} | Img={img} | Parent={ev['parent_image']} | CMD={cl} | TargetObj={to} | Det={det} | Msg={msg[:200].replace('\n', ' ')}\n")
[?2004l[?2004h> 
[?2004l[?2004h> print("Written trace to /tmp/ws05_filtered.txt")
[?2004l[?2004h> EOF
