[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> interesting_count = 0
[?2004l[?2004h> for r in rows:
