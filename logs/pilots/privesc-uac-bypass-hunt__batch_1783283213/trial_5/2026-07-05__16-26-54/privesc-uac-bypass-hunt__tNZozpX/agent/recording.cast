[17.785147, "i", "cat << 'EOF' > /tmp/analyze_all.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Event Counts by Host and Event Code ===\")\ncursor.execute(\"SELECT host, event_code, COUNT(*) FROM events GROUP BY host, event_code ORDER BY host, event_code;\")\nfor r in cursor.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]}\")\n\nprint(\"\\n=== Details of DC01 events ===\")\ncursor.execute(\"SELECT event_id, timestamp, event_code, user, target_user, image, command_line, service_name, service_file_name, message FROM events WHERE host = 'DC01.corp.example' ORDER BY timestamp;\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['event_code']} | {r['user']} | {r['image']} | {r['command_line'] or r['service_name'] or r['message'][:200]}\")\n\nprint(\"\\n=== Details of WS-06 events ===\")\ncursor.execute(\"SELECT event_id, timestamp, event_code, user, target_user, image, command_line, service_name, service_file_name, message FROM events WHERE host = 'WS-06.corp.example' ORDER BY timestamp;\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['event_code']} | {r['user']} | {r['image']} | {r['command_line'] or r['service_name'] or r['message'][:200]}\")\n\nEOF\npython3 /tmp/analyze_all.py\n"]
