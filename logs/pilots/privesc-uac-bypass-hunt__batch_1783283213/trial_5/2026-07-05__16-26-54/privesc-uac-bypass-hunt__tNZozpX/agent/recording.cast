[268.751993, "i", "cat << 'EOF' > /tmp/check_defender.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, provider, message\n    FROM events\n    WHERE provider LIKE '%Defender%'\n       OR provider LIKE '%Antivirus%'\n       OR message LIKE '%Defender%'\n       OR message LIKE '%Antivirus%'\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total Defender events: {len(rows)}\")\nfor r in rows:\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['provider']} | EC={r['event_code']} | Msg={r['message'][:200].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/check_defender.py\n"]
