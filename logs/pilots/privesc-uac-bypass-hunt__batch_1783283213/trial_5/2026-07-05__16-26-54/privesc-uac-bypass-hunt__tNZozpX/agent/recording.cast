[109.241591, "i", "cat << 'EOF' > /tmp/trace_elevated_powershell.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, target_object, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND (\n        process_guid = '{3ddc5665-ed08-5f51-f302-000000000500}' OR\n        parent_process_guid = '{3ddc5665-ed08-5f51-f302-000000000500}'\n    )\n    ORDER BY timestamp;\n\"\"\")\n\nfor r in cursor.fetchall():\n    cl = r['command_line'] or \"\"\n    msg = r['message'] or \"\"\n    to = r['target_object'] or \"\"\n    print(f\"{r['event_id']} | {r['timestamp']} | EC={r['event_code']} | Img={r['image']} | CMD={cl[:80]} | TO={to[:50]} | Msg={msg[:120].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/trace_elevated_powershell.py\n"]
