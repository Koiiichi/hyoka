[92.248839, "i", "cat << 'EOF' > /tmp/registry_changes_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, target_object, details, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (12, 13, 14, 4657)\n\"\"\")\n\nfor r in cursor.fetchall():\n    to = r['target_object'] or \"\"\n    det = r['details'] or \"\"\n    msg = r['message'] or \"\"\n    if any(x in to.lower() or x in det.lower() or x in msg.lower() for x in ['ms-settings', 'windows update', 'classes\\\\ms-settings', 'delegateexecute']):\n        print(f\"{r['event_id']} | {r['timestamp']} | EC={r['event_code']} | Img={r['image']} | TO={to} | Det={det[:120]} | Msg={msg[:120].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/registry_changes_details.py\n"]
[92.24935, "o", "cat << 'EOF' > /tmp/registry_changes_details.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
