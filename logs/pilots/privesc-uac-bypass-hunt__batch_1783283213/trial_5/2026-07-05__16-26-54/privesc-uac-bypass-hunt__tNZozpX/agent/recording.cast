[57.980286, "i", "cat << 'EOF' > /tmp/trace_from_305.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's select all events from WS-05 with timestamp >= 2026-05-06T00:00:25Z\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, details, message, process_guid, parent_process_guid\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND timestamp >= '2026-05-06T00:00:25Z'\n    ORDER BY timestamp;\n\"\"\")\n\nfor r in cursor.fetchall():\n    ec = r['event_code']\n    if ec in [7]:\n        continue\n    # print nicely\n    img = r['image'] or \"\"\n    pimg = r['parent_image'] or \"\"\n    cl = (r['command_line'] or \"\").replace('\\n', ' ')\n    msg = (r['message'] or \"\").replace('\\n', ' ')\n    to = r['target_object'] or \"\"\n    guid = r['process_guid'] or \"\"\n    pguid = r['parent_process_guid'] or \"\"\n    print(f\"{r['event_id']} | {r['timestamp']} | EC={ec} | GUID={guid[:10]} | PGUID={pguid[:10]} | Img={img} | Parent={pimg} | CMD={cl[:100]} | TO={to[:50]} | Msg={msg[:120]}\")\n\nEOF\npython3 /tmp/trace_from_305.py > /tmp/trace_after_305.txt\ncat /tmp/trace_after_305.txt\n"]
