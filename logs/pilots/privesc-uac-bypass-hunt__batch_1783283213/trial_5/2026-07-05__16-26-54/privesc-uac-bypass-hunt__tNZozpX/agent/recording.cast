[47.755708, "i", "cat << 'EOF' > /tmp/dump_clean.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, target_object, details, message, dst_ip, dst_port, src_ip\n    FROM events\n    ORDER BY timestamp;\n\"\"\")\n\nwith open('/tmp/clean_all.txt', 'w') as f:\n    for r in cursor.fetchall():\n        eid = r['event_id']\n        ts = r['timestamp']\n        ec = r['event_code']\n        host = r['host']\n        user = r['user'] or \"\"\n        img = r['image'] or \"\"\n        parent = r['parent_image'] or \"\"\n        cl = (r['command_line'] or \"\").replace('\\n', ' ').replace('\\r', ' ')\n        to = (r['target_object'] or \"\").replace('\\n', ' ').replace('\\r', ' ')\n        det = (r['details'] or \"\").replace('\\n', ' ').replace('\\r', ' ')\n        msg = (r['message'] or \"\").replace('\\n', ' ').replace('\\r', ' ')\n        dst_ip = r['dst_ip'] or \"\"\n        dst_port = r['dst_port'] or \"\"\n        src_ip = r['src_ip'] or \"\"\n\n        # Standard filters\n        # Let's filter out standard Windows Defender / svchost / guestagent etc. to make it easier\n        if ec == 7: # Image load\n            continue\n        if ec == 10 and (\"svchost.exe\" in msg.lower() or \"runtimebroker.exe\" in msg.lower()):\n            continue\n        if \"guestagent_\" in img.lower() or \"guestagent_\" in msg.lower():\n            continue\n        if \"networkwatcher\" in img.lower() or \"networkwatcher\" in msg.lower():\n            continue\n\n        f.write(f\"{eid}|{ts}|{host}|{ec}|{user}|{img}|{parent}|{cl}|{to}|{det}|{msg[:150]}|{dst_ip}:{dst_port}|{src_ip}\\n\")\n\nprint(\"Written out to /tmp/clean_all.txt\")\nEOF\npython3 /tmp/dump_clean.py\nwc -l /tmp/clean_all.txt\n"]
