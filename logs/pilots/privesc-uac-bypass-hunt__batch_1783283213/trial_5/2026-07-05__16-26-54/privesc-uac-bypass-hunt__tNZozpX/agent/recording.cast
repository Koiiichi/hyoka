[69.920193, "i", "cat << 'EOF' > /tmp/parse_malicious.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's get all process creations first to find suspicious ones\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, process_guid, parent_process_guid\n    FROM events\n    WHERE event_code IN (1, 4688)\n    ORDER BY timestamp;\n\"\"\")\n\nprocesses = cursor.fetchall()\nsuspicious_guids = set()\nsuspicious_images = ['whoami.exe', 'fodhelper.exe', 'powershell.exe', 'cmd.exe', 'conhost.exe']\n\nprint(\"=== PROCESS CREATION EVENTS ===\")\nfor p in processes:\n    img = p['image'] or \"\"\n    cl = p['command_line'] or \"\"\n    is_suspicious = False\n    if any(x in img.lower() for x in suspicious_images):\n        # Filter out standard non-interactive powershell if it's not our target, but wait,\n        # our malicious stagers are powershell.\n        is_suspicious = True\n    \n    # Any powershell running with -enc, -NoP, or gp HKCU is suspicious\n    if \"powershell\" in cl.lower() or \"whoami\" in cl.lower() or \"fodhelper\" in cl.lower():\n        is_suspicious = True\n\n    if is_suspicious:\n        suspicious_guids.add(p['process_guid'])\n        print(f\"{p['event_id']} | {p['timestamp']} | GUID={p['process_guid']} | ParentGUID={p['parent_process_guid']} | User={p['user']} | Img={img} | CMD={cl[:200]}\")\n\nprint(\"\\n=== SUSPICIOUS GUIDS PROCESS TREE / RELATED EVENTS ===\")\n# Now, let's select all events matching these suspicious process GUIDs or their parent GUIDs\n# Also let's include event code 3 (network connections) from these GUIDs or other processes\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, target_object, details, message, process_guid, parent_process_guid, dst_ip, dst_port\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n    ORDER BY timestamp;\n\"\"\")\n\nall_ws05 = cursor.fetchall()\nmalicious_event_ids = set()\n\nfor r in all_ws05:\n    ec = r['event_code']\n    guid = r['process_guid']\n    pguid = r['parent_process_guid']\n    img = r['image'] or \"\"\n    cl = r['command_line'] or \"\"\n    msg = r['message'] or \"\"\n    to = r['target_object'] or \"\"\n\n    # If the event is directly related to a suspicious GUID\n    is_malicious = False\n\n    if guid in suspicious_guids or pguid in suspicious_guids:\n        is_malicious = True\n    \n    # Check network connections (EC=3 or 5156/5158)\n    if ec in [3, 5156, 5158]:\n        # Let's see if the destination port/IP is not standard (e.g. not local or azure)\n        dst_ip = r['dst_ip'] or \"\"\n        dst_port = r['dst_port'] or \"\"\n        # If it's a connection to port 80/443 or unusual ports from powershell/whoami/fodhelper\n        if \"powershell.exe\" in img.lower() or \"conhost.exe\" in img.lower():\n            is_malicious = True\n        if any(x in msg.lower() for x in ['powershell', 'whoami', 'fodhelper']):\n            is_malicious = True\n\n    # PowerShell script blocks (800, 4103, 4104)\n    # If they contain the payload strings\n    if ec in [800, 4103, 4104]:\n        # Any script block from the user 'CORP\\m.ward' or referencing the malicious stager variables\n        # Wait, how to check user? Let's check context in message or details\n        # Let's search if the message contains m.ward, or specific malicious terms like '$f94e', 'fodhelper', 'Update', 'GBfR', etc.\n        if any(x in msg for x in ['$f94e', 'fodhelper', 'Update', 'GBfR', '$script:Headers', '$taskURI', 'Start-Sleep']):\n            is_malicious = True\n        if \"m.ward\" in msg:\n            is_malicious = True\n\n    # Registry edits (11, 12, 13, 14, 4657)\n    # If registry target is the UAC bypass registry keys or Windows Update\n    if ec in [11, 12, 13, 14]:\n        if any(x in to.lower() for x in ['fodhelper', 'ms-settings', 'windows update', 'software\\\\microsoft\\\\windows\\\\currentversion\\\\app paths']):\n            is_malicious = True\n        if \"powershell\" in img.lower():\n            is_malicious = True\n\n    if is_malicious:\n        malicious_event_ids.add(r['event_id'])\n  "]
[69.920321, "i", "      print(f\"MALICIOUS: {r['event_id']} | {r['timestamp']} | EC={ec} | GUID={guid} | Img={img} | CMD={cl[:100]} | TO={to[:50]} | Msg={msg[:150]}\")\n\nprint(f\"\\nTotal identified malicious events so far: {len(malicious_event_ids)}\")\nEOF\npython3 /tmp/parse_malicious.py > /tmp/malicious_list.txt\nhead -n 100 /tmp/malicious_list.txt\n"]
