[115.114493, "o", "\u001b[?2004hroot@d7430fea749f:~# "]
[120.021111, "i", "cat << 'EOF' > /tmp/find_dns.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, host, event_code, image, message, details\n    FROM events\n    WHERE event_code = 22 OR message LIKE '%dns%'\n    ORDER BY timestamp;\n\"\"\")\n\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | Host={r['host']} | Img={r['image']} | Msg={r['message'].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/find_dns.py\n"]
[120.022446, "o", "cat << 'EOF' > /tmp/find_dns.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, host, event_code, image, message, details\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events\r\n\u001b[?2004l\r\u001b[?2004h>     WHERE event_code = 22 OR message LIKE '%dns%'\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r['event_id']} | {r['timestamp']} | Host={r['host']} | Img={r['image']} | Msg={r['message'].replace('\\n', ' ')}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
