[250.779767, "o", "\u001b[?2004hroot@d7430fea749f:~# "]
[257.306393, "i", "cat << 'EOF' > /tmp/ws05_file_ids.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, target_object, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code = 11\n    ORDER BY timestamp;\n\"\"\")\n\nfor r in cursor.fetchall():\n    msg = r['message'] or \"\"\n    to = r['target_object'] or \"\"\n    img = r['image'] or \"\"\n    print(f\"{r['event_id']} | {r['timestamp']} | Img={img} | Msg={msg[:180].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/ws05_file_ids.py\n"]
[257.306863, "o", "cat << 'EOF' > /tmp/ws05_file_ids.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
