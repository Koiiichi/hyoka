[268.773617, "o", "\u001b[?2004hroot@d7430fea749f:~# "]
[276.774608, "i", "cat << 'EOF' > /tmp/find_malicious_sysmon10.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Malicious source processes we know\nsuspicious_images = ['powershell.exe', 'fodhelper.exe', 'whoami.exe']\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, details, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code = 10\n\"\"\")\n\nall_10 = cursor.fetchall()\nprint(f\"Total Sysmon 10 events on WS-05: {len(all_10)}\")\n\nmalicious_10 = []\nfor r in all_10:\n    msg = r['message'] or \"\"\n    # We can check SourceImage or target image in message\n    # Usually message contains: SourceImage: ... TargetImage: ...\n    source_img = \"\"\n    target_img = \"\"\n    for line in msg.split('\\n'):\n        if \"SourceImage:\" in line:\n            source_img = line.replace(\"SourceImage:\", \"\").strip()\n        if \"TargetImage:\" in line:\n            target_img = line.replace(\"TargetImage:\", \"\").strip()\n    \n    is_malicious = False\n    if any(x in source_img.lower() for x in suspicious_images):\n        is_malicious = True\n    if any(x in target_img.lower() for x in suspicious_images):\n        is_malicious = True\n\n    if is_malicious:\n        malicious_10.append(r)\n        print(f\"{r['event_id']} | {r['timestamp']} | Src={source_img} | Target={target_img} | Msg={msg[:120].replace('\\n', ' ')}\")\n\nprint(f\"Total malicious Sysmon 10 events: {len(malicious_10)}\")\n\nEOF\npython3 /tmp/find_malicious_sysmon10.py\n"]
[276.77508, "o", "cat << 'EOF' > /tmp/find_malicious_sysmon10.py\r\n\u001b[?2004l\r"]
