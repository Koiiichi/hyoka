[257.308526, "o", "cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, event_code, image, target_object, message\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events\r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'WS-05.corp.example' AND event_code = 11\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     msg = r['message'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     to = r['target_object'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     img = r['image'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r['event_id']} | {r['timestamp']} | Img={img} | Msg={msg[:180].replace('\\n', ' ')}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
