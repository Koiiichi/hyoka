[115.096061, "o", "\u001b[?2004h>     FROM events\r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'WS-05.corp.example' AND (\r\n\u001b[?2004l\r\u001b[?2004h>         process_guid = '{3ddc5665-ed08-5f51-f302-000000000500}' OR\r\n\u001b[?2004l\r\u001b[?2004h>         parent_process_guid = '{3ddc5665-ed08-5f51-f302-000000000500}'\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     cl = r['command_line'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     msg = r['message'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     to = r['target_object'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     det = r['details'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     ec = r['event_code']\r\n\u001b[?2004l\r\u001b[?2004h>     dst = f\"{r['dst_ip']}:{r['dst_port']}\" if r['dst_ip'] else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r['event_id']} | {r['timestamp']} | EC={ec} | Img={r['image']} | CMD={cl[:100]} | TO={to[:50]} | Dst={dst} | Msg={msg[:200].replace('\\n', ' ')}\") \r\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[