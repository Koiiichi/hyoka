[124.206804, "i", "cat << 'EOF' > /tmp/dns_exact.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, host, event_code, image, details, message\n    FROM events\n    WHERE event_code = 22\n    ORDER BY timestamp;\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total DNS query events (EC=22): {len(rows)}\")\nfor r in rows:\n    print(f\"{r['event_id']} | {r['timestamp']} | Host={r['host']} | Img={r['image']} | Det={r['details']} | Msg={r['message'].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/dns_exact.py\n"]
