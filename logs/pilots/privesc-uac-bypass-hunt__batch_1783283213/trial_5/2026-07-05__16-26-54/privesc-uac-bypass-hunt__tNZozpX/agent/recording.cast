[80.725796, "i", "cat << 'EOF' > /tmp/find_all_correlated.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Find any events related to {3ddc5665-e80d-5f51-2501-000000000500}\n# Let's search for this GUID in process_guid, parent_process_guid, or message/details\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, target_object, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND (\n        process_guid = '{3ddc5665-e80d-5f51-2501-000000000500}' OR\n        parent_process_guid = '{3ddc5665-e80d-5f51-2501-000000000500}' OR\n        message LIKE '%{3ddc5665-e80d-5f51-2501-000000000500}%' OR\n        details LIKE '%{3ddc5665-e80d-5f51-2501-000000000500}%'\n    )\n    ORDER BY timestamp;\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total direct events found: {len(rows)}\")\nfor r in rows:\n    cl = r['command_line'] or \"\"\n    msg = r['message'] or \"\"\n    to = r['target_object'] or \"\"\n    print(f\"{r['event_id']} | {r['timestamp']} | EC={r['event_code']} | Img={r['image']} | CMD={cl[:80]} | TO={to[:50]} | Msg={msg[:120].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/find_all_correlated.py\n"]
[80.726249, "o", "cat << 'EOF' > /tmp/find_all_correlated.py\r\n\u001b[?2004l\r"]
[80.727228, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Find any events related to {3ddc5665-e80d-5f51-2501-000000000500}\r\n\u001b[?2004l\r\u001b[?2004h> # Let's search for this GUID in process_guid, parent_process_guid, or message/details\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, target_object, message\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events\r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'WS-05.corp.example' AND (\r\n\u001b[?2004l\r\u001b[?2004h>         process_guid = '{3ddc5665-e80d-5f51-2501-000000000500}' OR\r\n\u001b[?2004l\r\u001b[?2004h> "]
