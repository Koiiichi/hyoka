[172.999259, "i", "cat << 'EOF' > /tmp/ws06_process.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, parent_image, command_line\n    FROM events\n    WHERE host = 'WS-06.corp.example' AND event_code IN (1, 4688)\n    ORDER BY timestamp;\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total Process Creations on WS-06: {len(rows)}\")\nfor r in rows:\n    print(f\"{r['event_id']} | {r['timestamp']} | Img={r['image']} | CMD={r['command_line']}\")\n\nEOF\npython3 /tmp/ws06_process.py\n"]
[172.999872, "o", "cat << 'EOF' > /tmp/ws06_process.py\r\n\u001b[?2004l\r"]
