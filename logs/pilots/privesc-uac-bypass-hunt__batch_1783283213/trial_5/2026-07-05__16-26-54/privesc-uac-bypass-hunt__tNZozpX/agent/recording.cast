[12.938253, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\nimport json\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's search for PowerShell script execution or anything containing m.ward\nprint(\"--- PROCESS CREATION EVENTS AND SUSPICIOUS CMDLINES ---\")\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, image, command_line\n    FROM events\n    WHERE event_code IN (1, 4688)\n    ORDER BY timestamp\n\"\"\")\nfor row in cursor.fetchall():\n    cmd = row['command_line'] or \"\"\n    if any(x in cmd.lower() for x in ['powershell', 'bypass', 'whoami', 'fodhelper', 'update', 'enc', 'gbfrb']):\n        print(f\"{row['event_id']} | {row['timestamp']} | {row['event_code']} | {row['host']} | {row['user']} | {row['image']} | {cmd[:200]}\")\n\nEOF\npython3 /tmp/analyze.py\n"]
[12.94038, "o", "cat << 'EOF' > /tmp/analyze.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import base64\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's search for PowerShell script execution or anything containing m.ward\r\n\u001b[?2004l\r\u001b[?2004h> print(\"--- PROCESS CREATION EVENTS AND SUSPICIOUS CMDLINES ---\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, event_code, host, user, image, command_line\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events\r\n\u001b[?2004l\r\u001b[?2004h>     WHERE event_code IN (1, 4688)\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = row['command_line'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if any(x in cmd.lower() for x in ['powershell', 'bypass', 'whoami', 'fodhelper', 'update', 'enc', 'gbfrb']):\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"{row['event_id']} | {row['timestamp']} | {row['event_code']} | {row['host']} | {row['user']} | {row['image']} | {cmd[:200]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
