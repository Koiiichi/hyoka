[338.799983, "i", "cat << 'EOF' > /tmp/ws05_4673.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code = 4673\n    ORDER BY timestamp;\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total 4673 events: {len(rows)}\")\nfor r in rows:\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['user']} | Msg={r['message'][:150].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/ws05_4673.py\n"]
