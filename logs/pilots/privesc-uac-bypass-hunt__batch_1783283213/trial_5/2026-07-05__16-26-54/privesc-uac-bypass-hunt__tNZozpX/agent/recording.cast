[17.80282, "o", "\u001b[?2004hroot@d7430fea749f:~# "]
[25.134782, "i", "cat << 'EOF' > /tmp/trace_ws05.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's list some key events on WS-05\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, details, message, dst_ip, dst_port, src_ip\n    FROM events \n    WHERE host = 'WS-05.corp.example'\n    ORDER BY timestamp;\n\"\"\")\n\nevents = cursor.fetchall()\nprint(f\"Total events on WS-05: {len(events)}\")\n\n# Let's group them or filter for interesting events\n# Interested in: Process creation (1, 4688), network connection (3, 5156, 5158), registry (11, 12, 13, 14, 4656, 4663, 4658, 4690), PowerShell (4103, 4104, 800, 400), WMI/Service/Privileges\n\nwith open('/tmp/ws05_filtered.txt', 'w') as f:\n    for ev in events:\n        ec = ev['event_code']\n        # Let's ignore very noisy events unless they are related\n        # Event code 7 is image load, 10 is process access (very common for lsass/svchost)\n        # Event code 4656/4658/4663/4690 is file/object access, can be noisy but let's see\n        # Let's print process creation, network, registry (if not standard noise), and powershell\n        img = ev['image'] or \"\"\n        cl = ev['command_line'] or \"\"\n        to = ev['target_object'] or \"\"\n        det = ev['details'] or \"\"\n        msg = ev['message'] or \"\"\n\n        # Filter out obvious benign noise from C:\\Windows\\System32\\svchost.exe, C:\\Windows\\servicing\\TrustedInstaller.exe, TiWorker.exe etc\n        if ec in [7]:\n            continue\n        if ec == 10 and \"lsass.exe\" in msg:\n            # Process access on lsass is interesting, but let's only write if source is not standard\n            if \"SourceImage: C:\\Windows\\System32\\svchost.exe\" in msg:\n                continue\n        \n        f.write(f\"{ev['event_id']} | {ev['timestamp']} | EC={ec} | User={ev['user']} | Img={img} | Parent={ev['parent_image']} | CMD={cl} | TargetObj={to} | Det={det} | Msg={msg[:200].replace('\\n', ' ')}\\n\")\n\nprint(\"Written trace to /tmp/ws05_filtered.txt\")\nEOF\npython3 /tmp/trace_ws05.py\n"]
[25.135333, "o", "cat << 'EOF' > /tmp/trace_ws05.py\r\n\u001b[?2004l\r"]
[25.135395, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
[25.135501, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.135542, "o", "\u001b[?2004h> "]
[25.135957, "o", "conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.136004, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's list some key events on WS-05\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.136364, "o", "    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, details, message, dst_ip, dst_port, src_ip\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.136422, "o", "    WHERE host = 'WS-05.corp.example'\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.136516, "o", "events = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.136722, "o", "print(f\"Total events on WS-05: {len(events)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.136766, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Let's group them or filter for interesting events\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.136973, "o", "# Interested in: Process creation (1, 4688), network connection (3, 5156, 5158), registry (11, 12, 13, 14, 4656, 4663, 4658, 4690), PowerShell (4103, 4104, 800, 400), WMI/Service/Privileges\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.137036, "o", "with open('/tmp/ws05_filtered.txt', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for ev in events:\r\n\u001b[?2004l\r"]
[25.137129, "o", "\u001b[?2004h>         ec = ev['event_code']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.137224, "o", "        # Let's ignore very noisy events unless they are related\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.137253, "o", "> "]
[25.1375, "o", "        # Event code 7 is image load, 10 is process access (very common for lsass/svchost)\r\n\u001b[?2004l\r\u001b[?2004h>         # Event code 4656/4658/4663/4690 is file/object access, can be noisy but let's see\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.137678, "o", "        # Let's print process creation, network, registry (if not standard noise), and powershell\r\n\u001b[?2004l\r\u001b[?2004h>         img = ev['image'] or \"\"\r\n\u001b[?2004l\r"]
[25.137837, "o", "\u001b[?2004h>         cl = ev['command_line'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         to = ev['target_object'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.138197, "o", "        det = ev['details'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         msg = ev['message'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         # Filter out obvious benign noise from C:\\Windows\\System32\\svchost.exe, C:\\Windows\\servicing\\TrustedInstaller.exe, TiWorker.exe etc\r\n\u001b[?2004l\r\u001b[?2004h>         if ec in [7]:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.138416, "o", "        if ec == 10 and \"lsass.exe\" in msg:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.1385, "o", "            # Process access on lsass is interesting, but let's only write if source is not standard\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.138572, "o", "            if \"SourceImage: C:\\Windows\\System32\\svchost.exe\" in msg:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.138709, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.138886, "o", "        f.write(f\"{ev['event_id']} | {ev['timestamp']} | EC={ec} | User={ev['user']} | Img={img} | Parent={ev['parent_image']} | CMD={cl} | TargetObj={to} | Det={det} | Msg={msg[:200].replace('\\n', ' ')}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.138975, "o", "print(\"Written trace to /tmp/ws05_filtered.txt\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[25.139772, "o", "\u001b[?2004hroot@d7430fea749f:~# python3 /tmp/trace_ws05.py\r\n\u001b[?2004l\r"]
[25.146271, "o", "/tmp/trace_ws05.py:40: SyntaxWarning: invalid escape sequence '\\W'\r\n  if \"SourceImage: C:\\Windows\\System32\\svchost.exe\" in msg:\r\n"]
[25.165573, "o", "Total events on WS-05: 3964\r\n"]
[25.168951, "o", "Written trace to /tmp/ws05_filtered.txt\r\n"]
[25.171271, "o", "\u001b[?2004hroot@d7430fea749f:~# "]
[26.153541, "i", "head -n 100 /tmp/ws05_filtered.txt\n"]
[26.154064, "o", "head -n 100 /tmp/ws05_filtered.txt\r\n\u001b[?2004l\r"]
