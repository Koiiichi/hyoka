[276.797634, "o", "Total malicious Sysmon 10 events: 259\r\n"]
[276.799536, "o", "\u001b[?2004hroot@d7430fea749f:~# "]
[290.817079, "i", "cat << 'EOF' > /tmp/collect_candidates.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's write out candidates into distinct groups\n# 1. PROCESS CREATION (EC 1, 4688) for malicious processes\nsuspicious_images = ['whoami.exe', 'fodhelper.exe', 'powershell.exe', 'conhost.exe']\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, command_line, process_guid, parent_process_guid\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (1, 4688)\n\"\"\")\nproc_events = []\nproc_guids = set()\nfor r in cursor.fetchall():\n    cl = r['command_line'] or \"\"\n    img = r['image'] or \"\"\n    # filter out Appinfo svchost or consent.exe or other benign ones\n    if any(x in img.lower() or x in cl.lower() for x in suspicious_images):\n        proc_events.append(r['event_id'])\n        if r['process_guid']:\n            proc_guids.add(r['process_guid'])\n\nprint(\"Malicious Process Creations:\", len(proc_events), sorted(proc_events))\n\n# 2. REGISTRY HIJACKS & CLEANUP (EC 12, 13, 14)\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, target_object, details\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (12, 13, 14)\n\"\"\")\nreg_events = []\nfor r in cursor.fetchall():\n    to = r['target_object'] or \"\"\n    img = r['image'] or \"\"\n    # If registry modification is by powershell or is on ms-settings / Update\n    if \"powershell\" in img.lower() or any(x in to.lower() for x in ['ms-settings', 'windows\\\\update', 'windows\\update']):\n        reg_events.append(r['event_id'])\n\nprint(\"Malicious Registry Events:\", len(reg_events), sorted(reg_events))\n\n# 3. NETWORK CONNECTIONS (EC 3, 5156, 5158)\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, dst_ip, dst_port, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (3, 5156, 5158)\n\"\"\")\nnet_events = []\nfor r in cursor.fetchall():\n    img = r['image'] or \"\"\n    msg = r['message'] or \"\"\n    # If network connection is by powershell or references 10.10.10.5\n    if \"powershell\" in img.lower() or \"10.10.10.5\" in msg or \"10.10.10.5\" in (r['dst_ip'] or \"\"):\n        net_events.append(r['event_id'])\n\nprint(\"Malicious Network Events:\", len(net_events), sorted(net_events))\n\n# 4. POWERSHELL SCRIPT BLOCKS (EC 800, 4103, 4104)\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103, 4104)\n\"\"\")\nps_events = []\nfor r in cursor.fetchall():\n    msg = r['message'] or \"\"\n    # If the message is non-empty and contains stager/beacon commands or was run by CORP\\m.ward\n    if msg != \"\":\n        ps_events.append(r['event_id'])\n\nprint(\"Malicious PowerShell Events:\", len(ps_events))\n\n# 5. FILE CREATIONS (EC 11)\ncursor.execute(\"\"\"\n    SELECT event_id, image, target_object, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code = 11\n\"\"\")\nfile_events = []\nfor r in cursor.fetchall():\n    img = r['image'] or \"\"\n    msg = r['message'] or \"\"\n    # policy test files created by powershell\n    if \"powershell\" in img.lower() and \"__psscriptpolicytest\" in msg.lower():\n        file_events.append(r['event_id'])\n\nprint(\"Malicious File Events (PSScriptPolicyTest):\", len(file_events), sorted(file_events))\n\nEOF\npython3 /tmp/collect_candidates.py\n"]
