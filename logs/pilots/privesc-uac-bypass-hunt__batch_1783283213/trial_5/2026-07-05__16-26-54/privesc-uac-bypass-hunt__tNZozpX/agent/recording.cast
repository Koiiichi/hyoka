[17.787402, "o", "cursor.execute(\"SELECT event_id, timestamp, event_code, user, target_user, image, command_line, service_name, service_file_name, message FROM events WHERE host = 'DC01.corp.example' ORDER BY timestamp;\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r['event_id']} | {r['timestamp']} | {r['event_code']} | {r['user']} | {r['image']} | {r['command_line'] or r['service_name'] or r['message'][:200]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== Details of WS-06 events ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, timestamp, event_code, user, target_user, image, command_line, service_name, service_file_name, message FROM events WHERE host = 'WS-06.corp.example' ORDER BY timestamp;\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r['event_id']} | {r['timestamp']} | {r['event_code']} | {r['user']} | {r['image']} | {r['command_line'] or r['service_name'] or r['message'][:200]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
