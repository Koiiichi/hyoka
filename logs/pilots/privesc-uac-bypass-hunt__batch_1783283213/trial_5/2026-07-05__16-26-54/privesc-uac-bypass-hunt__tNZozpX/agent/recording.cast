[69.929987, "o", "        if any(x in to.lower() for x in ['fodhelper', 'ms-settings', 'windows update', 'software\\\\microsoft\\\\windows\\\\currentversion\\\\app paths']):\r\n\u001b[?2004l\r\u001b[?2004h>             is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         if \"powershell\" in img.lower():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.93015, "o", "            is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if is_malicious:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_event_ids.add(r['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.930286, "o", "        print(f\"MALICIOUS: {r['event_id']} | {r['timestamp']} | EC={ec} | GUID={guid} | Img={img} | CMD={cl[:100]} | TO={to[:50]} | Msg={msg[:150]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.930476, "o", "print(f\"\\nTotal identified malicious events so far: {len(malicious_event_ids)}\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
