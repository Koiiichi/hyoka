[333.308888, "i", "cat << 'EOF' > /tmp/ws05_logons_privs.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, target_user, details, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (4624, 4672, 4673, 4674)\n    ORDER BY timestamp;\n\"\"\")\n\nfor r in cursor.fetchall():\n    msg = r['message'] or \"\"\n    user = r['user'] or r['target_user'] or \"\"\n    print(f\"{r['event_id']} | {r['timestamp']} | EC={r['event_code']} | User={user} | Msg={msg[:150].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/ws05_logons_privs.py\n"]
