[26.155669, "o", "00108 | 2026-05-06T00:00:13.062Z | EC=10 | User= | Img=C:\\windows\\system32\\svchost.exe | Parent= | CMD= | TargetObj= | Det= | Msg=Process accessed:\r RuleName: -\r UtcTime: 2020-09-04 07:29:58.277\r SourceProcessGUID: {3ddc5665-e7cc-5f51-1000-000000000500}\r SourceProcessId: 916\r SourceThreadId: 1808\r SourceImage: C:\\windows\\system3\r\nevt-00109 | 2026-05-06T00:00:13.063Z | EC=10 | User= | Img=C:\\windows\\system32\\svchost.exe | Parent= | CMD= | TargetObj= | Det= | Msg=Process accessed:\r RuleName: -\r UtcTime: 2020-09-04 07:29:58.277\r SourceProcessGUID: {3ddc5665-e7cc-5f51-1000-000000000500}\r SourceProcessId: 916\r SourceThreadId: 7376\r SourceImage: C:\\windows\\system3\r\n\u001b[?2004hroot@d7430fea749f:~# "]
[34.13644, "i", "cat << 'EOF' > /tmp/clean_trace.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, target_user, image, parent_image, command_line, target_object, details, message\n    FROM events\n    ORDER BY timestamp;\n\"\"\")\n\nrows = cursor.fetchall()\n\ninteresting_count = 0\nfor r in rows:\n    ec = r['event_code']\n    host = r['host']\n    user = r['user'] or \"\"\n    img = r['image'] or \"\"\n    parent = r['parent_image'] or \"\"\n    cl = r['command_line'] or \"\"\n    to = r['target_object'] or \"\"\n    det = r['details'] or \"\"\n    msg = r['message'] or \"\"\n\n    # Filtering known noise\n    if ec == 7: # Image loaded\n        continue\n    \n    if ec == 10: # Process access\n        # Let's ignore if source process is svchost.exe accessing something benign\n        # But keep if it's suspicious, like lsass being accessed\n        if \"lsass.exe\" in msg.lower():\n            # Keep lsass access, but if source is svchost, maybe skip?\n            # Usually, lsass access by non-system is very suspicious.\n            if \"SourceImage: C:\\Windows\\System32\\svchost.exe\" in msg or \"SourceImage: C:\\windows\\system32\\svchost.exe\" in msg:\n                continue\n        else:\n            continue # Skip other process accesses for now\n\n    if ec in [4656, 4658, 4663, 4690]: # File/Object Auditing\n        # Often very noisy, let's skip unless we want to see them\n        continue\n\n    if ec in [5156, 5158]: # Filtering Platform\n        # Filter network connection noise\n        if \"guestagent\" in msg.lower() or \"networkwatcher\" in msg.lower() or \"svchost.exe\" in msg.lower() or \"monitoring\" in msg.lower():\n            continue\n\n    # Registry noise\n    if ec in [12, 13, 14]:\n        if \"services\\\\bam\\\\\" in to.lower() or \"muicache\" in to.lower():\n            continue\n        if \"runtimebroker.exe\" in img.lower() or \"svchost.exe\" in img.lower() or \"searchindexer.exe\" in img.lower():\n            continue\n        # ignore standard system keys\n        if to.startswith(\"HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Lsa\") and \"lsass.exe\" in img.lower():\n            continue\n\n    # Print details\n    interesting_count += 1\n    print(f\"{r['event_id']} | {r['timestamp']} | {host} | EC={ec} | User={user} | Img={img} | Parent={parent} | CMD={cl[:120]} | TO={to[:80]} | Msg={msg[:150].replace('\\n', ' ')}\")\n\nprint(f\"Total interesting events: {interesting_count}\")\nEOF\npython3 /tmp/clean_trace.py > /tmp/interesting_events.txt\nwc -l /tmp/interesting_events.txt\n"]
