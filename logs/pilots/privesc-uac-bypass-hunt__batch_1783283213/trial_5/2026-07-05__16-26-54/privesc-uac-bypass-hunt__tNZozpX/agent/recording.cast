[133.108711, "i", "cat << 'EOF' > /tmp/find_net_conn.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, host, event_code, image, user, src_ip, dst_ip, dst_port, message\n    FROM events\n    WHERE event_code = 3\n    ORDER BY timestamp;\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total Network Connections (EC=3): {len(rows)}\")\nfor r in rows:\n    print(f\"{r['event_id']} | {r['timestamp']} | Host={r['host']} | Img={r['image']} | User={r['user']} | Src={r['src_ip']} | Dst={r['dst_ip']}:{r['dst_port']} | Msg={r['message'].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/find_net_conn.py\n"]
