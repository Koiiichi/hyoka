[244.950608, "o", "\u001b[?2004hroot@d7430fea749f:~# "]
[250.762985, "i", "cat << 'EOF' > /tmp/ws05_files.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, target_object, details, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code = 11\n    ORDER BY timestamp;\n\"\"\")\n\nfor r in cursor.fetchall():\n    msg = r['message'] or \"\"\n    to = r['target_object'] or \"\"\n    img = r['image'] or \"\"\n    print(f\"{r['event_id']} | {r['timestamp']} | Img={img} | TO={to} | Msg={msg.replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/ws05_files.py\n"]
[250.763274, "o", "cat << 'EOF' > /tmp/ws05_files.py\r\n\u001b[?2004l\r"]
