[216.566632, "i", "cat << 'EOF' > /tmp/powershell_4104.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, host, event_code, message, details\n    FROM events\n    WHERE event_code = 4104\n\"\"\")\n\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | Host={r['host']} | Msg={r['message'][:500]}\")\n\nEOF\npython3 /tmp/powershell_4104.py\n"]
