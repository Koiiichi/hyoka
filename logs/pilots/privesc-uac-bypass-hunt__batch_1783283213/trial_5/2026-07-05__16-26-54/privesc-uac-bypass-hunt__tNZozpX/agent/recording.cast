[244.933973, "i", "cat << 'EOF' > /tmp/powershell_other.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' \n      AND event_code IN (4103, 800, 400)\n      AND message IS NOT NULL AND message != ''\n\"\"\")\n\nrows = cursor.fetchall()\nprint(\"EID | Timestamp | EC | Snippet\")\nfor r in rows:\n    msg = r['message']\n    # check if any of our known stager terms is in it\n    is_stager = any(x in msg for x in ['$f94e', 'fodhelper', 'Update', 'Cookie', 'Start-Sleep', 'BitConverter', 'Get-Random', 'whoami', 'Headers'])\n    if not is_stager:\n        print(f\"{r['event_id']} | {r['timestamp']} | {r['event_code']} | {repr(msg[:150])}\")\n\nEOF\npython3 /tmp/powershell_other.py\n"]
[244.934282, "o", "cat << 'EOF' > /tmp/powershell_other.py\r\n\u001b[?2004l\r"]
