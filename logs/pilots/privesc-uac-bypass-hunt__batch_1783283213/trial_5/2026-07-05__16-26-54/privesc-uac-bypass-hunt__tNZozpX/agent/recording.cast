[128.858659, "i", "cat << 'EOF' > /tmp/dns_msg.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, host, image, details, message\n    FROM events\n    WHERE event_code = 22 AND image LIKE '%powershell.exe%'\n\"\"\")\nfor r in cursor.fetchall():\n    print(\"EVENT_ID:\", r['event_id'])\n    print(\"TIMESTAMP:\", r['timestamp'])\n    print(\"DETAILS:\", repr(r['details']))\n    print(\"MESSAGE:\", repr(r['message']))\n\nEOF\npython3 /tmp/dns_msg.py\n"]
