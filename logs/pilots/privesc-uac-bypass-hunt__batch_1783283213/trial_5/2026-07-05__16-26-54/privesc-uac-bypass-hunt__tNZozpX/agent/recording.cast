[227.677478, "i", "cat << 'EOF' > /tmp/powershell_nonempty.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, message, details\n    FROM events\n    WHERE host = 'WS-05.corp.example' \n      AND event_code IN (4103, 800, 400)\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total non-empty PS events: {len(rows)}\")\nnonempty_msg = 0\nnonempty_det = 0\nfor r in rows:\n    if r['message']:\n        nonempty_msg += 1\n    if r['details']:\n        nonempty_det += 1\n\nprint(\"Non-empty message:\", nonempty_msg)\nprint(\"Non-empty details:\", nonempty_det)\n\nEOF\npython3 /tmp/powershell_nonempty.py\n"]
