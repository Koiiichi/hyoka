[109.26488, "o", "\u001b[?2004hroot@d7430fea749f:~# "]
[115.094174, "i", "cat << 'EOF' > /tmp/trace_elevated_net.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's search for events related to GUID {3ddc5665-ed08-5f51-f302-000000000500}\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, details, message, dst_ip, dst_port\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND (\n        process_guid = '{3ddc5665-ed08-5f51-f302-000000000500}' OR\n        parent_process_guid = '{3ddc5665-ed08-5f51-f302-000000000500}'\n    )\n    ORDER BY timestamp;\n\"\"\")\n\nfor r in cursor.fetchall():\n    cl = r['command_line'] or \"\"\n    msg = r['message'] or \"\"\n    to = r['target_object'] or \"\"\n    det = r['details'] or \"\"\n    ec = r['event_code']\n    dst = f\"{r['dst_ip']}:{r['dst_port']}\" if r['dst_ip'] else \"\"\n    print(f\"{r['event_id']} | {r['timestamp']} | EC={ec} | Img={r['image']} | CMD={cl[:100]} | TO={to[:50]} | Dst={dst} | Msg={msg[:200].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/trace_elevated_net.py\n"]
[115.094522, "o", "cat << 'EOF' > /tmp/trace_elevated_net.py\r\n\u001b[?2004l\r"]
