[138.523619, "i", "cat << 'EOF' > /tmp/get_net_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, host, event_code, image, user, src_ip, dst_ip, dst_port, details, message\n    FROM events\n    WHERE event_code IN (3, 5156, 5158)\n    ORDER BY timestamp;\n\"\"\")\n\nfor r in cursor.fetchall():\n    cl = r['message'] or \"\"\n    # Let's filter out known guestagent/networkwatcher/camsvc/cameraupload/etc\n    if any(x in cl.lower() for x in ['guestagent', 'networkwatcher', 'camsvc', 'monitoring', 'microsoftedge', 'onedrive']):\n        continue\n    print(f\"{r['event_id']} | {r['timestamp']} | Host={r['host']} | EC={r['event_code']} | Img={r['image']} | Src={r['src_ip']} | Dst={r['dst_ip']}:{r['dst_port']} | Msg={cl.replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/get_net_details.py\n"]
[138.523838, "o", "cat << 'EOF' > /tmp/get_net_details.py\r\n\u001b[?2004l\r"]
