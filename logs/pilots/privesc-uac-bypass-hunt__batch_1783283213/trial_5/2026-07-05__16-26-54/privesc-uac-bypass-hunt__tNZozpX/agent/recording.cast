[211.851048, "i", "cat << 'EOF' > /tmp/powershell_guids.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's count script blocks by process_guid, or since process_guid might not be a direct column in 4103/800, we can extract from details/message\n# Wait, does the events table have process_guid populated for event 4103 or 800? Let's check!\ncursor.execute(\"\"\"\n    SELECT DISTINCT process_guid, COUNT(*) \n    FROM events \n    WHERE event_code IN (4103, 4104, 800, 400)\n    GROUP BY process_guid;\n\"\"\")\nfor r in cursor.fetchall():\n    print(\"Process GUID:\", r['process_guid'], \"Count:\", r['COUNT(*)'])\n\nEOF\npython3 /tmp/powershell_guids.py\n"]
