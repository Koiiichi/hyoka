[362.481552, "o", "\u001b[?2004hroot@d7430fea749f:~# python3 /tmp/generate_findings.py\r\n\u001b[?2004l\r"]
[362.504368, "o", "Total collected unique malicious event IDs: 771\r\n"]
[362.504736, "o", "Saved findings to /root/findings.json\r\n"]
[362.506468, "o", "\u001b[?2004hroot@d7430fea749f:~# "]
[377.944026, "i", "cat << 'EOF' > /tmp/generate_findings_precise.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncore_malicious_ids = set()\n\n# 1. Process creations (1, 4688) on WS-05 of our suspicious images\nsuspicious_images = ['whoami.exe', 'fodhelper.exe', 'powershell.exe', 'conhost.exe']\ncursor.execute(\"\"\"\n    SELECT event_id, image, command_line\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (1, 4688)\n\"\"\")\nproc_count = 0\nfor r in cursor.fetchall():\n    img = r['image'] or \"\"\n    cl = r['command_line'] or \"\"\n    if any(x in img.lower() or x in cl.lower() for x in suspicious_images):\n        core_malicious_ids.add(r['event_id'])\n        proc_count += 1\n\nprint(\"Core Process Creations:\", proc_count)\n\n# 2. Malicious Registry hijack & cleanup events\n# We hardcode the exact malicious registry event IDs we analyzed and confirmed:\nmalicious_registry_ids = [\n    'evt-00388', # Write stager payload to HKCU\\Software\\Microsoft\\Windows\\Update\n    'evt-00401', # ms-settings command hijack (CreateKey)\n    'evt-00402', # ms-settings command hijack (CreateKey)\n    'evt-00403', # ms-settings command hijack (CreateKey)\n    'evt-00404', # ms-settings command hijack (CreateKey)\n    'evt-00405', # ms-settings command hijack (SetValue DelegateExecute)\n    'evt-00408', # ms-settings command hijack (SetValue Default command)\n    'evt-02498', # Delete ms-settings\\...\\command (cleanup)\n    'evt-02499', # Delete ms-settings\\... (cleanup)\n    'evt-02500', # Delete ms-settings\\... (cleanup)\n    'evt-02501', # Delete ms-settings (cleanup)\n    'evt-02502'  # Delete Update key (cleanup)\n]\nfor eid in malicious_registry_ids:\n    core_malicious_ids.add(eid)\n\nprint(\"Core Registry Events:\", len(malicious_registry_ids))\n\n# 3. Core Network connection events (to 10.10.10.5 on port 80)\n# - evt-02454: Sysmon network connection detected\n# - evt-02206: WFP outbound connection permitted\nmalicious_net_ids = ['evt-02454', 'evt-02206']\nfor eid in malicious_net_ids:\n    core_malicious_ids.add(eid)\n\nprint(\"Core Network Events:\", len(malicious_net_ids))\n\n# 4. Non-empty PowerShell script block logs on WS-05\nps_script_ids = []\ncursor.execute(\"\"\"\n    SELECT event_id, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103, 4104)\n\"\"\")\nfor r in cursor.fetchall():\n    msg = r['message'] or \"\"\n    if msg != \"\":\n        ps_script_ids.append(r['event_id'])\n\nprint(\"Non-empty PowerShell Script Block Events:\", len(ps_script_ids))\n\n# Let's save a core-only findings file first and then a core-plus-ps findings file\n# This way we can evaluate the sizes.\n# Core only:\ncore_only = sorted(list(core_malicious_ids))\nprint(f\"Total Core Malicious Events: {len(core_only)}\")\nprint(\"Core Event IDs:\", core_only)\n\n# Core + Script Blocks:\ncore_plus_ps = sorted(list(core_malicious_ids.union(set(ps_script_ids))))\nprint(f\"Total Core + PS Script Block Events: {len(core_plus_ps)}\")\n\n# Let's write the Core + PS Script Block Events to findings.json because script blocks are indeed malicious telemetry created by the fileless RAT during execution.\nwith open('/root/findings.json', 'w') as f:\n    json.dump(core_plus_ps, f)\n\nprint(\"Saved findings to /root/findings.json\")\n\nEOF\npython3 /tmp/generate_findings_precise.py\n"]
[377.944433, "o", "cat << 'EOF' > /tmp/generate_findings_precise.py"]
