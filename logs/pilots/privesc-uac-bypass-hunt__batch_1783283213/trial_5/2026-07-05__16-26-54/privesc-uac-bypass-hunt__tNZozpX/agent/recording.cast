[318.193909, "i", "cat << 'EOF' > /tmp/find_pid_916_net.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND (\n        message LIKE '%916%'\n        OR details LIKE '%916%'\n    ) AND event_code IN (3, 5156, 5158)\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Connections found for PID 916: {len(rows)}\")\nfor r in rows:\n    print(f\"{r['event_id']} | {r['timestamp']} | EC={r['event_code']} | Img={r['image']} | Msg={r['message'].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/find_pid_916_net.py\n"]
