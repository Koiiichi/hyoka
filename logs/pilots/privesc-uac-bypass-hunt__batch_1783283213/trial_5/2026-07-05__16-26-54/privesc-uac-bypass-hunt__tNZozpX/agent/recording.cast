[205.261778, "i", "cat << 'EOF' > /tmp/registry_cleanup_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, target_object, details, message\n    FROM events\n    WHERE event_id IN ('evt-02498', 'evt-02499', 'evt-02500', 'evt-02501', 'evt-02502')\n\"\"\")\n\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | EC={r['event_code']} | Img={r['image']} | TO={r['target_object']} | Det={r['details']} | Msg={r['message'].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/registry_cleanup_details.py\n"]
