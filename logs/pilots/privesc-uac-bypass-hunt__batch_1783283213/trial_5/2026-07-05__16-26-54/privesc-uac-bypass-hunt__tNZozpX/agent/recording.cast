[261.536758, "i", "cat << 'EOF' > /tmp/ws05_file_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, image, target_object, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code = 11\n    ORDER BY timestamp;\n\"\"\")\n\nfor r in cursor.fetchall():\n    msg = r['message'] or \"\"\n    target_file = \"Unknown\"\n    for line in msg.split('\\n'):\n        if \"TargetFilename:\" in line:\n            target_file = line.replace(\"TargetFilename:\", \"\").strip()\n            break\n    # if not found, use target_object\n    if target_file == \"Unknown\":\n        target_file = r['target_object'] or \"\"\n    print(f\"{r['event_id']} | {r['timestamp']} | Img={r['image']} | File={target_file}\")\n\nEOF\npython3 /tmp/ws05_file_details.py\n"]
