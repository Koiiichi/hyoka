[151.081707, "i", "cat << 'EOF' > /tmp/ws06_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, details, message\n    FROM events\n    WHERE host = 'WS-06.corp.example'\n    ORDER BY timestamp;\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total events on WS-06: {len(rows)}\")\nfor r in rows:\n    ec = r['event_code']\n    cl = r['command_line'] or \"\"\n    to = r['target_object'] or \"\"\n    msg = r['message'] or \"\"\n    print(f\"{r['event_id']} | {r['timestamp']} | EC={ec} | Img={r['image']} | Parent={r['parent_image']} | CMD={cl[:80]} | TO={to[:50]} | Msg={msg[:150].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/ws06_events.py\n"]
