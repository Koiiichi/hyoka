[189.74206, "i", "cat << 'EOF' > /tmp/ws05_all_processes.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, process_guid, parent_process_guid\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (1, 4688)\n    ORDER BY timestamp;\n\"\"\")\n\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | EC={r['event_code']} | GUID={r['process_guid']} | PGUID={r['parent_process_guid']} | User={r['user']} | Img={r['image']} | CMD={r['command_line']}\")\n\nEOF\npython3 /tmp/ws05_all_processes.py\n"]
