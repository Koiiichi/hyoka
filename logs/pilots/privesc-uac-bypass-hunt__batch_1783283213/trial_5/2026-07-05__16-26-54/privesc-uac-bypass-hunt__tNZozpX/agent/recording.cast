[238.804573, "i", "cat << 'EOF' > /tmp/powershell_messages.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' \n      AND event_code IN (4103, 800, 400)\n      AND message IS NOT NULL AND message != ''\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Analyzing {len(rows)} PS messages...\")\n\nby_user = {}\nby_content_snippet = {}\n\nfor r in rows:\n    msg = r['message']\n    eid = r['event_id']\n    ec = r['event_code']\n    \n    # extract user context from message if present\n    user = \"Unknown\"\n    for line in msg.split('\\n'):\n        if \"UserId=\" in line or \"User=\" in line:\n            user = line.strip()\n            break\n    by_user[user] = by_user.get(user, 0) + 1\n    \n    # Let's find some snippets\n    snippet = \"Other\"\n    for term in ['$f94e', 'fodhelper', 'Update', 'Cookie', 'Start-Sleep', 'BitConverter', 'Get-Random', 'whoami', 'Headers']:\n        if term in msg:\n            snippet = term\n            break\n    by_content_snippet[snippet] = by_content_snippet.get(snippet, 0) + 1\n\nprint(\"User distributions in PS message logs:\")\nfor k, v in by_user.items():\n    print(f\"  {k}: {v}\")\n\nprint(\"Content distributions in PS message logs:\")\nfor k, v in by_content_snippet.items():\n    print(f\"  {k}: {v}\")\n\nEOF\npython3 /tmp/powershell_messages.py\n"]
[238.805022, "o", "cat << 'EOF' > /tmp/powershell_messages.py\r\n"]
