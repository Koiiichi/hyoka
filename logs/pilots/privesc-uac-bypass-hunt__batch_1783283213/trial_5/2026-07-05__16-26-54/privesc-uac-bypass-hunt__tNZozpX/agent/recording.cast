[362.473631, "i", "cat << 'EOF' > /tmp/generate_findings.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmalicious_ids = set()\n\n# 1. Process creations (1, 4688) on WS-05 of our suspicious images\nsuspicious_images = ['whoami.exe', 'fodhelper.exe', 'powershell.exe', 'conhost.exe']\ncursor.execute(\"\"\"\n    SELECT event_id, image, command_line\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (1, 4688)\n\"\"\")\nfor r in cursor.fetchall():\n    img = r['image'] or \"\"\n    cl = r['command_line'] or \"\"\n    if any(x in img.lower() or x in cl.lower() for x in suspicious_images):\n        malicious_ids.add(r['event_id'])\n\n# 2. Registry events (12, 13, 14) on WS-05\n# - ms-settings UAC bypass (created & deleted)\n# - Update payload key (created & deleted)\n# - Any registry edit by powershell.exe\ncursor.execute(\"\"\"\n    SELECT event_id, image, target_object\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (12, 13, 14)\n\"\"\")\nfor r in cursor.fetchall():\n    img = r['image'] or \"\"\n    to = r['target_object'] or \"\"\n    is_malicious = False\n    if \"powershell\" in img.lower():\n        is_malicious = True\n    if \"ms-settings\" in to.lower():\n        is_malicious = True\n    if \"windows\" in to.lower() and \"update\" in to.lower():\n        is_malicious = True\n    if is_malicious:\n        malicious_ids.add(r['event_id'])\n\n# 3. Network connection events (3, 5156, 5158)\n# - Outbound connection to C2 (10.10.10.5)\n# - Network connections by powershell.exe\ncursor.execute(\"\"\"\n    SELECT event_id, image, dst_ip, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (3, 5156, 5158)\n\"\"\")\nfor r in cursor.fetchall():\n    img = r['image'] or \"\"\n    dst_ip = r['dst_ip'] or \"\"\n    msg = r['message'] or \"\"\n    if \"powershell\" in img.lower() or \"10.10.10.5\" in dst_ip or \"10.10.10.5\" in msg:\n        malicious_ids.add(r['event_id'])\n\n# 4. PowerShell Script Blocks and Pipelines (800, 4103, 4104) with non-empty messages\ncursor.execute(\"\"\"\n    SELECT event_id, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103, 4104)\n\"\"\")\nfor r in cursor.fetchall():\n    msg = r['message'] or \"\"\n    if msg != \"\":\n        malicious_ids.add(r['event_id'])\n\n# Let's print out the counts in each category just to be super clear\nprint(f\"Total collected unique malicious event IDs: {len(malicious_ids)}\")\n\n# Write to /root/findings.json\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(malicious_ids)), f)\n\nprint(\"Saved findings to /root/findings.json\")\n\nEOF\npython3 /tmp/generate_findings.py\n"]
