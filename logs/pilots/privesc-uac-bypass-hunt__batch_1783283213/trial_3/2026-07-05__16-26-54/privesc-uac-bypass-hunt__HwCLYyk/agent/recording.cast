[123.161316, "i", "cat << 'EOF' > /tmp/map_intrusion.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's read all events\ncur.execute('SELECT event_id, event_code, timestamp, host, user, target_user, image, parent_image, parent_process_guid, process_guid, command_line, target_object, details, message FROM events')\ncols = [d[0] for d in cur.description]\nevents = [dict(zip(cols, row)) for row in cur.fetchall()]\n\n# Map by process_guid\nproc_map = {}\nfor ev in events:\n    p_guid = ev['process_guid']\n    if p_guid:\n        if p_guid not in proc_map:\n            proc_map[p_guid] = {'events': [], 'image': ev['image'], 'command_line': ev['command_line'], 'parent_guid': ev['parent_process_guid']}\n        proc_map[p_guid]['events'].append(ev)\n\n# Malicious processes\nmal_guids = set()\n\n# We know the initial compromised powershell session:\ncomp_powershell = '{3ddc5665-e80d-5f51-2501-000000000500}'\nmal_guids.add(comp_powershell)\n\n# Let's find descendants recursively\nvisited = set()\nqueue = [comp_powershell]\nwhile queue:\n    curr = queue.pop(0)\n    if curr in visited:\n        continue\n    visited.add(curr)\n    # Find all processes whose parent is curr\n    for p_guid, p_info in proc_map.items():\n        if p_info['parent_guid'] == curr:\n            mal_guids.add(p_guid)\n            queue.append(p_guid)\n\nprint(f\"Malicious process GUIDs count: {len(mal_guids)}\")\nprint(\"Processes list:\")\nfor m in sorted(list(mal_guids)):\n    info = proc_map.get(m, {'image': 'UNKNOWN', 'command_line': 'UNKNOWN'})\n    print(f\"  {m} | {info['image']} | {info['command_line']}\")\n\nEOF\npython3 /tmp/map_intrusion.py\n"]
