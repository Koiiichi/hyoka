[196.613353, "i", "cat << 'EOF' > /tmp/collect_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Malicious Process GUIDs\nmal_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed06-5f51-f202-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}',\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\nflagged_eids = set()\n\n# Let's read all events\ncur.execute('SELECT event_id, event_code, timestamp, host, user, target_user, image, parent_image, parent_process_guid, process_guid, target_object, details, message FROM events')\ncols = [d[0] for d in cur.description]\nall_events = [dict(zip(cols, row)) for row in cur.fetchall()]\n\nfor ev in all_events:\n    eid = ev['event_id']\n    code = ev['event_code']\n    ts = ev['timestamp']\n    p_guid = ev['process_guid']\n    pp_guid = ev['parent_process_guid']\n    \n    # Rule 1: Direct association with malicious process\n    if p_guid in mal_guids or pp_guid in mal_guids:\n        # For the compromised console powershell session, exclude events before 00:00:26\n        if p_guid == '{3ddc5665-e80d-5f51-2501-000000000500}' or pp_guid == '{3ddc5665-e80d-5f51-2501-000000000500}':\n            if ts >= '2026-05-06T00:00:26.000Z':\n                flagged_eids.add(eid)\n        else:\n            flagged_eids.add(eid)\n            \n    # Rule 2: PowerShell operational/pipeline events (since there are no other powershell processes)\n    if code in (800, 4103, 4104) and ev['host'] == 'WS-05.corp.example':\n        flagged_eids.add(eid)\n\nprint(f\"Total unique flagged Event IDs: {len(flagged_eids)}\")\n\n# Let's count by event_code to see what we have\ncounts = {}\nfor ev in all_events:\n    if ev['event_id'] in flagged_eids:\n        code = ev['event_code']\n        counts[code] = counts.get(code, 0) + 1\n\nprint(\"Event Code Counts:\")\nfor code in sorted(counts.keys()):\n    print(f\"  Event {code}: {counts[code]}\")\n\nEOF\npython3 /tmp/collect_events.py\n"]
