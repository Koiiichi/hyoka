[78.127019, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Malicious Process GUIDs we have identified:\n# 1. First powershell.exe (compromised): {3ddc5665-e80d-5f51-2501-000000000500}\n# 2. whoami /groups: {3ddc5665-ed04-5f51-eb02-000000000500}, {3ddc5665-ed04-5f51-ec02-000000000500}\n# 3. fodhelper.exe: {3ddc5665-ed05-5f51-ed02-000000000500}, {3ddc5665-ed05-5f51-f002-000000000500}\n# 4. powershell.exe (stage 1): {3ddc5665-ed06-5f51-f102-000000000500}\n# 5. conhost.exe: {3ddc5665-ed06-5f51-f202-000000000500}\n# 6. powershell.exe (stage 2): {3ddc5665-ed08-5f51-f302-000000000500}\n# 7. whoami (final): {3ddc5665-ed2e-5f51-fc02-000000000500}\n\nmalicious_guids = {\n    '{3ddc5665-e80d-5f51-2501-000000000500}',\n    '{3ddc5665-ed04-5f51-eb02-000000000500}',\n    '{3ddc5665-ed04-5f51-ec02-000000000500}',\n    '{3ddc5665-ed05-5f51-ed02-000000000500}',\n    '{3ddc5665-ed05-5f51-f002-000000000500}',\n    '{3ddc5665-ed06-5f51-f102-000000000500}',\n    '{3ddc5665-ed06-5f51-f202-000000000500}',\n    '{3ddc5665-ed08-5f51-f302-000000000500}',\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'\n}\n\n# Let's query all events that have these process_guid or parent_process_guid\ncur.execute('SELECT event_id, event_code, timestamp, image, process_guid, parent_process_guid, target_object, details, message FROM events')\nall_events = cur.fetchall()\n\nflagged_events = []\n\nfor row in all_events:\n    eid, code, ts, img, p_guid, pp_guid, target_obj, details, msg = row\n    \n    # If the process is a direct malicious process or its parent is malicious\n    is_malicious = False\n    if p_guid in malicious_guids or pp_guid in malicious_guids:\n        is_malicious = True\n        \n    # Wait, the compromised powershell '{3ddc5665-e80d-5f51-2501-000000000500}' is doing some benign stuff too. \n    # Let's inspect what events belong to '{3ddc5665-e80d-5f51-2501-000000000500}' and filter out the internet connections checking before 00:00:26.\n    if p_guid == '{3ddc5665-e80d-5f51-2501-000000000500}':\n        # Only count events from this compromised process that started at or after 00:00:26, or are specifically targeting ms-settings or Windows Update\n        # Let's see: the first whoami was spawned at 00:00:26.162Z. So let's count everything after 00:00:26.000Z.\n        if ts < '2026-05-06T00:00:26.000Z':\n            is_malicious = False\n            \n    if is_malicious:\n        flagged_events.append(row)\n\nprint(f\"Total flagged events: {len(flagged_events)}\")\nfor f in flagged_events[:100]:\n    print(f[0], f[1], f[2], f[3], f[6], f[7])\nEOF\npython3 /tmp/hunt.py\n"]
