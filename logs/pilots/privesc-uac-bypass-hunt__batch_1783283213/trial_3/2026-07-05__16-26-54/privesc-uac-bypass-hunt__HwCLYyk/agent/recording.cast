[102.713936, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute('SELECT * FROM events WHERE event_id IN (\\x27evt-01537\\x27, \\x27evt-01896\\x27)')\ncols = [description[0] for description in cur.description]\nfor row in cur.fetchall():\n    for c, val in zip(cols, row):\n        if val:\n            print(f'{c}: {val}')\n    print('-' * 40)\n\"\n"]
