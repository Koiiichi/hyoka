[?2004l[?2004h>     eid, ts, code, img, pimg, cmd, msg = ev
[?2004l[?2004h>     msg_str = (msg or "")
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if the process ID is in our malicious PIDs
[?2004l[?2004h>     pid_match = re.search(r'ProcessId:\s*(\d+)', msg_str, re.IGNORECASE)
[?2004l[?2004h>     pid = int(pid_match.group(1)) if pid_match else None
[?2004l[?2004h>     
[?2004l[?2004h>     spid_match = re.search(r'SourceProcessId:\s*(\d+)', msg_str, re.IGNORECASE)
[?2004l[?2004h>     spid = int(spid_match.group(1)) if spid_match else None
[?2004l[?2004h>     
[?2004l[?2004h>     tpid_match = re.search(r'TargetProcessId:\s*(\d+)', msg_str, re.IGNORECASE)
[?2004l[?2004h>     tpid = int(tpid_match.group(1)) if tpid_match else None
[?2004l[?2004h>     
[?2004l[?2004h>     is_mal = False
[?2004l[?2004h>     if pid in all_mal_pids or spid in all_mal_pids or tpid in all_mal_pids:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>     
[?2004l[?2004h>     # Also check image names if they are related
[?2004l[?2004h>     img_lower = (img or "").lower()
[?2004l[?2004h>     if 'wscript.exe' in img_lower or 'powershell.exe' in img_lower or 'whoami.exe' in img_lower:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     if not is_mal:
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # Skip benign noise even if from malicious PID
[?2004l[?2004h>     # - DLL loads (Event 7)
[?2004l[?2004h>     # - Standard registry queries (12, 13) to Tcpip, Internet Settings, etc.
[?2004l[?2004h>     if code == 7:
[?2004l[?2004h>         continue
[?2004l[?2004h>     if code in (12, 13):
[?2004l[?2004h>         if any(x in msg_str.lower() for x in ['internet settings', 'tcpip', 'enterprisecertificates', 'wbem', 'systemcertificates', 'disallowed', 'desktop\\namespace', 'syncrootmanager', 'winscript', 'scripting']):
[?2004l[?2004h>             continue
[?2004l[?2004h>     if code == 10:
[?2004l[?2004h>         # Skip standard system process accesses to/from powershell/wscript
[?2004l[?2004h>         if 'svchost' in msg_str.lower() or 'lsass' in msg_str.lower() or 'csrss' in msg_str.lower():
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>     # If it is PowerShell event 800 or 4103, let's skip them because they are very chatty, 
[?2004l[?2004h>     # unless they are really important, but we already have the main execution in 4104 (evt-00918).
[?2004l[?2004h>     if code in (800, 4103):
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # Summarize details
[?2004l[?2004h>     details = ""
[?2004l[?2004h>     if code in (1, 4688):
[?2004l[?2004h>         details = f"Process Create: {cmd or ''}"
[?2004l[?2004h>     elif code == 3:
[?2004l[?2004h>         # Network connection
[?2004l[?2004h>         dst_ip_match = re.search(r'DestinationIp:\s*(\S+)', msg_str)
[?2004l[?2004h>         dst_port_match = re.search(r'DestinationPort:\s*(\S+)', msg_str)
[?2004l[?2004h>         dst_ip = dst_ip_match.group(1) if dst_ip_match else ""
[?2004l[?2004h>         dst_port = dst_port_match.group(1) if dst_port_match else ""
[?2004l[?2004h>         details = f"Network Connection to {dst_ip}:{dst_port}"
[?2004l[?2004h>     elif code in (5156, 5158):
[?2004l[?2004h>         details = f"WFP Connection/Bind"
[?2004l[?2004h>     elif code in (11, 23):
[?2004l[?2004h>         tf_match = re.search(r'TargetFilename:\s*(.*)', msg_str)
[?2004l[?2004h>         tf = tf_match.group(1) if tf_match else ""
[?2004l[?2004h>         action = "File Created" if code == 11 else "File Deleted"
[?2004l[?2004h>         details = f"{action}: {tf}"
[?2004l[?2004h>     elif code in (17, 18):
[?2004l[?2004h>         pn_match = re.search(r'PipeName:\s*(.*)', msg_str)
[?2004l[?2004h>         pn = pn_match.group(1) if pn_match else ""
[?2004l[?2004h>         action = "Pipe Created" if code == 17 else "Pipe Connected"
[?2004l[?2004h>         details = f"{action}: {pn}"
[?2004l[?2004h>     elif code == 22:
[?2004l[?2004h>         details = f"DNS Query"
[?2004l[?2004h>     elif code == 4104:
[?2004l[?2004h>         details = f"PowerShell Script Block Logging"
[?2004l[?2004h>     elif code == 5857:
[?2004l[?2004h>         details = f"WMI Provider Started"
[?2004l[?2004h>     else:
[?2004l[?2004h>         # just show first line of message
[?2004l[?2004h>         details = msg_str.split('\n')[0]
[?2004l[?2004h>         
[?2004l[?2004h>     print(f"{eid} | {ts} | Code: {code} | {img or pimg or ''} | {details[:120]}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
