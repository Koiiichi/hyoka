[?2004hroot@cc5485f3f7a8:~# cat << 'EOF' > /tmp/clean_timeline.py
[?2004l[?2004h> import sqlite3, re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # We want to select all events on WS-05 and filter out standard, highly repetitive noise.
[?2004l[?2004h> # Let's write rules to keep only interesting things.
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h> SELECT event_id, timestamp, event_code, image, parent_image, command_line, message 
[?2004l[?2004h> FROM events 
[?2004l[?2004h> WHERE host = 'WS-05.corp.example'
[?2004l[?2004h> ORDER BY timestamp ASC;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> events = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> # Known process GUIDs
[?2004l[?2004h> wscript_guid = "{860ba2e3-9f13-5f52-2603-000000000400}"
[?2004l[?2004h> powershell_guid = "{860ba2e3-9f13-5f52-2703-000000000400}"
[?2004l[?2004h> whoami_guid = "{860ba2e3-9f2e-5f52-2a03-000000000400}"
[?2004l[?2004h> conhost_guid = "{860ba2e3-9f19-5f52-2803-000000000400}"
[?2004l[?2004h> wmiprvse_guid = "{860ba2e3-9f19-5f52-2903-000000000400}"
[?2004l[?2004h> 
[?2004l[?2004h> malicious_guids = {wscript_guid, powershell_guid, whoami_guid, conhost_guid, wmiprvse_guid}
[?2004l[?2004h> 
[?2004l[?2004h> # We will filter out benign/noise events:
[?2004l[?2004h> # - Event 7 (Image loaded): almost always noisy unless it's a very specific DLL (let's print non-system DLLs if any, but otherwise skip)
[?2004l[?2004h> # - Event 10 (ProcessAccess): skip svchost/lsass standard audits unless they are unusual
[?2004l[?2004h> # - Event 12/13 (Registry): skip standard Windows/Net/Wbem/Internet Settings keys
[?2004l[?2004h> # - Event 4656/4658/4663/4690 (Object Access): usually noise, but let's see
[?2004l[?2004h> # - Event 5156/5158 (WFP): skip unless the remote IP is 10.10.10.5
[?2004l[?2004h> 
[?2004l[?2004h> for ev in events:
[?2004l[?2004h>     eid, ts, code, img, pimg, cmd, msg = ev
[?2004l[?2004h>     msg_str = (msg or "")
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract GUIDs
[?2004l[?2004h>     pguid_match = re.search(r'ParentProcessGUID:\s*({[^{}]+})', msg_str, re.IGNORECASE)
[?2004l[?2004h>     pguid = pguid_match.group(1) if pguid_match else ""
[?2004l[?2004h>     guid_match = re.search(r'ProcessGUID:\s*({[^{}]+})', msg_str, re.IGNORECASE)
[?2004l[?2004h>     guid = guid_match.group(1) if guid_match else ""
[?2004l[?2004h>     
[?2004l[?2004h>     # If it's a highly chatty event code and not directly in our malicious guids, skip it
[?2004l[?2004h>     if code in (7, 10, 12, 13, 4656, 4658, 4663, 4690, 4703, 4673):
[?2004l[?2004h>         # check if it is related to our malicious processes
[?2004l[?2004h>         is_related = False
[?2004l[?2004h>         if pguid in malicious_guids or guid in malicious_guids:
[?2004l[?2004h>             is_related = True
[?2004l[?2004h>         # check if process ID or image in message matches
[?2004l[?2004h>         # we only want to print if it is interesting, like registry write to an AMSI/logging bypass key, or DLL load of an unusual DLL
[?2004l[?2004h>         if not is_related:
[?2004l[?2004h>             continue
[?2004l[?2004h>         # For registry (12, 13), only print if it's not internet settings / tcpip / certs / wbem
[?2004l[?2004h>         if code in (12, 13):
[?2004l[?2004h>             if any(x in msg_str.lower() for x in ['internet settings', 'tcpip', 'enterprisecertificates', 'wbem', 'systemcertificates', 'disallowed', 'desktop\\namespace', 'syncrootmanager']):
[?2004l[?2004h>                 continue
[?2004l[?2004h>         # For process access (10), skip standard svchost/lsass to our processes
[?2004l[?2004h>         if code == 10:
[?2004l[?2004h>             if 'svchost.exe' in msg_str.lower() or 'lsass.exe' in msg_str.lower() or 'csrss.exe' in msg_str.lower():
[?2004l[?2004h>                 continue
[?2004l[?2004h>         # For image load (7), skip standard Microsoft DLLs
[?2004l[?2004h>         if code == 7:
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h>     if code in (5156, 5158):
[?2004l[?2004h>         # only print if 10.10.10.5 is involved
[?2004l[?2004h>         if '10.10.10.5' not in msg_str:
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h>     # Print interesting events
[?2004l[?2004h>     print(f"{eid} | {ts} | Code: {code} | Img: {img} | Cmd: {cmd or ''}")
[?2004l[?2004h>     lines = [l.strip() for l in msg_str.split('\n') if l.strip()]
[?2004l[?2004h>     for l in lines[:5]:
[?2004l[?2004h>         print("  ", l)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@cc5485f3f7a8:~# python3 /tmp/clean_timeline.py > /tmp/clean_timeline.txt
[?2004l[?2004hroot@cc5485f3f7a8:~# cat /tmp/clean_timeline.txt
