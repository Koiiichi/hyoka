[?2004hroot@cc5485f3f7a8:~# cat << 'EOF' > /tmp/parse_timeline.py
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> # Let's read ws05_timeline.txt and classify the events.
[?2004l[?2004h> # Malicious Process PIDs: 
[?2004l[?2004h> # wscript: 2140? Let's check. 
[?2004l[?2004h> # powershell: 2316
[?2004l[?2004h> # whoami: 9152
[?2004l[?2004h> # conhost: under powershell
[?2004l[?2004h> # wmiprvse: 4864 (maybe?)
[?2004l[?2004h> 
[?2004l[?2004h> # Let's build a set of malicious process IDs dynamically
[?2004l[?2004h> # by starting with known malicious files/commands and tracing child/parent relationships.
[?2004l[?2004h> 
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, host, image, parent_image, parent_process_guid, process_guid, command_line, message FROM events WHERE host = 'WS-05.corp.example'")
[?2004l[?2004h> events = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> malicious_guids = set()
[?2004l[?2004h> malicious_pids = set()
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Initialize with known malicious entry points
[?2004l[?2004h> for ev in events:
[?2004l[?2004h>     eid, code, host, img, pimg, pguid, guid, cmd, msg = ev
[?2004l[?2004h>     cmd_str = (cmd or "").lower()
[?2004l[?2004h>     img_str = (img or "").lower()
[?2004l[?2004h>     # launcher.vbs is definitely malicious
[?2004l[?2004h>     if 'launcher.vbs' in cmd_str:
[?2004l[?2004h>         malicious_guids.add(guid)
[?2004l[?2004h>         # Extract pid from msg
[?2004l[?2004h>         pid_match = re.search(r'ProcessId:\s*(\d+)', msg or "")
[?2004l[?2004h>         if pid_match:
[?2004l[?2004h>             malicious_pids.add(int(pid_match.group(1)))
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Propagate parent/child GUIDs (iterate a few times to get full tree)
[?2004l[?2004h> for _ in range(5):
[?2004l[?2004h>     for ev in events:
[?2004l[?2004h>         eid, code, host, img, pimg, pguid, guid, cmd, msg = ev
[?2004l[?2004h>         if pguid in malicious_guids:
[?2004l[?2004h>             if guid:
[?2004l[?2004h>                 malicious_guids.add(guid)
[?2004l[?2004h>             pid_match = re.search(r'ProcessId:\s*(\d+)', msg or "")
[?2004l[?2004h>             if pid_match:
[?2004l[?2004h>                 malicious_pids.add(int(pid_match.group(1)))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Malicious GUIDs: {malicious_guids}")
[?2004l[?2004h> print(f"Malicious PIDs: {malicious_pids}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Identify all events associated with these GUIDs or PIDs
[?2004l[?2004h> malicious_events = []
[?2004l[?2004h> for ev in events:
[?2004l[?2004h>     eid, code, host, img, pimg, pguid, guid, cmd, msg = ev
[?2004l[?2004h>     msg_str = (msg or "")
[?2004l[?2004h>     pid_match = re.search(r'ProcessId:\s*(\d+)', msg_str)
[?2004l[?2004h>     spid_match = re.search(r'SourceProcessId:\s*(\d+)', msg_str)
[?2004l[?2004h>     tpid_match = re.search(r'TargetProcessId:\s*(\d+)', msg_str)
[?2004l[?2004h>     
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     if guid in malicious_guids or pguid in malicious_guids:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     elif pid_match and int(pid_match.group(1)) in malicious_pids:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     elif spid_match and int(spid_match.group(1)) in malicious_pids:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     elif tpid_match and int(tpid_match.group(1)) in malicious_pids:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     
[?2004l[?2004h>     # Also catch based on image names if they are related to the malicious pids
[?2004l[?2004h>     # e.g. wscript.exe, powershell.exe, whoami.exe, conhost.exe, wmiprvse.exe
[?2004l[?2004h>     # But we want to be highly precise so tracing GUIDs/PIDs is best.
[?2004l[?2004h>     
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         malicious_events.append(ev)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(malicious_events)} potentially malicious events.")
[?2004l[?2004h> # Let's write them out chronologically
[?2004l[?2004h> malicious_events.sort(key=lambda x: x[1]) # sort by timestamp
[?2004l[?2004h> with open('/tmp/suspect_events.txt', 'w') as f:
[?2004l[?2004h>     for ev in malicious_events:
[?2004l[?2004h>         eid, code, host, img, pimg, pguid, guid, cmd, msg = ev
