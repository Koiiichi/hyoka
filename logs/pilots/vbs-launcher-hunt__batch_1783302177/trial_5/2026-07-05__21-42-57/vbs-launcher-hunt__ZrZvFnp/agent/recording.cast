[97.450667, "i", "cat << 'EOF' > /tmp/check_reg.py\nimport sqlite3, re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (12, 13);\")\n\nignored = [\n    r'internet settings',\n    r'tcpip',\n    r'wbem',\n    r'enterprisecertificates',\n    r'hklm\\software\\\\microsoft',\n    r'hklm\\\\software\\\\classes',\n    r'currentversion\\\\explorer\\\\userassist',\n    r'sharedaccess',\n    r'hkcu\\\\software\\\\microsoft\\\\windows\\\\currentversion\\\\explorer',\n    r'currentversion\\\\explorer\\\\sessioninfo',\n    r'currentversion\\\\explorer\\\\advanced',\n    r'hkcu\\\\software\\\\microsoft\\\\windows\\\\currentversion\\\\internet settings',\n    r'hkcu\\\\software\\\\microsoft\\\\windows\\\\currentversion\\\\internet settings\\\\connections',\n]\n\nfor event_id, code, msg in cursor.fetchall():\n    msg_lower = msg.lower()\n    # Extract target object\n    target_match = re.search(r'TargetObject:\\s*(.*)', msg)\n    if target_match:\n        obj = target_match.group(1).lower()\n        if any(re.search(ign, obj) for ign in ignored):\n            continue\n        print(f\"{event_id} | {code} | {obj}\")\n    else:\n        print(f\"{event_id} | {code} | NO TARGET OBJECT | {msg[:100]}\")\n\nEOF\n"]
