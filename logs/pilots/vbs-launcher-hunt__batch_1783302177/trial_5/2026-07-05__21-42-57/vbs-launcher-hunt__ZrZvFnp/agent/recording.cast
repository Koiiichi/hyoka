[107.103376, "i", "cat << 'EOF' > /tmp/get_guid.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Get process GUID for wscript.exe\ncursor.execute(\"SELECT process_guid FROM events WHERE event_id = 'evt-00073';\")\nwscript_guid = cursor.fetchone()[0]\n\n# Get process GUID for powershell.exe\ncursor.execute(\"SELECT process_guid FROM events WHERE event_id = 'evt-00259';\")\npowershell_guid = cursor.fetchone()[0]\n\nprint(f\"wscript_guid: {wscript_guid}\")\nprint(f\"powershell_guid: {powershell_guid}\")\n\n# Now search all events by these GUIDs as either process_guid or parent_process_guid\ncursor.execute(\"\"\"\nSELECT event_id, event_code, host, image, parent_image, process_guid, parent_process_guid, message\nFROM events\nWHERE process_guid IN (?, ?) OR parent_process_guid IN (?, ?) OR message LIKE ? OR message LIKE ?\n\"\"\", (wscript_guid, powershell_guid, wscript_guid, powershell_guid, f'%{wscript_guid}%', f'%{powershell_guid}%'))\n\nresults = cursor.fetchall()\nprint(f\"Found {len(results)} related events.\")\nfor r in results[:100]:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]}\")\n\nEOF\n"]
