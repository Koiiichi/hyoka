[112.764212, "i", "cat << 'EOF' > /tmp/get_guid_stats.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT process_guid FROM events WHERE event_id = 'evt-00073';\")\nwscript_guid = cursor.fetchone()[0]\n\ncursor.execute(\"SELECT process_guid FROM events WHERE event_id = 'evt-00259';\")\npowershell_guid = cursor.fetchone()[0]\n\nprint(f\"wscript_guid: {wscript_guid}\")\nprint(f\"powershell_guid: {powershell_guid}\")\n\n# Group events by event_code for wscript\nprint(\"\\n--- wscript event counts ---\")\ncursor.execute(\"\"\"\nSELECT event_code, COUNT(*)\nFROM events\nWHERE process_guid = ? OR parent_process_guid = ? OR message LIKE ?\nGROUP BY event_code\n\"\"\", (wscript_guid, wscript_guid, f'%{wscript_guid}%'))\nfor code, count in cursor.fetchall():\n    print(f\"Event Code {code}: {count}\")\n\n# Group events by event_code for powershell\nprint(\"\\n--- powershell event counts ---\")\ncursor.execute(\"\"\"\nSELECT event_code, COUNT(*)\nFROM events\nWHERE process_guid = ? OR parent_process_guid = ? OR message LIKE ?\nGROUP BY event_code\n\"\"\", (powershell_guid, powershell_guid, f'%{powershell_guid}%'))\nfor code, count in cursor.fetchall():\n    print(f\"Event Code {code}: {count}\")\n\nEOF\n"]
