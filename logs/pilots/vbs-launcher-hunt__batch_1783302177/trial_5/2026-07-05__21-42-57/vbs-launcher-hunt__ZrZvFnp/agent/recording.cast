[185.257407, "i", "cat << 'EOF' > /tmp/clean_timeline.py\nimport sqlite3, re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# We want to select all events on WS-05 and filter out standard, highly repetitive noise.\n# Let's write rules to keep only interesting things.\n\ncursor.execute(\"\"\"\nSELECT event_id, timestamp, event_code, image, parent_image, command_line, message \nFROM events \nWHERE host = 'WS-05.corp.example'\nORDER BY timestamp ASC;\n\"\"\")\n\nevents = cursor.fetchall()\n\n# Known process GUIDs\nwscript_guid = \"{860ba2e3-9f13-5f52-2603-000000000400}\"\npowershell_guid = \"{860ba2e3-9f13-5f52-2703-000000000400}\"\nwhoami_guid = \"{860ba2e3-9f2e-5f52-2a03-000000000400}\"\nconhost_guid = \"{860ba2e3-9f19-5f52-2803-000000000400}\"\nwmiprvse_guid = \"{860ba2e3-9f19-5f52-2903-000000000400}\"\n\nmalicious_guids = {wscript_guid, powershell_guid, whoami_guid, conhost_guid, wmiprvse_guid}\n\n# We will filter out benign/noise events:\n# - Event 7 (Image loaded): almost always noisy unless it's a very specific DLL (let's print non-system DLLs if any, but otherwise skip)\n# - Event 10 (ProcessAccess): skip svchost/lsass standard audits unless they are unusual\n# - Event 12/13 (Registry): skip standard Windows/Net/Wbem/Internet Settings keys\n# - Event 4656/4658/4663/4690 (Object Access): usually noise, but let's see\n# - Event 5156/5158 (WFP): skip unless the remote IP is 10.10.10.5\n\nfor ev in events:\n    eid, ts, code, img, pimg, cmd, msg = ev\n    msg_str = (msg or \"\")\n    \n    # Extract GUIDs\n    pguid_match = re.search(r'ParentProcessGUID:\\s*({[^{}]+})', msg_str, re.IGNORECASE)\n    pguid = pguid_match.group(1) if pguid_match else \"\"\n    guid_match = re.search(r'ProcessGUID:\\s*({[^{}]+})', msg_str, re.IGNORECASE)\n    guid = guid_match.group(1) if guid_match else \"\"\n    \n    # If it's a highly chatty event code and not directly in our malicious guids, skip it\n    if code in (7, 10, 12, 13, 4656, 4658, 4663, 4690, 4703, 4673):\n        # check if it is related to our malicious processes\n        is_related = False\n        if pguid in malicious_guids or guid in malicious_guids:\n            is_related = True\n        # check if process ID or image in message matches\n        # we only want to print if it is interesting, like registry write to an AMSI/logging bypass key, or DLL load of an unusual DLL\n        if not is_related:\n            continue\n        # For registry (12, 13), only print if it's not internet settings / tcpip / certs / wbem\n        if code in (12, 13):\n            if any(x in msg_str.lower() for x in ['internet settings', 'tcpip', 'enterprisecertificates', 'wbem', 'systemcertificates', 'disallowed', 'desktop\\\\namespace', 'syncrootmanager']):\n                continue\n        # For process access (10), skip standard svchost/lsass to our processes\n        if code == 10:\n            if 'svchost.exe' in msg_str.lower() or 'lsass.exe' in msg_str.lower() or 'csrss.exe' in msg_str.lower():\n                continue\n        # For image load (7), skip standard Microsoft DLLs\n        if code == 7:\n            continue\n\n    if code in (5156, 5158):\n        # only print if 10.10.10.5 is involved\n        if '10.10.10.5' not in msg_str:\n            continue\n\n    # Print interesting events\n    print(f\"{eid} | {ts} | Code: {code} | Img: {img} | Cmd: {cmd or ''}\")\n    lines = [l.strip() for l in msg_str.split('\\n') if l.strip()]\n    for l in lines[:5]:\n        print(\"  \", l)\n\nEOF\n"]
