[123.507267, "i", "cat << 'EOF' > /tmp/get_malicious_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT process_guid FROM events WHERE event_id = 'evt-00073';\")\nwscript_guid = cursor.fetchone()[0]\n\ncursor.execute(\"SELECT process_guid FROM events WHERE event_id = 'evt-00259';\")\npowershell_guid = cursor.fetchone()[0]\n\nprint(\"--- Process Creations under wscript ---\")\ncursor.execute(\"\"\"\nSELECT event_id, event_code, image, command_line FROM events \nWHERE event_code IN (1, 4688) AND (parent_process_guid = ? OR process_guid = ?)\n\"\"\", (wscript_guid, wscript_guid))\nfor r in cursor.fetchall():\n    print(r)\n\nprint(\"\\n--- Process Creations under powershell ---\")\ncursor.execute(\"\"\"\nSELECT event_id, event_code, image, command_line FROM events \nWHERE event_code IN (1, 4688) AND (parent_process_guid = ? OR process_guid = ?)\n\"\"\", (powershell_guid, powershell_guid))\nfor r in cursor.fetchall():\n    print(r)\n\nEOF\n"]
