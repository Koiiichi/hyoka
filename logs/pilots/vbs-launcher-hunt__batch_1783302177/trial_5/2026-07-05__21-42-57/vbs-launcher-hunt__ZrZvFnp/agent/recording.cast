[202.376987, "o", "    pid = int(pid_match.group(1)) if pid_match else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.377239, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     spid_match = re.search(r'SourceProcessId:\\s*(\\d+)', msg_str, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h>     spid = int(spid_match.group(1)) if spid_match else None\r\n"]
[202.377257, "o", "\u001b[?2004l\r"]
[202.377376, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.377515, "o", "    tpid_match = re.search(r'TargetProcessId:\\s*(\\d+)', msg_str, re.IGNORECASE)\r\n"]
[202.377598, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[202.3777, "o", "    tpid = int(tpid_match.group(1)) if tpid_match else None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     is_mal = False\r\n\u001b[?2004l\r"]
[202.37787, "o", "\u001b[?2004h>     if pid in all_mal_pids or spid in all_mal_pids or tpid in all_mal_pids:\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.377934, "o", "    # Also check image names if they are related\r\n\u001b[?2004l\r\u001b[?2004h>     img_lower = (img or \"\").lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.37801, "o", "    if 'wscript.exe' in img_lower or 'powershell.exe' in img_lower or 'whoami.exe' in img_lower:\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     if not is_mal:\r\n\u001b[?2004l\r"]
[202.378038, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[202.378064, "o", "\u001b[?2004h> "]
[202.378137, "o", "    # Skip benign noise even if from malicious PID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.378175, "o", "    # - DLL loads (Event 7)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.378265, "o", "    # - Standard registry queries (12, 13) to Tcpip, Internet Settings, etc.\r\n\u001b[?2004l\r\u001b[?2004h>     if code == 7:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.378341, "o", "    if code in (12, 13):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.378476, "o", "        if any(x in msg_str.lower() for x in ['internet settings', 'tcpip', 'enterprisecertificates', 'wbem', 'systemcertificates', 'disallowed', 'desktop\\\\namespace', 'syncrootmanager', 'winscript', 'scripting']):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.378571, "o", ">     if code == 10:\r\n\u001b[?2004l\r\u001b[?2004h>         # Skip standard system process accesses to/from powershell/wscript\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.378711, "o", "        if 'svchost' in msg_str.lower() or 'lsass' in msg_str.lower() or 'csrss' in msg_str.lower():\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[202.378746, "o", "\u001b[?2004h> "]
[202.378871, "o", "    # If it is PowerShell event 800 or 4103, let's skip them because they are very chatty, \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.379067, "o", "    # unless they are really important, but we already have the main execution in 4104 (evt-00918).\r\n\u001b[?2004l\r\u001b[?2004h>     if code in (800, 4103):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.379098, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.379166, "o", "    # Summarize details\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.379188, "o", "    details = \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.379245, "o", ">     if code in (1, 4688):\r\n\u001b[?2004l\r"]
[202.37926, "o", "\u001b[?2004h> "]
[202.379305, "o", "        details = f\"Process Create: {cmd or ''}\"\r\n\u001b[?2004l\r\u001b[?2004h>     elif code == 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.379338, "o", "        # Network connection\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.379442, "o", "        dst_ip_match = re.search(r'DestinationIp:\\s*(\\S+)', msg_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.379523, "o", "        dst_port_match = re.search(r'DestinationPort:\\s*(\\S+)', msg_str)\r\n\u001b[?2004l\r\u001b[?2004h>         dst_ip = dst_ip_match.group(1) if dst_ip_match else \"\"\r\n\u001b[?2004l\r"]
[202.379536, "o", "\u001b[?2004h> "]
[202.379646, "o", "        dst_port = dst_port_match.group(1) if dst_port_match else \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.379737, "o", "        details = f\"Network Connection to {dst_ip}:{dst_port}\"\r\n\u001b[?2004l\r\u001b[?2004h>     elif code in (5156, 5158):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.379841, "o", "        details = f\"WFP Connection/Bind\"\r\n\u001b[?2004l\r\u001b[?2004h>     elif code in (11, 23):\r\n\u001b[?2004l\r\u001b[?2004h>         tf_match = re.search(r'TargetFilename:\\s*(.*)', msg_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.379935, "o", "        tf = tf_match.group(1) if tf_match else \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.380054, "o", "        action = \"File Created\" if code == 11 else \"File Deleted\"\r\n\u001b[?2004l\r\u001b[?2004h>         details = f\"{action}: {tf}\"\r\n\u001b[?2004l\r\u001b[?2004h>     elif code in (17, 18):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.380133, "o", "        pn_match = re.search(r'PipeName:\\s*(.*)', msg_str)\r\n\u001b[?2004l\r\u001b[?2004h>         pn = pn_match.group(1) if pn_match else \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.3802, "o", "        action = \"Pipe Created\" if code == 17 else \"Pipe Connected\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.380278, "o", "        details = f\"{action}: {pn}\"\r\n\u001b[?2004l\r\u001b[?2004h>     elif code == 22:\r\n\u001b[?2004l\r\u001b[?2004h>         details = f\"DNS Query\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.380287, "o", "    elif code == 4104:\r\n\u001b[?2004l\r"]
[202.380378, "o", "\u001b[?2004h>         details = f\"PowerShell Script Block Logging\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.380388, "o", "    elif code == 5857:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.380453, "o", "        details = f\"WMI Provider Started\"\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.380547, "o", "        # just show first line of message\r\n\u001b[?2004l\r\u001b[?2004h>         details = msg_str.split('\\n')[0]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.380629, "o", "    print(f\"{eid} | {ts} | Code: {code} | {img or pimg or ''} | {details[:120]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[202.381346, "o", "\u001b[?2004hroot@cc5485f3f7a8:~# "]
[202.844991, "i", "python3 /tmp/clean_details.py\n"]
