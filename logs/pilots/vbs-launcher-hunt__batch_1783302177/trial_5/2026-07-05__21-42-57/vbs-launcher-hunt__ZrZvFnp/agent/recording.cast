[101.569743, "i", "cat << 'EOF' > /tmp/check_reg_wscript.py\nimport sqlite3, re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n# Get all wscript events first\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND image LIKE '%wscript%' AND event_code IN (12, 13);\")\nfor event_id, code, msg in cursor.fetchall():\n    print(f\"{event_id} | {code} | {msg.replace('\\n', ' ')}\")\nEOF\n"]
