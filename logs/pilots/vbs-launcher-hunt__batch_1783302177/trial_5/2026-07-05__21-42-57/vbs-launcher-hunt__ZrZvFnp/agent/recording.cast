[162.143992, "o", "\u001b[?2004h> "]
[162.144005, "o", "for ev in events:\r\n\u001b[?2004l\r"]
[162.144069, "o", "\u001b[?2004h> "]
[162.144192, "o", "    eid, code, host, img, pimg, pguid, guid, cmd, msg = ev\r\n\u001b[?2004l\r\u001b[?2004h"]
[162.144311, "o", ">     msg_str = (msg or \"\")\r\n\u001b[?2004l\r\u001b[?2004h>     pid_match = re.search(r'ProcessId:\\s*(\\d+)', msg_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.144376, "o", "    spid_match = re.search(r'SourceProcessId:\\s*(\\d+)', msg_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.144395, "o", "    tpid_match = re.search(r'TargetProcessId:\\s*(\\d+)', msg_str)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[162.14458, "o", ">     is_malicious = False\r\n\u001b[?2004l\r\u001b[?2004h>     if guid in malicious_guids or pguid in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.144605, "o", "        is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>     elif pid_match and int(pid_match.group(1)) in malicious_pids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.144663, "o", "        is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.144741, "o", "    elif spid_match and int(spid_match.group(1)) in malicious_pids:\r\n\u001b[?2004l\r\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.144811, "o", "    elif tpid_match and int(tpid_match.group(1)) in malicious_pids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.144831, "o", "        is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[162.144874, "o", "> "]
[162.144963, "o", "    # Also catch based on image names if they are related to the malicious pids\r\n\u001b[?2004l\r"]
[162.145032, "o", "\u001b[?2004h>     # e.g. wscript.exe, powershell.exe, whoami.exe, conhost.exe, wmiprvse.exe\r\n\u001b[?2004l\r"]
[162.145112, "o", "\u001b[?2004h> "]
[162.145233, "o", "    # But we want to be highly precise so tracing GUIDs/PIDs is best.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.145248, "o", "    if is_malicious:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.145389, "o", "        malicious_events.append(ev)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(malicious_events)} potentially malicious events.\")\r\n\u001b[?2004l\r\u001b[?2004h> # Let's write them out chronologically\r\n\u001b[?2004l\r"]
[162.145514, "o", "\u001b[?2004h> malicious_events.sort(key=lambda x: x[1]) # sort by timestamp\r\n\u001b[?2004l\r\u001b[?2004h> with open('/tmp/suspect_events.txt', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.145557, "o", "    for ev in malicious_events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.145672, "o", "        eid, code, host, img, pimg, pguid, guid, cmd, msg = ev\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(f\"{eid} | {code} | {img} | {cmd or ''}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[162.146255, "o", "\u001b[?2004hroot@cc5485f3f7a8:~# "]
