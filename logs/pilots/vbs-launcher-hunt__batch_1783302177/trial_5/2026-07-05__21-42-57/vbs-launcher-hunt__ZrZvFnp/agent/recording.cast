[173.632023, "o", "cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> interesting_codes = [1, 4688, 3, 5, 17, 18, 22, 23, 4689, 4104, 5857, 4670, 9, 4673, 4703]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(f\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.632923, "o", "SELECT event_id, event_code, host, image, message \r\n\u001b[?2004l\r\u001b[?2004h> FROM events \r\n\u001b[?2004l\r\u001b[?2004h> WHERE host = 'WS-05.corp.example' AND event_code IN ({','.join(str(c) for c in interesting_codes)})\r\n\u001b[?2004l\r\u001b[?2004h> ORDER BY timestamp ASC;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for eid, code, host, img, msg in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"=== EVENT_ID: {eid} | CODE: {code} | IMG: {img} ===\")\r\n\u001b[?2004l\r\u001b[?2004h>     # Summarize message\r\n\u001b[?2004l\r\u001b[?2004h>     lines = [l.strip() for l in (msg or \"\").split('\\n') if l.strip()]\r\n\u001b[?2004l\r\u001b[?2004h>     for l in lines[:15]:\r\n\u001b[?2004l\r\u001b[?2004h>         print(\" \", l)\r\n\u001b[?2004l\r\u001b[?2004h>     print()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
