[162.140749, "i", "cat << 'EOF' > /tmp/parse_timeline.py\nimport re\n\n# Let's read ws05_timeline.txt and classify the events.\n# Malicious Process PIDs: \n# wscript: 2140? Let's check. \n# powershell: 2316\n# whoami: 9152\n# conhost: under powershell\n# wmiprvse: 4864 (maybe?)\n\n# Let's build a set of malicious process IDs dynamically\n# by starting with known malicious files/commands and tracing child/parent relationships.\n\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"SELECT event_id, event_code, host, image, parent_image, parent_process_guid, process_guid, command_line, message FROM events WHERE host = 'WS-05.corp.example'\")\nevents = cursor.fetchall()\n\nmalicious_guids = set()\nmalicious_pids = set()\n\n# Step 1: Initialize with known malicious entry points\nfor ev in events:\n    eid, code, host, img, pimg, pguid, guid, cmd, msg = ev\n    cmd_str = (cmd or \"\").lower()\n    img_str = (img or \"\").lower()\n    # launcher.vbs is definitely malicious\n    if 'launcher.vbs' in cmd_str:\n        malicious_guids.add(guid)\n        # Extract pid from msg\n        pid_match = re.search(r'ProcessId:\\s*(\\d+)', msg or \"\")\n        if pid_match:\n            malicious_pids.add(int(pid_match.group(1)))\n\n# Step 2: Propagate parent/child GUIDs (iterate a few times to get full tree)\nfor _ in range(5):\n    for ev in events:\n        eid, code, host, img, pimg, pguid, guid, cmd, msg = ev\n        if pguid in malicious_guids:\n            if guid:\n                malicious_guids.add(guid)\n            pid_match = re.search(r'ProcessId:\\s*(\\d+)', msg or \"\")\n            if pid_match:\n                malicious_pids.add(int(pid_match.group(1)))\n\nprint(f\"Malicious GUIDs: {malicious_guids}\")\nprint(f\"Malicious PIDs: {malicious_pids}\")\n\n# Step 3: Identify all events associated with these GUIDs or PIDs\nmalicious_events = []\nfor ev in events:\n    eid, code, host, img, pimg, pguid, guid, cmd, msg = ev\n    msg_str = (msg or \"\")\n    pid_match = re.search(r'ProcessId:\\s*(\\d+)', msg_str)\n    spid_match = re.search(r'SourceProcessId:\\s*(\\d+)', msg_str)\n    tpid_match = re.search(r'TargetProcessId:\\s*(\\d+)', msg_str)\n    \n    is_malicious = False\n    if guid in malicious_guids or pguid in malicious_guids:\n        is_malicious = True\n    elif pid_match and int(pid_match.group(1)) in malicious_pids:\n        is_malicious = True\n    elif spid_match and int(spid_match.group(1)) in malicious_pids:\n        is_malicious = True\n    elif tpid_match and int(tpid_match.group(1)) in malicious_pids:\n        is_malicious = True\n    \n    # Also catch based on image names if they are related to the malicious pids\n    # e.g. wscript.exe, powershell.exe, whoami.exe, conhost.exe, wmiprvse.exe\n    # But we want to be highly precise so tracing GUIDs/PIDs is best.\n    \n    if is_malicious:\n        malicious_events.append(ev)\n\nprint(f\"Found {len(malicious_events)} potentially malicious events.\")\n# Let's write them out chronologically\nmalicious_events.sort(key=lambda x: x[1]) # sort by timestamp\nwith open('/tmp/suspect_events.txt', 'w') as f:\n    for ev in malicious_events:\n        eid, code, host, img, pimg, pguid, guid, cmd, msg = ev\n        f.write(f\"{eid} | {code} | {img} | {cmd or ''}\\n\")\n\nEOF\n"]
