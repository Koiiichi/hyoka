[278.684419, "i", "cat << 'EOF' > /tmp/save_findings.py\nimport json\n\nfindings = [\n    \"evt-00073\", # Sysmon 1 - wscript.exe launcher.vbs\n    \"evt-00247\", # Security 4688 - wscript.exe launcher.vbs\n    \"evt-00272\", # Sysmon 5 - wscript.exe terminated\n    \"evt-00340\", # Security 4689 - wscript.exe exited\n    \"evt-00259\", # Sysmon 1 - powershell.exe stager\n    \"evt-00328\", # Security 4688 - powershell.exe stager\n    \"evt-00289\", # Sysmon 1 - conhost.exe backing powershell\n    \"evt-00343\", # Security 4688 - conhost.exe backing powershell\n    \"evt-00918\", # PowerShell 4104 - stager Script Block logging\n    \"evt-01478\", # Sysmon 3 - Outbound C2 connection to 10.10.10.5:80\n    \"evt-01409\", # Security 5158 - local port bind for powershell.exe\n    \"evt-01410\", # Security 5156 - outbound C2 connection permitted\n    \"evt-01496\", # Sysmon 1 - wmiprvse.exe triggered by powershell\n    \"evt-01628\", # Security 4688 - wmiprvse.exe triggered by powershell\n    \"evt-01817\", # Security 4688 - whoami.exe\n    \"evt-01820\", # Sysmon 1 - whoami.exe\n    \"evt-01832\", # Security 4689 - whoami.exe exited\n    \"evt-01858\"  # Sysmon 5 - whoami.exe terminated\n]\n\n# Ensure it's sorted\nfindings.sort()\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(findings, f, indent=2)\n\nprint(\"Findings saved to /root/findings.json successfully.\")\nEOF\n"]
