[192.170306, "i", "cat << 'EOF' > /tmp/format_timeline.py\nwith open('/tmp/clean_timeline.txt') as f:\n    lines = f.readlines()\n\nfor l in lines[:100]:\n    if len(l) > 120:\n        print(l[:117] + \"...\")\n    else:\n        print(l.rstrip())\nEOF\n"]
