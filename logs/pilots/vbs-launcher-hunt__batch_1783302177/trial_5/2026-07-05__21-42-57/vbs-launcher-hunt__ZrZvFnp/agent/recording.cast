[173.631469, "i", "cat << 'EOF' > /tmp/inspect_low_counts.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ninteresting_codes = [1, 4688, 3, 5, 17, 18, 22, 23, 4689, 4104, 5857, 4670, 9, 4673, 4703]\n\ncursor.execute(f\"\"\"\nSELECT event_id, event_code, host, image, message \nFROM events \nWHERE host = 'WS-05.corp.example' AND event_code IN ({','.join(str(c) for c in interesting_codes)})\nORDER BY timestamp ASC;\n\"\"\")\n\nfor eid, code, host, img, msg in cursor.fetchall():\n    print(f\"=== EVENT_ID: {eid} | CODE: {code} | IMG: {img} ===\")\n    # Summarize message\n    lines = [l.strip() for l in (msg or \"\").split('\\n') if l.strip()]\n    for l in lines[:15]:\n        print(\" \", l)\n    print()\n\nEOF\n"]
[173.631644, "o", "cat << 'EOF' > /tmp/inspect_low_counts.py\r\n\u001b[?2004l\r"]
