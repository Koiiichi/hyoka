[252.018608, "i", "python3 -c \"\nimport sqlite3, re\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\\\"SELECT event_id, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 4673 ORDER BY timestamp ASC;\\\")\nfor eid, ts, msg in cursor.fetchall():\n    proc_match = re.search(r'Process Name:\\s*(.*)', msg)\n    proc = proc_match.group(1) if proc_match else 'Unknown'\n    priv_match = re.search(r'Privileges:\\s*(.*)', msg)\n    priv = priv_match.group(1) if priv_match else 'Unknown'\n    print(f\\\"{eid} | {ts} | {proc} | {priv}\\\")\n\"\n"]
[252.019725, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
