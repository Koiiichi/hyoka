[202.877481, "o", "\u001b[?2004hroot@cc5485f3f7a8:~# "]
[213.001516, "i", "cat << 'EOF' > /tmp/clean_details2.py\nimport sqlite3, re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's select all events from WS-05 starting from 2026-05-06T00:00:15\ncursor.execute(\"\"\"\nSELECT event_id, timestamp, event_code, image, parent_image, command_line, message \nFROM events \nWHERE host = 'WS-05.corp.example' AND timestamp >= '2026-05-06T00:00:15'\nORDER BY timestamp ASC;\n\"\"\")\n\nevents = cursor.fetchall()\n\n# Known process PIDs/GUIDs\nwscript_pids = {2440}\npowershell_pids = {2316}\nconhost_pids = {5964}\nwhoami_pids = {9152}\nwmiprvse_pids = {4864}\n\nall_mal_pids = wscript_pids | powershell_pids | conhost_pids | whoami_pids | wmiprvse_pids\n\nfor ev in events:\n    eid, ts, code, img, pimg, cmd, msg = ev\n    msg_str = (msg or \"\")\n    \n    # Check if the process ID is in our malicious PIDs\n    pid_match = re.search(r'ProcessId:\\s*(\\d+)', msg_str, re.IGNORECASE)\n    pid = int(pid_match.group(1)) if pid_match else None\n    \n    spid_match = re.search(r'SourceProcessId:\\s*(\\d+)', msg_str, re.IGNORECASE)\n    spid = int(spid_match.group(1)) if spid_match else None\n    \n    tpid_match = re.search(r'TargetProcessId:\\s*(\\d+)', msg_str, re.IGNORECASE)\n    tpid = int(tpid_match.group(1)) if tpid_match else None\n    \n    is_mal = False\n    if pid in all_mal_pids or spid in all_mal_pids or tpid in all_mal_pids:\n        is_mal = True\n    \n    # Also check image names if they are related\n    img_lower = (img or \"\").lower()\n    if 'wscript.exe' in img_lower or 'powershell.exe' in img_lower or 'whoami.exe' in img_lower:\n        is_mal = True\n        \n    if not is_mal:\n        continue\n        \n    # Skip DLL loads (Event 7) and ALL registry (12, 13)\n    if code in (7, 12, 13):\n        continue\n    if code == 10:\n        # Skip standard system process accesses\n        if 'svchost' in msg_str.lower() or 'lsass' in msg_str.lower() or 'csrss' in msg_str.lower():\n            continue\n            \n    if code in (800, 4103):\n        continue\n        \n    details = \"\"\n    if code in (1, 4688):\n        details = f\"Process Create: {cmd or ''}\"\n    elif code == 3:\n        # Network connection\n        dst_ip_match = re.search(r'DestinationIp:\\s*(\\S+)', msg_str)\n        dst_port_match = re.search(r'DestinationPort:\\s*(\\S+)', msg_str)\n        dst_ip = dst_ip_match.group(1) if dst_ip_match else \"\"\n        dst_port = dst_port_match.group(1) if dst_port_match else \"\"\n        details = f\"Network Connection to {dst_ip}:{dst_port}\"\n    elif code in (5156, 5158):\n        details = f\"WFP Connection/Bind\"\n    elif code in (11, 23):\n        tf_match = re.search(r'TargetFilename:\\s*(.*)', msg_str)\n        tf = tf_match.group(1) if tf_match else \"\"\n        action = \"File Created\" if code == 11 else \"File Deleted\"\n        details = f\"{action}: {tf}\"\n    elif code in (17, 18):\n        pn_match = re.search(r'PipeName:\\s*(.*)', msg_str)\n        pn = pn_match.group(1) if pn_match else \"\"\n        action = \"Pipe Created\" if code == 17 else \"Pipe Connected\"\n        details = f\"{action}: {pn}\"\n    elif code == 22:\n        details = f\"DNS Query\"\n    elif code == 4104:\n        details = f\"PowerShell Script Block Logging\"\n    elif code == 5857:\n        details = f\"WMI Provider Started\"\n    else:\n        details = msg_str.split('\\n')[0]\n        \n    print(f\"{eid} | {ts} | Code: {code} | {img or pimg or ''} | {details[:120]}\")\n\nEOF\n"]
