[128.293621, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nwscript_guid = cursor.execute(\\\"SELECT process_guid FROM events WHERE event_id = 'evt-00073';\\\").fetchone()[0]\npowershell_guid = cursor.execute(\\\"SELECT process_guid FROM events WHERE event_id = 'evt-00259';\\\").fetchone()[0]\n\nprint('--- wscript related processes ---')\ncursor.execute(\\\"\\\"\\\"\nSELECT event_id, event_code, image, substr(command_line, 1, 100) \nFROM events \nWHERE event_code IN (1, 4688) \nAND (parent_process_guid = ? OR process_guid = ?)\n\\\"\\\"\\\", (wscript_guid, wscript_guid))\nfor r in cursor.fetchall():\n    print(r)\n\nprint('\\n--- powershell related processes ---')\ncursor.execute(\\\"\\\"\\\"\nSELECT event_id, event_code, image, substr(command_line, 1, 100) \nFROM events \nWHERE event_code IN (1, 4688) \nAND (parent_process_guid = ? OR process_guid = ?)\n\\\"\\\"\\\", (powershell_guid, powershell_guid))\nfor r in cursor.fetchall():\n    print(r)\n\"\n"]
