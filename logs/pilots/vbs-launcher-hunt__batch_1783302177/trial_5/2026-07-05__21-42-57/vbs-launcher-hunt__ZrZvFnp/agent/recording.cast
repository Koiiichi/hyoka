[152.363399, "i", "cat << 'EOF' > /tmp/dump_all_ws05.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\nSELECT event_id, timestamp, event_code, channel, provider, image, parent_image, command_line, message \nFROM events \nWHERE host = 'WS-05.corp.example'\nORDER BY timestamp ASC;\n\"\"\")\n\nall_events = cursor.fetchall()\n\n# Open output file\nwith open('/tmp/ws05_timeline.txt', 'w') as f:\n    f.write(f\"Total WS-05 events: {len(all_events)}\\n\\n\")\n    for ev in all_events:\n        eid, ts, code, chan, prov, img, pimg, cmd, msg = ev\n        f.write(f\"EVENT_ID: {eid} | TS: {ts} | CODE: {code} | CHAN: {chan} | IMG: {img} | CMD: {cmd}\\n\")\n        # Just a summary of message\n        msg_lines = [l.strip() for l in (msg or \"\").split('\\n') if l.strip()]\n        summary = \" | \".join(msg_lines[:3])\n        f.write(f\"  MSG SUMMARY: {summary[:200]}\\n\\n\")\n\nprint(\"Dump completed.\")\nEOF\n"]
