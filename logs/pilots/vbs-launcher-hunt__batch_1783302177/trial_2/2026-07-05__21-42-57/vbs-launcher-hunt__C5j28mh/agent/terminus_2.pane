[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> print("=== File Analysis ===")
[?2004l[?2004h> with open('/tmp/files.txt', 'r') as f:
[?2004l[?2004h>     lines = f.read().split('evt-')
[?2004l[?2004h>     for l in lines:
[?2004l[?2004h>         if not l.strip():
[?2004l[?2004h>             continue
[?2004l[?2004h>         eid = 'evt-' + l.split(' | ')[0]
[?2004l[?2004h>         # Find TargetFilename inside details / message
[?2004l[?2004h>         tf_m = re.search(r'TargetFilename: (.*)', l)
[?2004l[?2004h>         tf = tf_m.group(1).strip() if tf_m else "Unknown"
[?2004l[?2004h>         image_m = re.search(r'Image: (.*)', l)
[?2004l[?2004h>         img = image_m.group(1).strip() if image_m else "Unknown"
[?2004l[?2004h>         print(f"{eid} | {img} created {tf}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== Registry Analysis (Summary) ===")
[?2004l[?2004h> reg_events = []
[?2004l[?2004h> with open('/tmp/registry.txt', 'r') as f:
[?2004l[?2004h>     # Since registry events can be noisy, let's look at non-standard images/keys
[?2004l[?2004h>     lines = f.read().split('evt-')
[?2004l[?2004h>     for l in lines:
[?2004l[?2004h>         if not l.strip():
[?2004l[?2004h>             continue
[?2004l[?2004h>         parts = l.split(' | ')
[?2004l[?2004h>         eid = 'evt-' + parts[0]
[?2004l[?2004h>         img = parts[5] if len(parts) > 5 else ""
[?2004l[?2004h>         obj = parts[6] if len(parts) > 6 else ""
[?2004l[?2004h>         # print first few
[?2004l[?2004h>         reg_events.append((eid, img, obj))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total Registry events: {len(reg_events)}")
[?2004l[?2004h> print("Registry modifications by powershell.exe:")
[?2004l[?2004h> for reid, rimg, robj in reg_events:
[?2004l[?2004h>     if 'powershell' in rimg.lower() or 'wscript' in rimg.lower():
[?2004l[?2004h>         print(f"{reid} | {rimg} | {robj}")
[?2004l[?2004h> 
