[?2004hroot@5a136eabef84:~# cat << 'EOF' > /tmp/parse_network.py
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> with open('/tmp/network.txt') as f:
[?2004l[?2004h>     content = f.read()
[?2004l[?2004h> 
[?2004l[?2004h> blocks = content.split('\nevt-')
[?2004l[?2004h> for i, b in enumerate(blocks):
[?2004l[?2004h>     if i == 0:
[?2004l[?2004h>         if b.startswith('=== '):
[?2004l[?2004h>             continue
[?2004l[?2004h>         b = 'evt-' + b
[?2004l[?2004h>     else:
[?2004l[?2004h>         b = 'evt-' + b
[?2004l[?2004h> 
[?2004l[?2004h>     lines = b.strip().split('\n')
[?2004l[?2004h>     header = lines[0]
[?2004l[?2004h>     eid = header.split(' | ')[0]
[?2004l[?2004h>     host = header.split(' | ')[3]
[?2004l[?2004h>     image = header.split(' | ')[4]
[?2004l[?2004h>     user = header.split(' | ')[5]
[?2004l[?2004h>     src_dst = header.split(' | ')[6]
[?2004l[?2004h>     
[?2004l[?2004h>     # Only focus on WS-05 network events
[?2004l[?2004h>     if 'WS-05' in host or 'powershell' in image.lower() or 'wscript' in image.lower():
[?2004l[?2004h>         print(f"{eid} | {host} | {image} | {user} | {src_dst}")
[?2004l[?2004h>         # Print details if any
[?2004l[?2004h>         for l in lines[1:]:
[?2004l[?2004h>             if l.strip() and 'RuleName' not in l and 'UtcTime' not in l:
[?2004l[?2004h>                 print(f"  {l.strip()}")
