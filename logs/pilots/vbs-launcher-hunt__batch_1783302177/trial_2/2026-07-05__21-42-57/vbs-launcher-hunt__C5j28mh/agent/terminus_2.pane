[?2004hroot@5a136eabef84:~# cat << 'EOF' > /tmp/analyze.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect processes
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, timestamp, host, user, image, parent_image, command_line FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp")
[?2004l[?2004h> processes = [dict(r) for r in cur.fetchall()]
[?2004l[?2004h> print("=== PROCESSES ===")
[?2004l[?2004h> for p in processes:
[?2004l[?2004h>     print(f"{p['event_id']} | {p['timestamp']} | {p['host']} | {p['user']} | {p['image']} | {p['parent_image']} | {p['command_line']}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's check network connections (event code 3 or 5156/5158)
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, timestamp, host, image, user, src_ip, dst_ip, dst_port FROM events WHERE event_code IN (3, 5156, 5158) ORDER BY timestamp")
[?2004l[?2004h> network = [dict(r) for r in cur.fetchall()]
[?2004l[?2004h> print("\n=== NETWORK ===")
[?2004l[?2004h> for n in network:
[?2004l[?2004h>     print(f"{n['event_id']} | {n['event_code']} | {n['timestamp']} | {n['host']} | {n['image']} | {n['user']} | {n['src_ip']} -> {n['dst_ip']}:{n['dst_port']}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@5a136eabef84:~# python3 /tmp/analyze.py
