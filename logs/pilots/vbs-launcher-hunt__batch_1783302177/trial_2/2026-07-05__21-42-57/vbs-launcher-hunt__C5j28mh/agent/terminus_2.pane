[?2004hroot@5a136eabef84:~# cat << 'EOF' > /tmp/parse_blocks.py
[?2004l[?2004h> import sys
[?2004l[?2004h> 
[?2004l[?2004h> def parse_file(filename):
[?2004l[?2004h>     with open(filename) as f:
[?2004l[?2004h>         content = f.read()
[?2004l[?2004h>     
[?2004l[?2004h>     # Split by 'evt-'
[?2004l[?2004h>     blocks = content.split('\nevt-')
[?2004l[?2004h>     results = []
[?2004l[?2004h>     for i, b in enumerate(blocks):
[?2004l[?2004h>         if i == 0:
[?2004l[?2004h>             # First block might contain the header, skip or handle
[?2004l[?2004h>             if b.startswith('=== '):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             b = 'evt-' + b
[?2004l[?2004h>         else:
[?2004l[?2004h>             b = 'evt-' + b
[?2004l[?2004h>         
[?2004l[?2004h>         lines = b.strip().split('\n')
[?2004l[?2004h>         header_line = lines[0]
[?2004l[?2004h>         parts = header_line.split(' | ')
[?2004l[?2004h>         eid = parts[0]
[?2004l[?2004h>         
[?2004l[?2004h>         # Rest of lines
[?2004l[?2004h>         details = "\n".join(lines[1:])
[?2004l[?2004h>         results.append((eid, header_line, details))
[?2004l[?2004h>     return results
[?2004l[?2004h> 
[?2004l[?2004h> files_parsed = parse_file('/tmp/files.txt')
[?2004l[?2004h> print("=== PARSED FILES ===")
[?2004l[?2004h> for eid, header, details in files_parsed:
[?2004l[?2004h>     if 'prefetch' in details.lower() or 'wscript' in details.lower() or 'powershell' in details.lower() or 'whoami' in details.lower() or 'launcher' in details.lower():
[?2004l[?2004h>         print(f"{header}")
[?2004l[?2004h>         for l in details.split('\n'):
[?2004l[?2004h>             if 'TargetFilename' in l or 'Image' in l:
