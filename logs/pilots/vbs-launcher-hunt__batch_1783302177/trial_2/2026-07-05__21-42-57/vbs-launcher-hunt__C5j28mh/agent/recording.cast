[133.993857, "i", "cat << 'EOF' > /tmp/check_other_hosts_refined.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, timestamp, host, user, target_user, image, parent_image, command_line, message FROM events WHERE host IN ('WS-06.corp.example', 'DC01.corp.example') AND event_code NOT IN (7, 10, 4656, 4658, 4663, 4690, 5156, 5158)\")\nfor r in cur.fetchall():\n    user = r['user'] or r['target_user'] or \"\"\n    if not any(x in user.upper() for x in ['SYSTEM', 'SERVICE', 'DC01$', 'WS-06$']):\n        print(f\"{r['event_id']} | {r['host']} | {r['event_code']} | user: {user} | img: {r['image']} | cmd: {r['command_line']} | msg_len: {len(r['message']) if r['message'] else 0}\")\n\nEOF\npython3 /tmp/check_other_hosts_refined.py\n"]
