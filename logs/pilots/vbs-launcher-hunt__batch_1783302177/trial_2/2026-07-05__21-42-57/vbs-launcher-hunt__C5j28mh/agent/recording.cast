[188.258007, "o", "\r\n\u001b[?2004l\r"]
[188.266152, "o", "=== Uncorrelated Event Codes ===\r\nCode 10: 106\r\nCode 12: 62\r\nCode 13: 43\r\nCode 11: 16\r\nCode 9: 9\r\nCode 7: 7\r\nCode 18: 1\r\nCode 3: 1\r\nCode 22: 1\r\n\r\n=== Uncorrelated Images ===\r\nC:\\windows\\system32\\svchost.exe: 115\r\nC:\\Program Files\\Windows Defender\\MsMpEng.exe: 52\r\nC:\\windows\\Explorer.EXE: 41\r\nC:\\windows\\system32\\DllHost.exe: 9\r\nSystem: 9\r\nC:\\Windows\\explorer.exe: 7\r\nC:\\windows\\System32\\svchost.exe: 5\r\nC:\\windows\\system32\\SearchIndexer.exe: 3\r\nC:\\windows\\system32\\services.exe: 3\r\nC:\\Windows\\System32\\smartscreen.exe: 1\r\nC:\\windows\\system32\\lsass.exe: 1\r\n"]
[188.267891, "o", "\u001b[?2004hroot@5a136eabef84:~# "]
[194.941452, "i", "cat << 'EOF' > /tmp/inspect_uncorrelated_suspects.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's inspect Code 3, 22, and 11 events in uncorrelated\nuncorrelated_eids = []\nwith open('/tmp/uncorrelated_list.txt') as f:\n    for line in f:\n        uncorrelated_eids.append(line.split(' | ')[0])\n\neid_str = \",\".join(f\"'{e}'\" for e in uncorrelated_eids)\n\ncur.execute(f\"\"\"\n    SELECT event_id, event_code, timestamp, image, target_object, details, message \n    FROM events \n    WHERE event_id IN ({eid_str}) AND event_code IN (3, 11, 22)\n\"\"\")\n\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Img: {r['image']} | Obj: {r['target_object']} | Msg: {r['message'][:200]}...\")\n\nEOF\npython3 /tmp/inspect_uncorrelated_suspects.py\n"]
