[307.859351, "o", "\u001b[?2004hroot@5a136eabef84:~# "]
[313.441566, "i", "cat << 'EOF' > /tmp/check_findings_stats.py\nimport sqlite3\nimport json\nimport collections\n\nwith open('/root/findings.json') as f:\n    eids = json.load(f)\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\neid_str = \",\".join(f\"'{e}'\" for e in eids)\ncur.execute(f\"SELECT event_code, COALESCE(image, 'None') as img FROM events WHERE event_id IN ({eid_str})\")\n\ncodes = collections.Counter()\nimages = collections.Counter()\nfor r in cur.fetchall():\n    codes[r['event_code']] += 1\n    images[r['img']] += 1\n\nprint(\"=== Findings Event Code Stats ===\")\nfor c, count in codes.most_common():\n    print(f\"Code {c}: {count}\")\n\nprint(\"\\n=== Findings Image Stats ===\")\nfor img, count in images.most_common(20):\n    print(f\"{img}: {count}\")\n\nEOF\npython3 /tmp/check_findings_stats.py\n"]
