[84.803283, "i", "cat << 'EOF' > /tmp/parse_clean_network.py\nwith open('/tmp/network.txt') as f:\n    content = f.read()\n\nblocks = content.split('\\nevt-')\nfor i, b in enumerate(blocks):\n    if i == 0:\n        if b.startswith('=== '):\n            continue\n        b = 'evt-' + b\n    else:\n        b = 'evt-' + b\n    \n    if 'windowsazure' in b.lower() or 'guestagent' in b.lower():\n        continue\n    \n    lines = b.strip().split('\\n')\n    header = lines[0]\n    parts = header.split(' | ')\n    eid = parts[0]\n    code = parts[1]\n    ts = parts[2]\n    host = parts[3]\n    image = parts[4]\n    user = parts[5]\n    \n    # Only interested in WS-05 or connections from powershell, etc.\n    if 'WS-05' in host:\n        print(header)\n        for l in lines[1:]:\n            print(\"  \" + l)\nEOF\npython3 /tmp/parse_clean_network.py\n"]
