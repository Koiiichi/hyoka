[75.14342, "i", "cat << 'EOF' > /tmp/parse_network.py\nimport re\n\nwith open('/tmp/network.txt') as f:\n    content = f.read()\n\nblocks = content.split('\\nevt-')\nfor i, b in enumerate(blocks):\n    if i == 0:\n        if b.startswith('=== '):\n            continue\n        b = 'evt-' + b\n    else:\n        b = 'evt-' + b\n\n    lines = b.strip().split('\\n')\n    header = lines[0]\n    eid = header.split(' | ')[0]\n    host = header.split(' | ')[3]\n    image = header.split(' | ')[4]\n    user = header.split(' | ')[5]\n    src_dst = header.split(' | ')[6]\n    \n    # Only focus on WS-05 network events\n    if 'WS-05' in host or 'powershell' in image.lower() or 'wscript' in image.lower():\n        print(f\"{eid} | {host} | {image} | {user} | {src_dst}\")\n        # Print details if any\n        for l in lines[1:]:\n            if l.strip() and 'RuleName' not in l and 'UtcTime' not in l:\n                print(f\"  {l.strip()}\")\nEOF\npython3 /tmp/parse_network.py\n"]
