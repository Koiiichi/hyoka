[123.20581, "o", "\u001b[?2004hroot@5a136eabef84:~# "]
[128.148921, "i", "cat << 'EOF' > /tmp/check_other_hosts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, timestamp, host, user, target_user, image, parent_image, command_line, message FROM events WHERE host IN ('WS-06.corp.example', 'DC01.corp.example')\")\nfor r in cur.fetchall():\n    user = r['user'] or r['target_user'] or \"\"\n    # filter out typical machine accounts/system\n    if not any(x in user.upper() for x in ['SYSTEM', 'SERVICE', 'DC01$', 'WS-06$']):\n        print(f\"{r['event_id']} | {r['host']} | {r['event_code']} | user: {user} | img: {r['image']} | cmd: {r['command_line']}\")\n\nEOF\npython3 /tmp/check_other_hosts.py\n"]
[128.149249, "o", "cat << 'EOF' > /tmp/check_other_hosts.py\r\n\u001b[?2004l\r"]
