[27.794161, "o", "\u001b[?2004hroot@5a136eabef84:~# "]
[36.363092, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nwith open('/tmp/processes.txt', 'w') as f:\n    cur.execute(\"SELECT event_id, event_code, timestamp, host, user, image, parent_image, command_line FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp\")\n    f.write(\"=== PROCESSES ===\\n\")\n    for p in cur.fetchall():\n        f.write(f\"{p['event_id']} | {p['event_code']} | {p['timestamp']} | {p['host']} | {p['user']} | {p['image']} | {p['parent_image']} | {p['command_line']}\\n\")\n\nwith open('/tmp/network.txt', 'w') as f:\n    cur.execute(\"SELECT event_id, event_code, timestamp, host, image, user, src_ip, dst_ip, dst_port, message FROM events WHERE event_code IN (3, 5156, 5158) ORDER BY timestamp\")\n    f.write(\"=== NETWORK ===\\n\")\n    for n in cur.fetchall():\n        f.write(f\"{n['event_id']} | {n['event_code']} | {n['timestamp']} | {n['host']} | {n['image']} | {n['user']} | {n['src_ip']} -> {n['dst_ip']}:{n['dst_port']} | {n['message']}\\n\")\n\nwith open('/tmp/powershell.txt', 'w') as f:\n    cur.execute(\"SELECT event_id, event_code, timestamp, host, user, message FROM events WHERE event_code IN (4103, 4104, 800) ORDER BY timestamp\")\n    f.write(\"=== POWERSHELL ===\\n\")\n    for p in cur.fetchall():\n        f.write(f\"{p['event_id']} | {p['event_code']} | {p['timestamp']} | {p['host']} | {p['user']} | {len(p['message']) if p['message'] else 0}\\n\")\n\nwith open('/tmp/files.txt', 'w') as f:\n    cur.execute(\"SELECT event_id, event_code, timestamp, host, user, image, target_object, details, message FROM events WHERE event_code IN (11) ORDER BY timestamp\")\n    f.write(\"=== FILES ===\\n\")\n    for p in cur.fetchall():\n        f.write(f\"{p['event_id']} | {p['event_code']} | {p['timestamp']} | {p['host']} | {p['user']} | {p['image']} | {p['target_object']} | {p['details']} | {p['message']}\\n\")\n\nwith open('/tmp/registry.txt', 'w') as f:\n    cur.execute(\"SELECT event_id, event_code, timestamp, host, user, image, target_object, details, message FROM events WHERE event_code IN (12, 13) ORDER BY timestamp\")\n    f.write(\"=== REGISTRY ===\\n\")\n    for p in cur.fetchall():\n        f.write(f\"{p['event_id']} | {p['event_code']} | {p['timestamp']} | {p['host']} | {p['user']} | {p['image']} | {p['target_object']} | {p['details']} | {p['message']}\\n\")\n\nEOF\npython3 /tmp/analyze.py\n"]
