[91.194516, "i", "cat << 'EOF' > /tmp/summarize_network.py\nimport re\n\nwith open('/tmp/network.txt') as f:\n    content = f.read()\n\nblocks = content.split('\\nevt-')\nfor i, b in enumerate(blocks):\n    if i == 0:\n        if b.startswith('=== '):\n            continue\n        b = 'evt-' + b\n    else:\n        b = 'evt-' + b\n    \n    if 'windowsazure' in b.lower() or 'guestagent' in b.lower():\n        continue\n    \n    lines = b.strip().split('\\n')\n    header = lines[0]\n    parts = header.split(' | ')\n    eid = parts[0]\n    code = parts[1]\n    ts = parts[2]\n    host = parts[3]\n    image = parts[4]\n    user = parts[5]\n    src_dst = parts[6]\n    \n    if 'WS-05' in host:\n        # Find application name/image in details\n        app_name = \"\"\n        app_m = re.search(r'Application Name:\\s*(.*)', b, re.IGNORECASE)\n        if app_m:\n            app_name = app_m.group(1).strip()\n        \n        # Find destination address\n        dst_addr = \"\"\n        dst_m = re.search(r'Destination Address:\\s*(.*)', b, re.IGNORECASE)\n        if dst_m:\n            dst_addr = dst_m.group(1).strip()\n            \n        dst_port = \"\"\n        port_m = re.search(r'Destination Port:\\s*(.*)', b, re.IGNORECASE)\n        if port_m:\n            dst_port = port_m.group(1).strip()\n            \n        print(f\"{eid} | {ts} | {code} | {image or app_name} | {src_dst} | {dst_addr}:{dst_port}\")\n\nEOF\npython3 /tmp/summarize_network.py\n"]
[91.19758, "o", "cat << 'EOF' > /tmp/summarize_network.py\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/tmp/network.txt') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     content = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> blocks = content.split('\\nevt-')\r\n\u001b[?2004l\r\u001b[?2004h> for i, b in enumerate(blocks):\r\n\u001b[?2004l\r\u001b[?2004h>     if i == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         if b.startswith('=== '):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         b = 'evt-' + b\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         b = 'evt-' + b\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if 'windowsazure' in b.lower() or 'guestagent' in b.lower():\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     lines = b.strip().split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h>     header = lines[0]\r\n\u001b[?2004l\r\u001b[?2004h>     parts = header.split(' | ')\r\n\u001b[?2004l\r\u001b[?2004h>     eid = parts[0]\r\n\u001b[?2004l\r\u001b[?2004h>     code = parts[1]\r\n\u001b[?2004l\r\u001b[?2004h>     ts = parts[2]\r\n\u001b[?2004l\r\u001b[?2004h>     host = parts[3]\r\n\u001b[?2004l\r\u001b[?2004h>     image = parts[4]\r\n\u001b[?2004l\r\u001b[?2004h>     user = parts[5]\r\n\u001b[?2004l\r\u001b[?2004h>     src_dst = parts[6]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if 'WS-05' in host:\r\n\u001b[?2004l\r\u001b[?2004h>         # Find application name/image in details\r\n\u001b[?2004l\r\u001b[?2004h>         app_name = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         app_m = re.search(r'Application Name:\\s*(.*)', b, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h>         if app_m:\r\n\u001b[?2004l\r\u001b[?2004h>             app_name = app_m.group(1).strip()\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Find destination address\r\n\u001b[?2004l\r\u001b[?2004h>         dst_addr = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         dst_m = re.search(r'Destination Address:\\s*(.*)', b, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h>         if dst_m:\r\n\u001b[?2004l\r\u001b[?2004h>             dst_addr = dst_m.group(1).strip()\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>         dst_port = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         port_m = re.search(r'Destination Port:\\s*(.*)', b, re.IGNORECASE)\r\n\u001b[?2004l\r"]
