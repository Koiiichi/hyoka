[27.774239, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's inspect processes\ncur.execute(\"SELECT event_id, event_code, timestamp, host, user, image, parent_image, command_line FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp\")\nprocesses = [dict(r) for r in cur.fetchall()]\nprint(\"=== PROCESSES ===\")\nfor p in processes:\n    print(f\"{p['event_id']} | {p['timestamp']} | {p['host']} | {p['user']} | {p['image']} | {p['parent_image']} | {p['command_line']}\")\n\n# Let's check network connections (event code 3 or 5156/5158)\ncur.execute(\"SELECT event_id, event_code, timestamp, host, image, user, src_ip, dst_ip, dst_port FROM events WHERE event_code IN (3, 5156, 5158) ORDER BY timestamp\")\nnetwork = [dict(r) for r in cur.fetchall()]\nprint(\"\\n=== NETWORK ===\")\nfor n in network:\n    print(f\"{n['event_id']} | {n['event_code']} | {n['timestamp']} | {n['host']} | {n['image']} | {n['user']} | {n['src_ip']} -> {n['dst_ip']}:{n['dst_port']}\")\n\nEOF\npython3 /tmp/analyze.py\n"]
