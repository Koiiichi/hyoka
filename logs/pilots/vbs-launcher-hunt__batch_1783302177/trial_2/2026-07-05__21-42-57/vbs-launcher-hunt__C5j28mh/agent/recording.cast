[153.217198, "i", "cat << 'EOF' > /tmp/process_event_counts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Get all events on WS-05 and group by image\ncur.execute(\"\"\"\n    SELECT COALESCE(image, 'None') as img, COUNT(*) as cnt \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND timestamp >= '2026-05-06T00:00:14.000Z'\n    GROUP BY img\n    ORDER BY cnt DESC\n\"\"\")\n\nfor r in cur.fetchall():\n    print(f\"{r['img']} | {r['cnt']}\")\n\nEOF\npython3 /tmp/process_event_counts.py\n"]
