[256.653956, "i", "cat << 'EOF' > /tmp/breakdown_correlated.py\nimport collections\n\ncodes = collections.Counter()\nwith open('/tmp/correlated_list.txt') as f:\n    for line in f:\n        parts = line.strip().split(' | ')\n        if len(parts) >= 2:\n            codes[parts[1]] += 1\n\nfor code, cnt in sorted(codes.items(), key=lambda x: int(x[0])):\n    print(f\"Event Code {code}: {cnt} events\")\n\nEOF\npython3 /tmp/breakdown_correlated.py\n"]
