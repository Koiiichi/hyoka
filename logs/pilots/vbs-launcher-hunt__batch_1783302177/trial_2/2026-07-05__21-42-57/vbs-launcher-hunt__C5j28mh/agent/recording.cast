[181.884582, "o", "\u001b[?2004hroot@5a136eabef84:~# "]
[188.255733, "i", "cat << 'EOF' > /tmp/analyze_uncorrelated.py\nimport collections\n\ncodes = collections.Counter()\nimages = collections.Counter()\n\nwith open('/tmp/uncorrelated_list.txt') as f:\n    for line in f:\n        parts = line.strip().split(' | ')\n        if len(parts) >= 4:\n            eid, code, ts, img = parts[0], parts[1], parts[2], parts[3]\n            codes[code] += 1\n            images[img] += 1\n\nprint(\"=== Uncorrelated Event Codes ===\")\nfor code, cnt in codes.most_common():\n    print(f\"Code {code}: {cnt}\")\n\nprint(\"\\n=== Uncorrelated Images ===\")\nfor img, cnt in images.most_common(20):\n    print(f\"{img}: {cnt}\")\n\nEOF\npython3 /tmp/analyze_uncorrelated.py\n"]
[188.256065, "o", "cat << 'EOF' > /tmp/analyze_uncorrelated.py\r\n\u001b[?2004l\r"]
