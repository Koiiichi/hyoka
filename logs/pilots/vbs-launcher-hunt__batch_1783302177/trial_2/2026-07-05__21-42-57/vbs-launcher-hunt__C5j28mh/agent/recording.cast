[147.982457, "i", "cat << 'EOF' > /tmp/get_ws05_timeline.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, target_object, details, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND timestamp >= '2026-05-06T00:00:14.000Z'\n    ORDER BY timestamp\n\"\"\")\n\nwith open('/tmp/ws05_timeline.txt', 'w') as f:\n    for r in cur.fetchall():\n        f.write(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | img: {r['image']} | user: {r['user']} | parent: {r['parent_image']} | cmd: {r['command_line']} | obj: {r['target_object']} | det: {r['details']}\\n\")\n\nEOF\npython3 /tmp/get_ws05_timeline.py\nwc -l /tmp/ws05_timeline.txt\n"]
