[307.783413, "o", "    details = ev['details'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = ev['command_line'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.783669, "o", "    is_mal = False\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # 1. Guid matches\r\n\u001b[?2004l\r\u001b[?2004h>     if proc_guid in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.783828, "o", "        is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>     elif parent_guid in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.783961, "o", "        is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # 2. Image name is known malicious\r\n\u001b[?2004l\r\u001b[?2004h"]
[307.784082, "o", "> "]
[307.784227, "o", "    elif any(x in image.lower() for x in ['powershell.exe', 'wscript.exe', 'whoami.exe']) and ts >= '2026-05-06T00:00:15.000Z':\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.784263, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.784462, "o", "    # 3. Message contains any malicious GUID\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         for g in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.784548, "o", "            if g in msg or g in details:\r\n\u001b[?2004l\r\u001b[?2004h>                 is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.784665, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h>         if not is_mal:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.784702, "o", "            # 4. Message contains decimal PID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.784792, "o", "            for pid in mal_pids_dec:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.784895, "o", "                if re.search(r'\\b' + pid + r'\\b', msg) or re.search(r'\\b' + pid + r'\\b', details):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.785001, "o", "                    is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.785084, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[307.785187, "o", "\u001b[?2004h>             if not is_mal:\r\n\u001b[?2004l\r"]
[307.785203, "o", "\u001b[?2004h> "]
[307.78535, "o", "                # 5. Message contains hex PID\r\n\u001b[?2004l\r\u001b[?2004h>                 for pid in mal_pids_hex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.785487, "o", "                    if re.search(r'\\b' + pid + r'\\b', msg, re.IGNORECASE) or re.search(r'\\b' + pid + r'\\b', details, re.IGNORECASE):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.785578, "o", "                        is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.785669, "o", "                        break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.785802, "o", "    # 6. PowerShell Event logs on WS-05\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.785876, "o", "    if code in (400, 600, 800, 4103, 4104, 40961, 40962, 53504):\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.785959, "o", "    # 7. Explicit file launch/explorer activities associated with launching launcher.vbs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.786034, "o", "    if code == 11 and 'launcher.lnk' in msg:\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = True\r\n\u001b[?2004l\r"]
[307.786058, "o", "\u001b[?2004h> "]
[307.786186, "o", "    if code == 11 and 'AutomaticDestinations' in msg and 'launcher' in msg:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.786342, "o", "        is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.786439, "o", "    if code == 11 and 'desktop.ini' in msg and ts >= '2026-05-06T00:00:15.000Z' and ts <= '2026-05-06T00:00:16.000Z':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.786541, "o", "        is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.786671, "o", "    if code == 11 and 'MSHist' in msg and ts >= '2026-05-06T00:00:15.000Z' and ts <= '2026-05-06T00:00:16.000Z':\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.786815, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.78684, "o", "    # 8. Token manipulation/Permissions on Token during WmiPrvSE.exe launch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.786934, "o", "    if code == 4670 and 'Token' in msg and '0xb74' in msg:\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = True\r\n\u001b[?2004l\r"]
[307.787004, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[307.787049, "o", "\u001b[?2004h>     if is_mal:\r\n\u001b[?2004l\r\u001b[?2004h>         findings.add(eid) \r\n\u001b[?2004l\r"]
[307.787058, "o", "\u001b[?2004h"]
[307.787133, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.787161, "o", "# Deduplicate, sort and output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.787265, "o", "sorted_findings = sorted(list(findings))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.787343, "o", "print(f\"Total unique malicious events flagged: {len(sorted_findings)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.787437, "o", "# Let's write the JSON list to /root/findings.json\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[307.787507, "o", ">     json.dump(sorted_findings, f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[307.787526, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.787651, "o", "print(\"findings.json written successfully.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[307.78777, "o", "> EOF\r\n\u001b[?2004l\r"]
[307.788715, "o", "\u001b[?2004hroot@5a136eabef84:~# python3 /tmp/generate_findings.py\r\n\u001b[?2004l\r"]
