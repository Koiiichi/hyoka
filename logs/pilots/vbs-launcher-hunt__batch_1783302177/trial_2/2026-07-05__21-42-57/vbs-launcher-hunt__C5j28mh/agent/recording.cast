[49.796136, "i", "cat << 'EOF' > /tmp/inspect_details.py\nimport re\n\nprint(\"=== File Analysis ===\")\nwith open('/tmp/files.txt', 'r') as f:\n    lines = f.read().split('evt-')\n    for l in lines:\n        if not l.strip():\n            continue\n        eid = 'evt-' + l.split(' | ')[0]\n        # Find TargetFilename inside details / message\n        tf_m = re.search(r'TargetFilename: (.*)', l)\n        tf = tf_m.group(1).strip() if tf_m else \"Unknown\"\n        image_m = re.search(r'Image: (.*)', l)\n        img = image_m.group(1).strip() if image_m else \"Unknown\"\n        print(f\"{eid} | {img} created {tf}\")\n\nprint(\"\\n=== Registry Analysis (Summary) ===\")\nreg_events = []\nwith open('/tmp/registry.txt', 'r') as f:\n    # Since registry events can be noisy, let's look at non-standard images/keys\n    lines = f.read().split('evt-')\n    for l in lines:\n        if not l.strip():\n            continue\n        parts = l.split(' | ')\n        eid = 'evt-' + parts[0]\n        img = parts[5] if len(parts) > 5 else \"\"\n        obj = parts[6] if len(parts) > 6 else \"\"\n        # print first few\n        reg_events.append((eid, img, obj))\n\nprint(f\"Total Registry events: {len(reg_events)}\")\nprint(\"Registry modifications by powershell.exe:\")\nfor reid, rimg, robj in reg_events:\n    if 'powershell' in rimg.lower() or 'wscript' in rimg.lower():\n        print(f\"{reid} | {rimg} | {robj}\")\n\nEOF\npython3 /tmp/inspect_details.py\n"]
