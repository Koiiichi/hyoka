[220.616759, "i", "cat << 'EOF' > /tmp/inspect_process_access_directions.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\neids_to_check = ['evt-00074', 'evt-00075', 'evt-00117', 'evt-00131', 'evt-00134', 'evt-00135', 'evt-00143', 'evt-00144', 'evt-00228', 'evt-00232', 'evt-00233', 'evt-00263', 'evt-00303', 'evt-00372', 'evt-00374', 'evt-00381', 'evt-00383', 'evt-00385', 'evt-00850', 'evt-00851', 'evt-01118', 'evt-01121', 'evt-01124', 'evt-01126', 'evt-01497', 'evt-01498', 'evt-01537', 'evt-01538', 'evt-01543', 'evt-01549', 'evt-01550', 'evt-01824', 'evt-01913', 'evt-01915', 'evt-01917']\n\ncur = conn.cursor()\neid_str = \",\".join(f\"'{e}'\" for e in eids_to_check)\ncur.execute(f\"SELECT event_id, message FROM events WHERE event_id IN ({eid_str})\")\n\nfor r in cur.fetchall():\n    msg = r['message']\n    src_m = re.search(r'SourceImage:\\s*(.*)', msg)\n    tgt_m = re.search(r'TargetImage:\\s*(.*)', msg)\n    acc_m = re.search(r'GrantedAccess:\\s*(.*)', msg)\n    src = src_m.group(1).strip() if src_m else \"\"\n    tgt = tgt_m.group(1).strip() if tgt_m else \"\"\n    acc = acc_m.group(1).strip() if acc_m else \"\"\n    print(f\"{r['event_id']} | Source: {src} -> Target: {tgt} | Access: {acc}\")\n\nEOF\npython3 /tmp/inspect_process_access_directions.py\n"]
