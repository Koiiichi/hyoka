[233.779098, "i", "cat << 'EOF' > /tmp/inspect_other_process_access.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncorrelated_eids = ['evt-00074', 'evt-00075', 'evt-00117', 'evt-00131', 'evt-00134', 'evt-00135', 'evt-00143', 'evt-00144', 'evt-00228', 'evt-00232', 'evt-00233', 'evt-00263', 'evt-00303', 'evt-00372', 'evt-00374', 'evt-00381', 'evt-00383', 'evt-00385', 'evt-00850', 'evt-00851', 'evt-01118', 'evt-01121', 'evt-01124', 'evt-01126', 'evt-01497', 'evt-01498', 'evt-01537', 'evt-01538', 'evt-01543', 'evt-01549', 'evt-01550', 'evt-01824', 'evt-01913', 'evt-01915', 'evt-01917']\n\neid_str = \",\".join(f\"'{e}'\" for e in correlated_eids)\ncur.execute(f\"SELECT event_id, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 10 AND event_id NOT IN ({eid_str})\")\n\npairs = {}\nfor r in cur.fetchall():\n    msg = r['message']\n    src_m = re.search(r'SourceImage:\\s*(.*)', msg)\n    tgt_m = re.search(r'TargetImage:\\s*(.*)', msg)\n    src = src_m.group(1).strip() if src_m else \"\"\n    tgt = tgt_m.group(1).strip() if tgt_m else \"\"\n    pair = (src, tgt)\n    pairs[pair] = pairs.get(pair, 0) + 1\n\nfor (src, tgt), cnt in sorted(pairs.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{src} -> {tgt} | {cnt} times\")\n\nEOF\npython3 /tmp/inspect_other_process_access.py\n"]
