[278.632884, "i", "cat << 'EOF' > /tmp/print_ws05_files.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 11 ORDER BY timestamp\")\nfor r in cur.fetchall():\n    msg = r['message']\n    img_m = re.search(r'Image:\\s*(.*)', msg)\n    tf_m = re.search(r'TargetFilename:\\s*(.*)', msg)\n    img = img_m.group(1).strip() if img_m else \"\"\n    tf = tf_m.group(1).strip() if tf_m else \"\"\n    print(f\"{r['event_id']} | {r['timestamp']} | img: {img} | file: {tf}\")\n\nEOF\npython3 /tmp/print_ws05_files.py\n"]
