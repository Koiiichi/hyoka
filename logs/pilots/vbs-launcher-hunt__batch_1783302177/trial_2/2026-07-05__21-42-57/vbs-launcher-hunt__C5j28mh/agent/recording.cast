[200.920385, "i", "cat << 'EOF' > /tmp/inspect_uncorrelated_suspects.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nuncorrelated_eids = []\nwith open('/tmp/uncorrelated_list.txt') as f:\n    for line in f:\n        uncorrelated_eids.append(line.split(' | ')[0])\n\neid_str = \",\".join(f\"'{e}'\" for e in uncorrelated_eids)\n\n# Focus on 3 and 22 first\ncur.execute(f\"\"\"\n    SELECT event_id, event_code, timestamp, image, target_object, details, message \n    FROM events \n    WHERE event_id IN ({eid_str}) AND event_code IN (3, 22)\n\"\"\")\n\nprint(\"=== CODE 3 and 22 ===\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Img: {r['image']} | Obj: {r['target_object']} | Msg: {r['message']}\")\n\n# Focus on 11\ncur.execute(f\"\"\"\n    SELECT event_id, event_code, timestamp, image, target_object, details, message \n    FROM events \n    WHERE event_id IN ({eid_str}) AND event_code = 11\n\"\"\")\n\nprint(\"=== CODE 11 ===\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Img: {r['image']} | Msg: {r['message'].replace('\\n', '  ')[:300]}\")\n\nEOF\npython3 /tmp/inspect_uncorrelated_suspects.py\n"]
