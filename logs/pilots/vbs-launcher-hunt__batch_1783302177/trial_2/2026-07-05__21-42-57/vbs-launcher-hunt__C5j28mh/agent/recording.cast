[67.76877, "i", "cat << 'EOF' > /tmp/parse_blocks.py\nimport sys\n\ndef parse_file(filename):\n    with open(filename) as f:\n        content = f.read()\n    \n    # Split by 'evt-'\n    blocks = content.split('\\nevt-')\n    results = []\n    for i, b in enumerate(blocks):\n        if i == 0:\n            # First block might contain the header, skip or handle\n            if b.startswith('=== '):\n                continue\n            b = 'evt-' + b\n        else:\n            b = 'evt-' + b\n        \n        lines = b.strip().split('\\n')\n        header_line = lines[0]\n        parts = header_line.split(' | ')\n        eid = parts[0]\n        \n        # Rest of lines\n        details = \"\\n\".join(lines[1:])\n        results.append((eid, header_line, details))\n    return results\n\nfiles_parsed = parse_file('/tmp/files.txt')\nprint(\"=== PARSED FILES ===\")\nfor eid, header, details in files_parsed:\n    if 'prefetch' in details.lower() or 'wscript' in details.lower() or 'powershell' in details.lower() or 'whoami' in details.lower() or 'launcher' in details.lower():\n        print(f\"{header}\")\n        for l in details.split('\\n'):\n            if 'TargetFilename' in l or 'Image' in l:\n                print(f\"  {l}\")\n\nEOF\npython3 /tmp/parse_blocks.py\n"]
