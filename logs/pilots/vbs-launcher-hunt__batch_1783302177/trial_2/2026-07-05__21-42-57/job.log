Sending keys: ['cat << \'EOF\' > /tmp/get_malicious_pids.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let\'s get the known malicious processes from process creation events\ncur.execute("""\n    SELECT event_id, event_code, timestamp, image, command_line, process_guid, message \n    FROM events \n    WHERE host = \'WS-05.corp.example\' AND event_code IN (1, 4688)\n""")\n\npids = set()\nguids = set()\n\nprint("=== Known Malicious Process Events ===")\nfor r in cur.fetchall():\n    msg = r[\'message\']\n    img = r[\'image\'] or ""\n    cmd = r[\'command_line\'] or ""\n    \n    # Process ID / GUID parsing\n    pid = ""\n    guid = r[\'process_guid\'] or ""\n    \n    # In event 4688, Process ID is in message as New Process ID\n    pid_m = re.search(r\'New Process ID:\\s*(0x[0-9a-fA-F]+|\\d+)\', msg)\n    if pid_m:\n        pid = pid_m.group(1)\n    else:\n        # Sysmon 1\n        pid_m = re.search(r\'ProcessId:\\s*(\\d+)\', msg)\n        if pid_m:\n            pid = pid_m.group(1)\n            \n    guid_m = re.search(r\'ProcessGuid:\\s*({[^}]+})\', msg)\n    if guid_m:\n        guid = guid_m.group(1)\n        \n    print(f"{r[\'event_id\']} | Code: {r[\'event_code\']} | Img: {img or \'None\'} | Cmd: {cmd[:100]}... | PID: {pid} | GUID: {guid}")\n    \n    if pid:\n        pids.add(pid)\n    if guid:\n        guids.add(guid)\n\nprint("Malicious PIDs:", pids)\nprint("Malicious GUIDs:", guids)\n\nEOF\npython3 /tmp/get_malicious_pids.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
