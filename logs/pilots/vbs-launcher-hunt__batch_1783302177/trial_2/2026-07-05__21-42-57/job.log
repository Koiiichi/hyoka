Sending keys: ['cat << \'EOF\' > /tmp/find_correlated_events.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Malicious identifiers\nmal_pids_dec = {\'2440\', \'2316\', \'7700\', \'4864\', \'9152\'}\nmal_pids_hex = {\'0x988\', \'0x90c\', \'0x1e14\', \'0x1300\', \'0x23c0\'}\nmal_guids = {\n    \'{860ba2e3-9f13-5f52-2603-000000000400}\', # wscript\n    \'{860ba2e3-9f13-5f52-2703-000000000400}\', # powershell\n    \'{860ba2e3-9f13-5f52-2803-000000000400}\', # conhost\n    \'{860ba2e3-9f19-5f52-2903-000000000400}\', # wmiprvse\n    \'{860ba2e3-9f2e-5f52-2a03-000000000400}\'  # whoami\n}\n\n# We will do a full scan of WS-05 events\ncur.execute("SELECT * FROM events WHERE host = \'WS-05.corp.example\' ORDER BY timestamp")\nevents = [dict(r) for r in cur.fetchall()]\n\ncorrelated = []\nuncorrelated = []\n\nfor ev in events:\n    eid = ev[\'event_id\']\n    code = ev[\'event_code\']\n    ts = ev[\'timestamp\']\n    image = ev[\'image\'] or ""\n    parent_image = ev[\'parent_image\'] or ""\n    parent_guid = ev[\'parent_process_guid\'] or ""\n    proc_guid = ev[\'process_guid\'] or ""\n    msg = ev[\'message\'] or ""\n    details = ev[\'details\'] or ""\n    cmd = ev[\'command_line\'] or ""\n    \n    is_mal = False\n    reason = ""\n    \n    # 1. Guid matches\n    if proc_guid in mal_guids:\n        is_mal = True\n        reason = f"Process GUID {proc_guid} is malicious"\n    elif parent_guid in mal_guids:\n        is_mal = True\n        reason = f"Parent GUID {parent_guid} is malicious"\n        \n    # 2. Image name is known malicious\n    elif any(x in image.lower() for x in [\'powershell.exe\', \'wscript.exe\', \'whoami.exe\']) and ts >= \'2026-05-06T00:00:15.000Z\':\n        is_mal = True\n        reason = f"Malicious image {image}"\n        \n    # 3. Message contains any malicious GUID\n    else:\n        for g in mal_guids:\n            if g in msg or g in details:\n                is_mal = True\n                reason = f"Message/details contains malicious GUID {g}"\n                break\n                \n        if not is_mal:\n            # 4. Message contains decimal PID\n            # We need to be careful with false positives (e.g., standard numbers like 80, 443)\n            # Let\'s search for patterns: Process ID: PID, ProcessId: PID, ProcessId\n            for pid in mal_pids_dec:\n                # exact word match\n                if re.search(r\'\\b\' + pid + r\'\\b\', msg) or re.search(r\'\\b\' + pid + r\'\\b\', details):\n                    is_mal = True\n                    reason = f"Message/details contains dec PID {pid}"\n                    break\n            \n            if not is_mal:\n                # 5. Message contains hex PID\n                for pid in mal_pids_hex:\n                    if re.search(r\'\\b\' + pid + r\'\\b\', msg, re.IGNORECASE) or re.search(r\'\\b\' + pid + r\'\\b\', details, re.IGNORECASE):\n                        is_mal = True\n                        reason = f"Message/details contains hex PID {pid}"\n                        break\n                        \n    if is_mal:\n        correlated.append((eid, code, ts, image or parent_image or cmd[:30], reason))\n    else:\n        uncorrelated.append((eid, code, ts, image or parent_image or cmd[:30]))\n\nprint(f"Correlated: {len(correlated)} events")\nprint(f"Uncorrelated: {len(uncorrelated)} events")\n\nwith open(\'/tmp/correlated_list.txt\', \'w\') as f:\n    for c in correlated:\n        f.write(f"{c[0]} | {c[1]} | {c[2]} | {c[3]} | {c[4]}\\n")\n\nwith open(\'/tmp/uncorrelated_list.txt\', \'w\') as f:\n    for u in uncorrelated:\n        f.write(f"{u[0]} | {u[1]} | {u[2]} | {u[3]}\\n")\n\nEOF\npython3 /tmp/find_correlated_events.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
