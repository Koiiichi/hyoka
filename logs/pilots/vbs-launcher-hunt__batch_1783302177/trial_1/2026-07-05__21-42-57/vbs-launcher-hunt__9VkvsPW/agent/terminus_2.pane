[?2004hroot@0b273cc260a8:~# cat << 'EOF' > /tmp/malicious_trace.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find all processes spawned by, spawning, or interacting with the malicious processes.
[?2004l[?2004h> # Our starting malicious GUIDs:
[?2004l[?2004h> mal_guids = {'{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'}
[?2004l[?2004h> 
[?2004l[?2004h> # Let's also check for any process whose image is wscript.exe, powershell.exe (if it has launcher/enc), conhost (if child of powershell), whoami
[?2004l[?2004h> # Let's retrieve all event IDs where the process itself is malicious or directly related.
[?2004l[?2004h> cursor.execute("SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp")
[?2004l[?2004h> rows = [dict(r) for r in cursor.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> flagged_events = set()
[?2004l[?2004h> 
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     guid = r['process_guid']
[?2004l[?2004h>     pguid = r['parent_process_guid']
[?2004l[?2004h>     image = r['image'] or ''
[?2004l[?2004h>     pimage = r['parent_image'] or ''
[?2004l[?2004h>     cmd = r['command_line'] or ''
[?2004l[?2004h>     code = r['event_code']
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if this event belongs to the malicious process GUID list
[?2004l[?2004h>     is_mal = False
[?2004l[?2004h>     if guid in mal_guids or pguid in mal_guids:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>     
[?2004l[?2004h>     # Check for whoami
[?2004l[?2004h>     if 'whoami.exe' in image or 'whoami.exe' in cmd:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     # Check for launcher.vbs
