[?2004l[?2004h>     img = r['image'] or ''
[?2004l[?2004h>     # Ignore standard benign Windows Defender, svchost, spoolsv, searchindexer, lsass etc. if they are not doing anything weird
[?2004l[?2004h>     if 'MsMpEng.exe' in img or 'SearchIndexer.exe' in img or 'CompatTelRunner.exe' in img:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # Also ignore WmiPrvSE if it's the standard embedding svchost one (evt-01496 / evt-01628 / etc)
[?2004l[?2004h>     if r['event_id'] in ('evt-01496', 'evt-01628'):
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     print(f"ID: {r['event_id']} | Code: {code} | Time: {r['timestamp']}")
