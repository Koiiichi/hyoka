[?2004l[?2004h> 
[?2004l[?2004h> # Let's get all of these events and dump them in a structured way
[?2004l[?2004h> cursor.execute(f"SELECT * FROM events WHERE event_id IN ({','.join(['?']*len(event_ids))}) ORDER BY timestamp", event_ids)
[?2004l[?2004h> rows = [dict(row) for row in cursor.fetchall()]
[?2004l[?2004h> 
