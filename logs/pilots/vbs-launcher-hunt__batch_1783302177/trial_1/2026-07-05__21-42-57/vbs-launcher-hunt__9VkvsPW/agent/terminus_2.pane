[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> query = """SELECT event_id, event_code, timestamp, image, parent_image, command_line, target_image, target_object, details, src_ip, dst_ip, dst_port, process_guid, parent_process_guid 
[?2004l[?2004h> FROM events 
[?2004l[?2004h> WHERE host = 'WS-05.corp.example' AND event_id IN (
[?2004l[?2004h>     SELECT event_id FROM events WHERE (process_guid IN ('{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}') 
[?2004l[?2004h>     OR parent_process_guid IN ('{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'))
[?2004l[?2004h> ) AND image NOT LIKE '%explorer.exe%' AND image NOT LIKE '%MsMpEng.exe%' AND event_code != 7
[?2004l[?2004h> ORDER BY timestamp;"""
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute(query)
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(f"{r['event_id']} | {r['event_code']} | {r['image']} | {r['target_image'] or ''} | {r['target_object'] or ''} | {r['command_line'] or ''}")
[?2004l[?2004h> 
