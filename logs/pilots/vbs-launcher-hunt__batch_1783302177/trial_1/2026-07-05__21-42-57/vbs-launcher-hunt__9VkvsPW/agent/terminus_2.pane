[?2004l[?2004h>     if r['command_line']:
[?2004l[?2004h>         print(f"  Cmd: {r['command_line'][:120]}")
[?2004l[?2004h>     if r['target_image']:
[?2004l[?2004h>         print(f"  TargetImg: {r['target_image']}")
[?2004l[?2004h>     if r['target_object']:
[?2004l[?2004h>         print(f"  TargetObj: {r['target_object']} | Details: {r['details'] or ''}")
