[141.421022, "i", "cat << 'EOF' > /tmp/timeline.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nquery = \"\"\"SELECT event_id, event_code, timestamp, image, parent_image, command_line, target_image, target_object, details, src_ip, dst_ip, dst_port, process_guid, parent_process_guid \nFROM events \nWHERE host = 'WS-05.corp.example' AND timestamp BETWEEN '2026-05-06T00:00:14Z' AND '2026-05-06T00:00:55Z' \nORDER BY timestamp\"\"\"\n\ncursor.execute(query)\nfor r in cursor.fetchall():\n    code = r['event_code']\n    img = r['image'] or ''\n    # Ignore standard benign Windows Defender, svchost, spoolsv, searchindexer, lsass etc. if they are not doing anything weird\n    if 'MsMpEng.exe' in img or 'SearchIndexer.exe' in img or 'CompatTelRunner.exe' in img:\n        continue\n    \n    # Also ignore WmiPrvSE if it's the standard embedding svchost one (evt-01496 / evt-01628 / etc)\n    if r['event_id'] in ('evt-01496', 'evt-01628'):\n        continue\n        \n    print(f\"ID: {r['event_id']} | Code: {code} | Time: {r['timestamp']}\")\n    print(f\"  Img: {img} | Parent: {r['parent_image'] or ''}\")\n    if r['command_line']:\n        print(f\"  Cmd: {r['command_line'][:120]}\")\n    if r['target_image']:\n        print(f\"  TargetImg: {r['target_image']}\")\n    if r['target_object']:\n        print(f\"  TargetObj: {r['target_object']} | Details: {r['details'] or ''}\")\n    if r['dst_ip']:\n        print(f\"  Dst: {r['dst_ip']}:{r['dst_port']}\")\n    print(f\"  ProcGUID: {r['process_guid']} | ParentGUID: {r['parent_process_guid']}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/timeline.py > /tmp/ws05_timeline.txt\ncat /tmp/ws05_timeline.txt\n"]
[141.422568, "o", "cat << 'EOF' > /tmp/timeline.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> query = \"\"\"SELECT event_id, event_code, timestamp, image, parent_image, command_line, target_image, target_object, details, src_ip, dst_ip, dst_port, process_guid, parent_process_guid \r\n\u001b[?2004l\r\u001b[?2004h> FROM events \r\n\u001b[?2004l\r\u001b[?2004h> "]
