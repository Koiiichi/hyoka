[171.293952, "i", "cat << 'EOF' > /tmp/mal_events_detailed.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nquery = \"\"\"SELECT event_id, event_code, timestamp, image, parent_image, command_line, target_image, target_object, details, src_ip, dst_ip, dst_port, process_guid, parent_process_guid \nFROM events \nWHERE host = 'WS-05.corp.example' AND event_id IN (\n    SELECT event_id FROM events WHERE (process_guid IN ('{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}') \n    OR parent_process_guid IN ('{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'))\n) AND image NOT LIKE '%explorer.exe%' AND image NOT LIKE '%MsMpEng.exe%' AND event_code != 7\nORDER BY timestamp;\"\"\"\n\ncursor.execute(query)\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['event_code']} | {r['image']} | {r['target_image'] or ''} | {r['target_object'] or ''} | {r['command_line'] or ''}\")\n\nEOF\npython3 /tmp/mal_events_detailed.py\n"]
[171.294169, "o", "cat << 'EOF' > /tmp/mal_events_detailed.py\r\n\u001b[?2004l\r"]
[171.294914, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> query = \"\"\"SELECT event_id, event_code, timestamp, image, parent_image, command_line, target_image, target_object, details, src_ip, dst_ip, dst_port, process_guid, parent_process_guid \r\n\u001b[?2004l\r\u001b[?2004h> FROM events \r\n\u001b[?2004l\r\u001b[?2004h> WHERE host = 'WS-05.corp.example' AND event_id IN (\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id FROM events WHERE (process_guid IN ('{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}') \r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.295077, "o", "    OR parent_process_guid IN ('{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'))"]
