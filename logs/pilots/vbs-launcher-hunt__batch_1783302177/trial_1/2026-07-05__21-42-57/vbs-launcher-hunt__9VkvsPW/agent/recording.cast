[119.019128, "i", "cat << 'EOF' > /tmp/check_ws05.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Query for specific event codes we want to detail\ncodes = (3, 5, 22, 23, 17, 18, 4689, 4104)\ncursor.execute(f\"SELECT event_id, event_code, timestamp, image, parent_image, command_line, dst_ip, dst_port, details, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN {codes} ORDER BY timestamp\")\nfor row in cursor.fetchall():\n    r = dict(row)\n    print(f\"ID: {r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']}\")\n    print(f\"  Img: {r['image']} | ParentImg: {r['parent_image']}\")\n    if r['command_line']:\n        print(f\"  Cmd: {r['command_line'][:120]}\")\n    if r['dst_ip']:\n        print(f\"  Dst: {r['dst_ip']}:{r['dst_port']}\")\n    if r['details']:\n        print(f\"  Details: {r['details'][:100]}\")\n    # Let's see if there is any other specific field or we can show some of the message\n    # If it's 4104 we print the script block\n    if r['event_code'] == 4104:\n        print(f\"  Msg: {r['message'][:500]}\")\n    print(\"-\"*80)\n\nEOF\npython3 /tmp/check_ws05.py\n"]
[119.019401, "o", "cat << 'EOF' > /tmp/check_ws05.py\r\n\u001b[?2004l\r"]
