[150.526818, "i", "cat << 'EOF' > /tmp/malicious_trace.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's find all processes spawned by, spawning, or interacting with the malicious processes.\n# Our starting malicious GUIDs:\nmal_guids = {'{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'}\n\n# Let's also check for any process whose image is wscript.exe, powershell.exe (if it has launcher/enc), conhost (if child of powershell), whoami\n# Let's retrieve all event IDs where the process itself is malicious or directly related.\ncursor.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\nrows = [dict(r) for r in cursor.fetchall()]\n\nflagged_events = set()\n\nfor r in rows:\n    guid = r['process_guid']\n    pguid = r['parent_process_guid']\n    image = r['image'] or ''\n    pimage = r['parent_image'] or ''\n    cmd = r['command_line'] or ''\n    code = r['event_code']\n    \n    # Check if this event belongs to the malicious process GUID list\n    is_mal = False\n    if guid in mal_guids or pguid in mal_guids:\n        is_mal = True\n    \n    # Check for whoami\n    if 'whoami.exe' in image or 'whoami.exe' in cmd:\n        is_mal = True\n        \n    # Check for launcher.vbs\n    if 'launcher.vbs' in cmd:\n        is_mal = True\n        \n    # Check for powershell stager\n    if 'powershell.exe' in image and '-enc' in cmd:\n        is_mal = True\n        \n    # WScript process injection or access to powershell.exe\n    if r['target_image'] and 'powershell.exe' in r['target_image'].lower() and guid in mal_guids:\n        is_mal = True\n    if r['target_image'] and 'whoami.exe' in r['target_image'].lower() and guid in mal_guids:\n        is_mal = True\n        \n    if is_mal:\n        # Let's add any parent/child GUIDs to our set\n        if guid and guid != 'None': mal_guids.add(guid)\n        if pguid and pguid != 'None': mal_guids.add(pguid)\n        flagged_events.add(r['event_id'])\n\n# Now, let's print all flagged events and check what they are\nprint(f\"Total flagged events: {len(flagged_events)}\")\nfor r in rows:\n    if r['event_id'] in flagged_events:\n        # Filter out Event 7 (Image Load) and Event 12/13 (Registry) unless they are highly specific to be clean\n        # Let's see them all first anyway\n        print(f\"ID: {r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | Img: {r['image']} | Parent: {r['parent_image']} | TargetObj: {r['target_object'] or ''} | Net: {r['dst_ip'] or ''}\")\n\nEOF\npython3 /tmp/malicious_trace.py > /tmp/trace_output.txt\ncat /tmp/trace_output.txt | head -n 40\n"]
