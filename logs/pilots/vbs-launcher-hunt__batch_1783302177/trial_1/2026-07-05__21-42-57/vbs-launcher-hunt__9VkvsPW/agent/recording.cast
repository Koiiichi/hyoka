[84.990071, "i", "cat << 'EOF' > /tmp/check_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nquery = \"\"\"SELECT event_id, event_code, timestamp, image, target_object, details, target_image, message \nFROM events \nWHERE event_id IN ('evt-01022', 'evt-01023', 'evt-01095', 'evt-01097', 'evt-01098', 'evt-01107', 'evt-01651', 'evt-01723', 'evt-01816', 'evt-01818')\"\"\"\n\ncursor.execute(query)\nfor row in cursor.fetchall():\n    print(dict(row))\n    print(\"-\"*40)\nEOF\npython3 /tmp/check_details.py\n"]
