[150.550851, "o", "\u001b[?2004hroot@0b273cc260a8:~# "]
[157.517423, "i", "cat << 'EOF' > /tmp/summarize_flagged.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# We load the trace_output.txt and count event codes\nfrom collections import Counter\ncodes = Counter()\nevents_by_code = {}\n\nwith open('/tmp/trace_output.txt') as f:\n    for line in f:\n        if line.startswith('ID:'):\n            parts = line.strip().split('|')\n            ev_id = parts[0].split(':')[1].strip()\n            code = int(parts[1].split(':')[1].strip())\n            codes[code] += 1\n            events_by_code.setdefault(code, []).append(line.strip())\n\nfor c, count in codes.most_common():\n    print(f\"Code {c}: {count} events\")\n    print(\"Sample:\")\n    for sample in events_by_code[c][:5]:\n        print(f\"  {sample}\")\n    print(\"-\"*40)\nEOF\npython3 /tmp/summarize_flagged.py\n"]
