[3.48019, "o", "\r\n\u001b[?2004l\r"]
[3.489167, "o", "CREATE TABLE events (event_id TEXT, timestamp TEXT, event_code INTEGER, channel TEXT, provider TEXT, host TEXT, user TEXT, target_user TEXT, image TEXT, parent_image TEXT, parent_process_guid TEXT, command_line TEXT, logon_type TEXT, service_name TEXT, service_file_name TEXT, target_image TEXT, target_object TEXT, details TEXT, granted_access TEXT, src_ip TEXT, dst_ip TEXT, dst_port TEXT, process_guid TEXT, message TEXT);\r\n"]
