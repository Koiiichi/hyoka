[56.838476, "i", "cat << 'EOF' > /tmp/parse_events.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nevent_ids = ['evt-00073', 'evt-00234', 'evt-00235', 'evt-00236', 'evt-00237', 'evt-00238', 'evt-00239', 'evt-00240', 'evt-00241', 'evt-00259', 'evt-00261', 'evt-00265', 'evt-00272', 'evt-00289', 'evt-01022', 'evt-01023', 'evt-01095', 'evt-01097', 'evt-01098', 'evt-01107', 'evt-01478', 'evt-01651', 'evt-01723', 'evt-01816', 'evt-01818', 'evt-01820', 'evt-01822', 'evt-01858']\n\n# Let's get all of these events and dump them in a structured way\ncursor.execute(f\"SELECT * FROM events WHERE event_id IN ({','.join(['?']*len(event_ids))}) ORDER BY timestamp\", event_ids)\nrows = [dict(row) for row in cursor.fetchall()]\n\nfor r in rows:\n    print(f\"ID: {r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | Host: {r['host']} | User: {r['user']}\")\n    print(f\"  Img: {r['image']} | ParentImg: {r['parent_image']}\")\n    if r['command_line']:\n        print(f\"  Cmd: {r['command_line'][:150]}\")\n    if r['target_object']:\n        print(f\"  TargetObj: {r['target_object']} | Details: {r['details']}\")\n    if r['target_image']:\n        print(f\"  TargetImg: {r['target_image']} | Access: {r['granted_access']}\")\n    if r['src_ip'] or r['dst_ip']:\n        print(f\"  Net: {r['src_ip']} -> {r['dst_ip']}:{r['dst_port']}\")\n    print(\"-\"*80)\n\nEOF\npython3 /tmp/parse_events.py > /tmp/parsed_output.txt\ncat /tmp/parsed_output.txt\n"]
[56.83872, "o", "cat << 'EOF' > /tmp/parse_events.py\r\n\u001b[?2004l\r"]
[56.83879, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.838816, "o", "conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.838839, "o", "conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r"]
[56.838874, "o", "\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.838973, "o", "\u001b[?2004h> "]
[56.839403, "o", "event_ids = ['evt-00073', 'evt-00234', 'evt-00235', 'evt-00236', 'evt-00237', 'evt-00238', 'evt-00239', 'evt-00240', 'evt-00241', 'evt-00259', 'evt-00261', 'evt-00265', 'evt-00272', 'evt-00289', 'evt-01022', 'evt-01023', 'evt-01095', 'evt-01097', 'evt-01098', 'evt-01107', 'evt-01478', 'evt-01651', 'evt-01723', 'evt-01816', 'evt-01818', 'evt-01820', 'evt-01822', 'evt-01858']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's get all of these events and dump them in a structured way\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.839494, "o", "cursor.execute(f\"SELECT * FROM events WHERE event_id IN ({','.join(['?']*len(event_ids))}) ORDER BY timestamp\", event_ids)\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.839535, "o", "> rows = [dict(row) for row in cursor.fetchall()]\r\n\u001b[?2004l\r"]
[56.839735, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"ID: {r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | Host: {r['host']} | User: {r['user']}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.839754, "o", "> "]
[56.840006, "o", "    print(f\"  Img: {r['image']} | ParentImg: {r['parent_image']}\")\r\n\u001b[?2004l\r\u001b[?2004h>     if r['command_line']:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Cmd: {r['command_line'][:150]}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.840091, "o", "    if r['target_object']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.840126, "o", "        print(f\"  TargetObj: {r['target_object']} | Details: {r['details']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.840263, "o", "    if r['target_image']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.840298, "o", "        print(f\"  TargetImg: {r['target_image']} | Access: {r['granted_access']}\")\r\n\u001b[?2004l\r"]
[56.840325, "o", "\u001b[?2004h> "]
[56.840422, "o", "    if r['src_ip'] or r['dst_ip']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.840465, "o", "        print(f\"  Net: {r['src_ip']} -> {r['dst_ip']}:{r['dst_port']}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"-\"*80)\r\n\u001b[?2004l\r"]
[56.840581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
