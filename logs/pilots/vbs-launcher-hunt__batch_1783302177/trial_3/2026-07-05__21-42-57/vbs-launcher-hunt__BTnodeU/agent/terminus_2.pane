[?2004hroot@acdd65ae1d6f:~# cat << 'EOF' > /tmp/classify.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT * FROM events")
[?2004l[?2004h> events = [dict(r) for r in cursor.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious Process GUIDs
[?2004l[?2004h> mal_guids = {
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe
[?2004l[?2004h>     '{860ba2e3-9f2e-5f52-2a03-000000000400}', # whoami.exe
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2803-000000000400}'  # conhost.exe
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious PIDs (decimal)
[?2004l[?2004h> mal_pids_dec = {2440, 2316, 9152, 7700}
[?2004l[?2004h> 
[?2004l[?2004h> flagged = set()
[?2004l[?2004h> reasons = {}
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to add flagged event
[?2004l[?2004h> def add_flag(eid, reason):
[?2004l[?2004h>     flagged.add(eid)
[?2004l[?2004h>     reasons[eid] = reason
[?2004l[?2004h> 
[?2004l[?2004h> for e in events:
[?2004l[?2004h>     eid = e['event_id']
[?2004l[?2004h>     code = e['event_code']
[?2004l[?2004h>     msg = e['message'] or ''
[?2004l[?2004h>     guid = e['process_guid']
[?2004l[?2004h>     pguid = e['parent_process_guid']
[?2004l[?2004h>     img = e['image'] or ''
[?2004l[?2004h>     
[?2004l[?2004h>     # 1) If it's a Sysmon event (contains process_guid) and the process executing is malicious:
[?2004l[?2004h>     if guid in mal_guids:
[?2004l[?2004h>         # Verify that for Event Code 10, the source process is the one executing
[?2004l[?2004h>         # Wait, for Event Code 10, guid is indeed the SourceProcessGUID (ProcessGuid)
[?2004l[?2004h>         # Let's confirm: Sysmon Code 10's process_guid is the Source (the actor)
[?2004l[?2004h>         add_flag(eid, f"sysmon_malicious_actor_guid={guid}")
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 2) If it's a PowerShell Operational log, it is generated by the malicious powershell.exe execution
[?2004l[?2004h>     if code in (800, 4103, 4104, 400, 600) and e['host'] == 'WS-05.corp.example':
[?2004l[?2004h>         add_flag(eid, f"powershell_execution_log={code}")
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 3) For Security audit events and Windows Filtering Platform events, the process executing is specified in the message
[?2004l[?2004h>     # Let's check if the process initiating the event matches our malicious PIDs.
[?2004l[?2004h>     # Let's parse out Process ID and Creator Process ID / New Process ID.
[?2004l[?2004h>     # In Security logs:
[?2004l[?2004h>     # - For 4688: New Process ID is the process being created, Creator Process ID is the creator.
[?2004l[?2004h>     #   Both are part of the telemetry if the creator is malicious OR the new process is malicious.
[?2004l[?2004h>     # - For 4689: Process ID is the process exiting. If the exiting process is malicious, flag it.
[?2004l[?2004h>     # - For 4656/4658/4663/4673: Process ID is the process performing the action.
[?2004l[?2004h>     # - For 5156/5158: Process ID is the process performing the connection.
[?2004l[?2004h>     
[?2004l[?2004h>     # Let's check for Process ID in the message
[?2004l[?2004h>     pid_matches = re.findall(r'Process ID:\s*(0x[0-9A-Fa-f]+|\d+)', msg)
[?2004l[?2004h>     new_pid_matches = re.findall(r'New Process ID:\s*(0x[0-9A-Fa-f]+|\d+)', msg)
[?2004l[?2004h>     creator_pid_matches = re.findall(r'Creator Process ID:\s*(0x[0-9A-Fa-f]+|\d+)', msg)
[?2004l[?2004h>     
[?2004l[?2004h>     pids_found = set()
[?2004l[?2004h>     for val in pid_matches + new_pid_matches + creator_pid_matches:
[?2004l[?2004h>         val = val.strip()
[?2004l[?2004h>         if val.startswith('0x'):
[?2004l[?2004h>             pids_found.add(int(val, 16))
[?2004l[?2004h>         elif val.isdigit():
[?2004l[?2004h>             pids_found.add(int(val))
[?2004l[?2004h>             
[?2004l[?2004h>     # Check if any identified PID is in our malicious PIDs
[?2004l[?2004h>     is_mal_pid = False
[?2004l[?2004h>     for pid in pids_found:
[?2004l[?2004h>         if pid in mal_pids_dec:
[?2004l[?2004h>             is_mal_pid = True
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>     if is_mal_pid:
[?2004l[?2004h>         add_flag(eid, f"security_audit_mal_pid")
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total precisely flagged: {len(flagged)}")
[?2004l[?2004h> EOF
