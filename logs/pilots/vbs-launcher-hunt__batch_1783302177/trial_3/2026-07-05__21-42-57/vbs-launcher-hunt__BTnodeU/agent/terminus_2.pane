[?2004hroot@acdd65ae1d6f:~# cat << 'EOF' > /tmp/hunt.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Get all events
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, timestamp, host, user, target_user, image, parent_image, parent_process_guid, command_line, message, process_guid FROM events")
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> colnames = [d[0] for d in cursor.description]
[?2004l[?2004h> events = []
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     events.append(dict(zip(colnames, r)))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total events: {len(events)}")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@acdd65ae1d6f:~# python3 /tmp/hunt.py
[?2004lTotal events: 2067
[?2004hroot@acdd65ae1d6f:~# cat << 'EOF' > /tmp/hunt.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT * FROM events")
[?2004l[?2004h> events = [dict(r) for r in cursor.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> # Let's track malicious process GUIDs
[?2004l[?2004h> # Start with our known malicious launcher processes on WS-05
[?2004l[?2004h> malicious_guids = set([
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe C:\Users\m.ward\Desktop\launcher.vbs
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe -enc ...
[?2004l[?2004h> ])
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find child processes of these
[?2004l[?2004h> added = True
[?2004l[?2004h> while added:
[?2004l[?2004h>     added = False
[?2004l[?2004h>     for e in events:
[?2004l[?2004h>         pguid = e['process_guid']
[?2004l[?2004h>         ppguid = e['parent_process_guid']
[?2004l[?2004h>         if ppguid in malicious_guids and pguid and pguid not in malicious_guids:
[?2004l[?2004h>             malicious_guids.add(pguid)
[?2004l[?2004h>             added = True
[?2004l[?2004h> 
[?2004l[?2004h> print("Malicious GUIDs identified:")
[?2004l[?2004h> for g in malicious_guids:
[?2004l[?2004h>     print(g)
[?2004l[?2004h> EOF
[?2004l[?2004hroot@acdd65ae1d6f:~# python3 /tmp/hunt.py
[?2004lMalicious GUIDs identified:
{860ba2e3-9f13-5f52-2703-000000000400}
{860ba2e3-9f2e-5f52-2a03-000000000400}
{860ba2e3-9f13-5f52-2603-000000000400}
{860ba2e3-9f13-5f52-2803-000000000400}
[?2004hroot@acdd65ae1d6f:~# cat << 'EOF' > /tmp/hunt.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT * FROM events")
[?2004l[?2004h> events = [dict(r) for r in cursor.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious GUIDs
[?2004l[?2004h> mal_guids = {
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe
[?2004l[?2004h>     '{860ba2e3-9f2e-5f52-2a03-000000000400}', # whoami.exe
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2803-000000000400}'  # conhost.exe
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Let's map process PIDs and hex PIDs from Sysmon events to security events
[?2004l[?2004h> # wscript.exe: PID is 2440 (0x988)? Or what?
[?2004l[?2004h> # Let's print the PIDs and Logon IDs of these processes to be precise.
[?2004l[?2004h> 
[?2004l[?2004h> for e in events:
[?2004l[?2004h>     # Sysmon event code 1
[?2004l[?2004h>     if e['event_code'] == 1 and e['process_guid'] in mal_guids:
[?2004l[?2004h>         print(f"Code 1: ID={e['event_id']} Image={e['image']} Guid={e['process_guid']}")
[?2004l[?2004h>         # extract ProcessId
[?2004l[?2004h>         pid_match = re.search(r'ProcessId:\s*(\d+)', e['message'] or '')
[?2004l[?2004h>         if pid_match:
[?2004l[?2004h>             print(f"  PID: {pid_match.group(1)}")
[?2004l[?2004h> 
[?2004l[?2004h>     # Security event code 4688
[?2004l[?2004h>     if e['event_code'] == 4688:
[?2004l[?2004h>         cmd = e['command_line'] or ''
[?2004l[?2004h>         if 'launcher.vbs' in cmd or 'powershell.exe' in cmd or 'whoami.exe' in cmd or 'conhost.exe' in cmd:
[?2004l[?2004h>             print(f"Code 4688: ID={e['event_id']} Cmd={cmd}")
[?2004l[?2004h>             logon_match = re.search(r'Logon ID:\s*(0x[0-9A-Fa-f]+)', e['message'] or '')
[?2004l[?2004h>             if logon_match:
[?2004l[?2004h>                 print(f"  Logon ID: {logon_match.group(1)}")
[?2004l[?2004h>             proc_match = re.search(r'New Process ID:\s*(0x[0-9A-Fa-f]+)', e['message'] or '')
[?2004l[?2004h>             if proc_match:
[?2004l[?2004h>                 print(f"  New Process ID: {proc_match.group(1)}")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@acdd65ae1d6f:~# python3 /tmp/hunt.py
[?2004lCode 1: ID=evt-00073 Image=C:\Windows\System32\wscript.exe Guid={860ba2e3-9f13-5f52-2603-000000000400}
  PID: 2440
Code 4688: ID=evt-00247 Cmd="C:\windows\System32\WScript.exe" "C:\Users\m.ward\Desktop\launcher.vbs" 
