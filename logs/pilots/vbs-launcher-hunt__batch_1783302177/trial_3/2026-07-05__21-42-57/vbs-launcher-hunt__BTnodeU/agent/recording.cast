[201.69137, "i", "cat << 'EOF' > /tmp/check_network.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's import the flagged set of IDs from classify\nEOF\ncat /tmp/classify.py | grep -v 'print(' >> /tmp/check_network.py\ncat << 'EOF' >> /tmp/check_network.py\n\nprint(\"--- UNFLAGGED NETWORK/WFP EVENTS ON WS-05 ---\")\nfor e in events:\n    if e['event_id'] not in flagged and e['event_code'] in (3, 22, 5156, 5158) and e['host'] == 'WS-05.corp.example':\n        print(f\"ID: {e['event_id']}, Code: {e['event_code']}, Dest IP: {e['dst_ip']}, Port: {e['dst_port']}, Msg: {e['message'][:200].strip()}\")\nEOF\npython3 /tmp/check_network.py\n"]
