[162.262737, "o", "mal_hex_pids = {'0x988', '0x90c', '0x23c0', '0x1e14'}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> malicious_ids = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Rules for flagging malicious events\r\n\u001b[?2004l\r\u001b[?2004h> for e in events:\r\n\u001b[?2004l\r\u001b[?2004h>     eid = e['event_id']"]
