2e3-9f13-5f52-2803-000000000400}\r\n"]
[220.625945, "o", "\u001b[?2004hroot@acdd65ae1d6f:~# "]
[236.151677, "i", "cat << 'EOF' > /tmp/classify.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events\")\nevents = [dict(r) for r in cursor.fetchall()]\n\n# Malicious Process GUIDs\nmal_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}', # whoami.exe\n    '{860ba2e3-9f13-5f52-2803-000000000400}'  # conhost.exe\n}\n\n# Malicious PIDs (decimal)\nmal_pids_dec = {2440, 2316, 9152, 7700}\n\nflagged = set()\nreasons = {}\n\n# Helper to add flagged event\ndef add_flag(eid, reason):\n    flagged.add(eid)\n    reasons[eid] = reason\n\nfor e in events:\n    eid = e['event_id']\n    code = e['event_code']\n    msg = e['message'] or ''\n    guid = e['process_guid']\n    pguid = e['parent_process_guid']\n    img = e['image'] or ''\n    \n    # 1) If it's a Sysmon event (contains process_guid) and the process executing is malicious:\n    if guid in mal_guids:\n        # Verify that for Event Code 10, the source process is the one executing\n        # Wait, for Event Code 10, guid is indeed the SourceProcessGUID (ProcessGuid)\n        # Let's confirm: Sysmon Code 10's process_guid is the Source (the actor)\n        add_flag(eid, f\"sysmon_malicious_actor_guid={guid}\")\n        continue\n        \n    # 2) If it's a PowerShell Operational log, it is generated by the malicious powershell.exe execution\n    if code in (800, 4103, 4104, 400, 600) and e['host'] == 'WS-05.corp.example':\n        add_flag(eid, f\"powershell_execution_log={code}\")\n        continue\n        \n    # 3) For Security audit events and Windows Filtering Platform events, the process executing is specified in the message\n    # Let's check if the process initiating the event matches our malicious PIDs.\n    # Let's parse out Process ID and Creator Process ID / New Process ID.\n    # In Security logs:\n    # - For 4688: New Process ID is the process being created, Creator Process ID is the creator.\n    #   Both are part of the telemetry if the creator is malicious OR the new process is malicious.\n    # - For 4689: Process ID is the process exiting. If the exiting process is malicious, flag it.\n    # - For 4656/4658/4663/4673: Process ID is the process performing the action.\n    # - For 5156/5158: Process ID is the process performing the connection.\n    \n    # Let's check for Process ID in the message\n    pid_matches = re.findall(r'Process ID:\\s*(0x[0-9A-Fa-f]+|\\d+)', msg)\n    new_pid_matches = re.findall(r'New Process ID:\\s*(0x[0-9A-Fa-f]+|\\d+)', msg)\n    creator_pid_matches = re.findall(r'Creator Process ID:\\s*(0x[0-9A-Fa-f]+|\\d+)', msg)\n    \n    pids_found = set()\n    for val in pid_matches + new_pid_matches + creator_pid_matches:\n        val = val.strip()\n        if val.startswith('0x'):\n            pids_found.add(int(val, 16))\n        elif val.isdigit():\n            pids_found.add(int(val))\n            \n    # Check if any identified PID is in our malicious PIDs\n    is_mal_pid = False\n    for pid in pids_found:\n        if pid in mal_pids_dec:\n            is_mal_pid = True\n            break\n            \n    if is_mal_pid:\n        add_flag(eid, f\"security_audit_mal_pid\")\n        continue\n\nprint(f\"Total precisely flagged: {len(flagged)}\")\nEOF\npython3 /tmp/classify.py\n"]
