[162.260867, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events\")\nevents = [dict(r) for r in cursor.fetchall()]\n\n# Malicious Process GUIDs\nmal_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}', # whoami.exe\n    '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost.exe (powershell)\n    '{860ba2e3-9f14-5f52-2903-000000000400}', # Wait, conhost has another GUID? Let's check\n}\n\n# Malicious PIDs (decimal)\nmal_pids = {2440, 2316, 9152, 7700}\n# Malicious hex PIDs\nmal_hex_pids = {'0x988', '0x90c', '0x23c0', '0x1e14'}\n\nmalicious_ids = set()\n\n# Rules for flagging malicious events\nfor e in events:\n    eid = e['event_id']\n    code = e['event_code']\n    msg = e['message'] or ''\n    guid = e['process_guid']\n    pguid = e['parent_process_guid']\n    \n    # 1) Direct process GUID match\n    if guid in mal_guids or pguid in mal_guids:\n        malicious_ids.add(eid)\n        continue\n        \n    # 2) Mention in Sysmon events of malicious GUIDs as Source or Target or ProcessGuid\n    for g in mal_guids:\n        if g in msg:\n            malicious_ids.add(eid)\n            break\n    if eid in malicious_ids:\n        continue\n        \n    # 3) Security events that mention our malicious Process IDs or Logon ID 0x2D5A4B\n    # But wait, is Logon ID 0x2D5A4B used by non-malicious processes? Let's verify.\n    # Let's inspect all occurrences of Logon ID 0x2D5A4B first\n\nprint(f\"Flagged {len(malicious_ids)} events via GUIDs and direct mentions.\")\nEOF\npython3 /tmp/analyze.py\n"]
