[166.903453, "i", "cat << 'EOF' > /tmp/check_logon.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events\")\nevents = [dict(r) for r in cursor.fetchall()]\n\nlogon_id = '0x2D5A4B'\nprint(f\"Searching for Logon ID {logon_id}:\")\n\nlogon_events = []\nfor e in events:\n    msg = e['message'] or ''\n    if logon_id.lower() in msg.lower():\n        logon_events.append(e)\n\nprint(f\"Total events mentioning {logon_id}: {len(logon_events)}\")\n\n# Group by Event Code and Process Name\nfrom collections import Counter\nc = Counter()\nfor e in logon_events:\n    # try to find process name/ID in message\n    proc_name = \"\"\n    proc_match = re.search(r'Process Name:\\s*(.*)', e['message'] or '')\n    if proc_match:\n        proc_name = proc_match.group(1).strip()\n    else:\n        proc_match2 = re.search(r'Image:\\s*(.*)', e['message'] or '')\n        if proc_match2:\n            proc_name = proc_match2.group(1).strip()\n    c[(e['event_code'], proc_name)] += 1\n\nfor k, count in c.most_common():\n    print(f\"Code: {k[0]}, Proc: {k[1]}, Count: {count}\")\nEOF\npython3 /tmp/check_logon.py\n"]
