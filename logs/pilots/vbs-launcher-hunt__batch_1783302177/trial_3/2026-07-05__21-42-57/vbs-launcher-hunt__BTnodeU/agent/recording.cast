[240.973018, "i", "cat << 'EOF' > /tmp/compare.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Run both classification logics and print the difference\nEOF\n# Appending script 1 to /tmp/compare.py\ncat /tmp/verify.py | grep -v 'print(' >> /tmp/compare.py\n# Let's rename flagged from script 1 to flagged_old\nsed -i 's/flagged/flagged_old/g' /tmp/compare.py\nsed -i 's/reasons/reasons_old/g' /tmp/compare.py\nsed -i 's/add_flag/add_flag_old/g' /tmp/compare.py\n\n# Appending script 2 to /tmp/compare.py\ncat /tmp/classify.py | grep -v 'print(' >> /tmp/compare.py\n\n# Now compare them\ncat << 'EOF' >> /tmp/compare.py\ndiff = flagged_old - flagged\nprint(f\"Difference count: {len(diff)}\")\nfor eid in sorted(list(diff)):\n    cursor.execute(\"SELECT * FROM events WHERE event_id = ?\", (eid,))\n    e = dict(cursor.fetchone())\n    print(f\"{eid}: Code={e['event_code']}, Src={e['image']}, Target={e['target_image']}, ReasonOld={reasons_old[eid]}\")\nEOF\npython3 /tmp/compare.py\n"]
[240.973784, "o", "cat << 'EOF' > /tmp/compare.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> "]
