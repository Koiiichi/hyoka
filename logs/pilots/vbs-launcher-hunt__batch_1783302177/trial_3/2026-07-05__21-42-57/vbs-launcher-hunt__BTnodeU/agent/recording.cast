[100.269318, "o", "                                                                                                                                                                             \r\n                                                                                                                    %{S-1-5-32-560}                                                                                                                                                                                                                                      \r\n                                                                                                                    %{S-1-5-2}                                                                                                                                                                                                                                           \r\n                                                                                                                    %{S-1-5-11}                                                                                                                                                                                                                                          \r\n                                                                                                                    %{S-1-5-15}                                                                                                                                                                                                                                          \r\n                                                                                                                    %{S-1-5-21-2079883792-3656946353-945924832-1000}                                                                                                                                                                                    