[214.356553, "i", "cat << 'EOF' > /tmp/check_reasons.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nEOF\ncat /tmp/classify.py | grep -v 'print(' >> /tmp/check_reasons.py\ncat << 'EOF' >> /tmp/check_reasons.py\n\nfrom collections import Counter\nc = Counter()\nfor e in events:\n    if e['event_id'] in flagged:\n        c[(e['event_code'], reasons[e['event_id']])] += 1\n\nfor k, count in c.most_common():\n    print(f\"Code: {k[0]}, Reason: {k[1]}, Count: {count}\")\nEOF\npython3 /tmp/check_reasons.py\n"]
