[141.573737, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Get all events\ncursor.execute(\"SELECT event_id, event_code, timestamp, host, user, target_user, image, parent_image, parent_process_guid, command_line, message, process_guid FROM events\")\nrows = cursor.fetchall()\n\ncolnames = [d[0] for d in cursor.description]\nevents = []\nfor r in rows:\n    events.append(dict(zip(colnames, r)))\n\nprint(f\"Total events: {len(events)}\")\nEOF\npython3 /tmp/hunt.py\n"]
