[153.728683, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events\")\nevents = [dict(r) for r in cursor.fetchall()]\n\n# Malicious GUIDs\nmal_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}', # whoami.exe\n    '{860ba2e3-9f13-5f52-2803-000000000400}'  # conhost.exe\n}\n\n# Let's map process PIDs and hex PIDs from Sysmon events to security events\n# wscript.exe: PID is 2440 (0x988)? Or what?\n# Let's print the PIDs and Logon IDs of these processes to be precise.\n\nfor e in events:\n    # Sysmon event code 1\n    if e['event_code'] == 1 and e['process_guid'] in mal_guids:\n        print(f\"Code 1: ID={e['event_id']} Image={e['image']} Guid={e['process_guid']}\")\n        # extract ProcessId\n        pid_match = re.search(r'ProcessId:\\s*(\\d+)', e['message'] or '')\n        if pid_match:\n            print(f\"  PID: {pid_match.group(1)}\")\n\n    # Security event code 4688\n    if e['event_code'] == 4688:\n        cmd = e['command_line'] or ''\n        if 'launcher.vbs' in cmd or 'powershell.exe' in cmd or 'whoami.exe' in cmd or 'conhost.exe' in cmd:\n            print(f\"Code 4688: ID={e['event_id']} Cmd={cmd}\")\n            logon_match = re.search(r'Logon ID:\\s*(0x[0-9A-Fa-f]+)', e['message'] or '')\n            if logon_match:\n                print(f\"  Logon ID: {logon_match.group(1)}\")\n            proc_match = re.search(r'New Process ID:\\s*(0x[0-9A-Fa-f]+)', e['message'] or '')\n            if proc_match:\n                print(f\"  New Process ID: {proc_match.group(1)}\")\nEOF\npython3 /tmp/hunt.py\n"]
