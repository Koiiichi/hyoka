[100.270924, "o", "                                        Logon ID:               0x51E07A                                                                                                                                                                                                                             \r\n                                                                                                            Linked Logon ID:                0x0                                                                                                                                                                                                                          \r\n                                                                                                            Network Account Name:   -                                                                                                                                                                                                                                    \r\n                                                                                                            Network Account Domain: -                                                                                                                                                                                                                                    \r\n                                                                                                            Logon GUID:             {233a141f-661e-ef53-8c5e-ec52810dd948}                                                                                                                                                                                               \r\n                                                                                                                                                                                                                                                                                                                                                                         \r\n                                                                                                    Process Information:                                                                                                                                                                                                                                                 \r\n                                                                                                            Process ID:             0x0                                                                                                                                                                                                                                  \r\n                                                                                                            Process Name:           -                                                                                                                                                                                                                                    \r\n                                                                                                                                                                                                                                                                                                                                                                         \r\n                                                                                                    Network Information:                                                                                                                                                                                                                                                 \r\n                                  