[240.985774, "o", "\u001b[?2004hroot@acdd65ae1d6f:~# "]
[248.255925, "i", "cat << 'EOF' > /tmp/compare_clean.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events\")\nevents = [dict(r) for r in cursor.fetchall()]\n\n# Malicious Process GUIDs\nmal_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}', # whoami.exe\n    '{860ba2e3-9f13-5f52-2803-000000000400}'  # conhost.exe\n}\n\n# Malicious PIDs (decimal)\nmal_pids_dec = {2440, 2316, 9152, 7700}\nmal_pids_hex = {'0x988', '0x90c', '0x23c0', '0x1e14'}\n\nflagged_old = set()\nflagged_new = set()\n\nfor e in events:\n    eid = e['event_id']\n    code = e['event_code']\n    msg = e['message'] or ''\n    guid = e['process_guid']\n    pguid = e['parent_process_guid']\n    \n    # Logic 1 (Old)\n    if guid in mal_guids or pguid in mal_guids:\n        flagged_old.add(eid)\n    else:\n        for g in mal_guids:\n            if g in msg:\n                flagged_old.add(eid)\n                break\n        if eid not in flagged_old:\n            if code in (800, 4103, 4104, 400, 600) and e['host'] == 'WS-05.corp.example':\n                flagged_old.add(eid)\n            elif code in (5156, 5158) and e['host'] == 'WS-05.corp.example' and ('powershell.exe' in msg.lower() or 'wscript.exe' in msg.lower()):\n                flagged_old.add(eid)\n            else:\n                for p in mal_pids_hex:\n                    if p in msg.lower():\n                        flagged_old.add(eid)\n                        break\n                if eid not in flagged_old:\n                    for p in mal_pids_dec:\n                        if f\"ProcessId: {p}\" in msg or f\"Process ID: {p}\" in msg or f\"Process ID:\\t\\t{hex(p)}\" in msg:\n                            flagged_old.add(eid)\n                            break\n\n    # Logic 2 (New)\n    if guid in mal_guids:\n        flagged_new.add(eid)\n    elif code in (800, 4103, 4104, 400, 600) and e['host'] == 'WS-05.corp.example':\n        flagged_new.add(eid)\n    else:\n        # Check if the process executing is malicious\n        pid_matches = re.findall(r'Process ID:\\s*(0x[0-9A-Fa-f]+|\\d+)', msg)\n        new_pid_matches = re.findall(r'New Process ID:\\s*(0x[0-9A-Fa-f]+|\\d+)', msg)\n        creator_pid_matches = re.findall(r'Creator Process ID:\\s*(0x[0-9A-Fa-f]+|\\d+)', msg)\n        pids_found = set()\n        for val in pid_matches + new_pid_matches + creator_pid_matches:\n            val = val.strip()\n            if val.startswith('0x'):\n                pids_found.add(int(val, 16))\n            elif val.isdigit():\n                pids_found.add(int(val))\n        for pid in pids_found:\n            if pid in mal_pids_dec:\n                flagged_new.add(eid)\n                break\n\ndiff = flagged_old - flagged_new\nprint(f\"Flagged Old: {len(flagged_old)}, Flagged New: {len(flagged_new)}, Diff: {len(diff)}\")\nfor eid in sorted(list(diff)):\n    cursor.execute(\"SELECT * FROM events WHERE event_id = ?\", (eid,))\n    e = dict(cursor.fetchone())\n    print(f\"{eid}: Code={e['event_code']}, Src={e['image']}, Target={e['target_image']}, MsgSummary={e['message'][:150].strip().replace('\\n', ' ')}\")\nEOF\npython3 /tmp/compare_clean.py\n"]
[248.25645, "o", "cat << 'EOF' > /tmp/compare_clean.py\r\n"]
