[162.262128, "o", "    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe\r\n\u001b[?2004l\r\u001b[?2004h>     '{860ba2e3-9f2e-5f52-2a03-000000000400}', # whoami.exe\r\n\u001b[?2004l\r"]
[162.262176, "o", "\u001b[?2004h>     '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost.exe (powershell)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.262492, "o", "    '{860ba2e3-9f14-5f52-2903-000000000400}', # Wait, conhost has another GUID? Let's check\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Malicious PIDs (decimal)\r\n\u001b[?2004l\r\u001b[?2004h> mal_pids = {2440, 2316, 9152, 7700}\r\n\u001b[?2004l\r\u001b[?2004h> "]
