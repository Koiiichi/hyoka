[210.89939, "i", "cat << 'EOF' > /tmp/check_hosts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nEOF\ncat /tmp/classify.py | grep -v 'print(' >> /tmp/check_hosts.py\ncat << 'EOF' >> /tmp/check_hosts.py\n\nfrom collections import Counter\nhost_counts = Counter()\nfor e in events:\n    if e['event_id'] in flagged:\n        host_counts[e['host']] += 1\n\nfor h, count in host_counts.items():\n    print(f\"Host: {h}, Count: {count}\")\nEOF\npython3 /tmp/check_hosts.py\n"]
