[146.063524, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events\")\nevents = [dict(r) for r in cursor.fetchall()]\n\n# Let's track malicious process GUIDs\n# Start with our known malicious launcher processes on WS-05\nmalicious_guids = set([\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe C:\\Users\\m.ward\\Desktop\\launcher.vbs\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe -enc ...\n])\n\n# Let's find child processes of these\nadded = True\nwhile added:\n    added = False\n    for e in events:\n        pguid = e['process_guid']\n        ppguid = e['parent_process_guid']\n        if ppguid in malicious_guids and pguid and pguid not in malicious_guids:\n            malicious_guids.add(pguid)\n            added = True\n\nprint(\"Malicious GUIDs identified:\")\nfor g in malicious_guids:\n    print(g)\nEOF\npython3 /tmp/hunt.py\n"]
