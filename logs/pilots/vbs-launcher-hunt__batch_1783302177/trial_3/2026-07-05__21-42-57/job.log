Sending keys: ['cat << \'EOF\' > /tmp/compare_clean.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute("SELECT * FROM events")\nevents = [dict(r) for r in cursor.fetchall()]\n\n# Malicious Process GUIDs\nmal_guids = {\n    \'{860ba2e3-9f13-5f52-2603-000000000400}\', # wscript.exe\n    \'{860ba2e3-9f13-5f52-2703-000000000400}\', # powershell.exe\n    \'{860ba2e3-9f2e-5f52-2a03-000000000400}\', # whoami.exe\n    \'{860ba2e3-9f13-5f52-2803-000000000400}\'  # conhost.exe\n}\n\n# Malicious PIDs (decimal)\nmal_pids_dec = {2440, 2316, 9152, 7700}\nmal_pids_hex = {\'0x988\', \'0x90c\', \'0x23c0\', \'0x1e14\'}\n\nflagged_old = set()\nflagged_new = set()\n\nfor e in events:\n    eid = e[\'event_id\']\n    code = e[\'event_code\']\n    msg = e[\'message\'] or \'\'\n    guid = e[\'process_guid\']\n    pguid = e[\'parent_process_guid\']\n    \n    # Logic 1 (Old)\n    if guid in mal_guids or pguid in mal_guids:\n        flagged_old.add(eid)\n    else:\n        for g in mal_guids:\n            if g in msg:\n                flagged_old.add(eid)\n                break\n        if eid not in flagged_old:\n            if code in (800, 4103, 4104, 400, 600) and e[\'host\'] == \'WS-05.corp.example\':\n                flagged_old.add(eid)\n            elif code in (5156, 5158) and e[\'host\'] == \'WS-05.corp.example\' and (\'powershell.exe\' in msg.lower() or \'wscript.exe\' in msg.lower()):\n                flagged_old.add(eid)\n            else:\n                for p in mal_pids_hex:\n                    if p in msg.lower():\n                        flagged_old.add(eid)\n                        break\n                if eid not in flagged_old:\n                    for p in mal_pids_dec:\n                        if f"ProcessId: {p}" in msg or f"Process ID: {p}" in msg or f"Process ID:\\t\\t{hex(p)}" in msg:\n                            flagged_old.add(eid)\n                     