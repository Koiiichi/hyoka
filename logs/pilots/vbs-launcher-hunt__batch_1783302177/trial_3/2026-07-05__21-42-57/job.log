Sending keys: ['cat << \'EOF\' > /tmp/classify.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute("SELECT * FROM events")\nevents = [dict(r) for r in cursor.fetchall()]\n\n# Malicious Process GUIDs\nmal_guids = {\n    \'{860ba2e3-9f13-5f52-2603-000000000400}\', # wscript.exe\n    \'{860ba2e3-9f13-5f52-2703-000000000400}\', # powershell.exe\n    \'{860ba2e3-9f2e-5f52-2a03-000000000400}\', # whoami.exe\n    \'{860ba2e3-9f13-5f52-2803-000000000400}\'  # conhost.exe\n}\n\n# Malicious PIDs (hex)\nmal_pids_hex = {\'0x988\', \'0x90c\', \'0x23c0\', \'0x1e14\'}\n# Malicious PIDs (decimal)\nmal_pids_dec = {2440, 2316, 9152, 7700}\n\nflagged = set()\nreasons = {}\n\n# Helper to add flagged event\ndef add_flag(eid, reason):\n    flagged.add(eid)\n    reasons[eid] = reason\n\nfor e in events:\n    eid = e[\'event_id\']\n    code = e[\'event_code\']\n    msg = e[\'message\'] or \'\'\n    guid = e[\'process_guid\']\n    pguid = e[\'parent_process_guid\']\n    img = e[\'image\'] or \'\'\n    \n    # Rule 1: Sysmon process GUID is malicious\n    if guid in mal_guids:\n        add_flag(eid, f"process_guid={guid}")\n        continue\n    if pguid in mal_guids:\n        add_flag(eid, f"parent_process_guid={pguid}")\n        continue\n        \n    # Rule 2: Sysmon event mentions a malicious GUID\n    mentioned = False\n    for g in mal_guids:\n        if g in msg:\n            add_flag(eid, f"mentions_guid={g}")\n            mentioned = True\n            break\n    if mentioned:\n        continue\n        \n    # Rule 3: PowerShell Operational logs (since there is only one powershell.exe process and it is malicious)\n    if code in (800, 4103, 4104, 400, 600) and e[\'host\'] == \'WS-05.corp.example\':\n        add_flag(eid, f"powershell_log_code={code}")\n        continue\n        \n    # Rule 4: Security audits / WFP logs matching our malicious PIDs and Logon ID 0x2D5A4B\n    # Let\'s extract Process ID (both hex and decimal) and Logon ID from message\n    # For security audits:\n    # Logon ID: 0x2D5A4B\n    # Process ID / Creator Process ID / Creator Process ID / New Process ID: matching mal_pids_hex or mal_pids_dec\n    logon_match = re.search(r\'Logon ID:\\s*(0x[0-9A-Fa-f]+)\', msg)\n    proc_match = re.search(r\'Process ID:\\s*(0x[0-9A-Fa-f]+|\\d+)\', msg)\n    new_proc_match = re.search(r\'New Process ID:\\s*(0x[0-9A-Fa-f]+|\\d+)\', msg)\n    creator_proc_match = re.search(r\'Creator Process ID:\\s*(0x[0-9A-Fa-f]+|\\d+)\', msg)\n    source_proc_match = re.search(r\'SourceProcessId:\\s*(\\d+)\', msg)\n    target_proc_match = re.search(r\'TargetProcessId:\\s*(\\d+)\', msg)\n    \n    pids_found = set()\n    for m in [proc_match, new_proc_match, creator_proc_match]:\n        if m:\n            val = m.group(1).lower()\n            pids_found.add(val)\n    for m in [source_proc_match, target_proc_match]:\n        if m:\n            val = int(m.group(1))\n            pids_found.add(val)\n            \n    # Check if any identified PID is in our malicious PIDs\n    is_mal_pid = False\n    for pid in pids_found:\n        if str(pid) in mal_pids_hex or pid in mal_pids_dec:\n            is_mal_pid = True\n            break\n            \n    # Let\'s extract Logon ID\n    is_mal_logon = False\n    if logon_match and logon_match.group(1).upper() == \'0x2D5A4B\':\n        is_mal_logon = True\n        \n    # If it is one of our malicious PIDs, flag it!\n    if is_mal_pid:\n        add_flag(eid, f"matched_mal_pid_in_msg")\n        continue\n        \n    # Wait, what if the event is a WFP event for powershell.exe / wscript.exe?\n    # Code 5156/5158\n    if code in (5156, 5158) and e[\'host\'] == \'WS-05.corp.example\':\n        if \'powershell.exe\' in msg.lower() or \'wscript.exe\' in msg.lower():\n            add_flag(eid, "wfp_malicious_proc")\n            continue\n\nprint(f"Total flagged: {len(flagged)}")\nEOF\npython3 /tmp/classify.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
