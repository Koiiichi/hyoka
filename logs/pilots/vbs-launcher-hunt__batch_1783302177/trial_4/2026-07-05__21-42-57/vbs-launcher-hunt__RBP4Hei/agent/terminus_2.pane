[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> malicious_guids = {
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2603-000000000400}': 'wscript',
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2703-000000000400}': 'powershell',
[?2004l[?2004h>     '{860ba2e3-9f2e-5f52-2a03-000000000400}': 'whoami'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE host='WS-05.corp.example' ORDER BY timestamp ASC")
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> events_by_type = {}
[?2004l[?2004h> 
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     r_dict = dict(r)
[?2004l[?2004h>     guid = r_dict.get('process_guid')
[?2004l[?2004h>     pguid = r_dict.get('parent_process_guid')
[?2004l[?2004h>     image = (r_dict.get('image') or '').lower()
[?2004l[?2004h>     
[?2004l[?2004h>     # An event is directly initiated by a malicious process if:
[?2004l[?2004h>     # 1. Its process_guid matches one of our malicious processes
[?2004l[?2004h>     # 2. OR it is a process creation (1, 4688) of one of these malicious processes
[?2004l[?2004h>     # 3. OR it is a process termination (5, 4689) of one of these malicious processes
[?2004l[?2004h>     is_malicious_init = False
[?2004l[?2004h>     if guid in malicious_guids:
[?2004l[?2004h>         is_malicious_init = True
[?2004l[?2004h>     elif pguid in malicious_guids and r_dict['event_code'] in (1, 4688):
[?2004l[?2004h>         # Child process creation
[?2004l[?2004h>         is_malicious_init = True
[?2004l[?2004h>     elif r_dict['event_code'] in (1, 4688) and any(x in (r_dict['image'] or r_dict['command_line'] or '').lower() for x in ['wscript.exe', 'powershell.exe', 'whoami.exe', 'launcher.vbs']):
[?2004l[?2004h>         is_malicious_init = True
[?2004l[?2004h>     elif r_dict['event_code'] in (5, 4689) and any(x in (r_dict['image'] or '').lower() for x in ['wscript.exe', 'powershell.exe', 'whoami.exe']):
[?2004l[?2004h>         is_malicious_init = True
[?2004l[?2004h>         
[?2004l[?2004h>     if is_malicious_init:
[?2004l[?2004h>         code = r_dict['event_code']
[?2004l[?2004h>         if code not in events_by_type:
[?2004l[?2004h>             events_by_type[code] = []
[?2004l[?2004h>         events_by_type[code].append(r_dict)
[?2004l[?2004h> 
[?2004l[?2004h> print("MALICIOUS INITIATED EVENTS SUMMARY:")
[?2004l[?2004h> for code, evs in sorted(events_by_type.items()):
[?2004l[?2004h>     print(f"Event Code {code}: {len(evs)} events")
[?2004l[?2004h>     # Print up to 3 events as examples
[?2004l[?2004h>     for e in evs[:3]:
[?2004l[?2004h>         print(f"  ID: {e['event_id']} | Time: {e['timestamp']} | Image: {e['image']}")
[?2004l[?2004h>         if e['command_line']:
[?2004l[?2004h>             print(f"    Cmd: {e['command_line']}")
[?2004l[?2004h>         if e['event_code'] == 3:
[?2004l[?2004h>             print(f"    Net: {e['src_ip']} -> {e['dst_ip']}:{e['dst_port']}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
