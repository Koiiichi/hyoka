[?2004hroot@0eaae7d452c6:~# cat << 'EOF' > /tmp/check_privs.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, host, user, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE event_code IN (4673, 4703) 
[?2004l[?2004h>       AND host = 'WS-05.corp.example'
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     process_name = ""
[?2004l[?2004h>     for line in msg.split('\n'):
[?2004l[?2004h>         if 'Process Name:' in line or 'ProcessID:' in line or 'Process ID:' in line:
[?2004l[?2004h>             process_name += line.strip() + " | "
[?2004l[?2004h>     print(f"{r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | User: {r['user']}")
[?2004l[?2004h>     print(f"  Proc: {process_name}")
[?2004l[?2004h>     print("-"*50)
[?2004l[?2004h> EOF
