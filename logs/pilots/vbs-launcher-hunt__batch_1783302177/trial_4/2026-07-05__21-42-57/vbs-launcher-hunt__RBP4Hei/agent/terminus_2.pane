[?2004hroot@0eaae7d452c6:~# cat << 'EOF' > /tmp/inspect_reg_values.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, image, target_object, details, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE event_code IN (12, 13) 
[?2004l[?2004h>       AND (image LIKE '%powershell.exe' OR image LIKE '%wscript.exe')
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     # Try to find 'Details:' inside message if details column is empty
[?2004l[?2004h>     val_details = r['details'] or ''
[?2004l[?2004h>     if not val_details:
[?2004l[?2004h>         for line in msg.split('\n'):
[?2004l[?2004h>             if 'Details:' in line or 'NewName:' in line:
[?2004l[?2004h>                 val_details = line.strip()
[?2004l[?2004h>                 break
[?2004l[?2004h>     print(f"{r['event_id']} | Code: {r['event_code']} | Image: {r['image'][-20:]}")
[?2004l[?2004h>     print(f"  Key: {r['target_object']}")
[?2004l[?2004h>     print(f"  Val: {val_details}")
[?2004l[?2004h>     print("-"*50)
[?2004l[?2004h> EOF
[?2004l[?2004hroot@0eaae7d452c6:~# python3 /tmp/inspect_reg_values.py
