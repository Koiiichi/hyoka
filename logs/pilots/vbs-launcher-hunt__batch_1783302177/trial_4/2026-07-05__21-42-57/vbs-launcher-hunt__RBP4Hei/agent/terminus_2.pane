[?2004hroot@0eaae7d452c6:~# cat << 'EOF' > /tmp/inspect_messages.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE event_code IN (12, 13) 
[?2004l[?2004h>       AND (image LIKE '%powershell.exe' OR image LIKE '%wscript.exe')
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     lines = [line.strip() for line in msg.split('\n') if line.strip()]
[?2004l[?2004h>     # Find lines containing 'TargetObject', 'Details', 'NewName'
[?2004l[?2004h>     relevant = []
[?2004l[?2004h>     for line in lines:
[?2004l[?2004h>         if any(k in line for k in ['TargetObject:', 'Details:', 'NewName:', 'EventType:', 'TargetFilename:']):
[?2004l[?2004h>             relevant.append(line)
[?2004l[?2004h>     print(f"{r['event_id']} | Code: {r['event_code']} | {' | '.join(relevant)}")
[?2004l[?2004h> EOF
