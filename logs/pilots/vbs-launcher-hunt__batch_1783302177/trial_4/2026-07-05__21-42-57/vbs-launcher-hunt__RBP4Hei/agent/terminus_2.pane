[?2004hroot@0eaae7d452c6:~# cat << 'EOF' > /tmp/hunt.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> import base64
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's select all events
[?2004l[?2004h> cur.execute("SELECT * FROM events ORDER BY timestamp ASC")
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
