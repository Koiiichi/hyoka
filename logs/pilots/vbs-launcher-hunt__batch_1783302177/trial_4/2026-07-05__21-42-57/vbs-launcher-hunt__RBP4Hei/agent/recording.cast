[178.64255, "i", "cat << 'EOF' > /tmp/check_dc01.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host='DC01.corp.example' AND event_code IN (4624, 4672, 3, 11, 12)\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | User: {r['user']} | TarUser: {r['target_user']} | Img: {r['image']}\")\n    print(f\"  Msg: {r['message'][:300]}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/check_dc01.py\n"]
