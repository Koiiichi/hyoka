[215.184933, "i", "cat << 'EOF' > /tmp/hunt_initiators.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmalicious_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}': 'wscript',\n    '{860ba2e3-9f13-5f52-2703-000000000400}': 'powershell',\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}': 'whoami'\n}\n\ncur.execute(\"SELECT * FROM events WHERE host='WS-05.corp.example' ORDER BY timestamp ASC\")\nrows = cur.fetchall()\n\nevents_by_type = {}\n\nfor r in rows:\n    r_dict = dict(r)\n    guid = r_dict.get('process_guid')\n    pguid = r_dict.get('parent_process_guid')\n    image = (r_dict.get('image') or '').lower()\n    \n    # An event is directly initiated by a malicious process if:\n    # 1. Its process_guid matches one of our malicious processes\n    # 2. OR it is a process creation (1, 4688) of one of these malicious processes\n    # 3. OR it is a process termination (5, 4689) of one of these malicious processes\n    is_malicious_init = False\n    if guid in malicious_guids:\n        is_malicious_init = True\n    elif pguid in malicious_guids and r_dict['event_code'] in (1, 4688):\n        # Child process creation\n        is_malicious_init = True\n    elif r_dict['event_code'] in (1, 4688) and any(x in (r_dict['image'] or r_dict['command_line'] or '').lower() for x in ['wscript.exe', 'powershell.exe', 'whoami.exe', 'launcher.vbs']):\n        is_malicious_init = True\n    elif r_dict['event_code'] in (5, 4689) and any(x in (r_dict['image'] or '').lower() for x in ['wscript.exe', 'powershell.exe', 'whoami.exe']):\n        is_malicious_init = True\n        \n    if is_malicious_init:\n        code = r_dict['event_code']\n        if code not in events_by_type:\n            events_by_type[code] = []\n        events_by_type[code].append(r_dict)\n\nprint(\"MALICIOUS INITIATED EVENTS SUMMARY:\")\nfor code, evs in sorted(events_by_type.items()):\n    print(f\"Event Code {code}: {len(evs)} events\")\n    # Print up to 3 events as examples\n    for e in evs[:3]:\n        print(f\"  ID: {e['event_id']} | Time: {e['timestamp']} | Image: {e['image']}\")\n        if e['command_line']:\n            print(f\"    Cmd: {e['command_line']}\")\n        if e['event_code'] == 3:\n            print(f\"    Net: {e['src_ip']} -> {e['dst_ip']}:{e['dst_port']}\")\n\nEOF\npython3 /tmp/hunt_initiators.py\n"]
