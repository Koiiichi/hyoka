[83.16361, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, timestamp, host, user, image, parent_image, process_guid, parent_process_guid, command_line FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp ASC\")\nprocesses = [dict(r) for r in cur.fetchall()]\n\nprint(\"PROCESS CREATIONS:\")\nfor p in processes:\n    print(f\"ID: {p['event_id']} | Code: {p['event_code']} | Time: {p['timestamp']} | Host: {p['host']} | User: {p['user']}\")\n    print(f\"  Img: {p['image']} | ParentImg: {p['parent_image']}\")\n    print(f\"  Guid: {p['process_guid']} | ParentGuid: {p['parent_process_guid']}\")\n    print(f\"  Cmd: {p['command_line']}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/hunt.py\n"]
