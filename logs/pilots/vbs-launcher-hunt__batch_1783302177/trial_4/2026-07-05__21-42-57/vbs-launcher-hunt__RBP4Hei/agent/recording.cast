[203.185587, "i", "cat << 'EOF' > /tmp/check_process_access_malicious.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmalicious_names = ['wscript.exe', 'powershell.exe', 'whoami.exe', 'conhost.exe']\n\ncur.execute(\"SELECT event_id, event_code, timestamp, host, image, target_image, message FROM events WHERE host='WS-05.corp.example' AND event_code = 10\")\nfor r in cur.fetchall():\n    img = (r['image'] or '').lower()\n    targ = (r['target_image'] or '').lower()\n    \n    is_mal = False\n    for name in malicious_names:\n        if name in img or name in targ:\n            is_mal = True\n            break\n            \n    if is_mal:\n        print(f\"{r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']}\")\n        print(f\"  Src: {r['image']}\")\n        print(f\"  Targ: {r['target_image']}\")\n        print(\"-\"*80)\nEOF\npython3 /tmp/check_process_access_malicious.py\n"]
