[232.102276, "i", "cat << 'EOF' > /tmp/inspect_exact_malicious.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's get the core events:\n# Process creations and terminations\n# Network connection\n# Privilege service requests (Event 4673)\n# Script block logging (Event 4104)\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, host, image, command_line \n    FROM events \n    WHERE event_id IN (\n        'evt-00073', 'evt-00247', 'evt-00257', 'evt-00259', \n        'evt-00272', 'evt-00289', 'evt-00328', 'evt-00340', \n        'evt-00341', 'evt-00343', 'evt-00346', 'evt-00643', \n        'evt-00918', 'evt-01478', 'evt-01817', 'evt-01819', \n        'evt-01820', 'evt-01821', 'evt-01822', 'evt-01832', \n        'evt-01858'\n    ) ORDER BY timestamp ASC\n\"\"\")\n\nfor r in cur.fetchall():\n    print(f\"ID: {r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | Img: {r['image']}\")\n    if r['command_line']:\n        print(f\"  Cmd: {r['command_line'][:120]}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/inspect_exact_malicious.py\n"]
