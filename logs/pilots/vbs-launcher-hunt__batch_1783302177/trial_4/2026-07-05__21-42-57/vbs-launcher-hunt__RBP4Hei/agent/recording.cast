[192.089469, "i", "cat << 'EOF' > /tmp/check_exits.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host='WS-05.corp.example' AND event_code IN (5, 4689)\")\nfor r in cur.fetchall():\n    msg = r['message'] or ''\n    proc_guid = r['process_guid'] or ''\n    proc_name = \"\"\n    for line in msg.split('\\n'):\n        if 'Process Name:' in line or 'ProcessID:' in line or 'Image:' in line:\n            proc_name += line.strip() + \" | \"\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | Guid: {proc_guid}\")\n    print(f\"  Proc: {proc_name}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/check_exits.py\n"]
