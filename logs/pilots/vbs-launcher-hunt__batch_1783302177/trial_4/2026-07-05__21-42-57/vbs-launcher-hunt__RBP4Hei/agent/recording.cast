[133.796524, "o", "\u001b[?2004hroot@0eaae7d452c6:~# "]
[145.593759, "i", "cat << 'EOF' > /tmp/inspect_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\n\ncur = conn.cursor()\n\n# Inspecting Event 12, 13, 10 for powershell and wscript\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, host, image, target_object, details, message \n    FROM events \n    WHERE event_code IN (10, 12, 13) \n      AND (image LIKE '%powershell.exe' OR image LIKE '%wscript.exe')\n\"\"\")\n\nprint(\"REGISTRY AND PROCESS ACCESS EVENTS:\")\nfor r in cur.fetchall():\n    print(f\"ID: {r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | Image: {r['image']}\")\n    print(f\"  TargetObj: {r['target_object']}\")\n    print(f\"  Details: {r['details']}\")\n    print(f\"  Msg: {r['message'][:200]}\")\n    print(\"-\"*80)\n\nEOF\npython3 /tmp/inspect_events.py\n"]
