[150.062643, "o", "\u001b[?2004hroot@0eaae7d452c6:~# "]
[154.011897, "i", "cat << 'EOF' > /tmp/inspect_messages.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, message \n    FROM events \n    WHERE event_code IN (12, 13) \n      AND (image LIKE '%powershell.exe' OR image LIKE '%wscript.exe')\n\"\"\")\n\nfor r in cur.fetchall():\n    msg = r['message'] or ''\n    lines = [line.strip() for line in msg.split('\\n') if line.strip()]\n    # Find lines containing 'TargetObject', 'Details', 'NewName'\n    relevant = []\n    for line in lines:\n        if any(k in line for k in ['TargetObject:', 'Details:', 'NewName:', 'EventType:', 'TargetFilename:']):\n            relevant.append(line)\n    print(f\"{r['event_id']} | Code: {r['event_code']} | {' | '.join(relevant)}\")\nEOF\npython3 /tmp/inspect_messages.py\n"]
[154.012175, "o", "cat << 'EOF' > /tmp/inspect_messages.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
