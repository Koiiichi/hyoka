[174.125768, "i", "cat << 'EOF' > /tmp/check_other_hosts.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== DC01 EVENTS ===\")\ncur.execute(\"SELECT event_id, event_code, timestamp, user, target_user, image, message FROM events WHERE host='DC01.corp.example' ORDER BY timestamp ASC\")\nfor r in cur.fetchall():\n    msg = r['message'] or ''\n    # extract logon type, source network address, target user name if logon\n    details = \"\"\n    if r['event_code'] in (4624, 4625, 4672):\n        for line in msg.split('\\n'):\n            if 'Logon Type:' in line or 'Source Network Address:' in line or 'Account Name:' in line:\n                details += line.strip() + \" | \"\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | User: {r['user']} | TarUser: {r['target_user']} | Img: {r['image']}\")\n    if details:\n        print(f\"  Details: {details}\")\n    print(\"-\"*80)\n\nprint(\"\\n=== WS-06 EVENTS ===\")\ncur.execute(\"SELECT event_id, event_code, timestamp, user, target_user, image, message FROM events WHERE host='WS-06.corp.example' ORDER BY timestamp ASC\")\nfor r in cur.fetchall():\n    msg = r['message'] or ''\n    details = \"\"\n    for line in msg.split('\\n'):\n        if 'Process Name:' in line or 'Object Name:' in line or 'Accesses:' in line:\n            details += line.strip() + \" | \"\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | User: {r['user']} | TarUser: {r['target_user']} | Img: {r['image']}\")\n    if details:\n        print(f\"  Details: {details}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/check_other_hosts.py\n"]
