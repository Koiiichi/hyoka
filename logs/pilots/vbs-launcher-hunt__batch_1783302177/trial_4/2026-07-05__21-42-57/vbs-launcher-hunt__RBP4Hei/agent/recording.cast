[154.012728, "o", "conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, event_code, message \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.012786, "o", "    FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE event_code IN (12, 13) \r\n\u001b[?2004l\r\u001b[?2004h>       AND (image LIKE '%powershell.exe' OR image LIKE '%wscript.exe')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.013275, "o", "\"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     msg = r['message'] or ''\r\n\u001b[?2004l\r"]
[154.013485, "o", "\u001b[?2004h> "]
[154.01363, "o", "    lines = [line.strip() for line in msg.split('\\n') if line.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.013708, "o", "    # Find lines containing 'TargetObject', 'Details', 'NewName'\r\n\u001b[?2004l\r"]
[154.01401, "o", "\u001b[?2004h> "]
[154.014059, "o", "    relevant = []\r\n\u001b[?2004l\r\u001b[?2004h>     for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h>         if any(k in line for k in ['TargetObject:', 'Details:', 'NewName:', 'EventType:', 'TargetFilename:']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.014074, "o", "            relevant.append(line)\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.014188, "o", "> "]
[154.014363, "o", "    print(f\"{r['event_id']} | Code: {r['event_code']} | {' | '.join(relevant)}\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[154.015267, "o", "\u001b[?2004hroot@0eaae7d452c6:~# python3 /tmp/inspect_messages.py\r\n\u001b[?2004l\r"]
