[250.193579, "i", "cat << 'EOF' > /tmp/check_ws05_logons.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, timestamp, user, target_user, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (4624, 4672)\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | User: {r['user']} | TarUser: {r['target_user']}\")\n    print(f\"  Msg: {r['message'][:200]}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/check_ws05_logons.py\n"]
[250.195398, "o", "cat << 'EOF' > /tmp/check_ws05_logons.py\r\n"]
[250.195504, "o", "\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id, event_code, timestamp, user, target_user, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (4624, 4672)\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | User: {r['user']} | TarUser: {r['target_user']}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Msg: {r['message'][:200]}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[250.196131, "o", "    print(\"-\"*80)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[250.199796, "o", "\u001b[?2004hroot@0eaae7d452c6:~# "]
[250.200157, "o", "python3 /tmp/check_ws05_logons.py\r\n\u001b[?2004l\r"]
