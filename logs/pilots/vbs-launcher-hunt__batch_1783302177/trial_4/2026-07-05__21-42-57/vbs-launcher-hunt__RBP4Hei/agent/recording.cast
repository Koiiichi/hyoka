[163.97844, "i", "cat << 'EOF' > /tmp/check_privs.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, host, user, message \n    FROM events \n    WHERE event_code IN (4673, 4703) \n      AND host = 'WS-05.corp.example'\n\"\"\")\n\nfor r in cur.fetchall():\n    msg = r['message'] or ''\n    process_name = \"\"\n    for line in msg.split('\\n'):\n        if 'Process Name:' in line or 'ProcessID:' in line or 'Process ID:' in line:\n            process_name += line.strip() + \" | \"\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | User: {r['user']}\")\n    print(f\"  Proc: {process_name}\")\n    print(\"-\"*50)\nEOF\npython3 /tmp/check_privs.py\n"]
