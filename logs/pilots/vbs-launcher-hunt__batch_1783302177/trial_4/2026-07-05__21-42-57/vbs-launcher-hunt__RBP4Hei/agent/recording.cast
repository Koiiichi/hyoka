[145.62226, "o", "\u001b[?2004hroot@0eaae7d452c6:~# "]
[150.042146, "i", "cat << 'EOF' > /tmp/inspect_reg_values.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, image, target_object, details, message \n    FROM events \n    WHERE event_code IN (12, 13) \n      AND (image LIKE '%powershell.exe' OR image LIKE '%wscript.exe')\n\"\"\")\n\nfor r in cur.fetchall():\n    msg = r['message'] or ''\n    # Try to find 'Details:' inside message if details column is empty\n    val_details = r['details'] or ''\n    if not val_details:\n        for line in msg.split('\\n'):\n            if 'Details:' in line or 'NewName:' in line:\n                val_details = line.strip()\n                break\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Image: {r['image'][-20:]}\")\n    print(f\"  Key: {r['target_object']}\")\n    print(f\"  Val: {val_details}\")\n    print(\"-\"*50)\nEOF\npython3 /tmp/inspect_reg_values.py\n"]
[150.042472, "o", "cat << 'EOF' > /tmp/inspect_reg_values.py\r\n\u001b[?2004l\r"]
