[198.250754, "i", "cat << 'EOF' > /tmp/check_process_access.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, timestamp, host, user, image, target_image, granted_access, message FROM events WHERE host='WS-05.corp.example' AND event_code = 10\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Time: {r['timestamp']} | Image: {r['image']}\")\n    print(f\"  TargetImage: {r['target_image']} | Access: {r['granted_access']}\")\n    print(f\"  Msg: {r['message'][:300]}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/check_process_access.py\n"]
