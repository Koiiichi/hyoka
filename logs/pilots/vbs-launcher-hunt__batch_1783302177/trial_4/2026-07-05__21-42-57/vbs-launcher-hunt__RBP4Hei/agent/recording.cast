[220.798634, "i", "cat << 'EOF' > /tmp/summarize.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmalicious_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}': 'wscript',\n    '{860ba2e3-9f13-5f52-2703-000000000400}': 'powershell',\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}': 'whoami'\n}\n\ncur.execute(\"SELECT * FROM events WHERE host='WS-05.corp.example' ORDER BY timestamp ASC\")\nrows = cur.fetchall()\n\nresults = []\nfor r in rows:\n    r_dict = dict(r)\n    guid = r_dict.get('process_guid')\n    pguid = r_dict.get('parent_process_guid')\n    code = r_dict['event_code']\n    \n    is_mal = False\n    if guid in malicious_guids:\n        is_mal = True\n    elif pguid in malicious_guids and code in (1, 4688):\n        is_mal = True\n    elif code in (1, 4688) and any(x in (r_dict['image'] or r_dict['command_line'] or '').lower() for x in ['wscript.exe', 'powershell.exe', 'whoami.exe', 'launcher.vbs']):\n        is_mal = True\n    elif code in (5, 4689) and any(x in (r_dict['image'] or '').lower() for x in ['wscript.exe', 'powershell.exe', 'whoami.exe']):\n        is_mal = True\n        \n    if is_mal:\n        results.append(r_dict)\n\nprint(f\"Total selected: {len(results)}\")\ncounts = {}\nfor r in results:\n    c = r['event_code']\n    counts[c] = counts.get(c, 0) + 1\nfor c, count in sorted(counts.items()):\n    print(f\"Code {c}: {count}\")\n\nEOF\npython3 /tmp/summarize.py\n"]
