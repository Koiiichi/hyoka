[114.868859, "i", "cat << 'EOF' > /tmp/time_analysis.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Group events by host, process image and event code\ncur.execute(\"\"\"\n    SELECT host, event_code, image, COUNT(*)\n    FROM events\n    GROUP BY host, event_code, image\n    ORDER BY host, count(*) DESC\n\"\"\")\nfor r in cur.fetchall():\n    print(f\"{r['host']} | Event {r['event_code']} | Image: {r['image']} | Count: {r['count(*)']}\")\nEOF\npython3 /tmp/time_analysis.py\n"]
