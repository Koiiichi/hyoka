Sending keys: ['cat << \'EOF\' > /tmp/hunt_guids.py\nimport sqlite3\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmalicious_guids = {\n    \'{860ba2e3-9f13-5f52-2603-000000000400}\': \'wscript\',\n    \'{860ba2e3-9f13-5f52-2703-000000000400}\': \'powershell\',\n    \'{860ba2e3-9f2e-5f52-2a03-000000000400}\': \'whoami\'\n}\n\ncur.execute("SELECT * FROM events ORDER BY timestamp ASC")\nrows = cur.fetchall()\n\nmalicious_ids = []\n\nfor r in rows:\n    r_dict = dict(r)\n    guid = r_dict.get(\'process_guid\')\n    pguid = r_dict.get(\'parent_process_guid\')\n    msg = r_dict.get(\'message\') or \'\'\n    details = r_dict.get(\'details\') or \'\'\n    \n    is_malicious = False\n    reason = ""\n    \n    if guid in malicious_guids:\n        is_malicious = True\n        reason = f"ProcessGuid {guid} ({malicious_guids[guid]})"\n    elif pguid in malicious_guids:\n        is_malicious = True\n        reason = f"ParentProcessGuid {pguid} ({malicious_guids[pguid]})"\n    else:\n        for m_guid, name in malicious_guids.items():\n            if m_guid in msg or m_guid in details:\n                is_malicious = True\n                reason = f"GUID {m_guid} ({name}) in text"\n                break\n                \n    if is_malicious:\n        malicious_ids.append(r_dict[\'event_id\'])\n        print(f"ID: {r_dict[\'event_id\']} | Code: {r_dict[\'event_code\']} | Host: {r_dict[\'host\']} | Image: {r_dict[\'image\']} | Reason: {reason}")\n        print(f"  Timestamp: {r_dict[\'timestamp\']}")\n        if r_dict[\'command_line\']:\n            print(f"  Cmd: {r_dict[\'command_line\']}")\n        print("-"*50)\n\nprint(f"Found {len(malicious_ids)} malicious events.")\nEOF\npython3 /tmp/hunt_guids.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
