[84.614092, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's get all events from WS-05 first to analyze\ncursor.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\nrows = [dict(r) for r in cursor.fetchall()]\n\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP.exe\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd.exe\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost.exe\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt.exe\n    '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad.exe\n}\n\n# Let's trace matching process IDs (PIDs) from events\n# GruntHTTP.exe PID: 3356 (0xd1c)\n# cmd.exe PID: 3148 (0xc4c)\n# conhost.exe PID: ?\n# wuauclt.exe PID: 6208 (0x1840)\n# notepad.exe PID: 2368 (0x940)\nmalicious_pids = {3356, 3148, 6208, 2368, 1424, 6212} # we will find exact PIDs from the process creation events\n\nEOF\npython3 -c \"import sqlite3; conn=sqlite3.connect('/root/data/eventlogs.db'); c=conn.cursor(); c.execute('SELECT event_id, event_code, message FROM events WHERE host=\"WS-05.corp.example\" AND event_code IN (1, 4688)'); [print(row) for row in c.fetchall()]\"\n"]
