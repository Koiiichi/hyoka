[90.690242, "o", "\u001b[?2004hroot@608ec77142c9:~# "]
[99.028892, "i", "cat << 'EOF' >> /tmp/find_malicious.py\n\n# Let's write a script to check every WS-05 event and print it with a flag if it matches the GUIDs or PIDs\nmatched_events = []\n\nfor r in rows:\n    is_malicious = False\n    reason = []\n    \n    # Check GUIDs\n    pg = r.get('process_guid')\n    ppg = r.get('parent_process_guid')\n    if pg in malicious_guids:\n        is_malicious = True\n        reason.append(f\"process_guid={pg}\")\n    if ppg in malicious_guids:\n        is_malicious = True\n        reason.append(f\"parent_process_guid={ppg}\")\n        \n    # Check details for GUIDs\n    msg = r.get('message') or ''\n    for g in malicious_guids:\n        if g in msg:\n            is_malicious = True\n            reason.append(f\"GUID_in_message={g}\")\n            \n    # Check for PIDs in security logs or others\n    # Let's search for exact hex or decimal representations of malicious PIDs in message\n    for pid in pids:\n        hex_pid = hex(pid)\n        # Look for process ID patterns in message\n        # we should avoid false positives like standard numbers, so let's check patterns\n        patterns = [\n            rf'Process ID:\\s+({pid}|{hex_pid})\\b',\n            rf'ProcessID:\\s+({pid}|{hex_pid})\\b',\n            rf'Creator Process ID:\\s+({pid}|{hex_pid})\\b',\n            rf'SourceProcessId:\\s+({pid}|{hex_pid})\\b',\n            rf'TargetProcessId:\\s+({pid}|{hex_pid})\\b',\n            rf'Process ID:\\s*0x{pid:x}\\b',\n            rf'Process ID:\\s*0x{pid:08x}\\b',\n        ]\n        for pat in patterns:\n            if re.search(pat, msg, re.IGNORECASE):\n                is_malicious = True\n                reason.append(f\"PID_{pid}_matched_pattern\")\n                break\n                \n    if is_malicious:\n        matched_events.append((r, reason))\n\nprint(f\"Total matched malicious events: {len(matched_events)}\")\nfor r, reas in matched_events:\n    # print event summary\n    cmdline = r.get('command_line') or ''\n    img = r.get('image') or ''\n    pimg = r.get('parent_image') or ''\n    print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {img} | {pimg} | {cmdline[:60]} | {reas}\")\n\nEOF\npython3 /tmp/find_malicious.py > /tmp/matched.txt\nhead -n 100 /tmp/matched.txt\n"]
