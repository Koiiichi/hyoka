[129.944535, "o", "print(\"Event Codes:\")\r\nfor k, v in sorted(codes.items()):\r\n    print(f\"  {k}: {v}\")\r\n\r\nprint(\"Images:\")\r\nfor k, v in sorted(images.items()):\r\n    print(f\"  {k}: {v}\")\r\nprint(\"=== Non-core process matches ===\")\r\nfor r, reas in matched_events:\r\n    img = r['image'] or ''\r\n    if img and not any(x in img.lower() for x in ['grunthttp', 'cmd.exe', 'conhost.exe', 'wuauclt.exe', 'notepad.exe']):\r\n        print(f\"{r['event_id']} | {r['event_code']} | {img} | {reas}\")\r\n\u001b[?2004hroot@608ec77142c9:~# "]
[147.277718, "i", "cat << 'EOF' > /tmp/classify.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\nc = conn.cursor()\n\nc.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\nrows = [dict(r) for r in c.fetchall()]\n\n# Malicious Process GUIDs\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP.exe\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd.exe\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost.exe\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt.exe\n    '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad.exe\n}\n\ncore_malicious_events = []\n\nfor r in rows:\n    eid = r['event_id']\n    ec = r['event_code']\n    pg = r.get('process_guid')\n    ppg = r.get('parent_process_guid')\n    img = r.get('image') or ''\n    pimg = r.get('parent_image') or ''\n    cmd = r.get('command_line') or ''\n    msg = r.get('message') or ''\n    \n    # 1. Any event of GruntHTTP.exe\n    if pg == '{71b87c12-d7e5-5f84-0d01-000000000500}' or ppg == '{71b87c12-d7e5-5f84-0d01-000000000500}':\n        core_malicious_events.append((eid, ec, img, \"GruntHTTP.exe subject or child\"))\n        continue\n        \n    # 2. Process creation of malicious processes\n    if ec in (1, 4688):\n        if any(x in cmd.lower() or x in img.lower() for x in ['grunthttp', 'wuauclt.exe', 'notepad.exe', 'conhost.exe']):\n            core_malicious_events.append((eid, ec, img, \"Process creation of core process\"))\n            continue\n            \n    # 3. Remote thread creation from wuauclt to notepad\n    if ec == 8 and pg == '{71b87c12-d9fe-5f84-1901-000000000500}':\n        core_malicious_events.append((eid, ec, img, \"wuauclt remote thread\"))\n        continue\n        \n    # 4. SimpleInjection.dll loads or creations\n    if 'SimpleInjection.dll' in cmd or 'SimpleInjection.dll' in msg or 'SimpleInjection.dll' in r.get('image_loaded', ''):\n        core_malicious_events.append((eid, ec, img, \"SimpleInjection.dll\"))\n        continue\n        \n    # 5. Network / DNS events from injected notepad\n    if pg == '{71b87c12-d9fe-5f84-1a01-000000000500}' and ec in (3, 22):\n        core_malicious_events.append((eid, ec, img, \"notepad network/dns\"))\n        continue\n        \n    # 6. Registry modifications set by wuauclt or notepad\n    if ec in (12, 13) and pg in ('{71b87c12-d9fe-5f84-1901-000000000500}', '{71b87c12-d9fe-5f84-1a01-000000000500}'):\n        core_malicious_events.append((eid, ec, img, \"registry modification by injected/malicious process\"))\n        continue\n\nprint(f\"Core malicious events count: {len(core_malicious_events)}\")\nfor eid, ec, img, reas in core_malicious_events:\n    print(f\"  {eid} | {ec} | {img} | {reas}\")\n\nEOF\npython3 /tmp/classify.py\n"]
