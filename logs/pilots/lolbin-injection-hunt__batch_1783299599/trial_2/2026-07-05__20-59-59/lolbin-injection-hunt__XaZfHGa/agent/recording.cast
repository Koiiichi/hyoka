[162.019374, "o", "\u001b[?2004hroot@608ec77142c9:~# "]
[172.150173, "i", "cat << 'EOF' > /tmp/candidate_builder.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\nc = conn.cursor()\n\nc.execute(\"SELECT * FROM events ORDER BY timestamp\")\nrows = [dict(r) for r in c.fetchall()]\n\n# Malicious Process GUIDs\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP.exe\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd.exe\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost.exe\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt.exe\n    '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad.exe\n}\n\n# Malicious Process PIDs\nmalicious_pids = {3356, 3148, 4288, 6208, 2368}\n\nall_matches = []\n\nfor r in rows:\n    eid = r['event_id']\n    ec = r['event_code']\n    host = r['host']\n    pg = r.get('process_guid')\n    ppg = r.get('parent_process_guid')\n    img = r.get('image') or ''\n    pimg = r.get('parent_image') or ''\n    cmd = r.get('command_line') or ''\n    msg = r.get('message') or ''\n    \n    is_malicious = False\n    reason = []\n    \n    # 1. Host must be WS-05\n    if host != 'WS-05.corp.example':\n        continue\n        \n    # 2. Check GUIDs\n    if pg in malicious_guids:\n        is_malicious = True\n        reason.append(\"pg\")\n    if ppg in malicious_guids:\n        is_malicious = True\n        reason.append(\"ppg\")\n        \n    # 3. Check for GUIDs in message\n    for g in malicious_guids:\n        if g in msg:\n            is_malicious = True\n            reason.append(\"GUID_in_msg\")\n            \n    # 4. Check for PIDs in security logs or others\n    for pid in malicious_pids:\n        hex_pid = hex(pid)\n        patterns = [\n            rf'Process ID:\\s+({pid}|{hex_pid})\\b',\n            rf'ProcessID:\\s+({pid}|{hex_pid})\\b',\n            rf'Creator Process ID:\\s+({pid}|{hex_pid})\\b',\n            rf'SourceProcessId:\\s+({pid}|{hex_pid})\\b',\n            rf'TargetProcessId:\\s+({pid}|{hex_pid})\\b',\n            rf'Process ID:\\s*0x{pid:x}\\b',\n            rf'Process ID:\\s*0x{pid:08x}\\b',\n        ]\n        for pat in patterns:\n            if re.search(pat, msg, re.IGNORECASE):\n                is_malicious = True\n                reason.append(f\"PID_{pid}\")\n                break\n                \n    if is_malicious:\n        all_matches.append((r, reason))\n\n# Let's write strict vs broad definitions\n# Strict: excludes standard DLL loads (Sysmon 7) except for clbcatq.dll by GruntHTTP and SimpleInjection.dll\n# It also excludes process access (Sysmon 10) from benign processes (svchost, explorer, csrss, lsass, ctfmon) to malicious processes.\n\nstrict_events = []\nfor r, reas in all_matches:\n    ec = r['event_code']\n    img = r.get('image') or ''\n    msg = r.get('message') or ''\n    pg = r.get('process_guid')\n    ppg = r.get('parent_process_guid')\n    \n    # Filter Sysmon 7 (ImageLoad)\n    if ec == 7:\n        # only keep SimpleInjection.dll loads and GruntHTTP image loads\n        img_loaded = r.get('image_loaded') or ''\n        if 'simpleinjection' in img_loaded.lower() or 'grunthttp' in img.lower():\n            strict_events.append(r)\n        continue\n        \n    # Filter Sysmon 10 (ProcessAccess) from benign to malicious\n    if ec == 10:\n        # only keep where source is a malicious process\n        # extracting source process guid or checking image\n        if any(x in img.lower() for x in ['grunthttp', 'cmd.exe', 'conhost.exe', 'wuauclt.exe', 'notepad.exe']):\n            strict_events.append(r)\n        continue\n        \n    strict_events.append(r)\n\nprint(f\"All matches size: {len(all_matches)}\")\nprint(f\"Strict events size: {len(strict_events)}\")\n\nEOF\npython3 /tmp/candidate_builder.py\n"]
