[120.615625, "i", "cat << 'EOF' > /tmp/check_sec.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\nc = conn.cursor()\n\nc.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690) ORDER BY timestamp\")\nrows = [dict(r) for r in c.fetchall()]\n\nfor r in rows:\n    msg = r['message'] or ''\n    # extract Process ID and Process Name from message\n    pname = \"\"\n    pid = \"\"\n    m_name = re.search(r'Process Name:\\s*(.+)', msg, re.IGNORECASE)\n    m_id = re.search(r'Process ID:\\s*(0x[0-9a-f]+|\\d+)', msg, re.IGNORECASE)\n    if m_name:\n        pname = m_name.group(1).strip()\n    if m_id:\n        pid = m_id.group(1).strip()\n    print(f\"{r['event_id']} | {r['event_code']} | PID:{pid} | Name:{pname}\")\nEOF\npython3 /tmp/check_sec.py | head -n 30\n"]
