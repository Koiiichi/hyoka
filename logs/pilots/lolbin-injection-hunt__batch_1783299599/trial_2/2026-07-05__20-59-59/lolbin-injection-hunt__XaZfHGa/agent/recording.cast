[193.923678, "i", "cat << 'EOF' > /tmp/high_fidelity.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\nc = conn.cursor()\n\nc.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\nrows = [dict(r) for r in c.fetchall()]\n\n# Malicious Process GUIDs\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP.exe\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd.exe\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost.exe\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt.exe\n    '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad.exe\n}\n\nhf_events = []\n\nfor r in rows:\n    eid = r['event_id']\n    ec = r['event_code']\n    pg = r.get('process_guid')\n    ppg = r.get('parent_process_guid')\n    img = r.get('image') or ''\n    pimg = r.get('parent_image') or ''\n    cmd = r.get('command_line') or ''\n    msg = r.get('message') or ''\n    \n    is_malicious = False\n    reason = \"\"\n    \n    # Sysmon Events\n    if ec == 1:\n        if pg in malicious_guids:\n            is_malicious = True\n            reason = \"Sysmon 1\"\n    elif ec == 3:\n        if pg in malicious_guids:\n            is_malicious = True\n            reason = \"Sysmon 3\"\n    elif ec == 5:\n        if pg in malicious_guids:\n            is_malicious = True\n            reason = \"Sysmon 5\"\n    elif ec == 7:\n        img_loaded = r.get('image_loaded') or ''\n        if 'simpleinjection' in img_loaded.lower() or 'grunthttp' in img.lower():\n            is_malicious = True\n            reason = \"Sysmon 7\"\n    elif ec == 8:\n        if pg == '{71b87c12-d9fe-5f84-1901-000000000500}':\n            is_malicious = True\n            reason = \"Sysmon 8\"\n    elif ec == 10:\n        if pg in malicious_guids:\n            is_malicious = True\n            reason = \"Sysmon 10\"\n    elif ec == 11:\n        if pg == '{71b87c12-d7e5-5f84-0d01-000000000500}':\n            is_malicious = True\n            reason = \"Sysmon 11\"\n    elif ec in (12, 13):\n        if pg in malicious_guids:\n            is_malicious = True\n            reason = \"Sysmon 12/13\"\n    elif ec in (17, 18):\n        if pg in malicious_guids:\n            is_malicious = True\n            reason = \"Sysmon 17/18\"\n    elif ec == 22:\n        if pg in malicious_guids:\n            is_malicious = True\n            reason = \"Sysmon 22\"\n            \n    # Security Events\n    elif ec == 4688:\n        if any(x in cmd.lower() or x in img.lower() for x in ['grunthttp', 'wuauclt.exe', 'notepad.exe', 'conhost.exe']):\n            is_malicious = True\n            reason = \"Sec 4688\"\n    elif ec == 4673:\n        # privileged service request by GruntHTTP\n        if 'GruntHTTP' in msg:\n            is_malicious = True\n            reason = \"Sec 4673\"\n            \n    if is_malicious:\n        hf_events.append((eid, ec, img, cmd, reason))\n\nprint(f\"High-fidelity events size: {len(hf_events)}\")\nfor eid, ec, img, cmd, reason in hf_events:\n    print(f\"  {eid} | {ec} | {reason} | {img} | {cmd[:50]}\")\n\nEOF\npython3 /tmp/high_fidelity.py\n"]
