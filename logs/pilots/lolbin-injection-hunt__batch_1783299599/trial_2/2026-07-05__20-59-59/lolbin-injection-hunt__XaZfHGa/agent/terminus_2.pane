[?2004l[?2004h>         if g in msg:
[?2004l[?2004h>             is_malicious = True
[?2004l[?2004h>             reason.append(f"GUID_in_message={g}")
[?2004l[?2004h>             
[?2004l[?2004h>     # Check for PIDs in security logs or others
[?2004l[?2004h>     # Let's search for exact hex or decimal representations of malicious PIDs in message
