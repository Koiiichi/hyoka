Sending keys: ['cat << \'EOF\' > /tmp/find_malicious.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\nc = conn.cursor()\n\nc.execute("SELECT * FROM events WHERE host = \'WS-05.corp.example\' ORDER BY timestamp")\nrows = [dict(r) for r in c.fetchall()]\n\n# Malicious Process GUIDs\nmalicious_guids = {\n    \'{71b87c12-d7e5-5f84-0d01-000000000500}\', # GruntHTTP.exe\n    \'{71b87c12-d9fe-5f84-1701-000000000500}\', # cmd.exe\n    \'{71b87c12-d9fe-5f84-1801-000000000500}\', # conhost.exe\n    \'{71b87c12-d9fe-5f84-1901-000000000500}\', # wuauclt.exe\n    \'{71b87c12-d9fe-5f84-1a01-000000000500}\'  # notepad.exe\n}\n\n# Let\'s extract PIDs dynamically\npids = set()\nfor r in rows:\n    pg = r.get(\'process_guid\')\n    ppg = r.get(\'parent_process_guid\')\n    msg = r.get(\'message\') or \'\'\n    \n    # extract ProcessId/ProcessID/SourceProcessId/TargetProcessId/Creator Process ID from message\n    for match in re.finditer(r\'(?i)(processid|process id|sourceprocessid|targetprocessid|creator process id|target subject:\\s+process id):?\\s+(0x[0-9a-f]+|\\d+)\', msg):\n        val = match.group(2)\n        try:\n            pid = int(val, 16) if val.lower().startswith(\'0x\') else int(val)\n            if pg in malicious_guids or ppg in malicious_guids:\n                pids.add(pid)\n        except:\n            pass\n\nprint("Identified Malicious PIDs:", pids)\nEOF\npython3 /tmp/find_malicious.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
