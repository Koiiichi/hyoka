[183.791947, "i", "python3 -c \"\nimport sqlite3\nimport json\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Let's inspect the process tree and events\n# High-signal events:\n# 1. Sysmon 1 & Security 4688 for cmd, wuauclt, notepad\n# 2. Sysmon 11 (File creation) of SimpleInjection.dll\n# 3. Sysmon 17/18 (Pipes) from GruntHTTP.exe\n# 4. Sysmon 10 (Process access) to cmd, wuauclt, notepad\n# 5. Sysmon 7 (Image load) of SimpleInjection.dll\n# 6. Sysmon 8 (CreateRemoteThread) in notepad\n# 7. Sysmon 3 (Network connection) from notepad\n\nmal_ids = []\n\n# Let's query specific event_ids we identified\nquery = '''\nSELECT event_id, event_code, image, target_object, details, message \nFROM events \nWHERE event_id IN (\n    'evt-00088', -- SimpleInjection.dll creation\n    'evt-00528', -- cmd.exe 4688\n    'evt-00542', -- cmd.exe Sysmon 1\n    'evt-00531', 'evt-00534', 'evt-00535', 'evt-00536', -- Grunt Pipes\n    'evt-00544', -- Grunt to cmd Sysmon 10\n    'evt-00594', 'evt-00752', -- wuauclt.exe Sysmon 1 / 4688\n    'evt-00595', -- cmd to wuauclt Sysmon 10\n    'evt-00613', -- wuauclt load SimpleInjection.dll\n    'evt-00610', 'evt-00765', -- notepad.exe Sysmon 1 / 4688\n    'evt-00611', -- wuauclt to notepad Sysmon 10\n    'evt-00614', -- wuauclt to notepad Sysmon 8 CreateRemoteThread\n    'evt-00860'  -- notepad network connection\n)\n'''\n\ncur.execute(query)\nfor row in cur.fetchall():\n    print(row[0], row[1], row[2])\n\"\n"]
[183.793071, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> con = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cur = con.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
