[176.905341, "o", "sqlite3 /root/data/eventlogs.db \"SELECT count(*) FROM events WHERE host = 'WS-05.corp.example' AND timestamp BETWEEN '2026-05-06T00:01:49.000Z' AND '2026-05-06T00:01:54.000Z';\"\r\n"]
