[167.146325, "i", "cat << 'EOF' > /tmp/check_flagged.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nwith open('/tmp/flagged_ids_v2.json') as f:\n    flagged = json.load(f)\n\nprint(f\"Flagged events count: {len(flagged)}\")\n\nfor eid in flagged:\n    cursor.execute(\"SELECT event_code, host, image, target_image, command_line, message FROM events WHERE event_id = ?\", (eid,))\n    row = cursor.fetchone()\n    if row:\n        code, host, img, t_img, cl, msg = row\n        # Let's inspect some potential false positives\n        # Check if the process performing the action is svchost.exe, system, or another benign system process\n        # except for the prefetch file creations or WFP/Service activities\n        img_name = (img or '').lower()\n        if 'svchost.exe' in img_name and code != 11: # Code 11 is prefetch\n            print(f\"Suspicious svchost event {eid} (code {code}): {msg[:120].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/check_flagged.py\n"]
[167.147713, "o", "cat << 'EOF' > /tmp/check_flagged.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
