[114.578494, "i", "cat << 'EOF' > /tmp/check_pids.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp;\")\nevents = [dict(zip(['event_id', 'event_code', 'message'], row)) for row in cursor.fetchall()]\n\nwith open('/tmp/suspects.json') as f:\n    malicious_ids = set(json.load(f))\n\n# Let's map process IDs found in the direct malicious events to their process names\npid_to_names = {}\nfor ev in events:\n    eid = ev['event_id']\n    msg = ev['message'] or ''\n    # if this event is direct, let's look for Image and ProcessId or TargetImage and TargetProcessId\n    img_m = re.search(r'Image:\\s*([^\\r\\n]+)', msg)\n    pid_m = re.search(r'ProcessId:\\s*(\\d+)', msg)\n    if img_m and pid_m:\n        pid = int(pid_m.group(1))\n        img = img_m.group(1).strip()\n        pid_to_names.setdefault(pid, set()).add(img)\n        \n    t_img_m = re.search(r'TargetImage:\\s*([^\\r\\n]+)', msg)\n    t_pid_m = re.search(r'TargetProcessId:\\s*(\\d+)', msg)\n    if t_img_m and t_pid_m:\n        pid = int(t_pid_m.group(1))\n        img = t_img_m.group(1).strip()\n        pid_to_names.setdefault(pid, set()).add(img)\n\nfor pid, names in sorted(pid_to_names.items()):\n    print(f\"PID {pid}: {names}\")\n\nEOF\npython3 /tmp/check_pids.py\n"]
