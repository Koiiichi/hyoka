[98.95383, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's get all events on WS-05\ncursor.execute(\"SELECT event_id, event_code, timestamp, user, image, parent_image, parent_process_guid, process_guid, target_image, image_loaded, target_object, details, message FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp;\")\ncolumns = [col[0] for col in cursor.description]\nevents = [dict(zip(columns, row)) for row in cursor.fetchall()]\n\nprint(f\"Total events on WS-05: {len(events)}\")\n\n# Malicious Process GUIDs we know:\n# GruntHTTP.exe: {71b87c12-d7e5-5f84-0d01-000000000500}\n# cmd.exe: {71b87c12-d9fe-5f84-1701-000000000500}\n# conhost.exe: {71b87c12-d9fe-5f84-1801-000000000500}\n# wuauclt.exe: {71b87c12-d9fe-5f84-1901-000000000500}\n# notepad.exe: {71b87c12-d9fe-5f84-1a01-000000000500}\n\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # Grunt\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt\n    '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad\n}\n\nmalicious_ids = set()\n\nfor ev in events:\n    # Check if process_guid or parent_process_guid matches\n    p_guid = ev.get('process_guid')\n    pp_guid = ev.get('parent_process_guid')\n    msg = ev.get('message', '') or ''\n    eid = ev.get('event_id')\n    code = ev.get('event_code')\n    \n    # If the event message contains any of the malicious GUIDs\n    has_malicious_guid = any(g in msg for g in malicious_guids)\n    if p_guid in malicious_guids or pp_guid in malicious_guids or has_malicious_guid:\n        malicious_ids.add(eid)\n        continue\n        \n    # Also, let's look at images we know are malicious in this context\n    img = ev.get('image') or ''\n    t_img = ev.get('target_image') or ''\n    img_ld = ev.get('image_loaded') or ''\n    \n    # Check for GruntHTTP.exe\n    if 'GruntHTTP.exe' in img or 'GruntHTTP.exe' in msg:\n        malicious_ids.add(eid)\n        continue\n        \n    # Check for SimpleInjection.dll\n    if 'SimpleInjection.dll' in img_ld or 'SimpleInjection.dll' in msg:\n        malicious_ids.add(eid)\n        continue\n\nprint(f\"Identified {len(malicious_ids)} directly related malicious events.\")\n# Let's write them to a temp file and look at the ones we might have missed or want to verify\nwith open('/tmp/suspects.json', 'w') as f:\n    json.dump(sorted(list(malicious_ids)), f, indent=2)\n\nEOF\npython3 /tmp/hunt.py\n"]
