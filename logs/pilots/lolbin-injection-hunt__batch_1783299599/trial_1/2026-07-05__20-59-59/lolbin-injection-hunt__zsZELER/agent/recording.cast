[128.615311, "o", "        # In Sysmon message: ProcessId: PID, SourceProcessId: PID, TargetProcessId: PID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.615466, "o", "        # In Security message: Process ID: 0xPID, Creator Process ID: 0xPID, etc.\r\n\u001b[?2004l\r\u001b[?2004h>         hex_pid = f\"0x{pid:x}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.615671, "o", "        if re.search(r'\\b' + str(pid) + r'\\b', msg) or re.search(r'\\b' + hex_pid + r'\\b', msg, re.IGNORECASE):\r\n\u001b[?2004l\r\u001b[?2004h>             # Ensure it's not a generic number match. To be safe, verify the label around it\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.615798, "o", "            # like \"ProcessId: 3356\", \"Process ID:"]
[128.616647, "o", "\u00070xd1c\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[128.61672, "o", ">             # Let's write a robust check\r\n\u001b[?2004l\r"]
[128.616858, "o", "\u001b[?2004h> "]
[128.617029, "o", "            if re.search(r'(ProcessId|Process ID|SourceProcessId|TargetProcessId|Creator Process ID|Source Process ID|Target Process ID|ProcessId|ProcessGuid|SourceProcessGUID|TargetProcessGUID)\\b.*\\b(' + str(pid) + '|' + hex_pid + ')\\b', msg, re.IGNORECASE):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.617133, "o", "                has_mal_pid = True\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.617167, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.617306, "o", "    # Check for WFP (5156/5158) or Network Connection (3) on specific PIDs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.617326, "o", "    # Wait, WFP events have \"Process ID: <decimal_pid>\" in message\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.617441, "o", "    if code in (5156, 5158):\r\n\u001b[?2004l\r\u001b[?2004h>         for pid in mal_pids:\r\n\u001b[?2004l\r"]
[128.617473, "o", "\u001b[?2004h> "]
[128.617604, "o", "            if re.search(r'Process ID:\\s*' + str(pid) + r'\\b', msg):\r\n\u001b[?2004l\r\u001b[?2004h>                 has_mal_pid = True\r\n\u001b[?2004l\r\u001b[?2004h>                 break"]
[128.617775, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.617808, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.617934, "o", "    is_flagged = has_mal_file or has_mal_guid or has_mal_pid\r\n\u001b[?2004l\r\u001b[?2004h>     if is_flagged:\r\n\u001b[?2004l\r\u001b[?2004h>         flagged_events.append(ev)\r\n\u001b[?2004l\r"]
[128.617957, "o", "\u001b[?2004h> "]
[128.618124, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h>         benign_events.append(ev)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.61817, "o", "print(f\"Flagged: {len(flagged_events)} events\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Benign: {len(benign_events)} events\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.61835, "o", "# Let's save both list of IDs and details of benign events to review\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.618465, "o", "with open('/tmp/flagged_ids.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(sorted([ev['event_id'] for ev in flagged_events]), f, indent=2)\r\n\u001b[?2004l\r"]
[128.618489, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.618624, "o", "# Print some benign ones to see if any are suspicious\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.618656, "o", "with open('/tmp/benign_review.txt', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for ev in benign_events:"]
[128.618767, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.618872, "o", "        f.write(f\"{ev['event_id']} | {ev['event_code']} | {ev['timestamp']} | {ev['image']} | {ev['message'].replace('\\n', ' ')}\\n\")\r\n\u001b[?2004l\r"]
[128.61894, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[128.619688, "o", "\u001b[?2004hroot@ba4f5d4909cd:~# "]
[128.619779, "o", "python3 /tmp/classify_ws05.py\r\n\u001b[?2004l\r"]
[128.68088, "o", "Flagged: 223 events\r\nBenign: 461 events\r\n"]
[128.683045, "o", "\u001b[?2004hroot@ba4f5d4909cd:~# "]
[133.179924, "i", "grep -E -i 'wuauclt|notepad|cmd\\.exe|conhost|injection|grunt' /tmp/benign_review.txt | head -n 40\n"]
[133.180319, "o", "grep -E -i 'wuauclt|notepad|cmd\\.exe|conhost|injection|grunt' /tmp/benign_review.txt | head -n 40\r\n\u001b[?2004l\r"]
