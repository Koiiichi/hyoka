[153.121612, "i", "python3 -c \"\nimport json, collections, sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute('SELECT event_id, event_code FROM events')\neid_to_code = dict(cursor.fetchall())\n\nwith open('/tmp/flagged_ids_v2.json') as f: flagged = json.load(f)\nwith open('/tmp/flagged_ids.json') as f: flagged_v1 = json.load(f)\n\nprint('Flagged v2 counts:')\ncounts = collections.Counter(eid_to_code[e] for e in flagged)\nfor c, count in sorted(counts.items()):\n    print(f'  Code {c}: {count}')\n\"\n"]
