[98.95572, "o", "print(f\"Total events on WS-05: {len(events)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Malicious Process GUIDs we know:\r\n\u001b[?2004l\r\u001b[?2004h> # GruntHTTP.exe: {71b87c12-d7e5-5f84-0d01-000000000500}\r\n\u001b[?2004l\r\u001b[?2004h> # cmd.exe: {71b87c12-d9fe-5f84-1701-000000000500}\r\n\u001b[?2004l\r\u001b[?2004h> # conhost.exe: {71b87c12-d9fe-5f84-1801-000000000500}\r\n\u001b[?2004l\r\u001b[?2004h> # wuauclt.exe: {71b87c12-d9fe-5f84-1901-000000000500}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.955787, "o", "# notepad.exe: {71b87c12-d9fe-5f84-1a01-000000000500}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.955806, "o", "malicious_guids = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.95635, "o", ">     '{71b87c12-d7e5-5f84-0d01-000000000500}', # Grunt\r\n\u001b[?2004l\r\u001b[?2004h>     '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd\r\n\u001b[?2004l\r\u001b[?2004h>     '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost\r\n\u001b[?2004l\r\u001b[?2004h>     '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt\r\n\u001b[?2004l\r\u001b[?2004h>     '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.956501, "o", "malicious_ids = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for ev in events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.956727, "o", "    # Check if process_guid or parent_process_guid matches\r\n\u001b[?2004l\r\u001b[?2004h>     p_guid = ev.get('process_guid')\r\n\u001b[?2004l\r\u001b[?2004h>     pp_guid = ev.get('parent_process_guid')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.957278, "o", "    msg = ev.get('message', '') or ''\r\n\u001b[?2004l\r\u001b[?2004h>     eid = ev.get('event_id')\r\n\u001b[?2004l\r\u001b[?2004h>     code = ev.get('event_code')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # If the event message contains any of the malicious GUIDs\r\n\u001b[?2004l\r\u001b[?2004h>     has_malicious_guid = any(g in msg for g in malicious_guids)\r\n\u001b[?2004l\r\u001b[?2004h>     if p_guid in malicious_guids or pp_guid in malicious_guids or has_malicious_guid:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.957441, "o", "    # Also, let's look at images we know are malicious in this context\r\n\u001b[?2004l\r\u001b[?2004h>     img = ev.get('image') or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.957509, "o", "    t_img = ev.get('target_image') or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.957614, "o", "    img_ld = ev.get('image_loaded') or ''\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Check for GruntHTTP.exe\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.957874, "o", "> "]
[98.957967, "o", "    if 'GruntHTTP.exe' in img or 'GruntHTTP.exe' in msg:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # Check for SimpleInjection.dll\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.957987, "o", "    if 'SimpleInjection.dll' in img_ld or 'SimpleInjection.dll' in msg:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.958138, "o", "        malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.958283, "o", "print(f\"Identified {len(malicious_ids)} directly related malicious events.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.95846, "o", "# Let's write them to a temp file and look at the ones we might have missed or want to verify\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.958543, "o", "with open('/tmp/suspects.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.958576, "o", "    json.dump(sorted(list(malicious_ids)), f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[98.959851, "o", "\u001b[?2004hroot@ba4f5d4909cd:~# python3 /tmp/hunt.py\r\n\u001b[?2004l\r"]
[98.974687, "o", "Total events on WS-05: 684\r\n"]
[98.975288, "o", "Identified 221 directly related malicious events.\r\n"]
[98.978178, "o", "\u001b[?2004hroot@ba4f5d4909cd:~# "]
[108.78212, "i", "cat << 'EOF' >> /tmp/hunt.py\n\n# Let's find out which process IDs are associated with the malicious GUIDs\n# GruntHTTP.exe: {71b87c12-d7e5-5f84-0d01-000000000500}\n# cmd.exe: {71b87c12-d9fe-5f84-1701-000000000500}\n# conhost.exe: {71b87c12-d9fe-5f84-1801-000000000500}\n# wuauclt.exe: {71b87c12-d9fe-5f84-1901-000000000500}\n# notepad.exe: {71b87c12-d9fe-5f84-1a01-000000000500}\n\n# We saw in earlier logs:\n# GruntHTTP.exe PID: 3356 (0xd1c)\n# cmd.exe PID: 3148 (0xc4c)\n# wuauclt.exe PID: 6208 (0x1840)\n# notepad.exe PID: 2368 (0x940) or similar?\n# Let's extract the exact PIDs (both decimal and hex) from the database for these GUIDs\n\nimport re\n\npid_to_name = {}\npids = set() # decimal\nhex_pids = set() # hex format used in Security logs (e.g. 0x1a4)\n\nfor ev in events:\n    eid = ev['event_id']\n    if eid in malicious_ids:\n        # Let's extract ProcessId from message\n        msg = ev.get('message', '') or ''\n        for m in re.finditer(r'ProcessId:\\s*(\\d+)', msg):\n            pid = int(m.group(1))\n            pids.add(pid)\n            hex_pids.add(f\"0x{pid:x}\")\n        for m in re.finditer(r'SourceProcessId:\\s*(\\d+)', msg):\n            pid = int(m.group(1))\n            pids.add(pid)\n            hex_pids.add(f\"0x{pid:x}\")\n        for m in re.finditer(r'TargetProcessId:\\s*(\\d+)', msg):\n            pid = int(m.group(1))\n            pids.add(pid)\n            hex_pids.add(f\"0x{pid:x}\")\n\nprint(\"Malicious PIDs (decimal):\", pids)\nprint(\"Malicious PIDs (hex):\", hex_pids)\n\n# Now let's scan the remaining events and see if any of them mention these PIDs\nadditional_malicious = set()\nfor ev in events:\n    eid = ev['event_id']\n    if eid in malicious_ids:\n        continue\n    \n    msg = ev.get('message', '') or ''\n    # Check if any malicious PID (decimal or hex) is mentioned in the message or details\n    # Be careful to match them with word boundaries to avoid matching sub-strings\n    found = False\n    for pid in pids:\n        if re.search(r'\\b' + str(pid) + r'\\b', msg):\n            found = True\n            break\n    if not found:\n        for hpid in hex_pids:\n            if re.search(r'\\b' + hpid + r'\\b', msg, re.IGNORECASE):\n                found = True\n                break\n                \n    if found:\n        additional_malicious.add(eid)\n\nprint(f\"Found {len(additional_malicious)} additional malicious events by PID correlation.\")\n\n# Let's print the events that are STILL not classified as malicious so we can inspect them\nnon_malicious_events = []\nfor ev in events:\n    eid = ev['event_id']\n    if eid not in malicious_ids and eid not in additional_malicious:\n        non_malicious_events.append(ev)\n        \nprint(f\"Remaining non-malicious events on WS-05: {len(non_malicious_events)}\")\nfor ev in non_malicious_events[:20]:\n    print(f\"{ev['event_id']} | {ev['event_code']} | {ev['timestamp']} | {ev['image']} | {ev['message'][:100].replace('\\n', ' ')}\")\n\n# Merge additional ones\nmalicious_ids.update(additional_malicious)\nwith open('/tmp/suspects.json', 'w') as f:\n    json.dump(sorted(list(malicious_ids)), f, indent=2)\n\nEOF\npython3 /tmp/hunt.py\n"]
