[133.182842, "o", "\t\tC:\\Windows\\System32\\notepad.exe\r\nevt-00799 | 4658 | 2026-05-06T00:01:51.116Z |  | The handle to an object was closed.\r \r Subject :\r \tSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r \tAccount Name:\t\tm.ward\r \tAccount Domain:\t\tCORP\r \tLogon ID:\t\t0x163D26\r \r Object:\r \tObject Server:\t\tSecurity\r \tHandle ID:\t\t0x28fc\r \r Process Information:\r \tProcess ID:\t\t0x940\r \tProcess Name:\t\tC:\\Windows\\System32\\notepad.exe\r\nevt-00800 | 4656 | 2026-05-06T00:01:51.116Z |  | A handle to an object was requested.\r \r Subject:\r \tSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r \tAccount Name:\t\tm.ward\r \tAccount Domain:\t\tCORP\r \tLogon ID:\t\t0x163D26\r \r Object:\r \tObject Server:\t\tSecurity\r \tObject Type:\t\tKey\r \tObject Name:\t\t\\REGISTRY\\MACHINE\\SOFTWARE\\Microsoft\\.NETFramework\r \tHandle ID:\t\t0x270\r \tResource Attributes:\t-\r \r Process Information:\r \tProcess ID:\t\t0x940\r \tProcess Name:\t\tC:\\Windows\\System32\\notepad.exe\r \r Access Request Information:\r \tTransaction ID:\t\t{00000000-0000-0000-0000-000000000000}\r \tAccesses:\t\tREAD_CONTROL\r \t\t\t\tQuery key value\r \t\t\t\tEnumerate sub-keys\r \t\t\t\tNotify about changes to keys\r \t\t\t\t\r \tAccess Reasons:\t\t-\r \tAccess Mask:\t\t0x20019\r \tPrivileges Used for Access Check:\t-\r \tRestricted SID Count:\t0\r\nevt-00801 | 4658 | 2026-05-06T00:01:51.116Z |  | The handle to an object was closed.\r \r Subject :\r \tSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r \tAccount Name:\t\tm.ward\r \tAccount Domain:\t\tCORP\r \tLogon ID:\t\t0x163D26\r \r Object:\r \tObject Server:\t\tSecurity\r \tHandle ID:\t\t0x270\r \r Process Information:\r \tProcess ID:\t\t0x940\r \tProcess Name:\t\tC:\\Windows\\System32\\notepad.exe\r\n\u001b[?2004hroot@ba4f5d4909cd:~# "]
[143.504647, "i", "cat << 'EOF' > /tmp/classify_ws05_v2.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp;\")\ncolumns = [col[0] for col in cursor.description]\nevents = [dict(zip(columns, row)) for row in cursor.fetchall()]\n\n# Malicious Process PIDs, GUIDs, and Images\nmal_pids = {3356, 3148, 4288, 6208, 2368}\nmal_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}',\n    '{71b87c12-d9fe-5f84-1701-000000000500}',\n    '{71b87c12-d9fe-5f84-1801-000000000500}',\n    '{71b87c12-d9fe-5f84-1901-000000000500}',\n    '{71b87c12-d9fe-5f84-1a01-000000000500}'\n}\nmal_images = {'grunthttp.exe', 'simpleinjection.dll'}\n\n# Strict malicious filenames we want to catch if they are in the context of our execution\n# Specifically, they are cmd.exe, conhost.exe, wuauclt.exe, notepad.exe starting around 2026-05-06T00:01:49Z\n# Wait, is there any other cmd.exe, conhost.exe, wuauclt.exe, notepad.exe on WS-05 during this window?\n# Let's check. If they are in the execution window (between 00:01:49 and 00:02:10), they are almost certainly malicious!\n\nflagged_events = []\nbenign_events = []\n\nfor ev in events:\n    eid = ev['event_id']\n    code = ev['event_code']\n    msg = ev['message'] or ''\n    ts = ev['timestamp']\n    \n    # Check for direct mentions of malicious files\n    has_mal_file = any(img in msg.lower() for img in mal_images)\n    \n    # Check for process GUIDs\n    p_guid = ev.get('process_guid')\n    pp_guid = ev.get('parent_process_guid')\n    has_mal_guid = p_guid in mal_guids or pp_guid in mal_guids or any(g in msg for g in mal_guids)\n    \n    # Check if process PID is in msg\n    has_mal_pid = False\n    for pid in mal_pids:\n        hex_pid = f\"0x{pid:x}\"\n        if str(pid) in msg or hex_pid.lower() in msg.lower():\n            has_mal_pid = True\n            break\n            \n    # Check if the event mentions wuauclt, notepad, cmd.exe, conhost.exe during the critical execution window\n    # Execution window is 00:01:49 to 00:02:10\n    is_in_exec_window = '2026-05-06T00:01:49' <= ts <= '2026-05-06T00:02:10'\n    has_mal_exec_name = False\n    if is_in_exec_window:\n        for name in ['wuauclt', 'notepad', 'cmd.exe', 'conhost']:\n            if name in msg.lower():\n                has_mal_exec_name = True\n                break\n                \n    is_flagged = has_mal_file or has_mal_guid or has_mal_pid or has_mal_exec_name\n    if is_flagged:\n        flagged_events.append(ev)\n    else:\n        benign_events.append(ev)\n\nprint(f\"Flagged: {len(flagged_events)} events\")\nprint(f\"Benign: {len(benign_events)} events\")\n\nwith open('/tmp/flagged_ids_v2.json', 'w') as f:\n    json.dump(sorted([ev['event_id'] for ev in flagged_events]), f, indent=2)\n\nwith open('/tmp/benign_review_v2.txt', 'w') as f:\n    for ev in benign_events:\n        f.write(f\"{ev['event_id']} | {ev['event_code']} | {ev['timestamp']} | {ev['image']} | {ev['message'].replace('\\n', ' ')}\\n\")\n\nEOF\npython3 /tmp/classify_ws05_v2.py\n"]
