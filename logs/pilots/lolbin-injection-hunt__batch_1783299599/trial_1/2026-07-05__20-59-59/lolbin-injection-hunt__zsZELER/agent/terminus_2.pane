[?2004l[?2004h>         for pid in mal_pids:
[?2004l[?2004h>             if re.search(r'Process ID:\s*' + str(pid) + r'\b', msg):
[?2004l[?2004h>                 has_mal_pid = True
[?2004l[?2004h>                 break
[?2004l[?2004h>                 
[?2004l[?2004h>     is_flagged = has_mal_file or has_mal_guid or has_mal_pid
[?2004l[?2004h>     if is_flagged:
[?2004l[?2004h>         flagged_events.append(ev)
[?2004l[?2004h>     else:
[?2004l[?2004h>         benign_events.append(ev)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Flagged: {len(flagged_events)} events")
[?2004l[?2004h> print(f"Benign: {len(benign_events)} events")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's save both list of IDs and details of benign events to review
[?2004l[?2004h> with open('/tmp/flagged_ids.json', 'w') as f:
[?2004l[?2004h>     json.dump(sorted([ev['event_id'] for ev in flagged_events]), f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> # Print some benign ones to see if any are suspicious
[?2004l[?2004h> with open('/tmp/benign_review.txt', 'w') as f:
[?2004l[?2004h>     for ev in benign_events:
[?2004l[?2004h>         f.write(f"{ev['event_id']} | {ev['event_code']} | {ev['timestamp']} | {ev['image']} | {ev['message'].replace('\n', ' ')}\n")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@ba4f5d4909cd:~# python3 /tmp/classify_ws05.py
[?2004lFlagged: 223 events
