False\n    for pid in pids:\n        if re.search(r\'\\b\' + str(pid) + r\'\\b\', msg):\n            found = True\n            break\n    if not found:\n        for hpid in hex_pids:\n            if re.search(r\'\\b\' + hpid + r\'\\b\', msg, re.IGNORECASE):\n                found = True\n                break\n                \n    if found:\n        additional_malicious.add(eid)\n\nprint(f"Found {len(additional_malicious)} additional malicious events by PID correlation.")\n\n# Let\'s print the events that are STILL not classified as malicious so we can inspect them\nnon_malicious_events = []\nfor ev in events:\n    eid = ev[\'event_id\']\n    if eid not in malicious_ids and eid not in additional_malicious:\n        non_malicious_events.append(ev)\n        \nprint(f"Remaining non-malicious events on WS-05: {len(non_malicious_events)}")\nfor ev in non_malicious_events[:20]:\n    print(f"{ev[\'event_id\']} | {ev[\'event_code\']} | {ev[\'timestamp\']} | {ev[\'image\']} | {ev[\'message\'][:100].replace(\'\\n\', \' \')}")\n\n# Merge additional ones\nmalicious_ids.update(additional_malicious)\nwith open(\'/tmp/suspects.json\', \'w\') as f:\n    json.dump(sorted(list(malicious_ids)), f, indent=2)\n\nEOF\npython3 /tmp/hunt.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
