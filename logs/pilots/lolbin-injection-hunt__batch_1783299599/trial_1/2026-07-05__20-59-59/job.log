Sending keys: ['cat << \'EOF\' > /tmp/classify_ws05.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncursor = conn.cursor()\ncursor.execute("SELECT * FROM events WHERE host = \'WS-05.corp.example\' ORDER BY timestamp;")\ncolumns = [col[0] for col in cursor.description]\nevents = [dict(zip(columns, row)) for row in cursor.fetchall()]\n\n# Malicious Process PIDs, GUIDs, and Images\nmal_pids = {3356, 3148, 4288, 6208, 2368}\nmal_guids = {\n    \'{71b87c12-d7e5-5f84-0d01-000000000500}\', # Grunt\n    \'{71b87c12-d9fe-5f84-1701-000000000500}\', # cmd\n    \'{71b87c12-d9fe-5f84-1801-000000000500}\', # conhost\n    \'{71b87c12-d9fe-5f84-1901-000000000500}\', # wuauclt\n    \'{71b87c12-d9fe-5f84-1a01-000000000500}\'  # notepad\n}\nmal_images = {\'grunthttp.exe\', \'simpleinjection.dll\'}\n\nflagged_events = []\nbenign_events = []\n\nfor ev in events:\n    eid = ev[\'event_id\']\n    code = ev[\'event_code\']\n    msg = ev[\'message\'] or \'\'\n    \n    # Check for direct mentions of malicious filenames\n    has_mal_file = any(img in msg.lower() for img in mal_images)\n    \n    # Check for process GUIDs\n    p_guid = ev.get(\'process_guid\')\n    pp_guid = ev.get(\'parent_process_guid\')\n    has_mal_guid = p_guid in mal_guids or pp_guid in mal_guids or any(g in msg for g in mal_guids)\n    \n    # Check for process PIDs in Sysmon fields or message\n    has_mal_pid = False\n    for pid in mal_pids:\n        # Check if the process ID belongs to the event context as actor or target\n        # Usually, ProcessId, SourceProcessId, TargetProcessId are fields in the event\n        # In Sysmon message: ProcessId: PID, SourceProcessId: PID, TargetProcessId: PID\n        # In Security message: Process ID: 0xPID, Creator Process ID: 0xPID, etc.\n        hex_pid = f"0x{pid:x}"\n        if re.search(r\'\\b\' + str(pid) + r\'\\b\', msg) or re.search(r\'\\b\' + hex_pid + r\'\\b\', msg, re.IGNORECASE):\n            # Ensure it\'s not a generic number match. To be safe, verify the label around it\n            # like "ProcessId: 3356", "Process ID:\t0xd1c"\n            # Let\'s write a robust check\n            if re.search(r\'(ProcessId|Process ID|SourceProcessId|TargetProcessId|Creator Process ID|Source Process ID|Target Process ID|ProcessId|ProcessGuid|SourceProcessGUID|TargetProcessGUID)\\b.*\\b(\' + str(pid) + \'|\' + hex_pid + \')\\b\', msg, re.IGNORECASE):\n                has_mal_pid = True\n                break\n                \n    # Check for WFP (5156/5158) or Network Connection (3) on specific PIDs\n    # Wait, WFP events have "Process ID: <decimal_pid>" in message\n    if code in (5156, 5158):\n        for pid in mal_pids:\n            if re.search(r\'Process ID:\\s*\' + str(pid) + r\'\\b\', msg):\n                has_mal_pid = True\n                break\n                \n    is_flagged = has_mal_file or has_mal_guid or has_mal_pid\n    if is_flagged:\n        flagged_events.append(ev)\n    else:\n        benign_events.append(ev)\n\nprint(f"Flagged: {len(flagged_events)} events")\nprint(f"Benign: {len(benign_events)} events")\n\n# Let\'s save both list of IDs and details of benign events to review\nwith open(\'/tmp/flagged_ids.json\', \'w\') as f:\n    json.dump(sorted([ev[\'event_id\'] for ev in flagged_events]), f, indent=2)\n\n# Print some benign ones to see if any are suspicious\nwith open(\'/tmp/benign_review.txt\', \'w\') as f:\n    for ev in benign_events:\n        f.write(f"{ev[\'event_id\']} | {ev[\'event_code\']} | {ev[\'timestamp\']} | {ev[\'image\']} | {ev[\'message\'].replace(\'\\n\', \' \')}\\n")\n\nEOF\npython3 /tmp/classify_ws05.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
