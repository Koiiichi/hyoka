[160.427323, "i", "python3 -c \"\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute('SELECT event_id, event_code, host, channel, provider, image, parent_image, parent_process_guid, process_guid, message FROM events')\nrows = cursor.fetchall()\n\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP.exe\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd.exe\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost.exe\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt.exe\n    '{71b87c12-d9fe-5f84-1a01-000000000500}', # notepad.exe\n}\n\nmalicious_pids = {'3356', '3148', '4288', '6208', '2368'}\n\nmal_events = set()\n\nfor r_id, r_code, r_host, r_channel, r_provider, r_image, r_parent_image, r_parent_guid, r_guid, r_msg in rows:\n    is_m = False\n    # Rule 1: explicit malicious GUID in fields\n    if r_guid in malicious_guids or r_parent_guid in malicious_guids:\n        is_m = True\n    # Rule 2: message mentions any of the malicious GUIDs\n    if not is_m:\n        for guid in malicious_guids:\n            if guid in r_msg:\n                is_m = True\n                break\n    # Rule 3: message or image belongs to malicious process name + PID on host WS-05\n    if not is_m and r_host == 'WS-05.corp.example':\n        # check if it mentions malicious PIDs\n        for pid in malicious_pids:\n            hex_pid = hex(int(pid))\n            if pid in r_msg or hex_pid in r_msg.lower():\n                # ensure it is not svchost or other benign process\n                if 'svchost.exe' not in r_image.lower() and 'svchost.exe' not in r_msg.lower():\n                    is_m = True\n                    break\n        # check if it is Security process creation for one of our malicious processes\n        if r_code == 4688:\n            for pid in malicious_pids:\n                if pid in r_msg or hex(int(pid)) in r_msg.lower():\n                    is_m = True\n                    break\n            for name in ['grunthttp.exe', 'wuauclt.exe', 'notepad.exe']:\n                if"]
[160.427828, "i", " name in r_msg.lower():\n                    is_m = True\n                    break\n\n    if is_m:\n        mal_events.add(r_id)\n\nprint(f'Found {len(mal_events)} malicious events')\n# Let us write them to /root/findings.json\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(mal_events)), f)\n\"\n"]
