[213.135681, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute('SELECT event_id, message FROM events WHERE event_code = 10 AND host = \\'WS-05.corp.example\\'')\nrows = cursor.fetchall()\n\nmalicious_names = {'grunthttp.exe', 'cmd.exe', 'conhost.exe', 'wuauclt.exe', 'notepad.exe'}\n\nfor r_id, r_msg in rows:\n    source = ''\n    target = ''\n    for line in r_msg.splitlines():\n        if 'SourceImage:' in line: source = line.split(':', 1)[1].strip()\n        if 'TargetImage:' in line: target = line.split(':', 1)[1].strip()\n    # Check if source process name is in our malicious set\n    import os\n    src_base = os.path.basename(source).lower()\n    if src_base in malicious_names:\n        print(f'{r_id} | Src: {source} | Dst: {target}')\n\"\n"]
