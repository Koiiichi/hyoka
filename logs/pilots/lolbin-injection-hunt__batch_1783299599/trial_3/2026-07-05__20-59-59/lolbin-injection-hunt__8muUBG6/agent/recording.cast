[170.936151, "i", "python3 -c \"import sqlite3; conn = sqlite3.connect('/root/data/eventlogs.db'); cursor = conn.cursor(); cursor.execute('SELECT event_id, event_code, image, message FROM events WHERE host = \\'WS-05.corp.example\\' AND event_code IN (12, 13)'); rows = cursor.fetchall(); malicious_pids = {'3148', '4288', '6208', '2368', '3356'}; malicious_names = {'cmd.exe', 'conhost.exe', 'wuauclt.exe', 'notepad.exe', 'grunthttp.exe'}; m_count = 0; b_events = []\nfor r_id, r_code, r_img, r_msg in rows:\n    is_m = False\n    for pid in malicious_pids:\n        if pid in r_msg or hex(int(pid)) in r_msg.lower():\n            is_m = True; break\n    if not is_m:\n        for name in malicious_names:\n            if name in r_msg.lower() or (r_img and name in r_img.lower()):\n                is_m = True; break\n    if is_m: m_count += 1\n    else: b_events.append((r_id, r_code, r_img, r_msg[:100].replace('\\n', ' ')))\nprint('Registry Malicious:', m_count); print('Registry Benign:', len(b_events)); print('Benign registry samples:', b_events[:10])\"\n"]
