[253.423761, "i", "python3 -c \"\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute('SELECT event_id, event_code, host, channel, provider, image, parent_image, parent_process_guid, process_guid, message, target_image FROM events')\nrows = cursor.fetchall()\n\nmalicious_ids = set()\n\n# Malicious Process list on WS-05\nmalicious_proc_images = {\n    'c:\\\\users\\\\m.ward\\\\desktop\\\\grunthttp.exe',\n    'c:\\\\windows\\\\system32\\\\cmd.exe',\n    'c:\\\\windows\\\\system32\\\\conhost.exe',\n    'c:\\\\windows\\\\system32\\\\wuauclt.exe',\n    'c:\\\\windows\\\\system32\\\\notepad.exe'\n}\n\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP.exe\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd.exe\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost.exe\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt.exe\n    '{71b87c12-d9fe-5f84-1a01-000000000500}', # notepad.exe\n}\n\nfor r_id, r_code, r_host, r_channel, r_provider, r_image, r_parent, r_parent_guid, r_guid, r_msg, r_tgt_img in rows:\n    is_malicious = False\n    \n    # 1. Any event on other hosts (DC01, WS-06) is benign\n    if r_host != 'WS-05.corp.example':\n        continue\n        \n    # 2. Lowercase Security channel: malicious if Logon ID is 0x163D26\n    if r_channel.lower() == 'security':\n        if '0x163d26' in r_msg.lower():\n            is_malicious = True\n            \n    # 3. Sysmon channel\n    elif 'sysmon' in r_channel.lower():\n        # a. If we have GUID fields, check if they are in malicious guids\n        if r_guid in malicious_guids or r_parent_guid in malicious_guids:\n            # Exception for Sysmon 10 (Process Access): only count if the source process (image) is malicious!\n            if r_code == 10:\n                if r_image.lower() in malicious_proc_images:\n                    is_malicious = True\n            else:\n                is_malicious = True\n                \n        # b. File Created (11): only SimpleInjection.dll is malicious\n        elif r_code == 11:\n            if 'simpleinjection.dll' in r_msg.lower():\n                is_malicious = True\n                \n        # c. Registry Events (12, 13): check if process is malicious\n        elif r_code in (12, 13):\n            if r_image.lower() in malicious_proc_images:\n                is_malicious = True\n                \n        # d. Pipe Events (17, 18): check if process is malicious\n        elif r_code in (17, 18):\n            if r_image.lower() in malicious_proc_images:\n                is_malicious = True\n                \n        # e. Network Connection (3): check if process is malicious\n        elif r_code == 3:\n            if r_image.lower() in malicious_proc_images:\n                is_malicious = True\n                \n        # f. DNS Query (22): check if process is malicious\n        elif r_code == 22:\n            if r_image.lower() in malicious_proc_images:\n                is_malicious = True\n                \n        # g. CreateRemoteThread (8): check if source/target process is malicious\n        elif r_code == 8:\n            if r_image.lower() in malicious_proc_images:\n                is_malicious = True\n\n    if is_malicious:\n        malicious_ids.add(r_id)\n\nprint(f'Final Malicious Count: {len(malicious_ids)}')\n# Write sorted list to findings.json\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(malicious_ids)), f)\n\"\n"]
