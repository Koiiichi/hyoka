[199.654006, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute('SELECT event_id, event_code, host, image, parent_image, command_line FROM events')\nrows = cursor.fetchall()\n\n# Read /root/findings.json\nimport json\nwith open('/root/findings.json') as f:\n    mal_ids = set(json.load(f))\n\n# Print malicious events detail\nwith open('/tmp/malicious_details.txt', 'w') as out:\n    for r_id, r_code, r_host, r_image, r_parent, r_cmd in rows:\n        if r_id in mal_ids:\n            out.write(f'{r_id} | {r_code} | {r_host} | {r_image} | {r_parent} | {r_cmd}\\n')\n\"\n"]
