Sending keys: ['cat << \'EOF\' > find_security_events.py\nimport sqlite3\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncur = conn.cursor()\n\n# Let\'s search for Security events on WS-05\n# Malicious PIDs: \n# - Grunt: 3356\n# - cmd.exe: 3148\n# - conhost: 260\n# - wuauclt: 6208\n# - notepad: 2368\n\npids = {\'3356\', \'3148\', \'260\', \'6208\', \'2368\'}\n\ncur.execute("SELECT event_id, event_code, user, message FROM events WHERE host=\'WS-05.corp.example\' AND channel=\'Security\' AND event_code != 4688 ORDER BY timestamp;")\nrows = cur.fetchall()\n\nfor event_id, event_code, user, message in rows:\n    # Check if any malicious PID is in the message\n    found_pid = None\n    for pid in pids:\n        # typically PIDs in Security logs are represented in hex or decimal\n        # Let\'s do hex conversion as well\n        hex_pid_lower = f"0x{int(pid):x}"\n        hex_pid_upper = hex_pid_lower.upper()\n        if pid in message or hex_pid_lower in message or hex_pid_upper in message:\n            found_pid = pid\n            break\n    if found_pid:\n        print(f"{event_id} | Security Code {event_code} | Matching PID {found_pid} | Message: {message[:100]}...")\n\nEOF\npython3 find_security_events.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
