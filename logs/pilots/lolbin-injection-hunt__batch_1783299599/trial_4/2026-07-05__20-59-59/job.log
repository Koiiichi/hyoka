Sending keys: ['cat << \'EOF\' > parse_matched_security.py\nimport sqlite3\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncur = conn.cursor()\n\nquery = """\nSELECT event_id, event_code, message \nFROM events \nWHERE host=\'WS-05.corp.example\' \n  AND event_code IN (4656, 4658, 4663, 4673, 4690, 4703, 5156, 5158)\n  AND (\n    message LIKE \'%notepad.exe%\'\n    OR message LIKE \'%wuauclt.exe%\'\n    OR message LIKE \'%cmd.exe%\'\n    OR message LIKE \'%GruntHTTP.exe%\'\n    OR message LIKE \'%SimpleInjection%\'\n  );\n"""\n\ncur.execute(query)\nrows = cur.fetchall()\n\nfor event_id, event_code, message in rows:\n    # Parse process name, object name, etc.\n    lines = message.split(\'\\n\')\n    proc_name = ""\n    obj_name = ""\n    accesses = ""\n    dest_ip = ""\n    dest_port = ""\n    for l in lines:\n        if "Process Name:" in l:\n            proc_name = l.split("Process Name:")[1].strip()\n        elif "Process ID:" in l:\n            proc_name += " (PID " + l.split("Process ID:")[1].strip() + ")"\n        elif "Object Name:" in l:\n            obj_name = l.split("Object Name:")[1].strip()\n        elif "Accesses:" in l:\n            accesses = l.split("Accesses:")[1].strip()\n        elif "Destination Address:" in l:\n            dest_ip = l.split("Destination Address:")[1].strip()\n        elif "Destination Port:" in l:\n            dest_port = l.split("Destination Port:")[1].strip()\n            \n    if event_code in (5156, 5158):\n        print(f"{event_id} | {event_code} | Proc: {proc_name} | Net: {dest_ip}:{dest_port}")\n    else:\n        print(f"{event_id} | {event_code} | Proc: {proc_name} | Obj: {obj_name} | Access: {accesses}")\n\nEOF\npython3 parse_matched_security.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
