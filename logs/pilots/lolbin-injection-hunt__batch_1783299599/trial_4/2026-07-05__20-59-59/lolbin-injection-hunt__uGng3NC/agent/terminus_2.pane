[?2004hroot@ba8c3081bb16:~# cat << 'EOF' > get_all_timeline.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Query all events on WS-05 between 00:01:49 and 00:02:05
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h> SELECT event_id, event_code, timestamp, image, parent_image, target_image, command_line, details, target_object, message 
[?2004l[?2004h> FROM events 
[?2004l[?2004h> WHERE host='WS-05.corp.example' 
[?2004l[?2004h>   AND timestamp >= '2026-05-06T00:01:49.000Z'
[?2004l[?2004h>   AND timestamp <= '2026-05-06T00:02:05.000Z'
[?2004l[?2004h> ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total events in this window: {len(rows)}")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     event_id, event_code, timestamp, image, parent_image, target_image, command_line, details, target_object, message = r
[?2004l[?2004h>     # Summarize
[?2004l[?2004h>     p_info = f"Image: {image or ''} | Parent: {parent_image or ''} | TargetImg: {target_image or ''}"
[?2004l[?2004h>     c_info = f"Cmd: {command_line or ''}"
[?2004l[?2004h>     t_info = f"TargetObj: {target_object or ''}"
[?2004l[?2004h>     print(f"{event_id} | Code: {event_code} | Time: {timestamp} | {p_info} | {c_info} | {t_info}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
