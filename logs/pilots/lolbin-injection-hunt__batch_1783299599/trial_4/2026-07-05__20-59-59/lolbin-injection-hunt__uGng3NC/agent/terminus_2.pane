[?2004l[?2004h> 
[?2004l[?2004h> cur.execute(query)
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> for event_id, event_code, message in rows:
[?2004l[?2004h>     # Parse process name, object name, etc.
[?2004l[?2004h>     lines = message.split('\n')
[?2004l[?2004h>     proc_name = ""
[?2004l[?2004h>     obj_name = ""
[?2004l[?2004h>     accesses = ""
[?2004l[?2004h>     dest_ip = ""
[?2004l[?2004h>     dest_port = ""
[?2004l[?2004h>     for l in lines:
[?2004l[?2004h>         if "Process Name:" in l:
[?2004l[?2004h>             proc_name = l.split("Process Name:")[1].strip()
[?2004l[?2004h>         elif "Process ID:" in l:
[?2004l[?2004h>             proc_name += " (PID " + l.split("Process ID:")[1].strip() + ")"
[?2004l[?2004h>         elif "Object Name:" in l:
[?2004l[?2004h>             obj_name = l.split("Object Name:")[1].strip()
[?2004l[?2004h>         elif "Accesses:" in l:
[?2004l[?2004h>             accesses = l.split("Accesses:")[1].strip()
[?2004l[?2004h>         elif "Destination Address:" in l:
[?2004l[?2004h>             dest_ip = l.split("Destination Address:")[1].strip()
[?2004l[?2004h>         elif "Destination Port:" in l:
[?2004l[?2004h>             dest_port = l.split("Destination Port:")[1].strip()
[?2004l[?2004h>             
[?2004l[?2004h>     if event_code in (5156, 5158):
[?2004l[?2004h>         print(f"{event_id} | {event_code} | Proc: {proc_name} | Net: {dest_ip}:{dest_port}")
[?2004l[?2004h>     else:
[?2004l[?2004h>         print(f"{event_id} | {event_code} | Proc: {proc_name} | Obj: {obj_name} | Access: {accesses}")
