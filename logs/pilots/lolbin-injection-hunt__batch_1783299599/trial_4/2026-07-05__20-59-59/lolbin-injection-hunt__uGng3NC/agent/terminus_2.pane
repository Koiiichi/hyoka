[?2004l[?2004h>     
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     
[?2004l[?2004h>     # If the process is one of the malicious processes
[?2004l[?2004h>     if process_guid in malicious_guids or parent_process_guid in malicious_guids:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # Check if image or parent image is Grunt, wuauclt, notepad (except if it's standard background noise, let's look closer)
