[?2004hroot@ba8c3081bb16:~# cat << 'EOF' > find_security_events.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search for Security events on WS-05
[?2004l[?2004h> # Malicious PIDs: 
[?2004l[?2004h> # - Grunt: 3356
[?2004l[?2004h> # - cmd.exe: 3148
[?2004l[?2004h> # - conhost: 260
[?2004l[?2004h> # - wuauclt: 6208
[?2004l[?2004h> # - notepad: 2368
[?2004l[?2004h> 
[?2004l[?2004h> pids = {'3356', '3148', '260', '6208', '2368'}
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, user, message FROM events WHERE host='WS-05.corp.example' AND channel='Security' AND event_code != 4688 ORDER BY timestamp;")
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> for event_id, event_code, user, message in rows:
[?2004l[?2004h>     # Check if any malicious PID is in the message
[?2004l[?2004h>     found_pid = None
[?2004l[?2004h>     for pid in pids:
[?2004l[?2004h>         # typically PIDs in Security logs are represented in hex or decimal
[?2004l[?2004h>         # Let's do hex conversion as well
[?2004l[?2004h>         hex_pid_lower = f"0x{int(pid):x}"
[?2004l[?2004h>         hex_pid_upper = hex_pid_lower.upper()
[?2004l[?2004h>         if pid in message or hex_pid_lower in message or hex_pid_upper in message:
[?2004l[?2004h>             found_pid = pid
[?2004l[?2004h>             break
[?2004l[?2004h>     if found_pid:
[?2004l[?2004h>         print(f"{event_id} | Security Code {event_code} | Matching PID {found_pid} | Message: {message[:100]}...")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
