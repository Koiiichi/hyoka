[?2004l[?2004h> FROM events 
[?2004l[?2004h> WHERE host='WS-05.corp.example' 
[?2004l[?2004h>   AND event_code IN (4656, 4658, 4663, 4673, 4690, 4703, 5156, 5158)
[?2004l[?2004h>   AND (
[?2004l[?2004h>     message LIKE '%notepad.exe%'
[?2004l[?2004h>     OR message LIKE '%wuauclt.exe%'
