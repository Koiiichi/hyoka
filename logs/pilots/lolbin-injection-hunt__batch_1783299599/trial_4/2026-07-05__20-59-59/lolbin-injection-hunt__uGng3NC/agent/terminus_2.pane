[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Query all events from WS-05
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, image, parent_image, parent_process_guid, process_guid, command_line, details, target_object, message FROM events WHERE host='WS-05.corp.example' ORDER BY timestamp;")
[?2004l[?2004h> rows = cur.fetchall()
