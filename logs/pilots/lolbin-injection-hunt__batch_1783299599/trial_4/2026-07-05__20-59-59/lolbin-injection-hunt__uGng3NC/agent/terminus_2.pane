[?2004l[?2004h>     OR message LIKE '%GruntHTTP.exe%'
[?2004l[?2004h>     OR message LIKE '%SimpleInjection%'
[?2004l[?2004h>   );
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute(query)
[?2004l[?2004h> rows = cur.fetchall()
