r\nProcessGuid: {71b87c12-d9fe-5f84-1a01-000000000500}\r\r\nProcessId: 2368\r\r\nQueryName: WS-05\r\r\nQueryStatus: 0\r\r\nQueryResults: fe80::c82a:1ede:d7bd:6e6e;::ffff:172.18.39.5;\r\r\nImage: C:\\Windows\\System32\\notepad.exe\r\nevt-00887|11|Microsoft-Windows-Sysmon/Operational|WS-05.corp.example||C:\\windows\\system32\\svchost.exe||||File created:\r\r\nRuleName: -\r\r\nUtcTime: 2020-10-12 22:34:48.268\r\r\nProcessGuid: {71b87c12-d257-5f84-3100-000000000500}\r\r\nProcessId: 2064\r\r\nImage: C:\\windows\\system32\\svchost.exe\r\r\nTargetFilename: C:\\Windows\\Prefetch\\NOTEPAD.EXE-D8414F97.pf\r\r\nCreationUtcTime: 2020-10-12 21:39:56.997\r\nevt-00890|10|Microsoft-Windows-Sysmon/Operational|WS-05.corp.example||C:\\windows\\system32\\svchost.exe||c:\\windows\\system32\\notepad.exe||Process accessed:\r\r\nRuleName: -\r\r\nUtcTime: 2020-10-12 22:34:50.102\r\r\nSourceProcessGUID: {71b87c12-d257-5f84-3100-000000000500}\r\r\nSourceProcessId: 2064\r\r\nSourceThreadId: 2216\r\r\nSourceImage: C:\\windows\\system32\\svchost.exe\r\r\nTargetProcessGUID: {71b87c12-d9fe-5f84-1a01-000000000500}\r\r\nTargetProcessId: 2368\r\r\nTargetImage: c:\\windows\\system32\\notepad.exe\r\r\nGrantedAccess: 0x3000\r\r\nCallTrace: C:\\windows\\SYSTEM32\\ntdll.dll+9c534|C:\\windows\\System32\\KERNELBASE.dll+305fe|c:\\windows\\system32\\sysmain.dll+1e689|c:\\windows\\system32\\sysmain.dll+1e509|c:\\windows\\system32\\sysmain.dll+1c32b|c:\\windows\\system32\\sysmain.dll+1bf95|c:\\windows\\system32\\sysmain.dll+74b0d|c:\\windows\\system32\\sysmain.dll+73b32|c:\\windows\\system32\\sysmain.dll+601a3|C:\\windows\\system32\\svchost.exe+314c|C:\\windows\\System32\\sechost.dll+2de2|C:\\windows\\System32\\KERNEL32.DLL+17bd4|C:\\windows\\SYSTEM32\\ntdll.dll+6ce51\r\n\u001b[?2004hroot@ba8c3081bb16:~# "]
[109.173902, "i", "cat << 'EOF' > find_events.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's define the PIDs / process GUIDs of interest\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # Grunt\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt\n    '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad\n}\n\n# Query all events from WS-05\ncur.execute(\"SELECT event_id, event_code, image, parent_image, parent_process_guid, process_guid, command_line, details, target_object, message FROM events WHERE host='WS-05.corp.example' ORDER BY timestamp;\")\nrows = cur.fetchall()\n\nmalicious_events = []\n\nfor row in rows:\n    event_id, event_code, image, parent_image, parent_process_guid, process_guid, command_line, details, target_object, message = row\n    \n    is_malicious = False\n    \n    # If the process is one of the malicious processes\n    if process_guid in malicious_guids or parent_process_guid in malicious_guids:\n        is_malicious = True\n        \n    # Check if image or parent image is Grunt, wuauclt, notepad (except if it's standard background noise, let's look closer)\n    # Actually, we can refine this. What other events could be malicious?\n    # File deletions? registry settings?\n    \n    if is_malicious:\n        malicious_events.append({\n            'event_id': event_id,\n            'event_code': event_code,\n            'image': image,\n            'command_line': command_line,\n            'details': details,\n            'target_object': target_object\n        })\n\nprint(f\"Found {len(malicious_events)} malicious events based on GUID lineage:\")\nfor ev in malicious_events:\n    # print short summary\n    print(f\"{ev['event_id']} | {ev['event_code']} | {ev['image']} | {ev['command_line']} | {ev['target_object']}\")\n\nEOF\npython3 find_events.py > output.txt\nhead -n 100 output.txt\n"]
