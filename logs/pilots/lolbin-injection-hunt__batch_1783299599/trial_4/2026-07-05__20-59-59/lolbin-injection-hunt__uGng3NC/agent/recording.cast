[185.376341, "o", "\u001b[?2004hroot@ba8c3081bb16:~# "]
[189.607494, "i", "cat << 'EOF' > find_wfp.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (5156, 5158) ORDER BY timestamp;\")\nrows = cur.fetchall()\n\nfor event_id, event_code, message in rows:\n    # check for hex or dec PIDs\n    pids = ['2368', '3356', '3148', '6208', '260']\n    matched = False\n    for p in pids:\n        if p in message or f\"0x{int(p):x}\" in message or f\"0x{int(p):x}\".upper() in message:\n            matched = True\n            break\n    if matched:\n        print(f\"{event_id} | {event_code}\")\nEOF\npython3 find_wfp.py\n"]
[189.610395, "o", "cat << 'EOF' > find_wfp.py\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.61043, "o", "> import sqlite3\r\n\u001b[?2004l\r"]
