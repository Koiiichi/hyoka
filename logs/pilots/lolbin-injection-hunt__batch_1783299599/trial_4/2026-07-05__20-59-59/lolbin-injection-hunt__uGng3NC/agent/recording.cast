-00803\", \"evt-00804\", \"evt-00805\", \n    \"evt-00807\", \"evt-00808\", # notepad accesses .NETFramework\n    \"evt-00811\", \"evt-00812\", \"evt-00813\", \"evt-00814\", # notepad accesses Environment\n    \"evt-00816\", \"evt-00817\", \"evt-00818\", \"evt-00819\", \"evt-00821\", \"evt-00822\", \"evt-00823\", \"evt-00824\", \"evt-00826\", \n    \"evt-00827\", \"evt-00828\", \"evt-00829\", # notepad accesses Winlogon\n    \"evt-00831\", \"evt-00832\", \"evt-00833\", \"evt-00834\", \"evt-00836\", \"evt-00837\", \"evt-00838\", # notepad accesses Lsa & .NET\n]\n\n# Ensure unique and sorted\nfindings = sorted(list(set(findings)))\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(findings, f)\n    \nprint(f\"Successfully wrote {len(findings)} unique malicious events to /root/findings.json\")\nEOF\npython3 save_findings.py\n"]
