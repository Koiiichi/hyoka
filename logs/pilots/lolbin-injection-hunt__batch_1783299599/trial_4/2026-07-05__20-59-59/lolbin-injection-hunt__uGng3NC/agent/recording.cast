[129.225514, "i", "cat << 'EOF' > inspect_details.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nquery = \"\"\"\nSELECT event_id, event_code, image, parent_image, parent_process_guid, process_guid, command_line, details, target_object, message \nFROM events \nWHERE host='WS-05.corp.example' AND (\n    process_guid IN ('{71b87c12-d7e5-5f84-0d01-000000000500}', '{71b87c12-d9fe-5f84-1701-000000000500}', '{71b87c12-d9fe-5f84-1801-000000000500}', '{71b87c12-d9fe-5f84-1901-000000000500}', '{71b87c12-d9fe-5f84-1a01-000000000500}') OR \n    parent_process_guid IN ('{71b87c12-d7e5-5f84-0d01-000000000500}', '{71b87c12-d9fe-5f84-1701-000000000500}', '{71b87c12-d9fe-5f84-1801-000000000500}', '{71b87c12-d9fe-5f84-1901-000000000500}', '{71b87c12-d9fe-5f84-1a01-000000000500}')\n) ORDER BY timestamp;\n\"\"\"\n\ncur.execute(query)\nrows = cur.fetchall()\n\nfor r in rows:\n    event_id, event_code, image, parent_image, parent_process_guid, process_guid, command_line, details, target_object, message = r\n    if event_code == 7:\n        # Skip standard dlls\n        if \"System32\" in str(details) or \"System32\" in str(message) or \"System32\" in str(image_loaded := r[9]):\n            continue\n        if \"System32\" in str(target_object) or \"System32\" in str(command_line):\n            continue\n        # Let's print interesting dlls\n        print(f\"{event_id} | Code {event_code} | {image} loaded {message.split('ImageLoaded: ')[1].split('\\n')[0] if 'ImageLoaded: ' in message else message[:50]}\")\n    else:\n        print(f\"{event_id} | Code {event_code} | Image: {image} | Target: {target_object or ''} | Details: {str(details)[:100]} | Cmd: {command_line or ''}\")\n\nEOF\npython3 inspect_details.py > detailed_output.txt\ncat detailed_output.txt\n"]
