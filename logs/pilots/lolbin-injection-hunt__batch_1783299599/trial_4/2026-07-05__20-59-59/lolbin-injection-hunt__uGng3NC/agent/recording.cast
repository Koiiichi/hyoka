[261.719809, "i", "cat << 'EOF' > list_candidates.py\nimport json\n\n# Let's list the core events we are highly confident about:\ncore_events = [\n    # File creation\n    \"evt-00088\",\n    \n    # Named pipes\n    \"evt-00531\", \"evt-00534\", \"evt-00535\", \"evt-00536\",\n    \n    # Registry values sets (BAM)\n    \"evt-00540\", \"evt-00608\", \"evt-00647\",\n    \n    # Process creations\n    \"evt-00542\", \"evt-00528\", # cmd.exe\n    \"evt-00551\", \"evt-00530\", # conhost.exe\n    \"evt-00594\", \"evt-00752\", # wuauclt.exe\n    \"evt-00610\", \"evt-00765\", # notepad.exe\n    \n    # Process Access\n    \"evt-00544\", \"evt-00595\", \"evt-00611\",\n    \n    # DLL Loads (Malicious only)\n    \"evt-00613\",\n    \n    # Process injection\n    \"evt-00614\",\n    \n    # Process terminations\n    \"evt-00623\", \"evt-00646\", \"evt-00653\",\n    \n    # Registry additions/deletions by notepad.exe\n    \"evt-00744\", \"evt-00745\", \"evt-00753\", \"evt-00755\", \"evt-00756\", \"evt-00758\", \"evt-00760\", \"evt-00768\", \"evt-00776\", \n    \"evt-00843\", \"evt-00844\", \"evt-00845\", \"evt-00849\", \"evt-00851\", \"evt-00852\", \"evt-00853\", \"evt-00855\",\n    \n    # Network activity\n    \"evt-00860\", # Sysmon connection\n    \"evt-00863\", # Sysmon DNS\n    \"evt-00839\", # WFP bind\n    \"evt-00840\", # WFP connection\n    \n    # Privilege Use\n    \"evt-00529\", # Grunt privilege use\n    \"evt-00809\", # notepad privilege use\n    \n    # Object Access (Registry) associated with our processes\n    \"evt-00545\", # close handle by cmd\n    \"evt-00746\", \"evt-00748\", \"evt-00750\", # cmd accesses Lsa\n    \"evt-00757\", \"evt-00759\", \"evt-00761\", \"evt-00762\", # wuauclt accesses Lsa\n    \"evt-00771\", \"evt-00773\", \"evt-00775\", \"evt-00777\", # notepad accesses Lsa\n    \"evt-00783\", \"evt-00784\", \"evt-00785\", \"evt-00787\", \"evt-00788\", \"evt-00789\", \"evt-00791\", \"evt-00792\", \"evt-00793\", \n    \"evt-00795\", \"evt-00796\", \"evt-00797\", \"evt-00799\", \"evt-00800\", \"evt-00801\", \"evt-00803\", \"evt-00804\", \"evt-00805\", \n    \"evt-00807\", \"evt-00808\", # notepad accesses .NETFramework\n    \"evt-00811\", \"evt-00812\", \"evt-00813\", \"evt-00814\", # notepad accesses Environment\n    \"evt-00816\", \"evt-00817\", \"evt-00818\", \"evt-00819\", \"evt-00821\", \"evt-00822\", \"evt-00823\", \"evt-00824\", \"evt-00826\", \n    \"evt-00827\", \"evt-00828\", \"evt-00829\", # notepad accesses Winlogon\n    \"evt-00831\", \"evt-00832\", \"evt-00833\", \"evt-00834\", \"evt-00836\", \"evt-00837\", \"evt-00838\", # notepad accesses Lsa & .NET\n]\n\nprint(f\"Total core events: {len(core_events)}\")\nEOF\npython3 list_candidates.py\n"]
