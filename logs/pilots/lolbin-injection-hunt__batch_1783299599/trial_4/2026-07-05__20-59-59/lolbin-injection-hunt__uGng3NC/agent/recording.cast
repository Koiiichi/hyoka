[161.269425, "i", "cat << 'EOF' > find_matching_security.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nquery = \"\"\"\nSELECT event_id, event_code, message \nFROM events \nWHERE host='WS-05.corp.example' \n  AND event_code IN (4656, 4658, 4663, 4673, 4690, 4703, 5156, 5158)\n  AND (\n    message LIKE '%notepad.exe%'\n    OR message LIKE '%wuauclt.exe%'\n    OR message LIKE '%cmd.exe%'\n    OR message LIKE '%GruntHTTP.exe%'\n    OR message LIKE '%SimpleInjection%'\n  );\n\"\"\"\n\ncur.execute(query)\nrows = cur.fetchall()\n\nprint(f\"Found {len(rows)} matching Security events:\")\nfor event_id, event_code, message in rows:\n    # Extract a short summary of what happened\n    print(f\"{event_id} | {event_code} | {message[:120].strip().replace('\\n', ' ')}\")\n\nEOF\npython3 find_matching_security.py\n"]
[161.269721, "o", "cat << 'EOF' > find_matching_security.py\r\n\u001b[?2004l\r"]
