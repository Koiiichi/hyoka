[168.021956, "o", "Accoun\r\nevt-00827 | 4656 | A handle to an object was requested.\r\n\r\nSubject:\r\nSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r\nAccoun\r\nevt-00828 | 4663 | An attempt was made to access an object.\r\n\r\nSubject:\r\nSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r\nAc\r\nevt-00829 | 4658 | The handle to an object was closed.\r\n\r\nSubject :\r\nSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r\nAccoun\r\nevt-00831 | 4658 | The handle to an object was closed.\r\n\r\nSubject :\r\nSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r\nAccoun\r\nevt-00832 | 4656 | A handle to an object was requested.\r\n\r\nSubject:\r\nSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r\nAccoun\r\nevt-00833 | 4663 | An attempt was made to access an object.\r\n\r\nSubject:\r\nSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r\nAc\r\nevt-00834 | 4658 | The handle to an object was closed.\r\n\r\nSubject :\r\nSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r\nAccoun\r\nevt-00836 | 4658 | The handle to an object was closed.\r\n\r\nSubject :\r\nSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r\nAccoun\r\nevt-00837 | 4656 | A handle to an object was requested.\r\n\r\nSubject:\r\nSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r\nAccoun\r\nevt-00838 | 4658 | The handle to an object was closed.\r\n\r\nSubject :\r\nSecurity ID:\t\tS-1-5-21-4107722679-1012484280-3777968168-1104\r\nAccoun\r\nevt-00839 | 5158 | The Windows Filtering Platform has permitted a bind to a local port.\r\n\r\nApplication Information:\r\nProcess ID:\t\t2368\r\nA\r\nevt-00840 | 5156 | The Windows Filtering Platform has permitted a connection.\r\n\r\nApplication Information:\r\nProcess ID:\t\t2368\r\nApplication\r\n"]
[168.023707, "o", "\u001b[?2004hroot@ba8c3081bb16:~# "]
[174.307324, "i", "cat << 'EOF' > parse_matched_security.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nquery = \"\"\"\nSELECT event_id, event_code, message \nFROM events \nWHERE host='WS-05.corp.example' \n  AND event_code IN (4656, 4658, 4663, 4673, 4690, 4703, 5156, 5158)\n  AND (\n    message LIKE '%notepad.exe%'\n    OR message LIKE '%wuauclt.exe%'\n    OR message LIKE '%cmd.exe%'\n    OR message LIKE '%GruntHTTP.exe%'\n    OR message LIKE '%SimpleInjection%'\n  );\n\"\"\"\n\ncur.execute(query)\nrows = cur.fetchall()\n\nfor event_id, event_code, message in rows:\n    # Parse process name, object name, etc.\n    lines = message.split('\\n')\n    proc_name = \"\"\n    obj_name = \"\"\n    accesses = \"\"\n    dest_ip = \"\"\n    dest_port = \"\"\n    for l in lines:\n        if \"Process Name:\" in l:\n            proc_name = l.split(\"Process Name:\")[1].strip()\n        elif \"Process ID:\" in l:\n            proc_name += \" (PID \" + l.split(\"Process ID:\")[1].strip() + \")\"\n        elif \"Object Name:\" in l:\n            obj_name = l.split(\"Object Name:\")[1].strip()\n        elif \"Accesses:\" in l:\n            accesses = l.split(\"Accesses:\")[1].strip()\n        elif \"Destination Address:\" in l:\n            dest_ip = l.split(\"Destination Address:\")[1].strip()\n        elif \"Destination Port:\" in l:\n            dest_port = l.split(\"Destination Port:\")[1].strip()\n            \n    if event_code in (5156, 5158):\n        print(f\"{event_id} | {event_code} | Proc: {proc_name} | Net: {dest_ip}:{dest_port}\")\n    else:\n        print(f\"{event_id} | {event_code} | Proc: {proc_name} | Obj: {obj_name} | Access: {accesses}\")\n\nEOF\npython3 parse_matched_security.py\n"]
