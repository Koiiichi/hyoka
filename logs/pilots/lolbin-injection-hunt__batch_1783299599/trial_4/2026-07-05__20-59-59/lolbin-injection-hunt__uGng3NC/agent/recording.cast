[145.850836, "i", "cat << 'EOF' > dump_security.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, timestamp, user, target_user, service_name, details, message FROM events WHERE host='WS-05.corp.example' AND channel='Security' AND event_code NOT IN (4688, 4689) ORDER BY timestamp;\")\nrows = cur.fetchall()\n\nfor r in rows:\n    event_id, event_code, timestamp, user, target_user, service_name, details, message = r\n    print(f\"{event_id} | {event_code} | {timestamp} | {user} | {target_user} | {service_name} | {message[:200].replace('\\n', ' ')}\")\n\nEOF\npython3 dump_security.py > security_output.txt\ncat security_output.txt\n"]
