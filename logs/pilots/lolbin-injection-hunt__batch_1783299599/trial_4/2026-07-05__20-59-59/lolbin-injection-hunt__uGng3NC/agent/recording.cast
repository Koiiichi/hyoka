[306.119916, "i", "cat << 'EOF' > get_id10.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's search for Event Code 10 on WS-05\n# Malicious PIDs:\n# - Grunt: 3356\n# - cmd.exe: 3148\n# - conhost: 260\n# - wuauclt: 6208\n# - notepad: 2368\n\npids = {'3356', '3148', '260', '6208', '2368'}\n\ncur.execute(\"SELECT event_id, image, target_image, message FROM events WHERE host='WS-05.corp.example' AND event_code=10 ORDER BY timestamp;\")\nrows = cur.fetchall()\n\nfor event_id, image, target_image, message in rows:\n    found_pid = False\n    for pid in pids:\n        hex_pid_lower = f\"0x{int(pid):x}\"\n        hex_pid_upper = hex_pid_lower.upper()\n        if pid in message or hex_pid_lower in message or hex_pid_upper in message:\n            found_pid = True\n            break\n    if found_pid:\n        print(f\"{event_id} | Src: {image} | Target: {target_image}\")\n\nEOF\npython3 get_id10.py\n"]
[306.121108, "o", "cat << 'EOF' > get_id10.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
