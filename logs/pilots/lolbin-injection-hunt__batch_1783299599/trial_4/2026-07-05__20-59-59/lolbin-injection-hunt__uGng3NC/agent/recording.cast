[290.897602, "i", "cat << 'EOF' > inspect_access.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # Grunt\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt\n    '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad\n}\n\ncur.execute(\"\"\"\nSELECT event_id, image, target_image, details, message \nFROM events \nWHERE host='WS-05.corp.example' AND event_code=10;\n\"\"\")\nrows = cur.fetchall()\n\nfor event_id, image, target_image, details, message in rows:\n    # Extract source and target GUIDs from message if they are there\n    # or check if the process images match\n    is_rel = False\n    for g in malicious_guids:\n        if g in message:\n            is_rel = True\n            break\n    if is_rel:\n        # check if it is in our list of candidate process accesses\n        # Our candidates were: evt-00544, evt-00595, evt-00611, evt-00856, evt-00857\n        # Wait, let's print all of them so we can see if there are others!\n        print(f\"{event_id} | Src: {image} | Target: {target_image} | Msg: {message[:120].strip().replace('\\n', ' ')}\")\n\nEOF\npython3 inspect_access.py\n"]
