[282.525105, "i", "cat << 'EOF' > inspect_others.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's check Event ID 9, 11, 22 first\nprint(\"=== EVENT CODE 9 ===\")\ncur.execute(\"SELECT event_id, image, message FROM events WHERE host='WS-05.corp.example' AND event_code=9;\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2][:150].strip().replace('\\n', ' ')}\")\n\nprint(\"=== EVENT CODE 11 ===\")\ncur.execute(\"SELECT event_id, image, message FROM events WHERE host='WS-05.corp.example' AND event_code=11 AND event_id != 'evt-00088';\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2][:150].strip().replace('\\n', ' ')}\")\n\nprint(\"=== EVENT CODE 22 ===\")\ncur.execute(\"SELECT event_id, image, message FROM events WHERE host='WS-05.corp.example' AND event_code=22 AND event_id != 'evt-00863';\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2][:150].strip().replace('\\n', ' ')}\")\n\nEOF\npython3 inspect_others.py\n"]
