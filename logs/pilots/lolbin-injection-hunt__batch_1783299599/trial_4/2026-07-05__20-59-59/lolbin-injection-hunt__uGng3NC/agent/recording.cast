[235.065649, "i", "python3 -c \"\nlines = open('full_timeline.txt').readlines()[1:]\nimages = {}\nfor l in lines:\n    parts = l.strip().split(' | ')\n    for p in parts:\n        if p.startswith('Image:'):\n            img = p.split('Image: ')[1]\n            images[img] = images.get(img, 0) + 1\nfor img, count in sorted(images.items(), key=lambda x: x[1], reverse=True):\n    print(f'{count} | {img}')\n\"\n"]
