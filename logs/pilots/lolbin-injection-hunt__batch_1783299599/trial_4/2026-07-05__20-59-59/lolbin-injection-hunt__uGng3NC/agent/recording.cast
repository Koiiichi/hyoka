[189.612009, "o", "    pids = ['2368', '3356', '3148', '6208', '260']\r\n\u001b[?2004l\r\u001b[?2004h>     matched = False\r\n\u001b[?2004l\r\u001b[?2004h>     for p in pids:\r\n\u001b[?2004l\r\u001b[?2004h>         if p in message or f\"0x{int(p):x}\" in message or f\"0x{int(p):x}\".upper() in message:\r\n\u001b[?2004l\r\u001b[?2004h>             matched = True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>     if matched:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"{event_id} | {event_code}\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
