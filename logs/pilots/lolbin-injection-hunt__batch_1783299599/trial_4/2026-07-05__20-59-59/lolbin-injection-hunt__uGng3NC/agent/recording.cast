[185.363475, "i", "cat << 'EOF' > find_wfp.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (5156, 5158) ORDER BY timestamp;\")\nrows = cur.fetchall()\n\nfor event_id, event_code, message in rows:\n    if \"2368\" in message or \"3356\" in message or \"3148\" in message or \"6208\" in message:\n        print(f\"{event_id} | {event_code} | {message[:120].strip().replace('\\n', ' ')}\")\n\nEOF\npython3 find_wfp.py\n"]
[185.363968, "o", "cat << 'EOF' > find_wfp.py\r\n\u001b[?2004l\r"]
[185.364007, "o", "\u001b[?2004h> "]
[185.36417, "o", "import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[185.365264, "o", "> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (5156, 5158) ORDER BY timestamp;\")\r\n\u001b[?2004l\r\u001b[?2004h> rows = cur.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for event_id, event_code, message in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     if \"2368\" in message or \"3356\" in message or \"3148\" in message or \"6208\" in message:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"{event_id} | {event_code} | {message[:120].strip().replace('\\n', ' ')}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
