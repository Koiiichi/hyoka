[230.999892, "i", "cat << 'EOF' > get_all_timeline.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Query all events on WS-05 between 00:01:49 and 00:02:05\ncur.execute(\"\"\"\nSELECT event_id, event_code, timestamp, image, parent_image, target_image, command_line, details, target_object, message \nFROM events \nWHERE host='WS-05.corp.example' \n  AND timestamp >= '2026-05-06T00:01:49.000Z'\n  AND timestamp <= '2026-05-06T00:02:05.000Z'\nORDER BY timestamp;\n\"\"\")\nrows = cur.fetchall()\n\nprint(f\"Total events in this window: {len(rows)}\")\nfor r in rows:\n    event_id, event_code, timestamp, image, parent_image, target_image, command_line, details, target_object, message = r\n    # Summarize\n    p_info = f\"Image: {image or ''} | Parent: {parent_image or ''} | TargetImg: {target_image or ''}\"\n    c_info = f\"Cmd: {command_line or ''}\"\n    t_info = f\"TargetObj: {target_object or ''}\"\n    print(f\"{event_id} | Code: {event_code} | Time: {timestamp} | {p_info} | {c_info} | {t_info}\")\n\nEOF\npython3 get_all_timeline.py > full_timeline.txt\nwc -l full_timeline.txt\n"]
[231.001338, "o", "cat << 'EOF' > get_all_timeline.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Query all events on WS-05 between 00:01:49 and 00:02:05\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> SELECT event_id, event_code, timestamp, image, parent_image, target_image, command_line, details, target_object, message \r\n\u001b[?2004l\r\u001b[?2004h> FROM events \r\n\u001b[?2004l\r\u001b[?2004h> WHERE host='WS-05.corp.example' \r\n\u001b[?2004l\r\u001b[?2004h>   AND timestamp >= '2026-05-06T00:01:49.000Z'\r\n\u001b[?2004l\r\u001b[?2004h>   AND timestamp <= '2026-05-06T00:02:05.000Z'\r\n\u001b[?2004l\r\u001b[?2004h> ORDER BY timestamp;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> rows = cur.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total events in this window: {len(rows)}\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     event_id, event_code, timestamp, image, parent_image, target_image, command_line, details, target_object, message = r\r\n\u001b[?2004l\r\u001b[?2004h>     # Summarize\r\n\u001b[?2004l\r\u001b[?2004h>     p_info = f\"Image: {image or ''} | Parent: {parent_image or ''} | TargetImg: {target_image or ''}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.001373, "o", "    c_info = f\"Cmd: {command_line or ''}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.001445, "o", "    t_info = f\"TargetObj: {target_object or ''}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.001549, "o", "    print(f\"{event_id} | Code: {event_code} | Time: {timestamp} | {p_info} | {c_info} | {t_info}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
