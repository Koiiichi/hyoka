[?2004hroot@751658dfcbab:~# cat << 'EOF' > /root/union_malicious.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, event_code, host, user, image, target_image, message FROM events WHERE host='WS-05.corp.example'")
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> mal_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> # PIDs we know are malicious:
[?2004l[?2004h> # 1648 (decimal) = 0x670 (hex) -> powershell.exe
[?2004l[?2004h> # 6504 (decimal) = 0x1968 (hex) -> whoami.exe
[?2004l[?2004h> 
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     eid = r['event_id']
[?2004l[?2004h>     code = r['event_code']
[?2004l[?2004h>     user = (r['user'] if r['user'] else "").lower()
[?2004l[?2004h>     msg = r['message']
[?2004l[?2004h>     msg_lower = msg.lower()
[?2004l[?2004h>     img = (r['image'] if r['image'] else "").lower()
[?2004l[?2004h>     timg = (r['target_image'] if r['target_image'] else "").lower()
[?2004l[?2004h>     
[?2004l[?2004h>     is_mal = False
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. PowerShell execution
[?2004l[?2004h>     if code in (400, 600, 800, 4103):
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 2. User pgustavo / Logon ID 0x2BA622
[?2004l[?2004h>     elif 'pgustavo' in user or 'pgustavo' in msg_lower or '0x2ba622' in msg_lower or '2860578' in msg_lower:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Process GUIDs
[?2004l[?2004h>     elif '{297bc33e-65d0-5f2d-8207-000000000400}' in msg: # powershell
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>     elif '{297bc33e-660d-5f2d-8407-000000000400}' in msg: # whoami
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 4. Process IDs
[?2004l[?2004h>     elif '1648' in msg or '6504' in msg or '0x670' in msg or '0x1968' in msg:
[?2004l[?2004h>         # Let's ensure it's not a false positive with another string
[?2004l[?2004h>         # Usually PID appears in 'Process ID: 1648' or 'Process ID:\t1648' or 'ProcessID: 1648' or '0x670' or '0x1968'
[?2004l[?2004h>         # We can just look for the PID or hex PID in the msg.
[?2004l[?2004h>         # Since 1648, 6504, 0x670, 0x1968 are very specific, any occurrence in the log on WS-05 is almost certainly our malicious processes.
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 5. Prefetch WHOAMI.EXE
[?2004l[?2004h>     elif eid == 'evt-00389':
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h> 
[?2004l[?2004h>     if is_mal:
[?2004l[?2004h>         # Ensure we filter out standard benign services if they somehow matched
[?2004l[?2004h>         # (e.g. if we had a svchost or Azure agent that somehow had those numbers, which is extremely unlikely)
[?2004l[?2004h>         if 'windowsazureguestagent' in msg_lower or 'networkwatcheragent' in msg_lower:
[?2004l[?2004h>             is_mal = False
[?2004l[?2004h>             
[?2004l[?2004h>         if is_mal:
[?2004l[?2004h>             mal_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total WS-05 events: {len(rows)}")
[?2004l[?2004h> print(f"Union Malicious events: {len(mal_ids)}")
[?2004l[?2004h> print(f"Benign events: {len(rows) - len(mal_ids)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save to /root/findings.json
[?2004l[?2004h> with open('/root/findings.json', 'w') as f:
[?2004l[?2004h>     json.dump(sorted(list(mal_ids)), f)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@751658dfcbab:~# python3 /root/union_malicious.py
[?2004lTotal WS-05 events: 5188
Union Malicious events: 4871
Benign events: 317
[?2004hroot@751658dfcbab:~# cat << 'EOF' > /root/inspect_final_benign.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
