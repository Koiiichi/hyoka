[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, user, image, target_image, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host='WS-05.corp.example' 
[?2004l[?2004h>       AND event_code NOT IN (800, 4103) 
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> other_events = []
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     img = r['image'] if r['image'] else ""
[?2004l[?2004h>     timg = r['target_image'] if r['target_image'] else ""
[?2004l[?2004h>     
[?2004l[?2004h>     # filter out known benign background
[?2004l[?2004h>     if any(p in img.lower() or p in timg.lower() for p in (
[?2004l[?2004h>         'networkwatcheragent', 'waagent', 'telemetry', 'healthservice', 
[?2004l[?2004h>         'monitoringhost', 'omajadm', 'taskhostw', 'searchindexer', 
[?2004l[?2004h>         'softwareprotectionplatform', 'lsass', 'csrss', 'wininit', 
[?2004l[?2004h>         'services.exe', 'smss', 'winlogon', 'spoolsv', 'sgrmbroker', 
[?2004l[?2004h>         'svchost.exe', 'registry', 'msmpeng', 'nacl', 'conhost.exe'
[?2004l[?2004h>     )):
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     if 'powershell' not in img.lower() and 'powershell' not in timg.lower() and 'whoami' not in img.lower():
[?2004l[?2004h>         other_events.append(r)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(other_events)} events that do not match powershell or whoami:")
