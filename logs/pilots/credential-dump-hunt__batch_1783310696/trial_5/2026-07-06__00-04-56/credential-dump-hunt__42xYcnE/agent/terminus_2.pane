[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Query for any event on DC01 or WS-06 that involves the pgustavo user
[?2004l[?2004h> print("=== pgustavo on DC01 or WS-06 ===")
[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, host, event_code, user, image, message FROM events WHERE host IN ('DC01.corp.example', 'WS-06.corp.example') AND message LIKE '%pgustavo%'")
