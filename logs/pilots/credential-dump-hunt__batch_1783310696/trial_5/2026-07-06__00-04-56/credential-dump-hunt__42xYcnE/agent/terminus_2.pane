[?2004l[?2004h>     app_match = re.search(r'Application Name:\s*(.*)', msg)
[?2004l[?2004h>     if app_match: app_name = app_match.group(1).strip()
[?2004l[?2004h>     
[?2004l[?2004h>     dir_match = re.search(r'Direction:\s*(.*)', msg)
[?2004l[?2004h>     if dir_match: direction = dir_match.group(1).strip()
[?2004l[?2004h>     
[?2004l[?2004h>     src_match = re.search(r'Source Address:\s*(\S+)', msg)
