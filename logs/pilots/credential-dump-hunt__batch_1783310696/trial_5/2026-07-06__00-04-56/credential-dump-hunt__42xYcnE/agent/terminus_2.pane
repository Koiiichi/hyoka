[?2004hroot@751658dfcbab:~# cat << 'EOF' > /root/classify_all_ws05.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, user, image, target_image, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host='WS-05.corp.example'
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> print(f"Total WS-05 events: {len(rows)}")
[?2004l[?2004h> 
[?2004l[?2004h> malicious = []
[?2004l[?2004h> benign = []
[?2004l[?2004h> 
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     msg = r['message']
[?2004l[?2004h>     msg_lower = msg.lower()
[?2004l[?2004h>     img = (r['image'] if r['image'] else "").lower()
[?2004l[?2004h>     timg = (r['target_image'] if r['target_image'] else "").lower()
[?2004l[?2004h>     code = r['event_code']
[?2004l[?2004h>     
[?2004l[?2004h>     # Criteria for malicious
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. PowerShell execution events
[?2004l[?2004h>     if code in (800, 4103, 400, 600):
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 2. Associated with pgustavo / Logon ID 0x2BA622
[?2004l[?2004h>     elif 'pgustavo' in r['user'].lower() or 'pgustavo' in msg_lower or '0x2ba622' in msg_lower or '2860578' in msg_lower:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Associated with process_guid {297bc33e-65d0-5f2d-8207-000000000400} (PowerShell PID 1648)
[?2004l[?2004h>     elif '{297bc33e-65d0-5f2d-8207-000000000400}' in msg:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 4. Associated with PID 1648 (WFP 5156/5158)
[?2004l[?2004h>     elif code in (5156, 5158) and '1648' in msg:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         malicious.append(r)
[?2004l[?2004h>     else:
[?2004l[?2004h>         benign.append(r)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Malicious: {len(malicious)}")
[?2004l[?2004h> print(f"Benign: {len(benign)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect some of the 'Benign' ones to see if any are false negatives
[?2004l[?2004h> print("\n--- Sample Benign Events ---")
[?2004l[?2004h> for r in benign[:30]:
[?2004l[?2004h>     print(f"{r['event_id']} | {r['timestamp']} | Code {r['event_code']} | User {r['user']} | Image {r['image']} | Target {r['target_image']}")
[?2004l[?2004h> 
