[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, event_code, user, image, target_image, message FROM events WHERE host='WS-05.corp.example' ORDER BY timestamp")
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> final_benign = []
