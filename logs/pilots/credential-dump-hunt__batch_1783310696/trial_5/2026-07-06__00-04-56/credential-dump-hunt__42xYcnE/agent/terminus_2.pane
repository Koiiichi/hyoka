[?2004l[?2004h> cur.execute("SELECT event_id, event_code, user, image, target_image, message FROM events WHERE host='WS-05.corp.example'")
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> malicious_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     eid = r['event_id']
[?2004l[?2004h>     code = r['event_code']
[?2004l[?2004h>     user = (r['user'] if r['user'] else "").lower()
[?2004l[?2004h>     img = (r['image'] if r['image'] else "").lower()
[?2004l[?2004h>     timg = (r['target_image'] if r['target_image'] else "").lower()
[?2004l[?2004h>     msg = r['message']
[?2004l[?2004h>     msg_lower = msg.lower()
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. PowerShell execution events
[?2004l[?2004h>     if code in (400, 600, 800, 4103):
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 2. Associated with pgustavo / Logon ID 0x2BA622
[?2004l[?2004h>     if 'pgustavo' in user or 'pgustavo' in msg_lower or '0x2ba622' in msg_lower or '2860578' in msg_lower:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Associated with PowerShell process_guid
[?2004l[?2004h>     if '{297bc33e-65d0-5f2d-8207-000000000400}' in msg:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 4. Associated with whoami process_guid
[?2004l[?2004h>     if '{297bc33e-660d-5f2d-8407-000000000400}' in msg:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 5. Associated with PID 1648 (powershell) or 6504 (whoami)
[?2004l[?2004h>     # Check if 'Process ID: 1648' or 'Process ID: 6504' is in message
[?2004l[?2004h>     # Also hex versions: 0x670, 0x1968
[?2004l[?2004h>     if any(pid_str in msg for pid_str in ('Process ID:1648', 'Process ID:6504', 'Process ID: 1648', 'Process ID: 6504', 'Process ID:0x670', 'Process ID:0x1968', 'Source Process ID:0x670', 'Source Process ID:0x1968')):
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 6. Prefetch creation of WHOAMI.EXE
[?2004l[?2004h>     if eid == 'evt-00389':
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Compiled {len(malicious_ids)} malicious event IDs.")
[?2004l[?2004h> 
[?2004l[?2004h> # Write to json file
