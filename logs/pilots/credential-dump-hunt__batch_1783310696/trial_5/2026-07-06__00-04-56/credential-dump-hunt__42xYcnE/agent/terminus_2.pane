[?2004hroot@751658dfcbab:~# cat << 'EOF' > /root/sequence.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, host, event_code, user, image, target_image, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE timestamp BETWEEN '2026-05-06T14:32:20Z' AND '2026-05-06T14:33:00Z' 
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> print(f"Total events in window: {len(rows)}")
[?2004l[?2004h> with open('/root/sequence.txt', 'w') as f:
[?2004l[?2004h>     for r in rows:
[?2004l[?2004h>         # Simple clean up of message
[?2004l[?2004h>         msg_clean = r['message'].replace('\n', ' | ').replace('\r', '')[:200]
[?2004l[?2004h>         f.write(f"{r['event_id']} | {r['timestamp']} | {r['host']} | Code {r['event_code']} | User {r['user']} | Image {r['image']} | Target {r['target_image']} | {msg_clean}\n")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@751658dfcbab:~# python3 /root/sequence.py
[?2004lTotal events in window: 3048
