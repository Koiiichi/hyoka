[?2004hroot@751658dfcbab:~# cat << 'EOF' > /root/verify_non_powershell_v2.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, user, image, target_image, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host='WS-05.corp.example' 
[?2004l[?2004h>       AND event_code NOT IN (800, 4103) 
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> other_events = []
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     msg = r['message'].lower()
[?2004l[?2004h>     img = (r['image'] if r['image'] else "").lower()
[?2004l[?2004h>     timg = (r['target_image'] if r['target_image'] else "").lower()
[?2004l[?2004h>     
[?2004l[?2004h>     # check if powershell or whoami is involved
[?2004l[?2004h>     if 'powershell' in img or 'powershell' in timg or 'powershell' in msg:
[?2004l[?2004h>         continue
[?2004l[?2004h>     if 'whoami' in img or 'whoami' in timg or 'whoami' in msg:
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # known background processes
[?2004l[?2004h>     if any(p in img or p in timg or p in msg for p in (
[?2004l[?2004h>         'networkwatcheragent', 'waagent', 'telemetry', 'healthservice', 
[?2004l[?2004h>         'monitoringhost', 'omajadm', 'taskhostw', 'searchindexer', 
[?2004l[?2004h>         'softwareprotectionplatform', 'lsass.exe', 'csrss.exe', 'wininit.exe', 
[?2004l[?2004h>         'services.exe', 'smss.exe', 'winlogon.exe', 'spoolsv.exe', 'sgrmbroker.exe', 
[?2004l[?2004h>         'svchost.exe', 'registry', 'msmpeng.exe', 'nacl.exe', 'conhost.exe', 'explorer.exe',
[?2004l[?2004h>         'mpcmdrun.exe', 'sppsvc.exe', 'gpsvc', 'system'
[?2004l[?2004h>     )):
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     other_events.append(r)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(other_events)} unique non-powershell, non-whoami events on WS-05:")
[?2004l[?2004h> for r in other_events:
[?2004l[?2004h>     print(f"{r['event_id']} | {r['timestamp']} | Code {r['event_code']} | User {r['user']} | Img {r['image']} | Timg {r['target_image']}")
[?2004l[?2004h> 
