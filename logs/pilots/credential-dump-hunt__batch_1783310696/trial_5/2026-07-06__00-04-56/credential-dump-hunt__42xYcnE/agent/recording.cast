[227.945806, "o", "    # 2. Associated with pgustavo / Logon ID 0x2BA622\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.945956, "o", "    if 'pgustavo' in user or 'pgustavo' in msg_lower or '0x2ba622' in msg_lower or '2860578' in msg_lower:\r\n\u001b[?2004l\r\u001b[?2004h> "]
