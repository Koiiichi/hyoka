[153.378654, "o", "\u001b[?2004hroot@751658dfcbab:~# "]
[157.481277, "i", "cat << 'EOF' > /root/get_pgustavo_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, image, message \n    FROM events \n    WHERE host='WS-05.corp.example'\n      AND (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%' OR message LIKE '%0x2BA622%' OR message LIKE '%2860578%')\n    ORDER BY timestamp\n\"\"\")\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} events on WS-05 matching user/logon ID.\")\n\nwith open('/root/pgustavo_events_list.txt', 'w') as f:\n    for r in rows:\n        f.write(f\"{r['event_id']} | {r['timestamp']} | Code {r['event_code']} | User {r['user']} | Image {r['image']}\\n\")\n\nEOF\npython3 /root/get_pgustavo_events.py\n"]
