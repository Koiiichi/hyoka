[21.299862, "i", "cat << 'EOF' > /root/analyze.py\nimport sqlite3\nimport base64\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Get parent command line of evt-00282\ncur.execute(\"SELECT message FROM events WHERE event_id='evt-00282'\")\nrow = cur.fetchone()\nmessage = row['message']\nprint(\"evt-00282 message:\")\nprint(message)\n\n# Extract encoded command\nmatch = re.search(r'-enc\\s+([A-Za-z0-9+/=]+)', message)\nif match:\n    enc_cmd = match.group(1)\n    try:\n        dec_cmd = base64.b64decode(enc_cmd).decode('utf-16le', errors='ignore')\n        print(\"\\nDecoded command:\")\n        print(dec_cmd)\n    except Exception as e:\n        print(\"Error decoding:\", e)\nelse:\n    print(\"No encoded command found in evt-00282\")\n\nEOF\npython3 /root/analyze.py\n"]
