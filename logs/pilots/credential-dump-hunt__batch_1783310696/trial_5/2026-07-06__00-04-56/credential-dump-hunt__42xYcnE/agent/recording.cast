[26.680907, "i", "cat << 'EOF' > /root/analyze.py\nimport sqlite3\nimport base64\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT message FROM events WHERE event_id='evt-00282'\")\nrow = cur.fetchone()\nmessage = row['message']\n\n# Extract base64. The base64 might contain newlines if wrapped.\nlines = message.split('\\n')\nenc_lines = []\nstarted = False\nfor line in lines:\n    if 'ParentCommandLine' in line or started:\n        started = True\n        # extract everything after -enc or just collect base64 characters\n        match = re.search(r'-enc\\s+(.*)', line)\n        if match:\n            enc_lines.append(match.group(1).strip())\n        elif line.startswith(' '):\n            enc_lines.append(line.strip())\n        elif len(line) > 0 and not line.startswith('Parent'):\n            # This could be wrapped base64 line\n            # We can check if it contains base64-like characters\n            cleaned = line.strip()\n            if re.match(r'^[A-Za-z0-9+/=]+$', cleaned):\n                enc_lines.append(cleaned)\n            else:\n                # Stop if it doesn't look like base64\n                if len(enc_lines) > 0:\n                    break\n\nenc_cmd = \"\".join(enc_lines)\nprint(\"Extracted enc_cmd:\", enc_cmd[:100], \"... len:\", len(enc_cmd))\n\n# Pad base64 if needed\nwhile len(enc_cmd) % 4 != 0:\n    enc_cmd += '='\n\ntry:\n    dec_cmd = base64.b64decode(enc_cmd).decode('utf-16le', errors='ignore')\n    print(\"\\nDecoded command:\")\n    print(dec_cmd[:1000])\nexcept Exception as e:\n    print(\"Error:\", e)\nEOF\npython3 /root/analyze.py\n"]
