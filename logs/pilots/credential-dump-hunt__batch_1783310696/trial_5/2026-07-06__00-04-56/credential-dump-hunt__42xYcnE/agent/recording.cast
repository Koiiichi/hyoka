[79.82299, "o", "\u001b[?2004hroot@751658dfcbab:~# "]
[87.005762, "i", "cat << 'EOF' > /root/sequence.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, host, event_code, user, image, target_image, message \n    FROM events \n    WHERE timestamp BETWEEN '2026-05-06T14:32:20Z' AND '2026-05-06T14:33:00Z' \n    ORDER BY timestamp\n\"\"\")\nrows = cur.fetchall()\nprint(f\"Total events in window: {len(rows)}\")\nwith open('/root/sequence.txt', 'w') as f:\n    for r in rows:\n        # Simple clean up of message\n        msg_clean = r['message'].replace('\\n', ' | ').replace('\\r', '')[:200]\n        f.write(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | Code {r['event_code']} | User {r['user']} | Image {r['image']} | Target {r['target_image']} | {msg_clean}\\n\")\n\nEOF\npython3 /root/sequence.py\n"]
[87.006052, "o", "cat << 'EOF' > /root/sequence.py\r\n\u001b[?2004l\r"]
[87.006096, "o", "\u001b[?2004h> "]
