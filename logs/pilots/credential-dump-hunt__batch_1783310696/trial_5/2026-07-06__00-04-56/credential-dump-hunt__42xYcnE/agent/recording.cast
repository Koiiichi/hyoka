[51.797875, "o", "\u001b[?2004hroot@751658dfcbab:~# "]
[55.730346, "i", "cat << 'EOF' > /root/network_summary.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"--- NETWORK CONNECTIONS BY HOST ---\")\n# Event 3 is Sysmon Network Connection, 5156/5158 is Windows Security Filtering Platform\ncur.execute(\"SELECT host, event_code, image, src_ip, dst_ip, dst_port, COUNT(*) as c FROM events WHERE event_code IN (3, 5156, 5158) GROUP BY host, event_code, image, src_ip, dst_ip, dst_port ORDER BY host, c DESC\")\nfor r in cur.fetchall():\n    print(f\"{r['host']} | Code {r['event_code']} | Image {r['image']} | Src {r['src_ip']} -> Dst {r['dst_ip']}:{r['dst_port']} | Count {r['c']}\")\n\nEOF\npython3 /root/network_summary.py\n"]
[55.730777, "o", "cat << 'EOF' > /root/network_summary.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h"]
