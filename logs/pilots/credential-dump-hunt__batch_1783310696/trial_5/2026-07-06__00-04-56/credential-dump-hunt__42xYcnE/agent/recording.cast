[161.158575, "i", "cat << 'EOF' > /root/categorize_pgustavo.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_code, COUNT(*) as c\n    FROM events \n    WHERE host='WS-05.corp.example'\n      AND (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%' OR message LIKE '%0x2BA622%' OR message LIKE '%2860578%')\n    GROUP BY event_code\n    ORDER BY c DESC\n\"\"\")\nfor r in cur.fetchall():\n    print(f\"EventCode: {r['event_code']} | Count: {r['c']}\")\n\nEOF\npython3 /root/categorize_pgustavo.py\n"]
