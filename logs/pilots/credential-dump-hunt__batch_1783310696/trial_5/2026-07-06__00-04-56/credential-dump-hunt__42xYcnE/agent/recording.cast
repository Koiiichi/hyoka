[69.753676, "i", "cat << 'EOF' > /root/examine_hosts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nfor host in ('DC01.corp.example', 'WS-06.corp.example'):\n    print(f\"\\n=== {host} ===\")\n    cur.execute(\"SELECT event_code, COUNT(*) as c FROM events WHERE host=? GROUP BY event_code ORDER BY c DESC\", (host,))\n    for r in cur.fetchall():\n        print(f\"  Code {r['event_code']}: {r['c']} events\")\n\nEOF\npython3 /root/examine_hosts.py\n"]
[69.754061, "o", "cat << 'EOF' > /root/examine_hosts.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
