[214.780008, "i", "cat << 'EOF' > /root/check_any_other_suspicious.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Any event 3 on WS-05 that is not to 10.10.10.5?\nprint(\"=== Event 3 on WS-05 NOT to 10.10.10.5 ===\")\ncur.execute(\"SELECT event_id, dst_ip, dst_port, image FROM events WHERE host='WS-05.corp.example' AND event_code=3 AND dst_ip != '10.10.10.5'\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['dst_ip']}:{r['dst_port']} | {r['image']}\")\n\n# Any Event 1 on WS-05?\nprint(\"\\n=== Event 1 on WS-05 ===\")\ncur.execute(\"SELECT event_id, image, message FROM events WHERE host='WS-05.corp.example' AND event_code=1\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['image']}\")\n\n# Any Event 11 (File creation) on WS-05?\nprint(\"\\n=== Event 11 on WS-05 ===\")\ncur.execute(\"SELECT event_id, image, message FROM events WHERE host='WS-05.corp.example' AND event_code=11\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['image']} | {r['message'][:200].replace('\\n', ' ')}\")\n\nEOF\npython3 /root/check_any_other_suspicious.py\n"]
