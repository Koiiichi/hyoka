[131.79014, "o", "\u001b[?2004hroot@751658dfcbab:~# "]
[136.325901, "i", "cat << 'EOF' > /root/verify_non_powershell.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, target_image, message \n    FROM events \n    WHERE host='WS-05.corp.example' \n      AND event_code NOT IN (800, 4103) \n    ORDER BY timestamp\n\"\"\")\n\nother_events = []\nfor r in cur.fetchall():\n    img = r['image'] if r['image'] else \"\"\n    timg = r['target_image'] if r['target_image'] else \"\"\n    \n    # filter out known benign background\n    if any(p in img.lower() or p in timg.lower() for p in (\n        'networkwatcheragent', 'waagent', 'telemetry', 'healthservice', \n        'monitoringhost', 'omajadm', 'taskhostw', 'searchindexer', \n        'softwareprotectionplatform', 'lsass', 'csrss', 'wininit', \n        'services.exe', 'smss', 'winlogon', 'spoolsv', 'sgrmbroker', \n        'svchost.exe', 'registry', 'msmpeng', 'nacl', 'conhost.exe'\n    )):\n        continue\n        \n    if 'powershell' not in img.lower() and 'powershell' not in timg.lower() and 'whoami' not in img.lower():\n        other_events.append(r)\n\nprint(f\"Found {len(other_events)} events that do not match powershell or whoami:\")\nfor r in other_events:\n    print(f\"{r['event_id']} | {r['timestamp']} | Code {r['event_code']} | User {r['user']} | Img {r['image']} | Timg {r['target_image']}\")\n\nEOF\npython3 /root/verify_non_powershell.py\n"]
[136.327217, "o", "cat << 'EOF' > /root/verify_non_powershell.py\r\n\u001b[?2004l\r"]
