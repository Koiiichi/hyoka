[227.946464, "o", "    if '{297bc33e-660d-5f2d-8407-000000000400}' in msg:\r\n\u001b[?2004l\r"]
[227.94648, "o", "\u001b[?2004h> "]
[227.946546, "o", "        malicious_ids.add(eid)\r\n\u001b[?2004l\r"]
[227.946556, "o", "\u001b[?2004h> "]
