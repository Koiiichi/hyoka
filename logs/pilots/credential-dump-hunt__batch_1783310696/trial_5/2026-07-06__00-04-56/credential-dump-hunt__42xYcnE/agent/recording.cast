[185.660273, "i", "cat << 'EOF' > /root/classify_all_ws05.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, target_image, message \n    FROM events \n    WHERE host='WS-05.corp.example'\n    ORDER BY timestamp\n\"\"\")\nrows = cur.fetchall()\nprint(f\"Total WS-05 events: {len(rows)}\")\n\nmalicious = []\nbenign = []\n\nfor r in rows:\n    msg = r['message']\n    msg_lower = msg.lower()\n    img = (r['image'] if r['image'] else \"\").lower()\n    timg = (r['target_image'] if r['target_image'] else \"\").lower()\n    code = r['event_code']\n    \n    # Criteria for malicious\n    is_malicious = False\n    \n    # 1. PowerShell execution events\n    if code in (800, 4103, 400, 600):\n        is_malicious = True\n        \n    # 2. Associated with pgustavo / Logon ID 0x2BA622\n    elif 'pgustavo' in r['user'].lower() or 'pgustavo' in msg_lower or '0x2ba622' in msg_lower or '2860578' in msg_lower:\n        is_malicious = True\n        \n    # 3. Associated with process_guid {297bc33e-65d0-5f2d-8207-000000000400} (PowerShell PID 1648)\n    elif '{297bc33e-65d0-5f2d-8207-000000000400}' in msg:\n        is_malicious = True\n        \n    # 4. Associated with PID 1648 (WFP 5156/5158)\n    elif code in (5156, 5158) and '1648' in msg:\n        is_malicious = True\n        \n    if is_malicious:\n        malicious.append(r)\n    else:\n        benign.append(r)\n\nprint(f\"Malicious: {len(malicious)}\")\nprint(f\"Benign: {len(benign)}\")\n\n# Let's inspect some of the 'Benign' ones to see if any are false negatives\nprint(\"\\n--- Sample Benign Events ---\")\nfor r in benign[:30]:\n    print(f\"{r['event_id']} | {r['timestamp']} | Code {r['event_code']} | User {r['user']} | Image {r['image']} | Target {r['target_image']}\")\n\nEOF\npython3 /root/classify_all_ws05.py\n"]
[185.660497, "o", "cat << 'EOF' > /root/classify_all_ws05.py\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.660696, "o", "> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
