[115.837581, "i", "cat << 'EOF' > /root/check_other_hosts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Query for any event on DC01 or WS-06 that involves the pgustavo user\nprint(\"=== pgustavo on DC01 or WS-06 ===\")\ncur.execute(\"SELECT event_id, timestamp, host, event_code, user, image, message FROM events WHERE host IN ('DC01.corp.example', 'WS-06.corp.example') AND message LIKE '%pgustavo%'\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | Code {r['event_code']} | User {r['user']} | Image {r['image']}\")\n\n# Query for WMI / DSC events on DC01 or WS-06\nprint(\"\\n=== WMI / DSC events ===\")\ncur.execute(\"SELECT event_id, timestamp, host, event_code, user, image, message FROM events WHERE message LIKE '%DSCEngineCache%' OR message LIKE '%Wmi%' OR event_code=5857\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | Code {r['event_code']} | User {r['user']} | Image {r['image']}\")\n\n# Query for any network connection or security event from WS-05 (172.18.39.5) to DC01 or WS-06\nprint(\"\\n=== Inbound from WS-05 (172.18.39.5) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, event_code, message FROM events WHERE message LIKE '%172.18.39.5%'\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | Code {r['event_code']}\")\n    for line in r['message'].split('\\n'):\n        if any(k in line for k in ('Source Address:', 'Source Network Address:', 'Account Name:', 'Application Name:', 'CommandLine')):\n            print(\"  \", line.strip())\n\nEOF\npython3 /root/check_other_hosts.py\n"]
[115.840529, "o", "cat << 'EOF' > /root/check_other_hosts.py\r\n"]
[115.84062, "o", "\u001b[?2004l\r"]
