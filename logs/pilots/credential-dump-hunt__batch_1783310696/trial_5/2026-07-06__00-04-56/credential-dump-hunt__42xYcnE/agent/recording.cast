[153.329395, "i", "cat << 'EOF' > /root/get_pgustavo_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, message \n    FROM events \n    WHERE host='WS-05.corp.example' \n      AND (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%' OR message LIKE '%0x2BA622%' OR message LIKE '%2860578%')\n    ORDER BY timestamp\n\"\"\")\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} events associated with user pgustavo / LogonID 0x2BA622 on WS-05:\")\nfor r in rows:\n    print(f\"{r['event_id']} | {r['timestamp']} | Code {r['event_code']} | User {r['user']} | Image {r['image']}\")\n\nEOF\npython3 /root/get_pgustavo_events.py\n"]
