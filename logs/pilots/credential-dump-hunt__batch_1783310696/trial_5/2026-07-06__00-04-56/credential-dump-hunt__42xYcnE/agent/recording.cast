[45.673217, "i", "cat << 'EOF' > /root/search_guid.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nparent_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\ncur.execute(\"SELECT event_id, timestamp, event_code, host, image, target_image, process_guid, message FROM events WHERE process_guid=? OR message LIKE ?\", (parent_guid, f\"%{parent_guid}%\"))\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} events matching the powershell parent process guid {parent_guid}:\")\nfor r in rows[:20]:\n    print(f\"{r['event_id']} | {r['timestamp']} | EventCode {r['event_code']} | Host {r['host']} | Image {r['image']}\")\n\nEOF\npython3 /root/search_guid.py\n"]
