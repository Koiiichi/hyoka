[246.473028, "i", "cat << 'EOF' > /root/union_malicious.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, timestamp, event_code, host, user, image, target_image, message FROM events WHERE host='WS-05.corp.example'\")\nrows = cur.fetchall()\n\nmal_ids = set()\n\n# PIDs we know are malicious:\n# 1648 (decimal) = 0x670 (hex) -> powershell.exe\n# 6504 (decimal) = 0x1968 (hex) -> whoami.exe\n\nfor r in rows:\n    eid = r['event_id']\n    code = r['event_code']\n    user = (r['user'] if r['user'] else \"\").lower()\n    msg = r['message']\n    msg_lower = msg.lower()\n    img = (r['image'] if r['image'] else \"\").lower()\n    timg = (r['target_image'] if r['target_image'] else \"\").lower()\n    \n    is_mal = False\n    \n    # 1. PowerShell execution\n    if code in (400, 600, 800, 4103):\n        is_mal = True\n        \n    # 2. User pgustavo / Logon ID 0x2BA622\n    elif 'pgustavo' in user or 'pgustavo' in msg_lower or '0x2ba622' in msg_lower or '2860578' in msg_lower:\n        is_mal = True\n        \n    # 3. Process GUIDs\n    elif '{297bc33e-65d0-5f2d-8207-000000000400}' in msg: # powershell\n        is_mal = True\n    elif '{297bc33e-660d-5f2d-8407-000000000400}' in msg: # whoami\n        is_mal = True\n        \n    # 4. Process IDs\n    elif '1648' in msg or '6504' in msg or '0x670' in msg or '0x1968' in msg:\n        # Let's ensure it's not a false positive with another string\n        # Usually PID appears in 'Process ID: 1648' or 'Process ID:\\t1648' or 'ProcessID: 1648' or '0x670' or '0x1968'\n        # We can just look for the PID or hex PID in the msg.\n        # Since 1648, 6504, 0x670, 0x1968 are very specific, any occurrence in the log on WS-05 is almost certainly our malicious processes.\n        is_mal = True\n        \n    # 5. Prefetch WHOAMI.EXE\n    elif eid == 'evt-00389':\n        is_mal = True\n\n    if is_mal:\n        # Ensure we filter out standard benign services if they somehow matched\n        # (e.g. if we had a svchost or Azure agent that somehow had those numbers, which is extremely unlikely)\n        if 'windowsazureguestagent' in msg_lower or 'networkwatcheragent' in msg_lower:\n            is_mal = False\n            \n        if is_mal:\n            mal_ids.add(eid)\n\nprint(f\"Total WS-05 events: {len(rows)}\")\nprint(f\"Union Malicious events: {len(mal_ids)}\")\nprint(f\"Benign events: {len(rows) - len(mal_ids)}\")\n\n# Save to /root/findings.json\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(mal_ids)), f)\n\nEOF\npython3 /root/union_malicious.py\n"]
