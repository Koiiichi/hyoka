[104.748452, "i", "cat << 'EOF' > /root/powershell_timeframe.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT MIN(timestamp), MAX(timestamp), COUNT(*), event_code\n    FROM events \n    WHERE host='WS-05.corp.example' \n      AND event_code IN (800, 4103) \n    GROUP BY event_code\n\"\"\")\nfor r in cur.fetchall():\n    print(f\"EventCode: {r['event_code']} | Count: {r['COUNT(*)']} | MinTime: {r['MIN(timestamp)']} | MaxTime: {r['MAX(timestamp)']}\")\n\n# Let's check the commands inside some of them\nprint(\"\\n--- Sample command lines from Code 800 ---\")\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, message \n    FROM events \n    WHERE host='WS-05.corp.example' \n      AND event_code=800 \n    LIMIT 20\n\"\"\")\nfor r in cur.fetchall():\n    # extract command line from message\n    for line in r['message'].split('\\n'):\n        if 'command line:' in line.lower() or 'commandline:' in line.lower():\n            print(f\"{r['event_id']} | {r['timestamp']} | {line.strip()}\")\n\nEOF\npython3 /root/powershell_timeframe.py\n"]
[104.748903, "o", "cat << 'EOF' > /root/powershell_timeframe.py\r\n\u001b[?2004l\r"]
