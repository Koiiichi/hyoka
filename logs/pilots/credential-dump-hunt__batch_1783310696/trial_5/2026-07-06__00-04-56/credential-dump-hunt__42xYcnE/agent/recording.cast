[227.94537, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.945496, "o", "    # 1. PowerShell execution events\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.945567, "o", "    if code in (400, 600, 800, 4103):\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(eid)\r\n"]
