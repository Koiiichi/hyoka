[227.943948, "i", "cat << 'EOF' > /root/compile_malicious.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Fetch all events on WS-05\ncur.execute(\"SELECT event_id, event_code, user, image, target_image, message FROM events WHERE host='WS-05.corp.example'\")\nrows = cur.fetchall()\n\nmalicious_ids = set()\n\nfor r in rows:\n    eid = r['event_id']\n    code = r['event_code']\n    user = (r['user'] if r['user'] else \"\").lower()\n    img = (r['image'] if r['image'] else \"\").lower()\n    timg = (r['target_image'] if r['target_image'] else \"\").lower()\n    msg = r['message']\n    msg_lower = msg.lower()\n    \n    # 1. PowerShell execution events\n    if code in (400, 600, 800, 4103):\n        malicious_ids.add(eid)\n        continue\n        \n    # 2. Associated with pgustavo / Logon ID 0x2BA622\n    if 'pgustavo' in user or 'pgustavo' in msg_lower or '0x2ba622' in msg_lower or '2860578' in msg_lower:\n        malicious_ids.add(eid)\n        continue\n        \n    # 3. Associated with PowerShell process_guid\n    if '{297bc33e-65d0-5f2d-8207-000000000400}' in msg:\n        malicious_ids.add(eid)\n        continue\n        \n    # 4. Associated with whoami process_guid\n    if '{297bc33e-660d-5f2d-8407-000000000400}' in msg:\n        malicious_ids.add(eid)\n        continue\n        \n    # 5. Associated with PID 1648 (powershell) or 6504 (whoami)\n    # Check if 'Process ID: 1648' or 'Process ID: 6504' is in message\n    # Also hex versions: 0x670, 0x1968\n    if any(pid_str in msg for pid_str in ('Process ID:\t\t1648', 'Process ID:\t\t6504', 'Process ID: 1648', 'Process ID: 6504', 'Process ID:\t\t0x670', 'Process ID:\t\t0x1968', 'Source Process ID:\t0x670', 'Source Process ID:\t0x1968')):\n        malicious_ids.add(eid)\n        continue\n        \n    # 6. Prefetch creation of WHOAMI.EXE\n    if eid == 'evt-00389':\n        malicious_ids.add(eid)\n        continue\n\nprint(f\"Compiled {len(malicious_ids)} malicious event IDs.\")\n\n# Write to json file\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(malicious_ids)), f)\n\nEOF\npython3 /root/compile_malicious.py\n"]
