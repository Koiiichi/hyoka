[40.883649, "i", "cat << 'EOF' > /root/analyze_ps.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Get a sample of PowerShell 4103 (Operational) and 800 (classic) events\ncur.execute(\"SELECT event_id, timestamp, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (800, 4103) LIMIT 10\")\nfor row in cur.fetchall():\n    print(f\"{row['event_id']} | {row['timestamp']} | Event {row['event_code']}\")\n    print(row['message'][:200])\n    print(\"-\"*40)\n\nEOF\npython3 /root/analyze_ps.py\n"]
