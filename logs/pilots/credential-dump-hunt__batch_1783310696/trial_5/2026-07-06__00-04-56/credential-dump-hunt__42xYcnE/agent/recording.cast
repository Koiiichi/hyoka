[74.672064, "o", "\u001b[?2004hroot@751658dfcbab:~# "]
[79.803899, "i", "cat << 'EOF' > /root/explore_lateral.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Query events on DC01 between 14:32:40 and 14:32:50\nprint(\"=== DC01 Events around 14:32:47 ===\")\ncur.execute(\"SELECT event_id, timestamp, event_code, user, image, target_image, message FROM events WHERE host='DC01.corp.example' AND timestamp BETWEEN '2026-05-06T14:32:40Z' AND '2026-05-06T14:32:50Z' ORDER BY timestamp\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | EventCode {r['event_code']} | User {r['user']} | Image {r['image']} | Target {r['target_image']}\")\n    # check message for interesting stuff\n    for line in r['message'].split('\\n'):\n        if any(k in line.lower() for k in ('command', 'share', 'username', 'domain', 'address', 'access')):\n            print(\"   \", line.strip())\n\nEOF\npython3 /root/explore_lateral.py\n"]
