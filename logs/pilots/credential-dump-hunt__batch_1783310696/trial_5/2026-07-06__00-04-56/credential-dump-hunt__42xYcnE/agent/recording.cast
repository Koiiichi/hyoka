[32.527241, "i", "cat << 'EOF' > /root/analyze_all.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's count processes created (Sysmon Event ID 1, Security 4688)\nprint(\"--- PROCESS CREATIONS (Event Code 1 or 4688) ---\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code IN (1, 4688)\")\nproc_creations = cur.fetchall()\nfor row in proc_creations:\n    print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | {row['user']} | {row['image']}\")\n    # check if message contains Command Line\n    msg = row['message']\n    for line in msg.split('\\n'):\n        if 'CommandLine' in line or 'Command Line' in line or 'ParentCommandLine' in line:\n            print(\"   \", line.strip())\n\nEOF\npython3 /root/analyze_all.py\n"]
