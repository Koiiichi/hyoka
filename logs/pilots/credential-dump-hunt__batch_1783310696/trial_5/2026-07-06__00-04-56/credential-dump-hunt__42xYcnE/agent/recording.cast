[87.00787, "o", "        f.write(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | Code {r['event_code']} | User {r['user']} | Image {r['image']} | Target {r['target_image']} | {msg_clean}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
