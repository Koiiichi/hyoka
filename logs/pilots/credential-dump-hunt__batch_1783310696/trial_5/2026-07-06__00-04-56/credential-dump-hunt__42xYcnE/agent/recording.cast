[259.999164, "i", "cat << 'EOF' > /root/inspect_benign_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nimport json\nwith open('/root/findings.json', 'r') as f:\n    mal_ids = set(json.load(f))\n\ncur.execute(\"SELECT event_id, event_code, user, image, target_image, message FROM events WHERE host='WS-05.corp.example' ORDER BY timestamp\")\nrows = cur.fetchall()\n\nfor r in rows:\n    if r['event_id'] not in mal_ids:\n        code = r['event_code']\n        if code in (5, 7, 9, 4670, 4689, 5857):\n            print(f\"{r['event_id']} | Code {code} | Image: {r['image']} | Target: {r['target_image']} | msg: {r['message'][:200].replace('\\n', ' ')}\")\n\nEOF\npython3 /root/inspect_benign_details.py\n"]
