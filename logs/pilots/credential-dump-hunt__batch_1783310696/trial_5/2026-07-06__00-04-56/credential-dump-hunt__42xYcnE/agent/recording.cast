[227.946927, "o", "    # 5. Associated with PID 1648 (powershell) or 6504 (whoami)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.947152, "o", "    # Check if 'Process ID: 1648' or 'Process ID: 6504' is in message\r\n\u001b[?2004l\r\u001b[?2004h>     # Also hex versions: 0x670, 0x1968\r\n\u001b[?2004l\r"]
[227.947178, "o", "\u001b[?2004h>     if any(pid_str in msg for pid_str in ('Process ID:"]
