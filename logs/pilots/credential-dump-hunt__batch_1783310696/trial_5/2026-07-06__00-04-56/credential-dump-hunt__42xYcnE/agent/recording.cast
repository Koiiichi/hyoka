[227.945162, "o", "    img = (r['image'] if r['image'] else \"\").lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.945222, "o", "    timg = (r['target_image'] if r['target_image'] else \"\").lower()\r\n\u001b[?2004l\r\u001b[?2004h>     msg = r['message']\r\n\u001b[?2004l\r"]
