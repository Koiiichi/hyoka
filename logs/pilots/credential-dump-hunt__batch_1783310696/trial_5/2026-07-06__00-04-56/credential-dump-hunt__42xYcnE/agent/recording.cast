[190.929106, "i", "cat << 'EOF' > /root/inspect_benign.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's get the benign list from the previous logic\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, target_image, message \n    FROM events \n    WHERE host='WS-05.corp.example'\n    ORDER BY timestamp\n\"\"\")\nrows = cur.fetchall()\n\nbenign = []\nfor r in rows:\n    msg = r['message']\n    msg_lower = msg.lower()\n    img = (r['image'] if r['image'] else \"\").lower()\n    timg = (r['target_image'] if r['target_image'] else \"\").lower()\n    code = r['event_code']\n    \n    is_malicious = False\n    if code in (800, 4103, 400, 600):\n        is_malicious = True\n    elif 'pgustavo' in r['user'].lower() or 'pgustavo' in msg_lower or '0x2ba622' in msg_lower or '2860578' in msg_lower:\n        is_malicious = True\n    elif '{297bc33e-65d0-5f2d-8207-000000000400}' in msg:\n        is_malicious = True\n    elif code in (5156, 5158) and '1648' in msg:\n        is_malicious = True\n        \n    if not is_malicious:\n        benign.append(r)\n\nprint(f\"Benign total: {len(benign)}\")\n# Let's write them to /root/benign.txt with their full details so we can search/read them\nwith open('/root/benign.txt', 'w') as f:\n    for r in benign:\n        f.write(f\"{r['event_id']} | {r['timestamp']} | Code {r['event_code']} | User {r['user']} | Image {r['image']} | Target {r['target_image']} | {r['message'][:300].replace('\\n', ' ')}\\n\")\n\nEOF\npython3 /root/inspect_benign.py\n"]
[190.929541, "o", "cat << 'EOF' > /root/inspect_benign.py\r\n\u001b[?2004l\r"]
