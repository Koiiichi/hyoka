[227.949008, "o", "\u001b[?2004hroot@751658dfcbab:~# python3 /root/compile_malicious.py\r\n\u001b[?2004l\r"]
[227.972869, "o", "Compiled 4801 malicious event IDs.\r\n"]
[227.976622, "o", "\u001b[?2004hroot@751658dfcbab:~# "]
[236.606769, "i", "cat << 'EOF' > /root/compare_logic.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, user, image, target_image, message FROM events WHERE host='WS-05.corp.example'\")\nrows = cur.fetchall()\n\nset_a = set()\nset_b = set()\n\nfor r in rows:\n    eid = r['event_id']\n    code = r['event_code']\n    user = (r['user'] if r['user'] else \"\").lower()\n    msg = r['message']\n    msg_lower = msg.lower()\n    \n    # Logic A (classify_all_ws05.py)\n    is_mal_a = False\n    if code in (800, 4103, 400, 600):\n        is_mal_a = True\n    elif 'pgustavo' in user or 'pgustavo' in msg_lower or '0x2ba622' in msg_lower or '2860578' in msg_lower:\n        is_mal_a = True\n    elif '{297bc33e-65d0-5f2d-8207-000000000400}' in msg:\n        is_mal_a = True\n    elif code in (5156, 5158) and '1648' in msg:\n        is_mal_a = True\n        \n    if is_mal_a:\n        set_a.add(eid)\n        \n    # Logic B (compile_malicious.py)\n    is_mal_b = False\n    if code in (400, 600, 800, 4103):\n        is_mal_b = True\n    elif 'pgustavo' in user or 'pgustavo' in msg_lower or '0x2ba622' in msg_lower or '2860578' in msg_lower:\n        is_mal_b = True\n    elif '{297bc33e-65d0-5f2d-8207-000000000400}' in msg:\n        is_mal_b = True\n    elif '{297bc33e-660d-5f2d-8407-000000000400}' in msg:\n        is_mal_b = True\n    elif any(pid_str in msg for pid_str in ('Process ID:\t\t1648', 'Process ID:\t\t6504', 'Process ID: 1648', 'Process ID: 6504', 'Process ID:\t\t0x670', 'Process ID:\t\t0x1968', 'Source Process ID:\t0x670', 'Source Process ID:\t0x1968')):\n        # Note: in compile_malicious.py, some of these strings might have been written slightly differently due to shell escaping\n        is_mal_b = True\n    elif eid == 'evt-00389':\n        is_mal_b = True\n        \n    if is_mal_b:\n        set_b.add(eid)\n\nprint(f\"Set A size: {len(set_a)}\")\nprint(f\"Set B size: {len(set_b)}\")\nprint(f\"A - B size: {len(set_a - set_b)}\")\nprint(f\"B - A size: {len(set_b - set_a)}\")\n\n# Let's inspect A - B\nprint(\"\\n--- First 20 in A - B ---\")\nfor eid in sorted(list(set_a - set_b))[:20]:\n    cur.execute(\"SELECT event_id, event_code, message FROM events WHERE event_id=?\", (eid,))\n    row = cur.fetchone()\n    print(row['event_id'], \"| Code\", row['event_code'], \"| Message:\", row['message'][:200].replace('\\n', ' '))\n\nEOF\npython3 /root/compare_logic.py\n"]
