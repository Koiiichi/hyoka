[142.475793, "i", "cat << 'EOF' > /root/verify_non_powershell_v2.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, target_image, message \n    FROM events \n    WHERE host='WS-05.corp.example' \n      AND event_code NOT IN (800, 4103) \n    ORDER BY timestamp\n\"\"\")\n\nother_events = []\nfor r in cur.fetchall():\n    msg = r['message'].lower()\n    img = (r['image'] if r['image'] else \"\").lower()\n    timg = (r['target_image'] if r['target_image'] else \"\").lower()\n    \n    # check if powershell or whoami is involved\n    if 'powershell' in img or 'powershell' in timg or 'powershell' in msg:\n        continue\n    if 'whoami' in img or 'whoami' in timg or 'whoami' in msg:\n        continue\n        \n    # known background processes\n    if any(p in img or p in timg or p in msg for p in (\n        'networkwatcheragent', 'waagent', 'telemetry', 'healthservice', \n        'monitoringhost', 'omajadm', 'taskhostw', 'searchindexer', \n        'softwareprotectionplatform', 'lsass.exe', 'csrss.exe', 'wininit.exe', \n        'services.exe', 'smss.exe', 'winlogon.exe', 'spoolsv.exe', 'sgrmbroker.exe', \n        'svchost.exe', 'registry', 'msmpeng.exe', 'nacl.exe', 'conhost.exe', 'explorer.exe',\n        'mpcmdrun.exe', 'sppsvc.exe', 'gpsvc', 'system'\n    )):\n        continue\n        \n    other_events.append(r)\n\nprint(f\"Found {len(other_events)} unique non-powershell, non-whoami events on WS-05:\")\nfor r in other_events:\n    print(f\"{r['event_id']} | {r['timestamp']} | Code {r['event_code']} | User {r['user']} | Img {r['image']} | Timg {r['target_image']}\")\n\nEOF\npython3 /root/verify_non_powershell_v2.py\n"]
