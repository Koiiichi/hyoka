[87.519864, "o", "\u001b[?2004hroot@751658dfcbab:~# "]
[93.377358, "i", "cat << 'EOF' > /root/extract_intrusion.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nps_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\np_user = '%pgustavo%'\nc2_ip = '%10.10.10.5%'\n\n# Let's find events\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, host, event_code, user, image, target_image, message \n    FROM events \n    WHERE process_guid = ?\n       OR user LIKE ? \n       OR message LIKE ? \n       OR message LIKE ? \n    ORDER BY timestamp\n\"\"\", (ps_guid, p_user, f\"%{ps_guid}%\", c2_ip))\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} potential malicious events.\")\n\n# Group them by host and event_code to summarize\nsummary = {}\nfor r in rows:\n    k = (r['host'], r['event_code'])\n    summary[k] = summary.get(k, 0) + 1\n\nfor k, count in sorted(summary.items()):\n    print(f\"Host: {k[0]} | EventCode: {k[1]} | Count: {count}\")\n\n# Save candidates to a file\nwith open('/root/malicious_candidates.txt', 'w') as f:\n    for r in rows:\n        msg_clean = r['message'].replace('\\n', ' | ').replace('\\r', '')[:200]\n        f.write(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | Code {r['event_code']} | User {r['user']} | Image {r['image']} | Target {r['target_image']} | {msg_clean}\\n\")\n\nEOF\npython3 /root/extract_intrusion.py\n"]
[93.378728, "o", "cat << 'EOF' > /root/extract_intrusion.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ps_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\r\n\u001b[?2004l\r\u001b[?2004h> p_user = '%pgustavo%'\r\n\u001b[?2004l\r\u001b[?2004h> c2_ip = '%10.10.10.5%'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's find events\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, host, event_code, user, image, target_image, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE process_guid = ?\r\n\u001b[?2004l\r\u001b[?2004h>        OR user LIKE ? \r\n\u001b[?2004l\r\u001b[?2004h>        OR message LIKE ? \r\n\u001b[?2004l\r\u001b[?2004h>        OR message LIKE ? \r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\", (ps_guid, p_user, f\"%{ps_guid}%\", c2_ip))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> rows = cur.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(rows)} potential malicious events.\")\r\n\u001b[?2004l\r"]
