[59.11935, "o", "\u001b[?2004hroot@751658dfcbab:~# "]
[65.973121, "i", "cat << 'EOF' > /root/parse_network.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, host, event_code, message FROM events WHERE event_code IN (5156, 5158)\")\nrows = cur.fetchall()\n\nprint(f\"Parsed {len(rows)} WFP events:\")\nfor r in rows:\n    msg = r['message']\n    proc_id = \"\"\n    app_name = \"\"\n    direction = \"\"\n    src_addr = \"\"\n    src_port = \"\"\n    dst_addr = \"\"\n    dst_port = \"\"\n    \n    pid_match = re.search(r'Process ID:\\s*(\\d+)', msg)\n    if pid_match: proc_id = pid_match.group(1)\n    \n    app_match = re.search(r'Application Name:\\s*(.*)', msg)\n    if app_match: app_name = app_match.group(1).strip()\n    \n    dir_match = re.search(r'Direction:\\s*(.*)', msg)\n    if dir_match: direction = dir_match.group(1).strip()\n    \n    src_match = re.search(r'Source Address:\\s*(\\S+)', msg)\n    if src_match: src_addr = src_match.group(1).strip()\n    \n    srcp_match = re.search(r'Source Port:\\s*(\\d+)', msg)\n    if srcp_match: src_port = srcp_match.group(1).strip()\n    \n    dst_match = re.search(r'Destination Address:\\s*(\\S+)', msg)\n    if dst_match: dst_addr = dst_match.group(1).strip()\n    \n    dstp_match = re.search(r'Destination Port:\\s*(\\d+)', msg)\n    if dstp_match: dst_port = dstp_match.group(1).strip()\n    \n    # Print if outbound to non-local or non-standard, or powershell, or anything on WS-06/DC01 that looks weird\n    is_local = False\n    if dst_addr in ('127.0.0.1', '0.0.0.0', '::1', '', '::'):\n        is_local = True\n    if src_addr in ('127.0.0.1', '0.0.0.0', '::1', '', '::') and dst_addr == \"\":\n        is_local = True\n        \n    # Let's filter out standard local traffic\n    if not is_local or 'powershell' in app_name.lower():\n        print(f\"{r['event_id']} | {r['host']} | Code {r['event_code']} | PID {proc_id} | App {app_name} | Dir {direction} | Src {src_addr}:{src_port} -> Dst {dst_addr}:{dst_port}\")\n\nEOF\npython3 /root/parse_network.py\n"]
