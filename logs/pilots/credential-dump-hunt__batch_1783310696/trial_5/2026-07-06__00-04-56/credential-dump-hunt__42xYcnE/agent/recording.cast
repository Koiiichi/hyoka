[254.628692, "i", "cat << 'EOF' > /root/count_final_benign.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nimport json\nwith open('/root/findings.json', 'r') as f:\n    mal_ids = set(json.load(f))\n\ncur.execute(\"SELECT event_code, COUNT(*) as c FROM events WHERE host='WS-05.corp.example' GROUP BY event_code\")\ncounts = cur.fetchall()\n\n# Let's count only benign\nbenign_counts = {}\ncur.execute(\"SELECT event_id, event_code FROM events WHERE host='WS-05.corp.example'\")\nfor r in cur.fetchall():\n    if r['event_id'] not in mal_ids:\n        c = r['event_code']\n        benign_counts[c] = benign_counts.get(c, 0) + 1\n\nfor c, count in sorted(benign_counts.items()):\n    print(f\"EventCode: {c} | Benign Count: {count}\")\n\nEOF\npython3 /root/count_final_benign.py\n"]
