[74.645293, "i", "cat << 'EOF' > /root/examine_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== DC01 Logon Events (4624) ===\")\ncur.execute(\"SELECT event_id, timestamp, message FROM events WHERE host='DC01.corp.example' AND event_code=4624\")\nfor r in cur.fetchall():\n    print(r['event_id'], r['timestamp'])\n    for line in r['message'].split('\\n'):\n        if any(k in line for k in ('Logon Type:', 'Source Network Address:', 'Account Name:', 'Workstation Name:')):\n            print(\"  \", line.strip())\n\nprint(\"\\n=== DC01 Share Access (5140/5145) ===\")\ncur.execute(\"SELECT event_id, timestamp, event_code, message FROM events WHERE host='DC01.corp.example' AND event_code IN (5140, 5145)\")\nfor r in cur.fetchall():\n    print(r['event_id'], r['timestamp'], r['event_code'])\n    for line in r['message'].split('\\n'):\n        if any(k in line for k in ('Share Name:', 'Source Address:', 'Account Name:', 'Relative Target Name:')):\n            print(\"  \", line.strip())\n\nprint(\"\\n=== File Creations (Event 11) on all hosts ===\")\ncur.execute(\"SELECT event_id, timestamp, host, message FROM events WHERE event_code=11\")\nfor r in cur.fetchall():\n    print(r['event_id'], r['timestamp'], r['host'])\n    for line in r['message'].split('\\n'):\n        if any(k in line for k in ('TargetFilename:', 'Image:', 'User:')):\n            print(\"  \", line.strip())\n\nEOF\npython3 /root/examine_details.py\n"]
[74.646651, "o", "cat << 'EOF' > /root/examine_details.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== DC01 Logon Events (4624) ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id, timestamp, message FROM events WHERE host='DC01.corp.example' AND event_code=4624\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r['event_id'], r['timestamp'])\r\n\u001b[?2004l\r\u001b[?2004h>     for line in r['message'].split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h>         if any(k in line for k in ('Logon Type:', 'Source Network Address:', 'Account Name:', 'Workstation Name:')):\r\n\u001b[?2004l\r\u001b[?2004h>             print(\"  \", line.strip())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== DC01 Share Access (5140/5145) ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id, timestamp, event_code, message FROM events WHERE host='DC01.corp.example' AND event_code IN (5140, 5145)\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r['event_id'], r['timestamp'], r['event_code'])\r\n\u001b[?2004l\r\u001b[?2004h>     for line in r['message'].split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
