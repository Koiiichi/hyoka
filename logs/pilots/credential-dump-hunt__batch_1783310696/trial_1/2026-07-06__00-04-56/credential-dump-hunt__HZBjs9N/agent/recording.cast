[30.724266, "i", "cat << 'EOF' > decode_and_find.py\nimport sqlite3\nimport re\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's get all messages containing the base64 encoded block\ncursor.execute(\"SELECT event_id, host, user, message FROM events WHERE message LIKE '%enc %'\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} events containing 'enc '\")\n\n# Let's extract the base64 and decode it\nif rows:\n    msg = rows[0][3]\n    match = re.search(r'-enc\\s+([A-Za-z0-9+/=]+)', msg)\n    if match:\n        b64_str = match.group(1)\n        # Pad base64\n        b64_str += '=' * ((4 - len(b64_str) % 4) % 4)\n        try:\n            decoded = base64.b64decode(b64_str).decode('utf-16le', errors='ignore')\n            print(\"--- DECODED POWERSHELL SCRIPT ---\")\n            print(decoded)\n            print(\"---------------------------------\")\n        except Exception as e:\n            print(\"Failed to decode base64:\", e)\n            print(b64_str[:100])\n\n# Let's see all unique process GUIDs that run powershell with -enc\ncursor.execute(\"SELECT DISTINCT host, process_guid, message FROM events WHERE message LIKE '%powershell.exe% -enc %' OR message LIKE '%whoami%'\")\nps_processes = cursor.fetchall()\nprint(f\"Suspicious processes: {len(ps_processes)}\")\nfor p in ps_processes:\n    print(p[0], p[1])\n\nconn.close()\nEOF\npython3 decode_and_find.py\n"]
