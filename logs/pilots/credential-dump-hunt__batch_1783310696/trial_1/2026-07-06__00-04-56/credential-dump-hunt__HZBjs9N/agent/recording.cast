[85.033999, "i", "cat << 'EOF' > timeline.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Timeline range\ncursor.execute(\"SELECT MIN(timestamp), MAX(timestamp) FROM events\")\nprint(\"Time range:\", cursor.fetchone())\n\n# Count by event_code excluding WFP (5156, 5158) and PowerShell (4103, 800)\ncursor.execute(\"\"\"\n    SELECT event_code, COUNT(*), channel \n    FROM events \n    WHERE event_code NOT IN (800, 4103, 5156, 5158) \n    GROUP BY event_code \n    ORDER BY COUNT(*) DESC\n\"\"\")\nprint(\"Non-noisy Event Code counts:\")\nfor row in cursor.fetchall():\n    print(row)\n\nconn.close()\nEOF\npython3 timeline.py\n"]
