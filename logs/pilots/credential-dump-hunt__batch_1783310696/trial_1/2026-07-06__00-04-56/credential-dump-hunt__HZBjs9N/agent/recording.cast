[350.05708, "i", "cat << 'EOF' > find_all_ps_guids.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Find in message (since we don't have Process Create for powershell itself)\n# Let's search all Sysmon events (event_code < 100) for powershell.exe and extract process_guid\ncursor.execute(\"SELECT DISTINCT process_guid, image, message FROM events WHERE message LIKE '%powershell.exe%' AND event_code NOT IN (800, 4103)\")\nfor r in cursor.fetchall():\n    guid = r[0]\n    img = r[1]\n    msg = r[2]\n    # Find ProcessGuid inside message\n    m = re.findall(r'ProcessGuid:\\s*({[\\w-]+})', msg, re.IGNORECASE)\n    m2 = re.findall(r'SourceProcessGUID:\\s*({[\\w-]+})', msg, re.IGNORECASE)\n    m3 = re.findall(r'TargetProcessGUID:\\s*({[\\w-]+})', msg, re.IGNORECASE)\n    guids = set(m + m2 + m3)\n    print(f\"Image: {img}, GUIDs: {guids}\")\n\nconn.close()\nEOF\npython3 find_all_ps_guids.py\n"]
