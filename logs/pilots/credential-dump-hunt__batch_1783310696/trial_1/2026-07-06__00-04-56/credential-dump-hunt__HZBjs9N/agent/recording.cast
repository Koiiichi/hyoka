[261.727976, "i", "cat << 'EOF' > check_event10.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Get all Event 10 on WS-05\ncursor.execute(\"SELECT event_id, image, target_image, granted_access, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 10\")\nrows = cursor.fetchall()\nprint(f\"Total Event 10 on WS-05: {len(rows)}\")\n\nsuspicious = []\nfor r in rows:\n    eid, img, tgt, access, msg = r\n    # Check if powershell is either source or target\n    if 'powershell' in str(img).lower() or 'powershell' in str(tgt).lower():\n        suspicious.append(r)\n    elif 'whoami' in str(img).lower() or 'whoami' in str(tgt).lower():\n        suspicious.append(r)\n\nprint(f\"Suspicious Event 10 on WS-05 (related to PS or whoami): {len(suspicious)}\")\n# Let's see some non-suspicious Event 10 on WS-05 to see what they are\nnon_suspicious = [r for r in rows if r not in suspicious]\nprint(f\"Non-suspicious Event 10: {len(non_suspicious)}\")\nfor r in non_suspicious[:10]:\n    print(r[0], r[1], r[2], r[3])\n\nconn.close()\nEOF\npython3 check_event10.py\n"]
