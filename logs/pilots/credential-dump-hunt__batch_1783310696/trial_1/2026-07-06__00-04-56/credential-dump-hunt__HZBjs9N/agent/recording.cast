[289.349211, "i", "cat << 'EOF' > check_host2_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host = 'WS-05.corp.example' AND message LIKE '%ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b%' GROUP BY event_code\")\nprint(cursor.fetchall())\n\nconn.close()\nEOF\npython3 check_host2_events.py\n"]
