[377.96339, "i", "cat << 'EOF' > build_flagged_list.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nflagged = set()\n\n# 1. PowerShell logs on WS-05\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (400, 600, 800, 4103)\")\nfor r in cursor.fetchall(): flagged.add(r[0])\n\n# 2. Sysmon process GUIDs of malicious processes\nguid_ps = \"{297bc33e-65d0-5f2d-8207-000000000400}\"\nguid_whoami = \"{297bc33e-660d-5f2d-8407-000000000400}\"\n\ncursor.execute(\"SELECT event_id FROM events WHERE process_guid IN (?, ?)\", (guid_ps, guid_whoami))\nfor r in cursor.fetchall(): flagged.add(r[0])\n\n# Also check any Sysmon messages containing these GUIDs\ncursor.execute(\"SELECT event_id FROM events WHERE message LIKE ? OR message LIKE ?\", (f\"%{guid_ps}%\", f\"%{guid_whoami}%\"))\nfor r in cursor.fetchall(): flagged.add(r[0])\n\n# 3. WFP events on WS-05 with C2 IP\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158) AND message LIKE '%10.10.10.5%'\")\nfor r in cursor.fetchall(): flagged.add(r[0])\n\n# 4. Security audit events on WS-05 matching pgustavo/whoami execution or LSASS dump time\n# Let's inspect these events to be absolutely sure\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND user LIKE '%pgustavo%' \n      AND event_code NOT IN (800, 4103, 5156, 5158)\n\"\"\")\nfor r in cursor.fetchall():\n    # These are: whoami process creation (4688), whoami process exit (4689), handle request/close/dup (4656, 4658, 4663, 4690), privileged service (4673)\n    flagged.add(r[0])\n\nprint(f\"Total flagged events: {len(flagged)}\")\n\n# Let's see what is NOT flagged but has 'pgustavo' or is on WS-05\ncursor.execute(\"SELECT event_id, host, event_code, user, image, message FROM events\")\nnot_flagged_pg = []\nfor r in cursor.fetchall():\n    eid, host, ec, usr, img, msg = r\n    if eid not in flagged:\n        if 'pgustavo' in str(usr) or 'pgustavo' in str(msg):\n            not_flagged_pg.append(r)\n\nprint(f\"Not flagged but mentioning pgustavo: {len(not_flagged_pg)}\")\nfor r in not_flagged_pg:\n    print(r[0], r[1], r[2], r[3], r[4])\n\nconn.close()\nEOF\npython3 build_flagged_list.py\n"]
