[23.585079, "i", "cat << 'EOF' > analyze.py\nimport sqlite3\nimport base64\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's fetch all event rows\ncursor.execute(\"SELECT event_id, timestamp, event_code, channel, provider, host, user, image, target_image, granted_access, src_ip, dst_ip, dst_port, process_guid, message FROM events\")\ncolumns = [col[0] for col in cursor.description]\nevents = [dict(zip(columns, row)) for row in cursor.fetchall()]\n\nprint(f\"Loaded {len(events)} events.\")\n\n# Let's inspect processes with parent commandlines or command lines containing base64\nfor ev in events:\n    msg = ev['message'] or ''\n    # Check for powershell encoded command\n    if 'enc ' in msg or 'EncodedCommand' in msg:\n        print(f\"Suspicious PS command in event {ev['event_id']} on {ev['host']}:\")\n        print(msg)\n        print(\"=\"*50)\n\nconn.close()\nEOF\npython3 analyze.py\n"]
