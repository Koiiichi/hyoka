[229.209115, "i", "cat << 'EOF' > check_two_hosts.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, event_code, message, timestamp FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (400, 600, 800, 4103)\")\n\nhost1_events = []\nhost2_events = []\n\nfor row in cursor.fetchall():\n    eid, ec, msg, ts = row\n    if 'bd39a342-b84b-499d-b35a-752ceae5484c' in msg:\n        host1_events.append((eid, ec, ts, msg))\n    elif 'ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b' in msg:\n        host2_events.append((eid, ec, ts, msg))\n    else:\n        # No HostId in message?\n        pass\n\nprint(f\"Host bd39a342-b84b-499d-b35a-752ceae5484c: {len(host1_events)} events\")\nif host1_events:\n    print(f\"  First: {host1_events[0][2]}, Last: {host1_events[-1][2]}\")\n    # Get unique HostApplications\n    apps = set()\n    for _, _, _, msg in host1_events:\n        m = re.search(r'HostApplication=([^\\r\\n]+)', msg)\n        if m: apps.add(m.group(1))\n    print(\"  HostApps:\", [a[:100] for a in apps])\n\nprint(f\"Host ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b: {len(host2_events)} events\")\nif host2_events:\n    print(f\"  First: {host2_events[0][2]}, Last: {host2_events[-1][2]}\")\n    apps = set()\n    for _, _, _, msg in host2_events:\n        m = re.search(r'HostApplication=([^\\r\\n]+)', msg)\n        if m: apps.add(m.group(1))\n    print(\"  HostApps:\", [a[:100] for a in apps])\n\nconn.close()\nEOF\npython3 check_two_hosts.py\n"]
