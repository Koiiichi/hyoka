[355.638781, "i", "cat << 'EOF' > get_unique_ps_guids.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nall_guids = set()\ncursor.execute(\"SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code NOT IN (800, 4103) AND (message LIKE '%powershell.exe%' OR image LIKE '%powershell.exe%' OR target_image LIKE '%powershell.exe%')\")\nfor row in cursor.fetchall():\n    msg = row[0]\n    # Extract any guid pattern\n    matches = re.findall(r'({[a-f0-9-]{36}})', msg, re.IGNORECASE)\n    for m in matches:\n        # Check if this guid is in a context related to powershell\n        all_guids.add(m.lower())\n\nprint(\"All GUIDs found in PowerShell-related messages on WS-05:\", all_guids)\nconn.close()\nEOF\npython3 get_unique_ps_guids.py\n"]
[355.639157, "o", "cat << 'EOF' > get_unique_ps_guids.py\r\n"]
