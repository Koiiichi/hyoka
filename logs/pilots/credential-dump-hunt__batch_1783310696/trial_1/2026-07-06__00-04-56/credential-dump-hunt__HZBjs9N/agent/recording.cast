[209.84194, "i", "cat << 'EOF' > check_ps_details.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT COUNT(*) FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103) AND message NOT LIKE '%SQBGACgAJABQAFMA%'\")\nnot_matched = cursor.fetchone()[0]\nprint(f\"PowerShell events NOT containing the base64 prefix: {not_matched}\")\n\n# Let's inspect those not containing it, if any\nif not_matched > 0:\n    cursor.execute(\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103) AND message NOT LIKE '%SQBGACgAJABQAFMA%' LIMIT 10\")\n    for row in cursor.fetchall():\n        print(row[0], row[1], row[2][:200])\n\nconn.close()\nEOF\npython3 check_ps_details.py\n"]
