[215.454576, "i", "cat << 'EOF' > check_other_ps.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# All PS events in the DB\ncursor.execute(\"SELECT host, event_code, COUNT(*) FROM events WHERE event_code IN (400, 600, 800, 4103) GROUP BY host, event_code\")\nfor row in cursor.fetchall():\n    print(row)\n\nconn.close()\nEOF\npython3 check_other_ps.py\n"]
