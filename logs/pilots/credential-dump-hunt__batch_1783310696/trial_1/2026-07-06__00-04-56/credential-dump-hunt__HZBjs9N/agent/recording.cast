[294.973324, "i", "cat << 'EOF' > check_pgustavo_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, event_code, image, target_image, message FROM events WHERE host = 'WS-05.corp.example' AND (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%') AND event_code NOT IN (800, 4103, 5156, 5158)\")\nfor row in cursor.fetchall():\n    eid, ec, img, tgt, msg = row\n    # Print first line of msg\n    msg_line = msg.split('\\n')[0].strip() if msg else ''\n    print(f\"{eid} | EC: {ec} | Image: {img} | Target: {tgt} | Msg: {msg_line}\")\n\nconn.close()\nEOF\npython3 check_pgustavo_events.py\n"]
