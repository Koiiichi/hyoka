[155.002275, "i", "cat << 'EOF' > find_all_ips.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nprint(\"=== DISTINCT DST IPS (EVENT 3) ===\")\ncursor.execute(\"SELECT host, image, dst_ip, COUNT(*) FROM events WHERE event_code = 3 GROUP BY host, image, dst_ip\")\nfor r in cursor.fetchall():\n    print(r)\n\nprint(\"=== DISTINCT DST IPS (5156) ===\")\ncursor.execute(\"SELECT host, dst_ip, COUNT(*) FROM events WHERE event_code = 5156 GROUP BY host, dst_ip\")\nfor r in cursor.fetchall():\n    print(r)\n\nconn.close()\nEOF\npython3 find_all_ips.py\n"]
