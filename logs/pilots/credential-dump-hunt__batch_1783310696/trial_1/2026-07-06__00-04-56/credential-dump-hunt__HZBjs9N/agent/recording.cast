[187.436818, "i", "cat << 'EOF' > check_dc_logons.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, message FROM events WHERE host LIKE '%DC01%' AND event_code = 4624\")\nfor row in cursor.fetchall():\n    eid = row[0]\n    msg = row[1]\n    # Find TargetUserName and TargetDomainName in message\n    un = re.search(r'Account Name:\\s*(\\S+)', msg)\n    dom = re.search(r'Account Domain:\\s*(\\S+)', msg)\n    logon_type = re.search(r'Logon Type:\\s*(\\d+)', msg)\n    ip = re.search(r'Source Network Address:\\s*(\\S+)', msg)\n    print(f\"Event: {eid}, Account: {un.group(1) if un else None}, Domain: {dom.group(1) if dom else None}, Type: {logon_type.group(1) if logon_type else None}, IP: {ip.group(1) if ip else None}\")\n\nconn.close()\nEOF\npython3 check_dc_logons.py\n"]
[187.43964, "o", "cat << 'EOF' > check_dc_logons.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, message FROM events WHERE host LIKE '%DC01%' AND event_code = 4624\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     eid = row[0]\r\n\u001b[?2004l\r\u001b[?2004h>     msg = row[1]\r\n\u001b[?2004l\r\u001b[?2004h>     # Find TargetUserName and TargetDomainName in message\r\n\u001b[?2004l\r\u001b[?2004h>     un = re.search(r'Account Name:\\s*(\\S+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     dom = re.search(r'Account Domain:\\s*(\\S+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     logon_type = re.search(r'Logon Type:\\s*(\\d+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     ip = re.search(r'Source Network Address:\\s*(\\S+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Event: {eid}, Account: {un.group(1) if un else None}, Domain: {dom.group(1) if dom else None}, Type: {logon_type.group(1) if logon_type else None}, IP: {ip.group(1) if ip else None}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[187.44141, "o", "\u001b[?2004hroot@a7bd5d444754:~# "]
[187.441664, "o", "python3 check_dc_logons.py\r\n\u001b[?2004l\r"]
