[276.016299, "i", "cat << 'EOF' > find_host2_guid.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's search for PowerShell events with HostId ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b and see if we can find any Sysmon events sharing the same Process GUID or process ID\ncursor.execute(\"SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (400, 600, 800, 4103) AND message LIKE '%ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b%'\")\n# PowerShell logs can have ProcessId inside\npids = set()\nfor row in cursor.fetchall():\n    msg = row[0]\n    # Find ProcessId in message\n    match = re.search(r'ProcessId=(\\d+)', msg, re.IGNORECASE)\n    if match:\n        pids.add(match.group(1))\n\nprint(\"Process IDs for Host 2:\", pids)\n\n# Now let's see which Sysmon events on WS-05 have these PIDs\nfor pid in pids:\n    cursor.execute(\"SELECT DISTINCT process_guid, image FROM events WHERE host = 'WS-05.corp.example' AND message LIKE ?\", (f\"%ProcessId: {pid}%\",))\n    print(f\"For PID {pid}, found Sysmon processes:\", cursor.fetchall())\n\nconn.close()\nEOF\npython3 find_host2_guid.py\n"]
