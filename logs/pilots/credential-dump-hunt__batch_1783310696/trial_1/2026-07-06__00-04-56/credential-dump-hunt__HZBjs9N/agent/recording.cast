[170.741474, "i", "cat << 'EOF' > examine_other_hosts.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Check all events on WS-06\nprint(\"=== WS-06 Events by Event Code ===\")\ncursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host LIKE '%WS-06%' GROUP BY event_code\")\nfor r in cursor.fetchall():\n    print(r)\n\n# Check all events on DC01\nprint(\"=== DC01 Events by Event Code ===\")\ncursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host LIKE '%DC01%' GROUP BY event_code\")\nfor r in cursor.fetchall():\n    print(r)\n\n# Any other events with pgustavo?\nprint(\"=== Events with user pgustavo ===\")\ncursor.execute(\"SELECT host, event_code, COUNT(*) FROM events WHERE user LIKE '%pgustavo%' GROUP BY host, event_code\")\nfor r in cursor.fetchall():\n    print(r)\n\nconn.close()\nEOF\npython3 examine_other_hosts.py\n"]
