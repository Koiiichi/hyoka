[30.78076, "o", "\u001b[?2004hroot@a7bd5d444754:~# "]
[37.68474, "i", "cat << 'EOF' > decode_and_find.py\nimport sqlite3\nimport re\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's get all messages containing the base64 encoded block\ncursor.execute(\"SELECT event_id, host, user, message FROM events WHERE message LIKE '%-enc %'\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} events containing '-enc '\")\n\nif rows:\n    # Try to extract the full base64 string across the whole database, or from the whoami event ParentCommandLine\n    cursor.execute(\"SELECT message FROM events WHERE event_id = 'evt-00282'\")\n    whoami_msg = cursor.fetchone()[0]\n    # Find the ParentCommandLine inside whoami_msg\n    match = re.search(r'ParentCommandLine:.*-enc\\s+([A-Za-z0-9+/=]+)', whoami_msg, re.IGNORECASE | re.DOTALL)\n    if match:\n        b64_str = match.group(1).strip()\n        b64_str = b64_str.replace('\\n', '').replace('\\r', '').replace(' ', '')\n        b64_str += '=' * ((4 - len(b64_str) % 4) % 4)\n        decoded = base64.b64decode(b64_str).decode('utf-16le', errors='ignore')\n        with open('/root/decoded_script.txt', 'w') as f:\n            f.write(decoded)\n        print(\"Successfully decoded script from whoami event and wrote to /root/decoded_script.txt\")\n    else:\n        print(\"Could not find ParentCommandLine or base64 in event evt-00282\")\n\nconn.close()\nEOF\npython3 decode_and_find.py\ncat /root/decoded_script.txt | head -n 40\n"]
