[242.659385, "o", "\u001b[?2004hroot@a7bd5d444754:~# "]
[249.149629, "i", "cat << 'EOF' > summarize_hosts_v2.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (400, 600, 800, 4103)\")\n\nhost1_count = 0\nhost2_count = 0\nno_host_count = 0\nhost2_apps = set()\n\nfor row in cursor.fetchall():\n    msg = row[0]\n    if 'bd39a342-b84b-499d-b35a-752ceae5484c' in msg:\n        host1_count += 1\n    elif 'ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b' in msg:\n        host2_count += 1\n        m = re.search(r'HostApplication=([^\\r\\n]+)', msg)\n        if m: host2_apps.add(m.group(1))\n    else:\n        no_host_count += 1\n\nprint(f\"Host bd39a342-b84b-499d-b35a-752ceae5484c events: {host1_count}\")\nprint(f\"Host ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b events: {host2_count}\")\nprint(f\"Events without these HostIds: {no_host_count}\")\nprint(f\"Host 2 applications count: {len(host2_apps)}\")\nfor a in host2_apps:\n    print(f\"Host 2 app: {a[:150]}\")\n\nconn.close()\nEOF\npython3 summarize_hosts_v2.py\n"]
