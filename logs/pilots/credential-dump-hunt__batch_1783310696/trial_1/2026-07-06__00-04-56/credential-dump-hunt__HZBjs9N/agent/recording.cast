[161.530019, "i", "cat << 'EOF' > find_guid.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Search for the GUID {297bc33e-65d0-5f2d-8207-000000000400}\nguid = \"{297bc33e-65d0-5f2d-8207-000000000400}\"\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, user, image, message \n    FROM events \n    WHERE process_guid = ? \n       OR message LIKE ?\n\"\"\", (guid, f\"%{guid}%\"))\n\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} events associated with GUID {guid}\")\n\n# Let's count them by event_code\ncounts = {}\nfor r in rows:\n    code = r[1]\n    counts[code] = counts.get(code, 0) + 1\nprint(\"Counts by Event Code:\")\nfor code, count in sorted(counts.items()):\n    print(f\"Event Code {code}: {count}\")\n\nconn.close()\nEOF\npython3 find_guid.py\n"]
