[149.131752, "i", "cat << 'EOF' > find_ip.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Find any references to '10.10.10.5'\ncursor.execute(\"SELECT event_id, host, event_code, user, image, message FROM events WHERE message LIKE '%10.10.10.5%'\")\nrows = cursor.fetchall()\nprint(f\"Events with 10.10.10.5: {len(rows)}\")\nhosts = set()\nfor r in rows:\n    hosts.add(r[1])\nprint(\"Hosts interacting with 10.10.10.5:\", hosts)\n\n# Let's count them by host and event_code\ncursor.execute(\"\"\"\n    SELECT host, event_code, COUNT(*)\n    FROM events \n    WHERE message LIKE '%10.10.10.5%'\n    GROUP BY host, event_code\n\"\"\")\nfor r in cursor.fetchall():\n    print(r)\n\nconn.close()\nEOF\npython3 find_ip.py\n"]
