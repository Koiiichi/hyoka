[324.561646, "i", "cat << 'EOF' > print_remaining_summary.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nmalicious_events = set()\nguid_ps = \"{297bc33e-65d0-5f2d-8207-000000000400}\"\ncursor.execute(\"SELECT event_id FROM events WHERE process_guid = ? OR message LIKE ?\", (guid_ps, f\"%{guid_ps}%\"))\nfor r in cursor.fetchall(): malicious_events.add(r[0])\n\nguid_whoami = \"{297bc33e-660d-5f2d-8407-000000000400}\"\ncursor.execute(\"SELECT event_id FROM events WHERE process_guid = ? OR message LIKE ?\", (guid_whoami, f\"%{guid_whoami}%\"))\nfor r in cursor.fetchall(): malicious_events.add(r[0])\n\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (400, 600, 800, 4103)\")\nfor r in cursor.fetchall(): malicious_events.add(r[0])\n\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158) AND message LIKE '%10.10.10.5%'\")\nfor r in cursor.fetchall(): malicious_events.add(r[0])\n\n# Group remaining\ncursor.execute(\"SELECT event_id, host, event_code, image FROM events\")\nremaining_counts = {}\nfor eid, host, ec, img in cursor.fetchall():\n    if eid not in malicious_events:\n        key = (host, ec, img)\n        remaining_counts[key] = remaining_counts.get(key, 0) + 1\n\nprint(\"=== REMAINING BENIGN/UNFLAGGED EVENTS (TOP 30) ===\")\nfor k, c in sorted(remaining_counts.items(), key=lambda x: x[1], reverse=True)[:30]:\n    print(f\"{k}: {c}\")\n\nconn.close()\nEOF\npython3 print_remaining_summary.py\n"]
