[363.371539, "i", "cat << 'EOF' > check_third_guid.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nguid = \"{297bc33e-65ce-5f2d-7f07-000000000400}\"\ncursor.execute(\"SELECT event_id, event_code, image, message FROM events WHERE process_guid = ? OR message LIKE ?\", (guid, f\"%{guid}%\"))\nfor r in cursor.fetchall():\n    print(r[0], r[1], r[2], r[3][:200].replace('\\n', ' ').replace('\\r', ''))\n\nconn.close()\nEOF\npython3 check_third_guid.py\n"]
