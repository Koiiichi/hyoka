[317.376078, "i", "cat << 'EOF' > check_remaining.py\nimport sqlite3\n\n# Let's import the list of malicious event IDs from collect_all_malicious_sysmon.py logic\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nmalicious_events = set()\n\nguid_ps = \"{297bc33e-65d0-5f2d-8207-000000000400}\"\ncursor.execute(\"SELECT event_id FROM events WHERE process_guid = ? OR message LIKE ?\", (guid_ps, f\"%{guid_ps}%\"))\nfor r in cursor.fetchall():\n    malicious_events.add(r[0])\n\nguid_whoami = \"{297bc33e-660d-5f2d-8407-000000000400}\"\ncursor.execute(\"SELECT event_id FROM events WHERE process_guid = ? OR message LIKE ?\", (guid_whoami, f\"%{guid_whoami}%\"))\nfor r in cursor.fetchall():\n    malicious_events.add(r[0])\n\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (400, 600, 800, 4103)\")\nfor r in cursor.fetchall():\n    malicious_events.add(r[0])\n\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158) AND message LIKE '%10.10.10.5%'\")\nfor r in cursor.fetchall():\n    malicious_events.add(r[0])\n\n# Now select all other events\ncursor.execute(\"SELECT event_id, host, event_code, user, image, message FROM events\")\nremaining = []\nfor r in cursor.fetchall():\n    if r[0] not in malicious_events:\n        remaining.append(r)\n\nprint(f\"Remaining non-flagged events: {len(remaining)}\")\n\n# Group them by host, event_code, image to get a high-level overview\ngroups = {}\nfor r in remaining:\n    eid, host, ec, user, image, msg = r\n    key = (host, ec, image)\n    groups[key] = groups.get(key, 0) + 1\n\nprint(\"Remaining events grouped by (host, event_code, image):\")\nfor k, count in sorted(groups.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{k}: {count}\")\n\nconn.close()\nEOF\npython3 check_remaining.py\n"]
