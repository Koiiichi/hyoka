[100.220892, "i", "cat << 'EOF' > hunt.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nprint(\"=== SYSMON EVENT 3 (NETWORK) ===\")\ncursor.execute(\"SELECT event_id, host, user, image, src_ip, dst_ip, dst_port, message FROM events WHERE event_code = 3\")\nfor row in cursor.fetchall():\n    # Summarize or print if interesting\n    print(row[:7])\n\nprint(\"=== SYSMON EVENT 11 (FILE CREATE) ===\")\ncursor.execute(\"SELECT event_id, host, image, message FROM events WHERE event_code = 11\")\nfor row in cursor.fetchall():\n    print(row[:3], row[3][:200])\n\nprint(\"=== SYSMON EVENT 10 (PROCESS ACCESS) TARGETING LSASS OR OTHER SENSITIVE ===\")\ncursor.execute(\"SELECT event_id, host, image, target_image, granted_access, message FROM events WHERE event_code = 10\")\nfor row in cursor.fetchall():\n    ti = str(row[3]).lower()\n    if 'lsass' in ti or 'sam' in ti or 'hashing' in ti or 'system' in ti or 'pw' in ti:\n        print(row[:5])\n\nconn.close()\nEOF\npython3 hunt.py\n"]
