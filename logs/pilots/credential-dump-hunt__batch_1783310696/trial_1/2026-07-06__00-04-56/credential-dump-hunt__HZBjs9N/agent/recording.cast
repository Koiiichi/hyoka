[203.741322, "i", "cat << 'EOF' > check_ps_hosts.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's see the unique HostApplications in 4103 and 800 events\ncursor.execute(\"SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103)\")\nhost_apps = set()\nfor row in cursor.fetchall():\n    msg = row[0]\n    # Find HostApplication inside message\n    match = re.search(r'HostApplication=([^\\r\\n]+)', msg)\n    if match:\n        host_apps.add(match.group(1).strip())\n    else:\n        # Check other potential patterns\n        pass\n\nprint(f\"Unique HostApplications: {len(host_apps)}\")\nfor app in list(host_apps)[:10]:\n    print(app[:150])\n\nconn.close()\nEOF\npython3 check_ps_hosts.py\n"]
