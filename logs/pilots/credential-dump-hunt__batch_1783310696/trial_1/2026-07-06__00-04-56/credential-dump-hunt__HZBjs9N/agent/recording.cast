[100.256738, "o", "\u001b[?2004hroot@a7bd5d444754:~# "]
[133.52351, "i", "cat << 'EOF' > filter.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Get all Event Code 3 (Network)\ncursor.execute(\"SELECT event_id, host, user, image, src_ip, dst_ip, dst_port FROM events WHERE event_code = 3\")\nwith open('net_events.txt', 'w') as f:\n    for r in cursor.fetchall():\n        f.write(str(r) + '\\n')\n\n# Get all Event Code 11 (File Create)\ncursor.execute(\"SELECT event_id, host, user, image, message FROM events WHERE event_code = 11\")\nwith open('file_events.txt', 'w') as f:\n    for r in cursor.fetchall():\n        f.write(str(r) + '\\n')\n\n# Get Registry events (12, 13, 14)\ncursor.execute(\"SELECT event_id, event_code, host, user, image, message FROM events WHERE event_code IN (12, 13, 14)\")\nwith open('reg_events.txt', 'w') as f:\n    for r in cursor.fetchall():\n        f.write(str(r) + '\\n')\n\nconn.close()\nEOF\npython3 filter.py\n"]
[133.52427, "o", "cat << 'EOF' > filter.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
