[221.474809, "i", "cat << 'EOF' > check_all_ps_pids.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (400, 600, 800, 4103)\")\nsessions = set()\nfor row in cursor.fetchall():\n    eid, ec, msg = row\n    # Try to find HostId or RunspaceId or ProcessId inside the message\n    host_id = re.search(r'HostId=([\\w-]+)', msg, re.IGNORECASE)\n    proc_id = re.search(r'ProcessId=(\\d+)', msg, re.IGNORECASE)\n    if host_id:\n        sessions.add((\"HostId\", host_id.group(1)))\n    if proc_id:\n        sessions.add((\"ProcId\", proc_id.group(1)))\n\nprint(\"Identified Sessions/PIDs in PowerShell events:\")\nfor s in sessions:\n    print(s)\n\nconn.close()\nEOF\npython3 check_all_ps_pids.py\n"]
