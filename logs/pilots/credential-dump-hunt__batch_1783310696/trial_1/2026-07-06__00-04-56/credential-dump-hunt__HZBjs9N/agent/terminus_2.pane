[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Find any references to '10.10.10.5'
[?2004l[?2004h> cursor.execute("SELECT event_id, host, event_code, user, image, message FROM events WHERE message LIKE '%10.10.10.5%'")
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Events with 10.10.10.5: {len(rows)}")
[?2004l[?2004h> hosts = set()
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     hosts.add(r[1])
[?2004l[?2004h> print("Hosts interacting with 10.10.10.5:", hosts)
[?2004l[?2004h> 
[?2004l[?2004h> # Let's count them by host and event_code
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT host, event_code, COUNT(*)
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE message LIKE '%10.10.10.5%'
[?2004l[?2004h>     GROUP BY host, event_code
[?2004l[?2004h> """)
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(r)
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
