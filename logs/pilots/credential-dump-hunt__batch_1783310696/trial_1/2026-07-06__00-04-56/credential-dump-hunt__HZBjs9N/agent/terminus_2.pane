[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (400, 600, 800, 4103)")
