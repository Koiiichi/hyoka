[?2004hroot@a7bd5d444754:~# cat << 'EOF' > find_host2_guid.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search for PowerShell events with HostId ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b and see if we can find any Sysmon events sharing the same Process GUID or process ID
[?2004l[?2004h> cursor.execute("SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (400, 600, 800, 4103) AND message LIKE '%ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b%'")
[?2004l[?2004h> # PowerShell logs can have ProcessId inside
[?2004l[?2004h> pids = set()
[?2004l[?2004h> for row in cursor.fetchall():
[?2004l[?2004h>     msg = row[0]
[?2004l[?2004h>     # Find ProcessId in message
[?2004l[?2004h>     match = re.search(r'ProcessId=(\d+)', msg, re.IGNORECASE)
[?2004l[?2004h>     if match:
[?2004l[?2004h>         pids.add(match.group(1))
[?2004l[?2004h> 
[?2004l[?2004h> print("Process IDs for Host 2:", pids)
[?2004l[?2004h> 
[?2004l[?2004h> # Now let's see which Sysmon events on WS-05 have these PIDs
[?2004l[?2004h> for pid in pids:
[?2004l[?2004h>     cursor.execute("SELECT DISTINCT process_guid, image FROM events WHERE host = 'WS-05.corp.example' AND message LIKE ?", (f"%ProcessId: {pid}%",))
[?2004l[?2004h>     print(f"For PID {pid}, found Sysmon processes:", cursor.fetchall())
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
[?2004l[?2004h> EOF
[?2004l[?2004hroot@a7bd5d444754:~# python3 find_host2_guid.py
[?2004lProcess IDs for Host 2: set()
