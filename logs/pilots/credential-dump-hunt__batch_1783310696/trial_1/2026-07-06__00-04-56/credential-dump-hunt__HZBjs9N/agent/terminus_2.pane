[?2004hroot@a7bd5d444754:~# cat << 'EOF' > check_ps_hosts.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's see the unique HostApplications in 4103 and 800 events
[?2004l[?2004h> cursor.execute("SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103)")
[?2004l[?2004h> host_apps = set()
[?2004l[?2004h> for row in cursor.fetchall():
[?2004l[?2004h>     msg = row[0]
[?2004l[?2004h>     # Find HostApplication inside message
[?2004l[?2004h>     match = re.search(r'HostApplication=([^\r\n]+)', msg)
[?2004l[?2004h>     if match:
[?2004l[?2004h>         host_apps.add(match.group(1).strip())
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Check other potential patterns
[?2004l[?2004h>         pass
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Unique HostApplications: {len(host_apps)}")
[?2004l[?2004h> for app in list(host_apps)[:10]:
[?2004l[?2004h>     print(app[:150])
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
[?2004l[?2004h> EOF
[?2004l[?2004hroot@a7bd5d444754:~# python3 check_ps_hosts.py
