[?2004hroot@a7bd5d444754:~# cat << 'EOF' > check_all_ps_pids.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (400, 600, 800, 4103)")
[?2004l[?2004h> sessions = set()
[?2004l[?2004h> for row in cursor.fetchall():
[?2004l[?2004h>     eid, ec, msg = row
[?2004l[?2004h>     # Try to find HostId or RunspaceId or ProcessId inside the message
[?2004l[?2004h>     host_id = re.search(r'HostId=([\w-]+)', msg, re.IGNORECASE)
[?2004l[?2004h>     proc_id = re.search(r'ProcessId=(\d+)', msg, re.IGNORECASE)
[?2004l[?2004h>     if host_id:
[?2004l[?2004h>         sessions.add(("HostId", host_id.group(1)))
[?2004l[?2004h>     if proc_id:
[?2004l[?2004h>         sessions.add(("ProcId", proc_id.group(1)))
[?2004l[?2004h> 
[?2004l[?2004h> print("Identified Sessions/PIDs in PowerShell events:")
[?2004l[?2004h> for s in sessions:
[?2004l[?2004h>     print(s)
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
[?2004l[?2004h> EOF
[?2004l[?2004hroot@a7bd5d444754:~# python3 check_all_ps_pids.py
[?2004lIdentified Sessions/PIDs in PowerShell events:
('HostId', 'ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b')
('HostId', 'bd39a342-b84b-499d-b35a-752ceae5484c')
[?2004hroot@a7bd5d444754:~# cat << 'EOF' > check_two_hosts.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, message, timestamp FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (400, 600, 800, 4103)")
[?2004l[?2004h> 
[?2004l[?2004h> host1_events = []
[?2004l[?2004h> host2_events = []
[?2004l[?2004h> 
[?2004l[?2004h> for row in cursor.fetchall():
[?2004l[?2004h>     eid, ec, msg, ts = row
[?2004l[?2004h>     if 'bd39a342-b84b-499d-b35a-752ceae5484c' in msg:
[?2004l[?2004h>         host1_events.append((eid, ec, ts, msg))
[?2004l[?2004h>     elif 'ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b' in msg:
[?2004l[?2004h>         host2_events.append((eid, ec, ts, msg))
[?2004l[?2004h>     else:
[?2004l[?2004h>         # No HostId in message?
[?2004l[?2004h>         pass
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Host bd39a342-b84b-499d-b35a-752ceae5484c: {len(host1_events)} events")
[?2004l[?2004h> if host1_events:
[?2004l[?2004h>     print(f"  First: {host1_events[0][2]}, Last: {host1_events[-1][2]}")
[?2004l[?2004h>     # Get unique HostApplications
[?2004l[?2004h>     apps = set()
[?2004l[?2004h>     for _, _, _, msg in host1_events:
[?2004l[?2004h>         m = re.search(r'HostApplication=([^\r\n]+)', msg)
[?2004l[?2004h>         if m: apps.add(m.group(1))
[?2004l[?2004h>     print("  HostApps:", [a[:100] for a in apps])
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Host ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b: {len(host2_events)} events")
[?2004l[?2004h> if host2_events:
[?2004l[?2004h>     print(f"  First: {host2_events[0][2]}, Last: {host2_events[-1][2]}")
[?2004l[?2004h>     apps = set()
[?2004l[?2004h>     for _, _, _, msg in host2_events:
[?2004l[?2004h>         m = re.search(r'HostApplication=([^\r\n]+)', msg)
[?2004l[?2004h>         if m: apps.add(m.group(1))
[?2004l[?2004h>     print("  HostApps:", [a[:100] for a in apps])
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
[?2004l[?2004h> EOF
