[?2004l[?2004h>         host1_count += 1
[?2004l[?2004h>     elif 'ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b' in msg:
[?2004l[?2004h>         host2_count += 1
[?2004l[?2004h>         m = re.search(r'HostApplication=([^\r\n]+)', msg)
[?2004l[?2004h>         if m: host2_apps.add(m.group(1))
[?2004l[?2004h>     else:
[?2004l[?2004h>         no_host_count += 1
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Host bd39a342-b84b-499d-b35a-752ceae5484c events: {host1_count}")
