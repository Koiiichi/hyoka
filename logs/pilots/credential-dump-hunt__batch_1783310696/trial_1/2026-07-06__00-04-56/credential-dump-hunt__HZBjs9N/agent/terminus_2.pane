[?2004hroot@a7bd5d444754:~# cat << 'EOF' > find_guid.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Search for the GUID {297bc33e-65d0-5f2d-8207-000000000400}
[?2004l[?2004h> guid = "{297bc33e-65d0-5f2d-8207-000000000400}"
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, host, user, image, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE process_guid = ? 
[?2004l[?2004h>        OR message LIKE ?
[?2004l[?2004h> """, (guid, f"%{guid}%"))
[?2004l[?2004h> 
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} events associated with GUID {guid}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's count them by event_code
[?2004l[?2004h> counts = {}
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     code = r[1]
[?2004l[?2004h>     counts[code] = counts.get(code, 0) + 1
[?2004l[?2004h> print("Counts by Event Code:")
[?2004l[?2004h> for code, count in sorted(counts.items()):
[?2004l[?2004h>     print(f"Event Code {code}: {count}")
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
[?2004l[?2004h> EOF
