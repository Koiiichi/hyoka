[?2004hroot@a7bd5d444754:~# cat << 'EOF' > filter.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Get all Event Code 3 (Network)
[?2004l[?2004h> cursor.execute("SELECT event_id, host, user, image, src_ip, dst_ip, dst_port FROM events WHERE event_code = 3")
[?2004l[?2004h> with open('net_events.txt', 'w') as f:
[?2004l[?2004h>     for r in cursor.fetchall():
[?2004l[?2004h>         f.write(str(r) + '\n')
[?2004l[?2004h> 
[?2004l[?2004h> # Get all Event Code 11 (File Create)
[?2004l[?2004h> cursor.execute("SELECT event_id, host, user, image, message FROM events WHERE event_code = 11")
[?2004l[?2004h> with open('file_events.txt', 'w') as f:
[?2004l[?2004h>     for r in cursor.fetchall():
[?2004l[?2004h>         f.write(str(r) + '\n')
[?2004l[?2004h> 
[?2004l[?2004h> # Get Registry events (12, 13, 14)
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, host, user, image, message FROM events WHERE event_code IN (12, 13, 14)")
[?2004l[?2004h> with open('reg_events.txt', 'w') as f:
[?2004l[?2004h>     for r in cursor.fetchall():
[?2004l[?2004h>         f.write(str(r) + '\n')
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
[?2004l[?2004h> EOF
[?2004l[?2004hroot@a7bd5d444754:~# python3 filter.py
[?2004l[?2004hroot@a7bd5d444754:~# cat net_events.txt
