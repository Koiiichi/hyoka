[?2004hroot@a7bd5d444754:~# cat << 'EOF' > decode_and_find.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import base64
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's get all messages containing the base64 encoded block
[?2004l[?2004h> cursor.execute("SELECT event_id, host, user, message FROM events WHERE message LIKE '%-enc %'")
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} events containing '-enc '")
[?2004l[?2004h> 
[?2004l[?2004h> if rows:
[?2004l[?2004h>     # Try to extract the full base64 string across the whole database, or from the whoami event ParentCommandLine
[?2004l[?2004h>     cursor.execute("SELECT message FROM events WHERE event_id = 'evt-00282'")
[?2004l[?2004h>     whoami_msg = cursor.fetchone()[0]
[?2004l[?2004h>     # Find the ParentCommandLine inside whoami_msg
[?2004l[?2004h>     match = re.search(r'ParentCommandLine:.*-enc\s+([A-Za-z0-9+/=]+)', whoami_msg, re.IGNORECASE | re.DOTALL)
[?2004l[?2004h>     if match:
[?2004l[?2004h>         b64_str = match.group(1).strip()
[?2004l[?2004h>         b64_str = b64_str.replace('\n', '').replace('\r', '').replace(' ', '')
[?2004l[?2004h>         b64_str += '=' * ((4 - len(b64_str) % 4) % 4)
[?2004l[?2004h>         decoded = base64.b64decode(b64_str).decode('utf-16le', errors='ignore')
[?2004l[?2004h>         with open('/root/decoded_script.txt', 'w') as f:
[?2004l[?2004h>             f.write(decoded)
[?2004l[?2004h>         print("Successfully decoded script from whoami event and wrote to /root/decoded_script.txt")
[?2004l[?2004h>     else:
[?2004l[?2004h>         print("Could not find ParentCommandLine or base64 in event evt-00282")
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
