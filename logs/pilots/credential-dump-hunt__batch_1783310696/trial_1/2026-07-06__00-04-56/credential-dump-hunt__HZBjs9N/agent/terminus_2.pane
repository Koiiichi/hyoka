[?2004hroot@a7bd5d444754:~# cat << 'EOF' > find_all_ps_guids.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Find in message (since we don't have Process Create for powershell itself)
[?2004l[?2004h> # Let's search all Sysmon events (event_code < 100) for powershell.exe and extract process_guid
[?2004l[?2004h> cursor.execute("SELECT DISTINCT process_guid, image, message FROM events WHERE message LIKE '%powershell.exe%' AND event_code NOT IN (800, 4103)")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     guid = r[0]
[?2004l[?2004h>     img = r[1]
[?2004l[?2004h>     msg = r[2]
[?2004l[?2004h>     # Find ProcessGuid inside message
[?2004l[?2004h>     m = re.findall(r'ProcessGuid:\s*({[\w-]+})', msg, re.IGNORECASE)
[?2004l[?2004h>     m2 = re.findall(r'SourceProcessGUID:\s*({[\w-]+})', msg, re.IGNORECASE)
[?2004l[?2004h>     m3 = re.findall(r'TargetProcessGUID:\s*({[\w-]+})', msg, re.IGNORECASE)
[?2004l[?2004h>     guids = set(m + m2 + m3)
[?2004l[?2004h>     print(f"Image: {img}, GUIDs: {guids}")
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
[?2004l[?2004h> EOF
