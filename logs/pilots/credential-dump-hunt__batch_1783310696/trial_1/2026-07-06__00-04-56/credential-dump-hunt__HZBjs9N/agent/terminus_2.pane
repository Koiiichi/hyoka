[?2004l[?2004h> print(f"Events without these HostIds: {no_host_count}")
[?2004l[?2004h> print(f"Host 2 applications count: {len(host2_apps)}")
[?2004l[?2004h> for a in host2_apps:
[?2004l[?2004h>     print(f"Host 2 app: {a[:150]}")
