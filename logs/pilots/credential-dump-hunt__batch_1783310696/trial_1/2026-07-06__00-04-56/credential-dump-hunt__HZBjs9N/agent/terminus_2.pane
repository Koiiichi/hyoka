[?2004hroot@a7bd5d444754:~# cat << 'EOF' > get_unique_ps_guids.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> all_guids = set()
[?2004l[?2004h> cursor.execute("SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code NOT IN (800, 4103) AND (message LIKE '%powershell.exe%' OR image LIKE '%powershell.exe%' OR target_image LIKE '%powershell.exe%')")
[?2004l[?2004h> for row in cursor.fetchall():
[?2004l[?2004h>     msg = row[0]
[?2004l[?2004h>     # Extract any guid pattern
[?2004l[?2004h>     matches = re.findall(r'({[a-f0-9-]{36}})', msg, re.IGNORECASE)
[?2004l[?2004h>     for m in matches:
[?2004l[?2004h>         # Check if this guid is in a context related to powershell
[?2004l[?2004h>         all_guids.add(m.lower())
[?2004l[?2004h> 
[?2004l[?2004h> print("All GUIDs found in PowerShell-related messages on WS-05:", all_guids)
[?2004l[?2004h> conn.close()
