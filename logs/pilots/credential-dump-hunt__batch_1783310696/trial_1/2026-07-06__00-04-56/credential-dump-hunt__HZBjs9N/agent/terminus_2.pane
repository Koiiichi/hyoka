[?2004hroot@a7bd5d444754:~# cat << 'EOF' > check_event10.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Get all Event 10 on WS-05
[?2004l[?2004h> cursor.execute("SELECT event_id, image, target_image, granted_access, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 10")
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Total Event 10 on WS-05: {len(rows)}")
[?2004l[?2004h> 
[?2004l[?2004h> suspicious = []
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     eid, img, tgt, access, msg = r
[?2004l[?2004h>     # Check if powershell is either source or target
[?2004l[?2004h>     if 'powershell' in str(img).lower() or 'powershell' in str(tgt).lower():
[?2004l[?2004h>         suspicious.append(r)
[?2004l[?2004h>     elif 'whoami' in str(img).lower() or 'whoami' in str(tgt).lower():
[?2004l[?2004h>         suspicious.append(r)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Suspicious Event 10 on WS-05 (related to PS or whoami): {len(suspicious)}")
[?2004l[?2004h> # Let's see some non-suspicious Event 10 on WS-05 to see what they are
[?2004l[?2004h> non_suspicious = [r for r in rows if r not in suspicious]
[?2004l[?2004h> print(f"Non-suspicious Event 10: {len(non_suspicious)}")
[?2004l[?2004h> for r in non_suspicious[:10]:
[?2004l[?2004h>     print(r[0], r[1], r[2], r[3])
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
