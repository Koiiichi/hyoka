[363.086677, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\nwhoami_guid = '{297bc33e-660d-5f2d-8407-000000000400}'\ncursor.execute('SELECT event_id, event_code FROM events WHERE host = \\'WS-05.corp.example\\' AND (process_guid = ? OR message LIKE ?)', (whoami_guid, f'%{whoami_guid}%'))\nrows = cursor.fetchall()\nprint('Unique whoami events count:', len(rows))\ncounts = {}\nfor r in rows:\n    counts[r[1]] = counts.get(r[1], 0) + 1\nprint('By Event Code:', counts)\n\"\n"]
