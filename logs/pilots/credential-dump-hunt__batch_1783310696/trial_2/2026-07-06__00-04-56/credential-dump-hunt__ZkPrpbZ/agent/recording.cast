[23.323697, "i", "cat << 'EOF' > query_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute('SELECT event_id, event_code, host, user, image, target_image, message FROM events WHERE event_id IN (?, ?)', ('evt-00282', 'evt-00303'))\nfor row in cursor.fetchall():\n    print(f\"Event ID: {row[0]}, Event Code: {row[1]}, Host: {row[2]}, User: {row[3]}, Image: {row[4]}, Target: {row[5]}\\nMessage: {row[6][:500]}\\n\")\nEOF\npython3 query_events.py\n"]
