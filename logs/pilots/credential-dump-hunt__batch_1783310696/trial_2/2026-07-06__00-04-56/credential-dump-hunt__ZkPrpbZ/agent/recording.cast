[181.711122, "i", "cat << 'EOF' > check_pgustavo_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, user, image, target_image, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%')\n    ORDER BY timestamp ASC\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Events with pgustavo ({len(rows)}):\")\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5][:200].strip()}\\n\")\n\nEOF\npython3 check_pgustavo_events.py\n"]
