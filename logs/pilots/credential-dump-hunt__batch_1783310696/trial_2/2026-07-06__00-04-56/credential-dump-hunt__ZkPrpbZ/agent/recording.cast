[13.528577, "i", "cat << 'EOF' > explore.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's inspect event_codes and see how many we have for each\ncursor.execute(\"SELECT event_code, COUNT(*) FROM events GROUP BY event_code\")\nprint(\"Event codes:\", cursor.fetchall())\n\n# Let's see some process creation (event_code 1 or 4688)\ncursor.execute(\"SELECT event_id, host, user, image, message FROM events WHERE event_code IN (1, 4688)\")\nproc_events = cursor.fetchall()\nprint(f\"Process creation events ({len(proc_events)}):\")\nfor ev in proc_events[:30]:\n    print(ev[0], ev[1], ev[2], ev[3])\n\nEOF\npython3 explore.py\n"]
