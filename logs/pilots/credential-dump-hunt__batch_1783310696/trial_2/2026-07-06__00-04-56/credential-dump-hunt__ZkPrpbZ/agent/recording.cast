[99.511495, "i", "cat << 'EOF' > explore_ws05_processes.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's count events on WS-05 by image\ncursor.execute(\"\"\"\n    SELECT COALESCE(image, ''), COUNT(*)\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n    GROUP BY COALESCE(image, '')\n    ORDER BY COUNT(*) DESC\n\"\"\")\nprint(\"WS-05 event counts by image:\")\nfor r in cursor.fetchall():\n    print(f\"{r[1]:4d} | {r[0]}\")\n\nEOF\npython3 explore_ws05_processes.py\n"]
