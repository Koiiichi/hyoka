[136.533034, "i", "cat << 'EOF' > explore_ws05_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's inspect File Creation (Event Code 11) on WS-05\ncursor.execute(\"SELECT event_id, image, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 11\")\nrows = cursor.fetchall()\nprint(f\"File creation events on WS-05 ({len(rows)}):\")\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2][:300].strip()}\\n\")\n\n# Let's inspect Registry (Event Code 12, 13, 14) on WS-05 from powershell\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (12, 13, 14) AND (image LIKE '%powershell.exe' OR message LIKE '%powershell.exe%') LIMIT 10\")\nrows = cursor.fetchall()\nprint(f\"Registry events from PowerShell on WS-05 ({len(rows)}):\")\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2][:300].strip()}\\n\")\n\n# Let's check Named Pipes (Event Code 17, 18) on WS-05\ncursor.execute(\"SELECT event_id, event_code, image, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (17, 18)\")\nrows = cursor.fetchall()\nprint(f\"Named Pipe events on WS-05 ({len(rows)}):\")\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3][:300].strip()}\\n\")\n\nEOF\npython3 explore_ws05_details.py\n"]
