[286.325881, "i", "cat << 'EOF' > examine_non_union.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nmal_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\n\n# Get all event_ids in our current union\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (process_guid = ? OR message LIKE ?)\n\"\"\", (mal_guid, f'%{mal_guid}%'))\nguid_set = {r[0] for r in cursor.fetchall()}\n\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (message LIKE '%0x2BA622%' OR message LIKE '%0x2ba622%')\n\"\"\")\nlogon_set = {r[0] for r in cursor.fetchall()}\n\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE event_code IN (800, 4103)\n\"\"\")\nps_set = {r[0] for r in cursor.fetchall()}\n\nunion_set = guid_set.union(logon_set).union(ps_set)\n\n# Fetch all events on WS-05 NOT in union_set\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, COALESCE(image, ''), COALESCE(user, ''), message \n    FROM events \n    WHERE host = 'WS-05.corp.example'\n\"\"\")\nall_ws05 = cursor.fetchall()\nnon_union = [r for r in all_ws05 if r[0] not in union_set]\n\nprint(f\"Total non-union events on WS-05: {len(non_union)}\")\n\n# Count by event_code and image\ncounts = {}\nfor r in non_union:\n    key = (r[1], r[2], r[3])\n    counts[key] = counts.get(key, 0) + 1\n\nfor key, count in sorted(counts.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{count:4d} | Event Code: {key[0]} | Image: {key[1]} | User: {key[2]}\")\n\nEOF\npython3 examine_non_union.py\n"]
