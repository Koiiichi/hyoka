[29.591838, "i", "cat << 'EOF' > query_ps.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's search for keywords in message, or retrieve some 800/4103 messages\ncursor.execute(\"SELECT event_id, event_code, host, message FROM events WHERE event_code IN (800, 4103) LIMIT 100\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} PS events\")\n\n# Let's search for some patterns in messages\nkeywords = ['mimikatz', 'bypass', 'download', 'invoke', 'encoded', 'sc ', 'net ', 'ping', 'whoami', 'ipconfig', 'hostname', 'netstat', 'tasklist', 'reg ', 'schtasks', 'webclient', 'iex', 'exec', 'execute', 'token', 'privilege', 'lsass', 'sam', 'dump', 'procdump', 'mini', 'credential', 'hack', 'evil', 'reverse', 'shell', 'payload', 'meterpreter', 'cobalt', 'beacon', 'exploit', 'msf', 'empire', 'dnscat', 'bloodhound', 'sharphound', 'seatbelt', 'winpeas', 'powerup', 'powerview', 'laZagne', 'pypykatz', 'gppref', 'kerberoast', 'asreproast', 'rubeus', 'certutil']\n\nfor kw in keywords:\n    cursor.execute(\"SELECT event_id, event_code, host, user, image, target_image, message FROM events WHERE message LIKE ?\", (f'%{kw}%',))\n    res = cursor.fetchall()\n    if res:\n        print(f\"Keyword: {kw} -> {len(res)} matches\")\n        for r in res[:5]:\n            print(f\"  {r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5]} | {r[6][:200]}\")\n\nEOF\npython3 query_ps.py\n"]
