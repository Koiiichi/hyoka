[192.72974, "o", "\u001b[?2004hroot@2f72cdcef830:~# "]
[198.099578, "i", "cat << 'EOF' > summarize_pgustavo.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_code, COALESCE(image, ''), COUNT(*)\n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%')\n      AND event_code NOT IN (800, 4103)\n    GROUP BY event_code, COALESCE(image, '')\n\"\"\")\nprint(\"Summary of non-PS-log events with pgustavo:\")\nfor r in cursor.fetchall():\n    print(f\"{r[2]:4d} | Event Code: {r[0]} | Image: {r[1]}\")\n\nEOF\npython3 summarize_pgustavo.py\n"]
[198.100694, "o", "cat << 'EOF' > summarize_pgustavo.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_code, COALESCE(image, ''), COUNT(*)\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'WS-05.corp.example' \r\n\u001b[?2004l\r\u001b[?2004h>       AND (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%')\r\n\u001b[?2004l\r\u001b[?2004h>       AND event_code NOT IN (800, 4103)\r\n\u001b[?2004l\r\u001b[?2004h>     GROUP BY event_code, COALESCE(image, '')\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Summary of non-PS-log events with pgustavo:\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r[2]:4d} | Event Code: {r[0]} | Image: {r[1]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[198.101284, "o", "\u001b[?2004hroot@2f72cdcef830:~# python3 summarize_pgustavo.py\r\n\u001b[?2004l\r"]
