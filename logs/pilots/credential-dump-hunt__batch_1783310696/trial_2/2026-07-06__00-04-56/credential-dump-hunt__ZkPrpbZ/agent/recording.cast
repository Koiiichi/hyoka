[173.910023, "i", "cat << 'EOF' > check_ps_users.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103)\")\nusers = {}\nfor r in cursor.fetchall():\n    msg = r[0]\n    # Search for UserId=...\n    match = re.search(r\"UserId=(.*)\", msg)\n    if match:\n        u = match.group(1).strip()\n        users[u] = users.get(u, 0) + 1\n    else:\n        # Also try to look for other user indicators if present\n        pass\n\nprint(\"Users in PS events:\", users)\nEOF\npython3 check_ps_users.py\n"]
