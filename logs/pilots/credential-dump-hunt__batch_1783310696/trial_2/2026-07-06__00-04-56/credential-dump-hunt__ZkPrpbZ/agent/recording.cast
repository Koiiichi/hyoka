[298.404097, "i", "cat << 'EOF' > check_wfp_and_other_malicious.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Search for WFP events (5156, 5158) that mention powershell or PID 1648\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND event_code IN (5156, 5158)\n      AND (message LIKE '%powershell%' OR message LIKE '%1648%')\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"WFP events associated with malicious PowerShell ({len(rows)}):\")\nfor r in rows[:10]:\n    print(f\"{r[0]} | {r[1]} | {r[2][:150].strip()}\")\n\nEOF\npython3 check_wfp_and_other_malicious.py\n"]
