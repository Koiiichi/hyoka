[342.047911, "i", "cat << 'EOF' > check_remaining_singletons.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nsingletons = [\n    (\"event_code = 10 AND image LIKE '%csrss.exe'\"),\n    (\"event_code = 10 AND image LIKE '%conhost.exe'\"),\n    (\"event_code = 5 AND image LIKE '%WmiPrvSE.exe'\")\n]\nfor cond in singletons:\n    cursor.execute(f\"SELECT event_id, event_code, image, target_image, message FROM events WHERE host = 'WS-05.corp.example' AND {cond}\")\n    for r in cursor.fetchall():\n        print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4][:300].strip()}\\n\")\n\nEOF\npython3 check_remaining_singletons.py\n"]
