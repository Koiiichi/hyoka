[332.454717, "i", "cat << 'EOF' > check_lsass_event.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, image, target_image, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code = 10 AND image LIKE '%lsass.exe'\n\"\"\")\nrows = cursor.fetchall()\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4][:300].strip()}\")\nEOF\npython3 check_lsass_event.py\n"]
