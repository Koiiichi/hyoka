[50.459169, "i", "cat << 'EOF' > explore_powershell.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's search for the guid or pid\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, target_image, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND (message LIKE '%297bc33e-65d0-5f2d-8207-000000000400%' OR message LIKE '%1648%')\n    ORDER BY timestamp ASC\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} events for PowerShell on WS-05\")\nfor r in rows[:30]:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5]} | {r[6][:150].strip()}\")\n\nEOF\npython3 explore_powershell.py\n"]
