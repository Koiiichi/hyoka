[111.745302, "i", "cat << 'EOF' > check_pids.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's search for PowerShell process creations or any events of powershell\n# We saw earlier that we only have two process creation events (whoami), but we have other event codes for powershell like Sysmon event 12 (Registry), 3 (Network), 7 (Image load), etc.\n# Let's collect all ProcessGuids/PIDs of powershell.exe on WS-05.\ncursor.execute(\"\"\"\n    SELECT DISTINCT process_guid\n    FROM events\n    WHERE host = 'WS-05.corp.example' \n      AND (image LIKE '%powershell.exe' OR target_image LIKE '%powershell.exe')\n\"\"\")\nguids = [r[0] for r in cursor.fetchall() if r[0]]\nprint(\"PowerShell process guids from Sysmon:\", guids)\n\n# Let's also check if there are other PIDs in Event 800/4103\n# Let's search for \"HostId\" or \"ProcessId\" or \"HostName\" in 800/4103 messages on WS-05\ncursor.execute(\"SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 800 LIMIT 10\")\nfor r in cursor.fetchall():\n    print(r[0][:200])\n\nEOF\npython3 check_pids.py\n"]
