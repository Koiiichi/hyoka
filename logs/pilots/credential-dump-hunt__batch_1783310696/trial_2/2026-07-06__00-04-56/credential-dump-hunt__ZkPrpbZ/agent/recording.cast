[118.039445, "i", "cat << 'EOF' > check_other_guids.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nfor guid in ['{297bc33e-5c2e-5f2b-0c00-000000000400}', '{297bc33e-5c31-5f2b-2b00-000000000400}']:\n    print(f\"\\n--- Events for GUID {guid} ---\")\n    cursor.execute(\"\"\"\n        SELECT event_id, event_code, timestamp, image, target_image, message \n        FROM events \n        WHERE host = 'WS-05.corp.example' \n          AND (process_guid = ? OR message LIKE ?)\n        ORDER BY timestamp ASC\n    \"\"\", (guid, f'%{guid}%'))\n    rows = cursor.fetchall()\n    print(f\"Found {len(rows)} events\")\n    for r in rows[:10]:\n        print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5][:150].strip()}\")\n\nEOF\npython3 check_other_guids.py\n"]
