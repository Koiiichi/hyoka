[314.750815, "i", "cat << 'EOF' > check_dll_loads.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Group and count Event 7 on WS-05 by loading process\ncursor.execute(\"\"\"\n    SELECT COALESCE(image, ''), COUNT(*)\n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code = 7\n    GROUP BY COALESCE(image, '')\n\"\"\")\nprint(\"DLL loads on WS-05 by Image:\")\nfor r in cursor.fetchall():\n    print(f\"{r[1]:4d} | {r[0]}\")\n\nEOF\npython3 check_dll_loads.py\n"]
