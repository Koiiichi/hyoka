[62.702889, "i", "cat << 'EOF' > parse_all_hosts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's search for connections to 10.10.10.5 on all machines\ncursor.execute(\"SELECT DISTINCT host, image, event_code FROM events WHERE dst_ip = '10.10.10.5'\")\nprint(\"Connections to C2:\", cursor.fetchall())\n\n# Let's search for Event Code 3 on WS-06\ncursor.execute(\"SELECT event_id, image, dst_ip, dst_port, timestamp FROM events WHERE host = 'WS-06.corp.example' AND event_code = 3\")\nprint(\"WS-06 network connections:\", cursor.fetchall())\n\n# Let's look at Event Code 10 (ProcessAccess) on WS-05, WS-06, DC01\n# Often ProcessAccess to lsass.exe is malicious (Mimikatz, etc.)\ncursor.execute(\"SELECT event_id, host, image, target_image, granted_access, timestamp FROM events WHERE event_code = 10 AND target_image LIKE '%lsass.exe'\")\nprint(\"LSASS access:\", cursor.fetchall())\n\n# What other ProcessAccess target_images are there?\ncursor.execute(\"SELECT target_image, COUNT(*) FROM events WHERE event_code = 10 GROUP BY target_image\")\nprint(\"ProcessAccess targets:\", cursor.fetchall())\n\nEOF\npython3 parse_all_hosts.py\n"]
