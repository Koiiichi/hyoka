[232.098576, "i", "cat << 'EOF' > check_logon_id.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, user, message \n    FROM events \n    WHERE message LIKE '%0x2BA622%' OR message LIKE '%0x2ba622%'\n    ORDER BY timestamp ASC\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Events for Logon ID 0x2BA622 ({len(rows)}):\")\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4][:120].strip()}\")\n\nEOF\npython3 check_logon_id.py\n"]
[232.098859, "o", "cat << 'EOF' > check_logon_id.py\r\n\u001b[?2004l\r"]
[232.098979, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
