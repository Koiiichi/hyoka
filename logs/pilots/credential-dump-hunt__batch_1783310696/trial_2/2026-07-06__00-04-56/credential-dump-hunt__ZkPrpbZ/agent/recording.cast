[192.704732, "i", "cat << 'EOF' > check_explicit_user_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, user, image, target_image, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%')\n      AND event_code NOT IN (800, 4103)\n    ORDER BY timestamp ASC\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Non-PS-log events with pgustavo ({len(rows)}):\")\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5][:200].strip()}\\n\")\n\nEOF\npython3 check_explicit_user_events.py\n"]
