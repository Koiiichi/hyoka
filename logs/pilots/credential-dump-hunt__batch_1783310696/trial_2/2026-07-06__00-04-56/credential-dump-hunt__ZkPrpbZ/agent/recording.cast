[104.642201, "i", "cat << 'EOF' > explore_empty_images.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_code, COUNT(*)\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND (image IS NULL OR image = '')\n    GROUP BY event_code\n    ORDER BY COUNT(*) DESC\n\"\"\")\nprint(\"Empty image events by event_code:\")\nfor r in cursor.fetchall():\n    print(f\"{r[1]:4d} | {r[0]}\")\n\nEOF\npython3 explore_empty_images.py\n"]
