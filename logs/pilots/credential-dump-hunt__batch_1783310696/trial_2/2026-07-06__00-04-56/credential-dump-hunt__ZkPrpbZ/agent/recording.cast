[43.1682, "i", "cat << 'EOF' > explore_timeline.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's get the min and max timestamp\ncursor.execute(\"SELECT MIN(timestamp), MAX(timestamp) FROM events\")\nprint(\"Time range:\", cursor.fetchone())\n\n# Let's get the earliest events for each machine\nfor host in ['WS-05.corp.example', 'WS-06.corp.example', 'DC01.corp.example']:\n    print(f\"\\n--- Earliest events for {host} ---\")\n    cursor.execute(\"SELECT event_id, timestamp, event_code, channel, provider, user, image, target_image, message FROM events WHERE host = ? ORDER BY timestamp ASC LIMIT 20\", (host,))\n    for row in cursor.fetchall():\n        print(f\"{row[0]} | {row[1]} | {row[2]} | {row[3]} | {row[4]} | {row[5]} | {row[6]} | {row[7]} | {row[8][:100].strip()}\")\n\nEOF\npython3 explore_timeline.py\n"]
