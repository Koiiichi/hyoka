[83.209022, "o", "for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     # We want to find the New Logon details from message\r\n\u001b[?2004l\r\u001b[?2004h>     msg = r[3]\r\n\u001b[?2004l\r\u001b[?2004h>     target_user = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     target_domain = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     logon_type = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     ip = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     for line in msg.split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h>         if \"Account Name:\" in line and not \"-\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>             target_user = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if \"Account Domain:\" in line and not \"-\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>             target_domain = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if \"Logon Type:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>             logon_type = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if \"Source Network Address:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>             ip = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r[0]} | {r[1]} | {target_user} | {target_domain} | {logon_type} | {ip}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
