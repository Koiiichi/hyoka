[88.654063, "i", "cat << 'EOF' > explore_ws06.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Group by event_code on WS-06\ncursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host = 'WS-06.corp.example' GROUP BY event_code\")\nprint(\"WS-06 event codes:\", cursor.fetchall())\n\n# Let's list some process names or users on WS-06\ncursor.execute(\"SELECT DISTINCT user, image FROM events WHERE host = 'WS-06.corp.example'\")\nprint(\"WS-06 users/images:\")\nfor r in cursor.fetchall():\n    print(r)\n\nEOF\npython3 explore_ws06.py\n"]
