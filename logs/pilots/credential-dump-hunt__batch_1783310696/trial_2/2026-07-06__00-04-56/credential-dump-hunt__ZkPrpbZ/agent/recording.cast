[167.47623, "i", "cat << 'EOF' > check_users.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"SELECT COALESCE(user, ''), COUNT(*) FROM events WHERE host = 'WS-05.corp.example' GROUP BY COALESCE(user, '')\")\nprint(\"WS-05 events by User:\")\nfor r in cursor.fetchall():\n    print(f\"{r[1]:4d} | {r[0]}\")\nEOF\npython3 check_users.py\n"]
