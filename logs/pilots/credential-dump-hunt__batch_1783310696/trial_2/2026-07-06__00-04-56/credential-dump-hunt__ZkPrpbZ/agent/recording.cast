[204.64101, "i", "cat << 'EOF' > explore_suspicious_security.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, user, image, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%')\n      AND event_code IN (4656, 4658, 4663, 4673, 4688, 4689, 4690)\n    ORDER BY timestamp ASC\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Suspicious Security events on WS-05 ({len(rows)}):\")\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4][:250].strip()}\\n\")\n\nEOF\npython3 explore_suspicious_security.py\n"]
