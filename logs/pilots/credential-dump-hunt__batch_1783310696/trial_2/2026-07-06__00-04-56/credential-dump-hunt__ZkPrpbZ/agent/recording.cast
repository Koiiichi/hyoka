[308.398134, "i", "cat << 'EOF' > count_malicious_wfp.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# We'll search for 5156/5158 on WS-05 where the message contains \"Process ID:             1648\" or \"1648\" and \"powershell\"\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND event_code IN (5156, 5158)\n      AND (message LIKE '%Process ID:%1648%' OR (message LIKE '%1648%' AND message LIKE '%powershell%'))\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Malicious WFP events for PID 1648: {len(rows)}\")\nfor r in rows[:10]:\n    print(f\"{r[0]} | {r[1]} | {r[2][:150].strip()}\")\n\nEOF\npython3 count_malicious_wfp.py\n"]
