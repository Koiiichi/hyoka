[77.655122, "i", "cat << 'EOF' > explore_lateral.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Search for pgustavo on DC01\ncursor.execute(\"SELECT event_id, event_code, host, user, message FROM events WHERE user LIKE '%pgustavo%' AND host != 'WS-05.corp.example'\")\nprint(\"pgustavo on other hosts:\", cursor.fetchall())\n\n# Let's search for remote login events, or SMB connection events, on DC01 or WS-06\ncursor.execute(\"SELECT event_id, event_code, host, user, message FROM events WHERE event_code IN (4624, 4625, 4648, 4776, 5140, 5145) AND host != 'WS-05.corp.example'\")\nrows = cursor.fetchall()\nprint(f\"Logon/Share events on other hosts ({len(rows)}):\")\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4][:300].strip()}\\n\")\n\nEOF\npython3 explore_lateral.py\n"]
