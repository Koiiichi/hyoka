[244.428152, "i", "cat << 'EOF' > list_logon_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, timestamp, message \n    FROM events \n    WHERE message LIKE '%0x2BA622%' OR message LIKE '%0x2ba622%'\n    ORDER BY timestamp ASC\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Total: {len(rows)}\")\nfor r in rows:\n    # let's extract the first non-empty line after \"Subject\" or object name\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]}\")\n\nEOF\npython3 list_logon_events.py > logon_id_events.txt\ncat logon_id_events.txt\n"]
