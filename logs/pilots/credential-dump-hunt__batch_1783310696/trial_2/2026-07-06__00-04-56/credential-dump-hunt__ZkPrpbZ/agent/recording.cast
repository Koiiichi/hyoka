[351.308251, "i", "cat << 'EOF' > check_whoami_all.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nwhoami_guid = '{297bc33e-660d-5f2d-8407-000000000400}'\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, image, target_image, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (process_guid = ? OR message LIKE ?)\n    ORDER BY timestamp ASC\n\"\"\", (whoami_guid, f'%{whoami_guid}%'))\nrows = cursor.fetchall()\nprint(f\"All events for whoami's guid ({len(rows)}):\")\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4][:120].strip()}\")\n\nEOF\npython3 check_whoami_all.py\n"]
