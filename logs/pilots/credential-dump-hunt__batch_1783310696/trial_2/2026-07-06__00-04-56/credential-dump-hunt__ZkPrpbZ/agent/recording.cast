[277.885234, "i", "cat << 'EOF' > explore_timeline_all.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Get all events on WS-05\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, COALESCE(image, ''), COALESCE(user, ''), message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n    ORDER BY timestamp ASC\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Total WS-05 events: {len(rows)}\")\n\n# Let's count how many we have of each type\nfor r in rows:\n    # check if this event is in our current union\n    # union of guid_set, logon_set, ps_set\n    pass\n\nEOF\npython3 explore_timeline_all.py\n"]
