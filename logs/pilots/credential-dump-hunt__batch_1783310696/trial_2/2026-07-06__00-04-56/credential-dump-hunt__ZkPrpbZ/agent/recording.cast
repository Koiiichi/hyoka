[56.036383, "i", "cat << 'EOF' > explore_network.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, host, user, image, src_ip, dst_ip, dst_port, timestamp \n    FROM events \n    WHERE event_code = 3\n    ORDER BY timestamp ASC\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} Event 3 network connections:\")\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} -> {r[5]}:{r[6]} | {r[7]}\")\n\nEOF\npython3 explore_network.py\n"]
