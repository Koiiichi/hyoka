[260.374751, "i", "cat << 'EOF' > compile_malicious.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Malicious Process GUID\nmal_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\n\n# 1. Sysmon and other events where the process_guid matches directly, or is mentioned in the message\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, image, target_image\n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (process_guid = ? OR message LIKE ?)\n\"\"\", (mal_guid, f'%{mal_guid}%'))\nguid_events = cursor.fetchall()\nprint(f\"Direct Guid matches: {len(guid_events)}\")\n\n# 2. PowerShell Event 800 and 4103. Are there any on other machines? We saw they are only on WS-05 earlier\ncursor.execute(\"SELECT COUNT(*) FROM events WHERE event_code IN (800, 4103)\")\nps_events_count = cursor.fetchone()[0]\nprint(f\"Total PowerShell 800/4103 events in DB: {ps_events_count}\")\n\n# 3. Security events with Logon ID 0x2BA622\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (message LIKE '%0x2BA622%' OR message LIKE '%0x2ba622%')\n\"\"\")\nlogon_events = cursor.fetchall()\nprint(f\"Logon ID events: {len(logon_events)}\")\n\nEOF\npython3 compile_malicious.py\n"]
