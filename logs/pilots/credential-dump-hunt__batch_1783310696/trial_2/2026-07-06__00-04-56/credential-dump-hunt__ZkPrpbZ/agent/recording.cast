[363.107524, "o", "\u001b[?2004hroot@2f72cdcef830:~# "]
[376.779588, "i", "cat << 'EOF' > check_final_union.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nps_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\nwhoami_guid = '{297bc33e-660d-5f2d-8407-000000000400}'\nlogon_id = '0x2BA622'\nps_pid = '1648'\n\n# 1. PowerShell GUID set\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND (process_guid = ? OR message LIKE ?)\", (ps_guid, f'%{ps_guid}%'))\nps_guid_set = {r[0] for r in cursor.fetchall()}\n\n# 2. Whoami GUID set\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND (process_guid = ? OR message LIKE ?)\", (whoami_guid, f'%{whoami_guid}%'))\nwhoami_guid_set = {r[0] for r in cursor.fetchall()}\n\n# 3. PS log set\ncursor.execute(\"SELECT event_id FROM events WHERE event_code IN (800, 4103)\")\nps_log_set = {r[0] for r in cursor.fetchall()}\n\n# 4. Logon set\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND (message LIKE ? OR message LIKE ?)\", (f'%{logon_id}%', f'%{logon_id.lower()}%'))\nlogon_set = {r[0] for r in cursor.fetchall()}\n\n# 5. WFP set\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND event_code IN (5156, 5158)\n      AND (message LIKE '%Process ID:%1648%' OR (message LIKE '%1648%' AND message LIKE '%powershell%'))\n\"\"\")\nwfp_set = {r[0] for r in cursor.fetchall()}\n\n# 6. Prefetch set\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code = 11 AND message LIKE '%WHOAMI%'\")\nprefetch_set = {r[0] for r in cursor.fetchall()}\n\nfinal_union = ps_guid_set.union(whoami_guid_set).union(ps_log_set).union(logon_set).union(wfp_set).union(prefetch_set)\nprint(\"Final union size:\", len(final_union))\n\n# Let's see what is still not in final_union on WS-05\ncursor.execute(\"SELECT event_id, event_code, COALESCE(image, ''), COALESCE(user, ''), message FROM events WHERE host = 'WS-05.corp.example'\")\nall_ws05 = cursor.fetchall()\nremaining = [r for r in all_ws05 if r[0] not in final_union]\nprint(\"Remaining non-union size:\", len(remaining))\n\ncounts = {}\nfor r in remaining:\n    key = (r[1], r[2], r[3])\n    counts[key] = counts.get(key, 0) + 1\n\nfor key, count in sorted(counts.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{count:4d} | Event Code: {key[0]} | Image: {key[1]} | User: {key[2]}\")\n\nEOF\npython3 check_final_union.py\n"]
