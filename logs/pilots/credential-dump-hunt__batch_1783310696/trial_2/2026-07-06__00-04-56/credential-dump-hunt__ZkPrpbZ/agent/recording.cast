[83.206874, "i", "cat << 'EOF' > parse_logons.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's extract logon details\ncursor.execute(\"SELECT event_id, host, user, message FROM events WHERE event_code = 4624 AND host = 'DC01.corp.example'\")\nfor r in cursor.fetchall():\n    # We want to find the New Logon details from message\n    msg = r[3]\n    target_user = \"\"\n    target_domain = \"\"\n    logon_type = \"\"\n    ip = \"\"\n    for line in msg.split('\\n'):\n        if \"Account Name:\" in line and not \"-\" in line:\n            target_user = line.strip()\n        if \"Account Domain:\" in line and not \"-\" in line:\n            target_domain = line.strip()\n        if \"Logon Type:\" in line:\n            logon_type = line.strip()\n        if \"Source Network Address:\" in line:\n            ip = line.strip()\n    print(f\"{r[0]} | {r[1]} | {target_user} | {target_domain} | {logon_type} | {ip}\")\n\nEOF\npython3 parse_logons.py\n"]
