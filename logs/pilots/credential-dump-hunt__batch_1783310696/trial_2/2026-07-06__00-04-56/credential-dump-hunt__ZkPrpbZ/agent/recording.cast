[268.793233, "i", "cat << 'EOF' > check_overlap.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nmal_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\n\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (process_guid = ? OR message LIKE ?)\n\"\"\", (mal_guid, f'%{mal_guid}%'))\nguid_set = {r[0] for r in cursor.fetchall()}\n\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (message LIKE '%0x2BA622%' OR message LIKE '%0x2ba622%')\n\"\"\")\nlogon_set = {r[0] for r in cursor.fetchall()}\n\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE event_code IN (800, 4103)\n\"\"\")\nps_set = {r[0] for r in cursor.fetchall()}\n\nprint(\"Guid set size:\", len(guid_set))\nprint(\"Logon set size:\", len(logon_set))\nprint(\"PS set size:\", len(ps_set))\n\nintersection_guid_logon = guid_set.intersection(logon_set)\nprint(\"Intersection of Guid and Logon set:\", len(intersection_guid_logon))\nfor ev in sorted(intersection_guid_logon):\n    print(ev)\n\nintersection_guid_ps = guid_set.intersection(ps_set)\nprint(\"Intersection of Guid and PS set:\", len(intersection_guid_ps))\n\nintersection_logon_ps = logon_set.intersection(ps_set)\nprint(\"Intersection of Logon and PS set:\", len(intersection_logon_ps))\n\nEOF\npython3 check_overlap.py\n"]
[268.794423, "o", "cat << 'EOF' > check_overlap.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> mal_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'WS-05.corp.example' \r\n\u001b[?2004l\r\u001b[?2004h"]
[268.794445, "o", "> "]
[268.794562, "o", "      AND (process_guid = ? OR message LIKE ?)\r\n\u001b[?2004l\r\u001b[?2004h> "]
