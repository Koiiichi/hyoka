[4.268989, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute('SELECT COUNT(*) FROM events')\nprint('Total events:', cursor.fetchone()[0])\ncursor.execute('SELECT host, COUNT(*) FROM events GROUP BY host')\nprint('Hosts:', cursor.fetchall())\ncursor.execute('SELECT event_code, COUNT(*) FROM events GROUP BY event_code ORDER BY COUNT(*) DESC')\nprint('Event codes:', cursor.fetchall()[:20])\n\"\n"]
