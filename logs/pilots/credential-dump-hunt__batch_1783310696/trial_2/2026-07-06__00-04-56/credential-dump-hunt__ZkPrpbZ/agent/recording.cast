[70.321143, "i", "cat << 'EOF' > parse_by_guid.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's search for events where process_guid is {297bc33e-65d0-5f2d-8207-000000000400}\n# or where the message contains this guid\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, target_image, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' \n           OR message LIKE '%{297bc33e-65d0-5f2d-8207-000000000400}%')\n    ORDER BY timestamp ASC\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} events directly associated with the PowerShell ProcessGuid:\")\nfor r in rows[:40]:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5]} | {r[6][:100].strip()}\")\n\n# Let's save all these event IDs to a list to check their total count\nguid_event_ids = [r[0] for r in rows]\nprint(f\"Total unique event IDs: {len(set(guid_event_ids))}\")\n\nEOF\npython3 parse_by_guid.py\n"]
