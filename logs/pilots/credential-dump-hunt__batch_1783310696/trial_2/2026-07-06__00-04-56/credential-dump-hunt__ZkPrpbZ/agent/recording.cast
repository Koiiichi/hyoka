[363.088187, "o", "\u001b[?2004h> rows = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> print('Unique whoami events count:', len(rows))\r\n\u001b[?2004l\r\u001b[?2004h> counts = {}\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     counts[r[1]] = counts.get(r[1], 0) + 1\r\n\u001b[?2004l\r\u001b[?2004h> print('By Event Code:', counts)\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
