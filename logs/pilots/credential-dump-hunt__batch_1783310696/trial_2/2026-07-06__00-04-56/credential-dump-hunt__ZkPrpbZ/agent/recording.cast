[325.1735, "i", "cat << 'EOF' > check_remaining_non_union.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nmal_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\n\n# Original sets\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (process_guid = ? OR message LIKE ?)\n\"\"\", (mal_guid, f'%{mal_guid}%'))\nguid_set = {r[0] for r in cursor.fetchall()}\n\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (message LIKE '%0x2BA622%' OR message LIKE '%0x2ba622%')\n\"\"\")\nlogon_set = {r[0] for r in cursor.fetchall()}\n\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE event_code IN (800, 4103)\n\"\"\")\nps_set = {r[0] for r in cursor.fetchall()}\n\n# New malicious sets\n# WFP events\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND event_code IN (5156, 5158)\n      AND (message LIKE '%Process ID:%1648%' OR (message LIKE '%1648%' AND message LIKE '%powershell%'))\n\"\"\")\nwfp_set = {r[0] for r in cursor.fetchall()}\n\n# Whoami events (Image loaded, process terminated)\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND image LIKE '%whoami.exe'\n\"\"\")\nwhoami_image_set = {r[0] for r in cursor.fetchall()}\n\n# Prefetch file\ncursor.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND event_code = 11 \n      AND message LIKE '%WHOAMI%'\n\"\"\")\nprefetch_set = {r[0] for r in cursor.fetchall()}\n\n# Combined malicious set\ncombined_malicious = guid_set.union(logon_set).union(ps_set).union(wfp_set).union(whoami_image_set).union(prefetch_set)\nprint(\"Combined malicious set size:\", len(combined_malicious))\n\n# Get all events on WS-05\ncursor.execute(\"SELECT event_id, event_code, COALESCE(image, ''), COALESCE(user, ''), message FROM events WHERE host = 'WS-05.corp.example'\")\nall_ws05 = cursor.fetchall()\nremaining_non_union = [r for r in all_ws05 if r[0] not in combined_malicious]\nprint(f\"Remaining non-union events: {len(remaining_non_union)}\")\n\ncounts = {}\nfor r in remaining_non_union:\n    key = (r[1], r[2], r[3])\n    counts[key] = counts.get(key, 0) + 1\n\nfor key, count in sorted(counts.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{count:4d} | Event Code: {key[0]} | Image: {key[1]} | User: {key[2]}\")\n\nEOF\npython3 check_remaining_non_union.py\n"]
