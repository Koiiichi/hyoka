[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's extract logon details
[?2004l[?2004h> cursor.execute("SELECT event_id, host, user, message FROM events WHERE event_code = 4624 AND host = 'DC01.corp.example'")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     # We want to find the New Logon details from message
[?2004l[?2004h>     msg = r[3]
[?2004l[?2004h>     target_user = ""
[?2004l[?2004h>     target_domain = ""
[?2004l[?2004h>     logon_type = ""
[?2004l[?2004h>     ip = ""
[?2004l[?2004h>     for line in msg.split('\n'):
[?2004l[?2004h>         if "Account Name:" in line and not "-" in line:
[?2004l[?2004h>             target_user = line.strip()
[?2004l[?2004h>         if "Account Domain:" in line and not "-" in line:
[?2004l[?2004h>             target_domain = line.strip()
[?2004l[?2004h>         if "Logon Type:" in line:
[?2004l[?2004h>             logon_type = line.strip()
[?2004l[?2004h>         if "Source Network Address:" in line:
[?2004l[?2004h>             ip = line.strip()
[?2004l[?2004h>     print(f"{r[0]} | {r[1]} | {target_user} | {target_domain} | {logon_type} | {ip}")
[?2004l[?2004h> 
