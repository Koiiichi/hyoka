[?2004hroot@2f72cdcef830:~# cat << 'EOF' > parse_by_guid.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search for events where process_guid is {297bc33e-65d0-5f2d-8207-000000000400}
[?2004l[?2004h> # or where the message contains this guid
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, user, image, target_image, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example' 
[?2004l[?2004h>       AND (process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' 
[?2004l[?2004h>            OR message LIKE '%{297bc33e-65d0-5f2d-8207-000000000400}%')
[?2004l[?2004h>     ORDER BY timestamp ASC
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} events directly associated with the PowerShell ProcessGuid:")
[?2004l[?2004h> for r in rows[:40]:
[?2004l[?2004h>     print(f"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5]} | {r[6][:100].strip()}")
[?2004l[?2004h> 
