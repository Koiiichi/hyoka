[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's extract command lines from event code 800 for WS-05
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE event_code = 800 AND host = 'WS-05.corp.example'
[?2004l[?2004h>     ORDER BY timestamp ASC
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Total 800 events on WS-05: {len(rows)}")
[?2004l[?2004h> 
[?2004l[?2004h> # We'll extract the command lines
[?2004l[?2004h> unique_cmdlines = {}
[?2004l[?2004h> for ev_id, ts, msg in rows:
[?2004l[?2004h>     # Find 'command line: ' or 'CommandName=' etc.
[?2004l[?2004h>     # Let's do a simple regex or substring
[?2004l[?2004h>     match = re.search(r"Pipeline execution details for command line:\s*(.*)", msg, re.DOTALL)
[?2004l[?2004h>     if match:
[?2004l[?2004h>         cmd = match.group(1).strip().split('\n')[0]
[?2004l[?2004h>         unique_cmdlines[cmd] = unique_cmdlines.get(cmd, 0) + 1
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Unique command lines count: {len(unique_cmdlines)}")
[?2004l[?2004h> for cmd, count in sorted(unique_cmdlines.items(), key=lambda x: x[1], reverse=True)[:50]:
[?2004l[?2004h>     print(f"{count:4d} | {cmd[:120]}")
