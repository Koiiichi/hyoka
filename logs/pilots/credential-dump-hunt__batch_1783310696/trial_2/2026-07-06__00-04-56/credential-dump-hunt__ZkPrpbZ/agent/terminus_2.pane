[?2004hroot@2f72cdcef830:~# cat << 'EOF' > parse_all_hosts.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search for connections to 10.10.10.5 on all machines
[?2004l[?2004h> cursor.execute("SELECT DISTINCT host, image, event_code FROM events WHERE dst_ip = '10.10.10.5'")
[?2004l[?2004h> print("Connections to C2:", cursor.fetchall())
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search for Event Code 3 on WS-06
[?2004l[?2004h> cursor.execute("SELECT event_id, image, dst_ip, dst_port, timestamp FROM events WHERE host = 'WS-06.corp.example' AND event_code = 3")
[?2004l[?2004h> print("WS-06 network connections:", cursor.fetchall())
[?2004l[?2004h> 
[?2004l[?2004h> # Let's look at Event Code 10 (ProcessAccess) on WS-05, WS-06, DC01
[?2004l[?2004h> # Often ProcessAccess to lsass.exe is malicious (Mimikatz, etc.)
[?2004l[?2004h> cursor.execute("SELECT event_id, host, image, target_image, granted_access, timestamp FROM events WHERE event_code = 10 AND target_image LIKE '%lsass.exe'")
[?2004l[?2004h> print("LSASS access:", cursor.fetchall())
[?2004l[?2004h> 
[?2004l[?2004h> # What other ProcessAccess target_images are there?
[?2004l[?2004h> cursor.execute("SELECT target_image, COUNT(*) FROM events WHERE event_code = 10 GROUP BY target_image")
[?2004l[?2004h> print("ProcessAccess targets:", cursor.fetchall())
[?2004l[?2004h> 
