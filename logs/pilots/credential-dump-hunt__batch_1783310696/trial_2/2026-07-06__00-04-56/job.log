Sending keys: ['cat << \'EOF\' > parse_ps.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncursor = conn.cursor()\n\n# Let\'s extract command lines from event code 800 for WS-05\ncursor.execute("""\n    SELECT event_id, timestamp, message \n    FROM events \n    WHERE event_code = 800 AND host = \'WS-05.corp.example\'\n    ORDER BY timestamp ASC\n""")\nrows = cursor.fetchall()\nprint(f"Total 800 events on WS-05: {len(rows)}")\n\n# We\'ll extract the command lines\nunique_cmdlines = {}\nfor ev_id, ts, msg in rows:\n    # Find \'command line: \' or \'CommandName=\' etc.\n    # Let\'s do a simple regex or substring\n    match = re.search(r"Pipeline execution details for command line:\\s*(.*)", msg, re.DOTALL)\n    if match:\n        cmd = match.group(1).strip().split(\'\\n\')[0]\n        unique_cmdlines[cmd] = unique_cmdlines.get(cmd, 0) + 1\n\nprint(f"Unique command lines count: {len(unique_cmdlines)}")\nfor cmd, count in sorted(unique_cmdlines.items(), key=lambda x: x[1], reverse=True)[:50]:\n    print(f"{count:4d} | {cmd[:120]}")\n\nEOF\npython3 parse_ps.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
