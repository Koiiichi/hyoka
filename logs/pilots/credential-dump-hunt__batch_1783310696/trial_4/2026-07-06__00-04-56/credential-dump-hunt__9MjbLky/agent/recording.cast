[20.405142, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[28.319418, "i", "cat << 'EOF' > /tmp/analyze_ps_unique.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's inspect the PowerShell Operational (4104 or 4103) events\nprint(\"=== Unique command/script block details from 4104 ===\")\nfor row in cursor.execute(\"SELECT event_id, event_code, host, message FROM events WHERE event_code = 4104\"):\n    print(f\"{row['event_id']} | {row['host']} | {row['message'][:200]}\")\n\n# Let's inspect other Sysmon events like Process Creation on other hosts or any other host than WS-05\nprint(\"\\n=== Sysmon Events on other hosts (DC01, WS-06) ===\")\nfor row in cursor.execute(\"SELECT event_id, event_code, host, user, image, message FROM events WHERE host != 'WS-05.corp.example' AND channel LIKE '%Sysmon%'\"):\n    print(f\"{row['event_id']} | {row['event_code']} | {row['host']} | {row['user']} | {row['image']} | {row['message'][:100]}\")\n\nEOF\npython3 /tmp/analyze_ps_unique.py\n"]
