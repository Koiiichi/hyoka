[88.759976, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[95.607683, "i", "cat << 'EOF' > /tmp/lsass_context_py3.py\nimport sqlite3\nfrom datetime import datetime\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ndef parse_ts(t):\n    return datetime.strptime(t.replace('Z', ''), '%Y-%m-%dT%H:%M:%S.%f')\n\nstart_dt = parse_ts('2026-05-06T14:32:50.000')\nend_dt = parse_ts('2026-05-06T14:33:00.000')\n\nprint(\"=== Non-trivial events around LSASS access ===\")\nquery = \"SELECT event_id, timestamp, event_code, channel, host, user, image, message FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp ASC\"\nfor r in cursor.execute(query):\n    r_dt = parse_ts(r['timestamp'])\n    if start_dt <= r_dt <= end_dt:\n        if r['event_code'] in (5156, 5158, 4656, 4658, 4663, 4690):\n            continue\n        msg = r['message'] or ''\n        # Filter out very repetitive/boring lines\n        if \"Pipeline execution details for command line: .\" in msg:\n            continue\n        if \"Pipeline execution details for command line:    .\" in msg:\n            continue\n        if \"Provider \\\"\" in msg and \"is Started\" in msg:\n            continue\n        msg_clean = msg.replace('\\r', '').replace('\\n', ' ')\n        if len(msg_clean) > 180:\n            msg_clean = msg_clean[:180] + \"...\"\n        print(f\"{r['timestamp']} | {r['event_id']} | {r['event_code']} | {r['image']} | {msg_clean}\")\n\nEOF\npython3 /tmp/lsass_context_py3.py\n"]
[95.608053, "o", "cat << 'EOF' > /tmp/lsass_context_py3.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
[95.608092, "o", "\u001b[?2004h> from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
