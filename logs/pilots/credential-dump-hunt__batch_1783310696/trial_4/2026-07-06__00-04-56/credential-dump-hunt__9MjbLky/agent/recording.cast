[152.193415, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[160.955838, "i", "cat << 'EOF' > /tmp/collect_malicious.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nps_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\nwhoami_guid = '{297bc33e-660d-5f2d-8407-000000000400}'\n\nguids = [ps_guid, whoami_guid]\n\nprint(\"=== Collecting Sysmon and Security events for Malicious GUIDs ===\")\nevents = []\nfor row in cursor.execute(\"SELECT event_id, event_code, timestamp, host, user, image, process_guid, message FROM events\"):\n    msg = row['message'] or ''\n    # check if process_guid matches\n    p_guid = row['process_guid']\n    is_malicious = False\n    if p_guid in guids:\n        is_malicious = True\n    else:\n        # check if message contains either guid\n        for g in guids:\n            if g.lower() in msg.lower():\n                is_malicious = True\n                break\n                \n    if is_malicious:\n        events.append({\n            'event_id': row['event_id'],\n            'event_code': row['event_code'],\n            'timestamp': row['timestamp'],\n            'host': row['host'],\n            'image': row['image'],\n            'process_guid': p_guid or 'N/A',\n            'message_snippet': msg.replace('\\r', '').replace('\\n', ' ')[:100]\n        })\n\nprint(f\"Found {len(events)} events.\")\n# group by event code\ncodes = {}\nfor ev in events:\n    c = ev['event_code']\n    codes[c] = codes.get(c, 0) + 1\n\nprint(\"Event code counts:\")\nfor c, count in sorted(codes.items()):\n    print(f\"  Code {c}: {count}\")\n\nprint(\"\\nFirst 20 malicious events:\")\nfor ev in sorted(events, key=lambda x: x['timestamp'])[:20]:\n    print(f\"  {ev['timestamp']} | {ev['event_id']} | {ev['event_code']} | {ev['image']} | {ev['process_guid']} | {ev['message_snippet']}\")\n\nEOF\npython3 /tmp/collect_malicious.py\n"]
