[82.178431, "i", "cat << 'EOF' > /tmp/lsass_context_py.py\nimport sqlite3\nfrom datetime import datetime, timedelta\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nrow = cursor.execute(\"SELECT timestamp FROM events WHERE event_id = 'evt-02451'\").fetchone()\nts_str = row['timestamp']\nprint(f\"evt-02451 timestamp string: {ts_str}\")\n\n# Standardize formatting\n# '2026-05-06T14:32:57.589Z' -> datetime\ndef parse_ts(t):\n    return datetime.strptime(t.replace('Z', ''), '%Y-%m-%dT%H:%M:%S.%f')\n\nts_dt = parse_ts(ts_str)\nstart_dt = ts_dt - timedelta(seconds=10)\nend_dt = ts_dt + timedelta(seconds=10)\n\nprint(f\"Searching from {start_dt.isoformat()} to {end_dt.isoformat()}\")\n\nquery = \"SELECT event_id, timestamp, event_code, channel, host, user, image, message FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp ASC\"\nfor r in cursor.execute(query):\n    r_dt = parse_ts(r['timestamp'])\n    if start_dt <= r_dt <= end_dt:\n        msg = (r['message'] or '').replace('\\r', '').replace('\\n', ' ')[:120]\n        print(f\"{r['timestamp']} | {r['event_id']} | {r['event_code']} | {r['image']} | {msg}\")\n\nEOF\npython3 /tmp/lsass_context_py.py\n"]
