[177.24215, "i", "cat << 'EOF' > /tmp/scan_all_malicious.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Malicious Process GUIDs\nmalicious_guids = {'{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}'}\n\n# Malicious PIDs\nmalicious_pids = {'0x670', '0x1968', '1648', '6504'}  # 0x670 is 1648, 0x1968 is 6504\n\n# We will also search messages for these IDs/GUIDs\n\nmalicious_ids = set()\n\nprint(\"=== Starting Scan ===\")\nfor row in cursor.execute(\"SELECT event_id, event_code, timestamp, channel, host, user, image, process_guid, message FROM events\"):\n    msg = row['message'] or ''\n    ev_id = row['event_id']\n    p_guid = row['process_guid']\n    chan = row['channel'] or ''\n    \n    is_malicious = False\n    \n    # 1. Check if process guid matches\n    if p_guid in malicious_guids:\n        is_malicious = True\n        \n    # 2. Check if the message contains the GUIDs\n    if not is_malicious:\n        for g in malicious_guids:\n            if g.lower() in msg.lower():\n                is_malicious = True\n                break\n                \n    # 3. Check for Security events with the known process ID or creator process ID\n    if not is_malicious and chan == 'Security':\n        # Extract Process ID or Creator Process ID\n        # Usually listed as: Process ID:\t0x670 or Creator Process ID:\t0x670\n        pids_found = re.findall(r'Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg) + re.findall(r'Creator Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg)\n        for pid in pids_found:\n            # Normalise pid to hex or int\n            if pid.lower() in ('0x670', '1648', '0x1968', '6504'):\n                is_malicious = True\n                break\n                \n    # 4. What about PowerShell events?\n    # The PowerShell Operational logs have event_code = 4103 and channel = Microsoft-Windows-PowerShell/Operational\n    # and Windows PowerShell has event_code = 800\n    # Since the beacon is run by CORP\\pgustavo, let's verify if there are other PowerShell processes or if ALL\n    # powershell events on WS-05 under CORP\\pgustavo are the beacon.\n    # Wait, are there other powershell processes? Let's check. \n    # The only powershell process guid in the database is {297bc33e-65d0-5f2d-8207-000000000400}!\n    # So ALL PowerShell events on WS-05 in this window are from this same malicious process!\n    # Wait, let's check: are there any other powershell process GUIDs or hosts?\n    # We ran a GUID query earlier, and the only powershell process GUID was {297bc33e-65d0-5f2d-8207-000000000400}.\n    # This means ALL PowerShell (Operational or Engine) events in the database are from this single malicious beacon process!\n    # Let's double check if there are any other PowerShell events. No, they are all on WS-05.\n    if not is_malicious and ('PowerShell' in chan or 'PowerShell' in msg or 'powershell.exe' in (row['image'] or '').lower()):\n        is_malicious = True\n\n    if is_malicious:\n        malicious_ids.add(ev_id)\n\nprint(f\"Total malicious events identified: {len(malicious_ids)}\")\nEOF\npython3 /tmp/scan_all_malicious.py\n"]
