[165.99821, "o", "\u001b[01;31m\u001b[KFound\u001b[m\u001b[K 136 events.\r\n\u001b[01;31m\u001b[KEvent code counts:\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[K  Code\u001b[m\u001b[K 1: 1\r\n\u001b[01;31m\u001b[K  Code\u001b[m\u001b[K 3: 35\r\n\u001b[01;31m\u001b[K  Code\u001b[m\u001b[K 5: 1\r\n\u001b[01;31m\u001b[K  Code\u001b[m\u001b[K 7: 47\r\n\u001b[01;31m\u001b[K  Code\u001b[m\u001b[K 10: 7\r\n\u001b[01;31m\u001b[K  Code\u001b[m\u001b[K 12: 40\r\n\u001b[01;31m\u001b[K  Code\u001b[m\u001b[K 17: 2\r\n\u001b[01;31m\u001b[K  Code\u001b[m\u001b[K 18: 2\r\n\u001b[01;31m\u001b[K  Code\u001b[m\u001b[K 22: 1\r\n"]
