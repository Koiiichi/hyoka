[4.675526, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[8.654724, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Event Code Frequencies ===\")\nfor row in cursor.execute(\"SELECT event_code, count(*) as cnt FROM events GROUP BY event_code ORDER BY cnt DESC\"):\n    print(f\"Code {row['event_code']}: {row['cnt']}\")\n\nprint(\"\\n=== Sysmon Process Creation (Event Code 1) ===\")\nfor row in cursor.execute(\"SELECT event_id, host, user, image, message FROM events WHERE event_code = 1\"):\n    # let's extract some command line or message details\n    print(f\"{row['event_id']} | {row['host']} | {row['user']} | {row['image']}\")\n\nEOF\npython3 /tmp/analyze.py | head -n 100\n"]
[8.654971, "o", "cat << 'EOF' > /tmp/analyze.py\r\n\u001b[?2004l\r"]
