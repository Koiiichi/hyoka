[75.502124, "i", "cat << 'EOF' > /tmp/lsass_context.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's get the timestamp of evt-02451\nrow = cursor.execute(\"SELECT timestamp FROM events WHERE event_id = 'evt-02451'\").fetchone()\nts = row['timestamp']\nprint(f\"evt-02451 timestamp: {ts}\")\n\n# Let's find events on WS-05 around this timestamp\nquery = \"\"\"\nSELECT event_id, timestamp, event_code, channel, host, user, image, message \nFROM events \nWHERE host = 'WS-05.corp.example' \n  AND timestamp >= datetime(?, '-10 seconds') \n  AND timestamp <= datetime(?, '+10 seconds')\nORDER BY timestamp ASC\n\"\"\"\nfor r in cursor.execute(query, (ts, ts)):\n    msg = (r['message'] or '').replace('\\r', '').replace('\\n', ' ')[:150]\n    print(f\"{r['timestamp']} | {r['event_id']} | {r['event_code']} | {r['image']} | {msg}\")\n\nEOF\npython3 /tmp/lsass_context.py\n"]
