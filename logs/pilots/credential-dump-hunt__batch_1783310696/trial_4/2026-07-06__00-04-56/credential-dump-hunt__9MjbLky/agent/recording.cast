[133.829003, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[141.390592, "i", "cat << 'EOF' > /tmp/check_early_comp.py\nimport sqlite3\nfrom datetime import datetime\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ndef parse_ts(t):\n    return datetime.strptime(t.replace('Z', ''), '%Y-%m-%dT%H:%M:%S.%f')\n\nstart_dt = parse_ts('2026-05-06T14:32:25.000')\nend_dt = parse_ts('2026-05-06T14:32:46.000')\n\nprint(\"=== Early PowerShell/pgustavo Activity ===\")\nquery = \"\"\"\nSELECT event_id, timestamp, event_code, channel, host, user, image, message \nFROM events \nWHERE host = 'WS-05.corp.example' \n  AND (user LIKE '%pgustavo%' OR image LIKE '%powershell%' OR message LIKE '%pgustavo%' OR message LIKE '%powershell%')\nORDER BY timestamp ASC\n\"\"\"\nfor r in cursor.execute(query):\n    r_dt = parse_ts(r['timestamp'])\n    if start_dt <= r_dt <= end_dt:\n        if r['event_code'] in (5156, 5158, 4656, 4658, 4663, 4690):\n            continue\n        msg = (r['message'] or '').replace('\\r', '').replace('\\n', ' ')\n        if \"Pipeline execution details for command line: .\" in msg or \"Pipeline execution details for command line:    .\" in msg:\n            continue\n        if \"Provider \\\"\" in msg and \"is Started\" in msg:\n            continue\n        if len(msg) > 180:\n            msg = msg[:180] + \"...\"\n        print(f\"{r['timestamp']} | {r['event_id']} | {r['event_code']} | {r['image']} | {msg}\")\n\nEOF\npython3 /tmp/check_early_comp.py\n"]
