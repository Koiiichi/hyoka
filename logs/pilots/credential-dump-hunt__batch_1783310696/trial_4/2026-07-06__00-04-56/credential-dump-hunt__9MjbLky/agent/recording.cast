[45.38619, "o", "evt-00533|WS-05.corp.example||CIMWin32 provider started with result code 0x0. HostProcess = wmiprvse.exe; ProcessID = 1400; ProviderPath = %systemroot%\\system32\\wbem\\cimwin32.dll\r\n"]
[45.391552, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[50.550972, "i", "cat << 'EOF' > /tmp/parse_security.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== LOGINS ===\")\nfor row in cursor.execute(\"SELECT event_id, timestamp, host, message FROM events WHERE event_code IN (4624, 4625)\"):\n    msg = row['message'] or ''\n    # extract Account Name\n    acc_names = re.findall(r'Account Name:\\s+(\\S+)', msg)\n    logon_type = re.search(r'Logon Type:\\s+(\\d+)', msg)\n    src_ip = re.search(r'Source Network Address:\\s+(\\S+)', msg)\n    lt = logon_type.group(1) if logon_type else \"N/A\"\n    sip = src_ip.group(1) if src_ip else \"N/A\"\n    print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | Accounts: {acc_names} | LogonType: {lt} | SrcIP: {sip}\")\n\nprint(\"\\n=== ALL OTHER SECURITY EVENTS ===\")\nfor row in cursor.execute(\"SELECT event_id, timestamp, event_code, host, message FROM events WHERE channel = 'Security' AND event_code NOT IN (4624, 4625) ORDER BY timestamp ASC\"):\n    msg_snippet = row['message'].replace('\\r', '').replace('\\n', ' ')[:120]\n    print(f\"{row['event_id']} | {row['timestamp']} | {row['event_code']} | {row['host']} | {msg_snippet}\")\n\nEOF\npython3 /tmp/parse_security.py\n"]
[50.551211, "o", "cat << 'EOF' > /tmp/parse_security.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
