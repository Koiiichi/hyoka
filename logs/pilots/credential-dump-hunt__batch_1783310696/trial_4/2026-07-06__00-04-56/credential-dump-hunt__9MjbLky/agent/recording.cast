[253.523845, "i", "cat << 'EOF' > /tmp/generate_findings.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmalicious_guids = {'{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}'}\n\nmalicious_ids = set()\n\nfor row in cursor.execute(\"SELECT event_id, event_code, channel, host, message, process_guid FROM events\"):\n    chan = row['channel'] or ''\n    # Only evaluate Security and Sysmon channels\n    if chan not in ('Security', 'Microsoft-Windows-Sysmon/Operational'):\n        continue\n        \n    msg = row['message'] or ''\n    p_guid = row['process_guid']\n    ev_id = row['event_id']\n    \n    is_malicious = False\n    if p_guid in malicious_guids:\n        is_malicious = True\n    if not is_malicious:\n        for g in malicious_guids:\n            if g.lower() in msg.lower():\n                is_malicious = True\n                break\n    if not is_malicious and chan == 'Security':\n        pids_found = re.findall(r'Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg) + re.findall(r'Creator Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg)\n        for pid in pids_found:\n            if pid.lower() in ('0x670', '1648', '0x1968', '6504'):\n                is_malicious = True\n                break\n                \n    if is_malicious:\n        malicious_ids.add(ev_id)\n\nprint(f\"Writing {len(malicious_ids)} malicious event IDs to /root/findings.json\")\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(malicious_ids)), f)\n\nEOF\npython3 /tmp/generate_findings.py\n"]
[253.524844, "o", "cat << 'EOF' > /tmp/generate_findings.py\r\n\u001b[?2004l\r"]
[253.524978, "o", "\u001b[?2004h> import sqlite3\r\n"]
[253.525155, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[253.525503, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.525732, "o", "conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.525871, "o", "malicious_guids = {'{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}'}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[253.525994, "o", "\u001b[?2004l\r"]
[253.526217, "o", "\u001b[?2004h> malicious_ids = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.526296, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.527007, "o", "for row in cursor.execute(\"SELECT event_id, event_code, channel, host, message, process_guid FROM events\"):\r\n\u001b[?2004l\r\u001b[?2004h>     chan = row['channel'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     # Only evaluate Security and Sysmon channels\r\n\u001b[?2004l\r\u001b[?2004h>     if chan not in ('Security', 'Microsoft-Windows-Sysmon/Operational'):\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     msg = row['message'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     p_guid = row['process_guid']\r\n\u001b[?2004l\r\u001b[?2004h>     ev_id = row['event_id']\r\n\u001b[?2004l\r"]
[253.527087, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.527346, "o", "    is_malicious = False\r\n\u001b[?2004l\r\u001b[?2004h>     if p_guid in malicious_guids:\r\n\u001b[?2004l\r"]
[253.527449, "o", "\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.527477, "o", "> "]
[253.527496, "o", "    if not is_malicious:\r\n\u001b[?2004l\r"]
[253.527554, "o", "\u001b[?2004h> "]
[253.527679, "o", "        for g in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h>             if g.lower() in msg.lower():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.527907, "o", "                is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.527944, "o", "    if not is_malicious and chan == 'Security':\r\n\u001b[?2004l\r"]
[253.528053, "o", "\u001b[?2004h> "]
[253.528645, "o", "        pids_found = re.findall(r'Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg) + re.findall(r'Creator Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.528755, "o", "> "]
[253.52882, "o", "        for pid in pids_found:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.52899, "o", "            if pid.lower() in ('0x670', '1648', '0x1968', '6504'):\r\n\u001b[?2004l\r\u001b[?2004h>                 is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.529046, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r"]
[253.529162, "o", "\u001b[?2004h>     if is_malicious:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(ev_id)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[253.529215, "o", "\u001b[?2004h> "]
[253.529299, "o", "print(f\"Writing {len(malicious_ids)} malicious event IDs to /root/findings.json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.529328, "o", "with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.529433, "o", "    json.dump(sorted(list(malicious_ids)), f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[253.530639, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[253.53075, "o", "python3 /tmp/generate_findings.py\r\n\u001b[?2004l\r"]
[253.562184, "o", "Writing 224 malicious event IDs to /root/findings.json\r\n"]
[253.564133, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[262.847721, "i", "cat /root/findings.json | head -n 100\n"]
[262.847941, "o", "cat /root/findings.json | head -n 100\r\n\u001b[?2004l\r"]
