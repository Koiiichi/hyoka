[95.608301, "o", "cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.608428, "o", "def parse_ts(t):\r\n\u001b[?2004l\r\u001b[?2004h>     return datetime.strptime(t.replace('Z', ''), '%Y-%m-%dT%H:%M:%S.%f')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.608547, "o", "start_dt = parse_ts('2026-05-06T14:32:50.000')\r\n\u001b[?2004l\r\u001b[?2004h> end_dt = parse_ts('2026-05-06T14:33:00.000')\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.608703, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== Non-trivial events around LSASS access ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.609016, "o", "query = \"SELECT event_id, timestamp, event_code, channel, host, user, image, message FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp ASC\"\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.execute(query):\r\n\u001b[?2004l\r\u001b[?2004h>     r_dt = parse_ts(r['timestamp'])"]
[95.609147, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     if start_dt <= r_dt <= end_dt:\r\n\u001b[?2004l\r\u001b[?2004h>         if r['event_code'] in (5156, 5158, 4656, 4658, 4663, 4690):\r\n"]
[95.609219, "o", "\u001b[?2004l\r"]
[95.60926, "o", "\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         msg = r['message'] or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.609364, "o", "        # Filter out very repetitive/boring lines\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.609467, "o", "        if \"Pipeline execution details for command line: .\" in msg:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.609626, "o", "        if \"Pipeline execution details for command line:    .\" in msg:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         if \"Provider \\\"\" in msg and \"is Started\" in msg:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.609832, "o", "        msg_clean = msg.replace('\\r', '').replace('\\n', ' ')\r\n\u001b[?2004l\r\u001b[?2004h>         if len(msg_clean) > 180:\r\n\u001b[?2004l\r\u001b[?2004h>             msg_clean = msg_clean[:180] + \"...\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.610021, "o", "        print(f\"{r['timestamp']} | {r['event_id']} | {r['event_code']} | {r['image']} | {msg_clean}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[95.610146, "o", "> EOF\r\n\u001b[?2004l\r"]
[95.611008, "o", "\u001b[?2004hroot@d5309541b381:~# python3 /tmp/lsass_context_py3.py\r\n\u001b[?2004l\r"]
[95.624248, "o", "=== Non-trivial events around LSASS access ===\r\n"]
