[210.505319, "i", "cat << 'EOF' > /tmp/check_security_malicious.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Security Channel Malicious Events ===\")\ncount = 0\nfor row in cursor.execute(\"SELECT event_id, event_code, timestamp, host, message FROM events WHERE channel = 'Security'\"):\n    msg = row['message'] or ''\n    # check for the known PIDs or GUIDs or images\n    pids_found = re.findall(r'Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg) + re.findall(r'Creator Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg)\n    is_mal_pid = False\n    for pid in pids_found:\n        if pid.lower() in ('0x670', '1648', '0x1968', '6504'):\n            is_mal_pid = True\n            break\n            \n    is_mal_text = False\n    for txt in ['whoami.exe', 'powershell.exe', '{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}']:\n        if txt.lower() in msg.lower():\n            is_mal_text = True\n            break\n            \n    if is_mal_pid or is_mal_text:\n        count += 1\n        print(f\"{row['event_id']} | {row['event_code']} | {row['timestamp']} | {row['host']} | PID matches: {is_mal_pid}, Text matches: {is_mal_text} | {msg[:100].replace('\\r', '').replace('\\n', ' ')}\")\n\nprint(f\"Total malicious Security events: {count}\")\nEOF\npython3 /tmp/check_security_malicious.py\n"]
[210.506199, "o", "cat << 'EOF' > /tmp/check_security_malicious.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
