[126.347596, "o", "\u001b[?2004h> FROM events \r\n\u001b[?2004l\r\u001b[?2004h> WHERE (message LIKE '%IMAGE_NT_HEADERS%' \r\n\u001b[?2004l\r\u001b[?2004h> "]
