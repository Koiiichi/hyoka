[107.389144, "i", "cat << 'EOF' > /tmp/find_ps_cmds.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Searching for PowerShell commands ===\")\nquery = \"\"\"\nSELECT event_id, event_code, host, message \nFROM events \nWHERE (channel LIKE '%PowerShell%' OR channel LIKE '%WMI%')\n  AND message NOT LIKE '%Start-Sleep%'\n  AND message NOT LIKE '%Get-Random%'\n  AND message NOT LIKE '%System.Net.WebClient%'\n  AND message NOT LIKE '%$55f%'\n  AND message NOT LIKE '%$IV%'\n  AND message NOT LIKE '%$AES%'\n  AND message NOT LIKE '%packet%'\n  AND message NOT LIKE '%ToCharArray%'\n  AND message NOT LIKE '%Remove-Variable%'\n  AND message NOT LIKE '%$taskURI%'\n  AND message NOT LIKE '%$Buffer%'\n  AND message NOT LIKE '%Provider \\\"%' \n  AND message NOT LIKE '%Engine state is changed%'\n\"\"\"\nfor row in cursor.execute(query):\n    msg = (row['message'] or '').replace('\\r', '').replace('\\n', ' ')\n    if len(msg) > 200:\n        msg = msg[:200] + \"...\"\n    print(f\"{row['event_id']} | {row['event_code']} | {row['host']} | {msg}\")\n\nEOF\npython3 /tmp/find_ps_cmds.py\n"]
[107.390128, "o", "cat << 'EOF' > /tmp/find_ps_cmds.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
