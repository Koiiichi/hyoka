[120.196307, "i", "cat << 'EOF' > /tmp/find_compromise_start.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Earliest PowerShell reflect/token events ===\")\nquery = \"\"\"\nSELECT event_id, timestamp, event_code, message \nFROM events \nWHERE (message LIKE '%IMAGE_NT_HEADERS%' \n   OR message LIKE '%MyDelegateType%' \n   OR message LIKE '%TOKEN_PRIVILEGES%' \n   OR message LIKE '%LUID_AND_ATTRIBUTES%')\nORDER BY timestamp ASC\nLIMIT 10\n\"\"\"\nfor row in cursor.execute(query):\n    print(f\"{row['timestamp']} | {row['event_id']} | {row['event_code']} | {row['message'][:150].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/find_compromise_start.py\n"]
