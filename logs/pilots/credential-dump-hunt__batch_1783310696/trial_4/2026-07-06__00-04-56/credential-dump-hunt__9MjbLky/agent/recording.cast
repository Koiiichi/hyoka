[28.345115, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[35.291401, "i", "cat << 'EOF' > /tmp/timeline.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's see some basic info about whoami, powershell creation, etc.\nprint(\"=== TIMELINE ===\")\nquery = \"\"\"\nSELECT event_id, timestamp, event_code, channel, host, user, image, message \nFROM events \nWHERE event_code IN (1, 3, 4688, 4624, 4625) \nORDER BY timestamp ASC\n\"\"\"\nfor row in cursor.execute(query):\n    msg_snippet = (row['message'] or '').replace('\\r', '').replace('\\n', ' ')[:100]\n    print(f\"{row['timestamp']} | {row['event_id']} | {row['event_code']} | {row['host']} | {row['user']} | {row['image']} | {msg_snippet}\")\n\nEOF\npython3 /tmp/timeline.py\n"]
[35.291712, "o", "cat << 'EOF' > /tmp/timeline.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
