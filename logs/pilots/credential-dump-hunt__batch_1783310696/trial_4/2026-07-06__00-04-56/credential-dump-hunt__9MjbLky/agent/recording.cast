[62.016146, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[68.266289, "i", "cat << 'EOF' > /tmp/inspect_others.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Sysmon 11 (File Creation) on DC01 and WS-06 ===\")\nfor row in cursor.execute(\"SELECT event_id, host, image, message FROM events WHERE event_code = 11 AND host != 'WS-05.corp.example'\"):\n    print(f\"{row['event_id']} | {row['host']} | {row['image']} | {row['message'].replace('\\r', '').replace('\\n', ' ')[:150]}\")\n\nprint(\"\\n=== Sysmon 12/13/14 (Registry) on DC01 and WS-06 ===\")\nfor row in cursor.execute(\"SELECT event_id, event_code, host, image, message FROM events WHERE event_code IN (12, 13, 14) AND host != 'WS-05.corp.example'\"):\n    print(f\"{row['event_id']} | {row['event_code']} | {row['host']} | {row['image']} | {row['message'].replace('\\r', '').replace('\\n', ' ')[:150]}\")\n\nprint(\"\\n=== Sysmon 10 (Process Access) where Target is LSASS ===\")\nfor row in cursor.execute(\"SELECT event_id, host, image, target_image, granted_access FROM events WHERE event_code = 10 AND target_image LIKE '%lsass.exe%'\"):\n    print(f\"{row['event_id']} | {row['host']} | {row['image']} -> {row['target_image']} ({row['granted_access']})\")\n\nEOF\npython3 /tmp/inspect_others.py\n"]
