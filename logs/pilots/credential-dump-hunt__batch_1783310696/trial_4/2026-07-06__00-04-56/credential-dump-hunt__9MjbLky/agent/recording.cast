[107.645195, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[113.716677, "i", "cat << 'EOF' > /tmp/find_ps_cmds2.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's define exclusions\nexclusions = [\n    'Start-Sleep', 'Get-Random', 'System.Net.WebClient', '$55f', '$IV', '$AES', 'packet',\n    'ToCharArray', 'Remove-Variable', '$taskURI', '$Buffer', 'Provider \\\"', 'Engine state is changed',\n    'ForEach-Object', '0..255', 'System.Security.Cryptography', 'Compare-Object', 'SyncWindow',\n    'BeginInvoke', '$script:Headers', 'PSDataCollection', '$RandName', 'get.php', 'ParameterBinding(New-Object)'\n]\n\nprint(\"=== Unique and Interesting PowerShell Events ===\")\nquery = \"SELECT event_id, event_code, host, message FROM events WHERE (channel LIKE '%PowerShell%' OR channel LIKE '%WMI%')\"\ncount = 0\nfor row in cursor.execute(query):\n    msg = row['message'] or ''\n    skip = False\n    for excl in exclusions:\n        if excl in msg:\n            skip = True\n            break\n    if skip:\n        continue\n    \n    msg_clean = msg.replace('\\r', '').replace('\\n', ' ')\n    if len(msg_clean) > 180:\n        msg_clean = msg_clean[:180] + \"...\"\n    print(f\"{row['event_id']} | {row['event_code']} | {row['host']} | {msg_clean}\")\n    count += 1\n\nprint(f\"Total interesting events: {count}\")\nEOF\npython3 /tmp/find_ps_cmds2.py\n"]
[113.717042, "o", "cat << 'EOF' > /tmp/find_ps_cmds2.py\r\n\u001b[?2004l\r"]
