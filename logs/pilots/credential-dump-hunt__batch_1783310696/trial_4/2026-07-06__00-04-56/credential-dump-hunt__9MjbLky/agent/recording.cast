[14.507105, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[20.326594, "i", "cat << 'EOF' > /tmp/analyze_ps.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Non-standard PowerShell Events ===\")\n# Let's search for interesting strings in the message field of PowerShell logs\nsearch_terms = ['bypass', 'iex', 'invoke', 'download', 'encoded', 'secure', 'payload', 'http', 'whoami', 'token', 'mimikatz', 'reflect', 'lsass', 'sam', 'system', 'shadow', 'vss', 'ticket', 'kerberos']\n\nquery = \"SELECT event_id, event_code, channel, host, message FROM events WHERE (channel LIKE '%PowerShell%' OR channel LIKE '%WMI%')\"\nresults = []\nfor row in cursor.execute(query):\n    msg = row['message'] or ''\n    for term in search_terms:\n        if term.lower() in msg.lower():\n            results.append((row['event_id'], row['event_code'], row['channel'], row['host'], msg))\n            break\n\nprint(f\"Found {len(results)} potentially interesting PowerShell events.\")\nfor ev_id, code, chan, host, msg in results[:50]:\n    # Summarize the message\n    summary = msg.replace('\\r', '').replace('\\n', ' ')[:120]\n    print(f\"{ev_id} | {code} | {chan} | {host} | {summary}\")\n\nEOF\npython3 /tmp/analyze_ps.py\n"]
