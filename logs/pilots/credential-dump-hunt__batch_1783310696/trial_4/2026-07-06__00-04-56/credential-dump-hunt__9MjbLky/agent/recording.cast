[210.552355, "o", "\u001b[?2004hroot@d5309541b381:~# "]
[221.222243, "i", "cat << 'EOF' > /tmp/malicious_sec_sysmon.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Malicious Process GUIDs\nmalicious_guids = {'{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}'}\n\nprint(\"=== Malicious Events in Security and Sysmon ===\")\nmal_events = []\nfor row in cursor.execute(\"SELECT event_id, event_code, channel, host, user, image, process_guid, message FROM events WHERE channel IN ('Security', 'Microsoft-Windows-Sysmon/Operational')\"):\n    msg = row['message'] or ''\n    p_guid = row['process_guid']\n    chan = row['channel']\n    \n    is_malicious = False\n    if p_guid in malicious_guids:\n        is_malicious = True\n    if not is_malicious:\n        for g in malicious_guids:\n            if g.lower() in msg.lower():\n                is_malicious = True\n                break\n    if not is_malicious and chan == 'Security':\n        pids_found = re.findall(r'Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg) + re.findall(r'Creator Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg)\n        for pid in pids_found:\n            if pid.lower() in ('0x670', '1648', '0x1968', '6504'):\n                is_malicious = True\n                break\n                \n    if is_malicious:\n        mal_events.append(row)\n\nprint(f\"Total malicious events in Security/Sysmon: {len(mal_events)}\")\nprint(\"By host and channel:\")\ncounts = {}\nfor ev in mal_events:\n    k = (ev['channel'], ev['host'], ev['event_code'])\n    counts[k] = counts.get(k, 0) + 1\n\nfor k, c in sorted(counts.items()):\n    print(f\"  {c} | Channel: {k[0]} | Host: {k[1]} | Code: {k[2]}\")\n\nprint(\"\\nAll events in Security channel that are malicious:\")\nfor ev in mal_events:\n    if ev['channel'] == 'Security':\n        print(f\"  {ev['event_id']} | Code {ev['event_code']} | Host {ev['host']} | {ev['message'][:120].replace('\\r', '').replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/malicious_sec_sysmon.py\n"]
[221.222688, "o", "cat << 'EOF' > /tmp/malicious_sec_sysmon.py\r\n"]
