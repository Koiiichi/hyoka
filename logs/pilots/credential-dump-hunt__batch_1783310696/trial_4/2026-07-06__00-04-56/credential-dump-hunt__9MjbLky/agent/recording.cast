[14.471706, "i", "cat << 'EOF' > /tmp/analyze2.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Event Code 4688 (Security Process Creation) ===\")\nfor row in cursor.execute(\"SELECT event_id, host, user, message FROM events WHERE event_code = 4688\"): \n    print(f\"{row['event_id']} | {row['host']} | {row['user']} | {row['message']}\")\n\nprint(\"\\n=== Event Code 3 (Network Connections) ===\")\nfor row in cursor.execute(\"SELECT event_id, host, user, image, src_ip, dst_ip, dst_port, message FROM events WHERE event_code = 3\"):\n    print(f\"{row['event_id']} | {row['host']} | {row['user']} | {row['image']} | {row['src_ip']} -> {row['dst_ip']}:{row['dst_port']}\")\n\nprint(\"\\n=== Event Code 10 (Process Access) ===\")\nfor row in cursor.execute(\"SELECT event_id, host, user, image, target_image, granted_access, message FROM events WHERE event_code = 10 LIMIT 30\"):\n    print(f\"{row['event_id']} | {row['host']} | {row['user']} | {row['image']} -> {row['target_image']} ({row['granted_access']})\")\n\nEOF\npython3 /tmp/analyze2.py\n"]
