[185.34867, "i", "cat << 'EOF' > /tmp/scan_benign.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Malicious Process GUIDs\nmalicious_guids = {'{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}'}\n\n# Malicious PIDs\nmalicious_pids = {'0x670', '0x1968', '1648', '6504'}\n\nbenign_events = []\n\nfor row in cursor.execute(\"SELECT event_id, event_code, timestamp, channel, host, user, image, process_guid, message FROM events\"):\n    msg = row['message'] or ''\n    ev_id = row['event_id']\n    p_guid = row['process_guid']\n    chan = row['channel'] or ''\n    \n    is_malicious = False\n    \n    if p_guid in malicious_guids:\n        is_malicious = True\n    if not is_malicious:\n        for g in malicious_guids:\n            if g.lower() in msg.lower():\n                is_malicious = True\n                break\n    if not is_malicious and chan == 'Security':\n        pids_found = re.findall(r'Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg) + re.findall(r'Creator Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg)\n        for pid in pids_found:\n            if pid.lower() in ('0x670', '1648', '0x1968', '6504'):\n                is_malicious = True\n                break\n    if not is_malicious and ('PowerShell' in chan or 'PowerShell' in msg or 'powershell.exe' in (row['image'] or '').lower()):\n        is_malicious = True\n\n    if not is_malicious:\n        benign_events.append(row)\n\nprint(f\"Total benign events: {len(benign_events)}\")\nprint(\"=== Grouping of Benign Events ===\")\nstats = {}\nfor row in benign_events:\n    key = (row['channel'], row['host'], row['event_code'], row['image'] or 'N/A')\n    stats[key] = stats.get(key, 0) + 1\n\nfor key, count in sorted(stats.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{count} | Channel: {key[0]} | Host: {key[1]} | Code: {key[2]} | Image: {key[3]}\")\n\nEOF\npython3 /tmp/scan_benign.py\n"]
[185.348997, "o", "cat << 'EOF' > /tmp/scan_benign.py"]
