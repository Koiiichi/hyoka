[?2004l[?2004h>         if "Provider \"" in msg and "is Started" in msg:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if len(msg) > 180:
[?2004l[?2004h>             msg = msg[:180] + "..."
[?2004l[?2004h>         print(f"{r['timestamp']} | {r['event_id']} | {r['event_code']} | {r['image']} | {msg}")
