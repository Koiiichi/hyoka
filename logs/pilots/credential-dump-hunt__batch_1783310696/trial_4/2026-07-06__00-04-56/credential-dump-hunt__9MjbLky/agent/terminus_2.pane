[?2004hroot@d5309541b381:~# cat << 'EOF' > /tmp/timeline.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's see some basic info about whoami, powershell creation, etc.
[?2004l[?2004h> print("=== TIMELINE ===")
[?2004l[?2004h> query = """
[?2004l[?2004h> SELECT event_id, timestamp, event_code, channel, host, user, image, message 
[?2004l[?2004h> FROM events 
[?2004l[?2004h> WHERE event_code IN (1, 3, 4688, 4624, 4625) 
[?2004l[?2004h> ORDER BY timestamp ASC
[?2004l[?2004h> """
[?2004l[?2004h> for row in cursor.execute(query):
[?2004l[?2004h>     msg_snippet = (row['message'] or '').replace('\r', '').replace('\n', ' ')[:100]
[?2004l[?2004h>     print(f"{row['timestamp']} | {row['event_id']} | {row['event_code']} | {row['host']} | {row['user']} | {row['image']} | {msg_snippet}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@d5309541b381:~# python3 /tmp/timeline.py
[?2004l=== TIMELINE ===
