[?2004l[?2004h>                 is_malicious = True
[?2004l[?2004h>                 break
[?2004l[?2004h>     if not is_malicious and chan == 'Security':
[?2004l[?2004h>         pids_found = re.findall(r'Process ID:\s*(0x[0-9a-fA-F]+|[0-9]+)', msg) + re.findall(r'Creator Process ID:\s*(0x[0-9a-fA-F]+|[0-9]+)', msg)
[?2004l[?2004h>         for pid in pids_found:
[?2004l[?2004h>             if pid.lower() in ('0x670', '1648', '0x1968', '6504'):
[?2004l[?2004h>                 is_malicious = True
[?2004l[?2004h>                 break
[?2004l[?2004h>                 
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         malicious_ids.add(ev_id)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Writing {len(malicious_ids)} malicious event IDs to /root/findings.json")
[?2004l[?2004h> with open('/root/findings.json', 'w') as f:
