[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's define exclusions
[?2004l[?2004h> exclusions = [
[?2004l[?2004h>     'Start-Sleep', 'Get-Random', 'System.Net.WebClient', '$55f', '$IV', '$AES', 'packet',
[?2004l[?2004h>     'ToCharArray', 'Remove-Variable', '$taskURI', '$Buffer', 'Provider \"', 'Engine state is changed',
[?2004l[?2004h>     'ForEach-Object', '0..255', 'System.Security.Cryptography', 'Compare-Object', 'SyncWindow',
[?2004l[?2004h>     'BeginInvoke', '$script:Headers', 'PSDataCollection', '$RandName', 'get.php', 'ParameterBinding(New-Object)'
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> print("=== Unique and Interesting PowerShell Events ===")
[?2004l[?2004h> query = "SELECT event_id, event_code, host, message FROM events WHERE (channel LIKE '%PowerShell%' OR channel LIKE '%WMI%')"
[?2004l[?2004h> count = 0
[?2004l[?2004h> for row in cursor.execute(query):
[?2004l[?2004h>     msg = row['message'] or ''
[?2004l[?2004h>     skip = False
[?2004l[?2004h>     for excl in exclusions:
[?2004l[?2004h>         if excl in msg:
[?2004l[?2004h>             skip = True
[?2004l[?2004h>             break
[?2004l[?2004h>     if skip:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     msg_clean = msg.replace('\r', '').replace('\n', ' ')
[?2004l[?2004h>     if len(msg_clean) > 180:
[?2004l[?2004h>         msg_clean = msg_clean[:180] + "..."
[?2004l[?2004h>     print(f"{row['event_id']} | {row['event_code']} | {row['host']} | {msg_clean}")
[?2004l[?2004h>     count += 1
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total interesting events: {count}")
