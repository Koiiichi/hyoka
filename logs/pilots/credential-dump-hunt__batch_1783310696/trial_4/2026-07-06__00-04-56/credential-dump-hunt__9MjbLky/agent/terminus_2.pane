[?2004hroot@d5309541b381:~# cat << 'EOF' > /tmp/parse_security2.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> print("=== LOGINS ===")
[?2004l[?2004h> for row in cursor.execute("SELECT event_id, timestamp, host, message FROM events WHERE event_code IN (4624, 4625)"):
[?2004l[?2004h>     msg = row['message'] or ''
[?2004l[?2004h>     # extract Account Name
[?2004l[?2004h>     acc_names = re.findall(r'Account Name:\s+(\S+)', msg)
[?2004l[?2004h>     logon_type = re.search(r'Logon Type:\s+(\d+)', msg)
[?2004l[?2004h>     src_ip = re.search(r'Source Network Address:\s+(\S+)', msg)
[?2004l[?2004h>     lt = logon_type.group(1) if logon_type else "N/A"
[?2004l[?2004h>     sip = src_ip.group(1) if src_ip else "N/A"
[?2004l[?2004h>     print(f"{row['event_id']} | {row['timestamp']} | {row['host']} | Accounts: {acc_names} | LogonType: {lt} | SrcIP: {sip}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== OTHER RELEVANT SECURITY EVENTS ===")
[?2004l[?2004h> # Ignore noisy events like 5156, 5158, 4656, 4658, 4663, 4690
[?2004l[?2004h> exclude_codes = (5156, 5158, 4656, 4658, 4663, 4690)
[?2004l[?2004h> query = f"SELECT event_id, timestamp, event_code, host, message FROM events WHERE channel = 'Security' AND event_code NOT IN (4624, 4625, {', '.join(map(str, exclude_codes))}) ORDER BY timestamp ASC"
[?2004l[?2004h> for row in cursor.execute(query):
[?2004l[?2004h>     msg_snippet = row['message'].replace('\r', '').replace('\n', ' ')[:150]
[?2004l[?2004h>     print(f"{row['event_id']} | {row['timestamp']} | {row['event_code']} | {row['host']} | {msg_snippet}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@d5309541b381:~# python3 /tmp/parse_security2.py
[?2004l=== LOGINS ===
