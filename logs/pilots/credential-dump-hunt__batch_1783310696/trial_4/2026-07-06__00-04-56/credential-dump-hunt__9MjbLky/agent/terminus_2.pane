[?2004l[?2004h>     chan = row['channel'] or ''
[?2004l[?2004h>     # Only evaluate Security and Sysmon channels
[?2004l[?2004h>     if chan not in ('Security', 'Microsoft-Windows-Sysmon/Operational'):
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     msg = row['message'] or ''
[?2004l[?2004h>     p_guid = row['process_guid']
[?2004l[?2004h>     ev_id = row['event_id']
[?2004l[?2004h>     
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     if p_guid in malicious_guids:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     if not is_malicious:
[?2004l[?2004h>         for g in malicious_guids:
