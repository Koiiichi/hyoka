[?2004l[?2004h> SELECT event_id, timestamp, event_code, channel, host, user, image, message 
[?2004l[?2004h> FROM events 
[?2004l[?2004h> WHERE host = 'WS-05.corp.example' 
[?2004l[?2004h>   AND (user LIKE '%pgustavo%' OR image LIKE '%powershell%' OR message LIKE '%pgustavo%' OR message LIKE '%powershell%')
[?2004l[?2004h> ORDER BY timestamp ASC
[?2004l[?2004h> """
