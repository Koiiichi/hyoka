[?2004hroot@d5309541b381:~# cat << 'EOF' > /tmp/analyze_ps.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> print("=== Non-standard PowerShell Events ===")
[?2004l[?2004h> # Let's search for interesting strings in the message field of PowerShell logs
[?2004l[?2004h> search_terms = ['bypass', 'iex', 'invoke', 'download', 'encoded', 'secure', 'payload', 'http', 'whoami', 'token', 'mimikatz', 'reflect', 'lsass', 'sam', 'system', 'shadow', 'vss', 'ticket', 'kerberos']
[?2004l[?2004h> 
[?2004l[?2004h> query = "SELECT event_id, event_code, channel, host, message FROM events WHERE (channel LIKE '%PowerShell%' OR channel LIKE '%WMI%')"
[?2004l[?2004h> results = []
[?2004l[?2004h> for row in cursor.execute(query):
[?2004l[?2004h>     msg = row['message'] or ''
[?2004l[?2004h>     for term in search_terms:
[?2004l[?2004h>         if term.lower() in msg.lower():
[?2004l[?2004h>             results.append((row['event_id'], row['event_code'], row['channel'], row['host'], msg))
[?2004l[?2004h>             break
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(results)} potentially interesting PowerShell events.")
[?2004l[?2004h> for ev_id, code, chan, host, msg in results[:50]:
[?2004l[?2004h>     # Summarize the message
[?2004l[?2004h>     summary = msg.replace('\r', '').replace('\n', ' ')[:120]
[?2004l[?2004h>     print(f"{ev_id} | {code} | {chan} | {host} | {summary}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
