Sending keys: ['cat << \'EOF\' > parse_all_hosts.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let\'s search for events on DC01 and WS-06 that happened during our intrusion timeline (14:32:00 to 14:35:30)\n# We\'ll print events of code IN (4624, 4672, 4673, 5140, 5145, 10, 11, 12, 13)\ncur.execute("""\n    SELECT event_id, event_code, timestamp, host, user, image, message \n    FROM events \n    WHERE host IN (\'DC01.corp.example\', \'WS-06.corp.example\') \n      AND timestamp >= \'2026-05-06T14:32:00\' \n      AND timestamp <= \'2026-05-06T14:36:00\'\n      AND event_code IN (4624, 4672, 4673, 5140, 5145, 10, 11)\n    ORDER BY timestamp\n""")\n\nfor row in cur.fetchall():\n    msg = row[\'message\']\n    # extract some details\n    details = ""\n    if row[\'event_code\'] == 4624:\n        # logon type, logon process, target account\n        account = ""\n        logon_type = ""\n        for line in msg.split(\'\\n\'):\n            if "Target UserName:" in line or "Account Name:" in line:\n                account += line.strip() + " "\n            if "Logon Type:" in line:\n                logon_type = line.strip()\n        details = f"{account} | {logon_type}"\n    elif row[\'event_code\'] == 10:\n        # source/target images\n        src = ""\n        tgt = ""\n        access = ""\n        for line in msg.split(\'\\n\'):\n            if "SourceImage:" in line:\n                src = line.strip()\n            if "TargetImage:" in line:\n                tgt = line.strip()\n            if "GrantedAccess:" in line:\n                access = line.strip()\n        details = f"{src} -> {tgt} ({access})"\n    elif row[\'event_code\'] == 11:\n        details = "File Created: "\n        for line in msg.split(\'\\n\'):\n            if "TargetFilename:" in line:\n                details += line.strip()\n    else:\n        details = msg[:150].replace(\'\\n\', \' \')\n\n    prin