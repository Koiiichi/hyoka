[?2004hroot@2ff0fb849f3b:~# cat << 'EOF' > parse_wfp.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect 5156 events on WS-05
[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 5156")
[?2004l[?2004h> ps_5156 = []
[?2004l[?2004h> other_5156 = []
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     msg = row['message']
[?2004l[?2004h>     if "powershell.exe" in msg.lower() or "10.10.10.5" in msg:
[?2004l[?2004h>         ps_5156.append(row['event_id'])
[?2004l[?2004h>     else:
[?2004l[?2004h>         other_5156.append((row['event_id'], msg[:200].replace('\n', ' ')))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total 5156 for powershell/C2: {len(ps_5156)}")
[?2004l[?2004h> print(f"Total other 5156: {len(other_5156)}")
[?2004l[?2004h> for eid, brief in other_5156[:10]:
[?2004l[?2004h>     print(f"  {eid} | {brief}")
[?2004l[?2004h> 
