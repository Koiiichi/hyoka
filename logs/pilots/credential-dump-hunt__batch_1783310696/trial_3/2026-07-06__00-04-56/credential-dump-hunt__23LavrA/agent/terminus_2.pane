[?2004l[?2004hroot@2ff0fb849f3b:~# cat << 'EOF' > parse_logons.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, host, message FROM events WHERE event_code = 4624 ORDER BY timestamp")
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     msg = row['message']
[?2004l[?2004h>     account_names = re.findall(r'Account Name:\s+(\S+)', msg)
[?2004l[?2004h>     logon_type = re.search(r'Logon Type:\s+(\d+)', msg)
[?2004l[?2004h>     src_ip = re.search(r'Source Network Address:\s+(\S+)', msg)
[?2004l[?2004h>     
[?2004l[?2004h>     lt = logon_type.group(1) if logon_type else "?"
[?2004l[?2004h>     sip = src_ip.group(1) if src_ip else "?"
[?2004l[?2004h>     accounts = ", ".join(set(account_names)) if account_names else "?"
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"{row['event_id']} | {row['timestamp']} | {row['host']} | Accounts: {accounts} | Type: {lt} | SrcIP: {sip}")
[?2004l[?2004h> 
