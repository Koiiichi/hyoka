[?2004hroot@2ff0fb849f3b:~# cat << 'EOF' > find_guid_full.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Find the powershell process GUIDs that made connections to 10.10.10.5
[?2004l[?2004h> cur.execute("SELECT event_id, message FROM events WHERE event_code = 3 AND dst_ip = '10.10.10.5'")
[?2004l[?2004h> powershell_guids = set()
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     msg = row['message']
[?2004l[?2004h>     m = re.search(r'ProcessGuid:\s*\{?([a-fA-F0-9\-]+)\}?', msg)
[?2004l[?2004h>     if m:
[?2004l[?2004h>         powershell_guids.add(m.group(1).lower())
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Powershell GUIDs: {powershell_guids}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search for all events matching any of these GUIDs in WS-05
[?2004l[?2004h> for guid in powershell_guids:
[?2004l[?2004h>     cur.execute("SELECT event_id, event_code, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND (message LIKE ? OR process_guid LIKE ?) ORDER BY timestamp", (f"%{guid}%", f"%{guid}%"))
[?2004l[?2004h>     rows = cur.fetchall()
[?2004l[?2004h>     print(f"GUID: {guid} has {len(rows)} events.")
[?2004l[?2004h>     with open(f"/tmp/events_{guid}.txt", "w") as f:
[?2004l[?2004h>         for row in rows:
[?2004l[?2004h>             f.write(f"{row['event_id']} | {row['event_code']} | {row['timestamp']}\n")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
