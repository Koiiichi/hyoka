[?2004l[?2004h>             if "Target UserName:" in line or "Account Name:" in line:
[?2004l[?2004h>                 account += line.strip() + " "
[?2004l[?2004h>             if "Logon Type:" in line:
[?2004l[?2004h>                 logon_type = line.strip()
[?2004l[?2004h>         details = f"{account} | {logon_type}"
[?2004l[?2004h>     elif row['event_code'] == 10:
