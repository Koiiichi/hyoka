[131.92416, "i", "cat << 'EOF' > list_all.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's collect ALL event IDs that are malicious.\n# First, let's identify the malicious PowerShell session. \n# It runs on WS-05 under user CORP\\pgustavo.\n# Let's verify if there are any other PowerShell sessions (different HostId/LogonID) on WS-05.\n\ncur.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE event_code IN (800, 4103, 400, 600) AND host = 'WS-05.corp.example' ORDER BY timestamp\")\nps_events = cur.fetchall()\nprint(f\"Total WS-05 PowerShell logs: {len(ps_events)}\")\n\nEOF\npython3 list_all.py\n"]
