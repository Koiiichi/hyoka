[182.014724, "i", "cat << 'EOF' > print_details.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nfor code in [9, 11, 4670, 4673, 4703]:\n    cur.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = ?\", (code,))\n    for row in cur.fetchall():\n        print(f\"ID: {row['event_id']} | CODE: {row['event_code']} | TS: {row['timestamp']}\")\n        print(row['message'])\n        print(\"=\"*50)\n\nEOF\npython3 print_details.py\n"]
[182.015595, "o", "cat << 'EOF' > print_details.py\r\n\u001b[?2004l\r"]
