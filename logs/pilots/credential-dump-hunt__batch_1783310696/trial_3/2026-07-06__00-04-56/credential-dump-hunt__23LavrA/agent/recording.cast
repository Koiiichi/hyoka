[106.176887, "o", "sqlite3 /root/data/eventlogs.db \"SELECT event_id, timestamp, host, message FROM events WHERE event_code = 4624 AND message NOT LIKE '%$%' ORDER BY timestamp;\"\r\n\u001b[?2004l\r"]
[106.189187, "o", "\u001b[?2004hroot@2ff0fb849f3b:~# "]
[110.325512, "i", "cat << 'EOF' > parse_logons.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, timestamp, host, message FROM events WHERE event_code = 4624 ORDER BY timestamp\")\nfor row in cur.fetchall():\n    msg = row['message']\n    account_names = re.findall(r'Account Name:\\s+(\\S+)', msg)\n    logon_type = re.search(r'Logon Type:\\s+(\\d+)', msg)\n    src_ip = re.search(r'Source Network Address:\\s+(\\S+)', msg)\n    \n    lt = logon_type.group(1) if logon_type else \"?\"\n    sip = src_ip.group(1) if src_ip else \"?\"\n    accounts = \", \".join(set(account_names)) if account_names else \"?\"\n    \n    print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | Accounts: {accounts} | Type: {lt} | SrcIP: {sip}\")\n\nEOF\npython3 parse_logons.py\n"]
[110.326176, "o", "cat << 'EOF' > parse_logons.py\r\n\u001b[?2004l\r"]
[110.326236, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.326735, "o", "import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.32679, "o", "cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.328232, "o", "cur.execute(\"SELECT event_id, timestamp, host, message FROM events WHERE event_code = 4624 ORDER BY timestamp\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     msg = row['message']\r\n\u001b[?2004l\r\u001b[?2004h>     account_names = re.findall(r'Account Name:\\s+(\\S+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     logon_type = re.search(r'Logon Type:\\s+(\\d+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     src_ip = re.search(r'Source Network Address:\\s+(\\S+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     lt = logon_type.group(1) if logon_type else \"?\"\r\n\u001b[?2004l\r\u001b[?2004h>     sip = src_ip.group(1) if src_ip else \"?\"\r\n\u001b[?2004l\r\u001b[?2004h>     accounts = \", \".join(set(account_names)) if account_names else \"?\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | Accounts: {accounts} | Type: {lt} | SrcIP: {sip}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
