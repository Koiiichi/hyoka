[226.669114, "i", "cat << 'EOF' > parse_wfp.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's inspect 5156 events on WS-05\ncur.execute(\"SELECT event_id, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 5156\")\nps_5156 = []\nother_5156 = []\nfor row in cur.fetchall():\n    msg = row['message']\n    if \"powershell.exe\" in msg.lower() or \"10.10.10.5\" in msg:\n        ps_5156.append(row['event_id'])\n    else:\n        other_5156.append((row['event_id'], msg[:200].replace('\\n', ' ')))\n\nprint(f\"Total 5156 for powershell/C2: {len(ps_5156)}\")\nprint(f\"Total other 5156: {len(other_5156)}\")\nfor eid, brief in other_5156[:10]:\n    print(f\"  {eid} | {brief}\")\n\n# Let's inspect 5158 events on WS-05\ncur.execute(\"SELECT event_id, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 5158\")\nps_5158 = []\nother_5158 = []\nfor row in cur.fetchall():\n    msg = row['message']\n    if \"powershell.exe\" in msg.lower() or \"1648\" in msg:\n        ps_5158.append(row['event_id'])\n    else:\n        other_5158.append((row['event_id'], msg[:200].replace('\\n', ' ')))\n\nprint(f\"Total 5158 for powershell/C2: {len(ps_5158)}\")\nprint(f\"Total other 5158: {len(other_5158)}\")\nfor eid, brief in other_5158[:10]:\n    print(f\"  {eid} | {brief}\")\n\nEOF\npython3 parse_wfp.py\n"]
