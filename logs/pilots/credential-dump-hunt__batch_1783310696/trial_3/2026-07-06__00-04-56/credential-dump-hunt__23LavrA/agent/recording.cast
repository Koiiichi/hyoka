[80.082569, "i", "cat << 'EOF' > trace_tree.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's find processes on WS-05, WS-06, and DC01 that are created during the intrusion window.\n# WS-05 powershell GUID: {297bc33e-65d0-5f2d-8207-000000000400}\n\nprint(\"=== WS-05 Process Creation (Event Code 1 & 4688) ===\")\ncur.execute(\"SELECT event_id, event_code, timestamp, host, message FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp\")\nfor row in cur.fetchall():\n    print(f\"{row['event_id']} | {row['event_code']} | {row['timestamp']} | {row['host']}\")\n    for line in row['message'].split('\\n'):\n        if any(x in line for x in ['Image:', 'CommandLine:', 'Process Command Line:', 'ParentProcessGuid:', 'ParentProcessId:', 'ParentImage:']):\n            print(f\"  {line.strip()}\")\n\nEOF\npython3 trace_tree.py\n"]
