[213.082762, "i", "sqlite3 /root/data/eventlogs.db \"SELECT event_id, timestamp, image, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 7 ORDER BY timestamp;\" > /tmp/ws05_imageloads.txt\ncat << 'EOF' > parse_imageloads.py\nimport re\n\nwith open('/tmp/ws05_imageloads.txt') as f:\n    data = f.read()\n\nevents = data.split('evt-')\nfor ev in events:\n    if not ev.strip():\n        continue\n    lines = ev.split('\\n')\n    ev_id = 'evt-' + lines[0].split('|')[0]\n    timestamp = lines[0].split('|')[1]\n    image = lines[0].split('|')[2]\n    \n    loaded_image = \"\"\n    for line in lines:\n        if \"ImageLoaded:\" in line:\n            loaded_image = line.split()[-1]\n            break\n    print(f\"{ev_id} | {timestamp} | {image} | Loaded: {loaded_image}\")\n\nEOF\npython3 parse_imageloads.py\n"]
[213.083393, "o", "sqlite3 /root/data/eventlogs.db \"SELECT event_id, timestamp, image, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 7 ORDER BY timestamp;\" > /tmp/ws05_imageloads.txt\r\n\u001b[?2004l\r"]
[213.091994, "o", "\u001b[?2004hroot@2ff0fb849f3b:~# "]
[213.092031, "o", "cat << 'EOF' > parse_imageloads.py\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r"]
[213.092042, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[213.092316, "o", "> with open('/tmp/ws05_imageloads.txt') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> events = data.split('evt-')\r\n\u001b[?2004l\r\u001b[?2004h> for ev in events:\r\n\u001b[?2004l\r\u001b[?2004h>     if not ev.strip():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[213.092342, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     lines = ev.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[213.092462, "o", "    ev_id = 'evt-' + lines[0].split('|')[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[213.092483, "o", "    timestamp = lines[0].split('|')[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[213.092497, "o", "    image = lines[0].split('|')[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[213.092603, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     loaded_image = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[213.092767, "o", "    for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h>         if \"ImageLoaded:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>             loaded_image = line.split()[-1]\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[213.092884, "o", "    print(f\"{ev_id} | {timestamp} | {image} | Loaded: {loaded_image}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[213.092984, "o", "> EOF\r\n\u001b[?2004l\r"]
[213.093674, "o", "\u001b[?2004hroot@2ff0fb849f3b:~# "]
[213.093736, "o", "python3 parse_imageloads.py\r\n\u001b[?2004l\r"]
