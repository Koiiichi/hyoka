[193.143419, "i", "cat << 'EOF' > parse_registry_and_access.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== Registry Event Code 12 and 13 by Image ===\")\ncur.execute(\"\"\"\n    SELECT image, event_code, count(*)\n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code IN (12, 13) \n    GROUP BY image, event_code\n\"\"\")\nfor row in cur.fetchall():\n    print(f\"{row['image']} | {row['event_code']} | {row['count(*)']}\")\n\nprint(\"=== Process Access Event Code 10 by Source/Target Image ===\")\ncur.execute(\"\"\"\n    SELECT image, target_image, count(*)\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code = 10\n    GROUP BY image, target_image\n\"\"\")\nfor row in cur.fetchall():\n    print(f\"{row['image']} | {row['target_image']} | {row['count(*)']}\")\n\nEOF\npython3 parse_registry_and_access.py\n"]
