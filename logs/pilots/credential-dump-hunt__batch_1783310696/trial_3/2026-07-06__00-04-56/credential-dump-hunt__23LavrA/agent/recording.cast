[89.866077, "i", "cat << 'EOF' > parse_process_access.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Source GUID of malicious powershell: {297bc33e-65d0-5f2d-8207-000000000400}\ncur.execute(\"SELECT event_id, timestamp, host, message FROM events WHERE event_code = 10 AND message LIKE '%{297bc33e-65d0-5f2d-8207-000000000400}%' ORDER BY timestamp\")\nfor row in cur.fetchall():\n    print(f\"{row['event_id']} | {row['timestamp']} | {row['host']}\")\n    for line in row['message'].split('\\n'):\n        if any(x in line for x in ['SourceImage', 'TargetImage', 'GrantedAccess', 'CallTrace']):\n            print(f\"  {line.strip()}\")\n\nEOF\npython3 parse_process_access.py\n"]
