[176.126821, "i", "cat << 'EOF' > explore_uncommon_2.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nfor code in [9, 11, 4670, 4673, 4703]:\n    print(f\"=== Event Code {code} ===\")\n    cur.execute(\"SELECT event_id, timestamp, image, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = ?\", (code,))\n    for row in cur.fetchall():\n        print(f\"{row['event_id']} | {row['timestamp']} | {row['image']} | {row['message'][:300].replace('\\n', ' ')}\")\n\nEOF\npython3 explore_uncommon_2.py\n"]
