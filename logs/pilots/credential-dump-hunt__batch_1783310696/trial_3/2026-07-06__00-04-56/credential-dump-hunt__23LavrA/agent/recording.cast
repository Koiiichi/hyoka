[19.191547, "i", "cat << 'EOF' > dump_commands.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp\")\nfor row in cur.fetchall():\n    msg = row['message']\n    cmdline = \"\"\n    for line in msg.split('\\n'):\n        if \"CommandLine:\" in line or \"Command Line:\" in line:\n            cmdline = line.strip()\n            break\n    print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | {row['user']} | {row['image']} | {cmdline}\")\n\nEOF\npython3 dump_commands.py\n"]
