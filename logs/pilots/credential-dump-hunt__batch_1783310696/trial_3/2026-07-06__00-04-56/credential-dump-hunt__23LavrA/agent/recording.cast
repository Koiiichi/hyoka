[141.699125, "i", "cat << 'EOF' > parse_ps_hosts.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE event_code IN (800, 4103) AND host = 'WS-05.corp.example'\")\nby_host_id = {}\nfor row in cur.fetchall():\n    msg = row['message']\n    h = re.search(r'Host ID\\s*=\\s*(\\S+)|HostId=(\\S+)', msg, re.IGNORECASE)\n    host_id = \"unknown\"\n    if h:\n        host_id = h.group(1) or h.group(2)\n    if host_id not in by_host_id:\n        by_host_id[host_id] = []\n    by_host_id[host_id].append((row['event_id'], row['event_code'], row['timestamp'], msg))\n\nfor hid, evs in by_host_id.items():\n    print(f\"=== Host ID: {hid} | Count: {len(evs)} ===\")\n    # print first 10 command lines/invocations\n    shown = 0\n    for eid, ecode, ts, msg in evs:\n        for line in msg.split('\\n'):\n            if \"command line:\" in line.lower() or \"commandinvocation\" in line.lower():\n                print(f\"  {eid} | {ts} | {line.strip()}\")\n                shown += 1\n                if shown >= 10:\n                    break\n        if shown >= 10:\n            break\n\nEOF\npython3 parse_ps_hosts.py\n"]
