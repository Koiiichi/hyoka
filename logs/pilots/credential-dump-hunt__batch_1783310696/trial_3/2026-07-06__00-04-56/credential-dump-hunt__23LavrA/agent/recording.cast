[55.808063, "i", "cat << 'EOF' > find_guid_full.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Find the powershell process GUIDs that made connections to 10.10.10.5\ncur.execute(\"SELECT event_id, message FROM events WHERE event_code = 3 AND dst_ip = '10.10.10.5'\")\npowershell_guids = set()\nfor row in cur.fetchall():\n    msg = row['message']\n    m = re.search(r'ProcessGuid:\\s*\\{?([a-fA-F0-9\\-]+)\\}?', msg)\n    if m:\n        powershell_guids.add(m.group(1).lower())\n\nprint(f\"Powershell GUIDs: {powershell_guids}\")\n\n# Let's search for all events matching any of these GUIDs in WS-05\nfor guid in powershell_guids:\n    cur.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND (message LIKE ? OR process_guid LIKE ?) ORDER BY timestamp\", (f\"%{guid}%\", f\"%{guid}%\"))\n    rows = cur.fetchall()\n    print(f\"GUID: {guid} has {len(rows)} events.\")\n    with open(f\"/tmp/events_{guid}.txt\", \"w\") as f:\n        for row in rows:\n            f.write(f\"{row['event_id']} | {row['event_code']} | {row['timestamp']}\\n\")\n\nEOF\npython3 find_guid_full.py\n"]
[55.809095, "o", "cat << 'EOF' > find_guid_full.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
