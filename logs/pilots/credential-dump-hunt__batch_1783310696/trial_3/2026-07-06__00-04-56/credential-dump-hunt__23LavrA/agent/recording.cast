[149.230097, "i", "cat << 'EOF' > parse_ws05_processes.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's inspect processes on WS-05 using Event Code 1 (Process Create), 5 (Process Terminated), 4688 (Process Create), 4689 (Process Terminated)\ncur.execute(\"SELECT event_id, event_code, timestamp, user, image, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (1, 5, 4688, 4689) ORDER BY timestamp\")\nfor row in cur.fetchall():\n    msg = row['message']\n    proc_guid = \"\"\n    proc_id = \"\"\n    for line in msg.split('\\n'):\n        if \"ProcessGuid:\" in line or \"ProcessGuid\" in line:\n            proc_guid = line.split()[-1]\n        if \"ProcessId:\" in line or \"ProcessId\" in line:\n            proc_id = line.split()[-1]\n    print(f\"{row['event_id']} | {row['event_code']} | {row['timestamp']} | {row['user']} | {row['image']} | GUID: {proc_guid} | PID: {proc_id}\")\n\nEOF\npython3 parse_ws05_processes.py\n"]
[149.230482, "o", "cat << 'EOF' > parse_ws05_processes.py\r\n"]
