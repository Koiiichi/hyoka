[49.937851, "i", "cat << 'EOF' > find_guid.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's get the ProcessGuid from Event Code 3 (powershell to 10.10.10.5)\ncur.execute(\"SELECT distinct message FROM events WHERE event_code = 3 AND dst_ip = '10.10.10.5'\")\nguids = set()\nfor row in cur.fetchall():\n    msg = row['message']\n    for line in msg.split('\\n'):\n        if \"ProcessGuid:\" in line or \"ProcessGuid\" in line:\n            guid = line.split()[-1].strip('{}')\n            guids.add(guid)\n\nprint(f\"Malicious ProcessGuids: {guids}\")\n\n# Let's see what other events have this ProcessGuid anywhere in their fields or message\nfor guid in guids:\n    print(f\"=== Events for GUID {guid} ===\")\n    cur.execute(\"SELECT event_id, event_code, timestamp, host, message FROM events WHERE process_guid LIKE ? OR message LIKE ? ORDER BY timestamp\", (f\"%{guid}%\", f\"%{guid}%\"))\n    rows = cur.fetchall()\n    print(f\"Total events for {guid}: {len(rows)}\")\n    for row in rows[:20]:\n        print(f\"{row['event_id']} | {row['event_code']} | {row['timestamp']} | {row['message'][:200]}\")\n\nEOF\npython3 find_guid.py\n"]
