[255.729977, "i", "cat << 'EOF' > get_all_malicious_ids.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmalicious_ids = set()\n\n# 1. PowerShell events on WS-05 (800, 4103, 400, 600)\ncur.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103, 400, 600)\")\nfor row in cur.fetchall():\n    malicious_ids.add(row['event_id'])\n\nprint(f\"PowerShell logs count: {len(malicious_ids)}\")\n\n# 2. Sysmon events matching malicious GUIDs\n# PowerShell: {297bc33e-65d0-5f2d-8207-000000000400}\n# Whoami: {297bc33e-660d-5f2d-8407-000000000400}\nguids = ['{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}']\nfor guid in guids:\n    cur.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND (process_guid = ? OR message LIKE ?)\", (guid, f\"%{guid}%\"))\n    for row in cur.fetchall():\n        malicious_ids.add(row['event_id'])\n\nprint(f\"After GUID search: {len(malicious_ids)}\")\n\n# 3. Process creation / termination of Whoami in Security logs (4688, 4689)\ncur.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4688, 4689) AND message LIKE '%whoami.exe%'\")\nfor row in cur.fetchall():\n    malicious_ids.add(row['event_id'])\n\n# 4. Sensitive privilege use by powershell in Security logs (4673)\ncur.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code = 4673 AND message LIKE '%powershell.exe%'\")\nfor row in cur.fetchall():\n    malicious_ids.add(row['event_id'])\n\n# 5. WFP events (5156, 5158) for powershell.exe / PID 1648\ncur.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158) AND (message LIKE '%powershell.exe%' OR message LIKE '%1648%')\")\nfor row in cur.fetchall():\n    malicious_ids.add(row['event_id'])\n\n# 6. Prefetch creation for whoami (Event 11)\ncur.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code = 11 AND message LIKE '%WHOAMI.EXE-%\")\nfor row in cur.fetchall():\n    malicious_ids.add(row['event_id'])\n\nprint(f\"Total unique malicious event IDs collected: {len(malicious_ids)}\")\n\nEOF\npython3 get_all_malicious_ids.py\n"]
