[161.379751, "i", "cat << 'EOF' > parse_all_ws05.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's fetch all events on WS-05, and check if there's anything else\ncur.execute(\"SELECT event_id, event_code, timestamp, user, image, message FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\nrows = cur.fetchall()\nprint(f\"Total WS-05 events: {len(rows)}\")\n\nsuspicious_event_ids = []\n\n# Let's print summary\ncodes = {}\nfor row in rows:\n    ecode = row['event_code']\n    codes[ecode] = codes.get(ecode, 0) + 1\n\nprint(\"Event code counts on WS-05:\")\nfor ec, cnt in sorted(codes.items()):\n    print(f\"  Event {ec}: {cnt}\")\n\nEOF\npython3 parse_all_ws05.py\n"]
