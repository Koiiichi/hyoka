[55.810944, "o", "    with open(f\"/tmp/events_{guid}.txt\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>         for row in rows:\r\n\u001b[?2004l\r\u001b[?2004h>             f.write(f\"{row['event_id']} | {row['event_code']} | {row['timestamp']}\\n\")\r\n"]
[55.811089, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
