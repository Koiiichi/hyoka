[131.971247, "o", "\u001b[?2004hroot@2ff0fb849f3b:~# "]
[136.027167, "i", "cat << 'EOF' > parse_ps_sessions.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT message FROM events WHERE event_code IN (800, 4103, 400, 600) AND host = 'WS-05.corp.example'\")\nhost_ids = set()\nprocess_ids = set()\nfor row in cur.fetchall():\n    msg = row['message']\n    h = re.search(r'Host ID\\s*=\\s*(\\S+)|HostId=(\\S+)', msg, re.IGNORECASE)\n    p = re.search(r'Process ID\\s*=\\s*(\\S+)|ProcessId=(\\S+)', msg, re.IGNORECASE)\n    if h:\n        host_ids.add(h.group(1) or h.group(2))\n    if p:\n        process_ids.add(p.group(1) or p.group(2))\n\nprint(f\"Unique Host IDs: {host_ids}\")\nprint(f\"Unique Process IDs: {process_ids}\")\nEOF\npython3 parse_ps_sessions.py\n"]
