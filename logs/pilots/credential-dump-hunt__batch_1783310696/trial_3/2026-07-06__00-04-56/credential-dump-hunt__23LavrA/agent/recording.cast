[243.144564, "i", "cat << 'EOF' > parse_other_hosts_access.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== Event Code 10 on DC01 and WS-06 ===\")\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, host, image, target_image, message \n    FROM events \n    WHERE host IN ('DC01.corp.example', 'WS-06.corp.example') \n      AND event_code = 10\n\"\"\")\nfor row in cur.fetchall():\n    msg = row['message']\n    granted_access = \"\"\n    for line in msg.split('\\n'):\n        if \"GrantedAccess:\" in line:\n            granted_access = line.strip()\n            break\n    # filter out standard ones like svchost to svchost, or lsass to lsass, etc.\n    src = row['image']\n    tgt = row['target_image']\n    if \"svchost.exe\" in src.lower() and \"svchost.exe\" in tgt.lower():\n        continue\n    if \"lsass.exe\" in src.lower() and \"lsass.exe\" in tgt.lower():\n        continue\n    print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | {src} -> {tgt} | {granted_access}\")\n\nEOF\npython3 parse_other_hosts_access.py\n"]
