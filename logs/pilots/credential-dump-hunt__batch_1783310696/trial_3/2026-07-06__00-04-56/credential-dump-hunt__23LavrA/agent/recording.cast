[26.5862, "i", "cat << 'EOF' > parse_powershell.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's search for interesting strings in powershell events (800, 4103)\ncur.execute(\"SELECT event_id, event_code, timestamp, host, message FROM events WHERE event_code IN (800, 4103) ORDER BY timestamp\")\nrows = cur.fetchall()\nprint(f\"Total powershell events: {len(rows)}\")\n\nsuspicious_keywords = ['bypass', 'download', 'encoded', 'iex', 'invoke', 'mimikatz', 'reflectivedllinjection', 'powerup', 'powerview', 'bloodhound', 'sharphound', 'gpp', 'sam', 'lsass', 'nc.exe', 'netcat', 'reverse', 'shell', 'payload', 'empire', 'cobalt', 'strike', 'meterpreter', 'webclient', 'upload', 'http', 'https', 'ftp', 'temp', 'appdata', 'whoami', 'net user', 'net group', 'net localgroup', 'nltest', 'ipconfig']\n\nfound = 0\nfor row in rows:\n    msg_lower = row['message'].lower()\n    matched = [kw for kw in suspicious_keywords if kw in msg_lower]\n    if matched:\n        print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | {row['event_code']} | Matched: {matched}\")\n        # Let's also print some message content for the first few\n        if found < 20:\n            print(row['message'][:300])\n            print(\"-\"*50)\n        found += 1\n\nprint(f\"Found {found} matching events\")\nEOF\npython3 parse_powershell.py > /tmp/powershell_matched.txt\nhead -n 100 /tmp/powershell_matched.txt\n"]
