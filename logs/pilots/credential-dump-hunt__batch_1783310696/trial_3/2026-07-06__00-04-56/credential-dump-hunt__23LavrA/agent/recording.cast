[99.197553, "i", "cat << 'EOF' > parse_all_hosts.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's search for events on DC01 and WS-06 that happened during our intrusion timeline (14:32:00 to 14:35:30)\n# We'll print events of code IN (4624, 4672, 4673, 5140, 5145, 10, 11, 12, 13)\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, host, user, image, message \n    FROM events \n    WHERE host IN ('DC01.corp.example', 'WS-06.corp.example') \n      AND timestamp >= '2026-05-06T14:32:00' \n      AND timestamp <= '2026-05-06T14:36:00'\n      AND event_code IN (4624, 4672, 4673, 5140, 5145, 10, 11)\n    ORDER BY timestamp\n\"\"\")\n\nfor row in cur.fetchall():\n    msg = row['message']\n    # extract some details\n    details = \"\"\n    if row['event_code'] == 4624:\n        # logon type, logon process, target account\n        account = \"\"\n        logon_type = \"\"\n        for line in msg.split('\\n'):\n            if \"Target UserName:\" in line or \"Account Name:\" in line:\n                account += line.strip() + \" \"\n            if \"Logon Type:\" in line:\n                logon_type = line.strip()\n        details = f\"{account} | {logon_type}\"\n    elif row['event_code'] == 10:\n        # source/target images\n        src = \"\"\n        tgt = \"\"\n        access = \"\"\n        for line in msg.split('\\n'):\n            if \"SourceImage:\" in line:\n                src = line.strip()\n            if \"TargetImage:\" in line:\n                tgt = line.strip()\n            if \"GrantedAccess:\" in line:\n                access = line.strip()\n        details = f\"{src} -> {tgt} ({access})\"\n    elif row['event_code'] == 11:\n        details = \"File Created: \"\n        for line in msg.split('\\n'):\n            if \"TargetFilename:\" in line:\n                details += line.strip()\n    else:\n        details = msg[:150].replace('\\n', ' ')\n\n    print(f\"{row['event_id']} | {row['event_code']} | {row['timestamp']} | {row['host']} | {row['user']} | {details}\")\n\nEOF\npython3 parse_all_hosts.py > /tmp/lateral.txt\ncat /tmp/lateral.txt\n"]
[99.198508, "o", "cat << 'EOF' > parse_all_hosts.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r"]
[99.19854, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.198643, "o", "# Let's search for events on DC01 and WS-06 that happened during our intrusion timeline (14:32:00 to 14:35:30)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.198751, "o", "# We'll print events of code IN (4624, 4672, 4673, 5140, 5145, 10, 11, 12, 13)\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.198839, "o", "    SELECT event_id, event_code, timestamp, host, user, image, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.199304, "o", "    WHERE host IN ('DC01.corp.example', 'WS-06.corp.example') \r\n\u001b[?2004l\r\u001b[?2004h>       AND timestamp >= '2026-05-06T14:32:00' \r\n\u001b[?2004l\r\u001b[?2004h>       AND timestamp <= '2026-05-06T14:36:00'\r\n\u001b[?2004l\r\u001b[?2004h>       AND event_code IN (4624, 4672, 4673, 5140, 5145, 10, 11)\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.199495, "o", "for row in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     msg = row['message']\r\n"]
[99.199637, "o", "\u001b[?2004l\r\u001b[?2004h>     # extract some details\r\n\u001b[?2004l\r\u001b[?2004h>     details = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.199794, "o", "    if row['event_code'] == 4624:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.199908, "o", "        # logon type, logon process, target account\r\n\u001b[?2004l\r\u001b[?2004h>         account = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         logon_type = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         for line in msg.split('\\n'):"]
[99.200033, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.200115, "o", "            if \"Target UserName:\" in line or \"Account Name:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>                 account += line.strip() + \" \"\r\n\u001b[?2004l\r\u001b[?2004h>             if \"Logon Type:\" in line:\r\n\u001b[?2004l\r"]
[99.200187, "o", "\u001b[?2004h> "]
[99.200281, "o", "                logon_type = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         details = f\"{account} | {logon_type}\"\r\n\u001b[?2004l\r"]
[99.200442, "o", "\u001b[?2004h>     elif row['event_code'] == 10:\r\n\u001b[?2004l\r\u001b[?2004h>         # source/target images\r\n\u001b[?2004l\r\u001b[?2004h>         src = \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.200467, "o", "> "]
[99.200667, "o", "        tgt = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         access = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         for line in msg.split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h>             if \"SourceImage:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>                 src = line.strip()\r\n\u001b[?2004l\r"]
[99.200767, "o", "\u001b[?2004h>             if \"TargetImage:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.200784, "o", "                tgt = line.strip()\r\n\u001b[?2004l\r"]
[99.200976, "o", "\u001b[?2004h>             if \"GrantedAccess:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>                 access = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         details = f\"{src} -> {tgt} ({access})\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.20106, "o", "    elif row['event_code'] == 11:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.201125, "o", "        details = \"File Created: \"\r\n\u001b[?2004l\r\u001b[?2004h>         for line in msg.split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.201162, "o", "            if \"TargetFilename:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>                 details += line.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.201245, "o", "    else:\r\n\u001b[?2004l\r"]
[99.201281, "o", "\u001b[?2004h> "]
[99.201345, "o", "        details = msg[:150].replace('\\n', ' ')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.201568, "o", "    print(f\"{row['event_id']} | {row['event_code']} | {row['timestamp']} | {row['host']} | {row['user']} | {details}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.201679, "o", "EOF\r\n\u001b[?2004l\r"]
[99.202545, "o", "\u001b[?2004hroot@2ff0fb849f3b:~# "]
[99.202683, "o", "python3 parse_all_hosts.py > /tmp/lateral.txt\r\n\u001b[?2004l\r"]
[99.228322, "o", "\u001b[?2004hroot@2ff0fb849f3b:~# cat /tmp/lateral.txt\r\n\u001b[?2004l\r"]
[99.228746, "o", "evt-00001 | 10 | 2026-05-06T14:32:25.358Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00002 | 10 | 2026-05-06T14:32:25.359Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00003 | 10 | 2026-05-06T14:32:25.359Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00026 | 4672 | 2026-05-06T14:32:29.368Z | DC01.corp.example | DC01$ | Special privileges assigned to new logon.\r \r Subject:\r \tSecurity ID:\t\tS-1-5-18\r \tAccount Name:\t\tDC01$\r \tAccount Domain:\t\tCORP\r \tLogon ID:\t\t0x2B6B6C5\r \r\nevt-00028 | 4624 | 2026-05-06T14:32:29.369Z | DC01.corp.example | - | Account Name:\t\t- Account Name:\t\tDC01$ Network Account Name:\t-  | Logon Type:\t\t3\r\nevt-00051 | 11 | 2026-05-06T14:32:31.382Z | WS-06.corp.example |  | File Created: TargetFilename: C:\\Windows\\ServiceState\\EventLog\\Data\\lastalive0.dat\r\nevt-00107 | 11 | 2026-05-06T14:32:43.467Z | DC01.corp.example |  | File Created: TargetFilename: C:\\Windows\\ServiceState\\EventLog\\Data\\lastalive0.dat\r\nevt-00203 | 11 | 2026-05-06T14:32:47.550Z | DC01.corp.example |  | File Created: TargetFilename: C:\\Windows\\System32\\Configuration\\DSCEngineCache.mof\r\nevt-00205 | 11 | 2026-05-06T14:32:47.552Z | DC01.corp.example |  | File Created: TargetFilename: C:\\Windows\\System32\\Configuration\\DSCResourceStateCache.mof\r\nevt-00206 | 10 | 2026-05-06T14:32:47.552Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00208 | 10 | 2026-05-06T14:32:47.553Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00210 | 10 | 2026-05-06T14:32:47.553Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00213 | 10 | 2026-05-06T14:32:47.555Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00215 | 10 | 2026-05-06T14:32:47.556Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00216 | 10 | 2026-05-06T14:32:47.556Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00222 | 10 | 2026-05-06T14:32:47.559Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00223 | 10 | 2026-05-06T14:32:47.560Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00224 | 10 | 2026-05-06T14:32:47.560Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00225 | 10 | 2026-05-06T14:32:47.564Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00227 | 10 | 2026-05-06T14:32:47.565Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00230 | 10 | 2026-05-06T14:32:47.566Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00237 | 10 | 2026-05-06T14:32:47.569Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00239 | 10 | 2026-05-06T14:32:47.570Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00241 | 10 | 2026-05-06T14:32:47.571Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00250 | 10 | 2026-05-06T14:32:47.574Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\nevt-00252 | 10 | 2026-05-06T14:32:47.575Z | DC01.corp.example |  | SourceImage: C:\\windows\\system32\\svchost.exe -> TargetImage: C:\\windows\\System32\\svchost.exe (GrantedAccess: 0x1000)\r\n"]
