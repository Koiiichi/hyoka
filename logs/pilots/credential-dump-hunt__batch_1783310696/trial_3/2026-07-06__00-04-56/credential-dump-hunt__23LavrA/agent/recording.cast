[69.465688, "o", "\u001b[?2004hroot@2ff0fb849f3b:~# "]
[69.967954, "i", "cat << 'EOF' > parse_powershell_commands.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE event_code IN (800, 4103) AND host = 'WS-05.corp.example' ORDER BY timestamp\")\nlines = []\nfor row in cur.fetchall():\n    msg = row['message']\n    if row['event_code'] == 800:\n        for line in msg.split('\\n'):\n            if \"Pipeline execution details\" in line or \"command line:\" in line:\n                lines.append((row['event_id'], row['timestamp'], line.strip()))\n    elif row['event_code'] == 4103:\n        for line in msg.split('\\n'):\n            if \"CommandInvocation\" in line:\n                lines.append((row['event_id'], row['timestamp'], line.strip()))\n\nwith open('/tmp/ps_cmds.txt', 'w') as f:\n    for ev_id, ts, cmd in lines:\n        f.write(f\"{ev_id} | {ts} | {cmd}\\n\")\n\nprint(f\"Extracted {len(lines)} powershell command invocations.\")\nEOF\npython3 parse_powershell_commands.py\nhead -n 100 /tmp/ps_cmds.txt\n"]
[69.968251, "o", "cat << 'EOF' > parse_powershell_commands.py\r\n\u001b[?2004l\r"]
