[15.473567, "i", "cat << 'EOF' > analyze.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== Event Code 1 (Process Creation) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code = 1\")\nfor row in cur.fetchall():\n    print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | {row['user']} | {row['image']} | {row['message'][:200]}\")\n\nprint(\"=== Event Code 4688 ===\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code = 4688\")\nfor row in cur.fetchall():\n    print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | {row['user']} | {row['image']} | {row['message'][:200]}\")\n\nEOF\npython3 analyze.py > /tmp/process_creation.txt\nhead -n 50 /tmp/process_creation.txt\n"]
