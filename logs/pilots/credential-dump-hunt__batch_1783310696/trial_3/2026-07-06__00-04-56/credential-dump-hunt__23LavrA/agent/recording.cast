[26.661661, "o", "\u001b[?2004hroot@2ff0fb849f3b:~# "]
[32.070181, "i", "cat << 'EOF' > parse_sysmon.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's inspect Sysmon event codes\n# Event Code 3: Network Connection\n# Event Code 11: File Create\n# Event Code 12, 13, 14: Registry\n# Event Code 10: Process Access\n\nprint(\"=== Event Code 3 (Network Connections) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, src_ip, dst_ip, dst_port, message FROM events WHERE event_code = 3 ORDER BY timestamp\")\nfor row in cur.fetchall():\n    print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | {row['image']} | {row['src_ip']} -> {row['dst_ip']}:{row['dst_port']}\")\n\nprint(\"=== Event Code 11 (File Create) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code = 11 ORDER BY timestamp\")\nfor row in cur.fetchall():\n    print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | {row['image']} | {row['message'][:200]}\")\n\nEOF\npython3 parse_sysmon.py > /tmp/sysmon_network_file.txt\nhead -n 100 /tmp/sysmon_network_file.txt\n"]
