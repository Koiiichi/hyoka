[115.692402, "i", "cat << 'EOF' > parse_ws05.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's count event_code by image on WS-05\nprint(\"=== WS-05 Event counts by image and event_code ===\")\ncur.execute(\"SELECT image, event_code, count(*) FROM events WHERE host = 'WS-05.corp.example' GROUP BY image, event_code ORDER BY count(*) DESC\")\nfor row in cur.fetchall():\n    print(f\"{row['image']} | {row['event_code']} | {row['count(*)']}\")\n\nEOF\npython3 parse_ws05.py\n"]
