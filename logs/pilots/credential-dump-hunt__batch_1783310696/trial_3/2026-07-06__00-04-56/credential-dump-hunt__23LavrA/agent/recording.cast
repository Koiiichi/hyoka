[122.088904, "i", "cat << 'EOF' > parse_malicious_events.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's list ALL events where process_guid is either powershell's GUID or whoami's GUID\nguids = ['{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}']\n\nall_malicious_events = set()\n\nprint(\"=== Events for Malicious GUIDs ===\")\nfor guid in guids:\n    cur.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE process_guid = ? OR message LIKE ? ORDER BY timestamp\", (guid, f\"%{guid}%\"))\n    for row in cur.fetchall():\n        all_malicious_events.add(row['event_id'])\n        print(f\"{row['event_id']} | {row['event_code']} | {row['timestamp']}\")\n\nprint(f\"Total unique events from GUID search: {len(all_malicious_events)}\")\nEOF\npython3 parse_malicious_events.py\n"]
