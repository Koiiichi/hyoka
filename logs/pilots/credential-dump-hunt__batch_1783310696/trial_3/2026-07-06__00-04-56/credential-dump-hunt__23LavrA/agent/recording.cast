[40.110463, "i", "cat << 'EOF' > parse_net.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, timestamp, host, image, src_ip, dst_ip, dst_port FROM events WHERE event_code = 3\")\nfor row in cur.fetchall():\n    print(f\"{row['event_id']} | {row['timestamp']} | {row['host']} | {row['image']} | {row['src_ip']} -> {row['dst_ip']}:{row['dst_port']}\")\n\nEOF\npython3 parse_net.py\n"]
