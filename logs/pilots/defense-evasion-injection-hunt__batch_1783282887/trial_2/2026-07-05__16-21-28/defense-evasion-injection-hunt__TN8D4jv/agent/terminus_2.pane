[?2004hroot@c2d02cefd2ea:~# python3 -c "
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute(\"SELECT event_id, timestamp, host, event_code, user, target_user, src_ip, logon_type FROM events WHERE event_code IN (4624, 4625)\")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     # filter out typical local system logons if they are noisy
[?2004l[?2004h>     user_str = r['user'] or r['target_user'] or ''
[?2004l[?2004h>     if 'SYSTEM' in user_str or 'LOCAL SERVICE' in user_str or 'NETWORK SERVICE' in user_str:
[?2004l[?2004h>         continue
[?2004l[?2004h>     print(f\"{r['event_id']} | {r['timestamp']} | Host: {r['host']} | Code: {r['event_code']} | User: {user_str} | IP: {r['src_ip']} | Type: {r['logon_type']}\")
[?2004l[?2004h> "
