[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect some unique columns to find potential indicators:
[?2004l[?2004h> # - image/parent_image names
[?2004l[?2004h> # - command_lines
[?2004l[?2004h> # - network connections (Event ID 3)
[?2004l[?2004h> # - process access (Event ID 10)
[?2004l[?2004h> # - registry modifications (Event ID 12, 13, 14)
[?2004l[?2004h> # - file creation (Event ID 11)
[?2004l[?2004h> # - service creations
[?2004l[?2004h> 
[?2004l[?2004h> print("=== PROCESS CREATION EVENTS (1, 4688) ===")
[?2004l[?2004h> cursor.execute("SELECT event_id, timestamp, host, user, image, parent_image, command_line FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(f"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image']} | {r['parent_image']} | {r['command_line']}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== NETWORK CONNECTIONS (3, 5156) ===")
[?2004l[?2004h> cursor.execute("SELECT event_id, timestamp, host, user, image, src_ip, dst_ip, dst_port FROM events WHERE event_code IN (3, 5156) AND (image NOT LIKE '%svchost%' AND image NOT LIKE '%System%' AND image NOT LIKE '%spoolsv%') ORDER BY timestamp")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(f"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image']} | {r['src_ip']} -> {r['dst_ip']}:{r['dst_port']}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== FILE CREATION (11) ===")
[?2004l[?2004h> cursor.execute("SELECT event_id, timestamp, host, user, image, target_image FROM events WHERE event_code = 11 ORDER BY timestamp")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(f"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image']} | {r['target_image']}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== SERVICE MODIFICATIONS ===")
[?2004l[?2004h> cursor.execute("SELECT event_id, timestamp, host, user, service_name, service_file_name FROM events WHERE service_name IS NOT NULL OR service_file_name IS NOT NULL ORDER BY timestamp")
[?2004l[?2004h> for r in cursor.fetchall():
