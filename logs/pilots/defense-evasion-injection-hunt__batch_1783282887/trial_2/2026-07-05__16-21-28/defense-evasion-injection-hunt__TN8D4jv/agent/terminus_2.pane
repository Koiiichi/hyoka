[?2004l[?2004h>             added = True
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Propagated suspect process GUIDs: {suspect_guids}")
[?2004l[?2004h> 
[?2004l[?2004h> # Now, let's find ALL events in the database that reference any of these process GUIDs
[?2004l[?2004h> # (in process_guid, parent_process_guid, or source_process_guid/target_process_guid/etc. inside the message or details, or in specific columns)
