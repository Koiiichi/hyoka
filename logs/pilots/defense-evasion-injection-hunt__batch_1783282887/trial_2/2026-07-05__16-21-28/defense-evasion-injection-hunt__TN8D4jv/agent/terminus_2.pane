[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         malicious.append(ev)
[?2004l[?2004h>     else:
[?2004l[?2004h>         benign.append(ev)
