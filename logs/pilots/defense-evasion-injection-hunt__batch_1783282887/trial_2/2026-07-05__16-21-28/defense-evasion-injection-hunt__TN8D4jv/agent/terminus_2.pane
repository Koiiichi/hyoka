[?2004l[?2004h> 
[?2004l[?2004h> # Let's search all process creation events first to extract their process_guid
[?2004l[?2004h> cursor.execute("SELECT event_id, timestamp, event_code, host, image, process_guid, parent_process_guid FROM events WHERE event_code IN (1, 4688)")
[?2004l[?2004h> proc_rows = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> guid_to_name = {}
[?2004l[?2004h> for r in proc_rows:
[?2004l[?2004h>     pguid = r['process_guid']
[?2004l[?2004h>     image = r['image']
[?2004l[?2004h>     if pguid and image:
[?2004l[?2004h>         guid_to_name[pguid] = image
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find process GUIDs specifically for our suspects
[?2004l[?2004h> suspect_guids = set()
[?2004l[?2004h> suspect_images = ['grunthttp.exe', 'simpleinjection.dll', 'wuauclt.exe', 'notepad.exe']
[?2004l[?2004h> 
[?2004l[?2004h> for r in proc_rows:
[?2004l[?2004h>     pguid = r['process_guid']
[?2004l[?2004h>     image = r['image'] or ''
[?2004l[?2004h>     cmd = r['command_line'] or ''
[?2004l[?2004h>     parent_guid = r['parent_process_guid']
[?2004l[?2004h>     
[?2004l[?2004h>     is_suspect = False
[?2004l[?2004h>     for s in suspect_images:
[?2004l[?2004h>         if s in image.lower() or s in cmd.lower():
[?2004l[?2004h>             is_suspect = True
[?2004l[?2004h>             break
[?2004l[?2004h>     
[?2004l[?2004h>     if is_suspect:
[?2004l[?2004h>         if pguid: suspect_guids.add(pguid)
[?2004l[?2004h>         if parent_guid: suspect_guids.add(parent_guid)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Initial suspect process GUIDs: {suspect_guids}")
[?2004l[?2004h> 
[?2004l[?2004h> # Propagate: find all child processes of suspect processes
[?2004l[?2004h> added = True
[?2004l[?2004h> while added:
[?2004l[?2004h>     added = False
[?2004l[?2004h>     for r in proc_rows:
