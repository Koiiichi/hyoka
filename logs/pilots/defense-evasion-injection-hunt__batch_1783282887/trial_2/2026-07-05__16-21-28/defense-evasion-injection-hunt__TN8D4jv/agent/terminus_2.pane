[?2004l[?2004h> query = """
[?2004l[?2004h> SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, target_image, service_name, target_object, details, message
[?2004l[?2004h> FROM events
[?2004l[?2004h> """
[?2004l[?2004h> cursor.execute(query)
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> matches = []
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     row_str = " ".join([str(val) for val in dict(r).values() if val is not None])
[?2004l[?2004h>     for kw in keywords:
[?2004l[?2004h>         if kw.lower() in row_str.lower():
[?2004l[?2004h>             matches.append(r)
[?2004l[?2004h>             suspicious_ids.add(r['event_id'])
[?2004l[?2004h>             break
[?2004l[?2004h> 
[?2004l[?2004h> # Sort matches by timestamp
[?2004l[?2004h> matches.sort(key=lambda x: x['timestamp'])
[?2004l[?2004h> for m in matches[:100]:
