[?2004hroot@c2d02cefd2ea:~# cat << 'EOF' > /tmp/details.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> eids = [
[?2004l[?2004h>     'evt-00088', # File Create
[?2004l[?2004h>     'evt-00528', 'evt-00530', 'evt-00542', 'evt-00551', 'evt-00594', 'evt-00610', 'evt-00752', 'evt-00765', # Proc Create
[?2004l[?2004h>     'evt-00844', 'evt-00845', 'evt-00846', 'evt-00847', 'evt-00848', 'evt-00849', 'evt-00850', # Registry, ImageLoad, etc
[?2004l[?2004h>     'evt-00851', 'evt-00852', 'evt-00853', 'evt-00854', 'evt-00855', 'evt-00856', 'evt-00857',
[?2004l[?2004h>     'evt-00858', 'evt-00859', 'evt-00860', 'evt-00863', 'evt-00890'
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> # Let's query them
[?2004l[?2004h> cursor.execute("SELECT * FROM events WHERE event_id IN ({})".format(", ".join([f"'{x}'" for x in eids])))
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by timestamp
[?2004l[?2004h> rows = sorted(rows, key=lambda x: x['timestamp'])
[?2004l[?2004h> 
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     print(f"=== EVENT {r['event_id']} (Code {r['event_code']}) ===")
[?2004l[?2004h>     for col in r.keys():
[?2004l[?2004h>         if r[col] is not None and str(r[col]).strip() != '':
[?2004l[?2004h>             print(f"  {col}: {r[col]}")
[?2004l[?2004h>     print()
[?2004l[?2004h> EOF
[?2004l[?2004hroot@c2d02cefd2ea:~# python3 /tmp/details.py > /tmp/details.txt
