[?2004l[?2004h> # We also want to check if any event contains these GUIDs or PIDs
[?2004l[?2004h> # Let's print out all event types we have
[?2004l[?2004h> for ev in all_events:
[?2004l[?2004h>     eid = ev['event_id']
[?2004l[?2004h>     code = ev['event_code']
[?2004l[?2004h>     host = ev['host']
[?2004l[?2004h>     msg = ev['message'] or ''
[?2004l[?2004h>     details = ev['details'] or ''
[?2004l[?2004h>     img = ev['image'] or ''
[?2004l[?2004h>     tgt_img = ev['target_image'] or ''
[?2004l[?2004h>     cmd = ev['command_line'] or ''
[?2004l[?2004h>     img_loaded = ev['image_loaded'] or ''
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if there is a direct match with malicious GUIDs
[?2004l[?2004h>     has_malicious_guid = False
[?2004l[?2004h>     for g in malicious_guids:
[?2004l[?2004h>         if ev.get('process_guid') == g or ev.get('parent_process_guid') == g:
[?2004l[?2004h>             has_malicious_guid = True
[?2004l[?2004h>             break
[?2004l[?2004h>         if g in msg or g in details:
[?2004l[?2004h>             has_malicious_guid = True
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>     # Check if there is a match with malicious PIDs in Security events
[?2004l[?2004h>     has_malicious_pid = False
[?2004l[?2004h>     for pid in malicious_pids:
[?2004l[?2004h>         pid_hex = f"0x{pid:x}"
[?2004l[?2004h>         if f"Process ID:\t\t{pid_hex}" in msg or f"Process ID: {pid}" in msg or f"ProcessId: {pid}" in msg or f"ProcessId: {pid}" in details:
[?2004l[?2004h>             has_malicious_pid = True
[?2004l[?2004h>             break
[?2004l[?2004h>         if f"New Process ID:\t\t{pid_hex}" in msg or f"New Process ID:\t{pid_hex}" in msg or f"New Process ID: {pid_hex}" in msg:
[?2004l[?2004h>             has_malicious_pid = True
[?2004l[?2004h>             break
[?2004l[?2004h>         if f"SourceProcessId: {pid}" in msg or f"TargetProcessId: {pid}" in msg:
[?2004l[?2004h>             has_malicious_pid = True
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>     # Special cases
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     if has_malicious_guid or has_malicious_pid:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # File creation for SimpleInjection.dll by GruntHTTP.exe
