[154.599648, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Classified {len(malicious)} events as malicious, {len(benign)} as benign.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.599764, "o", "# Let's inspect the classified malicious events by code\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.599853, "o", "code_counts = Counter([r['event_code'] for r in malicious])\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Malicious event code counts:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.599958, "o", "for code, count in code_counts.most_common():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  EventCode {code}: {count}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.600087, "o", "# Let's print out any EventCode 7 (Image Load) in the malicious list\r\n\u001b[?2004l\r\u001b[?2004h> malicious_code_7 = [r for r in malicious if r['event_code'] == 7]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.600206, "o", "print(f\"\\nMalicious EventCode 7 events: {len(malicious_code_7)}\")\r\n\u001b[?2004l\r\u001b[?2004h> for m7 in malicious_code_7:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.600251, "o", "    print(f\"  {m7['event_id']} | Image: {m7['image']} | Loaded: {m7['image_loaded']}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
