[278.301332, "i", "cat << 'EOF' > /tmp/write_findings.py\nimport json\n\n# Core set of malicious events representing the actual attack chain\nmalicious_events = [\n    'evt-00088', # Sysmon 11: File created (SimpleInjection.dll)\n    'evt-00528', # Security 4688: cmd.exe command execution\n    'evt-00542', # Sysmon 1: cmd.exe command execution\n    'evt-00530', # Security 4688: conhost.exe spawned by cmd.exe\n    'evt-00551', # Sysmon 1: conhost.exe spawned by cmd.exe\n    'evt-00544', # Sysmon 10: GruntHTTP.exe accessing cmd.exe\n    'evt-00594', # Sysmon 1: wuauclt.exe spawned by cmd.exe\n    'evt-00752', # Security 4688: wuauclt.exe spawned by cmd.exe\n    'evt-00613', # Sysmon 7: wuauclt.exe loading SimpleInjection.dll\n    'evt-00611', # Sysmon 10: wuauclt.exe accessing notepad.exe (CallTrace in SimpleInjection.dll)\n    'evt-00614', # Sysmon 8: CreateRemoteThread from wuauclt.exe to notepad.exe (Injection)\n    'evt-00610', # Sysmon 1: notepad.exe spawned by wuauclt.exe\n    'evt-00765', # Security 4688: notepad.exe spawned by wuauclt.exe\n    'evt-00839', # Security 5158: notepad.exe local port bind\n    'evt-00840', # Security 5156: notepad.exe WFP outbound connection permitted\n    'evt-00860', # Sysmon 3: notepad.exe outbound network connection\n    'evt-00863'  # Sysmon 22: notepad.exe DNS query\n]\n\n# Let's write the findings to findings.json\nwith open('/root/findings.json', 'w') as f:\n    json.dump(malicious_events, f)\n\nprint(f\"Wrote {len(malicious_events)} malicious events to /root/findings.json\")\nEOF\npython3 /tmp/write_findings.py\n"]
