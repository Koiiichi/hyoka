[17.908518, "i", "sqlite3 /root/data/eventlogs.db \"SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, target_image, service_name, target_object, details, message FROM events WHERE (image LIKE '%Grunt%' OR parent_image LIKE '%Grunt%' OR command_line LIKE '%Grunt%' OR image LIKE '%Injection%' OR command_line LIKE '%Injection%' OR target_image LIKE '%notepad%' OR image LIKE '%notepad%' OR target_object LIKE '%Injection%' OR details LIKE '%Injection%') ORDER BY timestamp;\"\n"]
