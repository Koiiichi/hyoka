[180.626705, "o", "\u001b[?2004hroot@c2d02cefd2ea:~# "]
[196.57076, "i", "cat << 'EOF' > /tmp/check_more.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's list the core events we identified as definitely malicious:\ndefinitely_malicious = [\n    'evt-00088', # File creation: SimpleInjection.dll\n    'evt-00528', # cmd.exe (4688)\n    'evt-00530', # conhost.exe (4688)\n    'evt-00531', # Pipe created (17)\n    'evt-00534', # Pipe connected (18)\n    'evt-00535', # Pipe created (17)\n    'evt-00536', # Pipe connected (18)\n    'evt-00540', # Registry bam cmd.exe (13)\n    'evt-00542', # cmd.exe (1)\n    'evt-00544', # ProcessAccess to cmd.exe (10)\n    'evt-00551', # conhost.exe (1)\n    'evt-00594', # wuauclt.exe (1)\n    'evt-00608', # Registry bam notepad.exe (13)\n    'evt-00610', # notepad.exe (1)\n    'evt-00613', # DLL Load: SimpleInjection.dll (7)\n    'evt-00614', # CreateRemoteThread to notepad (8)\n    'evt-00623', # wuauclt.exe terminated (5)\n    'evt-00646', # cmd.exe terminated (5)\n    'evt-00647', # Registry bam cmd.exe (13)\n    'evt-00653', # conhost.exe terminated (5)\n    'evt-00701', # Registry bam notepad.exe (13)\n    'evt-00752', # wuauclt.exe (4688)\n    'evt-00765', # notepad.exe (4688)\n    'evt-00840', # WFP permitted outbound (5156)\n    'evt-00860', # Network connection notepad (3)\n    'evt-00863'  # DNS Query notepad (22)\n]\n\n# Let's print out what other events involve those same process GUIDs or PIDs\n# to see if they are registry, file, or handle events that we should also flag.\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP.exe\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd.exe\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost.exe\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt.exe\n    '{71b87c12-d9fe-5f84-1a01-000000000500}', # notepad.exe\n}\n\ncursor.execute(\"SELECT * FROM events\")\nall_rows = cursor.fetchall()\n\nother_candidate_events = []\nfor r in all_rows:\n    eid = r['event_id']\n    if eid in definitely_malicious:\n        continue\n    \n    # Check if process_guid or parent_process_guid is malicious\n    pguid = r['process_guid']\n    p_pguid = r['parent_process_guid']\n    \n    if pguid in malicious_guids or p_pguid in malicious_guids:\n        other_candidate_events.append(r)\n\nprint(f\"Found {len(other_candidate_events)} other events referencing malicious GUIDs.\")\n# Group them by event_code\nfrom collections import Counter\ncnt = Counter([r['event_code'] for r in other_candidate_events])\nfor code, count in cnt.most_common():\n    print(f\"  Code {code}: {count}\")\n\nEOF\npython3 /tmp/check_more.py\n"]
