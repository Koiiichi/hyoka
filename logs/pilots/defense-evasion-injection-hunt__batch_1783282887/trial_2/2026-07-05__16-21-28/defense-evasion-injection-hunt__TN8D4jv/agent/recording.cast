[232.632526, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\\\"SELECT event_id, timestamp, host, event_code, user, target_user, src_ip, logon_type FROM events WHERE event_code IN (4624, 4625)\\\")\nfor r in cursor.fetchall():\n    # filter out typical local system logons if they are noisy\n    user_str = r['user'] or r['target_user'] or ''\n    if 'SYSTEM' in user_str or 'LOCAL SERVICE' in user_str or 'NETWORK SERVICE' in user_str:\n        continue\n    print(f\\\"{r['event_id']} | {r['timestamp']} | Host: {r['host']} | Code: {r['event_code']} | User: {user_str} | IP: {r['src_ip']} | Type: {r['logon_type']}\\\")\n\"\n"]
