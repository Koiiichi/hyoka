[65.881776, "i", "cat << 'EOF' > /tmp/details.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\neids = [\n    'evt-00088', # File Create\n    'evt-00528', 'evt-00530', 'evt-00542', 'evt-00551', 'evt-00594', 'evt-00610', 'evt-00752', 'evt-00765', # Proc Create\n    'evt-00844', 'evt-00845', 'evt-00846', 'evt-00847', 'evt-00848', 'evt-00849', 'evt-00850', # Registry, ImageLoad, etc\n    'evt-00851', 'evt-00852', 'evt-00853', 'evt-00854', 'evt-00855', 'evt-00856', 'evt-00857',\n    'evt-00858', 'evt-00859', 'evt-00860', 'evt-00863', 'evt-00890'\n]\n\n# Let's query them\ncursor.execute(\"SELECT * FROM events WHERE event_id IN ({})\".format(\", \".join([f\"'{x}'\" for x in eids])))\nrows = cursor.fetchall()\n\n# Sort by timestamp\nrows = sorted(rows, key=lambda x: x['timestamp'])\n\nfor r in rows:\n    print(f\"=== EVENT {r['event_id']} (Code {r['event_code']}) ===\")\n    for col in r.keys():\n        if r[col] is not None and str(r[col]).strip() != '':\n            print(f\"  {col}: {r[col]}\")\n    print()\nEOF\npython3 /tmp/details.py > /tmp/details.txt\ncat /tmp/details.txt\n"]
