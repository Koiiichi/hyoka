[196.576954, "o", "print(f\"Found {len(other_candidate_events)} other events referencing malicious GUIDs.\")\r\n\u001b[?2004l\r"]
[196.577016, "o", "\u001b[?2004h> # Group them by event_code\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.577065, "o", "> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.577141, "o", "cnt = Counter([r['event_code'] for r in other_candidate_events])\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.577197, "o", "> "]
[196.577277, "o", "for code, count in cnt.most_common():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.5774, "o", "    print(f\"  Code {code}: {count}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[196.57825, "o", "\u001b[?2004hroot@c2d02cefd2ea:~# "]
[196.578273, "o", "python3 /tmp/check_more.py\r\n\u001b[?2004l\r"]
