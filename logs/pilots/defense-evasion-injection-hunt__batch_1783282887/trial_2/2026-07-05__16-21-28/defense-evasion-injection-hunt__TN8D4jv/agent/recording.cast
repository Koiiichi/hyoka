[175.158635, "i", "cat << 'EOF' > /tmp/inspect_interesting.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ninterest_codes = [1, 3, 5, 8, 11, 12, 13, 14, 17, 18, 22, 4688, 5156, 5158]\n\ncursor.execute(\"SELECT event_id, timestamp, event_code, host, user, image, target_image, command_line, target_object, details FROM events WHERE event_code IN ({}) ORDER BY timestamp\".format(\", \".join(map(str, interest_codes))))\nrows = cursor.fetchall()\n\nprint(f\"Total interesting events: {len(rows)}\")\nfor r in rows:\n    img = r['image'] or ''\n    tgt = r['target_image'] or ''\n    cmd = r['command_line'] or ''\n    obj = r['target_object'] or ''\n    det = r['details'] or ''\n    \n    # Check if this event relates to our malicious sequence\n    is_rel = False\n    for keyword in ['grunt', 'simpleinjection', 'wuauclt', 'notepad', 'cmd.exe', 'conhost.exe', '10.10.10.5', 'tcpip\\\\parameters']:\n        if (keyword in img.lower() or keyword in tgt.lower() or keyword in cmd.lower() or \n            keyword in obj.lower() or keyword in det.lower()):\n            is_rel = True\n            break\n            \n    if is_rel:\n        print(f\"{r['event_id']} | Code: {r['event_code']} | Host: {r['host']} | Img: {r['image']} | Tgt: {r['target_image']} | CMD: {r['command_line']} | Obj: {r['target_object']}\")\n\nEOF\npython3 /tmp/inspect_interesting.py > /tmp/interesting.txt\ncat /tmp/interesting.txt\n"]
