[23.667788, "i", "cat << 'EOF' > /tmp/search.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's find all events containing suspicious keywords\nkeywords = ['Grunt', 'Injection', 'notepad', 'wuauclt', 'SimpleInjection', 'm.ward']\n\nsuspicious_ids = set()\n\nprint(\"=== SUSPICIOUS EVENTS INVOLVING KEYWORDS ===\")\nquery = \"\"\"\nSELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, target_image, service_name, target_object, details, message\nFROM events\n\"\"\"\ncursor.execute(query)\nrows = cursor.fetchall()\n\nmatches = []\nfor r in rows:\n    row_str = \" \".join([str(val) for val in dict(r).values() if val is not None])\n    for kw in keywords:\n        if kw.lower() in row_str.lower():\n            matches.append(r)\n            suspicious_ids.add(r['event_id'])\n            break\n\n# Sort matches by timestamp\nmatches.sort(key=lambda x: x['timestamp'])\nfor m in matches[:100]:\n    print(f\"{m['event_id']} | {m['timestamp']} | EventCode: {m['event_code']} | Host: {m['host']}\")\n    print(f\"  User: {m['user']} | Image: {m['image']} | ParentImage: {m['parent_image']}\")\n    print(f\"  CommandLine: {m['command_line']}\")\n    print(f\"  TargetImage: {m['target_image']} | ServiceName: {m['service_name']} | TargetObject: {m['target_object']}\")\n    print(f\"  Details: {m['details']}\")\n    print(\"-\"*50)\n\nprint(f\"Total matches: {len(matches)}\")\nEOF\npython3 /tmp/search.py > /tmp/results.txt\nhead -n 120 /tmp/results.txt\n"]
