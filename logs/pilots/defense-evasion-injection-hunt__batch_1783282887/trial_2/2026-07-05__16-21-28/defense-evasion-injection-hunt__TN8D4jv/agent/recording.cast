[196.593384, "o", "\u001b[?2004hroot@c2d02cefd2ea:~# "]
[203.437666, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}',\n    '{71b87c12-d9fe-5f84-1701-000000000500}',\n    '{71b87c12-d9fe-5f84-1801-000000000500}',\n    '{71b87c12-d9fe-5f84-1901-000000000500}',\n    '{71b87c12-d9fe-5f84-1a01-000000000500}',\n}\n\ndefinitely_malicious = [\n    'evt-00088', 'evt-00528', 'evt-00530', 'evt-00531', 'evt-00534', 'evt-00535', 'evt-00536', 'evt-00540',\n    'evt-00542', 'evt-00544', 'evt-00551', 'evt-00594', 'evt-00608', 'evt-00610', 'evt-00613', 'evt-00614',\n    'evt-00623', 'evt-00646', 'evt-00647', 'evt-00653', 'evt-00701', 'evt-00752', 'evt-00765', 'evt-00840',\n    'evt-00860', 'evt-00863'\n]\n\ncursor.execute(\\\"SELECT event_id, event_code, host, image, target_image, command_line, target_object, details, message FROM events WHERE event_id NOT IN ({}) AND (process_guid IN ({}) OR parent_process_guid IN ({}))\\\".format(\n    \\\", \\\".join([f\\\"'{x}'\\\" for x in definitely_malicious]),\n    \\\", \\\".join([f\\\"'{x}'\\\" for x in malicious_guids]),\n    \\\", \\\".join([f\\\"'{x}'\\\" for x in malicious_guids])\n))\nrows = cursor.fetchall()\nfor r in rows:\n    if r['event_code'] in (10, 12):\n        print(f\\\"{r['event_id']} | Code: {r['event_code']} | Img: {r['image']} | Obj: {r['target_object']} | Details: {r['details']} | Msg: {r['message'][:100]}\\\")\n\"\n"]
