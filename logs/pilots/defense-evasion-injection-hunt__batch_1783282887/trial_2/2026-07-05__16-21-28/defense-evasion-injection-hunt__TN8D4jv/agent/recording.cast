[154.596423, "o", "\u001b[?2004h>     3356, # GruntHTTP.exe\r\n\u001b[?2004l\r\u001b[?2004h>     3148, # cmd.exe\r\n\u001b[?2004l\r\u001b[?2004h>     4288, # conhost.exe\r\n\u001b[?2004l\r\u001b[?2004h>     6208, # wuauclt.exe\r\n\u001b[?2004l\r\u001b[?2004h>     2368, # notepad.exe\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[154.596645, "o", "> # We also want to check if any event contains these GUIDs or PIDs\r\n\u001b[?2004l\r\u001b[?2004h> # Let's print out all event types we have\r\n\u001b[?2004l\r\u001b[?2004h> for ev in all_events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.596917, "o", "    eid = ev['event_id']\r\n\u001b[?2004l\r\u001b[?2004h>     code = ev['event_code']\r\n\u001b[?2004l\r\u001b[?2004h>     host = ev['host']\r\n\u001b[?2004l\r\u001b[?2004h>     msg = ev['message'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     details = ev['details'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     img = ev['image'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     tgt_img = ev['target_image'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = ev['command_line'] or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.597083, "o", "    img_loaded = ev['image_loaded'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Check if there is a direct match with malicious GUIDs\r\n\u001b[?2004l\r\u001b[?2004h>     has_malicious_guid = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.597191, "o", "    for g in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h>         if ev.get('process_guid') == g or ev.get('parent_process_guid') == g:\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.597222, "o", "> "]
[154.597334, "o", "            has_malicious_guid = True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.597351, "o", "        if g in msg or g in details:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.59741, "o", "            has_malicious_guid = True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.597572, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h>     # Check if there is a match with malicious PIDs in Security events\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.597647, "o", "    has_malicious_pid = False\r\n\u001b[?2004l\r\u001b[?2004h>     for pid in malicious_pids:\r\n\u001b[?2004l\r\u001b[?2004h>         pid_hex = f\"0x{pid:x}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.597766, "o", "        if f\"Process ID:\\t\\t{pid_hex}\" in msg or f\"Process ID: {pid}\" in msg or f\"ProcessId: {pid}\" in msg or f\"ProcessId: {pid}\" in details:"]
[154.597968, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             has_malicious_pid = True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.598073, "o", "        if f\"New Process ID:\\t\\t{pid_hex}\" in msg or f\"New Process ID:\\t{pid_hex}\" in msg or f\"New Process ID: {pid_hex}\" in msg:\r\n\u001b[?2004l\r\u001b[?2004h>             has_malicious_pid = True\r\n\u001b[?2004l\r"]
[154.598151, "o", "\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.598293, "o", "        if f\"SourceProcessId: {pid}\" in msg or f\"TargetProcessId: {pid}\" in msg:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.59842, "o", "            has_malicious_pid = True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[154.598552, "o", "\u001b[?2004h>     # Special cases\r\n\u001b[?2004l\r\u001b[?2004h>     is_malicious = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.598595, "o", "    if has_malicious_guid or has_malicious_pid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.598791, "o", "        is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # File creation for SimpleInjection.dll by GruntHTTP.exe\r\n\u001b[?2004l\r"]
[154.598892, "o", "\u001b[?2004h>     if code == 11 and 'SimpleInjection.dll' in msg:\r\n\u001b[?2004l\r\u001b[?2004h>         is_malicious = True"]
