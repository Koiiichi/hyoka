[154.594055, "i", "cat << 'EOF' > /tmp/classify.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's get all events\ncursor.execute(\"SELECT * FROM events\")\nall_events = [dict(r) for r in cursor.fetchall()]\n\n# Group events by host\nprint(f\"Total events in database: {len(all_events)}\")\n\n# Let's categorize them by looking at characteristics\nmalicious = []\nbenign = []\n\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP.exe\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd.exe\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost.exe\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt.exe\n    '{71b87c12-d9fe-5f84-1a01-000000000500}', # notepad.exe\n}\n\nmalicious_pids = {\n    3356, # GruntHTTP.exe\n    3148, # cmd.exe\n    4288, # conhost.exe\n    6208, # wuauclt.exe\n    2368, # notepad.exe\n}\n\n# We also want to check if any event contains these GUIDs or PIDs\n# Let's print out all event types we have\nfor ev in all_events:\n    eid = ev['event_id']\n    code = ev['event_code']\n    host = ev['host']\n    msg = ev['message'] or ''\n    details = ev['details'] or ''\n    img = ev['image'] or ''\n    tgt_img = ev['target_image'] or ''\n    cmd = ev['command_line'] or ''\n    img_loaded = ev['image_loaded'] or ''\n    \n    # Check if there is a direct match with malicious GUIDs\n    has_malicious_guid = False\n    for g in malicious_guids:\n        if ev.get('process_guid') == g or ev.get('parent_process_guid') == g:\n            has_malicious_guid = True\n            break\n        if g in msg or g in details:\n            has_malicious_guid = True\n            break\n            \n    # Check if there is a match with malicious PIDs in Security events\n    has_malicious_pid = False\n    for pid in malicious_pids:\n        pid_hex = f\"0x{pid:x}\"\n        if f\"Process ID:\\t\\t{pid_hex}\" in msg or f\"Process ID: {pid}\" in msg or f\"ProcessId: {pid}\" in msg or f\"ProcessId: {pid}\" in details:\n            has_malicious_pid = True\n            break\n        if f\"New Process ID:\\t\\t{pid_hex}\" in msg or f\"New Process ID:\\t{pid_hex}\" in msg or f\"New Process ID: {pid_hex}\" in msg:\n            has_malicious_pid = True\n            break\n        if f\"SourceProcessId: {pid}\" in msg or f\"TargetProcessId: {pid}\" in msg:\n            has_malicious_pid = True\n            break\n            \n    # Special cases\n    is_malicious = False\n    if has_malicious_guid or has_malicious_pid:\n        is_malicious = True\n        \n    # File creation for SimpleInjection.dll by GruntHTTP.exe\n    if code == 11 and 'SimpleInjection.dll' in msg:\n        is_malicious = True\n        \n    # Registry value set or other events specifically targeting or involving the malicious files\n    if 'SimpleInjection.dll' in cmd or 'SimpleInjection.dll' in msg or 'SimpleInjection.dll' in details:\n        is_malicious = True\n    if 'GruntHTTP.exe' in cmd or 'GruntHTTP.exe' in msg or 'GruntHTTP.exe' in details:\n        is_malicious = True\n        \n    if is_malicious:\n        malicious.append(ev)\n    else:\n        benign.append(ev)\n\nprint(f\"Classified {len(malicious)} events as malicious, {len(benign)} as benign.\")\n\n# Let's inspect the classified malicious events by code\nfrom collections import Counter\ncode_counts = Counter([r['event_code'] for r in malicious])\nprint(\"Malicious event code counts:\")\nfor code, count in code_counts.most_common():\n    print(f\"  EventCode {code}: {count}\")\n\n# Let's print out any EventCode 7 (Image Load) in the malicious list\nmalicious_code_7 = [r for r in malicious if r['event_code'] == 7]\nprint(f\"\\nMalicious EventCode 7 events: {len(malicious_code_7)}\")\nfor m7 in malicious_code_7:\n    print(f\"  {m7['event_id']} | Image: {m7['image']} | Loaded: {m7['image_loaded']}\")\n\n# Let's print out all event codes to understand if any of them should be filtered\nEOF\npython3 /tmp/classify.py\n"]
