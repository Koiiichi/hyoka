[31.496804, "i", "cat << 'EOF' > /tmp/analyze_sessions.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's inspect some unique columns to find potential indicators:\n# - image/parent_image names\n# - command_lines\n# - network connections (Event ID 3)\n# - process access (Event ID 10)\n# - registry modifications (Event ID 12, 13, 14)\n# - file creation (Event ID 11)\n# - service creations\n\nprint(\"=== PROCESS CREATION EVENTS (1, 4688) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, image, parent_image, command_line FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image']} | {r['parent_image']} | {r['command_line']}\")\n\nprint(\"\\n=== NETWORK CONNECTIONS (3, 5156) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, image, src_ip, dst_ip, dst_port FROM events WHERE event_code IN (3, 5156) AND (image NOT LIKE '%svchost%' AND image NOT LIKE '%System%' AND image NOT LIKE '%spoolsv%') ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image']} | {r['src_ip']} -> {r['dst_ip']}:{r['dst_port']}\")\n\nprint(\"\\n=== FILE CREATION (11) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, image, target_image FROM events WHERE event_code = 11 ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image']} | {r['target_image']}\")\n\nprint(\"\\n=== SERVICE MODIFICATIONS ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, service_name, service_file_name FROM events WHERE service_name IS NOT NULL OR service_file_name IS NOT NULL ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['service_name']} | {r['service_file_name']}\")\n\nEOF\npython3 /tmp/analyze_sessions.py > /tmp/summary.txt\ncat /tmp/summary.txt\n"]
