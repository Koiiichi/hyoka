[261.926121, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\npids = [3356, 3148, 4288, 6208, 2368]\ncursor.execute(\\\"SELECT event_id, event_code, host, image, src_ip, dst_ip, dst_port, message FROM events WHERE event_code IN (3, 5156, 5158) AND host = 'WS-05.corp.example'\\\")\nrows = cursor.fetchall()\nfor r in rows:\n    msg = r['message'] or ''\n    matched = False\n    for pid in pids:\n        if f'Process ID: {pid}' in msg or f'Process ID:\\t\\t{pid}' in msg or f'ProcessId: {pid}' in msg or f'0x{pid:x}' in msg:\n            matched = True\n            break\n    if matched or r['image'] is not None and any(x in r['image'].lower() for x in ['notepad', 'wuauclt', 'cmd.exe', 'conhost']):\n        print(f\\\"{r['event_id']} | Code: {r['event_code']} | Img: {r['image']} | Src: {r['src_ip']} | Dst: {r['dst_ip']}:{r['dst_port']}\\\")\n\"\n"]
