[154.599438, "o", "> "]
[154.599491, "o", "    if is_malicious:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious.append(ev)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
