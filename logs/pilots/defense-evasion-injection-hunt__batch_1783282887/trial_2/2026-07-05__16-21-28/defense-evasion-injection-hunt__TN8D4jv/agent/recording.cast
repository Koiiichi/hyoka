[88.052962, "i", "cat << 'EOF' > /tmp/search_all_hosts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's check for any network connections (Code 3 or 5156) containing 10.10.10.5\nprint(\"=== CONNECTIONS TO 10.10.10.5 ===\")\ncursor.execute(\"SELECT * FROM events WHERE dst_ip = '10.10.10.5' OR src_ip = '10.10.10.5' OR message LIKE '%10.10.10.5%' OR details LIKE '%10.10.10.5%'\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | Host: {r['host']} | Code: {r['event_code']} | Image: {r['image']} | dst_ip: {r['dst_ip']} | dst_port: {r['dst_port']}\")\n\n# Let's check for other notepad.exe or wuauclt.exe or Grunt or SimpleInjection references on WS-06 or DC01\nprint(\"\\n=== SUSPICIOUS PROCESSES ON OTHER HOSTS ===\")\ncursor.execute(\"SELECT * FROM events WHERE host != 'WS-05.corp.example' AND (image LIKE '%notepad%' OR image LIKE '%wuauclt%' OR image LIKE '%Grunt%' OR image LIKE '%Injection%' OR command_line LIKE '%notepad%' OR command_line LIKE '%wuauclt%' OR command_line LIKE '%Grunt%' OR command_line LIKE '%Injection%')\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | Host: {r['host']} | Code: {r['event_code']} | Image: {r['image']} | CMD: {r['command_line']}\")\n\nEOF\npython3 /tmp/search_all_hosts.py\n"]
