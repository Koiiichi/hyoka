[238.214662, "o", "\u001b[?2004hroot@c2d02cefd2ea:~# "]
[245.43326, "i", "cat << 'EOF' > /tmp/filter_ws05.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt\n    '{71b87c12-d9fe-5f84-1a01-000000000500}', # notepad\n}\n\n# We will select all events where:\n# - process_guid is in malicious_guids\n# - parent_process_guid is in malicious_guids\n# - Or event is event_id 'evt-00088' (file creation)\n# - Or the message or details refers to these process GUIDs\n# - Or security event targets these processes\n\ncursor.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\nrows = cursor.fetchall()\n\nmal_events = []\nfor r in rows:\n    eid = r['event_id']\n    r_dict = dict(r)\n    \n    # Check if this event is one of our malicious group\n    is_mal = False\n    if eid == 'evt-00088':\n        is_mal = True\n    elif r['process_guid'] in malicious_guids:\n        is_mal = True\n    elif r['parent_process_guid'] in malicious_guids:\n        is_mal = True\n    else:\n        # Check text fields for GUIDs\n        msg = r['message'] or ''\n        details = r['details'] or ''\n        for g in malicious_guids:\n            if g in msg or g in details:\n                is_mal = True\n                break\n                \n    if is_mal:\n        mal_events.append(r_dict)\n\nprint(f\"Found {len(mal_events)} malicious events.\")\n# Group and print them\nfor m in mal_events:\n    # Print high-level fields\n    print(f\"{m['event_id']} | Code {m['event_code']} | Img: {m['image']} | Parent: {m['parent_image']} | CMD: {m['command_line']} | Loaded: {m['image_loaded']} | Target: {m['target_image']} | Obj: {m['target_object']}\")\n\nEOF\npython3 /tmp/filter_ws05.py > /tmp/mal_ws05_filtered.txt\nwc -l /tmp/mal_ws05_filtered.txt\n"]
[245.433659, "o", "cat << 'EOF' > /tmp/filter_ws05.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
