[48.620768, "i", "cat << 'EOF' > /tmp/trace_guids.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's find process GUIDs for:\n# 1. GruntHTTP.exe\n# 2. cmd.exe (under GruntHTTP.exe)\n# 3. wuauclt.exe\n# 4. notepad.exe\n\n# Let's search all process creation events first to extract their process_guid\ncursor.execute(\"SELECT event_id, timestamp, event_code, host, image, process_guid, parent_process_guid FROM events WHERE event_code IN (1, 4688)\")\nproc_rows = cursor.fetchall()\n\nguid_to_name = {}\nfor r in proc_rows:\n    pguid = r['process_guid']\n    image = r['image']\n    if pguid and image:\n        guid_to_name[pguid] = image\n\n# Let's find process GUIDs specifically for our suspects\nsuspect_guids = set()\nsuspect_images = ['grunthttp.exe', 'simpleinjection.dll', 'wuauclt.exe', 'notepad.exe']\n\nfor r in proc_rows:\n    pguid = r['process_guid']\n    image = r['image'] or ''\n    cmd = r['command_line'] or ''\n    parent_guid = r['parent_process_guid']\n    \n    is_suspect = False\n    for s in suspect_images:\n        if s in image.lower() or s in cmd.lower():\n            is_suspect = True\n            break\n    \n    if is_suspect:\n        if pguid: suspect_guids.add(pguid)\n        if parent_guid: suspect_guids.add(parent_guid)\n\nprint(f\"Initial suspect process GUIDs: {suspect_guids}\")\n\n# Propagate: find all child processes of suspect processes\nadded = True\nwhile added:\n    added = False\n    for r in proc_rows:\n        parent_guid = r['parent_process_guid']\n        pguid = r['process_guid']\n        if parent_guid in suspect_guids and pguid not in suspect_guids:\n            suspect_guids.add(pguid)\n            added = True\n\nprint(f\"Propagated suspect process GUIDs: {suspect_guids}\")\n\n# Now, let's find ALL events in the database that reference any of these process GUIDs\n# (in process_guid, parent_process_guid, or source_process_guid/target_process_guid/etc. inside the message or details, or in specific columns)\nsuspect_event_ids = set()\n\n# Let's fetch all events and check if their process_guid or parent_process_guid or target_process_guid matches\ncursor.execute(\"SELECT * FROM events\")\nall_events = cursor.fetchall()\n\nfor r in all_events:\n    eid = r['event_id']\n    r_dict = dict(r)\n    \n    match = False\n    # Check specific columns\n    for col in ['process_guid', 'parent_process_guid']:\n        if r_dict.get(col) in suspect_guids:\n            match = True\n            break\n            \n    # Check message and details for any of the GUIDs\n    if not match:\n        msg_details = (r_dict.get('message') or '') + ' ' + (r_dict.get('details') or '')\n        for guid in suspect_guids:\n            if guid in msg_details:\n                match = True\n                break\n                \n    # Also, check if the image or target_image or command_line contains any suspect names\n    if not match:\n        img_cmd = (r_dict.get('image') or '') + ' ' + (r_dict.get('target_image') or '') + ' ' + (r_dict.get('command_line') or '')\n        for s in suspect_images:\n            if s in img_cmd.lower():\n                match = True\n                break\n                \n    if match:\n        suspect_event_ids.add(eid)\n\nprint(f\"Found {len(suspect_event_ids)} events associated with malicious/suspect processes.\")\n\n# Let's print them sorted by timestamp\nsuspect_events_sorted = [r for r in all_events if r['event_id'] in suspect_event_ids]\nsuspect_events_sorted.sort(key=lambda x: x['timestamp'])\n\nfor se in suspect_events_sorted:\n    print(f\"{se['event_id']} | {se['timestamp']} | EventCode: {se['event_code']} | Host: {se['host']} | User: {se['user'] or se['target_user']} | Image: {se['image']} | ParentImage: {se['parent_image']} | CMD: {se['command_line']} | TargetImage: {se['target_image']} | Svc: {se['service_name']} | SvcFile: {se['service_file_name']}\")\n\nEOF\npython3 /tmp/trace_guids.py > /tmp/malicious_sequence.txt\nhead -n 50 /tmp/malicious_sequence.txt\n"]
