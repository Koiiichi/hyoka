[175.160802, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> rows = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total interesting events: {len(rows)}\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     img = r['image'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     tgt = r['target_image'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = r['command_line'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     obj = r['target_object'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     det = r['details'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Check if this event relates to our malicious sequence\r\n\u001b[?2004l\r\u001b[?2004h>     is_rel = False\r\n\u001b[?2004l\r\u001b[?2004h>     for keyword in ['grunt', 'simpleinjection', 'wuauclt', 'notepad', 'cmd.exe', 'conhost.exe', '10.10.10.5', 'tcpip\\\\parameters']:\r\n\u001b[?2004l\r\u001b[?2004h>         if (keyword in img.lower() or keyword in tgt.lower() or keyword in cmd.lower() or \r\n\u001b[?2004l\r\u001b[?2004h>             keyword in obj.lower() or keyword in det.lower()):\r\n\u001b[?2004l\r\u001b[?2004h>             is_rel = True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     if is_rel:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"{r['event_id']} | Code: {r['event_code']} | Host: {r['host']} | Img: {r['image']} | Tgt: {r['target_image']} | CMD: {r['command_line']} | Obj: {r['target_object']}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
