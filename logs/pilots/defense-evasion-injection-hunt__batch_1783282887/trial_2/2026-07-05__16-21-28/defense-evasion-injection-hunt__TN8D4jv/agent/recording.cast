[125.565912, "i", "cat << 'EOF' > /tmp/search_files_reg.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Query all file creation events\nprint(\"=== FILE CREATIONS (11) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, image, target_image FROM events WHERE event_code = 11\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['image']} | {r['target_image']}\")\n\n# Query any other potentially suspicious command lines across all hosts\nprint(\"\\n=== ALL CMD LINES ON WS-06 AND DC01 ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, image, command_line FROM events WHERE host != 'WS-05.corp.example' AND event_code IN (1, 4688)\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image']} | {r['command_line']}\")\n\nEOF\npython3 /tmp/search_files_reg.py\n"]
