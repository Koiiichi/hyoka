[238.198195, "i", "cat << 'EOF' > /tmp/dump_ws05.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, timestamp, event_code, host, user, image, target_image, command_line, target_object, message FROM events WHERE host = 'WS-05.corp.example' AND timestamp >= '2026-05-06T00:00:25Z' ORDER BY timestamp\")\nrows = cursor.fetchall()\n\nprint(f\"Total events on WS-05 in this window: {len(rows)}\")\nfor r in rows:\n    img = r['image'] or ''\n    tgt = r['target_image'] or ''\n    cmd = r['command_line'] or ''\n    obj = r['target_object'] or ''\n    user = r['user'] or ''\n    \n    # We can print high-level info for each event\n    print(f\"{r['event_id']} | {r['timestamp']} | Code: {r['event_code']} | User: {user} | Img: {img} | Tgt: {tgt} | CMD: {cmd} | Obj: {obj}\")\n\nEOF\npython3 /tmp/dump_ws05.py > /tmp/ws05_all.txt\nwc -l /tmp/ws05_all.txt\n"]
