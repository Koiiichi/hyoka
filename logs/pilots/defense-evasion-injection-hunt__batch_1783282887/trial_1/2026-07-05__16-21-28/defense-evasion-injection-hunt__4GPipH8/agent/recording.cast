Parameters\\Adapters\\{CA598CB3-EAA8-4D1E-B6BB-8D6D3BAC3BE5}|\r\nevt-01300|2026-05-06T00:02:40.636Z|10|||||||\r\nevt-01301|2026-05-06T00:02:40.636Z|12||C:\\windows\\System32\\svchost.exe||||HKLM\\System\\CurrentControlSet|\r\nevt-01302|2026-05-06T00:02:40.637Z|11|||||||\r\nevt-01303|2026-05-06T00:02:40.637Z|12||C:\\windows\\System32\\svchost.exe||||HKLM\\System\\CurrentControlSet|\r\nevt-01304|2026-05-06T00:02:40.638Z|7040|||||||\r\nevt-01305|2026-05-06T00:02:40.638Z|13||C:\\windows\\system32\\services.exe||||HKLM\\System\\CurrentControlSet\\Services\\NdisCap\\Start|DWORD (0x00000003)\r\nevt-01306|2026-05-06T00:02:40.639Z|11||System|||||\r\nevt-01307|2026-05-06T00:02:40.639Z|4703|WS-05$||||||\r\nevt-01308|2026-05-06T00:02:40.640Z|23|NT AUTHORITY\\SYSTEM|C:\\Packages\\Plugins\\Microsoft.Azure.NetworkWatcher.NetworkWatcherAgentWindows\\1.4.1654.1\\NetworkWatcherAgent\\NetworkWatcherAgent.exe|||||\r\nevt-01309|2026-05-06T00:02:40.641Z|4703|WS-05$||||||\r\nevt-01310|2026-05-06T00:02:40.641Z|5158|||||||\r\nevt-01311|2026-05-06T00:02:40.641Z|5156|||||||\r\nevt-01312|2026-05-06T00:02:40.642Z|5158|||||||\r\nevt-01313|2026-05-06T00:02:40.642Z|5158|||||||\r\nevt-01319|2026-05-06T00:02:50.689Z|5158|||||||\r\nevt-01320|2026-05-06T00:02:50.689Z|5156|||||||\r\nevt-01325|2026-05-06T00:02:54.722Z|5158|||||||\r\nevt-01326|2026-05-06T00:02:54.723Z|5156|||||||\r\n"]
[16.436377, "o", "\u001b[?2004hroot@179b3aeada33:~# "]
[26.497607, "i", "cat << 'EOF' > inspect_events.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's get all events from event_id evt-00500 to evt-00900\ncur.execute(\"SELECT * FROM events WHERE event_id >= 'evt-00500' AND event_id <= 'evt-00900' ORDER BY event_id\")\nfor r in cur.fetchall():\n    # Only print if they are on WS-05 and don't seem like noise (like standard system svchost registry noise)\n    # Wait, actually, let's print everything but nicely formatted so we can analyze it, or filter by known malicious processes:\n    # GruntHTTP.exe, wuauclt.exe, notepad.exe, cmd.exe, conhost.exe\n    # Or we can inspect all of them.\n    # Let's just print them to check which ones are related to the intrusion.\n    d = dict(r)\n    # filter out some noisy system events if necessary, but keep it broad\n    print(f\"{d['event_id']} | {d['timestamp']} | {d['event_code']} | {d['user']} | {d['image']} | {d['parent_image']} | {d['command_line']} | {d['target_image']} | {d['target_object']} | {d['details']} | {d['message'][:100] if d['message'] else ''}\")\n\nEOF\npython3 inspect_events.py > /tmp/events.txt\nhead -n 100 /tmp/events.txt\n"]
[26.499987, "o", "cat << 'EOF' > inspect_events.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's get all events from event_id evt-00500 to evt-00900\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT * FROM events WHERE event_id >= 'evt-00500' AND event_id <= 'evt-00900' ORDER BY event_id\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     # Only print if they are on WS-05 and don't seem like noise (like standard system svchost registry noise)\r\n\u001b[?2004l\r\u001b[?2004h>     # Wait, actually, let's print everything but nicely formatted so we can analyze it, or filter by known malicious processes:\r\n\u001b[?2004l\r\u001b[?2004h>     # GruntHTTP.exe, wuauclt.exe, notepad.exe, cmd.exe, conhost.exe\r\n\u001b[?2004l\r\u001b[?2004h>     # Or we can inspect all of them.\r\n\u001b[?2004l\r\u001b[?2004h>     # Let's just print them to check which ones are related to the intrusion.\r\n\u001b[?2004l\r\u001b[?2004h>     d = dict(r)\r\n\u001b[?2004l\r\u001b[?2004h>     # filter out some noisy system events if necessary, but keep it broad\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{d['event_id']} | {d['timestamp']} | {d['event_code']} | {d['user']} | {d['image']} | {d['parent_image']} | {d['command_line']} | {d['target_image']} | {d['target_object']} | {d['details']} | {d['message'][:100] if d['message'] else ''}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[26.501072, "o", "\u001b[?2004hroot@179b3aeada33:~# python3 inspect_events.py > /tmp/events.txt\r\n\u001b[?2004l\r"]
