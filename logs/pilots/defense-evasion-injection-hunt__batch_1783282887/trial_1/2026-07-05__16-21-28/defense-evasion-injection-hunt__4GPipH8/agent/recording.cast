[48.642928, "o", "# Let's find ALL events that are related to these GUIDs\r\n\u001b[?2004l\r\u001b[?2004h> # 1. Any event where process_guid or parent_process_guid is in guids.\r\n\u001b[?2004l\r\u001b[?2004h> # 2. Any event where the message/details contain one of these GUIDs.\r\n\u001b[?2004l\r\u001b[?2004h> "]
