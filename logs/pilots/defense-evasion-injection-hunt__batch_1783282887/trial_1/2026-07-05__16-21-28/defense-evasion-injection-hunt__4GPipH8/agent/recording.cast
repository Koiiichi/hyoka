[138.196092, "i", "cat << 'EOF' > list_other_processes.py\nimport sqlite3\nfrom collections import Counter\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, image, parent_image, command_line FROM events WHERE host = 'WS-05.corp.example' AND event_id >= 'evt-00528' ORDER BY event_id\")\nevents = [dict(r) for r in cur.fetchall()]\n\nproc_counts = Counter()\nfor e in events:\n    proc_counts[e['image']] += 1\n\nfor p, c in proc_counts.most_common():\n    print(f\"{p} : {c} events\")\n\nEOF\npython3 list_other_processes.py\n"]
