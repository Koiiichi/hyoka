[115.555749, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.555784, "o", "        matched_pid = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.555799, "o", "        for hp in mal_hex_pids:\r\n\u001b[?2004l\r"]
[115.555946, "o", "\u001b[?2004h>             if hp in msg:\r\n\u001b[?2004l\r\u001b[?2004h>                 is_rel = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.55597, "o", "                matched_pid = hp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.555983, "o", "                \r\n\u001b[?2004l\r"]
[115.556062, "o", "\u001b[?2004h>         if is_rel:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.556081, "o", "            # Print brief details\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.556435, "o", "            print(f\"{e['event_id']} | EC: {e['event_code']} | ProcessId: {matched_pid} | Message snippet: {e['message'][:120].replace('\\n', ' ')}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[115.557296, "o", "\u001b[?2004hroot@179b3aeada33:~# python3 inspect_detailed_events.py\r\n\u001b[?2004l\r"]
