[57.379257, "o", "GUID Meta: {\r\n  \"{71b87c12-d7e5-5f84-0d01-000000000500}\": {\r\n    \"pid\": 3356,\r\n    \"hex_pid\": \"0xd1c\",\r\n    \"image\": \"C:\\\\Users\\\\m.ward\\\\Desktop\\\\GruntHTTP.exe\"\r\n  },\r\n  \"{71b87c12-d9fe-5f84-1701-000000000500}\": {\r\n    \"pid\": 3148,\r\n    \"hex_pid\": \"0xc4c\",\r\n    \"image\": \"C:\\\\Windows\\\\System32\\\\cmd.exe\"\r\n  },\r\n  \"{71b87c12-d9fe-5f84-1801-000000000500}\": {\r\n    \"pid\": 4288,\r\n    \"hex_pid\": \"0x10c0\",\r\n    \"image\": \"C:\\\\Windows\\\\System32\\\\conhost.exe\"\r\n  },\r\n  \"{71b87c12-d9fe-5f84-1901-000000000500}\": {\r\n    \"pid\": 6208,\r\n    \"hex_pid\": \"0x1840\",\r\n    \"image\": \"C:\\\\Windows\\\\System32\\\\wuauclt.exe\"\r\n  },\r\n  \"{71b87c12-d9fe-5f84-1a01-000000000500}\": {\r\n    \"pid\": 2368,\r\n    \"hex_pid\": \"0x940\",\r\n    \"image\": \"C:\\\\Windows\\\\System32\\\\notepad.exe\"\r\n  }\r\n}\r\n"]
[57.381064, "o", "\u001b[?2004hroot@179b3aeada33:~# "]
[68.061856, "i", "cat << 'EOF' >> trace_intrusion_v2.py\n\n# Let's map out matches in all_events\nmal_event_ids = set()\n\n# PIDs to check\nmal_pids = {meta['pid'] for meta in guid_meta.values() if meta['pid']}\nmal_hex_pids = {meta['hex_pid'].lower() for meta in guid_meta.values() if meta['hex_pid']}\nmal_names = {'grunthttp.exe', 'wuauclt.exe', 'notepad.exe', 'simpleinjection.dll', 'cmd.exe', 'conhost.exe'}\n\n# Let's trace why each event might be malicious\nreasons = {}\n\nfor e in all_events:\n    eid = e['event_id']\n    ec = e['event_code']\n    msg = (e['message'] or '').lower()\n    det = (e['details'] or '').lower()\n    cl = (e['command_line'] or '').lower()\n    img = (e['image'] or '').lower()\n    pimg = (e['parent_image'] or '').lower()\n    pguid = (e['parent_process_guid'] or '').lower()\n    guid = (e['process_guid'] or '').lower()\n    t_img = (e['target_image'] or '').lower()\n    t_obj = (e['target_object'] or '').lower()\n    host = e['host']\n    \n    # We only care about WS-05 host since that's where the intrusion happened\n    # Wait, let's verify if there is any intrusion on other hosts.\n    # Is there? Let's check. If the adversary moved laterally, they'd use other hosts.\n    # But since we saw GruntHTTP was on WS-05, let's look closely at WS-05 first.\n    # Actually, we can check all hosts if they contain any mal_names or mal_pids.\n    \n    is_mal = False\n    reason = []\n    \n    # 1. Guid check\n    if guid in mal_guids:\n        is_mal = True\n        reason.append(\"process_guid\")\n    if pguid in mal_guids:\n        is_mal = True\n        reason.append(\"parent_process_guid\")\n        \n    # 2. Message / Details Guid check\n    for g in mal_guids:\n        if g in msg or g in det:\n            is_mal = True\n            reason.append(f\"contains_guid_{g}\")\n            \n    # 3. PID / Hex PID check\n    # Be careful with false positives (like a random number matching PID).\n    # Let's see if PID/HexPID matches specifically in a Process ID context.\n    # In Security logs (like 4688, 4673, 4656, 4663, 4658), the process ID is represented in hex, e.g. \"Process ID: 0xc4c\" or \"ProcessId: 0xc4c\" or \"New Process ID: 0xc4c\".\n    # Or \"Creator Process ID: 0xd1c\".\n    # Let's search for hex PID with boundary or labels.\n    for hpid in mal_hex_pids:\n        if hpid in msg or hpid in det:\n            # Let's ensure it's not a false positive\n            # We can print these to verify\n            is_mal = True\n            reason.append(f\"contains_hex_pid_{hpid}\")\n            \n    # 4. Explicit malicious process name/file matches on WS-05\n    if host == 'WS-05.corp.example':\n        if any(name in cl or name in img or name in pimg or name in t_img or name in t_obj for name in mal_names):\n            # But cmd.exe/conhost.exe/wuauclt.exe/notepad.exe might have benign uses?\n            # On WS-05, during this 1-minute window, is there any benign use of these?\n            # Let's check if there are other processes of cmd.exe or notepad.exe\n            # Let's include them if they are associated with our malicious parent or activity.\n            if 'grunthttp' in cl or 'grunthttp' in img or 'grunthttp' in pimg or 'simpleinjection' in cl or 'simpleinjection' in det or 'simpleinjection' in msg:\n                is_mal = True\n                reason.append(\"explicit_mal_name\")\n\n    if is_mal:\n        mal_event_ids.add(eid)\n        reasons[eid] = reason\n\nprint(f\"Found {len(mal_event_ids)} potentially malicious events.\")\n# Let's write them to a file with details for manual verification\nwith open('/tmp/pot_mal.txt', 'w') as f:\n    for eid in sorted(mal_event_ids):\n        # find event\n        e = next(ev for ev in all_events if ev['event_id'] == eid)\n        f.write(f\"{eid} | {e['timestamp']} | {e['event_code']} | {e['host']} | {e['user']} | {e['image']} | {e['parent_image']} | {e['command_line']} | {reasons[eid]}\\n\")\n\nEOF\npython3 trace_intrusion_v2.py\n"]
