[36.599227, "i", "cat << 'EOF' > trace_intrusion.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's search for Process GUIDs of our malicious processes\n# We will extract Process GUIDs from the message field or other fields if present.\n# In Sysmon Event 1, ProcessGuid is a field or inside message.\n# Let's search events with image containing our names.\n\nmalicious_images = ['grunthttp.exe', 'wuauclt.exe', 'notepad.exe', 'simpleinjection.dll']\n\n# We also want to find cmd.exe and conhost.exe spawned by GruntHTTP or wuauclt.\n# Let's do a broad query first to find all process GUIDs of Interest.\ncur.execute(\"SELECT event_id, event_code, image, parent_image, process_guid, parent_process_guid, message FROM events WHERE host = 'WS-05.corp.example'\")\n\nevents = [dict(r) for r in cur.fetchall()]\n\n# Let's find process GUIDs\nguids = set()\n\n# 1. GruntHTTP.exe itself\n# Wait, did GruntHTTP.exe start in this log? Let's check if there is an event for it.\nfor e in events:\n    img = (e['image'] or '').lower()\n    pimg = (e['parent_image'] or '').lower()\n    cl = (e['command_line'] or '').lower()\n    msg = (e['message'] or '').lower()\n    \n    if 'grunthttp' in img or 'grunthttp' in pimg or 'grunthttp' in cl or 'grunthttp' in msg:\n        if e['process_guid']:\n            guids.add(e['process_guid'])\n        if e['parent_process_guid']:\n            guids.add(e['parent_process_guid'])\n            \n        # Parse process guid from message if not in process_guid column\n        m = re.search(r'processguid:\\s*({[^}]+})', msg, re.IGNORECASE)\n        if m:\n            guids.add(m.group(1))\n        m = re.search(r'parentprocessguid:\\s*({[^}]+})', msg, re.IGNORECASE)\n        if m:\n            guids.add(m.group(1))\n\nprint(\"Initial malicious GUIDs:\", guids)\n\n# Now let's recursively find all child processes and their GUIDs\n# Also let's keep track of all malicious event IDs\nmalicious_event_ids = set()\n\n# Let's run a loop to expand our GUID set based on ParentProcessGuid\nexpanded = True\nwhile expanded:\n    expanded = False\n    for e in events:\n        pguid = e['parent_process_guid']\n        guid = e['process_guid']\n        msg = (e['message'] or '')\n        \n        # Parse from message as well\n        m_guid = None\n        m_pguid = None\n        m = re.search(r'ProcessGuid:\\s*({[^}]+})', msg)\n        if m: m_guid = m.group(1)\n        m = re.search(r'ParentProcessGuid:\\s*({[^}]+})', msg)\n        if m: m_pguid = m.group(1)\n        \n        if pguid in guids or m_pguid in guids:\n            if guid and guid not in guids:\n                guids.add(guid)\n                expanded = True\n            if m_guid and m_guid not in guids:\n                guids.add(m_guid)\n                expanded = True\n\nprint(\"All related process GUIDs:\", guids)\n\nEOF\npython3 trace_intrusion.py\n"]
