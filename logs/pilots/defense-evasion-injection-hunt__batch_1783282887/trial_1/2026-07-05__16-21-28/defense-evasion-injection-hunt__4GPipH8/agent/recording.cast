[147.889174, "o", "cur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' AND event_id >= 'evt-00528'\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.889259, "o", "> events = [dict(r) for r in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.889353, "o", "for e in events:\r\n\u001b[?2004l\r\u001b[?2004h>     img = (e['image'] or '').lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.889589, "o", "    if 'explorer.exe' in img or 'lsass.exe' in img or 'system' in img or 'csrss.exe' in img or 'networkwatcher' in img or 'ctfmon.exe' in img or 'services.exe' in img:\r\n\u001b[?2004l\r\u001b[?2004h>         # Check if message contains our malicious indicators\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.889663, "o", "        msg = (e['message'] or '').lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.889793, "o", "        det = (e['details'] or '').lower()\r\n\u001b[?2004l\r\u001b[?2004h>         is_rel = False\r\n\u001b[?2004l\r\u001b[?2004h>         for hp in mal_hex_pids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.889827, "o", "            if hp in msg or hp in det:\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.89002, "o", "> "]
[147.890152, "o", "                is_rel = True\r\n\u001b[?2004l\r\u001b[?2004h>         for g in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h>             if g in msg or g in det:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.890362, "o", "                is_rel = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if is_rel:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.890507, "o", "            print(f\"{e['event_id']} | EC: {e['event_code']} | Image: {e['image']} | Matches malicious indicators!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
