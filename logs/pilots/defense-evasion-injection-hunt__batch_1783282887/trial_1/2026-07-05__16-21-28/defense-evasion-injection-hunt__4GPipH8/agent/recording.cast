[190.279891, "i", "cat << 'EOF' > find_missed_events.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Load candidate IDs\nwith open('/tmp/candidates.json') as f:\n    candidates = json.load(f)\n\ncand_ids = set(candidates.keys())\n\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' AND event_id >= 'evt-00528' ORDER BY event_id\")\nall_events = [dict(r) for r in cur.fetchall()]\n\nmissed_by_code = {}\nfor e in all_events:\n    eid = e['event_id']\n    if eid not in cand_ids:\n        ec = e['event_code']\n        missed_by_code[ec] = missed_by_code.get(ec, []) + [e]\n\nfor ec, evs in sorted(missed_by_code.items()):\n    print(f\"Event Code {ec}: {len(evs)} missed events\")\n    # print a few examples\n    for e in evs[:3]:\n        print(f\"  {e['event_id']} | {e['timestamp']} | {e['image']} | {e['parent_image']} | {e['command_line']} | {e['message'][:80].replace('\\n', ' ')}\")\n\nEOF\npython3 find_missed_events.py\n"]
