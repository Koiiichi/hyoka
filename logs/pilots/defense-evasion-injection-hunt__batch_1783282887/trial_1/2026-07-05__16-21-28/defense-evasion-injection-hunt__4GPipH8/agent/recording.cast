[115.551863, "i", "cat << 'EOF' > inspect_detailed_events.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events\")\nall_events = [dict(r) for r in cur.fetchall()]\n\n# Malicious Process PIDs\nmal_pids = {3356, 3148, 4288, 6208, 2368}\nmal_hex_pids = {'0xd1c', '0xc4c', '0x10c0', '0x1840', '0x940'}\n\n# Let's inspect Registry events (12, 13)\nprint(\"\\n--- Registry Events ---\")\nfor e in all_events:\n    if e['event_code'] in (12, 13) and e['host'] == 'WS-05.corp.example':\n        # Let's see which ones are related to our malicious processes or PIDs\n        msg = (e['message'] or '').lower()\n        # Is it related?\n        is_rel = False\n        for hp in mal_hex_pids:\n            if hp in msg:\n                is_rel = True\n        guid = (e['process_guid'] or '').lower()\n        if guid in {'{71b87c12-d7e5-5f84-0d01-000000000500}', '{71b87c12-d9fe-5f84-1701-000000000500}', '{71b87c12-d9fe-5f84-1801-000000000500}', '{71b87c12-d9fe-5f84-1901-000000000500}', '{71b87c12-d9fe-5f84-1a01-000000000500}'}:\n            is_rel = True\n            \n        if is_rel:\n            print(f\"{e['event_id']} | EC: {e['event_code']} | Image: {e['image']} | Target: {e['target_object']} | Details: {e['details']}\")\n\n# Let's inspect Handle/Resource Access events (4656, 4663, 4658, 4690)\nprint(\"\\n--- Handle/Resource Access Events ---\")\nfor e in all_events:\n    if e['event_code'] in (4656, 4663, 4658, 4690) and e['host'] == 'WS-05.corp.example':\n        msg = (e['message'] or '').lower()\n        is_rel = False\n        matched_pid = None\n        for hp in mal_hex_pids:\n            if hp in msg:\n                is_rel = True\n                matched_pid = hp\n                \n        if is_rel:\n            # Print brief details\n            print(f\"{e['event_id']} | EC: {e['event_code']} | ProcessId: {matched_pid} | Message snippet: {e['message'][:120].replace('\\n', ' ')}\")\n\nEOF\npython3 inspect_detailed_events.py\n"]
