[57.35871, "i", "cat << 'EOF' > trace_intrusion_v2.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's select all events\ncur.execute(\"SELECT * FROM events\")\nall_events = [dict(r) for r in cur.fetchall()]\n\n# Malicious Process GUIDs we already discovered\nmal_guids = {\n  '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP\n  '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd\n  '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost\n  '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt\n  '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad\n}\n\n# Let's extract Sysmon process metadata: ProcessId, and other mappings\n# Maps Sysmon ProcessGuid -> decimal PID, hex PID, Image, ParentGuid\nguid_meta = {}\nfor e in all_events:\n    guid = (e['process_guid'] or '').lower()\n    if guid in mal_guids:\n        # Let's parse pid from message if not explicit\n        msg = e['message'] or ''\n        pid = None\n        m = re.search(r'ProcessId:\\s*(\\d+)', msg, re.IGNORECASE)\n        if m: pid = int(m.group(1))\n        \n        if guid not in guid_meta:\n            guid_meta[guid] = {'pid': pid, 'hex_pid': f\"0x{pid:x}\" if pid else None, 'image': e['image']}\n\nprint(\"GUID Meta:\", json.dumps(guid_meta, indent=2))\n\nEOF\npython3 trace_intrusion_v2.py\n"]
[57.359742, "o", "cat << 'EOF' > trace_intrusion_v2.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's select all events\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.360669, "o", "cur.execute(\"SELECT * FROM events\")\r\n\u001b[?2004l\r\u001b[?2004h> all_events = [dict(r) for r in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Malicious Process GUIDs we already discovered\r\n\u001b[?2004l\r\u001b[?2004h> mal_guids = {\r\n\u001b[?2004l\r\u001b[?2004h>   '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP\r\n\u001b[?2004l\r\u001b[?2004h>   '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd\r\n\u001b[?2004l\r\u001b[?2004h>   '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost\r\n\u001b[?2004l\r\u001b[?2004h>   '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt\r\n\u001b[?2004l\r\u001b[?2004h>   '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's extract Sysmon process metadata: ProcessId, and other mappings\r\n\u001b[?2004l\r\u001b[?2004h> # Maps Sysmon ProcessGuid -> decimal PID, hex PID, Image, ParentGuid\r\n\u001b[?2004l\r\u001b[?2004h> guid_meta = {}\r\n\u001b[?2004l\r\u001b[?2004h> for e in all_events:\r\n\u001b[?2004l\r\u001b[?2004h>     guid = (e['process_guid'] or '').lower()\r\n\u001b[?2004l\r\u001b[?2004h>     if guid in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h>         # Let's parse pid from message if not explicit\r\n\u001b[?2004l\r\u001b[?2004h>         msg = e['message'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>         pid = None\r\n\u001b[?2004l\r\u001b[?2004h>         m = re.search(r'ProcessId:\\s*(\\d+)', msg, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h>         if m: pid = int(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.360826, "o", "        if guid not in guid_meta:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.360964, "o", "            guid_meta[guid] = {'pid': pid, 'hex_pid': f\"0x{pid:x}\" if pid else None, 'image': e['image']}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"GUID Meta:\", json.dumps(guid_meta, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
