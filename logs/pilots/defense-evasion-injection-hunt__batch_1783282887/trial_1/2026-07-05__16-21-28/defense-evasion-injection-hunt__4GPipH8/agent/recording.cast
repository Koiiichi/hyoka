[42.493345, "i", "cat << 'EOF' > trace_intrusion.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's select all columns to be safe\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example'\")\n\nevents = [dict(r) for r in cur.fetchall()]\n\n# Let's find process GUIDs\nguids = set()\n\n# 1. GruntHTTP.exe itself\nfor e in events:\n    img = (e['image'] or '').lower()\n    pimg = (e['parent_image'] or '').lower()\n    cl = (e['command_line'] or '').lower()\n    msg = (e['message'] or '').lower()\n    \n    if 'grunthttp' in img or 'grunthttp' in pimg or 'grunthttp' in cl or 'grunthttp' in msg:\n        if e['process_guid']:\n            guids.add(e['process_guid'])\n        if e['parent_process_guid']:\n            guids.add(e['parent_process_guid'])\n            \n        # Parse process guid from message if not in process_guid column\n        m = re.search(r'processguid:\\s*({[^}]+})', msg, re.IGNORECASE)\n        if m:\n            guids.add(m.group(1).lower())\n        m = re.search(r'parentprocessguid:\\s*({[^}]+})', msg, re.IGNORECASE)\n        if m:\n            guids.add(m.group(1).lower())\n\n# Standardize to lowercase\nguids = {g.lower() for g in guids if g}\nprint(\"Initial malicious GUIDs:\", guids)\n\n# Let's run a loop to expand our GUID set based on ParentProcessGuid\nexpanded = True\nwhile expanded:\n    expanded = False\n    for e in events: \n        pguid = (e['parent_process_guid'] or '').lower()\n        guid = (e['process_guid'] or '').lower()\n        msg = (e['message'] or '')\n        \n        # Parse from message as well\n        m_guid = None\n        m_pguid = None\n        m = re.search(r'ProcessGuid:\\s*({[^}]+})', msg, re.IGNORECASE)\n        if m: m_guid = m.group(1).lower()\n        m = re.search(r'ParentProcessGuid:\\s*({[^}]+})', msg, re.IGNORECASE)\n        if m: m_pguid = m.group(1).lower()\n        \n        if pguid in guids or m_pguid in guids:\n            if guid and guid not in guids:\n                guids.add(guid)\n                expanded = True\n            if m_guid and m_guid not in guids:\n                guids.add(m_guid)\n                expanded = True\n\nprint(\"All related process GUIDs:\", guids)\n\nEOF\npython3 trace_intrusion.py\n"]
