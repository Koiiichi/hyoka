[164.732895, "o", "        category = \"Resource/Handle Access Security\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # 12. CreateRemoteThread (8) from malicious process\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.732998, "o", "    elif ec == 8 and guid in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.733058, "o", ">         is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.733118, "o", "        category = \"CreateRemoteThread (8)\"\r\n\u001b[?2004l\r"]
[164.733148, "o", "\u001b[?2004h> "]
[164.73319, "o", "        \r\n\u001b[?2004l\r"]
[164.733266, "o", "\u001b[?2004h> "]
[164.73328, "o", "    if is_mal:\r\n\u001b[?2004l\r"]
[164.733338, "o", "\u001b[?2004h> "]
[164.733378, "o", "        candidates[eid] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.733435, "o", "            'event_code': ec,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.733498, "o", "            'host': host,\r\n\u001b[?2004l\r\u001b[?2004h>             'image': e['image'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.733512, "o", "            'category': category,\r\n"]
[164.733519, "o", "\u001b[?2004l\r\u001b[?2004h"]
[164.73366, "o", ">             'timestamp': e['timestamp'],\r\n\u001b[?2004l\r\u001b[?2004h>             'command_line': e['command_line'],\r\n\u001b[?2004l\r\u001b[?2004h>             'target_image': e['target_image']\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.733773, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's print candidate counts by category\r\n\u001b[?2004l\r\u001b[?2004h> cat_counts = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.733865, "o", "for k, v in candidates.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.73391, "o", "    cat_counts[v['category']] = cat_counts.get(v['category'], 0) + 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[164.733995, "o", "\u001b[?2004h> "]
[164.734009, "o", "print(\"Candidate Categories:\", json.dumps(cat_counts, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.734084, "o", "print(f\"Total candidates: {len(candidates)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save the candidates to inspect\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.734099, "o", "> "]
[164.734177, "o", "with open('/tmp/candidates.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.73427, "o", "    json.dump(candidates, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
