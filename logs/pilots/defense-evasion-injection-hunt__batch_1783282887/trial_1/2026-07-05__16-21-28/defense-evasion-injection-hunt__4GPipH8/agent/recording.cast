[147.886368, "i", "cat << 'EOF' > inspect_system_procs.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Malicious hex PIDs\nmal_hex_pids = {'0xd1c', '0xc4c', '0x10c0', '0x1840', '0x940'}\nmal_guids = {\n  '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP\n  '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd\n  '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost\n  '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt\n  '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad\n}\n\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' AND event_id >= 'evt-00528'\")\nevents = [dict(r) for r in cur.fetchall()]\n\nfor e in events:\n    img = (e['image'] or '').lower()\n    if 'explorer.exe' in img or 'lsass.exe' in img or 'system' in img or 'csrss.exe' in img or 'networkwatcher' in img or 'ctfmon.exe' in img or 'services.exe' in img:\n        # Check if message contains our malicious indicators\n        msg = (e['message'] or '').lower()\n        det = (e['details'] or '').lower()\n        is_rel = False\n        for hp in mal_hex_pids:\n            if hp in msg or hp in det:\n                is_rel = True\n        for g in mal_guids:\n            if g in msg or g in det:\n                is_rel = True\n        \n        if is_rel:\n            print(f\"{e['event_id']} | EC: {e['event_code']} | Image: {e['image']} | Matches malicious indicators!\")\n\nEOF\npython3 inspect_system_procs.py\n"]
