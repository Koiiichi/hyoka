[48.643319, "o", "> "]
[48.643524, "o", "# Sysmon (1) and Security (4688) always occur in pairs for the same process start.\r\n\u001b[?2004l\r\u001b[?2004h> # Let's look at the correlation between them.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
