[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         category = "Process Terminate Security (4689)"
[?2004l[?2004h>         
[?2004l[?2004h>     # 7. Sysmon Process Access (10) where source is malicious
[?2004l[?2004h>     elif ec == 10 and guid in mal_guids:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         category = "Process Access (10) Source"
[?2004l[?2004h>         
[?2004l[?2004h>     # 8. Sysmon Registry events (12, 13) where process is malicious
[?2004l[?2004h>     elif ec in (12, 13) and guid in mal_guids:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         category = "Registry Event"
[?2004l[?2004h>         
[?2004l[?2004h>     # 9. Sysmon Network connections (3) or DNS (22) from malicious process
[?2004l[?2004h>     elif ec in (3, 22) and guid in mal_guids:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         category = "Network/DNS"
[?2004l[?2004h>         
[?2004l[?2004h>     # 10. Pipe events (17, 18) from malicious process
[?2004l[?2004h>     elif ec in (17, 18) and guid in mal_guids:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         category = "Named Pipe"
[?2004l[?2004h>         
[?2004l[?2004h>     # 11. Security resource access / handle auditing (4656, 4663, 4658, 4690)
[?2004l[?2004h>     elif ec in (4656, 4663, 4658, 4690) and any(hp in msg for hp in mal_hex_pids):
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         category = "Resource/Handle Access Security"
[?2004l[?2004h>         
[?2004l[?2004h>     # 12. CreateRemoteThread (8) from malicious process
[?2004l[?2004h>     elif ec == 8 and guid in mal_guids:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         category = "CreateRemoteThread (8)"
[?2004l[?2004h>         
[?2004l[?2004h>     if is_mal:
[?2004l[?2004h>         candidates[eid] = {
[?2004l[?2004h>             'event_code': ec,
[?2004l[?2004h>             'host': host,
[?2004l[?2004h>             'image': e['image'],
[?2004l[?2004h>             'category': category,
[?2004l[?2004h>             'timestamp': e['timestamp'],
[?2004l[?2004h>             'command_line': e['command_line'],
[?2004l[?2004h>             'target_image': e['target_image']
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h> # Let's print candidate counts by category
[?2004l[?2004h> cat_counts = {}
[?2004l[?2004h> for k, v in candidates.items():
[?2004l[?2004h>     cat_counts[v['category']] = cat_counts.get(v['category'], 0) + 1
[?2004l[?2004h> 
[?2004l[?2004h> print("Candidate Categories:", json.dumps(cat_counts, indent=2))
[?2004l[?2004h> print(f"Total candidates: {len(candidates)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save the candidates to inspect
[?2004l[?2004h> with open('/tmp/candidates.json', 'w') as f:
[?2004l[?2004h>     json.dump(candidates, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
