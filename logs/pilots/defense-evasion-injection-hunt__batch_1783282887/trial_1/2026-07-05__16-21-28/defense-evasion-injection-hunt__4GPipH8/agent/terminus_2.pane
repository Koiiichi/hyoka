[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's read all 303 potential event IDs
[?2004l[?2004h> # First, run trace_intrusion_v2 to get mal_event_ids
[?2004l[?2004h> EOF
[?2004l[?2004hroot@179b3aeada33:~# cat trace_intrusion_v2.py categorize_events.py > run_analysis.py
[?2004l[?2004hroot@179b3aeada33:~# # Let's replace the last print in run_analysis.py with customized analysis code
[?2004l[?2004hroot@179b3aeada33:~# cat << 'EOF' > run_analysis.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT * FROM events")
[?2004l[?2004h> all_events = [dict(r) for r in cur.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious GUIDs
[?2004l[?2004h> mal_guids = {
[?2004l[?2004h>   '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP
[?2004l[?2004h>   '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd
[?2004l[?2004h>   '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost
[?2004l[?2004h>   '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt
[?2004l[?2004h>   '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # PIDs
[?2004l[?2004h> # GruntHTTP: 3356 (0xd1c)
[?2004l[?2004h> # cmd.exe: 3148 (0xc4c)
[?2004l[?2004h> # conhost.exe: 4288 (0x10c0)
[?2004l[?2004h> # wuauclt.exe: 6208 (0x1840)
[?2004l[?2004h> # notepad.exe: 2368 (0x940)
[?2004l[?2004h> 
[?2004l[?2004h> mal_pids = {3356, 3148, 4288, 6208, 2368}
[?2004l[?2004h> mal_hex_pids = {'0xd1c', '0xc4c', '0x10c0', '0x1840', '0x940'}
[?2004l[?2004h> 
[?2004l[?2004h> # Let's categorize every event
[?2004l[?2004h> # We want to identify events that are directly related to the malicious processes
[?2004l[?2004h> # Let's filter out known benign noise. What is benign noise?
[?2004l[?2004h> # E.g. csrss.exe (PID 380) or svchost.exe (various PIDs) accessing our processes is typical Windows OS behavior when a process is created.
[?2004l[?2004h> # But wait, let's look at all of them first!
[?2004l[?2004h> 
[?2004l[?2004h> categorized = {}
[?2004l[?2004h> for e in all_events:
[?2004l[?2004h>     eid = e['event_id']
[?2004l[?2004h>     ec = e['event_code']
[?2004l[?2004h>     img = (e['image'] or '').lower()
[?2004l[?2004h>     pimg = (e['parent_image'] or '').lower()
[?2004l[?2004h>     cl = (e['command_line'] or '').lower()
[?2004l[?2004h>     guid = (e['process_guid'] or '').lower()
[?2004l[?2004h>     pguid = (e['parent_process_guid'] or '').lower()
[?2004l[?2004h>     msg = (e['message'] or '').lower()
[?2004l[?2004h>     det = (e['details'] or '').lower()
[?2004l[?2004h>     host = e['host']
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if this event relates to our malicious processes
[?2004l[?2004h>     is_rel = False
[?2004l[?2004h>     reason = []
[?2004l[?2004h>     
[?2004l[?2004h>     if guid in mal_guids:
[?2004l[?2004h>         is_rel = True
[?2004l[?2004h>         reason.append("guid")
[?2004l[?2004h>     if pguid in mal_guids:
[?2004l[?2004h>         is_rel = True
[?2004l[?2004h>         reason.append("pguid")
[?2004l[?2004h>         
[?2004l[?2004h>     # check hex pids in message
[?2004l[?2004h>     for hp in mal_hex_pids:
[?2004l[?2004h>         if hp in msg or hp in det:
[?2004l[?2004h>             is_rel = True
[?2004l[?2004h>             reason.append(f"hex_pid_{hp}")
[?2004l[?2004h>             
[?2004l[?2004h>     if is_rel:
[?2004l[?2004h>         categorized[eid] = {
[?2004l[?2004h>             'event_code': ec,
[?2004l[?2004h>             'host': host,
[?2004l[?2004h>             'image': e['image'],
[?2004l[?2004h>             'parent_image': e['parent_image'],
[?2004l[?2004h>             'command_line': e['command_line'],
[?2004l[?2004h>             'reason': reason,
[?2004l[?2004h>             'user': e['user'],
[?2004l[?2004h>             'target_image': e['target_image'],
[?2004l[?2004h>             'target_object': e['target_object'],
[?2004l[?2004h>             'details': e['details']
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h> # Print summary by Event Code
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> counts = Counter([v['event_code'] for v in categorized.values()])
[?2004l[?2004h> print("Event Code Counts:", counts)
[?2004l[?2004h> 
[?2004l[?2004h> # Let's print out the process access (event code 10) events to see which ones are svchost/csrss vs GruntHTTP
[?2004l[?2004h> print("\n--- Event Code 10 (ProcessAccess) Details ---")
[?2004l[?2004h> for eid, v in sorted(categorized.items()):
[?2004l[?2004h>     if v['event_code'] == 10:
[?2004l[?2004h>         # check source/target
[?2004l[?2004h>         print(f"{eid} | Source: {v['image']} | Target: {v['target_image']} | Details: {v['details']} | Reasons: {v['reason']}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@179b3aeada33:~# python3 run_analysis.py
