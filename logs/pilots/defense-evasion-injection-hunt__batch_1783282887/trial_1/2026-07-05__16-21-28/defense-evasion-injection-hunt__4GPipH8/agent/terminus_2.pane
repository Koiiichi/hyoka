[?2004hroot@179b3aeada33:~# cat << 'EOF' > trace_intrusion.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search for Process GUIDs of our malicious processes
[?2004l[?2004h> # We will extract Process GUIDs from the message field or other fields if present.
[?2004l[?2004h> # In Sysmon Event 1, ProcessGuid is a field or inside message.
[?2004l[?2004h> # Let's search events with image containing our names.
[?2004l[?2004h> 
[?2004l[?2004h> malicious_images = ['grunthttp.exe', 'wuauclt.exe', 'notepad.exe', 'simpleinjection.dll']
[?2004l[?2004h> 
[?2004l[?2004h> # We also want to find cmd.exe and conhost.exe spawned by GruntHTTP or wuauclt.
[?2004l[?2004h> # Let's do a broad query first to find all process GUIDs of Interest.
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, image, parent_image, process_guid, parent_process_guid, message FROM events WHERE host = 'WS-05.corp.example'")
[?2004l[?2004h> 
[?2004l[?2004h> events = [dict(r) for r in cur.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find process GUIDs
[?2004l[?2004h> guids = set()
[?2004l[?2004h> 
[?2004l[?2004h> # 1. GruntHTTP.exe itself
[?2004l[?2004h> # Wait, did GruntHTTP.exe start in this log? Let's check if there is an event for it.
[?2004l[?2004h> for e in events:
[?2004l[?2004h>     img = (e['image'] or '').lower()
[?2004l[?2004h>     pimg = (e['parent_image'] or '').lower()
[?2004l[?2004h>     cl = (e['command_line'] or '').lower()
[?2004l[?2004h>     msg = (e['message'] or '').lower()
[?2004l[?2004h>     
[?2004l[?2004h>     if 'grunthttp' in img or 'grunthttp' in pimg or 'grunthttp' in cl or 'grunthttp' in msg:
[?2004l[?2004h>         if e['process_guid']:
[?2004l[?2004h>             guids.add(e['process_guid'])
[?2004l[?2004h>         if e['parent_process_guid']:
[?2004l[?2004h>             guids.add(e['parent_process_guid'])
[?2004l[?2004h>             
[?2004l[?2004h>         # Parse process guid from message if not in process_guid column
[?2004l[?2004h>         m = re.search(r'processguid:\s*({[^}]+})', msg, re.IGNORECASE)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             guids.add(m.group(1))
[?2004l[?2004h>         m = re.search(r'parentprocessguid:\s*({[^}]+})', msg, re.IGNORECASE)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             guids.add(m.group(1))
[?2004l[?2004h> 
[?2004l[?2004h> print("Initial malicious GUIDs:", guids)
[?2004l[?2004h> 
[?2004l[?2004h> # Now let's recursively find all child processes and their GUIDs
[?2004l[?2004h> # Also let's keep track of all malicious event IDs
[?2004l[?2004h> malicious_event_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's run a loop to expand our GUID set based on ParentProcessGuid
[?2004l[?2004h> expanded = True
[?2004l[?2004h> while expanded:
[?2004l[?2004h>     expanded = False
[?2004l[?2004h>     for e in events:
[?2004l[?2004h>         pguid = e['parent_process_guid']
[?2004l[?2004h>         guid = e['process_guid']
[?2004l[?2004h>         msg = (e['message'] or '')
[?2004l[?2004h>         
[?2004l[?2004h>         # Parse from message as well
[?2004l[?2004h>         m_guid = None
[?2004l[?2004h>         m_pguid = None
[?2004l[?2004h>         m = re.search(r'ProcessGuid:\s*({[^}]+})', msg)
[?2004l[?2004h>         if m: m_guid = m.group(1)
[?2004l[?2004h>         m = re.search(r'ParentProcessGuid:\s*({[^}]+})', msg)
[?2004l[?2004h>         if m: m_pguid = m.group(1)
[?2004l[?2004h>         
[?2004l[?2004h>         if pguid in guids or m_pguid in guids:
[?2004l[?2004h>             if guid and guid not in guids:
[?2004l[?2004h>                 guids.add(guid)
[?2004l[?2004h>                 expanded = True
[?2004l[?2004h>             if m_guid and m_guid not in guids:
[?2004l[?2004h>                 guids.add(m_guid)
[?2004l[?2004h>                 expanded = True
[?2004l[?2004h> 
[?2004l[?2004h> print("All related process GUIDs:", guids)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
