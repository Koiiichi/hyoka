  "Process Exec (EC 17)": 2,
  "Resource/Handle Access Security": 76,
  "Process Exec (EC 18)": 2,
  "Process Exec (EC 13)": 3,
  "Process Exec (EC 1)": 4,
  "Process Exec (EC 10)": 4,
  "Process Exec (EC 7)": 141,
  "Process Exec (EC 8)": 1,
  "Process Exec (EC 5)": 3,
  "Process Exec (EC 12)": 17,
  "Process Terminate Security (4689)": 3,
  "Process Exec (EC 3)": 1,
  "Process Exec (EC 22)": 1
}
