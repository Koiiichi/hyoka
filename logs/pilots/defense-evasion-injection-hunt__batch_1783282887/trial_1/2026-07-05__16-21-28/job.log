Sending keys: ['cat << \'EOF\' > trace_intrusion_v2.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let\'s select all events\ncur.execute("SELECT * FROM events")\nall_events = [dict(r) for r in cur.fetchall()]\n\n# Malicious Process GUIDs we already discovered\nmal_guids = {\n  \'{71b87c12-d7e5-5f84-0d01-000000000500}\', # GruntHTTP\n  \'{71b87c12-d9fe-5f84-1701-000000000500}\', # cmd\n  \'{71b87c12-d9fe-5f84-1801-000000000500}\', # conhost\n  \'{71b87c12-d9fe-5f84-1901-000000000500}\', # wuauclt\n  \'{71b87c12-d9fe-5f84-1a01-000000000500}\'  # notepad\n}\n\n# Let\'s extract Sysmon process metadata: ProcessId, and other mappings\n# Maps Sysmon ProcessGuid -> decimal PID, hex PID, Image, ParentGuid\nguid_meta = {}\nfor e in all_events:\n    guid = (e[\'process_guid\'] or \'\').lower()\n    if guid in mal_guids:\n        # Let\'s parse pid from message if not explicit\n        msg = e[\'message\'] or \'\'\n        pid = None\n        m = re.search(r\'ProcessId:\\s*(\\d+)\', msg, re.IGNORECASE)\n        if m: pid = int(m.group(1))\n        \n        if guid not in guid_meta:\n            guid_meta[guid] = {\'pid\': pid, \'hex_pid\': f"0x{pid:x}" if pid else None, \'image\': e[\'image\']}\n\nprint("GUID Meta:", json.dumps(guid_meta, indent=2))\n\nEOF\npython3 trace_intrusion_v2.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
