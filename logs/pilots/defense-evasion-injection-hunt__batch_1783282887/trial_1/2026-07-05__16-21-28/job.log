atching PID).\n    # Let\'s see if PID/HexPID matches specifically in a Process ID context.\n    # In Security logs (like 4688, 4673, 4656, 4663, 4658), the process ID is represented in hex, e.g. "Process ID: 0xc4c" or "ProcessId: 0xc4c" or "New Process ID: 0xc4c".\n    # Or "Creator Process ID: 0xd1c".\n    # Let\'s search for hex PID with boundary or labels.\n    for hpid in mal_hex_pids:\n        if hpid in msg or hpid in det:\n            # Let\'s ensure it\'s not a false positive\n            # We can print these to verify\n            is_mal = True\n            reason.append(f"contains_hex_pid_{hpid}")\n            \n    # 4. Explicit malicious process name/file matches on WS-05\n    if host == \'WS-05.corp.example\':\n        if any(name in cl or name in img or name in pimg or name in t_img or name in t_obj for name in mal_names):\n            # But cmd.exe/conhost.exe/wuauclt.exe/notepad.exe might have benign uses?\n            # On WS-05, during this 1-minute window, is there any benign use of these?\n            # Let\'s check if there are other processes of cmd.exe or notepad.exe\n            # Let\'s include them if they are associated with our malicious parent or activity.\n            if \'grunthttp\' in cl or \'grunthttp\' in img or \'grunthttp\' in pimg or \'simpleinjection\' in cl or \'simpleinjection\' in det or \'simpleinjection\' in msg:\n                is_mal = True\n                reason.append("explicit_mal_name")\n\n    if is_mal:\n        mal_event_ids.add(eid)\n        reasons[eid] = reason\n\nprint(f"Found {len(mal_event_ids)} potentially malicious events.")\n# Let\'s write them to a file with details for manual verification\nwith open(\'/tmp/pot_mal.txt\', \'w\') as f:\n    for eid in sorted(mal_event_ids):\n        # find event\n        e = next(ev for ev in all_events if ev[\'event_id\'] == eid)\n        f.write(f"{eid} | {e[\'timestamp\']} | {e[\'event_code\']} | {e[\'host\']} | {e[\'user\']} | {e[\'image\']} | {e[\'parent_image\']} 