Sending keys: ['cat << \'EOF\' > run_analysis.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute("SELECT * FROM events")\nall_events = [dict(r) for r in cur.fetchall()]\n\n# Malicious GUIDs\nmal_guids = {\n  \'{71b87c12-d7e5-5f84-0d01-000000000500}\', # GruntHTTP\n  \'{71b87c12-d9fe-5f84-1701-000000000500}\', # cmd\n  \'{71b87c12-d9fe-5f84-1801-000000000500}\', # conhost\n  \'{71b87c12-d9fe-5f84-1901-000000000500}\', # wuauclt\n  \'{71b87c12-d9fe-5f84-1a01-000000000500}\'  # notepad\n}\n\n# PIDs\n# GruntHTTP: 3356 (0xd1c)\n# cmd.exe: 3148 (0xc4c)\n# conhost.exe: 4288 (0x10c0)\n# wuauclt.exe: 6208 (0x1840)\n# notepad.exe: 2368 (0x940)\n\nmal_pids = {3356, 3148, 4288, 6208, 2368}\nmal_hex_pids = {\'0xd1c\', \'0xc4c\', \'0x10c0\', \'0x1840\', \'0x940\'}\n\n# Let\'s categorize every event\n# We want to identify events that are directly related to the malicious processes\n# Let\'s filter out known benign noise. What is benign noise?\n# E.g. csrss.exe (PID 380) or svchost.exe (various PIDs) accessing our processes is typical Windows OS behavior when a process is created.\n# But wait, let\'s look at all of them first!\n\ncategorized = {}\nfor e in all_events:\n    eid = e[\'event_id\']\n    ec = e[\'event_code\']\n    img = (e[\'image\'] or \'\').lower()\n    pimg = (e[\'parent_image\'] or \'\').lower()\n    cl = (e[\'command_line\'] or \'\').lower()\n    guid = (e[\'process_guid\'] or \'\').lower()\n    pguid = (e[\'parent_process_guid\'] or \'\').lower()\n    msg = (e[\'message\'] or \'\').lower()\n    det = (e[\'details\'] or \'\').lower()\n    host = e[\'host\']\n    \n    # Check if this event relates to our malicious processes\n    is_rel = False\n    reason = []\n    \n    if guid in mal_guids:\n        is_rel = True\n        reason.append("guid")\n    if pguid in mal_guids:\n        is_rel = True\n        reason.append("pguid")\n        \n    # check hex pids in message\n    for hp in mal_hex_pids:\n        if hp in msg or hp in det:\n            is_rel = True\n            reason.append(f"hex_pid_{hp}")\n            \n    if is_rel:\n        categorized[eid] = {\n            \'event_code\': ec,\n            \'host\': host,\n            \'image\': e[\'image\'],\n            \'parent_image\': e[\'parent_image\'],\n            \'command_line\': e[\'command_line\'],\n            \'reason\': reason,\n            \'user\': e[\'user\'],\n            \'target_image\': e[\'target_image\'],\n            \'target_object\': e[\'target_object\'],\n            \'details\': e[\'details\']\n        }\n\n# Print summary by Event Code\nfrom collections import Counter\ncounts = Counter([v[\'event_code\'] for v in categorized.values()])\nprint("Event Code Counts:", counts)\n\n# Let\'s print out the process access (event code 10) events to see which ones are svchost/csrss vs GruntHTTP\nprint("\\n--- Event Code 10 (ProcessAccess) Details ---")\nfor eid, v in sorted(categorized.items()):\n    if v[\'event_code\'] == 10:\n        # check source/target\n        print(f"{eid} | Source: {v[\'image\']} | Target: {v[\'target_image\']} | Details: {v[\'details\']} | Reasons: {v[\'reason\']}")\n\nEOF\npython3 run_analysis.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
