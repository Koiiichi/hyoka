Sending keys: ['cat << \'EOF\' > get_candidate_events.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute("SELECT * FROM events")\nall_events = [dict(r) for r in cur.fetchall()]\n\n# Malicious Process GUIDs\nmal_guids = {\n  \'{71b87c12-d7e5-5f84-0d01-000000000500}\', # GruntHTTP\n  \'{71b87c12-d9fe-5f84-1701-000000000500}\', # cmd\n  \'{71b87c12-d9fe-5f84-1801-000000000500}\', # conhost\n  \'{71b87c12-d9fe-5f84-1901-000000000500}\', # wuauclt\n  \'{71b87c12-d9fe-5f84-1a01-000000000500}\'  # notepad\n}\n\nmal_hex_pids = {\'0xd1c\', \'0xc4c\', \'0x10c0\', \'0x1840\', \'0x940\'}\n\ncandidates = {}\nfor e in all_events:\n    eid = e[\'event_id\']\n    ec = e[\'event_code\']\n    host = e[\'host\']\n    img = (e[\'image\'] or \'\').lower()\n    pimg = (e[\'parent_image\'] or \'\').lower()\n    cl = (e[\'command_line\'] or \'\').lower()\n    guid = (e[\'process_guid\'] or \'\').lower()\n    pguid = (e[\'parent_process_guid\'] or \'\').lower()\n    msg = (e[\'message\'] or \'\').lower()\n    det = (e[\'details\'] or \'\').lower()\n    t_img = (e[\'target_image\'] or \'\').lower()\n    \n    is_mal = False\n    category = ""\n    \n    # 1. File dropping of DLL\n    if eid == \'evt-00088\':\n        is_mal = True\n        category = "File Drop"\n        \n    # 2. Process creation / execution by our malicious GUIDs\n    elif guid in mal_guids:\n        is_mal = True\n        category = f"Process Exec (EC {ec})"\n        \n    # 3. Process creation with our malicious parent\n    elif pguid in mal_guids:\n        is_mal = True\n        category = f"Process Exec (EC {ec})"\n        \n    # 4. Security process creation (4688) matching our processes\n    elif ec == 4688 and any(hp in msg for hp in mal_hex_pids):\n        is_mal = True\n        category = "Process Create Security (4688)"\n        \n    # 5. Security privilege use (4673) matching our processes\n    elif ec == 4673 and any(hp in msg for hp in mal_hex_pids):\n        is_mal = True\n        category = "Privilege Use Security (4673)"\n        \n    # 6. Process termination (4689) matching our processes\n    elif ec == 4689 and any(hp in msg for hp in mal_hex_pids):\n        is_mal = True\n        category = "Process Terminate Security (4689)"\n        \n    # 7. Sysmon Process Access (10) where source is malicious\n    elif ec == 10 and guid in mal_guids:\n        is_mal = True\n        category = "Process Access (10) Source"\n        \n    # 8. Sysmon Registry events (12, 13) where process is malicious\n    elif ec in (12, 13) and guid in mal_guids:\n        is_mal = True\n        category = "Registry Event"\n        \n    # 9. Sysmon Network connections (3) or DNS (22) from malicious process\n    elif ec in (3, 22) and guid in mal_guids:\n        is_mal = True\n        category = "Network/DNS"\n        \n    # 10. Pipe events (17, 18) from malicious process\n    elif ec in (17, 18) and guid in mal_guids:\n        is_mal = True\n        category = "Named Pipe"\n        \n    # 11. Security resource access / handle auditing (4656, 4663, 4658, 4690)\n    elif ec in (4656, 4663, 4658, 4690) and any(hp in msg for hp in mal_hex_pids):\n        is_mal = True\n        category = "Resource/Handle Access Security"\n        \n    # 12. CreateRemoteThread (8) from malicious process\n    elif ec == 8 and guid in mal_guids:\n        is_mal = True\n        category = "CreateRemoteThread (8)"\n        \n    if is_mal:\n        candidates[eid] = {\n            \'event_code\': ec,\n            \'host\': host,\n            \'image\': e[\'image\'],\n            \'category\': category,\n            \'timestamp\': e[\'timestamp\'],\n            \'command_line\': e[\'command_line\'],\n            \'target_image\': e[\'target_image\']\n        }\n\n# Let\'s print candidate counts by category\ncat_counts = {}\nfor k, v in candidates.items():\n    cat_counts[v[\'category\']] = cat_counts.g