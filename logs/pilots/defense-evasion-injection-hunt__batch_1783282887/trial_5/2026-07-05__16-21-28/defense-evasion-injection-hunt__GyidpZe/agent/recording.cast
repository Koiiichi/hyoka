[164.297159, "i", "cat << 'EOF' > inspect_special_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nfor eid in ['evt-00538', 'evt-00552', 'evt-00583', 'evt-00584', 'evt-00701', 'evt-00723']:\n    ev = cursor.execute(\"SELECT * FROM events WHERE event_id = ?\", (eid,)).fetchone()\n    if ev:\n        print(f\"=== {ev['event_id']} (Code {ev['event_code']}, {ev['timestamp']}) ===\")\n        for k, v in dict(ev).items():\n            if v is not None and v != '':\n                print(f\"  {k}: {v}\")\n\nEOF\npython3 inspect_special_events.py\n"]
