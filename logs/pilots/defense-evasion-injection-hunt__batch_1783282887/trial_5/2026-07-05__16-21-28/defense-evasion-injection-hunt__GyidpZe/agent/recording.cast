[79.631722, "o", "events = cursor.execute(\"SELECT * FROM events\").fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.632097, "o", "# We will run an iterative process to find all related GUIDs.\r\n\u001b[?2004l\r\u001b[?2004h> # Any process created by a malicious process is malicious.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.633019, "o", "# Any process accessing a malicious process or being accessed by one, we'll check.\r\n\u001b[?2004l\r\u001b[?2004h> # Let's run a loop to expand malicious_guids.\r\n\u001b[?2004l\r\u001b[?2004h> expanded = True\r\n\u001b[?2004l\r\u001b[?2004h> while expanded:\r\n\u001b[?2004l\r\u001b[?2004h>     expanded = False\r\n\u001b[?2004l\r\u001b[?2004h>     for ev in events:\r\n\u001b[?2004l\r\u001b[?2004h>         # Check if this event indicates a process creation (Sysmon 1 or Security 4688)\r\n\u001b[?2004l\r\u001b[?2004h>         # where the parent is malicious, or the created process is malicious.\r\n\u001b[?2004l\r\u001b[?2004h>         p_guid = ev['process_guid']\r\n\u001b[?2004l\r\u001b[?2004h>         parent_guid = ev['parent_process_guid']\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Also extract from message/details just in case\r\n\u001b[?2004l\r\u001b[?2004h>         msg = ev['message'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>         details = ev['details'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>         all_text = msg + \" \" + details\r\n\u001b[?2004l\r\u001b[?2004h>         guids_in_text = [g.lower() for g in re.findall(r'\\{[a-fA-F0-9\\-]+\\}', all_text)]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Check for matching GUIDs\r\n\u001b[?2004l\r\u001b[?2004h>         is_connected = False\r\n\u001b[?2004l\r"]
[79.633063, "o", "\u001b[?2004h> "]
[79.633197, "o", "        if p_guid and p_guid.lower() in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h>             is_connected = True\r\n"]
[79.633231, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[79.633358, "o", "        if parent_guid and parent_guid.lower() in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.633601, "o", "            is_connected = True\r\n\u001b[?2004l\r\u001b[?2004h>         for g in guids_in_text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.633776, "o", "            if g in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h>                 is_connected = True\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.633925, "o", "        if is_connected:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.63407, "o", "            # If connected, add both process_guid and parent_process_guid to malicious_guids\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.634168, "o", "            if p_guid and p_guid.lower() not in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h>                 malicious_guids.add(p_guid.lower())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.634204, "o", "                expanded = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.634351, "o", "            if parent_guid and parent_guid.lower() not in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.634588, "o", "                malicious_guids.add(parent_guid.lower())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.63463, "o", "                expanded = True\r\n\u001b[?2004l\r\u001b[?2004h>             for g in guids_in_text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.634985, "o", "                if g not in malicious_guids and g != '{00000000-0000-0000-0000-000000000000}':\r\n\u001b[?2004l\r\u001b[?2004h>                     malicious_guids.add(g)\r\n\u001b[?2004l\r\u001b[?2004h>                     expanded = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Identified {len(malicious_guids)} malicious GUIDs:\")\r\n\u001b[?2004l\r\u001b[?2004h> for g in sorted(malicious_guids):\r\n\u001b[?2004l\r\u001b[?2004h>     print(g)"]
