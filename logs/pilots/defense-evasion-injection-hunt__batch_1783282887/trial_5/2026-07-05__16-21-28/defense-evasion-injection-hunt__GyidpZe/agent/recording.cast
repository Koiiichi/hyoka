[95.808171, "i", "cat << 'EOF' > summarize_malicious.py\nunique_images = set()\nunique_codes = set()\nwith open('malicious_timeline.txt') as f:\n    for line in f:\n        parts = line.strip().split(' | ')\n        if len(parts) >= 6:\n            unique_codes.add(parts[1])\n            unique_images.add(parts[5])\nprint(\"Codes:\", sorted(list(unique_codes)))\nprint(\"Images:\", sorted(list(unique_images)))\nEOF\npython3 summarize_malicious.py\n"]
