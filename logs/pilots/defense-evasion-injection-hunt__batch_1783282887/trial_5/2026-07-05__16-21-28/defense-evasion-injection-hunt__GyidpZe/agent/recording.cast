[158.757945, "i", "cat << 'EOF' > compare_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nwith open('malicious_timeline.txt') as f:\n    m_ids = set(line.split(' | ')[0] for line in f)\n\nwith open('correlated_timeline.txt') as f:\n    c_ids = set(line.split(' | ')[0] for line in f)\n\nprint(f\"In malicious_timeline but not in correlated_timeline: {len(m_ids - c_ids)}\")\nfor eid in sorted(list(m_ids - c_ids)):\n    ev = cursor.execute(\"SELECT event_id, event_code, host, image, command_line FROM events WHERE event_id = ?\", (eid,)).fetchone()\n    print(f\"  {ev['event_id']} | Code {ev['event_code']} | {ev['image']} | {ev['command_line'] or ''}\")\n\nprint(f\"\\nIn correlated_timeline but not in malicious_timeline: {len(c_ids - m_ids)}\")\nfor eid in sorted(list(c_ids - m_ids))[:50]:\n    ev = cursor.execute(\"SELECT event_id, event_code, host, image, command_line FROM events WHERE event_id = ?\", (eid,)).fetchone()\n    print(f\"  {ev['event_id']} | Code {ev['event_code']} | {ev['image']} | {ev['command_line'] or ''}\")\n\nEOF\npython3 compare_events.py\n"]
