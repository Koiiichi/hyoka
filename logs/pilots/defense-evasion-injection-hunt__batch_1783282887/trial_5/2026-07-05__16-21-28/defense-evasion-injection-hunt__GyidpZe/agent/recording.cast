[44.423568, "i", "cat << 'EOF' > inspect_hosts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nfor host in ['WS-06.corp.example', 'DC01.corp.example']:\n    print(f\"\\n=== Event counts for {host} ===\")\n    counts = cursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host = ? GROUP BY event_code ORDER BY 2 DESC\", (host,)).fetchall()\n    for row in counts:\n        print(f\"Event {row[0]}: {row[1]}\")\n\nEOF\npython3 inspect_hosts.py\n"]
