[129.807362, "i", "cat << 'EOF' > get_all_pids.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}': 'GruntHTTP.exe',\n    '{71b87c12-d9fe-5f84-1701-000000000500}': 'cmd.exe',\n    '{71b87c12-d9fe-5f84-1801-000000000500}': 'conhost.exe',\n    '{71b87c12-d9fe-5f84-1901-000000000500}': 'wuauclt.exe',\n    '{71b87c12-d9fe-5f84-1a01-000000000500}': 'notepad.exe'\n}\n\nevents = cursor.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\").fetchall()\n\npid_map = {}\nfor guid, name in malicious_guids.items():\n    # Find a sysmon event with this guid to extract process ID\n    for ev in events:\n        p_guid = ev['process_guid']\n        if p_guid and p_guid.lower() == guid:\n            # try to find process ID in message\n            msg = ev['message'] or ''\n            pid_match = re.search(r'ProcessId:\\s*(\\d+)', msg, re.I)\n            if pid_match:\n                pid_dec = int(pid_match.group(1))\n                pid_hex = f\"0x{pid_dec:x}\"\n                pid_map[guid] = (name, pid_dec, pid_hex)\n                break\n\nfor guid, info in pid_map.items():\n    print(f\"{info[0]} ({guid}): Dec PID = {info[1]}, Hex PID = {info[2]}\")\n\nEOF\npython3 get_all_pids.py\n"]
