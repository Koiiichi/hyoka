[153.957887, "i", "cat << 'EOF' > inspect_network_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nwith open('correlated_timeline.txt') as f:\n    matched_ids = [line.split(' | ')[0] for line in f]\n\nplaceholders = ','.join('?' for _ in matched_ids)\nevents = cursor.execute(f\"SELECT event_id, event_code, timestamp, host, user, image, message FROM events WHERE event_id IN ({placeholders}) AND event_code IN (3, 5156, 5158, 22)\", matched_ids).fetchall()\n\nfor ev in events:\n    msg = ev['message'] or ''\n    import re\n    # extract process ID / application name / destination / source ports\n    app_match = re.search(r'Application Name:\\s*([^\\r\\n]+)', msg, re.I)\n    app_name = app_match.group(1).strip() if app_match else (ev['image'] or \"Unknown\")\n    \n    dst_match = re.search(r'Destination Address:\\s*([^\\r\\n]+)', msg, re.I)\n    dst_addr = dst_match.group(1).strip() if dst_match else \"Unknown\"\n    \n    port_match = re.search(r'Destination Port:\\s*([^\\r\\n]+)', msg, re.I)\n    dst_port = port_match.group(1).strip() if port_match else \"Unknown\"\n    \n    print(f\"{ev['event_id']} | Code {ev['event_code']} | App: {app_name} | Dst: {dst_addr}:{dst_port}\")\n\nEOF\npython3 inspect_network_events.py\n"]
