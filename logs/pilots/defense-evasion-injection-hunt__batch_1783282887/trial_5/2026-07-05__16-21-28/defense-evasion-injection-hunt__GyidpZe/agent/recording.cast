.222Z | DC01.corp.example | Event 11 | Image: C:\\windows\\system32\\DFSRs.exe\r\nevt-00097 | 2026-05-06T00:00:26.222Z | DC01.corp.example | Event 4672 | User: DC01$\r\nevt-00098 | 2026-05-06T00:00:26.223Z | DC01.corp.example | Event 4624 | User: - | Net: fe80::74bc:2942:9832:aa63 -> None:None\r\nevt-00099 | 2026-05-06T00:00:26.223Z | DC01.corp.example | Event 4627 | User: -\r\nevt-00100 | 2026-05-06T00:00:26.224Z | DC01.corp.example | Event 12 | Image: C:\\windows\\system32\\DFSRs.exe | Reg: HKLM\\System\\CurrentControlSet\\Services\\DFSR\\Parameters\\Replication Groups\\97D9634C-611C-418C-B807-83070FC7A0CA\r\n\u001b[?2004hroot@8eed1cd52d1d:~# "]
[36.674153, "i", "cat << 'EOF' > analyze_timeline.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's list some suspected terms\nterms = ['GruntHTTP', 'SimpleInjection', 'wuauclt', 'notepad', '10.10.10.5']\n\n# We want to trace all events that are connected to this activity.\n# Let's write a recursive finder for process GUIDs.\n# First, what processes are involved?\n# 1. GruntHTTP.exe\n# 2. cmd.exe\n# 3. conhost.exe\n# 4. wuauclt.exe\n# 5. notepad.exe\n\nsuspicious_images = ['GruntHTTP.exe', 'SimpleInjection.dll', 'wuauclt.exe', 'notepad.exe', 'conhost.exe', 'cmd.exe']\n\n# Let's find all processes on WS-05 that are spawned or spawn something in this chain.\n# Let's look for specific process GUIDs:\n# ProcessGuid of GruntHTTP.exe: let's query its Guid\n# ProcessGuid of cmd.exe: {71b87c12-d9e5-5f84-1401-000000000500} or similar?\n\n# Let's fetch all process GUIDs that have any connection to the above terms.\nrelated_guids = set()\nevents = cursor.execute(\"SELECT * FROM events\").fetchall()\n\nfor ev in events:\n    ev_str = str(dict(ev))\n    for term in terms:\n        if term.lower() in ev_str.lower():\n            # find process_guid or parent_process_guid\n            for key in ['process_guid', 'parent_process_guid', 'details', 'message']:\n                val = ev[key]\n                if val:\n                    # Try to extract GUIDs using regex\n                    guids = re.findall(r'\\{[a-fA-F0-9\\-]+\\}', str(val))\n                    for g in guids:\n                        related_guids.add(g.lower())\n            if ev['process_guid']:\n                related_guids.add(ev['process_guid'].lower())\n            if ev['parent_process_guid']:\n                related_guids.add(ev['parent_process_guid'].lower())\n\nprint(f\"Found {len(related_guids)} related process GUIDs:\")\nfor g in sorted(related_guids):\n    print(g)\n\n# Now let's find all events that reference any of these GUIDs, or contain any of the terms.\nmalicious_events = {}\nfor ev in events:\n    ev_str = str(dict(ev))\n    has_term = any(term.lower() in ev_str.lower() for term in terms)\n    has_guid = False\n    for key in ['process_guid', 'parent_process_guid', 'details', 'message']:\n        val = ev[key]\n        if val:\n            guids = re.findall(r'\\{[a-fA-F0-9\\-]+\\}', str(val))\n            if any(g.lower() in related_guids for g in guids):\n                has_guid = True\n                break\n    if ev['process_guid'] and ev['process_guid'].lower() in related_guids:\n        has_guid = True\n    if ev['parent_process_guid'] and ev['parent_process_guid'].lower() in related_guids:\n        has_guid = True\n        \n    if has_term or has_guid:\n        malicious_events[ev['event_id']] = ev\n\nprint(f\"Found {len(malicious_events)} suspected events.\")\n# Let's print them in order\nfor eid in sorted(malicious_events.keys(), key=lambda x: malicious_events[x]['timestamp']):\n    ev = malicious_events[eid]\n    # print a concise summary\n    desc = f\"{ev['event_id']} | {ev['timestamp']} | {ev['event_code']} | {ev['host']} | {ev['user']} | {ev['image']} | {ev['command_line']} | {ev['target_object'] or ''}\"\n    print(desc)\n\nEOF\npython3 analyze_timeline.py > suspected.txt\nhead -n 100 suspected.txt\n"]
