[119.337083, "i", "cat << 'EOF' > get_malicious_events.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmalicious_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP.exe\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd.exe\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost.exe\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt.exe\n    '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad.exe\n}\n\nevents = cursor.execute(\"SELECT * FROM events ORDER BY timestamp\").fetchall()\n\nmalicious_ids = []\n\nfor ev in events:\n    # Determine the primary process GUID for this event\n    p_guid = ev['process_guid']\n    parent_guid = ev['parent_process_guid']\n    \n    is_malicious = False\n    \n    # Case 1: Process is one of our malicious GUIDs\n    if p_guid and p_guid.lower() in malicious_guids:\n        is_malicious = True\n        \n    # Case 2: Parent is one of our malicious GUIDs (important for process creation events)\n    elif parent_guid and parent_guid.lower() in malicious_guids:\n        is_malicious = True\n        \n    # Case 3: Event-specific GUID checks\n    else:\n        # Check message / details for ProcessGuid of any malicious processes\n        msg = ev['message'] or ''\n        details = ev['details'] or ''\n        text = msg + \" \" + details\n        \n        # Extract ProcessGuid or SourceProcessGUID or TargetProcessGUID\n        # (We want to avoid matching if a benign process accesses a malicious process,\n        # but we DO want to match if a malicious process accesses anything.)\n        src_match = re.search(r'SourceProcessGUID:\\s*(\\{[a-fA-F0-9\\-]+\\})', text, re.I)\n        tgt_match = re.search(r'TargetProcessGUID:\\s*(\\{[a-fA-F0-9\\-]+\\})', text, re.I)\n        proc_match = re.search(r'ProcessGuid:\\s*(\\{[a-fA-F0-9\\-]+\\})', text, re.I)\n        \n        if proc_match:\n            g = proc_match.group(1).lower()\n            if g in malicious_guids:\n                is_malicious = True\n        if src_match:\n            sg = src_match.group(1).lower()\n            if sg in malicious_guids:\n                is_malicious = True\n                \n    if is_malicious:\n        malicious_ids.append(ev['event_id'])\n\nprint(f\"Found {len(malicious_ids)} malicious event IDs.\")\n# Let's print some details\nfor eid in malicious_ids[:20]:\n    ev = cursor.execute(\"SELECT * FROM events WHERE event_id = ?\", (eid,)).fetchone()\n    print(f\"{ev['event_id']} | {ev['event_code']} | {ev['timestamp']} | {ev['image']} | {ev['command_line'] or ''}\")\n\nEOF\npython3 get_malicious_events.py\n"]
