[61.433641, "i", "cat << 'EOF' > inspect_detail.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ndef print_ev(eid):\n    ev = cursor.execute(\"SELECT * FROM events WHERE event_id = ?\", (eid,)).fetchone()\n    if ev:\n        print(f\"=== {ev['event_id']} (Code {ev['event_code']}, {ev['timestamp']}) ===\")\n        for k, v in dict(ev).items():\n            if v is not None and v != '':\n                print(f\"  {k}: {v}\")\n\n# Let's check evt-00088\nprint_ev('evt-00088')\n\n# Let's check events around 00:01:21 (evt-00290 to evt-00315)\nprint(\"\\n--- Events 290 to 315 ---\")\nfor i in range(290, 315):\n    print_ev(f\"evt-{i:05d}\")\n\nEOF\npython3 inspect_detail.py\n"]
