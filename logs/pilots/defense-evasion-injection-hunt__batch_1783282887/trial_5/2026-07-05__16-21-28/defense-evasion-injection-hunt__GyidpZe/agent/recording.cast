[36.677612, "o", "print(f\"Found {len(related_guids)} related process GUIDs:\")\r\n\u001b[?2004l\r\u001b[?2004h> for g in sorted(related_guids):\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.67769, "o", ">     print(g)\r\n\u001b[?2004l\r"]
[36.67776, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.677861, "o", "# Now let's find all events that reference any of these GUIDs, or contain any of the terms.\r\n\u001b[?2004l\r\u001b[?2004h> malicious_events = {}\r\n\u001b[?2004l\r\u001b[?2004h> for ev in events:\r\n\u001b[?2004l\r\u001b[?2004h>     ev_str = str(dict(ev))\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.67794, "o", "> "]
[36.678003, "o", "    has_term = any(term.lower() in ev_str.lower() for term in terms)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.678063, "o", "    has_guid = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.678091, "o", "    for key in ['process_guid', 'parent_process_guid', 'details', 'message']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.678127, "o", "        val = ev[key]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.678215, "o", "        if val:\r\n\u001b[?2004l\r\u001b[?2004h>             guids = re.findall(r'\\{[a-fA-F0-9\\-]+\\}', str(val))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.678268, "o", "            if any(g.lower() in related_guids for g in guids):\r\n\u001b[?2004l\r\u001b[?2004h>                 has_guid = True\r\n\u001b[?2004l\r"]
[36.678328, "o", "\u001b[?2004h>                 break\r\n\u001b[?2004l\r"]
[36.678428, "o", "\u001b[?2004h>     if ev['process_guid'] and ev['process_guid'].lower() in related_guids:\r\n\u001b[?2004l\r"]
[36.678489, "o", "\u001b[?2004h>         has_guid = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.678616, "o", "    if ev['parent_process_guid'] and ev['parent_process_guid'].lower() in related_guids:\r\n\u001b[?2004l\r\u001b[?2004h>         has_guid = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     if has_term or has_guid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.67883, "o", "        malicious_events[ev['event_id']] = ev\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(malicious_events)} suspected events.\")\r\n\u001b[?2004l\r"]
[36.678867, "o", "\u001b[?2004h> # Let's print them in order\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.678961, "o", "for eid in sorted(malicious_events.keys(), key=lambda x: malicious_events[x]['timestamp']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.678976, "o", "    ev = malicious_events[eid]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.67904, "o", "    # print a concise summary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.679141, "o", "    desc = f\"{ev['event_id']} | {ev['timestamp']} | {ev['event_code']} | {ev['host']} | {ev['user']} | {ev['image']} | {ev['command_line']} | {ev['target_object'] or ''}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.679256, "o", "    print(desc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[36.679822, "o", "\u001b[?2004hroot@8eed1cd52d1d:~# python3 analyze_timeline.py > suspected.txt\r\n\u001b[?2004l\r"]
[36.720485, "o", "\u001b[?2004hroot@8eed1cd52d1d:~# "]
[36.720513, "o", "head -n 100 suspected.txt\r\n\u001b[?2004l\r"]
