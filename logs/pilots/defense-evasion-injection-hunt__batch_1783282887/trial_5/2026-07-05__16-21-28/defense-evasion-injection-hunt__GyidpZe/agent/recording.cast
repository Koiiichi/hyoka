[56.277517, "i", "cat << 'EOF' > find_mward.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's search for any event containing 'm.ward' or 'ward'\nevents = cursor.execute(\"SELECT * FROM events WHERE user LIKE '%ward%' OR target_user LIKE '%ward%' OR command_line LIKE '%ward%' OR message LIKE '%ward%' OR details LIKE '%ward%'\").fetchall()\nprint(f\"Found {len(events)} events involving 'ward'\")\n\n# Let's write them to mward_events.txt\nwith open('mward_events.txt', 'w') as f:\n    for ev in events:\n        f.write(f\"{ev['event_id']} | {ev['event_code']} | {ev['timestamp']} | {ev['host']} | {ev['user']} | {ev['image']} | {ev['command_line']}\\n\")\n\nEOF\npython3 find_mward.py\nhead -n 50 mward_events.txt\n"]
