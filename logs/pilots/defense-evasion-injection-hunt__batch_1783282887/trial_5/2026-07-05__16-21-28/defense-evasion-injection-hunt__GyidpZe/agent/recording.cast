[111.117159, "i", "cat << 'EOF' > trace_direct_chain.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nknown_malicious = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}': 'GruntHTTP.exe',\n    '{71b87c12-d9fe-5f84-1701-000000000500}': 'cmd.exe',\n    '{71b87c12-d9fe-5f84-1801-000000000500}': 'conhost.exe',\n    '{71b87c12-d9fe-5f84-1901-000000000500}': 'wuauclt.exe',\n    '{71b87c12-d9fe-5f84-1a01-000000000500}': 'notepad.exe'\n}\n\nevents = cursor.execute(\"SELECT * FROM events ORDER BY timestamp\").fetchall()\n\nprint(\"=== Checking for any other processes spawned by known malicious processes ===\")\nfor ev in events:\n    if ev['event_code'] in (1, 4688):\n        parent = ev['parent_process_guid']\n        if parent and parent.lower() in known_malicious:\n            child_guid = ev['process_guid']\n            child_image = ev['image']\n            child_cmd = ev['command_line']\n            if child_guid and child_guid.lower() not in known_malicious:\n                print(f\"New child found: {child_image} ({child_guid}) | Parent: {known_malicious[parent.lower()]} ({parent})\")\n\nprint(\"\\n=== Checking for process accesses (Event 10) initiated by known malicious processes ===\")\nfor ev in events:\n    if ev['event_code'] == 10:\n        # Details contains the XML / source/target GUIDs\n        # Let's extract source/target from details or message\n        msg = ev['message'] or ''\n        details = ev['details'] or ''\n        text = msg + \" \" + details\n        import re\n        src_match = re.search(r'SourceProcessGUID:\\s*(\\{[a-fA-F0-9\\-]+\\})', text, re.I)\n        tgt_match = re.search(r'TargetProcessGUID:\\s*(\\{[a-fA-F0-9\\-]+\\})', text, re.I)\n        if src_match and tgt_match:\n            src = src_match.group(1).lower()\n            tgt = tgt_match.group(1).lower()\n            if src in known_malicious:\n                print(f\"Malicious process {known_malicious[src]} ({src}) accessed: {ev['image']} or target GUID {tgt} in event {ev['event_id']}\")\n\nEOF\npython3 trace_direct_chain.py\n"]
[111.117508, "o", "cat << 'EOF' > trace_direct_chain.py\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.11769, "o", "> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.1179, "o", "cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.117951, "o", "\u001b[?2004h> known_malicious = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.11806, "o", "    '{71b87c12-d7e5-5f84-0d01-000000000500}': 'GruntHTTP.exe',\r\n\u001b[?2004l\r\u001b[?2004h>     '{71b87c12-d9fe-5f84-1701-000000000500}': 'cmd.exe',"]
