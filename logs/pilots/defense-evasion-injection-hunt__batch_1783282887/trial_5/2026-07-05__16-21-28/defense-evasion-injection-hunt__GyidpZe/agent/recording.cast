[71.442307, "o", "\u001b[?2004hroot@8eed1cd52d1d:~# "]
[79.630438, "i", "cat << 'EOF' > trace_tree.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Malicious Process GUIDs starting point\nmalicious_guids = {'{71b87c12-d7e5-5f84-0d01-000000000500}'}  # GruntHTTP.exe\n\n# Let's find all events in the DB\nevents = cursor.execute(\"SELECT * FROM events\").fetchall()\n\n# We will run an iterative process to find all related GUIDs.\n# Any process created by a malicious process is malicious.\n# Any process accessing a malicious process or being accessed by one, we'll check.\n# Let's run a loop to expand malicious_guids.\nexpanded = True\nwhile expanded:\n    expanded = False\n    for ev in events:\n        # Check if this event indicates a process creation (Sysmon 1 or Security 4688)\n        # where the parent is malicious, or the created process is malicious.\n        p_guid = ev['process_guid']\n        parent_guid = ev['parent_process_guid']\n        \n        # Also extract from message/details just in case\n        msg = ev['message'] or ''\n        details = ev['details'] or ''\n        all_text = msg + \" \" + details\n        guids_in_text = [g.lower() for g in re.findall(r'\\{[a-fA-F0-9\\-]+\\}', all_text)]\n        \n        # Check for matching GUIDs\n        is_connected = False\n        if p_guid and p_guid.lower() in malicious_guids:\n            is_connected = True\n        if parent_guid and parent_guid.lower() in malicious_guids:\n            is_connected = True\n        for g in guids_in_text:\n            if g in malicious_guids:\n                is_connected = True\n                break\n                \n        if is_connected:\n            # If connected, add both process_guid and parent_process_guid to malicious_guids\n            if p_guid and p_guid.lower() not in malicious_guids:\n                malicious_guids.add(p_guid.lower())\n                expanded = True\n            if parent_guid and parent_guid.lower() not in malicious_guids:\n                malicious_guids.add(parent_guid.lower())\n                expanded = True\n            for g in guids_in_text:\n                if g not in malicious_guids and g != '{00000000-0000-0000-0000-000000000000}':\n                    malicious_guids.add(g)\n                    expanded = True\n\nprint(f\"Identified {len(malicious_guids)} malicious GUIDs:\")\nfor g in sorted(malicious_guids):\n    print(g)\n\nEOF\npython3 trace_tree.py\n"]
[79.630725, "o", "cat << 'EOF' > trace_tree.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> "]
