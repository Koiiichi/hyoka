[79.656747, "o", "Identified 42 malicious GUIDs:\r\n{31ec1a48-7490-45f7-9954-e672f3d22309}\r\n{4d36e972-e325-11ce-bfc1-08002be10318}\r\n{71b87c12-d255-5f84-0c00-000000000500}\r\n{71b87c12-d256-5f84-1000-000000000500}\r\n{71b87c12-d256-5f84-1100-000000000500}\r\n{71b87c12-d257-5f84-1a00-000000000500}\r\n{71b87c12-d257-5f84-2a00-000000000500}\r\n{71b87c12-d257-5f84-3100-000000000500}\r\n{71b87c12-d257-5f84-3200-000000000500}\r\n"]
[79.65683, "o", "{71b87c12-d259-5f84-5600-000000000500}\r\n{71b87c12-d26a-5f84-7a00-000000000500}\r\n{71b87c12-d423-5f84-bc00-000000000500}\r\n{71b87c12-d426-5f84-263d-160000000000}\r\n{71b87c12-d427-5f84-c700-000000000500}\r\n{71b87c12-d428-5f84-d000-000000000500}\r\n{71b87c12-d429-5f84-d400-000000000500}\r\n{71b87c12-d44f-5f84-ec00-000000000500}\r\n{71b87c12-d7e5-5f84-0d01-000000000500}\r\n{71b87c12-d7e5-5f84-0e01-000000000500}\r\n{71b87c12-d96c-5f84-1601-000000000500}\r\n{71b87c12-d9fe-5f84-1701-000000000500}\r\n{71b87c12-d9fe-5f84-1801-000000000500}\r\n{71b87c12-d9fe-5f84-1901-000000000500}\r\n{71b87c12-d9fe-5f84-1a01-000000000500}\r\n{a111f1ef-5923-47c0-9a68-d0bafb577901}\r\n{a111f1f2-5923-47c0-9a68-d0bafb577901}\r\n{a111f208-5923-47c0-9a68-d0bafb577901}\r\n{a111f20e-5923-47c0-9a68-d0bafb577901}\r\n{a73a27c4-6acc-2ec5-d9b0-6bdf1199b97a}\r\n{afd3b9fc-85e3-31ae-ca58-c6c829075072}\r\n{c0cc9f2c-b35a-99db-c300-ab81f9214f1d}\r\n{c253ba43-a50b-4bdb-bbbd-31beba3f9383}\r\n{c2cc0b70-b07c-4e94-ce7a-e64aa5b54f1f}\r\n{ca598cb3-eaa8-4d1e-b6bb-8d6d3bac3be5}\r\n{caeb40ef-974a-c792-c33a-5f463afe6817}\r\n{cbb2a086-1b6d-56b2-d894-d36c531e3116}\r\n{d4c3490c-57ea-41da-a72a-a0d687a2a40b}\r\n{d4d94fa9-f35e-411f-c00a-3a647cf15a09}\r\n"]
[79.656882, "o", "{d580afc0-7f79-d03f-dba4-b64e15110308}\r\n{dda7e45f-584f-5939-d6e4-0f428a5a2400}\r\n{dfa77003-5b69-8e76-db9e-4289d6ce2402}\r\n{ea24cd6c-d17a-4348-9190-09f0d5be83dd}\r\n"]
[79.658925, "o", "\u001b[?2004hroot@8eed1cd52d1d:~# "]
[90.055892, "i", "cat << 'EOF' > trace_malicious_events.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# These are the exact process GUIDs of the malicious chain on WS-05\nmalicious_p_guids = {\n    '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP.exe\n    '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd.exe (evt-00542 / 00528)\n    '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost.exe (evt-00551 / 00530)\n    '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt.exe (evt-00594 / 00752)\n    '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad.exe (evt-00610 / 00765)\n}\n\n# Let's verify if there are other process GUIDs related to these. For example, did GruntHTTP run anything else?\n# Let's find any process creation event where the parent process GUID is in malicious_p_guids.\nevents = cursor.execute(\"SELECT * FROM events ORDER BY timestamp\").fetchall()\n\n# Let's iteratively find all child processes of malicious processes\nexpanded = True\nwhile expanded:\n    expanded = False\n    for ev in events:\n        if ev['event_code'] in (1, 4688):\n            # Sysmon 1 or Security 4688\n            parent_guid = ev['parent_process_guid']\n            p_guid = ev['process_guid']\n            # For security 4688, we might need to get GUIDs or Process ID\n            # But Sysmon 1 is present for all these creations. Let's rely on Sysmon 1\n            if parent_guid and parent_guid.lower() in malicious_p_guids:\n                if p_guid and p_guid.lower() not in malicious_p_guids:\n                    malicious_p_guids.add(p_guid.lower())\n                    expanded = True\n\nprint(\"Malicious Process GUIDs identified:\")\nfor g in sorted(malicious_p_guids):\n    print(g)\n\n# Now let's collect ALL events associated with these process GUIDs\n# Events are associated if:\n# 1. process_guid or parent_process_guid is in malicious_p_guids\n# 2. For Sysmon 10 (ProcessAccess), either SourceProcessGUID or TargetProcessGUID is in malicious_p_guids\n# 3. For Sysmon 17/18 (PipeEvents), ProcessGuid is in malicious_p_guids\n# 4. Any other event that has these GUIDs in its message or details\n\nmalicious_events = {}\nfor ev in events:\n    p_guid = ev['process_guid']\n    parent_guid = ev['parent_process_guid']\n    \n    is_malicious = False\n    if p_guid and p_guid.lower() in malicious_p_guids:\n        is_malicious = True\n    if parent_guid and parent_guid.lower() in malicious_p_guids:\n        is_malicious = True\n        \n    # Check message and details for these GUIDs\n    msg = ev['message'] or ''\n    details = ev['details'] or ''\n    all_text = msg + \" \" + details\n    for g in malicious_p_guids:\n        if g in all_text.lower():\n            is_malicious = True\n            break\n            \n    if is_malicious:\n        malicious_events[ev['event_id']] = ev\n\nprint(f\"\\nTotal malicious events found: {len(malicious_events)}\")\nwith open('malicious_timeline.txt', 'w') as f:\n    for eid in sorted(malicious_events.keys(), key=lambda x: malicious_events[x]['timestamp']):\n        ev = malicious_events[eid]\n        line = f\"{ev['event_id']} | {ev['event_code']} | {ev['timestamp']} | {ev['host']} | {ev['user']} | {ev['image']} | {ev['command_line'] or ''} | {ev['target_object'] or ''} | {ev['message'][:200].replace('\\n', ' ').replace('\\r', '')}\\n\"\n        f.write(line)\n\nEOF\npython3 trace_malicious_events.py\ncat malicious_timeline.txt\n"]
