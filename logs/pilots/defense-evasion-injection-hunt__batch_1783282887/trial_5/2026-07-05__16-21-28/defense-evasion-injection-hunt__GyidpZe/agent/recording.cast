[100.190481, "i", "cat << 'EOF' > inspect_benign_involvement.py\nimport re\n\nwith open('malicious_timeline.txt') as f:\n    for line in f:\n        parts = line.strip().split(' | ')\n        if len(parts) >= 6:\n            image = parts[5].lower()\n            if any(benign in image for benign in ['explorer', 'csrss', 'ctfmon', 'lsass', 'svchost']):\n                print(line.strip())\nEOF\npython3 inspect_benign_involvement.py\n"]
