[36.721147, "o", "\u001b[?2004hroot@8eed1cd52d1d:~# "]
[41.194056, "i", "cat << 'EOF' > inspect_others.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's see what processes were created on WS-06 and DC01\nprint(\"=== Process creations on WS-06 ===\")\nfor ev in cursor.execute(\"SELECT event_id, event_code, timestamp, image, parent_image, command_line FROM events WHERE host = 'WS-06.corp.example' AND event_code IN (1, 4688)\").fetchall():\n    print(dict(ev))\n\nprint(\"\\n=== Process creations on DC01 ===\")\nfor ev in cursor.execute(\"SELECT event_id, event_code, timestamp, image, parent_image, command_line FROM events WHERE host = 'DC01.corp.example' AND event_code IN (1, 4688)\").fetchall():\n    print(dict(ev))\n\n# Are there any remote service/scheduled task creations, or service starts on DC01/WS-06?\nprint(\"\\n=== Services and other actions on WS-06/DC01 ===\")\nfor ev in cursor.execute(\"SELECT event_id, event_code, timestamp, host, user, message, details FROM events WHERE host IN ('WS-06.corp.example', 'DC01.corp.example') AND event_code IN (7040, 4697, 4702, 4698)\").fetchall():\n    print(dict(ev))\n\nEOF\npython3 inspect_others.py\n"]
