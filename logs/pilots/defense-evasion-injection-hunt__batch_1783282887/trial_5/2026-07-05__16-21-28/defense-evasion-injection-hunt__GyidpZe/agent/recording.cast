[21.68739, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.687713, "o", "# Let's inspect some of the processes and events around the timestamp of GruntHTTP (2026-05-06)\r\n\u001b[?2004l\r\u001b[?2004h> # Since all activity is 2026-05-06, let's query all events sorted by timestamp.\r\n\u001b[?2004l\r\u001b[?2004h> events = cursor.execute(\"SELECT * FROM events ORDER BY timestamp\").fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total events: {len(events)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[21.689068, "o", "\u001b[?2004hroot@8eed1cd52d1d:~# python3 hunt.py\r\n\u001b[?2004l\r"]
[21.706829, "o", "Total events: 1326\r\n"]
[21.709032, "o", "\u001b[?2004hroot@8eed1cd52d1d:~# "]
[26.15237, "i", "cat << 'EOF' > hunt.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nevents = cursor.execute(\"SELECT event_id, event_code, timestamp, host, user, image, parent_image, command_line, target_object, src_ip, dst_ip, dst_port, service_name, message FROM events ORDER BY timestamp\").fetchall()\n\nfor ev in events:\n    # Print a nice summary of each event\n    line = f\"{ev['event_id']} | {ev['timestamp']} | {ev['host']} | Event {ev['event_code']}\"\n    if ev['user']:\n        line += f\" | User: {ev['user']}\"\n    if ev['image']:\n        line += f\" | Image: {ev['image']}\"\n    if ev['command_line']:\n        line += f\" | Cmd: {ev['command_line'][:100]}\"\n    if ev['target_object']:\n        line += f\" | Reg: {ev['target_object']}\"\n    if ev['src_ip'] or ev['dst_ip']:\n        line += f\" | Net: {ev['src_ip']} -> {ev['dst_ip']}:{ev['dst_port']}\"\n    if ev['service_name']:\n        line += f\" | Svc: {ev['service_name']}\"\n    print(line)\nEOF\npython3 hunt.py > timeline.txt\nhead -n 100 timeline.txt\n"]
