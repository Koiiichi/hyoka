[48.55312, "i", "cat << 'EOF' > inspect_subset.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== WS-06 Event 11, 12, 13 ===\")\nfor ev in cursor.execute(\"SELECT event_id, event_code, timestamp, image, target_object, details, message FROM events WHERE host = 'WS-06.corp.example' AND event_code IN (11, 12, 13)\").fetchall():\n    print(dict(ev))\n\nprint(\"\\n=== DC01 Event 11, 12, 13 ===\")\nfor ev in cursor.execute(\"SELECT event_id, event_code, timestamp, image, target_object, details, message FROM events WHERE host = 'DC01.corp.example' AND event_code IN (11, 12, 13)\").fetchall():\n    print(dict(ev))\n\nprint(\"\\n=== DC01 Share / Network Access Events (5140, 5145) ===\")\nfor ev in cursor.execute(\"SELECT event_id, event_code, timestamp, user, message, details FROM events WHERE host = 'DC01.corp.example' AND event_code IN (5140, 5145)\").fetchall():\n    print(dict(ev))\n\nEOF\npython3 inspect_subset.py\n"]
