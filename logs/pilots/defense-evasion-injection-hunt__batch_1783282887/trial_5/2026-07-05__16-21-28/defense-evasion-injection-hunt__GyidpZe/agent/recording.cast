[148.762466, "i", "cat << 'EOF' > inspect_object_access.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's inspect object access events in our correlated list\n# We'll pull from the database directly, but filter by the matched event IDs\nwith open('correlated_timeline.txt') as f:\n    matched_ids = [line.split(' | ')[0] for line in f]\n\nplaceholders = ','.join('?' for _ in matched_ids)\nevents = cursor.execute(f\"SELECT event_id, event_code, timestamp, host, user, image, message, details FROM events WHERE event_id IN ({placeholders}) AND event_code IN (4656, 4658, 4663, 4690)\", matched_ids).fetchall()\n\n# Let's group and count them by accessed object / type\nfor ev in events[:50]:\n    msg = ev['message'] or ''\n    # Try to extract object name\n    import re\n    obj_match = re.search(r'Object Name:\\s*([^\\r\\n]+)', msg, re.I)\n    obj_name = obj_match.group(1).strip() if obj_match else \"Unknown\"\n    \n    # Extract process name / ID doing the access\n    proc_match = re.search(r'Process Name:\\s*([^\\r\\n]+)', msg, re.I)\n    proc_name = proc_match.group(1).strip() if proc_match else \"Unknown\"\n    \n    print(f\"{ev['event_id']} | Code {ev['event_code']} | Proc: {proc_name} | Obj: {obj_name}\")\n\nEOF\npython3 inspect_object_access.py\n"]
