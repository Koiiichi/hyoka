[129.809529, "o", "    '{71b87c12-d9fe-5f84-1901-000000000500}': 'wuauclt.exe',\r\n\u001b[?2004l\r\u001b[?2004h>     '{71b87c12-d9fe-5f84-1a01-000000000500}': 'notepad.exe'\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.809661, "o", "events = cursor.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\").fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pid_map = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[129.809688, "o", "> for guid, name in malicious_guids.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.809864, "o", "    # Find a sysmon event with this guid to extract process ID\r\n\u001b[?2004l\r\u001b[?2004h>     for ev in events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.809999, "o", "        p_guid = ev['process_guid']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.810028, "o", "        if p_guid and p_guid.lower() == guid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.810177, "o", "            # try to find process ID in message\r\n\u001b[?2004l\r\u001b[?2004h>             msg = ev['message'] or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.810362, "o", "            pid_match = re.search(r'ProcessId:\\s*(\\d+)', msg, re.I)\r\n\u001b[?2004l\r\u001b[?2004h>             if pid_match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.81039, "o", "                pid_dec = int(pid_match.group(1))\r\n"]
[129.810499, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[129.810596, "o", "                pid_hex = f\"0x{pid_dec:x}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.810747, "o", "                pid_map[guid] = (name, pid_dec, pid_hex)\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.81091, "o", "for guid, info in pid_map.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.811083, "o", "    print(f\"{info[0]} ({guid}): Dec PID = {info[1]}, Hex PID = {info[2]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
