[?2004hroot@8eed1cd52d1d:~# cat << 'EOF' > inspect_detail.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> def print_ev(eid):
[?2004l[?2004h>     ev = cursor.execute("SELECT * FROM events WHERE event_id = ?", (eid,)).fetchone()
[?2004l[?2004h>     if ev:
[?2004l[?2004h>         print(f"=== {ev['event_id']} (Code {ev['event_code']}, {ev['timestamp']}) ===")
[?2004l[?2004h>         for k, v in dict(ev).items():
[?2004l[?2004h>             if v is not None and v != '':
[?2004l[?2004h>                 print(f"  {k}: {v}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's check evt-00088
[?2004l[?2004h> print_ev('evt-00088')
[?2004l[?2004h> 
[?2004l[?2004h> # Let's check events around 00:01:21 (evt-00290 to evt-00315)
[?2004l[?2004h> print("\n--- Events 290 to 315 ---")
[?2004l[?2004h> for i in range(290, 315):
[?2004l[?2004h>     print_ev(f"evt-{i:05d}")
[?2004l[?2004h> 
