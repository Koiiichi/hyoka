[?2004l[?2004h>     msg = ev['message'] or ''
[?2004l[?2004h>     details = ev['details'] or ''
[?2004l[?2004h>     text = (msg + " " + details).lower()
[?2004l[?2004h>     
[?2004l[?2004h>     # Let's check for any of the malicious names first
[?2004l[?2004h>     has_name = any(name in text for name in names)
[?2004l[?2004h>     
[?2004l[?2004h>     # Let's extract hex and dec values that look like process IDs/thread IDs in the text
[?2004l[?2004h>     # Specifically, we want to match fields like:
[?2004l[?2004h>     # Process ID: 0xd1c
[?2004l[?2004h>     # Creator Process ID: 0xd1c
[?2004l[?2004h>     # Process ID: 3356
[?2004l[?2004h>     has_pid = False
[?2004l[?2004h>     
[?2004l[?2004h>     # We can search for the exact strings "0xd1c", "3356", etc.
[?2004l[?2004h>     # Let's search for exact word matches
[?2004l[?2004h>     words = re.split(r'[^a-zA-Z0-9x]', text)
[?2004l[?2004h>     for w in words:
[?2004l[?2004h>         if w in pids_dec or w in pids_hex:
[?2004l[?2004h>             has_pid = True
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>     if has_name or has_pid:
[?2004l[?2004h>         # Let's filter out some extreme noise if it's unrelated
[?2004l[?2004h>         # Standard svchost telemetry is not malicious
[?2004l[?2004h>         if ev['image'] and 'svchost.exe' in ev['image'].lower() and not has_name:
[?2004l[?2004h>             continue
[?2004l[?2004h>         correlated_sec_events.append(ev)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(correlated_sec_events)} correlated events on WS-05.")
[?2004l[?2004h> with open('correlated_timeline.txt', 'w') as f:
[?2004l[?2004h>     for ev in correlated_sec_events:
[?2004l[?2004h>         f.write(f"{ev['event_id']} | {ev['event_code']} | {ev['timestamp']} | {ev['host']} | {ev['user']} | {ev['image']} | {ev['command_line'] or ''} | {ev['target_object'] or ''}\n")
[?2004l[?2004h> 
