[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious PIDs
[?2004l[?2004h> pids_dec = {'3356', '3148', '4288', '6208', '2368'}
[?2004l[?2004h> pids_hex = {'0xd1c', '0xc4c', '0x10c0', '0x1840', '0x940'}
[?2004l[?2004h> names = {'grunthttp', 'simpleinjection', 'wuauclt', 'notepad.exe'}
[?2004l[?2004h> 
[?2004l[?2004h> events = cursor.execute("SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp").fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> correlated_sec_events = []
[?2004l[?2004h> 
[?2004l[?2004h> for ev in events:
[?2004l[?2004h>     # We only care about events NOT already covered by the Sysmon GUID check
