[?2004l[?2004h>     'evt-00723', 'evt-00726', 'evt-00729', 'evt-00887', # Prefetch
[?2004l[?2004h>     'evt-00540', 'evt-00608', 'evt-00647', 'evt-00700', 'evt-00701', 'evt-00702' # BAM
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> events = cursor.execute("SELECT * FROM events ORDER BY timestamp").fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> final_malicious_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> for ev in events:
[?2004l[?2004h>     eid = ev['event_id']
[?2004l[?2004h>     p_guid = ev['process_guid']
[?2004l[?2004h>     parent_guid = ev['parent_process_guid']
[?2004l[?2004h>     msg = ev['message'] or ''
[?2004l[?2004h>     details = ev['details'] or ''
[?2004l[?2004h>     text = (msg + " " + details).lower()
[?2004l[?2004h>     
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     
[?2004l[?2004h>     # Rule 1: Process executing the action is malicious
[?2004l[?2004h>     if p_guid and p_guid.lower() in malicious_guids:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # Rule 2: Parent process is malicious (crucial for process creation events)
[?2004l[?2004h>     elif parent_guid and parent_guid.lower() in malicious_guids:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # Rule 3: Special check for Sysmon ProcessAccess (Event 10)
[?2004l[?2004h>     # We want to match ONLY if SourceProcessGUID is malicious.
[?2004l[?2004h>     # (If Source is benign and Target is malicious, it's a benign system check, so we don't match.)
[?2004l[?2004h>     elif ev['event_code'] == 10:
[?2004l[?2004h>         src_match = re.search(r'SourceProcessGUID:\s*(\{[a-fA-F0-9\-]+\})', text, re.I)
[?2004l[?2004h>         if src_match:
[?2004l[?2004h>             sg = src_match.group(1).lower()
[?2004l[?2004h>             if sg in malicious_guids:
[?2004l[?2004h>                 is_malicious = True
[?2004l[?2004h>                 
[?2004l[?2004h>     # Rule 4: Security channel event checks using Subject PIDs
[?2004l[?2004h>     elif ev['channel'] == 'security':
[?2004l[?2004h>         # We need to extract the Subject Process ID or Creator Process ID
[?2004l[?2004h>         # We should NOT match if a benign PID is the subject, even if target PID is malicious.
[?2004l[?2004h>         # Let's extract "Subject: ... Process ID: ..." or "Creator Subject: ..."
[?2004l[?2004h>         # Let's check if the Subject / Creator PID is one of the malicious ones.
[?2004l[?2004h>         
[?2004l[?2004h>         # Find the Process ID in Subject / Creator section
[?2004l[?2004h>         # Typically formatted as:
[?2004l[?2004h>         # Subject:
[?2004l[?2004h>         #    ... 
[?2004l[?2004h>         #    Process ID: 0xd1c
[?2004l[?2004h>         # Or Creator Process ID: 0xd1c
[?2004l[?2004h>         # Or Process ID: 3356
[?2004l[?2004h>         
[?2004l[?2004h>         subject_pid_matches = re.findall(r'Process ID:\s*([0-9a-fx]+)', text, re.I)
[?2004l[?2004h>         creator_pid_matches = re.findall(r'Creator Process ID:\s*([0-9a-fx]+)', text, re.I)
[?2004l[?2004h>         
[?2004l[?2004h>         all_subj_pids = set(subject_pid_matches + creator_pid_matches)
[?2004l[?2004h>         for p in all_subj_pids:
[?2004l[?2004h>             if p in pids_dec or p in pids_hex:
[?2004l[?2004h>                 is_malicious = True
[?2004l[?2004h>                 break
[?2004l[?2004h>                 
[?2004l[?2004h>     # Rule 5: Explicitly include designated system reactions
[?2004l[?2004h>     if eid in system_reaction_events:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         final_malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Selected {len(final_malicious_ids)} malicious event IDs.")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's write the JSON list to findings.json
[?2004l[?2004h> findings_list = sorted(list(final_malicious_ids))
[?2004l[?2004h> with open('/root/findings.json', 'w') as f:
[?2004l[?2004h>     json.dump(findings_list, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("Saved findings to /root/findings.json")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's print out the full chronologically sorted timeline of our final list to double check
[?2004l[?2004h> print("\n--- FINAL MALICIOUS TIMELINE ---")
[?2004l[?2004h> for eid in findings_list:
[?2004l[?2004h>     ev = cursor.execute("SELECT * FROM events WHERE event_id = ?", (eid,)).fetchone()
[?2004l[?2004h>     print(f"{ev['event_id']} | {ev['event_code']} | {ev['timestamp']} | {ev['host']} | {ev['image'] or ''} | {ev['command_line'] or ''}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@8eed1cd52d1d:~# python3 generate_final_findings.py > final_timeline.txt
[?2004l[?2004hroot@8eed1cd52d1d:~# wc -l final_timeline.txt
[?2004l278 final_timeline.txt
[?2004hroot@8eed1cd52d1d:~# head -n 50 final_timeline.txt
[?2004lSelected 274 malicious event IDs.
