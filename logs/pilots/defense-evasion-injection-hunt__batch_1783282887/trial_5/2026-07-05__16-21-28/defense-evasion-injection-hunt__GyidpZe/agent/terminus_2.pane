[?2004hroot@8eed1cd52d1d:~# cat << 'EOF' > trace_malicious_events.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # These are the exact process GUIDs of the malicious chain on WS-05
[?2004l[?2004h> malicious_p_guids = {
[?2004l[?2004h>     '{71b87c12-d7e5-5f84-0d01-000000000500}', # GruntHTTP.exe
[?2004l[?2004h>     '{71b87c12-d9fe-5f84-1701-000000000500}', # cmd.exe (evt-00542 / 00528)
[?2004l[?2004h>     '{71b87c12-d9fe-5f84-1801-000000000500}', # conhost.exe (evt-00551 / 00530)
[?2004l[?2004h>     '{71b87c12-d9fe-5f84-1901-000000000500}', # wuauclt.exe (evt-00594 / 00752)
[?2004l[?2004h>     '{71b87c12-d9fe-5f84-1a01-000000000500}'  # notepad.exe (evt-00610 / 00765)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Let's verify if there are other process GUIDs related to these. For example, did GruntHTTP run anything else?
[?2004l[?2004h> # Let's find any process creation event where the parent process GUID is in malicious_p_guids.
[?2004l[?2004h> events = cursor.execute("SELECT * FROM events ORDER BY timestamp").fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's iteratively find all child processes of malicious processes
[?2004l[?2004h> expanded = True
[?2004l[?2004h> while expanded:
[?2004l[?2004h>     expanded = False
[?2004l[?2004h>     for ev in events:
[?2004l[?2004h>         if ev['event_code'] in (1, 4688):
[?2004l[?2004h>             # Sysmon 1 or Security 4688
[?2004l[?2004h>             parent_guid = ev['parent_process_guid']
[?2004l[?2004h>             p_guid = ev['process_guid']
[?2004l[?2004h>             # For security 4688, we might need to get GUIDs or Process ID
[?2004l[?2004h>             # But Sysmon 1 is present for all these creations. Let's rely on Sysmon 1
[?2004l[?2004h>             if parent_guid and parent_guid.lower() in malicious_p_guids:
[?2004l[?2004h>                 if p_guid and p_guid.lower() not in malicious_p_guids:
[?2004l[?2004h>                     malicious_p_guids.add(p_guid.lower())
[?2004l[?2004h>                     expanded = True
[?2004l[?2004h> 
[?2004l[?2004h> print("Malicious Process GUIDs identified:")
[?2004l[?2004h> for g in sorted(malicious_p_guids):
[?2004l[?2004h>     print(g)
[?2004l[?2004h> 
[?2004l[?2004h> # Now let's collect ALL events associated with these process GUIDs
[?2004l[?2004h> # Events are associated if:
[?2004l[?2004h> # 1. process_guid or parent_process_guid is in malicious_p_guids
[?2004l[?2004h> # 2. For Sysmon 10 (ProcessAccess), either SourceProcessGUID or TargetProcessGUID is in malicious_p_guids
[?2004l[?2004h> # 3. For Sysmon 17/18 (PipeEvents), ProcessGuid is in malicious_p_guids
[?2004l[?2004h> # 4. Any other event that has these GUIDs in its message or details
[?2004l[?2004h> 
[?2004l[?2004h> malicious_events = {}
[?2004l[?2004h> for ev in events:
[?2004l[?2004h>     p_guid = ev['process_guid']
[?2004l[?2004h>     parent_guid = ev['parent_process_guid']
[?2004l[?2004h>     
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     if p_guid and p_guid.lower() in malicious_p_guids:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     if parent_guid and parent_guid.lower() in malicious_p_guids:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # Check message and details for these GUIDs
[?2004l[?2004h>     msg = ev['message'] or ''
[?2004l[?2004h>     details = ev['details'] or ''
[?2004l[?2004h>     all_text = msg + " " + details
[?2004l[?2004h>     for g in malicious_p_guids:
[?2004l[?2004h>         if g in all_text.lower():
[?2004l[?2004h>             is_malicious = True
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         malicious_events[ev['event_id']] = ev
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nTotal malicious events found: {len(malicious_events)}")
[?2004l[?2004h> with open('malicious_timeline.txt', 'w') as f:
[?2004l[?2004h>     for eid in sorted(malicious_events.keys(), key=lambda x: malicious_events[x]['timestamp']):
[?2004l[?2004h>         ev = malicious_events[eid]
[?2004l[?2004h>         line = f"{ev['event_id']} | {ev['event_code']} | {ev['timestamp']} | {ev['host']} | {ev['user']} | {ev['image']} | {ev['command_line'] or ''} | {ev['target_object'] or ''} | {ev['message'][:200].replace('\n', ' ').replace('\r', '')}\n"
[?2004l[?2004h>         f.write(line)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
