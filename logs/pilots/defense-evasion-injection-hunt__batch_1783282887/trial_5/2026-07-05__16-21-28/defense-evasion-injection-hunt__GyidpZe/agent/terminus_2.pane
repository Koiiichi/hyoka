[?2004hroot@8eed1cd52d1d:~# cat << 'EOF' > trace_tree.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious Process GUIDs starting point
[?2004l[?2004h> malicious_guids = {'{71b87c12-d7e5-5f84-0d01-000000000500}'}  # GruntHTTP.exe
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find all events in the DB
[?2004l[?2004h> events = cursor.execute("SELECT * FROM events").fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> # We will run an iterative process to find all related GUIDs.
[?2004l[?2004h> # Any process created by a malicious process is malicious.
[?2004l[?2004h> # Any process accessing a malicious process or being accessed by one, we'll check.
[?2004l[?2004h> # Let's run a loop to expand malicious_guids.
[?2004l[?2004h> expanded = True
[?2004l[?2004h> while expanded:
[?2004l[?2004h>     expanded = False
[?2004l[?2004h>     for ev in events:
[?2004l[?2004h>         # Check if this event indicates a process creation (Sysmon 1 or Security 4688)
[?2004l[?2004h>         # where the parent is malicious, or the created process is malicious.
[?2004l[?2004h>         p_guid = ev['process_guid']
[?2004l[?2004h>         parent_guid = ev['parent_process_guid']
[?2004l[?2004h>         
[?2004l[?2004h>         # Also extract from message/details just in case
[?2004l[?2004h>         msg = ev['message'] or ''
[?2004l[?2004h>         details = ev['details'] or ''
[?2004l[?2004h>         all_text = msg + " " + details
[?2004l[?2004h>         guids_in_text = [g.lower() for g in re.findall(r'\{[a-fA-F0-9\-]+\}', all_text)]
[?2004l[?2004h>         
[?2004l[?2004h>         # Check for matching GUIDs
[?2004l[?2004h>         is_connected = False
[?2004l[?2004h>         if p_guid and p_guid.lower() in malicious_guids:
[?2004l[?2004h>             is_connected = True
[?2004l[?2004h>         if parent_guid and parent_guid.lower() in malicious_guids:
[?2004l[?2004h>             is_connected = True
[?2004l[?2004h>         for g in guids_in_text:
[?2004l[?2004h>             if g in malicious_guids:
[?2004l[?2004h>                 is_connected = True
[?2004l[?2004h>                 break
[?2004l[?2004h>                 
[?2004l[?2004h>         if is_connected:
[?2004l[?2004h>             # If connected, add both process_guid and parent_process_guid to malicious_guids
[?2004l[?2004h>             if p_guid and p_guid.lower() not in malicious_guids:
[?2004l[?2004h>                 malicious_guids.add(p_guid.lower())
[?2004l[?2004h>                 expanded = True
[?2004l[?2004h>             if parent_guid and parent_guid.lower() not in malicious_guids:
[?2004l[?2004h>                 malicious_guids.add(parent_guid.lower())
[?2004l[?2004h>                 expanded = True
[?2004l[?2004h>             for g in guids_in_text:
[?2004l[?2004h>                 if g not in malicious_guids and g != '{00000000-0000-0000-0000-000000000000}':
[?2004l[?2004h>                     malicious_guids.add(g)
[?2004l[?2004h>                     expanded = True
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Identified {len(malicious_guids)} malicious GUIDs:")
[?2004l[?2004h> for g in sorted(malicious_guids):
[?2004l[?2004h>     print(g)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
