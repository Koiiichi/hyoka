Sending keys: ['cat << \'EOF\' > correlate_security_events.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Malicious PIDs\npids_dec = {\'3356\', \'3148\', \'4288\', \'6208\', \'2368\'}\npids_hex = {\'0xd1c\', \'0xc4c\', \'0x10c0\', \'0x1840\', \'0x940\'}\nnames = {\'grunthttp\', \'simpleinjection\', \'wuauclt\', \'notepad.exe\'}\n\nevents = cursor.execute("SELECT * FROM events WHERE host = \'WS-05.corp.example\' ORDER BY timestamp").fetchall()\n\ncorrelated_sec_events = []\n\nfor ev in events:\n    # We only care about events NOT already covered by the Sysmon GUID check\n    # Wait, actually, let\'s look at all events to be safe.\n    msg = ev[\'message\'] or \'\'\n    details = ev[\'details\'] or \'\'\n    text = (msg + " " + details).lower()\n    \n    # Let\'s check for any of the malicious names first\n    has_name = any(name in text for name in names)\n    \n    # Let\'s extract hex and dec values that look like process IDs/thread IDs in the text\n    # Specifically, we want to match fields like:\n    # Process ID: 0xd1c\n    # Creator Process ID: 0xd1c\n    # Process ID: 3356\n    has_pid = False\n    \n    # We can search for the exact strings "0xd1c", "3356", etc.\n    # Let\'s search for exact word matches\n    words = re.split(r\'[^a-zA-Z0-9x]\', text)\n    for w in words:\n        if w in pids_dec or w in pids_hex:\n            has_pid = True\n            break\n            \n    if has_name or has_pid:\n        # Let\'s filter out some extreme noise if it\'s unrelated\n        # Standard svchost telemetry is not malicious\n        if ev[\'image\'] and \'svchost.exe\' in ev[\'image\'].lower() and not has_name:\n            continue\n        correlated_sec_events.append(ev)\n\nprint(f"Found {len(correlated_sec_events)} correlated events on WS-05.")\nwith open(\'correlated_timeline.txt\', \'w\') as f:\n    for ev in correlated_sec_events:\n        f.write(f"{ev[\'event_id\']} | {ev[\'event_code\']} | {ev[\'timestamp\']} | {ev[\'host\']} | {ev[\'user\']} | {ev[\'image\']} | {ev[\'command_line\'] or \'\'} | {ev[\'target_object\'] or \'\'}\\n")\n\nEOF\npython3 correlate_security_events.py\ncat correlated_timeline.txt\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
