[36.63821, "o", "\u001b[?2004hroot@2d7aab8642bb:~# "]
[54.897327, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Query all events on WS-05\ncursor.execute(\"SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, target_image, target_object, details, message FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp ASC\")\nrows = cursor.fetchall()\n\nprint(f\"Total events on WS-05: {len(rows)}\")\n\n# Let's inspect specific events that are clearly related to the threat actor\n# We'll identify malicious events\n# Let's write a script to look at details of 4656, 4663, 4658, 4690, etc.\nfor r in rows:\n    eid, ecode, ts, user, img, pimg, cmd, tgt_img, tgt_obj, details, msg = r\n    \n    # If the process is GruntHTTP.exe, cmd.exe (spawned by Grunt), wuauclt.exe (spawned by cmd), conhost.exe (spawned by cmd), notepad.exe (spawned by wuauclt)\n    # Or if the event message contains 'SimpleInjection.dll'\n    \n    # Let's print out details of the 4656/4663/4658/4690/4673 events\n    if ecode in [4656, 4663, 4658, 4690, 4673, 12, 13, 10, 7, 11]:\n        # Let's print if they contain relevant strings\n        msg_lower = (msg or '').lower()\n        if 'simpleinjection' in msg_lower or 'grunt' in msg_lower or 'wuauclt' in msg_lower or 'notepad' in msg_lower:\n            print(f\"{eid} | {ecode} | {img or ''} | {tgt_obj or ''} | {tgt_img or ''}\")\n            if ecode in [4656, 4663, 4673, 12, 13, 10]:\n                # print some lines of msg\n                lines = [l.strip() for l in msg.split('\\n') if l.strip()]\n                for line in lines[:8]:\n                    print(\"  \", line)\nEOF\npython3 /tmp/analyze.py\n"]
[54.899518, "o", "cat << 'EOF' > /tmp/analyze.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
