[76.2182, "i", "cat << 'EOF' > /tmp/detailed_timeline.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's get the timeline of events around the execution of GruntHTTP.exe (using timestamp column)\n# We'll fetch all events from WS-05 and filter down\ncursor.execute(\"SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, message FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp ASC\")\nrows = cursor.fetchall()\n\n# Let's find the timestamp of evt-00528 to baseline\ntarget_ts = None\nfor r in rows:\n    if r[0] == 'evt-00528':\n        target_ts = r[2]\n        break\n\nprint(f\"Target event timestamp: {target_ts}\")\n\n# Print events around that time (+- 5 seconds or by chronological proximity)\n# Let's print all events that are related to GruntHTTP.exe, wuauclt.exe, notepad.exe, cmd.exe, conhost.exe\n# we'll exclude common noisy system events unless they are clearly related\n\nfor r in rows:\n    eid, ecode, ts, user, img, pimg, cmd, msg = r\n    \n    # Check if the event involves our known processes\n    msg_lower = (msg or '').lower()\n    img_lower = (img or '').lower()\n    pimg_lower = (pimg or '').lower()\n    cmd_lower = (cmd or '').lower()\n    \n    is_relevant = False\n    for keyword in ['grunt', 'simpleinjection', 'wuauclt', 'notepad']:\n        if keyword in msg_lower or keyword in img_lower or keyword in pimg_lower or keyword in cmd_lower:\n            is_relevant = True\n            break\n            \n    # Also include cmd.exe and conhost.exe if their parent is Grunt or cmd\n    if 'cmd.exe' in img_lower and 'grunt' in pimg_lower:\n        is_relevant = True\n    if 'conhost.exe' in img_lower and 'cmd.exe' in pimg_lower:\n        is_relevant = True\n        \n    if is_relevant:\n        print(f\"{eid} | {ecode} | {ts} | {img or ''} | {cmd or ''}\")\nEOF\npython3 /tmp/detailed_timeline.py\n"]
