[65.679519, "i", "cat << 'EOF' > /tmp/search_other_hosts.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Query for occurrences of Grunt, SimpleInjection, wuauclt, etc. across all hosts\ncursor.execute(\"SELECT host, event_code, COUNT(*) FROM events WHERE message LIKE '%Grunt%' OR message LIKE '%SimpleInjection%' OR message LIKE '%wuauclt%' GROUP BY host, event_code\")\nfor r in cursor.fetchall():\n    print(\"Match on:\", r)\n\n# Let's check for any other uncommon executables running from C:\\Users\\*\\Desktop or C:\\ProgramData\\\ncursor.execute(\"SELECT event_id, host, image, command_line FROM events WHERE event_code IN (1, 4688) AND (image LIKE '%Users%' OR command_line LIKE '%Users%' OR image LIKE '%ProgramData%' OR command_line LIKE '%ProgramData%') AND image NOT LIKE '%chrome%' AND image NOT LIKE '%Microsoft%'\")\nfor r in cursor.fetchall():\n    print(\"Uncommon execution:\", r)\nEOF\npython3 /tmp/search_other_hosts.py\n"]
