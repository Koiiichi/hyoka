[128.918906, "i", "cat << 'EOF' > /tmp/summarize_audits.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\neids = ['evt-00812', 'evt-00813', 'evt-00814', 'evt-00822', 'evt-00823', 'evt-00824', 'evt-00827', 'evt-00828', 'evt-00829']\nfor eid in eids:\n    cursor.execute(\"SELECT event_code, message FROM events WHERE event_id = ?\", (eid,))\n    row = cursor.fetchone()\n    if row:\n        ecode, msg = row\n        # extract Process Name and Object Name\n        proc = \"\"\n        obj = \"\"\n        for line in msg.split('\\n'):\n            if 'Process Name:' in line:\n                proc = line.split(':', 1)[1].strip()\n            if 'Object Name:' in line:\n                obj = line.split(':', 1)[1].strip()\n        print(f\"{eid} | {ecode} | {proc} | {obj}\")\nEOF\npython3 /tmp/summarize_audits.py\n"]
