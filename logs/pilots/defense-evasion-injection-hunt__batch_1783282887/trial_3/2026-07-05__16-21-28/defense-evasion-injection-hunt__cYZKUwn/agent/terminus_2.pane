[?2004hroot@2d7aab8642bb:~# cat << 'EOF' > /tmp/search_other_hosts.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Query for occurrences of Grunt, SimpleInjection, wuauclt, etc. across all hosts
[?2004l[?2004h> cursor.execute("SELECT host, event_code, COUNT(*) FROM events WHERE message LIKE '%Grunt%' OR message LIKE '%SimpleInjection%' OR message LIKE '%wuauclt%' GROUP BY host, event_code")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print("Match on:", r)
[?2004l[?2004h> 
[?2004l[?2004h> # Let's check for any other uncommon executables running from C:\Users\*\Desktop or C:\ProgramData\
[?2004l[?2004h> cursor.execute("SELECT event_id, host, image, command_line FROM events WHERE event_code IN (1, 4688) AND (image LIKE '%Users%' OR command_line LIKE '%Users%' OR image LIKE '%ProgramData%' OR command_line LIKE '%ProgramData%') AND image NOT LIKE '%chrome%' AND image NOT LIKE '%Microsoft%'")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print("Uncommon execution:", r)
