[?2004hroot@2d7aab8642bb:~# cat << 'EOF' > /tmp/detailed_timeline.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's get the timeline of events around the execution of GruntHTTP.exe (using timestamp column)
[?2004l[?2004h> # We'll fetch all events from WS-05 and filter down
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, message FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp ASC")
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find the timestamp of evt-00528 to baseline
[?2004l[?2004h> target_ts = None
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     if r[0] == 'evt-00528':
[?2004l[?2004h>         target_ts = r[2]
[?2004l[?2004h>         break
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Target event timestamp: {target_ts}")
[?2004l[?2004h> 
[?2004l[?2004h> # Print events around that time (+- 5 seconds or by chronological proximity)
[?2004l[?2004h> # Let's print all events that are related to GruntHTTP.exe, wuauclt.exe, notepad.exe, cmd.exe, conhost.exe
[?2004l[?2004h> # we'll exclude common noisy system events unless they are clearly related
[?2004l[?2004h> 
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     eid, ecode, ts, user, img, pimg, cmd, msg = r
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if the event involves our known processes
[?2004l[?2004h>     msg_lower = (msg or '').lower()
[?2004l[?2004h>     img_lower = (img or '').lower()
[?2004l[?2004h>     pimg_lower = (pimg or '').lower()
[?2004l[?2004h>     cmd_lower = (cmd or '').lower()
[?2004l[?2004h>     
[?2004l[?2004h>     is_relevant = False
[?2004l[?2004h>     for keyword in ['grunt', 'simpleinjection', 'wuauclt', 'notepad']:
[?2004l[?2004h>         if keyword in msg_lower or keyword in img_lower or keyword in pimg_lower or keyword in cmd_lower:
[?2004l[?2004h>             is_relevant = True
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>     # Also include cmd.exe and conhost.exe if their parent is Grunt or cmd
[?2004l[?2004h>     if 'cmd.exe' in img_lower and 'grunt' in pimg_lower:
[?2004l[?2004h>         is_relevant = True
[?2004l[?2004h>     if 'conhost.exe' in img_lower and 'cmd.exe' in pimg_lower:
[?2004l[?2004h>         is_relevant = True
[?2004l[?2004h>         
[?2004l[?2004h>     if is_relevant:
[?2004l[?2004h>         print(f"{eid} | {ecode} | {ts} | {img or ''} | {cmd or ''}")
[?2004l[?2004h> EOF
