[?2004hroot@7db012086c2c:~# cat << 'EOF' > /tmp/explore_lateral.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's see if there are any Sysmon 11 (File Create) events on DC01 or WS-06 that aren't typical
[?2004l[?2004h> print("=== Non-standard Sysmon 11 (File Create) on DC01 or WS-06 ===")
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, host, timestamp, user, image, target_object, details, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE event_code = 11 AND host != 'WS-05.corp.example'
[?2004l[?2004h> """)
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     tgt = str(r['target_object']) or ''
[?2004l[?2004h>     img = str(r['image']) or ''
[?2004l[?2004h>     # filter out some extremely standard ones if any
[?2004l[?2004h>     print(f"{r['event_id']} | {r['host']} | {r['timestamp']} | {img} created {tgt}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== Sysmon 12/13 (Registry) on DC01 or WS-06 (non-standard) ===")
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, host, timestamp, event_code, image, target_object, details 
