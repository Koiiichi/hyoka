[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example' 
