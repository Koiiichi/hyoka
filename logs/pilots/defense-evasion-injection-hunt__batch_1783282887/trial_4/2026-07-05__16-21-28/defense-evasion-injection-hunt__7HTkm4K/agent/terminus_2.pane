[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT * FROM events")
[?2004l[?2004h> all_events = [dict(r) for r in cursor.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find any event mentioning "GruntHTTP.exe" or "SimpleInjection.dll" to start
[?2004l[?2004h> initial_event_ids = set()
[?2004l[?2004h> initial_guids = set()
[?2004l[?2004h> 
[?2004l[?2004h> for ev in all_events:
[?2004l[?2004h>     msg = ev['message'] or ''
[?2004l[?2004h>     cmd = ev['command_line'] or ''
[?2004l[?2004h>     img = ev['image'] or ''
[?2004l[?2004h>     pimg = ev['parent_image'] or ''
[?2004l[?2004h>     
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     if 'GruntHTTP' in img or 'GruntHTTP' in pimg or 'GruntHTTP' in cmd or 'GruntHTTP' in msg:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     if 'SimpleInjection' in cmd or 'SimpleInjection' in msg:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         initial_event_ids.add(ev['event_id'])
[?2004l[?2004h>         if ev['process_guid']:
[?2004l[?2004h>             initial_guids.add(ev['process_guid'])
[?2004l[?2004h>         if ev['parent_process_guid']:
[?2004l[?2004h>             initial_guids.add(ev['parent_process_guid'])
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Initial malicious event IDs (based on strings): {len(initial_event_ids)}")
[?2004l[?2004h> print(f"Initial malicious GUIDs: {initial_guids}")
[?2004l[?2004h> 
[?2004l[?2004h> # Now, let's recursively trace process GUIDs
[?2004l[?2004h> malicious_guids = set(initial_guids)
[?2004l[?2004h> prev_len = 0
[?2004l[?2004h> while len(malicious_guids) > prev_len:
[?2004l[?2004h>     prev_len = len(malicious_guids)
[?2004l[?2004h>     for ev in all_events:
[?2004l[?2004h>         # If the event's process_guid or parent_process_guid is in malicious_guids,
[?2004l[?2004h>         # add both of them to the set
[?2004l[?2004h>         pg = ev['process_guid']
[?2004l[?2004h>         ppg = ev['parent_process_guid']
[?2004l[?2004h>         if pg in malicious_guids or ppg in malicious_guids:
[?2004l[?2004h>             if pg:
[?2004l[?2004h>                 malicious_guids.add(pg)
[?2004l[?2004h>             if ppg:
[?2004l[?2004h>                 malicious_guids.add(ppg)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Traced to {len(malicious_guids)} malicious process GUIDs.")
[?2004l[?2004h> 
[?2004l[?2004h> # Now, gather all event IDs associated with these malicious GUIDs
[?2004l[?2004h> malicious_event_ids = set(initial_event_ids)
[?2004l[?2004h> for ev in all_events:
[?2004l[?2004h>     pg = ev['process_guid']
[?2004l[?2004h>     ppg = ev['parent_process_guid']
[?2004l[?2004h>     if pg in malicious_guids or ppg in malicious_guids:
