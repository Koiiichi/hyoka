[57.946529, "i", "cat << 'EOF' > /tmp/explore_access.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Event 10 Source & Target Processes ===\")\ncursor.execute(\"\"\"\n    SELECT host, image, target_image, COUNT(*) \n    FROM events \n    WHERE event_code = 10 \n    GROUP BY host, image, target_image\n\"\"\")\nfor r in cursor.fetchall():\n    print(dict(r))\nEOF\npython3 /tmp/explore_access.py\n"]
