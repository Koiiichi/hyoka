[136.688974, "i", "cat << 'EOF' > /tmp/check_unmatched_details.py\nimport sqlite3\nimport json\n\nwith open('/tmp/correlated_malicious_events.json') as f:\n    malicious_ids = set(json.load(f))\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example'\")\nall_ws05 = [dict(r) for r in cursor.fetchall()]\n\nunmatched = [r for r in all_ws05 if r['event_id'] not in malicious_ids]\n\nfor r in unmatched:\n    code = r['event_code']\n    img = r['image'] or ''\n    # Check security events, 7040, empty image events\n    if code in (7040, 11, 10) and img == '':\n        print(f\"=== {r['event_id']} (Code {code}) ===\")\n        print(r['message'])\n        print(\"\\n\")\n    elif code in (4656, 4658, 4663, 4673, 4690, 4703):\n        # Print a short summary of security events\n        msg = r['message'] or ''\n        # Extract process name and target object if possible\n        import re\n        proc = re.search(r'Process Name:\\s*(.+)', msg)\n        obj = re.search(r'Object Name:\\s*(.+)', msg)\n        proc_str = proc.group(1).strip() if proc else 'unknown'\n        obj_str = obj.group(1).strip() if obj else 'unknown'\n        print(f\"=== {r['event_id']} (Code {code}) === Proc: {proc_str} | Obj: {obj_str}\")\n\nEOF\npython3 /tmp/check_unmatched_details.py\n"]
