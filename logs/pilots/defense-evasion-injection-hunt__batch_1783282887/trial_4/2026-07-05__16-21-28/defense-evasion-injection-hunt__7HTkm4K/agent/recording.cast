[45.178647, "i", "cat << 'EOF' > /tmp/explore_lateral.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Sysmon 11 (FileCreate) on DC01 and WS-06 ===\")\ncursor.execute(\"SELECT event_id, host, timestamp, user, image, target_object, details FROM events WHERE event_code = 11 AND host != 'WS-05.corp.example'\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nprint(\"\\n=== Sysmon 12/13 (Registry) on DC01 and WS-06 ===\")\ncursor.execute(\"SELECT event_id, host, timestamp, event_code, image, target_object, details FROM events WHERE event_code IN (12, 13) AND host != 'WS-05.corp.example'\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nprint(\"\\n=== Sysmon 3 (Network) on DC01 and WS-06 ===\")\ncursor.execute(\"SELECT event_id, host, timestamp, image, src_ip, dst_ip, dst_port, details, message FROM events WHERE event_code = 3 AND host != 'WS-05.corp.example'\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nprint(\"\\n=== Security 5140/5145 on DC01 ===\")\ncursor.execute(\"SELECT event_id, host, timestamp, user, target_user, service_name, details, message FROM events WHERE event_code IN (5140, 5145)\")\nfor r in cursor.fetchall():\n    print(dict(r))\nEOF\npython3 /tmp/explore_lateral.py\n"]
