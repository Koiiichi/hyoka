[121.502619, "i", "sqlite3 /root/data/eventlogs.db \"SELECT event_id, host, event_code, message FROM events WHERE host != 'WS-05.corp.example' AND (message LIKE '%10.10.10.5%' OR message LIKE '%SimpleInjection%' OR message LIKE '%Grunt%');\"\n"]
[121.503318, "o", "sqlite3 /root/data/eventlogs.db \"SELECT event_id, host, event_code, message FROM events WHERE host != 'WS-05.corp.example' AND (message LIKE '%10.10.10.5%' OR message LIKE '%SimpleInjection%' OR message LIKE '%Grunt%');\"\r\n\u001b[?2004l\r"]
[121.507317, "o", "\u001b[?2004hroot@7db012086c2c:~# "]
[130.42088, "i", "cat << 'EOF' > /tmp/unmatched_ws05.py\nimport sqlite3\nimport json\n\nwith open('/tmp/correlated_malicious_events.json') as f:\n    malicious_ids = set(json.load(f))\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example'\")\nall_ws05 = [dict(r) for r in cursor.fetchall()]\n\nunmatched = [r for r in all_ws05 if r['event_id'] not in malicious_ids]\nprint(f\"Total WS-05 events: {len(all_ws05)}\")\nprint(f\"Matched: {len(malicious_ids)}\")\nprint(f\"Unmatched: {len(unmatched)}\")\n\nfrom collections import Counter\ncounts = Counter()\nfor r in unmatched:\n    counts[(r['event_code'], r['image'] or '')] += 1\n\nprint(\"\\n=== Unmatched WS-05 Events by Code and Image ===\")\nfor k, v in sorted(counts.items()):\n    print(f\"Code: {k[0]} | Image: {k[1]} | Count: {v}\")\n\nEOF\npython3 /tmp/unmatched_ws05.py\n"]
