[39.659173, "i", "cat << 'EOF' > /tmp/explore2.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT host, event_code, COUNT(*) as cnt FROM events GROUP BY host, event_code ORDER BY host, cnt DESC\")\nfor row in cursor.fetchall():\n    print(f\"{row['host']} | Code {row['event_code']} | Count: {row['cnt']}\")\nEOF\npython3 /tmp/explore2.py\n"]
