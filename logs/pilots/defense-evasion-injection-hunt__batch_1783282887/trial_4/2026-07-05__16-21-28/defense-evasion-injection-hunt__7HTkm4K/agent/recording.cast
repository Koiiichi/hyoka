[31.209669, "o", "\u001b[?2004hroot@7db012086c2c:~# "]
[36.007002, "i", "cat << 'EOF' > /tmp/explore.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events ORDER BY timestamp\")\nall_events = [dict(r) for r in cursor.fetchall()]\n\nprint(f\"Loaded {len(all_events)} events.\")\n\n# Group events by host\nby_host = {}\nfor ev in all_events:\n    h = ev['host']\n    if h not in by_host:\n        by_host[h] = []\n    by_host[h].append(ev)\n\nfor host, evs in by_host.items():\n    print(f\"\\n=== {host} ({len(evs)} events) ===\")\n    # Print process creations and their context\n    for ev in evs:\n        code = ev['event_code']\n        if code in (1, 4688):\n            print(f\"[{ev['timestamp']}] PID_CREATE {code}: {ev['user']} | {ev['image']} | {ev['command_line']} (Parent: {ev['parent_image']}) ID: {ev['event_id']}\")\n\nEOF\npython3 /tmp/explore.py\n"]
[36.007391, "o", "cat << 'EOF' > /tmp/explore.py\r\n\u001b[?2004l\r"]
