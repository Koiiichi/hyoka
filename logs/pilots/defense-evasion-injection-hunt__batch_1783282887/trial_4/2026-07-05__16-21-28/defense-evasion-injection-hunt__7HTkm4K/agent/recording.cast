[115.814769, "o", "> "]
[115.814906, "o", "    if 'SimpleInjection' in cmd or 'SimpleInjection' in msg:\r\n\u001b[?2004l\r\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if is_malicious:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.815027, "o", "        if ev['process_guid']:\r\n\u001b[?2004l\r"]
[115.815051, "o", "\u001b[?2004h> "]
[115.815193, "o", "            malicious_guids.add(ev['process_guid'])\r\n\u001b[?2004l\r\u001b[?2004h>         if ev['parent_process_guid']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.815315, "o", "            malicious_guids.add(ev['parent_process_guid'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Trace GUIDs recursively\r\n\u001b[?2004l\r\u001b[?2004h> prev_len = 0\r\n\u001b[?2004l\r"]
[115.815408, "o", "\u001b[?2004h> while len(malicious_guids) > prev_len:\r\n\u001b[?2004l\r"]
[115.815458, "o", "\u001b[?2004h>     prev_len = len(malicious_guids)\r\n\u001b[?2004l\r"]
[115.815525, "o", "\u001b[?2004h>     for ev in all_events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.815603, "o", "        pg = ev['process_guid']\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.815625, "o", "> "]
[115.815734, "o", "        ppg = ev['parent_process_guid']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.815843, "o", "        if pg in malicious_guids or ppg in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.815861, "o", "            if pg:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.815937, "o", "                malicious_guids.add(pg)\r\n\u001b[?2004l\r\u001b[?2004h>             if ppg:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.815994, "o", "                malicious_guids.add(ppg)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.816026, "o", "# Extract PIDs for these GUIDs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.81614, "o", "for ev in all_events:\r\n\u001b[?2004l\r"]
[115.816192, "o", "\u001b[?2004h>     pg = ev['process_guid']\r\n\u001b[?2004l\r"]
[115.816242, "o", "\u001b[?2004h> "]
[115.816356, "o", "    if pg in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.816499, "o", "        # Let's extract PID from message or details if possible, or use Event 1/4688\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.816649, "o", "        # Event 1 usually has PID inside the message, let's parse it\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.81673, "o", "        # Or we can just look for standard fields. Since the schema doesn't have a direct 'pid' column, \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.816836, "o", "        # let's parse PID from the message field using regex\r\n\u001b[?2004l\r\u001b[?2004h>         msg = ev['message'] or ''\r\n\u001b[?2004l\r"]
[115.816855, "o", "\u001b[?2004h>         m = re.search(r'ProcessId:\\s*(\\d+)', msg, re.IGNORECASE)"]
[115.816865, "o", "\r\n\u001b[?2004l\r"]
[115.816998, "o", "\u001b[?2004h>         if m:\r\n\u001b[?2004l\r\u001b[?2004h>             pid_dec = int(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.817108, "o", "            host = ev['host']\r\n\u001b[?2004l\r\u001b[?2004h>             img = ev['image'] or ev['target_image'] or 'unknown'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.817273, "o", "            malicious_pids[(host, pid_dec)] = img\r\n\u001b[?2004l\r\u001b[?2004h>             malicious_pids_hex[(host, f\"0x{pid_dec:x}\")] = img\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.817298, "o", "            malicious_pids_hex[(host, f\"0x{pid_dec:X}\")] = img\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.817421, "o", "print(f\"Traced GUIDs: {len(malicious_guids)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.817448, "o", "> "]
[115.817642, "o", "print(f\"Traced PIDs (Dec): {malicious_pids}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Traced PIDs (Hex): {malicious_pids_hex}\")\r\n\u001b[?2004l\r"]
[115.817675, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.817845, "o", "# Now, let's find ALL events that contain these PIDs (hex or dec) or GUIDs or malicious process names on the specific hosts\r\n\u001b[?2004l\r\u001b[?2004h> malicious_event_ids = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.817928, "o", "\u001b[?2004h> for ev in all_events:\r\n\u001b[?2004l\r\u001b[?2004h>     host = ev['host']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.817942, "o", "    msg = ev['message'] or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.818, "o", "    eid = ev['event_id']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.818113, "o", "    # Check GUIDs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.818213, "o", "    if ev['process_guid'] in malicious_guids or ev['parent_process_guid'] in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_event_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.818268, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # Check Decimal PIDs in message\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.818378, "o", ">     for (h, pdec), img in malicious_pids.items():\r\n\u001b[?2004l\r\u001b[?2004h>         if host == h:\r\n"]
[115.818499, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[115.818631, "o", "            # look for Process ID: <pid> or ProcessId: <pid>\r\n\u001b[?2004l\r\u001b[?2004h>             if re.search(r'Process\\s*Id:\\s*' + str(pdec) + r'\\b', msg, re.IGNORECASE):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.818711, "o", "                malicious_event_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.818838, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h>     # Check Hex PIDs in message\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.8189, "o", "    for (h, phex), img in malicious_pids_hex.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.818939, "o", "        if host == h:\r\n\u001b[?2004l\r\u001b[?2004h>             # look for Process ID: 0x... or ProcessId: 0x...\r\n\u001b[?2004l\r"]
[115.818958, "o", "\u001b[?2004h"]
[115.819102, "o", "> "]
[115.819156, "o", "            if re.search(r'Process\\s*Id:\\s*' + phex + r'\\b', msg, re.IGNORECASE):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.819179, "o", "                malicious_event_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.819281, "o", "                break\r\n\u001b[?2004l\r"]
[115.819337, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.819382, "o", "print(f\"Total correlated malicious events: {len(malicious_event_ids)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.819483, "o", "# Let's count them by host, code\r\n\u001b[?2004l\r\u001b[?2004h> counts = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.819658, "o", "for ev in all_events:\r\n\u001b[?2004l\r\u001b[?2004h>     if ev['event_id'] in malicious_event_ids:"]
[115.819718, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.819736, "o", "        key = (ev['host'], ev['event_code'])\r\n\u001b[?2004l\r"]
[115.819815, "o", "\u001b[?2004h> "]
[115.819947, "o", "        counts[key] = counts.get(key, 0) + 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for k, v in sorted(counts.items()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.820076, "o", "    print(f\"{k[0]} | Code {k[1]} | Count: {v}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's save them to a json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.820257, "o", "with open('/tmp/correlated_malicious_events.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.820283, "o", "    json.dump(sorted(list(malicious_event_ids)), f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[115.821039, "o", "\u001b[?2004hroot@7db012086c2c:~# "]
[115.821059, "o", "python3 /tmp/correlate_pids.py\r\n\u001b[?2004l\r"]
