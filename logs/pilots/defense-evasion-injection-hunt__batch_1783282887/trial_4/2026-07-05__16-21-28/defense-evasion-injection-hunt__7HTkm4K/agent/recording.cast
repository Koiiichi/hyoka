[115.812123, "i", "cat << 'EOF' > /tmp/correlate_pids.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events\")\nall_events = [dict(r) for r in cursor.fetchall()]\n\n# 1. Identify the core malicious processes from Sysmon process creations/events\n# Let's track their process_guid, PID (decimal), and host\nmalicious_pids = {}  # (host, pid_dec) -> process_name\nmalicious_pids_hex = {}  # (host, pid_hex) -> process_name\nmalicious_guids = set()\n\n# We start with known malicious processes/files\nfor ev in all_events:\n    msg = ev['message'] or ''\n    cmd = ev['command_line'] or ''\n    img = ev['image'] or ''\n    pimg = ev['parent_image'] or ''\n    \n    is_malicious = False\n    if 'GruntHTTP' in img or 'GruntHTTP' in pimg or 'GruntHTTP' in cmd or 'GruntHTTP' in msg:\n        is_malicious = True\n    if 'SimpleInjection' in cmd or 'SimpleInjection' in msg:\n        is_malicious = True\n    \n    if is_malicious:\n        if ev['process_guid']:\n            malicious_guids.add(ev['process_guid'])\n        if ev['parent_process_guid']:\n            malicious_guids.add(ev['parent_process_guid'])\n\n# Trace GUIDs recursively\nprev_len = 0\nwhile len(malicious_guids) > prev_len:\n    prev_len = len(malicious_guids)\n    for ev in all_events:\n        pg = ev['process_guid']\n        ppg = ev['parent_process_guid']\n        if pg in malicious_guids or ppg in malicious_guids:\n            if pg:\n                malicious_guids.add(pg)\n            if ppg:\n                malicious_guids.add(ppg)\n\n# Extract PIDs for these GUIDs\nfor ev in all_events:\n    pg = ev['process_guid']\n    if pg in malicious_guids:\n        # Let's extract PID from message or details if possible, or use Event 1/4688\n        # Event 1 usually has PID inside the message, let's parse it\n        # Or we can just look for standard fields. Since the schema doesn't have a direct 'pid' column, \n        # let's parse PID from the message field using regex\n        msg = ev['message'] or ''\n        m = re.search(r'ProcessId:\\s*(\\d+)', msg, re.IGNORECASE)\n        if m:\n            pid_dec = int(m.group(1))\n            host = ev['host']\n            img = ev['image'] or ev['target_image'] or 'unknown'\n            malicious_pids[(host, pid_dec)] = img\n            malicious_pids_hex[(host, f\"0x{pid_dec:x}\")] = img\n            malicious_pids_hex[(host, f\"0x{pid_dec:X}\")] = img\n\nprint(f\"Traced GUIDs: {len(malicious_guids)}\")\nprint(f\"Traced PIDs (Dec): {malicious_pids}\")\nprint(f\"Traced PIDs (Hex): {malicious_pids_hex}\")\n\n# Now, let's find ALL events that contain these PIDs (hex or dec) or GUIDs or malicious process names on the specific hosts\nmalicious_event_ids = set()\n\nfor ev in all_events:\n    host = ev['host']\n    msg = ev['message'] or ''\n    eid = ev['event_id']\n    \n    # Check GUIDs\n    if ev['process_guid'] in malicious_guids or ev['parent_process_guid'] in malicious_guids:\n        malicious_event_ids.add(eid)\n        continue\n        \n    # Check Decimal PIDs in message\n    for (h, pdec), img in malicious_pids.items():\n        if host == h:\n            # look for Process ID: <pid> or ProcessId: <pid>\n            if re.search(r'Process\\s*Id:\\s*' + str(pdec) + r'\\b', msg, re.IGNORECASE):\n                malicious_event_ids.add(eid)\n                break\n                \n    # Check Hex PIDs in message\n    for (h, phex), img in malicious_pids_hex.items():\n        if host == h:\n            # look for Process ID: 0x... or ProcessId: 0x...\n            if re.search(r'Process\\s*Id:\\s*' + phex + r'\\b', msg, re.IGNORECASE):\n                malicious_event_ids.add(eid)\n                break\n\nprint(f\"Total correlated malicious events: {len(malicious_event_ids)}\")\n\n# Let's count them by host, code\ncounts = {}\nfor ev in all_events:\n    if ev['event_id'] in malicious_event_ids:\n        key = (ev['host'], ev['event_code'])\n        counts[key] = counts.get(key, 0) + 1\n\nfor k, v in sorted(counts.items()):\n    print(f\"{k[0]} | Code {k[1]} | Count: {v}\")\n\n# Let's save them to a json\nwith open('/tmp/correlated_m"]
[115.812351, "i", "alicious_events.json', 'w') as f:\n    json.dump(sorted(list(malicious_event_ids)), f, indent=2)\n\nEOF\npython3 /tmp/correlate_pids.py\n"]
