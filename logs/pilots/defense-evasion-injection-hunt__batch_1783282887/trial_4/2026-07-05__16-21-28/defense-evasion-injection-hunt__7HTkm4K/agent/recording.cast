[147.148233, "i", "cat << 'EOF' > /tmp/inspect_event_types.py\nimport sqlite3\nimport json\n\nwith open('/tmp/correlated_malicious_events.json') as f:\n    malicious_ids = set(json.load(f))\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events\")\nall_events = [dict(r) for r in cursor.fetchall()]\n\n# Let's see details of matched events for Code 10, 12, 13, 17, 18, 4656, 4658, 4663, 4690\nmatched_by_code = {}\nfor ev in all_events:\n    if ev['event_id'] in malicious_ids:\n        c = ev['event_code']\n        if c not in matched_by_code:\n            matched_by_code[c] = []\n        matched_by_code[c].append(ev)\n\nfor code in sorted(matched_by_code.keys()):\n    evs = matched_by_code[code]\n    print(f\"\\n=== Code {code} (Count: {len(evs)}) ===\")\n    # Print up to 5 examples of each\n    for ev in evs[:5]:\n        print(f\"{ev['event_id']} | {ev['host']} | {ev['image'] or ev['provider']} | {ev['message'].split('\\n')[0]}\")\n\nEOF\npython3 /tmp/inspect_event_types.py\n"]
