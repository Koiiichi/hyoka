[98.392073, "i", "cat << 'EOF' > /tmp/check_untraced.py\nimport sqlite3\nimport json\n\n# Load matched event IDs\nwith open('/tmp/traced_malicious_events.json') as f:\n    malicious_event_ids = set(json.load(f))\n\n# Add the two newly found WFP events\nmalicious_event_ids.add('evt-00839')\nmalicious_event_ids.add('evt-00840')\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Query events on WS-05 in the timeframe\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND timestamp BETWEEN '2026-05-06T00:01:45Z' AND '2026-05-06T00:02:05Z'\n    ORDER BY timestamp\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total events on WS-05 in timeframe: {len(rows)}\")\n\nuntraced = []\nfor r in rows:\n    eid = r['event_id']\n    if eid not in malicious_event_ids:\n        untraced.append(r)\n\nprint(f\"Untraced events: {len(untraced)}\")\nfor u in untraced:\n    print(f\"{u['event_id']} | Code {u['event_code']} | {u['timestamp']} | {u['image']} | {u['user']} | {u['message'].split('\\n')[0] if u['message'] else ''}\")\n\nEOF\npython3 /tmp/check_untraced.py\n"]
