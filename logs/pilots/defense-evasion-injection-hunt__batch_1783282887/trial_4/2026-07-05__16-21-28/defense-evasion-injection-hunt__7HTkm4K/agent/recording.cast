[103.748072, "i", "cat << 'EOF' > /tmp/analyze_untraced_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\neids = [\n    'evt-00856', 'evt-00857', 'evt-00861', 'evt-00862', 'evt-00890', 'evt-00891',\n    # Also, let's grab some of the 4656/4663/4690/4658 events to see what they are targeting\n    'evt-00810', 'evt-00811', 'evt-00812', 'evt-00813', 'evt-00832', 'evt-00833'\n]\n\nfor eid in eids:\n    cursor.execute(\"SELECT event_id, event_code, message FROM events WHERE event_id = ?\", (eid,))\n    r = cursor.fetchone()\n    if r:\n        print(f\"=== {r['event_id']} (Code {r['event_code']}) ===\")\n        print(r['message'])\n        print(\"\\n\")\n\nEOF\npython3 /tmp/analyze_untraced_details.py\n"]
