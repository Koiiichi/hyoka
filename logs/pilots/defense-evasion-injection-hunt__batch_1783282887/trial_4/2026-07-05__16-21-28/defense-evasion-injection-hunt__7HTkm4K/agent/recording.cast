[73.844495, "o", "\u001b[?2004hroot@7db012086c2c:~# "]
[84.255098, "i", "cat << 'EOF' > /tmp/trace_guids.py\nimport sqlite3\nimport json\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events\")\nall_events = [dict(r) for r in cursor.fetchall()]\n\ninitial_event_ids = set()\ninitial_guids = set()\n\nfor ev in all_events:\n    msg = ev['message'] or ''\n    cmd = ev['command_line'] or ''\n    img = ev['image'] or ''\n    pimg = ev['parent_image'] or ''\n    \n    is_malicious = False\n    if 'GruntHTTP' in img or 'GruntHTTP' in pimg or 'GruntHTTP' in cmd or 'GruntHTTP' in msg:\n        is_malicious = True\n    if 'SimpleInjection' in cmd or 'SimpleInjection' in msg:\n        is_malicious = True\n    \n    if is_malicious:\n        initial_event_ids.add(ev['event_id'])\n        if ev['process_guid']:\n            initial_guids.add(ev['process_guid'])\n        if ev['parent_process_guid']:\n            initial_guids.add(ev['parent_process_guid'])\n\nmalicious_guids = set(initial_guids)\nprev_len = 0\nwhile len(malicious_guids) > prev_len:\n    prev_len = len(malicious_guids)\n    for ev in all_events:\n        pg = ev['process_guid']\n        ppg = ev['parent_process_guid']\n        if pg in malicious_guids or ppg in malicious_guids:\n            if pg:\n                malicious_guids.add(pg)\n            if ppg:\n                malicious_guids.add(ppg)\n\nmalicious_event_ids = set(initial_event_ids)\nfor ev in all_events:\n    pg = ev['process_guid']\n    ppg = ev['parent_process_guid']\n    if pg in malicious_guids or ppg in malicious_guids:\n        malicious_event_ids.add(ev['event_id'])\n\n# Let's inspect specific events:\nprint(\"=== Sysmon 11 File Create ===\")\nfor ev in all_events:\n    if ev['event_id'] in malicious_event_ids and ev['event_code'] == 11:\n         print(ev['event_id'], ev['timestamp'], ev['image'], ev['target_object'], ev['message'])\n\nprint(\"=== Sysmon 3 (Network) or 22 (DNS) ===\")\nfor ev in all_events:\n    if ev['event_id'] in malicious_event_ids and ev['event_code'] in (3, 22):\n         print(ev['event_id'], ev['timestamp'], ev['image'], ev['message'])\n\n# Let's write the JSON list properly\nwith open('/tmp/traced_malicious_events.json', 'w') as f:\n    json.dump(sorted(list(malicious_event_ids)), f, indent=2)\n\nEOF\npython3 /tmp/trace_guids.py\n"]
