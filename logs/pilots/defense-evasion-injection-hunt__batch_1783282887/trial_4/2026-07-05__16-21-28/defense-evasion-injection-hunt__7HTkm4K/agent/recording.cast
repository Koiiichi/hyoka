[45.19198, "o", "\u001b[?2004hroot@7db012086c2c:~# "]
[51.337659, "i", "cat << 'EOF' > /tmp/explore_lateral.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's see if there are any Sysmon 11 (File Create) events on DC01 or WS-06 that aren't typical\nprint(\"=== Non-standard Sysmon 11 (File Create) on DC01 or WS-06 ===\")\ncursor.execute(\"\"\"\n    SELECT event_id, host, timestamp, user, image, target_object, details, message \n    FROM events \n    WHERE event_code = 11 AND host != 'WS-05.corp.example'\n\"\"\")\nfor r in cursor.fetchall():\n    tgt = str(r['target_object']) or ''\n    img = str(r['image']) or ''\n    # filter out some extremely standard ones if any\n    print(f\"{r['event_id']} | {r['host']} | {r['timestamp']} | {img} created {tgt}\")\n\nprint(\"\\n=== Sysmon 12/13 (Registry) on DC01 or WS-06 (non-standard) ===\")\ncursor.execute(\"\"\"\n    SELECT event_id, host, timestamp, event_code, image, target_object, details \n    FROM events \n    WHERE event_code IN (12, 13) AND host != 'WS-05.corp.example'\n\"\"\")\nfor r in cursor.fetchall():\n    tgt = str(r['target_object']) or ''\n    img = str(r['image']) or ''\n    # Only print things that aren't typical system registry keys if possible, or just print everything since it's small\n    if 'HKLM\\\\System\\\\CurrentControlSet\\\\Services\\\\bam' in tgt or 'Run' in tgt or 'Services' in tgt:\n        print(f\"{r['event_id']} | {r['host']} | {r['timestamp']} | {r['event_code']} | {img} modified {tgt}\")\n    else:\n        # Let's print others too\n        print(f\"{r['event_id']} | {r['host']} | {r['timestamp']} | {r['event_code']} | {img} -> {tgt} ({r['details']})\")\n\nEOF\npython3 /tmp/explore_lateral.py\n"]
