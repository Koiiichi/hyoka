[73.820741, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> all_events = [dict(r) for r in cursor.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's find any event mentioning \"GruntHTTP.exe\" or \"SimpleInjection.dll\" to start\r\n\u001b[?2004l\r\u001b[?2004h> initial_event_ids = set()\r\n\u001b[?2004l\r\u001b[?2004h> initial_guids = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for ev in all_events:\r\n\u001b[?2004l\r\u001b[?2004h>     msg = ev['message'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = ev['command_line'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     img = ev['image'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     pimg = ev['parent_image'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     is_malicious = False\r\n\u001b[?2004l\r\u001b[?2004h>     if 'GruntHTTP' in img or 'GruntHTTP' in pimg or 'GruntHTTP' in cmd or 'GruntHTTP' in msg:\r\n\u001b[?2004l\r\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>     if 'SimpleInjection' in cmd or 'SimpleInjection' in msg:\r\n\u001b[?2004l\r\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if is_malicious:\r\n\u001b[?2004l\r\u001b[?2004h>         initial_event_ids.add(ev['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h>         if ev['process_guid']:\r\n\u001b[?2004l\r\u001b[?2004h>             initial_guids.add(ev['process_guid'])\r\n\u001b[?2004l\r\u001b[?2004h>         if ev['parent_process_guid']:\r\n\u001b[?2004l\r\u001b[?2004h>             initial_guids.add(ev['parent_process_guid'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Recursively trace process GUIDs\r\n\u001b[?2004l\r\u001b[?2004h> malicious_guids = set(initial_guids)\r\n\u001b[?2004l\r\u001b[?2004h> prev_len = 0\r\n\u001b[?2004l\r\u001b[?2004h> while len(malicious_guids) > prev_len:\r\n\u001b[?2004l\r\u001b[?2004h>     prev_len = len(malicious_guids)\r\n\u001b[?2004l\r\u001b[?2004h>     for ev in all_events:\r\n\u001b[?2004l\r\u001b[?2004h>         pg = ev['process_guid']\r\n\u001b[?2004l\r\u001b[?2004h>         ppg = ev['parent_process_guid']\r\n\u001b[?2004l\r\u001b[?2004h>         if pg in malicious_guids or ppg in malicious_guids:\r\n\u001b[?2004l\r"]
[73.820813, "o", "\u001b[?2004h> "]
[73.820941, "o", "            if pg:\r\n\u001b[?2004l\r\u001b[?2004h>                 malicious_guids.add(pg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.820979, "o", "            if ppg:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.82118, "o", "                malicious_guids.add(ppg)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Gather all event IDs associated with these malicious GUIDs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.821318, "o", "malicious_event_ids = set(initial_event_ids)\r\n\u001b[?2004l\r\u001b[?2004h> for ev in all_events:\r\n\u001b[?2004l\r\u001b[?2004h>     pg = ev['process_guid']"]
[73.821519, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.821595, "o", "    ppg = ev['parent_process_guid']\r\n\u001b[?2004l\r\u001b[?2004h>     if pg in malicious_guids or ppg in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.821769, "o", "        malicious_event_ids.add(ev['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.821802, "o", "print(f\"Total unique malicious events: {len(malicious_event_ids)}\")\r\n\u001b[?2004l\r"]
[73.821892, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.821929, "o", "# Group and count by host, event_code, image\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.822103, "o", "from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.822141, "o", "counts = Counter()\r\n\u001b[?2004l\r\u001b[?2004h> for ev in all_events:\r\n\u001b[?2004l\r"]
[73.822211, "o", "\u001b[?2004h> "]
[73.822331, "o", "    if ev['event_id'] in malicious_event_ids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.822367, "o", "        counts[(ev['host'], ev['event_code'], ev['image'])] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.822509, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.822692, "o", "print(\"=== Malicious Event Counts ===\")\r\n\u001b[?2004l\r\u001b[?2004h> for k, v in sorted(counts.items()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.822723, "o", "    print(f\"Host: {k[0]} | Code: {k[1]} | Image: {k[2]} | Count: {v}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.822882, "o", "# Also let's write all malicious event IDs sorted to a JSON format\r\n\u001b[?2004l\r\u001b[?2004h> with open('/tmp/traced_malicious_events.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.822914, "o", "    json.dump(sorted(list(malicious_event_ids)), f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
