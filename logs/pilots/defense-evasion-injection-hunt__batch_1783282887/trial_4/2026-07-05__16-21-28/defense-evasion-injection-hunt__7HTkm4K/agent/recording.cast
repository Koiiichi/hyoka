vchost.exe', 'target_image': 'C:\\\\windows\\\\system32\\\\conhost.exe', 'COUNT(*)': 1}\r\n{'host': 'WS-05.corp.example', 'image': 'C:\\\\windows\\\\system32\\\\svchost.exe', 'target_image': 'C:\\\\windows\\\\system32\\\\sihost.exe', 'COUNT(*)': 2}\r\n{'host': 'WS-05.corp.example', 'image': 'C:\\\\windows\\\\system32\\\\svchost.exe', 'target_image': 'c:\\\\windows\\\\system32\\\\notepad.exe', 'COUNT(*)': 4}\r\n{'host': 'WS-06.corp.example', 'image': 'C:\\\\windows\\\\system32\\\\svchost.exe', 'target_image': 'C:\\\\windows\\\\System32\\\\svchost.exe', 'COUNT(*)': 37}\r\n{'host': 'WS-06.corp.example', 'image': 'C:\\\\windows\\\\system32\\\\svchost.exe', 'target_image': 'C:\\\\windows\\\\system32\\\\svchost.exe', 'COUNT(*)': 28}\r\n"]
[57.965075, "o", "\u001b[?2004hroot@7db012086c2c:~# "]
[66.80261, "i", "cat << 'EOF' > /tmp/trace_guids.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events\")\nall_events = [dict(r) for r in cursor.fetchall()]\n\n# Let's find any event mentioning \"GruntHTTP.exe\" or \"SimpleInjection.dll\" to start\ninitial_event_ids = set()\ninitial_guids = set()\n\nfor ev in all_events:\n    msg = ev['message'] or ''\n    cmd = ev['command_line'] or ''\n    img = ev['image'] or ''\n    pimg = ev['parent_image'] or ''\n    \n    is_malicious = False\n    if 'GruntHTTP' in img or 'GruntHTTP' in pimg or 'GruntHTTP' in cmd or 'GruntHTTP' in msg:\n        is_malicious = True\n    if 'SimpleInjection' in cmd or 'SimpleInjection' in msg:\n        is_malicious = True\n    \n    if is_malicious:\n        initial_event_ids.add(ev['event_id'])\n        if ev['process_guid']:\n            initial_guids.add(ev['process_guid'])\n        if ev['parent_process_guid']:\n            initial_guids.add(ev['parent_process_guid'])\n\nprint(f\"Initial malicious event IDs (based on strings): {len(initial_event_ids)}\")\nprint(f\"Initial malicious GUIDs: {initial_guids}\")\n\n# Now, let's recursively trace process GUIDs\nmalicious_guids = set(initial_guids)\nprev_len = 0\nwhile len(malicious_guids) > prev_len:\n    prev_len = len(malicious_guids)\n    for ev in all_events:\n        # If the event's process_guid or parent_process_guid is in malicious_guids,\n        # add both of them to the set\n        pg = ev['process_guid']\n        ppg = ev['parent_process_guid']\n        if pg in malicious_guids or ppg in malicious_guids:\n            if pg:\n                malicious_guids.add(pg)\n            if ppg:\n                malicious_guids.add(ppg)\n\nprint(f\"Traced to {len(malicious_guids)} malicious process GUIDs.\")\n\n# Now, gather all event IDs associated with these malicious GUIDs\nmalicious_event_ids = set(initial_event_ids)\nfor ev in all_events:\n    pg = ev['process_guid']\n    ppg = ev['parent_process_guid']\n    if pg in malicious_guids or ppg in malicious_guids:\n        malicious_event_ids.add(ev['event_id'])\n        \nprint(f\"Total events associated with malicious GUIDs: {len(malicious_event_ids)}\")\nfor ev in sorted(all_events, key=lambda x: x['timestamp']):\n    if ev['event_id'] in malicious_event_ids:\n        print(f\"{ev['event_id']} | {ev['timestamp']} | Code {ev['event_code']} | Host {ev['host']} | User {ev['user']} | Image: {ev['image']} | Parent: {ev['parent_image']} | CMD: {ev['command_line']} | TargetImg: {ev['target_image']} | TargetObj: {ev['target_object']}\")\n\nEOF\npython3 /tmp/trace_guids.py\n"]
