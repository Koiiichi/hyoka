for evt in all_events:\n    mal, reason = is_malicious(evt)\n    if mal:\n        malicious_ids.add(evt[\'event_id\'])\n\nprint(f"Pass 1: Flagged {len(malicious_ids)} malicious events")\n\n# Let\'s inspect what is NOT flagged as malicious\nbenign_events = [e for e in all_events if e[\'event_id\'] not in malicious_ids]\nprint(f"Pass 1: Remaining {len(benign_events)} events")\n\n# Let\'s print out remaining events in detail grouped by Host and Event Code\nfrom collections import defaultdict\nby_group = defaultdict(list)\nfor e in benign_events:\n    by_group[(e[\'host\'], e[\'event_code\'])].append(e)\n\nfor k, evts in sorted(by_group.items()):\n    print(f"\\nGroup: Host={k[0]}, EventCode={k[1]} (Count: {len(evts)})")\n    # Print first 5 events in each group\n    for e in evts[:5]:\n        print(f"  {e[\'event_id\']} | User: {e[\'user\']} | Image: {e[\'image\']} | Message: {e[\'message\'][:150].replace(\'\\r\\n\', \' \').replace(\'\\n\', \' \')}")\n    if len(evts) > 5:\n        print(f"  ... and {len(evts)-5} more")\n\nEOF\npython3 /tmp/classify_all.py > /tmp/classification_report.txt\nhead -n 50 /tmp/classification_report.txt\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
