[?2004l[?2004h>     if 'ca33ee8b-7d2f-4343-83bb-33cd9ad23223' in msg:
[?2004l[?2004h>         malicious_ids.add(evt_id)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 4. Any event with C2 IP address 10.10.10.5
[?2004l[?2004h>     if '10.10.10.5' in msg:
