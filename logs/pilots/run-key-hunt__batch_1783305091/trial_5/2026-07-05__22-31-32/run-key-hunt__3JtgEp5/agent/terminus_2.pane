[?2004hroot@52ac26b4f854:~# cat << 'EOF' > /tmp/classify_all.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> all_events = []
[?2004l[?2004h> for r in cur.execute("SELECT * FROM events ORDER BY timestamp ASC, event_id ASC"):
[?2004l[?2004h>     all_events.append(dict(r))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Loaded {len(all_events)} events")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's define rules for maliciousness
[?2004l[?2004h> # Any event with our known malicious process_guid
[?2004l[?2004h> malicious_guids = {'{b59756a9-b239-5f17-5307-000000000400}'}
[?2004l[?2004h> # Let's expand malicious guids automatically if we see them in malicious events
[?2004l[?2004h> # But we can also look at other indicators
[?2004l[?2004h> 
[?2004l[?2004h> malicious_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> def is_malicious(evt):
[?2004l[?2004h>     msg = evt['message'] or ''
[?2004l[?2004h>     # 1. Guid matches
[?2004l[?2004h>     if evt['process_guid'] in malicious_guids:
[?2004l[?2004h>         return True, "guid_match"
[?2004l[?2004h>     for g in malicious_guids:
[?2004l[?2004h>         if g in msg:
[?2004l[?2004h>             return True, "guid_in_msg"
[?2004l[?2004h>     
[?2004l[?2004h>     # 2. Contains specific host ID
[?2004l[?2004h>     if "ca33ee8b-7d2f-4343-83bb-33cd9ad23223" in msg:
[?2004l[?2004h>         return True, "host_id_match"
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Contains specific malicious terms
[?2004l[?2004h>     # 'SQBmACgAJAB' is the base64 payload of the script block logging bypass / agent
[?2004l[?2004h>     # 'SQBGACgAJAB' is another encoding prefix of the same bypass / agent
[?2004l[?2004h>     if any(term in msg for term in ['SQBmACgAJAB', 'SQBGACgAJAB', 'HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Debug', 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Debug', 'CurrentVersion\\Run\\Updater', 'CurrentVersion\\Run\\\\' + 'Updater']):
[?2004l[?2004h>         return True, "malicious_payload_terms"
[?2004l[?2004h>         
[?2004l[?2004h>     # 4. Specific known malicious event IDs
[?2004l[?2004h>     if evt['event_id'] in ('evt-00256', 'evt-00260'):
[?2004l[?2004h>          return True, "explicit_malicious_id"
[?2004l[?2004h>          
[?2004l[?2004h>     # 5. Connects to C2 IP
[?2004l[?2004h>     if "10.10.10.5" in msg:
[?2004l[?2004h>          return True, "c2_ip_match"
[?2004l[?2004h>          
[?2004l[?2004h>     return False, ""
[?2004l[?2004h> 
[?2004l[?2004h> # Run classification first pass
[?2004l[?2004h> for evt in all_events:
[?2004l[?2004h>     mal, reason = is_malicious(evt)
[?2004l[?2004h>     if mal:
[?2004l[?2004h>         malicious_ids.add(evt['event_id'])
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Pass 1: Flagged {len(malicious_ids)} malicious events")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect what is NOT flagged as malicious
[?2004l[?2004h> benign_events = [e for e in all_events if e['event_id'] not in malicious_ids]
[?2004l[?2004h> print(f"Pass 1: Remaining {len(benign_events)} events")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's print out remaining events in detail grouped by Host and Event Code
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> by_group = defaultdict(list)
[?2004l[?2004h> for e in benign_events:
[?2004l[?2004h>     by_group[(e['host'], e['event_code'])].append(e)
[?2004l[?2004h> 
[?2004l[?2004h> for k, evts in sorted(by_group.items()):
[?2004l[?2004h>     print(f"\nGroup: Host={k[0]}, EventCode={k[1]} (Count: {len(evts)})")
[?2004l[?2004h>     # Print first 5 events in each group
[?2004l[?2004h>     for e in evts[:5]:
[?2004l[?2004h>         print(f"  {e['event_id']} | User: {e['user']} | Image: {e['image']} | Message: {e['message'][:150].replace('\r\n', ' ').replace('\n', ' ')}")
[?2004l[?2004h>     if len(evts) > 5:
[?2004l[?2004h>         print(f"  ... and {len(evts)-5} more")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
