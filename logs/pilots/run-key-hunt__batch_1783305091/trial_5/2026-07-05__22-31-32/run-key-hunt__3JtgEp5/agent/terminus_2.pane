[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # We will extract destination IP and Port from all Event 3 and 5156 messages
[?2004l[?2004h> print("=== Unique network connections in entire database ===")
[?2004l[?2004h> connections = set()
[?2004l[?2004h> for r in cur.execute("SELECT event_id, event_code, host, user, image, message FROM events WHERE event_code IN (3, 5156, 5158)"):
[?2004l[?2004h>     msg = r['message']
[?2004l[?2004h>     # extract DestinationIp, DestinationPort, Protocol, etc.
[?2004l[?2004h>     dst_ip = None
[?2004l[?2004h>     dst_port = None
[?2004l[?2004h>     
[?2004l[?2004h>     # Try Sysmon Event 3 patterns
[?2004l[?2004h>     ip_m = re.search(r'DestinationIp:\s*(\S+)', msg)
[?2004l[?2004h>     port_m = re.search(r'DestinationPort:\s*(\S+)', msg)
[?2004l[?2004h>     if ip_m and port_m:
[?2004l[?2004h>         dst_ip = ip_m.group(1)
[?2004l[?2004h>         dst_port = port_m.group(1)
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Try Windows Firewall 5156 patterns
[?2004l[?2004h>         ip_m = re.search(r'Destination Address:\s*(\S+)', msg)
[?2004l[?2004h>         port_m = re.search(r'Destination Port:\s*(\S+)', msg)
[?2004l[?2004h>         if ip_m and port_m:
[?2004l[?2004h>             dst_ip = ip_m.group(1)
[?2004l[?2004h>             dst_port = port_m.group(1)
[?2004l[?2004h>             
[?2004l[?2004h>     if dst_ip or dst_port:
[?2004l[?2004h>         connections.add((r['host'], r['event_code'], r['user'], r['image'], dst_ip, dst_port))
[?2004l[?2004h> 
[?2004l[?2004h> for host, code, user, img, ip, port in sorted(connections):
[?2004l[?2004h>     print(f"{host} | Code {code} | User: {user} | Image: {img} | Dst: {ip}:{port}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
