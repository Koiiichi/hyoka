[69.146834, "i", "cat << 'EOF' > /tmp/hunt_all.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmalicious_ids = set()\n\n# 1. Sysmon and Event GUIDs\nknown_guids = {'{b59756a9-b239-5f17-5307-000000000400}'}\n\n# Let's search by GUID in process_guid and in message text\nfor guid in list(known_guids):\n    for r in cur.execute(\"SELECT event_id, process_guid, message FROM events WHERE process_guid = ? OR message LIKE ?\", (guid, f\"%{guid}%\")):\n        malicious_ids.add(r['event_id'])\n\n# 2. Process ID 9076 or hex 0x2374 on WS-05\nfor r in cur.execute(\"SELECT event_id, message FROM events WHERE host = 'WS-05.corp.example' AND (message LIKE '%9076%' OR message LIKE '%0x2374%')\"):\n    malicious_ids.add(r['event_id'])\n\n# 3. PowerShell Host ID \"ca33ee8b-7d2f-4343-83bb-33cd9ad23223\"\nfor r in cur.execute(\"SELECT event_id, message FROM events WHERE message LIKE '%ca33ee8b-7d2f-4343-83bb-33cd9ad23223%'\"):\n    malicious_ids.add(r['event_id'])\n\n# Let's see what other event codes exist on WS-05 that might be malicious. \n# Let's print out what we found so far.\nprint(f\"Malicious IDs count so far: {len(malicious_ids)}\")\n\n# Let's write the sorted IDs to a file and look at what else might be on WS-05, WS-06, and DC01\nprint(\"Total events in database:\")\nfor r in cur.execute(\"SELECT COUNT(*) FROM events\"):\n    print(dict(r))\n\nEOF\npython3 /tmp/hunt_all.py\n"]
