[149.269736, "i", "cat << 'EOF' > /tmp/check_event10.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== Event 10 on WS-05 ===\")\nfor r in cur.execute(\"SELECT event_id, host, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 10\"):\n    msg = r['message']\n    src = re.search(r'SourceImage:\\s*(\\S+)', msg)\n    tgt = re.search(r'TargetImage:\\s*(\\S+)', msg)\n    access = re.search(r'GrantedAccess:\\s*(\\S+)', msg)\n    src_img = src.group(1) if src else \"unknown\"\n    tgt_img = tgt.group(1) if tgt else \"unknown\"\n    acc = access.group(1) if access else \"unknown\"\n    print(f\"{r['event_id']} | Src: {src_img} -> Tgt: {tgt_img} | Access: {acc}\")\n\nprint(\"\\n=== Event 10 on WS-06 ===\")\nfor r in cur.execute(\"SELECT event_id, host, message FROM events WHERE host = 'WS-06.corp.example' AND event_code = 10\"):\n    msg = r['message']\n    src = re.search(r'SourceImage:\\s*(\\S+)', msg)\n    tgt = re.search(r'TargetImage:\\s*(\\S+)', msg)\n    access = re.search(r'GrantedAccess:\\s*(\\S+)', msg)\n    src_img = src.group(1) if src else \"unknown\"\n    tgt_img = tgt.group(1) if tgt else \"unknown\"\n    acc = access.group(1) if access else \"unknown\"\n    print(f\"{r['event_id']} | Src: {src_img} -> Tgt: {tgt_img} | Access: {acc}\")\n\nEOF\npython3 /tmp/check_event10.py\n"]
[149.27083, "o", "cat << 'EOF' > /tmp/check_event10.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
