[98.445323, "i", "cat << 'EOF' > /tmp/inspect_other.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Recreate our current malicious set\nmalicious_ids = set()\nknown_guids = {'{b59756a9-b239-5f17-5307-000000000400}'}\nfor guid in list(known_guids):\n    for r in cur.execute(\"SELECT event_id FROM events WHERE process_guid = ? OR message LIKE ?\", (guid, f\"%{guid}%\")):\n        malicious_ids.add(r['event_id'])\nfor r in cur.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND (message LIKE '%9076%' OR message LIKE '%0x2374%')\"):\n    malicious_ids.add(r['event_id'])\nfor r in cur.execute(\"SELECT event_id FROM events WHERE message LIKE '%ca33ee8b-7d2f-4343-83bb-33cd9ad23223%'\"):\n    malicious_ids.add(r['event_id'])\n\nprint(\"=== Event Code 11 (File Create) ===\")\nfor r in cur.execute(\"SELECT event_id, host, user, message FROM events WHERE event_code = 11\"):\n    print(f\"{r['event_id']} | {r['host']} | {r['user']} | {r['message'][:200].replace('\\r\\n', ' ')}\")\n\nprint(\"\\n=== Event Code 12/13 (Registry) not in malicious ===\")\nfor r in cur.execute(\"SELECT event_id, host, user, message FROM events WHERE event_code IN (12, 13)\"):\n    if r['event_id'] not in malicious_ids:\n        print(f\"{r['event_id']} | {r['host']} | {r['user']} | {r['message'][:200].replace('\\r\\n', ' ')}\")\n\nprint(\"\\n=== Event Code 5140/5145 (Share) not in malicious ===\")\nfor r in cur.execute(\"SELECT event_id, host, user, message FROM events WHERE event_code IN (5140, 5145)\"):\n    if r['event_id'] not in malicious_ids:\n         print(f\"{r['event_id']} | {r['host']} | {r['user']} | {r['message'][:200].replace('\\r\\n', ' ')}\")\n\nprint(\"\\n=== Event Code 4624 (Logon) ===\")\nfor r in cur.execute(\"SELECT event_id, host, user, message FROM events WHERE event_code = 4624\"):\n    print(f\"{r['event_id']} | {r['host']} | {r['user']} | {r['message'][:300].replace('\\r\\n', ' ')}\")\n\nEOF\npython3 /tmp/inspect_other.py\n"]
