System32\\svchost.exe | Network connection detected: RuleName: - UtcTime: 2020-07-22 04:18:56.003 ProcessGuid: {47b21e2e-\r\nevt-00161 | 3 | DC01.corp.example | NT AUTHORITY\\NETWORK SERVICE | C:\\Windows\\System32\\svchost.exe | Network connection detected: RuleName: - UtcTime: 2020-07-22 04:18:56.006 ProcessGuid: {47b21e2e-\r\nevt-00162 | 3 | DC01.corp.example | NT AUTHORITY\\NETWORK SERVICE | C:\\Windows\\System32\\svchost.exe | Network connection detected: RuleName: - UtcTime: 2020-07-22 04:18:56.018 ProcessGuid: {47b21e2e-\r\nevt-00163 | 3 | DC01.corp.example | NT AUTHORITY\\NETWORK SERVICE | C:\\Windows\\System32\\svchost.exe | Network connection detected: RuleName: - UtcTime: 2020-07-22 04:18:56.029 ProcessGuid: {47b21e2e-\r\nevt-00164 | 3 | DC01.corp.example | NT AUTHORITY\\NETWORK SERVICE | C:\\Windows\\System32\\svchost.exe | Network connection detected: RuleName: - UtcTime: 2020-07-22 04:18:56.033 ProcessGuid: {47b21e2e-\r\nevt-00165 | 3 | DC01.corp.example | NT AUTHORITY\\NETWORK SERVICE | C:\\Windows\\System32\\svchost.exe | Network connection detected: RuleName: - UtcTime: 2020-07-22 04:18:56.036 ProcessGuid: {47b21e2e-\r\nevt-00166 | 3 | DC01.corp.example | NT AUTHORITY\\NETWORK SERVICE | C:\\Windows\\System32\\svchost.exe | Network connection detected: RuleName: - UtcTime: 2020-07-22 04:18:56.049 ProcessGuid: {47b21e2e-\r\nevt-00167 | 3 | DC01.corp.example | NT AUTHORITY\\NETWORK SERVICE | C:\\Windows\\System32\\svchost.exe | Network connection detected: RuleName: - UtcTime: 2020-07-22 04:18:56.052 ProcessGuid: {47b21e2e-\r\n\u001b[?2004hroot@52ac26b4f854:~# "]
[84.478232, "i", "cat << 'EOF' > /tmp/analyze_network.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# We will extract destination IP and Port from all Event 3 and 5156 messages\nprint(\"=== Unique network connections in entire database ===\")\nconnections = set()\nfor r in cur.execute(\"SELECT event_id, event_code, host, user, image, message FROM events WHERE event_code IN (3, 5156, 5158)\"):\n    msg = r['message']\n    # extract DestinationIp, DestinationPort, Protocol, etc.\n    dst_ip = None\n    dst_port = None\n    \n    # Try Sysmon Event 3 patterns\n    ip_m = re.search(r'DestinationIp:\\s*(\\S+)', msg)\n    port_m = re.search(r'DestinationPort:\\s*(\\S+)', msg)\n    if ip_m and port_m:\n        dst_ip = ip_m.group(1)\n        dst_port = port_m.group(1)\n    else:\n        # Try Windows Firewall 5156 patterns\n        ip_m = re.search(r'Destination Address:\\s*(\\S+)', msg)\n        port_m = re.search(r'Destination Port:\\s*(\\S+)', msg)\n        if ip_m and port_m:\n            dst_ip = ip_m.group(1)\n            dst_port = port_m.group(1)\n            \n    if dst_ip or dst_port:\n        connections.add((r['host'], r['event_code'], r['user'], r['image'], dst_ip, dst_port))\n\nfor host, code, user, img, ip, port in sorted(connections):\n    print(f\"{host} | Code {code} | User: {user} | Image: {img} | Dst: {ip}:{port}\")\n\nEOF\npython3 /tmp/analyze_network.py\n"]
