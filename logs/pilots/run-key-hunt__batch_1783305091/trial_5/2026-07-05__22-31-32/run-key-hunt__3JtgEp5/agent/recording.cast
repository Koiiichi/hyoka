[127.027574, "i", "cat << 'EOF' > /tmp/classify_all.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nall_events = []\nfor r in cur.execute(\"SELECT * FROM events ORDER BY timestamp ASC, event_id ASC\"):\n    all_events.append(dict(r))\n\nprint(f\"Loaded {len(all_events)} events\")\n\n# Let's define rules for maliciousness\n# Any event with our known malicious process_guid\nmalicious_guids = {'{b59756a9-b239-5f17-5307-000000000400}'}\n# Let's expand malicious guids automatically if we see them in malicious events\n# But we can also look at other indicators\n\nmalicious_ids = set()\n\ndef is_malicious(evt):\n    msg = evt['message'] or ''\n    # 1. Guid matches\n    if evt['process_guid'] in malicious_guids:\n        return True, \"guid_match\"\n    for g in malicious_guids:\n        if g in msg:\n            return True, \"guid_in_msg\"\n    \n    # 2. Contains specific host ID\n    if \"ca33ee8b-7d2f-4343-83bb-33cd9ad23223\" in msg:\n        return True, \"host_id_match\"\n        \n    # 3. Contains specific malicious terms\n    # 'SQBmACgAJAB' is the base64 payload of the script block logging bypass / agent\n    # 'SQBGACgAJAB' is another encoding prefix of the same bypass / agent\n    if any(term in msg for term in ['SQBmACgAJAB', 'SQBGACgAJAB', 'HKLM\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Debug', 'HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Debug', 'CurrentVersion\\\\Run\\\\Updater', 'CurrentVersion\\\\Run\\\\\\\\' + 'Updater']):\n        return True, \"malicious_payload_terms\"\n        \n    # 4. Specific known malicious event IDs\n    if evt['event_id'] in ('evt-00256', 'evt-00260'):\n         return True, \"explicit_malicious_id\"\n         \n    # 5. Connects to C2 IP\n    if \"10.10.10.5\" in msg:\n         return True, \"c2_ip_match\"\n         \n    return False, \"\"\n\n# Run classification first pass\nfor evt in all_events:\n    mal, reason = is_malicious(evt)\n    if mal:\n        malicious_ids.add(evt['event_id'])\n\nprint(f\"Pass 1: Flagged {len(malicious_ids)} malicious events\")\n\n# Let's inspect what is NOT flagged as malicious\nbenign_events = [e for e in all_events if e['event_id'] not in malicious_ids]\nprint(f\"Pass 1: Remaining {len(benign_events)} events\")\n\n# Let's print out remaining events in detail grouped by Host and Event Code\nfrom collections import defaultdict\nby_group = defaultdict(list)\nfor e in benign_events:\n    by_group[(e['host'], e['event_code'])].append(e)\n\nfor k, evts in sorted(by_group.items()):\n    print(f\"\\nGroup: Host={k[0]}, EventCode={k[1]} (Count: {len(evts)})\")\n    # Print first 5 events in each group\n    for e in evts[:5]:\n        print(f\"  {e['event_id']} | User: {e['user']} | Image: {e['image']} | Message: {e['message'][:150].replace('\\r\\n', ' ').replace('\\n', ' ')}\")\n    if len(evts) > 5:\n        print(f\"  ... and {len(evts)-5} more\")\n\nEOF\npython3 /tmp/classify_all.py > /tmp/classification_report.txt\nhead -n 50 /tmp/classification_report.txt\n"]
