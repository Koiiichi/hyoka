[216.300913, "i", "cat << 'EOF' > /tmp/generate_malicious_list.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmalicious_ids = set()\n\nfor r in cur.execute(\"SELECT * FROM events\"):\n    evt_id = r['event_id']\n    msg = r['message'] or ''\n    host = r['host']\n    user = r['user'] or ''\n    guid = r['process_guid'] or ''\n    event_code = r['event_code']\n    \n    is_mal = False\n    \n    # Rule 1: All PowerShell events in the database (since they are all on WS-05 and all malicious)\n    if event_code in (800, 4103):\n        is_mal = True\n        \n    # Rule 2: Any event mentioning our malicious process GUID\n    elif guid == '{b59756a9-b239-5f17-5307-000000000400}' or '{b59756a9-b239-5f17-5307-000000000400}' in msg:\n        is_mal = True\n        \n    # Rule 3: Any event mentioning the malicious host ID\n    elif 'ca33ee8b-7d2f-4343-83bb-33cd9ad23223' in msg:\n        is_mal = True\n        \n    # Rule 4: Any event on WS-05 involving user pgustavo\n    elif host == 'WS-05.corp.example' and ('pgustavo' in user.lower() or 'pgustavo' in msg.lower()):\n        is_mal = True\n        \n    # Rule 5: Any event containing C2 IP address\n    elif '10.10.10.5' in msg:\n        is_mal = True\n        \n    # Rule 6: Process ID 9076 or hex 0x2374 on WS-05\n    elif host == 'WS-05.corp.example' and ('9076' in msg or '0x2374' in msg):\n        is_mal = True\n        \n    if is_mal:\n        malicious_ids.add(evt_id)\n\nprint(f\"Total compiled malicious event count: {len(malicious_ids)}\")\n\n# Let's write the sorted list to findings.json\nsorted_malicious = sorted(list(malicious_ids))\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted_malicious, f)\n\nprint(\"findings.json generated successfully.\")\n\nEOF\npython3 /tmp/generate_malicious_list.py\n"]
