[221.984975, "i", "cat << 'EOF' > /tmp/check_final.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nwith open('/root/findings.json') as f:\n    malicious_ids = set(json.load(f))\n\nprint(f\"Loaded {len(malicious_ids)} malicious IDs from findings.json\")\n\nremaining_ws05 = []\nfor r in cur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example'\"):\n    if r['event_id'] not in malicious_ids:\n         remaining_ws05.append(r)\n\nprint(f\"Remaining events on WS-05: {len(remaining_ws05)}\")\nfor r in remaining_ws05:\n    print(f\"{r['event_id']} | Code {r['event_code']} | User {r['user']} | Msg: {r['message'][:150].replace('\\r\\n', ' ')}\")\n\nEOF\npython3 /tmp/check_final.py\n"]
