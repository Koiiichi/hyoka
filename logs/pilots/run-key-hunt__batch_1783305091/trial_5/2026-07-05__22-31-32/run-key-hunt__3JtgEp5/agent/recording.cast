[149.294957, "o", "\u001b[?2004hroot@52ac26b4f854:~# "]
[156.574266, "i", "cat << 'EOF' > /tmp/compile_malicious.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmalicious_ids = set()\n\n# Let's read all events\nfor r in cur.execute(\"SELECT * FROM events\"):\n    evt_id = r['event_id']\n    msg = r['message'] or ''\n    host = r['host']\n    user = r['user'] or ''\n    \n    # Criteria for maliciousness:\n    # 1. Any event on WS-05 involving user pgustavo (either in the 'user' column or in the message)\n    if host == 'WS-05.corp.example' and ('pgustavo' in user.lower() or 'pgustavo' in msg.lower()):\n        malicious_ids.add(evt_id)\n        continue\n        \n    # 2. Any event mentioning the known malicious process_guid\n    if r['process_guid'] == '{b59756a9-b239-5f17-5307-000000000400}':\n        malicious_ids.add(evt_id)\n        continue\n    if '{b59756a9-b239-5f17-5307-000000000400}' in msg:\n        malicious_ids.add(evt_id)\n        continue\n        \n    # 3. Any event mentioning the powershell Host ID\n    if 'ca33ee8b-7d2f-4343-83bb-33cd9ad23223' in msg:\n        malicious_ids.add(evt_id)\n        continue\n        \n    # 4. Any event with C2 IP address 10.10.10.5\n    if '10.10.10.5' in msg:\n        malicious_ids.add(evt_id)\n        continue\n\nprint(f\"Total compiled malicious event count: {len(malicious_ids)}\")\n\n# Let's inspect the remaining events\nremaining = []\nfor r in cur.execute(\"SELECT * FROM events ORDER BY timestamp ASC\"):\n    if r['event_id'] not in malicious_ids:\n        remaining.append(r)\n\nprint(f\"Remaining events: {len(remaining)}\")\n\n# Let's look at remaining events on WS-05\nws05_rem = [r for r in remaining if r['host'] == 'WS-05.corp.example']\nprint(f\"Remaining events on WS-05: {len(ws05_rem)}\")\nfor r in ws05_rem:\n    print(f\"{r['event_id']} | Code {r['event_code']} | User {r['user']} | Msg: {r['message'][:150].replace('\\r\\n', ' ')}\")\n\nEOF\npython3 /tmp/compile_malicious.py\n"]
