[136.489473, "i", "cat << 'EOF' > /tmp/summary_groups.py\nimport sqlite3\nimport re\nfrom collections import defaultdict\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nall_events = []\nfor r in cur.execute(\"SELECT * FROM events ORDER BY timestamp ASC, event_id ASC\"):\n    all_events.append(dict(r))\n\nmalicious_guids = {'{b59756a9-b239-5f17-5307-000000000400}'}\nmalicious_ids = set()\n\ndef is_malicious(evt):\n    msg = evt['message'] or ''\n    if evt['process_guid'] in malicious_guids:\n        return True\n    for g in malicious_guids:\n        if g in msg:\n            return True\n    if \"ca33ee8b-7d2f-4343-83bb-33cd9ad23223\" in msg:\n        return True\n    if any(term in msg for term in ['SQBmACgAJAB', 'SQBGACgAJAB', 'HKLM\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Debug', 'HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Debug', 'CurrentVersion\\\\Run\\\\Updater', 'CurrentVersion\\\\Run\\\\\\\\' + 'Updater']):\n        return True\n    if evt['event_id'] in ('evt-00256', 'evt-00260'):\n         return True\n    if \"10.10.10.5\" in msg:\n         return True\n    return False\n\nfor evt in all_events:\n    if is_malicious(evt):\n        malicious_ids.add(evt['event_id'])\n\nby_group = defaultdict(list)\nfor e in all_events:\n    if e['event_id'] not in malicious_ids:\n        by_group[(e['host'], e['event_code'])].append(e)\n\nprint(f\"Total events: {len(all_events)}, Malicious: {len(malicious_ids)}, Benign: {len(all_events) - len(malicious_ids)}\")\nfor k, evts in sorted(by_group.items()):\n    print(f\"{k[0]} | Code {k[1]} | Count: {len(evts)}\")\n    # print unique images/processes\n    images = set(e['image'] for e in evts if e['image'])\n    print(f\"  Images: {list(images)}\")\n    # if it's PowerShell, or security log with pgustavo, print detailed command lines\n    if k[1] in (800, 4103) or any('pgustavo' in (e['message'] or '').lower() for e in evts):\n        print(\"  DETAILS:\")\n        for e in evts:\n            print(f\"    {e['event_id']} | {e['message'][:200].replace('\\r\\n', ' ')}\")\n\nEOF\npython3 /tmp/summary_groups.py\n"]
[136.490946, "o", "cat << 'EOF' > /tmp/summary_groups.py\r\n"]
