[156.601076, "o", "\u001b[?2004hroot@52ac26b4f854:~# "]
[164.308662, "i", "cat << 'EOF' > /tmp/compile_malicious_v2.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmalicious_ids = set()\n\nfor r in cur.execute(\"SELECT * FROM events\"):\n    evt_id = r['event_id']\n    msg = r['message'] or ''\n    host = r['host']\n    user = r['user'] or ''\n    guid = r['process_guid'] or ''\n    \n    is_mal = False\n    \n    # 1. Any event on WS-05 involving user pgustavo (case insensitive)\n    if host == 'WS-05.corp.example' and ('pgustavo' in user.lower() or 'pgustavo' in msg.lower()):\n        is_mal = True\n        \n    # 2. Known malicious process_guid\n    elif guid == '{b59756a9-b239-5f17-5307-000000000400}' or '{b59756a9-b239-5f17-5307-000000000400}' in msg:\n        is_mal = True\n        \n    # 3. Mention of PowerShell Host ID\n    elif 'ca33ee8b-7d2f-4343-83bb-33cd9ad23223' in msg:\n        is_mal = True\n        \n    # 4. Mention of Process ID 9076 or hex 0x2374 on WS-05\n    elif host == 'WS-05.corp.example' and ('9076' in msg or '0x2374' in msg):\n        is_mal = True\n        \n    # 5. Connection to C2 IP\n    elif '10.10.10.5' in msg:\n        is_mal = True\n        \n    if is_mal:\n        malicious_ids.add(evt_id)\n\nprint(f\"Total compiled malicious event count (v2): {len(malicious_ids)}\")\n\n# Let's inspect the remaining events\nremaining = []\nfor r in cur.execute(\"SELECT * FROM events ORDER BY timestamp ASC\"):\n    if r['event_id'] not in malicious_ids:\n        remaining.append(r)\n\nprint(f\"Remaining events: {len(remaining)}\")\n\nws05_rem = [r for r in remaining if r['host'] == 'WS-05.corp.example']\nprint(f\"Remaining events on WS-05: {len(ws05_rem)}\")\nfor r in ws05_rem:\n    print(f\"{r['event_id']} | Code {r['event_code']} | User {r['user']} | Msg: {r['message'][:150].replace('\\r\\n', ' ')}\")\n\nEOF\npython3 /tmp/compile_malicious_v2.py\n"]
