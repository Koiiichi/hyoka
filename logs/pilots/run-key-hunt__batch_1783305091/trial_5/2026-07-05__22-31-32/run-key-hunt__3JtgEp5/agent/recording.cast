[173.159649, "i", "cat << 'EOF' > /tmp/check_all_ps.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nps_events = []\nfor r in cur.execute(\"SELECT event_id, event_code, host, user, message FROM events WHERE event_code IN (800, 4103)\"):\n    ps_events.append(dict(r))\n\nprint(f\"Total PS events: {len(ps_events)}\")\n\n# Let's see if there are distinct Host IDs or other indicators in these events\nfor e in ps_events:\n    msg = e['message'] or ''\n    # Search for Host ID\n    # Host ID is typically a GUID-like string\n    import re\n    host_ids = re.findall(r'Host ID\\s*=\\s*(\\S+)|HostId\\s*=\\s*(\\S+)', msg)\n    print(f\"{e['event_id']} | Host: {e['host']} | User: {e['user']} | HostIDs: {host_ids} | Msg: {msg[:100].replace('\\r\\n', ' ')}\")\n\nEOF\npython3 /tmp/check_all_ps.py > /tmp/all_ps_events.txt\nwc -l /tmp/all_ps_events.txt\nhead -n 40 /tmp/all_ps_events.txt\n"]
