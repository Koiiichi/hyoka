[108.761982, "i", "cat << 'EOF' > /tmp/check_ps.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Recreate our current malicious set\nmalicious_ids = set()\nknown_guids = {'{b59756a9-b239-5f17-5307-000000000400}'}\nfor guid in list(known_guids):\n    for r in cur.execute(\"SELECT event_id FROM events WHERE process_guid = ? OR message LIKE ?\", (guid, f\"%{guid}%\")):\n        malicious_ids.add(r['event_id'])\nfor r in cur.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND (message LIKE '%9076%' OR message LIKE '%0x2374%')\"):\n    malicious_ids.add(r['event_id'])\nfor r in cur.execute(\"SELECT event_id FROM events WHERE message LIKE '%ca33ee8b-7d2f-4343-83bb-33cd9ad23223%'\"):\n    malicious_ids.add(r['event_id'])\n\nprint(f\"Malicious set size: {len(malicious_ids)}\")\n\nremaining_ps = []\nfor r in cur.execute(\"SELECT event_id, event_code, host, message FROM events WHERE event_code IN (800, 4103)\"):\n    if r['event_id'] not in malicious_ids:\n        remaining_ps.append(r)\n\nprint(f\"Remaining PowerShell events: {len(remaining_ps)}\")\nfor r in remaining_ps:\n    print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | {r['message'][:200].replace('\\r\\n', ' ')}\")\n\nEOF\npython3 /tmp/check_ps.py\n"]
[108.763339, "o", "cat << 'EOF' > /tmp/check_ps.py\r\n"]
[108.764516, "o", "\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Recreate our current malicious set\r\n\u001b[?2004l\r\u001b[?2004h> malicious_ids = set()\r\n\u001b[?2004l\r\u001b[?2004h> known_guids = {'{b59756a9-b239-5f17-5307-000000000400}'}\r\n\u001b[?2004l\r\u001b[?2004h> for guid in list(known_guids):\r\n\u001b[?2004l\r\u001b[?2004h>     for r in cur.execute(\"SELECT event_id FROM events WHERE process_guid = ? OR message LIKE ?\", (guid, f\"%{guid}%\")):\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(r['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND (message LIKE '%9076%' OR message LIKE '%0x2374%')\"):\r\n\u001b[?2004l\r\u001b[?2004h>     malicious_ids.add(r['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.execute(\"SELECT event_id FROM events WHERE message LIKE '%ca33ee8b-7d2f-4343-83bb-33cd9ad23223%'\"):\r\n\u001b[?2004l\r\u001b[?2004h>     malicious_ids.add(r['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Malicious set size: {len(malicious_ids)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> remaining_ps = []\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.execute(\"SELECT event_id, event_code, host, message FROM events WHERE event_code IN (800, 4103)\"):\r\n\u001b[?2004l\r\u001b[?2004h>     if r['event_id'] not in malicious_ids:\r\n\u001b[?2004l\r\u001b[?2004h>         remaining_ps.append(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Remaining PowerShell events: {len(remaining_ps)}\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in remaining_ps:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | {r['message'][:200].replace('\\r\\n', ' ')}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
