[117.93561, "i", "cat << 'EOF' > /tmp/search_terms.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nterms = ['Debug', 'Updater', 'SQBmACgAJAB', 'SQBGACgAJAB', 'powershell', 'pgustavo']\nfor term in terms:\n    print(f\"\\n=== Events containing: {term} ===\")\n    for r in cur.execute(\"SELECT event_id, event_code, host, message FROM events WHERE message LIKE ? LIMIT 10\", (f\"%{term}%\",)):\n         print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | {r['message'][:150].replace('\\r\\n', ' ')}\")\n\nEOF\npython3 /tmp/search_terms.py\n"]
