[143.32069, "i", "cat << 'EOF' > /tmp/check_sec_pids.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\npids = set()\nimages = set()\nfor r in cur.execute(\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690)\"):\n    msg = r['message']\n    # extract Process ID and Process Name if present\n    pid_m = re.findall(r'Process ID:\\s*(0x[0-9a-fA-F]+|[0-9]+)', msg)\n    proc_m = re.findall(r'Process Name:\\s*(\\S+)', msg)\n    for p in pid_m:\n        pids.add(p)\n    for pr in proc_m:\n        images.add(pr)\n\nprint(f\"Process IDs found in WS-05 security events: {pids}\")\nprint(f\"Process Names found in WS-05 security events: {images}\")\n\nEOF\npython3 /tmp/check_sec_pids.py\n"]
[143.321276, "o", "cat << 'EOF' > /tmp/check_sec_pids.py\r\n\u001b[?2004l\r"]
