[45.918055, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== Event count by Event Code ===\")\nfor r in cur.execute(\"SELECT event_code, count(*) FROM events GROUP BY event_code ORDER BY count(*) DESC\"): \n    print(dict(r))\n\nprint(\"\\n=== Details of powershell process_guid ===\")\n# Let's get the GUID: {b59756a9-b239-5f17-5307-000000000400}\nfor r in cur.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE process_guid = '{b59756a9-b239-5f17-5307-000000000400}' LIMIT 10\"):\n    print(dict(r))\n\nEOF\npython3 /tmp/hunt.py\n"]
