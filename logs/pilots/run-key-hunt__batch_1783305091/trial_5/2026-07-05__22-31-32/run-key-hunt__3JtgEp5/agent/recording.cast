[189.024289, "i", "cat << 'EOF' > /tmp/check_ws05_processes.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nproc_guids = [\n    '{b59756a9-9969-5f14-2d00-000000000400}', \n    '{b59756a9-9966-5f14-1200-000000000400}', \n    '{b59756a9-99c5-5f14-4a02-000000000400}', \n    '{b59756a9-996d-5f14-4900-000000000400}'\n]\n\nfor guid in proc_guids:\n    print(f\"\\n=== GUID: {guid} ===\")\n    for r in cur.execute(\"SELECT event_id, event_code, user, image, command_line, message FROM events WHERE process_guid = ? LIMIT 3\", (guid,)):\n        print(f\"  {r['event_id']} | Code {r['event_code']} | User {r['user']} | Image {r['image']} | Cmd {r['command_line']}\")\n\n# Let's check Process 3580 or others on WS-05\nprint(\"\\n=== Process 3580 on WS-05 ===\")\nfor r in cur.execute(\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND message LIKE '%3580%' LIMIT 3\"):\n    print(f\"  {r['event_id']} | Code {r['event_code']} | Msg: {r['message'][:200].replace('\\r\\n', ' ')}\")\n\nEOF\npython3 /tmp/check_ws05_processes.py\n"]
