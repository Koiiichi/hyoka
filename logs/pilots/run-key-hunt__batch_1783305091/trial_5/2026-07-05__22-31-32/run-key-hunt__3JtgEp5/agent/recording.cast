[76.432289, "o", "    malicious_ids.add(r['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.43239, "o", "for r in cur.execute(\"SELECT event_id FROM events WHERE message LIKE '%ca33ee8b-7d2f-4343-83bb-33cd9ad23223%'\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.43257, "o", "    malicious_ids.add(r['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Active malicious count: {len(malicious_ids)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[76.432834, "o", "\u001b[?2004h> # Let's group remaining events by host and event_code\r\n\u001b[?2004l\r\u001b[?2004h> remaining = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.432901, "o", "for r in cur.execute(\"SELECT event_id, event_code, host, user, image, message FROM events\"):\r\n\u001b[?2004l\r\u001b[?2004h>     if r['event_id'] not in malicious_ids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.432944, "o", "        remaining.append(r)\r\n\u001b[?2004l\r"]
[76.433112, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[76.433291, "o", "\u001b[?2004h> print(f\"Remaining events count: {len(remaining)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.433392, "o", "host_code_counts = Counter((r['host'], r['event_code']) for r in remaining)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== Remaining host + event_code counts ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.433421, "o", "for k, v in host_code_counts.most_common():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.433519, "o", "    print(f\"{k}: {v}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.433575, "o", "# Let's inspect unique users in remaining events\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.433754, "o", "users = Counter(r['user'] for r in remaining)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== Remaining users ===\")\r\n\u001b[?2004l\r\u001b[?2004h> for k, v in users.most_common():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.433868, "o", "    print(f\"{k}: {v}\")\r\n\u001b[?2004l\r"]
[76.433951, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.434049, "o", "# Let's inspect remaining Event Code 3 (Network) or 5156 (Firewall Connection)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== Remaining Network/Firewall connections ===\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in remaining:\r\n\u001b[?2004l\r"]
[76.434153, "o", "\u001b[?2004h>     if r['event_code'] in (3, 5156, 5158):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.434256, "o", "        # check destination IP in message or dst_ip\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.434272, "o", "        # we want to print any interesting connections\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.434423, "o", "        msg = r['message']\r\n\u001b[?2004l\r\u001b[?2004h>         dst = re.search(r'DestinationIp: (\\S+)|Destination Port:\\s+(\\d+)|Destination Address:\\s+(\\S+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.434441, "o", "> "]
[76.434548, "o", "        # Let's just print a summary of dst_ip, dst_port or message snippet\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.43474, "o", "        print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | {r['user']} | {r['image'] or ''} | {msg[:100].replace('\\r\\n', ' ')}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[76.43558, "o", "\u001b[?2004hroot@52ac26b4f854:~# "]
