[37.261371, "o", "for r in cursor.execute(\"SELECT event_id, event_code, timestamp, src_ip, dst_ip, dst_port, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (5156, 5158) LIMIT 10\"): \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.261558, "o", "    print(r['event_id'], r['event_code'], r['timestamp'], r['src_ip'], r['dst_ip'], r['dst_port'], repr(r['message'][:150]))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
