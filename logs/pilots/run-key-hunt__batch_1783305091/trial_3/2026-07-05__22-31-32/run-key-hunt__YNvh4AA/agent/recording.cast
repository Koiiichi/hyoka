[30.254026, "i", "cat << 'EOF' > query4.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Hosts in DB ===\")\nfor r in cursor.execute(\"SELECT host, COUNT(*) FROM events GROUP BY host\"): \n    print(dict(r))\n\nprint(\"\\n=== WS-05 events with process_guid ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, parent_image, command_line, process_guid FROM events WHERE process_guid='{b59756a9-b239-5f17-5307-000000000400}'\"): \n    print(dict(r))\n\nprint(\"\\n=== Any other process connections or unusual processes on other hosts? ===\")\nfor r in cursor.execute(\"SELECT event_id, host, event_code, timestamp, image, command_line FROM events WHERE event_code IN (3, 11, 12, 13) AND host != 'WS-05.corp.example'\"): \n    print(dict(r))\n\nEOF\npython3 query4.py > output4.txt\ncat output4.txt\n"]
[30.254346, "o", "cat << 'EOF' > query4.py\r\n\u001b[?2004l\r"]
