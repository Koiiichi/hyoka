[17.478118, "i", "cat << 'EOF' > query2.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Event 10 (ProcessAccess) ===\")\nfor r in cursor.execute(\"SELECT event_id, host, image, target_image, granted_access, process_guid FROM events WHERE event_code=10\"): \n    print(dict(r))\n\nprint(\"\\n=== Event 4103 / 800 (PowerShell) ===\")\nfor r in cursor.execute(\"SELECT event_id, host, event_code, message FROM events WHERE event_code IN (4103, 800) LIMIT 20\"): \n    print(r['event_id'], r['host'], r['event_code'], repr(r['message'][:200]))\n\nEOF\npython3 query2.py > output2.txt\ncat output2.txt\n"]
