[94.146369, "i", "cat << 'EOF' > query12.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== All events on WS-06 ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, parent_image, command_line, user, target_user, details, message FROM events WHERE host='WS-06.corp.example' ORDER BY timestamp\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], repr(r['image']), repr(r['user']), repr(r['command_line']), repr(r['message'][:200]))\n\nEOF\npython3 query12.py > output12.txt\ncat output12.txt\n"]
[94.147073, "o", "cat << 'EOF' > query12.py\r\n\u001b[?2004l\r"]
