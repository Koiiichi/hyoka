[66.713967, "i", "cat << 'EOF' > query9.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== evt-00224 ===\")\nfor r in cursor.execute(\"SELECT * FROM events WHERE event_id='evt-00224'\"): \n    print(dict(r))\n\nprint(\"=== evt-00226 ===\")\nfor r in cursor.execute(\"SELECT * FROM events WHERE event_id='evt-00226'\"): \n    print(dict(r))\n\n# Let's count event codes on DC01\nprint(\"=== DC01 Event Counts ===\")\nfor r in cursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host='DC01.corp.example' GROUP BY event_code\"): \n    print(dict(r))\n\nEOF\npython3 query9.py > output9.txt\ncat output9.txt\n"]
