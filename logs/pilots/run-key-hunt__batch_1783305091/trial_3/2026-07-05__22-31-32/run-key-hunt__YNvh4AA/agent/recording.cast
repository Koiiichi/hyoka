[37.273691, "o", "\u001b[?2004hroot@a739cdc68808:~# "]
[44.435769, "i", "cat << 'EOF' > query6.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Object Access details ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, user, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (4656, 4663) LIMIT 10\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], r['user'], repr(r['message']))\n\nprint(\"\\n=== Any mentions of Process 3580? ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, parent_image, command_line, message FROM events WHERE host='WS-05.corp.example' AND (message LIKE '%3580%' OR process_guid LIKE '%3580%') LIMIT 10\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], r['image'], r['command_line'], repr(r['message'][:200]))\n\nprint(\"\\n=== Let's look at WS-06 events ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, command_line, message FROM events WHERE host='WS-06.corp.example' LIMIT 20\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], r['image'], r['command_line'], repr(r['message'][:150]))\n\nEOF\npython3 query6.py > output6.txt\ncat output6.txt\n"]
