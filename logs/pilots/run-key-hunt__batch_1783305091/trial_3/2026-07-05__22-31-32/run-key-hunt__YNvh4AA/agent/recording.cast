[58.773002, "i", "cat << 'EOF' > query8.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== WS-06 ProcessAccess details ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, target_image, granted_access, process_guid, message FROM events WHERE host='WS-06.corp.example' AND event_code=10\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], r['image'], r['target_image'], r['granted_access'], r['process_guid'], repr(r['message']))\n\nprint(\"\\n=== WS-05 ProcessAccess details ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, target_image, granted_access, process_guid, message FROM events WHERE host='WS-05.corp.example' AND event_code=10\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], r['image'], r['target_image'], r['granted_access'], r['process_guid'], repr(r['message']))\n\nEOF\npython3 query8.py > output8.txt\ncat output8.txt\n"]
[58.77516, "o", "cat << 'EOF' > query8.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== WS-06 ProcessAccess details ===\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, target_image, granted_access, process_guid, message FROM events WHERE host='WS-06.corp.example' AND event_code=10\"): \r\n\u001b[?2004l\r\u001b[?2004h>     print(r['event_id'], r['event_code'], r['timestamp'], r['image'], r['target_image'], r['granted_access'], r['process_guid'], repr(r['message']))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== WS-05 ProcessAccess details ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
