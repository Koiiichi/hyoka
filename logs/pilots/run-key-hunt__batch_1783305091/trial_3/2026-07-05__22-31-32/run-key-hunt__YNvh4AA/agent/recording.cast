[124.618169, "i", "cat << 'EOF' > query14.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Checking Object Access (4656, 4658, 4663, 4690) on WS-05 ===\")\n# Let's count how many are from PID 0x2374\nfor r in cursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host='WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690) AND message LIKE '%0x2374%' GROUP BY event_code\"): \n    print(dict(r))\n\nprint(\"\\n=== Total Object Access on WS-05 ===\")\nfor r in cursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host='WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690) GROUP BY event_code\"): \n    print(dict(r))\n\nprint(\"\\n=== Details of 4663 ===\")\nfor r in cursor.execute(\"SELECT * FROM events WHERE host='WS-05.corp.example' AND event_code=4663\"): \n    print(dict(r))\n\nEOF\npython3 query14.py > output14.txt\ncat output14.txt\n"]
