[51.486025, "i", "cat << 'EOF' > query7.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Registry events on WS-06 (12, 13) ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, target_object, details, message FROM events WHERE host='WS-06.corp.example' AND event_code IN (12, 13)\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], r['image'], repr(r['target_object']), repr(r['details']), repr(r['message'][:200]))\n\nprint(\"\\n=== Registry events on WS-05 (12, 13) ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, target_object, details, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (12, 13)\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], r['image'], repr(r['target_object']), repr(r['details']), repr(r['message'][:200]))\n\nprint(\"\\n=== Registry events on DC01 (12, 13) ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, target_object, details, message FROM events WHERE host='DC01.corp.example' AND event_code IN (12, 13)\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], r['image'], repr(r['target_object']), repr(r['details']), repr(r['message'][:200]))\n\nEOF\npython3 query7.py > output7.txt\ncat output7.txt\n"]
