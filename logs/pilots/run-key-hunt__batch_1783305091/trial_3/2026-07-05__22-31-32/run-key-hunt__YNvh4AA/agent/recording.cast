[37.258831, "i", "cat << 'EOF' > query5.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Event types on WS-05 ===\")\nfor r in cursor.execute(\"SELECT event_code, COUNT(*), MIN(timestamp), MAX(timestamp) FROM events WHERE host='WS-05.corp.example' GROUP BY event_code\"): \n    print(dict(r))\n\n# Let's inspect Event 4656, 4658, 4663, 4690 on WS-05 - these are object access, handles, etc.\nprint(\"\\n=== Object Access Events on WS-05 (4656, 4658, 4663, 4690) ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, target_object, details, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690) LIMIT 10\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], repr(r['image']), repr(r['target_object']), repr(r['message'][:150]))\n\n# Let's also inspect Event 5156, 5158 on WS-05 (WFP network connections)\nprint(\"\\n=== WFP Network connections on WS-05 (5156, 5158) ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, src_ip, dst_ip, dst_port, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (5156, 5158) LIMIT 10\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], r['src_ip'], r['dst_ip'], r['dst_port'], repr(r['message'][:150]))\n\nEOF\npython3 query5.py > output5.txt\ncat output5.txt\n"]
[37.259678, "o", "cat << 'EOF' > query5.py\r\n\u001b[?2004l\r"]
[37.259775, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> "]
