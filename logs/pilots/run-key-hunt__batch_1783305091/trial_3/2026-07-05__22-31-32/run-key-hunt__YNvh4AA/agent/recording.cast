[23.606135, "i", "cat << 'EOF' > query3.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's count event codes on WS-05 and find all events related to pgustavo\nprint(\"=== WS-05 Event Counts ===\")\nfor r in cursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host='WS-05.corp.example' GROUP BY event_code\"):\n    print(dict(r))\n\nprint(\"\\n=== User pgustavo Events ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, command_line, message FROM events WHERE user LIKE '%pgustavo%' OR message LIKE '%pgustavo%'\"):\n    print(r['event_id'], r['event_code'], r['timestamp'], repr(r['image']), repr(r['command_line']), repr(r['message'][:150]))\n\nEOF\npython3 query3.py > output3.txt\ncat output3.txt\n"]
[23.60633, "o", "cat << 'EOF' > query3.py\r\n\u001b[?2004l\r"]
