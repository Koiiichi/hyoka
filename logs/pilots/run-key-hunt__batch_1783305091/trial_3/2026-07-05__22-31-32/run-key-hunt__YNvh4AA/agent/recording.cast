[37.260757, "o", "for r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, target_object, details, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690) LIMIT 10\"): \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.260806, "o", "    print(r['event_id'], r['event_code'], r['timestamp'], repr(r['image']), repr(r['target_object']), repr(r['message'][:150]))\r\n\u001b[?2004l\r"]
[37.260947, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.261047, "o", "# Let's also inspect Event 5156, 5158 on WS-05 (WFP network connections)\r\n\u001b[?2004l\r\u001b[?2004h> "]
