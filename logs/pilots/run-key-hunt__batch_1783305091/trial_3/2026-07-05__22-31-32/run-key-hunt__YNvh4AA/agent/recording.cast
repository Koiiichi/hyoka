[136.875462, "i", "cat << 'EOF' > make_findings.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmalicious_ids = []\n\n# 1. PowerShell Operational on WS-05\nfor r in cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=4103\"): \n    malicious_ids.append(r['event_id'])\n\n# 2. Windows PowerShell on WS-05\nfor r in cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=800\"): \n    malicious_ids.append(r['event_id'])\n\n# 3. Sysmon Event 3 on WS-05\nfor r in cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=3\"): \n    malicious_ids.append(r['event_id'])\n\n# 4. Sysmon Event 12 on WS-05\nfor r in cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=12\"): \n    malicious_ids.append(r['event_id'])\n\n# 5. Sysmon Event 13 on WS-05 (only from powershell.exe)\nfor r in cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=13 AND image LIKE '%powershell.exe'\"): \n    malicious_ids.append(r['event_id'])\n\n# 6. Security Event 4656 on WS-05 (all are from powershell)\nfor r in cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=4656\"): \n    malicious_ids.append(r['event_id'])\n\n# 7. Security Event 4658 on WS-05 (all are from powershell)\nfor r in cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=4658\"): \n    malicious_ids.append(r['event_id'])\n\n# 8. Security Event 4663 on WS-05 (all are from powershell)\nfor r in cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=4663\"): \n    malicious_ids.append(r['event_id'])\n\n# 9. Security Event 4690 on WS-05 (all are from powershell)\nfor r in cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=4690\"): \n    malicious_ids.append(r['event_id'])\n\n# 10. Security Event 5156 on WS-05 (only from powershell PID 9076)\nfor r in cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=5156 AND message LIKE '%9076%'\"): \n    malicious_ids.append(r['event_id'])\n\n# 11. Security Event 5158 on WS-05 (only from powershell PID 9076)\nfor r in cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=5158 AND message LIKE '%9076%'\"): \n    malicious_ids.append(r['event_id'])\n\nprint(\"Total Malicious Events Collected:\", len(malicious_ids))\nprint(\"Unique Malicious Events:\", len(set(malicious_ids)))\n\n# Write to findings.json\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(set(malicious_ids))), f)\n\nEOF\npython3 make_findings.py\n"]
