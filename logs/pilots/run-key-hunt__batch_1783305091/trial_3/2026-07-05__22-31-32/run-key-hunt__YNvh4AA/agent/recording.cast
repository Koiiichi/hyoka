[12.546852, "i", "cat << 'EOF' > query.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== FileCreate (11) ===\")\nfor r in cursor.execute(\"SELECT * FROM events WHERE event_code=11\"): \n    print(dict(r))\n\nprint(\"\\n=== PipeEvent (18) ===\")\nfor r in cursor.execute(\"SELECT * FROM events WHERE event_code=18\"): \n    print(dict(r))\n\nprint(\"\\n=== Registry (12, 13) ===\")\nfor r in cursor.execute(\"SELECT * FROM events WHERE event_code IN (12, 13)\"): \n    print(dict(r))\n\nprint(\"\\n=== Network share (5140, 5145) ===\")\nfor r in cursor.execute(\"SELECT * FROM events WHERE event_code IN (5140, 5145)\"): \n    print(dict(r))\n\nprint(\"\\n=== RawAccessRead (9) ===\")\nfor r in cursor.execute(\"SELECT * FROM events WHERE event_code=9\"): \n    print(dict(r))\n\nEOF\npython3 query.py > output.txt\ncat output.txt\n"]
