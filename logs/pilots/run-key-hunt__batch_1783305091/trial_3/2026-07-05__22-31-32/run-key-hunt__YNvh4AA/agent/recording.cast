[73.70903, "i", "cat << 'EOF' > query10.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== DC01 Events (Non-WFP, Non-Network) ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, parent_image, command_line, user, target_user, details, message FROM events WHERE host='DC01.corp.example' AND event_code NOT IN (5156, 5158, 3) ORDER BY timestamp\"): \n    print(r['event_id'], r['event_code'], r['timestamp'], repr(r['image']), repr(r['user']), repr(r['target_user']), repr(r['command_line']), repr(r['message'][:150]))\n\nEOF\npython3 query10.py > output10.txt\ncat output10.txt\n"]
