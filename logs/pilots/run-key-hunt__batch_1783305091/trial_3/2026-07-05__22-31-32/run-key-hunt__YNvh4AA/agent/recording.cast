[104.900701, "i", "cat << 'EOF' > query13.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Registry SetValue (13) on WS-05 ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, image, target_object, details FROM events WHERE host='WS-05.corp.example' AND event_code=13\"): \n    print(dict(r))\n\nprint(\"\\n=== WFP connections (5156) on WS-05 ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE host='WS-05.corp.example' AND event_code=5156\"): \n    # Check if PID 9076 is in the message\n    msg = r['message']\n    has_9076 = \"9076\" in msg\n    has_3580 = \"3580\" in msg\n    print(r['event_id'], \"has_9076:\", has_9076, \"has_3580:\", has_3580, repr(msg[:120]))\n\nprint(\"\\n=== WFP binds (5158) on WS-05 ===\")\nfor r in cursor.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE host='WS-05.corp.example' AND event_code=5158\"): \n    msg = r['message']\n    has_9076 = \"9076\" in msg\n    has_3580 = \"3580\" in msg\n    print(r['event_id'], \"has_9076:\", has_9076, \"has_3580:\", has_3580, repr(msg[:120]))\n\nEOF\npython3 query13.py > output13.txt\ncat output13.txt\n"]
