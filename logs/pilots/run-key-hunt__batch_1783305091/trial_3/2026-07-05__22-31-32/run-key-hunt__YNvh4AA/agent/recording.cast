[84.350701, "i", "cat << 'EOF' > query11.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== WS-05 Event Types and Channels ===\")\nfor r in cursor.execute(\"SELECT channel, provider, event_code, COUNT(*) FROM events WHERE host='WS-05.corp.example' GROUP BY channel, provider, event_code\"): \n    print(dict(r))\n\nEOF\npython3 query11.py > output11.txt\ncat output11.txt\n"]
