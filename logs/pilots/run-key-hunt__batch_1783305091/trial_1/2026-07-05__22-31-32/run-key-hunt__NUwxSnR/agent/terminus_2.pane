[?2004hroot@c64bdbbf713d:~# cat << 'EOF' > /tmp/analyze_pgustavo.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, host, user, image, target_object, details, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE user LIKE '%pgustavo%' OR target_user LIKE '%pgustavo%' OR message LIKE '%pgustavo%' 
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} events for pgustavo")
[?2004l[?2004h> 
[?2004l[?2004h> # Group by event_code
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> c = Counter([row[1] for row in rows])
[?2004l[?2004h> print("Event Code counts:", c)
[?2004l[?2004h> 
[?2004l[?2004h> for row in rows:
[?2004l[?2004h>     # Print if it's NOT event code 800 or 4103 (to see Sysmon and Security events)
[?2004l[?2004h>     if row[1] not in (800, 4103):
[?2004l[?2004h>         print(f"ID: {row[0]} | Code: {row[1]} | Host: {row[2]} | Image: {row[4]} | Target: {row[5]} | Details: {row[6]}")
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
