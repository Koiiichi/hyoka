[?2004hroot@c64bdbbf713d:~# cat << 'EOF' > /tmp/analyze_wec.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, host, user, target_user, image, target_object, details, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE user LIKE '%WEC%' OR target_user LIKE '%WEC%' OR src_ip = '172.18.38.6' 
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> for row in cursor.fetchall():
[?2004l[?2004h>     print("="*50)
[?2004l[?2004h>     print(f"Event ID: {row[0]} | Code: {row[2]} | Host: {row[3]} | User: {row[4]} | Target: {row[5]}")
[?2004l[?2004h>     # print non-empty fields
[?2004l[?2004h>     if row[6]: print(f"Image: {row[6]}")
[?2004l[?2004h>     if row[7]: print(f"Target Object: {row[7]}")
[?2004l[?2004h>     if row[8]: print(f"Details: {row[8]}")
[?2004l[?2004h>     # extract Relative Target Name from message if present
[?2004l[?2004h>     msg = row[9] or ""
[?2004l[?2004h>     target_name_match = [line.strip() for line in msg.split('\n') if 'Relative Target Name' in line or 'Share Name' in line]
[?2004l[?2004h>     if target_name_match:
[?2004l[?2004h>         print(f"Msg details: {target_name_match}")
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
[?2004l[?2004h> EOF
[?2004l[?2004hroot@c64bdbbf713d:~# python3 /tmp/analyze_wec.py
