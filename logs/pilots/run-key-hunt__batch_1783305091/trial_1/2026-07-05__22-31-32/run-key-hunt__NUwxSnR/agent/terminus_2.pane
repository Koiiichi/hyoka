[?2004hroot@c64bdbbf713d:~# cat << 'EOF' > /tmp/decode_ps.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import base64
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT DISTINCT message FROM events WHERE message LIKE '%-enc%';")
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> all_enc = set()
[?2004l[?2004h> for row in rows:
[?2004l[?2004h>     msg = row[0]
[?2004l[?2004h>     # Find patterns of -enc followed by base64
[?2004l[?2004h>     # Note that -enc might be followed by whitespace then the string
[?2004l[?2004h>     match = re.search(r'-enc\s+([A-Za-z0-9+/=]+)', msg)
[?2004l[?2004h>     if match:
[?2004l[?2004h>         all_enc.add(match.group(1))
[?2004l[?2004h> 
[?2004l[?2004h> # Also check other fields like command_line or details
[?2004l[?2004h> cursor.execute("SELECT DISTINCT command_line FROM events WHERE command_line LIKE '%-enc%';")
[?2004l[?2004h> for row in cursor.fetchall():
[?2004l[?2004h>     if row[0]:
[?2004l[?2004h>         match = re.search(r'-enc\s+([A-Za-z0-9+/=]+)', row[0])
[?2004l[?2004h>         if match:
[?2004l[?2004h>             all_enc.add(match.group(1))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(all_enc)} unique base64 strings")
[?2004l[?2004h> for idx, enc in enumerate(all_enc):
[?2004l[?2004h>     print(f"--- String {idx} ---")
[?2004l[?2004h>     print(enc[:100] + "...")
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Try padding just in case
[?2004l[?2004h>         missing_padding = len(enc) % 4
[?2004l[?2004h>         if missing_padding:
[?2004l[?2004h>             enc += '=' * (4 - missing_padding)
[?2004l[?2004h>         decoded = base64.b64decode(enc).decode('utf-16-le', errors='ignore')
[?2004l[?2004h>         print(decoded[:1000])
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print("Error decoding:", e)
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
[?2004l[?2004h> EOF
