[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Gather all event ids
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, host, user, image, message FROM events ORDER BY timestamp;")
[?2004l[?2004h> all_events = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Define malicious sets
[?2004l[?2004h> # a) Sysmon process guid
[?2004l[?2004h> cursor.execute("SELECT event_id FROM events WHERE process_guid = '{b59756a9-b239-5f17-5307-000000000400}';")
[?2004l[?2004h> sysmon_mal = set(r[0] for r in cursor.fetchall())
[?2004l[?2004h> 
[?2004l[?2004h> # b) Security events for pgustavo/powershell.exe
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE (user LIKE '%pgustavo%' OR message LIKE '%powershell.exe%' OR message LIKE '%9076%')
[?2004l[?2004h>       AND event_code IN (4656, 4658, 4663, 4690);
[?2004l[?2004h> """)
[?2004l[?2004h> sec_mal = set(r[0] for r in cursor.fetchall())
[?2004l[?2004h> 
[?2004l[?2004h> # c) PowerShell logs (800, 4103) on WS-05
[?2004l[?2004h> cursor.execute("SELECT event_id FROM events WHERE event_code IN (800, 4103) AND host = 'WS-05.corp.example';")
[?2004l[?2004h> ps_mal = set(r[0] for r in cursor.fetchall())
[?2004l[?2004h> 
[?2004l[?2004h> # d) WFP events for powershell
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE event_code IN (5156, 5158) 
[?2004l[?2004h>       AND (message LIKE '%powershell.exe%' OR message LIKE '%9076%');
[?2004l[?2004h> """)
[?2004l[?2004h> wfp_mal = set(r[0] for r in cursor.fetchall())
[?2004l[?2004h> 
[?2004l[?2004h> malicious_ids = sysmon_mal.union(sec_mal).union(ps_mal).union(wfp_mal)
[?2004l[?2004h> print(f"Malicious IDs count: {len(malicious_ids)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Partitioning
[?2004l[?2004h> benign_events = []
[?2004l[?2004h> for r in all_events:
[?2004l[?2004h>     eid = r[0]
[?2004l[?2004h>     if eid not in malicious_ids:
[?2004l[?2004h>         benign_events.append(r)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Remaining supposedly benign events: {len(benign_events)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's group benign events by event_code, host, image
[?2004l[?2004h> by_group = {}
[?2004l[?2004h> for r in benign_events:
[?2004l[?2004h>     key = (r[1], r[2], r[4])
[?2004l[?2004h>     by_group[key] = by_group.get(key, 0) + 1
[?2004l[?2004h> 
[?2004l[?2004h> for key, count in sorted(by_group.items(), key=lambda x: x[1], reverse=True):
[?2004l[?2004h>     print(f"Code: {key[0]:<5} | Host: {key[1]:<20} | Image: {str(key[2]):<50} | Count: {count}")
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
