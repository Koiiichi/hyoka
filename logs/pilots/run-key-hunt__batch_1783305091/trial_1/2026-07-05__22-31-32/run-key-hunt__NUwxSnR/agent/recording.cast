[193.630522, "i", "cat << 'EOF' > /tmp/check_wfp.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's check 5156, 5158 events\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, message \n    FROM events \n    WHERE event_code IN (5156, 5158) \n      AND (message LIKE '%powershell.exe%' OR message LIKE '%9076%');\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} WFP events for powershell\")\nfor r in rows[:10]:\n    print(r[0], r[1], r[2], r[3][:150].replace('\\n', ' '))\n\nconn.close()\nEOF\npython3 /tmp/check_wfp.py\n"]
[193.631226, "o", "cat << 'EOF' > /tmp/check_wfp.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r"]
[193.631635, "o", "\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's check 5156, 5158 events\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, event_code, host, message \r\n\u001b[?2004l\r\u001b[?2004h> "]
