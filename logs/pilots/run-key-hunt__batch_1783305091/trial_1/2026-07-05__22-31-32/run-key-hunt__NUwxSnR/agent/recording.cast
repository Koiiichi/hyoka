[146.970107, "i", "cat << 'EOF' > /tmp/check_all_ps.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's count how many 800 and 4103 events have HostApplication containing our malicious base64 string\ncursor.execute(\"\"\"\n    SELECT event_code, COUNT(*)\n    FROM events \n    WHERE event_code IN (800, 4103) \n      AND message LIKE '%-enc%'\n    GROUP BY event_code;\n\"\"\")\nprint(\"PowerShell logs with -enc:\", cursor.fetchall())\n\n# Let's check if there are ANY 800 or 4103 events that do NOT contain '-enc' or are from a different HostApplication\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, message \n    FROM events \n    WHERE event_code IN (800, 4103) \n      AND message NOT LIKE '%-enc%'\n    LIMIT 10;\n\"\"\")\nother_ps = cursor.fetchall()\nprint(f\"PowerShell logs without -enc: {len(other_ps)}\")\nfor row in other_ps[:5]:\n    print(row[0], row[1], row[2][:200])\n\nconn.close()\nEOF\npython3 /tmp/check_all_ps.py\n"]
[146.972164, "o", "cat << 'EOF' > /tmp/check_all_ps.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's count how many 800 and 4103 events have HostApplication containing our malicious base64 string\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_code, COUNT(*)\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h> "]
[146.973026, "o", "    WHERE event_code IN (800, 4103) \r\n\u001b[?2004l\r\u001b[?2004h>       AND message LIKE '%-enc%'\r\n\u001b[?2004l\r\u001b[?2004h>     GROUP BY event_code;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"PowerShell logs with -enc:\", cursor.fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's check if there are ANY 800 or 4103 events that do NOT contain '-enc' or are from a different HostApplication\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, event_code, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE event_code IN (800, 4103) \r\n\u001b[?2004l\r\u001b[?2004h>       AND message NOT LIKE '%-enc%'\r\n\u001b[?2004l\r\u001b[?2004h>     LIMIT 10;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> other_ps = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"PowerShell logs without -enc: {len(other_ps)}\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in other_ps[:5]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
