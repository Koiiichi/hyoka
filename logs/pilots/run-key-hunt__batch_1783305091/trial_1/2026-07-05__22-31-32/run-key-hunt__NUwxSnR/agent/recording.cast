[171.811039, "i", "cat << 'EOF' > /tmp/collect_malicious.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# 1. Sysmon events for the PowerShell beacon\ncursor.execute(\"SELECT event_id FROM events WHERE process_guid = '{b59756a9-b239-5f17-5307-000000000400}';\")\nsysmon_evts = [r[0] for r in cursor.fetchall()]\nprint(f\"Sysmon events ({len(sysmon_evts)}): {sysmon_evts}\")\n\n# 2. Security events involving powershell.exe\ncursor.execute(\"\"\"\n    SELECT event_id \n    FROM events \n    WHERE (user LIKE '%pgustavo%' OR message LIKE '%powershell.exe%')\n      AND event_code IN (4656, 4658, 4663, 4690);\n\"\"\")\nsec_evts = [r[0] for r in cursor.fetchall()]\nprint(f\"Security events ({len(sec_evts)}): {sec_evts}\")\n\n# 3. PowerShell logs (800, 4103) on WS-05\ncursor.execute(\"SELECT event_id FROM events WHERE event_code IN (800, 4103) AND host = 'WS-05.corp.example';\")\nps_evts = [r[0] for r in cursor.fetchall()]\nprint(f\"PowerShell logs ({len(ps_evts)}): {ps_evts}\")\n\n# Combine and check duplicates\nall_malicious = sorted(list(set(sysmon_evts + sec_evts + ps_evts)))\nprint(f\"Total unique malicious events: {len(all_malicious)}\")\n\nconn.close()\nEOF\npython3 /tmp/collect_malicious.py\n"]
