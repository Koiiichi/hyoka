[55.132102, "i", "cat << 'EOF' > /tmp/analyze_guids.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT process_guid, host, image, COUNT(*), MIN(timestamp), MAX(timestamp)\n    FROM events \n    WHERE process_guid IS NOT NULL AND process_guid != ''\n    GROUP BY process_guid, host, image\n    ORDER BY host, MIN(timestamp);\n\"\"\")\nprint(f\"{'Process GUID':<40} | {'Host':<20} | {'Image':<50} | {'Count':<5} | {'Min Time'} | {'Max Time'}\")\nprint(\"-\"*150)\nfor row in cursor.fetchall():\n    print(f\"{str(row[0]):<40} | {str(row[1]):<20} | {str(row[2]):<50} | {str(row[3]):<5} | {row[4]} | {row[5]}\")\n\nconn.close()\nEOF\npython3 /tmp/analyze_guids.py\n"]
[55.132596, "o", "cat << 'EOF' > /tmp/analyze_guids.py\r\n\u001b[?2004l\r"]
