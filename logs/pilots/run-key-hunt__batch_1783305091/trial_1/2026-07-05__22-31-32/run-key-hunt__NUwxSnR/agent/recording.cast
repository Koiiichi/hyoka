[69.19512, "o", "\u001b[?2004hroot@c64bdbbf713d:~# "]
[76.670051, "i", "cat << 'EOF' > /tmp/analyze_wec.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, target_user, image, target_object, details, message \n    FROM events \n    WHERE user LIKE '%WEC%' OR target_user LIKE '%WEC%' OR src_ip = '172.18.38.6' \n    ORDER BY timestamp;\n\"\"\")\n\nfor row in cursor.fetchall():\n    print(\"=\"*50)\n    print(f\"Event ID: {row[0]} | Code: {row[2]} | Host: {row[3]} | User: {row[4]} | Target: {row[5]}\")\n    # print non-empty fields\n    if row[6]: print(f\"Image: {row[6]}\")\n    if row[7]: print(f\"Target Object: {row[7]}\")\n    if row[8]: print(f\"Details: {row[8]}\")\n    # extract Relative Target Name from message if present\n    msg = row[9] or \"\"\n    target_name_match = [line.strip() for line in msg.split('\\n') if 'Relative Target Name' in line or 'Share Name' in line]\n    if target_name_match:\n        print(f\"Msg details: {target_name_match}\")\n\nconn.close()\nEOF\npython3 /tmp/analyze_wec.py\n"]
