[98.856419, "i", "cat << 'EOF' > /tmp/analyze_others.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Inspect Image Load (7)\ncursor.execute(\"SELECT event_id, host, image, details, message FROM events WHERE event_code = 7;\")\nprint(\"=== Sysmon Event 7 (Image Loaded) ===\")\nfor row in cursor.fetchall():\n    print(row[0], row[1], row[2], row[3], row[4][:200] if row[4] else \"\")\n\n# Inspect Registry (12, 13) that are NOT by powershell.exe with the known guid\ncursor.execute(\"\"\"\n    SELECT event_id, host, image, target_object, details, process_guid \n    FROM events \n    WHERE event_code IN (12, 13) AND process_guid != '{b59756a9-b239-5f17-5307-000000000400}';\n\"\"\")\nprint(\"\\n=== Sysmon Registry (12, 13) NOT by Known PowerShell Beacon ===\")\nfor row in cursor.fetchall():\n    print(row)\n\n# Inspect Process Access (10) that are NOT by svchost.exe target/source\ncursor.execute(\"\"\"\n    SELECT event_id, host, image, target_image, granted_access, process_guid, message \n    FROM events \n    WHERE event_code = 10 AND NOT (image LIKE '%svchost.exe%' AND target_image LIKE '%svchost.exe%');\n\"\"\")\nprint(\"\\n=== Sysmon Process Access (10) NOT svchost-to-svchost ===\")\nfor row in cursor.fetchall():\n    print(row[0], row[1], row[2], row[3], row[4])\n\nconn.close()\nEOF\npython3 /tmp/analyze_others.py\n"]
