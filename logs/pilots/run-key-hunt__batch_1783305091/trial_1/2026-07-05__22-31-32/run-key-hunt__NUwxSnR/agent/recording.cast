[222.24953, "i", "cat << 'EOF' > /tmp/write_findings.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# 1. Sysmon events for the PowerShell beacon\ncursor.execute(\"SELECT event_id FROM events WHERE process_guid = '{b59756a9-b239-5f17-5307-000000000400}';\")\nsysmon_mal = set(r[0] for r in cursor.fetchall())\n\n# 2. Security events for pgustavo/powershell.exe\ncursor.execute(\"\"\"\n    SELECT event_id \n    FROM events \n    WHERE (user LIKE '%pgustavo%' OR message LIKE '%powershell.exe%' OR message LIKE '%9076%')\n      AND event_code IN (4656, 4658, 4663, 4690);\n\"\"\")\nsec_mal = set(r[0] for r in cursor.fetchall())\n\n# 3. PowerShell logs (800, 4103) on WS-05\ncursor.execute(\"SELECT event_id FROM events WHERE event_code IN (800, 4103) AND host = 'WS-05.corp.example';\")\nps_mal = set(r[0] for r in cursor.fetchall())\n\n# 4. WFP events for powershell\ncursor.execute(\"\"\"\n    SELECT event_id \n    FROM events \n    WHERE event_code IN (5156, 5158) \n      AND (message LIKE '%powershell.exe%' OR message LIKE '%9076%');\n\"\"\")\nwfp_mal = set(r[0] for r in cursor.fetchall())\n\nall_malicious = sorted(list(sysmon_mal.union(sec_mal).union(ps_mal).union(wfp_mal)))\n\nprint(f\"Writing {len(all_malicious)} events to findings.json\")\nwith open('/root/findings.json', 'w') as f:\n    json.dump(all_malicious, f)\n\nconn.close()\nEOF\npython3 /tmp/write_findings.py\ncat /root/findings.json\n"]
[222.249906, "o", "cat << 'EOF' > /tmp/write_findings.py\r\n"]
[222.249952, "o", "\u001b[?2004l\r"]
[222.250199, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
[222.250293, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.250386, "o", "conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h"]
[222.250543, "o", "> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.251, "o", "# 1. Sysmon events for the PowerShell beacon\r\n\u001b[?2004l\r"]
[222.251078, "o", "\u001b[?2004h> "]
[222.253063, "o", "cursor.execute(\"SELECT event_id FROM events WHERE process_guid = '{b59756a9-b239-5f17-5307-000000000400}';\")\r\n\u001b[?2004l\r\u001b[?2004h> sysmon_mal = set(r[0] for r in cursor.fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 2. Security events for pgustavo/powershell.exe\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE (user LIKE '%pgustavo%' OR message LIKE '%powershell.exe%' OR message LIKE '%9076%')\r\n\u001b[?2004l\r\u001b[?2004h>       AND event_code IN (4656, 4658, 4663, 4690);\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> sec_mal = set(r[0] for r in cursor.fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 3. PowerShell logs (800, 4103) on WS-05\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id FROM events WHERE event_code IN (800, 4103) AND host = 'WS-05.corp.example';\")\r\n\u001b[?2004l\r\u001b[?2004h> ps_mal = set(r[0] for r in cursor.fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 4. WFP events for powershell\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE event_code IN (5156, 5158) \r\n\u001b[?2004l\r\u001b[?2004h>       AND (message LIKE '%powershell.exe%' OR message LIKE '%9076%');\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> wfp_mal = set(r[0] for r in cursor.fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> all_malicious = sorted(list(sysmon_mal.union(sec_mal).union(ps_mal).union(wfp_mal)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Writing {len(all_malicious)} events to findings.json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.253086, "o", "with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(all_malicious, f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.25317, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.253359, "o", "conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[222.255694, "o", "\u001b[?2004hroot@c64bdbbf713d:~# "]
[222.255729, "o", "python3 /tmp/write_findings.py\r\n\u001b[?2004l\r"]
[222.26926, "o", "Writing 309 events to findings.json\r\n"]
[222.271478, "o", "\u001b[?2004hroot@c64bdbbf713d:~# "]
[222.271497, "o", "cat /root/findings.json\r\n\u001b[?2004l\r"]
