[131.897578, "i", "cat << 'EOF' > /tmp/analyze_pgustavo_sec.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, user, message \n    FROM events \n    WHERE (user LIKE '%pgustavo%' OR target_user LIKE '%pgustavo%' OR message LIKE '%pgustavo%')\n      AND event_code IN (4656, 4658, 4663, 4690, 4661)\n    ORDER BY timestamp;\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} security events\")\n\n# Let's extract object name or process name from message\nfor row in rows:\n    msg = row[4] or \"\"\n    obj_name = \"\"\n    proc_name = \"\"\n    for line in msg.split('\\n'):\n        if 'Object Name:' in line:\n            obj_name = line.strip()\n        if 'Process Name:' in line:\n            proc_name = line.strip()\n    print(f\"ID: {row[0]} | Code: {row[1]} | {proc_name} | {obj_name}\")\n\nconn.close()\nEOF\npython3 /tmp/analyze_pgustavo_sec.py\n"]
[131.89849, "o", "cat << 'EOF' > /tmp/analyze_pgustavo_sec.py\r\n\u001b[?2004l\r"]
[131.899579, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, event_code, host, user, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE (user LIKE '%pgustavo%' OR target_user LIKE '%pgustavo%' OR message LIKE '%pgustavo%')\r\n\u001b[?2004l\r\u001b[?2004h>       AND event_code IN (4656, 4658, 4663, 4690, 4661)\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> rows = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(rows)} security events\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's extract object name or process name from message\r\n\u001b[?2004l\r\u001b[?2004h> for row in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     msg = row[4] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     obj_name = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     proc_name = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     for line in msg.split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h>         if 'Object Name:' in line:\r\n\u001b[?2004l\r\u001b[?2004h>             obj_name = line.strip()\r\n\u001b[?2004l\r"]
