[206.066903, "i", "cat << 'EOF' > /tmp/partition_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# 1. Gather all event ids\ncursor.execute(\"SELECT event_id, event_code, host, user, image, message FROM events ORDER BY timestamp;\")\nall_events = cursor.fetchall()\n\n# 2. Define malicious sets\n# a) Sysmon process guid\ncursor.execute(\"SELECT event_id FROM events WHERE process_guid = '{b59756a9-b239-5f17-5307-000000000400}';\")\nsysmon_mal = set(r[0] for r in cursor.fetchall())\n\n# b) Security events for pgustavo/powershell.exe\ncursor.execute(\"\"\"\n    SELECT event_id \n    FROM events \n    WHERE (user LIKE '%pgustavo%' OR message LIKE '%powershell.exe%' OR message LIKE '%9076%')\n      AND event_code IN (4656, 4658, 4663, 4690);\n\"\"\")\nsec_mal = set(r[0] for r in cursor.fetchall())\n\n# c) PowerShell logs (800, 4103) on WS-05\ncursor.execute(\"SELECT event_id FROM events WHERE event_code IN (800, 4103) AND host = 'WS-05.corp.example';\")\nps_mal = set(r[0] for r in cursor.fetchall())\n\n# d) WFP events for powershell\ncursor.execute(\"\"\"\n    SELECT event_id \n    FROM events \n    WHERE event_code IN (5156, 5158) \n      AND (message LIKE '%powershell.exe%' OR message LIKE '%9076%');\n\"\"\")\nwfp_mal = set(r[0] for r in cursor.fetchall())\n\nmalicious_ids = sysmon_mal.union(sec_mal).union(ps_mal).union(wfp_mal)\nprint(f\"Malicious IDs count: {len(malicious_ids)}\")\n\n# Partitioning\nbenign_events = []\nfor r in all_events:\n    eid = r[0]\n    if eid not in malicious_ids:\n        benign_events.append(r)\n\nprint(f\"Remaining supposedly benign events: {len(benign_events)}\")\n\n# Let's group benign events by event_code, host, image\nby_group = {}\nfor r in benign_events:\n    key = (r[1], r[2], r[4])\n    by_group[key] = by_group.get(key, 0) + 1\n\nfor key, count in sorted(by_group.items(), key=lambda x: x[1], reverse=True):\n    print(f\"Code: {key[0]:<5} | Host: {key[1]:<20} | Image: {str(key[2]):<50} | Count: {count}\")\n\nconn.close()\nEOF\npython3 /tmp/partition_events.py\n"]
