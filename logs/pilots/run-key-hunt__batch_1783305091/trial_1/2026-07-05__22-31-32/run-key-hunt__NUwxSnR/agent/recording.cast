[137.896627, "i", "cat << 'EOF' > /tmp/analyze_pgustavo_objects.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, message \n    FROM events \n    WHERE message LIKE '%powershell.exe%' AND event_code IN (4656, 4663);\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} object access events for powershell.exe\")\n\nunique_objects = set()\nfor row in rows:\n    msg = row[2] or \"\"\n    for line in msg.split('\\n'):\n        if 'Object Name:' in line:\n            unique_objects.add(line.strip())\n\nfor obj in sorted(list(unique_objects)):\n    print(obj)\n\nconn.close()\nEOF\npython3 /tmp/analyze_pgustavo_objects.py\n"]
[137.899325, "o", "cat << 'EOF' > /tmp/analyze_pgustavo_objects.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, event_code, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE message LIKE '%powershell.exe%' AND event_code IN (4656, 4663);\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> rows = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(rows)} object access events for powershell.exe\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> unique_objects = set()\r\n\u001b[?2004l\r\u001b[?2004h> for row in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     msg = row[2] or \"\"\r\n\u001b[?2004l\r"]
[137.902854, "o", "\u001b[?2004h>     for line in msg.split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h>         if 'Object Name:' in line:\r\n\u001b[?2004l\r\u001b[?2004h>             unique_objects.add(line.strip())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for obj in sorted(list(unique_objects)):\r\n\u001b[?2004l\r\u001b[?2004h>     print(obj)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
