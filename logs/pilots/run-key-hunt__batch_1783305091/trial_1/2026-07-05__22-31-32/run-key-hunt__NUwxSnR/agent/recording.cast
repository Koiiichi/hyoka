[121.249594, "o", "\u001b[?2004hroot@c64bdbbf713d:~# "]
[125.97234, "i", "cat << 'EOF' > /tmp/analyze_pgustavo.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, user, image, target_object, details, message \n    FROM events \n    WHERE user LIKE '%pgustavo%' OR target_user LIKE '%pgustavo%' OR message LIKE '%pgustavo%' \n    ORDER BY timestamp;\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} events for pgustavo\")\n\n# Group by event_code\nfrom collections import Counter\nc = Counter([row[1] for row in rows])\nprint(\"Event Code counts:\", c)\n\nfor row in rows:\n    # Print if it's NOT event code 800 or 4103 (to see Sysmon and Security events)\n    if row[1] not in (800, 4103):\n        print(f\"ID: {row[0]} | Code: {row[1]} | Host: {row[2]} | Image: {row[4]} | Target: {row[5]} | Details: {row[6]}\")\n\nconn.close()\nEOF\npython3 /tmp/analyze_pgustavo.py\n"]
[125.972634, "o", "cat << 'EOF' > /tmp/analyze_pgustavo.py\r\n\u001b[?2004l\r"]
