[23.676155, "i", "cat << 'EOF' > /tmp/analyze_ps.py\nimport sqlite3\nimport re\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's inspect unique powershell host applications / arguments\ncursor.execute(\"SELECT event_id, timestamp, message FROM events WHERE event_code IN (800, 4103) ORDER BY timestamp;\")\nrows = cursor.fetchall()\n\nprint(f\"Found {len(rows)} PowerShell events\")\nfor row in rows[:15]:\n    print(\"=\"*50)\n    print(f\"Event ID: {row[0]} | Timestamp: {row[1]}\")\n    print(row[2][:500])\n\nconn.close()\nEOF\npython3 /tmp/analyze_ps.py > /tmp/ps_output.txt\nhead -n 100 /tmp/ps_output.txt\n"]
