[38.726212, "i", "cat << 'EOF' > /tmp/analyze_net.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's inspect Event 3\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, host, user, image, src_ip, dst_ip, dst_port, process_guid \n    FROM events \n    WHERE event_code = 3 \n    ORDER BY timestamp;\n\"\"\")\nprint(\"=== Sysmon Event 3 (Network Connections) ===\")\nfor row in cursor.fetchall():\n    print(row)\n\n# Let's inspect Event 11 (File Create)\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, host, user, image, target_object, details \n    FROM events \n    WHERE event_code = 11;\n\"\"\")\nprint(\"\\n=== Sysmon Event 11 (File Create) ===\")\nfor row in cursor.fetchall():\n    print(row)\n\n# Let's inspect Event 18 (Pipe Created)\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, host, user, image, target_object, details \n    FROM events \n    WHERE event_code = 18;\n\"\"\")\nprint(\"\\n=== Sysmon Event 18 (Pipe Created) ===\")\nfor row in cursor.fetchall():\n    print(row)\n\n# Let's inspect Event 9 (Raw Access Read)\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, host, user, image, target_object, details \n    FROM events \n    WHERE event_code = 9;\n\"\"\")\nprint(\"\\n=== Sysmon Event 9 (RawAccessRead) ===\")\nfor row in cursor.fetchall():\n    print(row)\n\nconn.close()\nEOF\npython3 /tmp/analyze_net.py\n"]
