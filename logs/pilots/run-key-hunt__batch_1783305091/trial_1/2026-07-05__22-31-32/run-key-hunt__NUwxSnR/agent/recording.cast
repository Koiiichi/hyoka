[23.689862, "o", "\u001b[?2004hroot@c64bdbbf713d:~# "]
[29.488594, "i", "cat << 'EOF' > /tmp/decode_ps.py\nimport sqlite3\nimport re\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT DISTINCT message FROM events WHERE message LIKE '%-enc%';\")\nrows = cursor.fetchall()\n\nall_enc = set()\nfor row in rows:\n    msg = row[0]\n    # Find patterns of -enc followed by base64\n    # Note that -enc might be followed by whitespace then the string\n    match = re.search(r'-enc\\s+([A-Za-z0-9+/=]+)', msg)\n    if match:\n        all_enc.add(match.group(1))\n\n# Also check other fields like command_line or details\ncursor.execute(\"SELECT DISTINCT command_line FROM events WHERE command_line LIKE '%-enc%';\")\nfor row in cursor.fetchall():\n    if row[0]:\n        match = re.search(r'-enc\\s+([A-Za-z0-9+/=]+)', row[0])\n        if match:\n            all_enc.add(match.group(1))\n\nprint(f\"Found {len(all_enc)} unique base64 strings\")\nfor idx, enc in enumerate(all_enc):\n    print(f\"--- String {idx} ---\")\n    print(enc[:100] + \"...\")\n    try:\n        # Try padding just in case\n        missing_padding = len(enc) % 4\n        if missing_padding:\n            enc += '=' * (4 - missing_padding)\n        decoded = base64.b64decode(enc).decode('utf-16-le', errors='ignore')\n        print(decoded[:1000])\n    except Exception as e:\n        print(\"Error decoding:\", e)\n\nconn.close()\nEOF\npython3 /tmp/decode_ps.py > /tmp/decoded_output.txt\ncat /tmp/decoded_output.txt\n"]
