[177.294107, "i", "cat << 'EOF' > /tmp/check_sec_procs.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, message \n    FROM events \n    WHERE event_code IN (4656, 4658, 4663, 4690, 4661);\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Total Security events: {len(rows)}\")\n\nproc_counts = {}\nfor row in rows:\n    msg = row[2] or \"\"\n    proc_name = \"Unknown\"\n    for line in msg.split('\\n'):\n        if 'Process Name:' in line:\n            proc_name = line.strip().split()[-1]\n            break\n    proc_counts[proc_name] = proc_counts.get(proc_name, 0) + 1\n\nfor proc, count in proc_counts.items():\n    print(f\"{proc}: {count}\")\n\nconn.close()\nEOF\npython3 /tmp/check_sec_procs.py\n"]
