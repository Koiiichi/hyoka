[184.653697, "i", "cat << 'EOF' > /tmp/check_unknown_sec.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, user, message \n    FROM events \n    WHERE event_code IN (4656, 4658, 4663, 4690, 4661);\n\"\"\")\nfor row in cursor.fetchall():\n    msg = row[4] or \"\"\n    proc_name = \"Unknown\"\n    for line in msg.split('\\n'):\n        if 'Process Name:' in line:\n            proc_name = line.strip().split()[-1]\n            break\n    if proc_name == \"Unknown\":\n        print(f\"ID: {row[0]} | Code: {row[1]} | Host: {row[2]} | User: {row[3]}\")\n        # Print the first few lines of the message\n        lines = [l.strip() for l in msg.split('\\n') if l.strip()][:8]\n        print(\"   Msg summary:\", \" | \".join(lines))\n\nprint(\"\\n--- lsass and WmiPrvSE events ---\")\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, user, message \n    FROM events \n    WHERE event_code IN (4656, 4658, 4663, 4690, 4661);\n\"\"\")\nfor row in cursor.fetchall():\n    msg = row[4] or \"\"\n    proc_name = \"Unknown\"\n    for line in msg.split('\\n'):\n        if 'Process Name:' in line:\n            proc_name = line.strip().split()[-1]\n            break\n    if proc_name in (\"C:\\\\Windows\\\\System32\\\\lsass.exe\", \"C:\\\\Windows\\\\System32\\\\wbem\\\\WmiPrvSE.exe\"):\n        print(f\"ID: {row[0]} | Code: {row[1]} | Host: {row[2]} | User: {row[3]} | Proc: {proc_name}\")\n        lines = [l.strip() for l in msg.split('\\n') if l.strip()][:5]\n        print(\"   Msg:\", \" | \".join(lines))\n\nconn.close()\nEOF\npython3 /tmp/check_unknown_sec.py\n"]
[184.654064, "o", "cat << 'EOF' > /tmp/check_unknown_sec.py\r\n\u001b[?2004l\r"]
[184.654213, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.654415, "o", "cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.65458, "o", "    SELECT event_id, event_code, host, user, message \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.654875, "o", "    FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE event_code IN (4656, 4658, 4663, 4690, 4661);\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.655016, "o", "> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.65517, "o", "for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     msg = row[4] or \"\""]
[184.655225, "o", "\r\n\u001b[?2004l\r"]
[184.65531, "o", "\u001b[?2004h> "]
[184.655559, "o", "    proc_name = \"Unknown\"\r\n\u001b[?2004l\r\u001b[?2004h>     for line in msg.split('\\n'):\r\n\u001b[?2004l\r"]
[184.655579, "o", "\u001b[?2004h> "]
[184.655633, "o", "        if 'Process Name:' in line:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.655825, "o", "            proc_name = line.strip().split()[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.655891, "o", "            break"]
[184.656223, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     if proc_name == \"Unknown\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.656407, "o", "        print(f\"ID: {row[0]} | Code: {row[1]} | Host: {row[2]} | User: {row[3]}\")\r\n\u001b[?2004l\r"]
[184.656521, "o", "\u001b[?2004h"]
[184.656646, "o", "> "]
[184.656754, "o", "        # Print the first few lines of the message\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.656774, "o", "        lines = [l.strip() for l in msg.split('\\n') if l.strip()][:8]\r\n"]
[184.656887, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[184.656914, "o", "        print(\"   Msg summary:\", \" | \".join(lines))\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.656991, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.657034, "o", "print(\"\\n--- lsass and WmiPrvSE events ---\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r"]
[184.657084, "o", "\u001b[?2004h> "]
[184.657193, "o", "    SELECT event_id, event_code, host, user, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.657289, "o", "    WHERE event_code IN (4656, 4658, 4663, 4690, 4661);\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.657347, "o", "for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.657492, "o", "    msg = row[4] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     proc_name = \"Unknown\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.657608, "o", "    for line in msg.split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h>         if 'Process Name:' in line:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.657645, "o", "            proc_name = line.strip().split()[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.657746, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.657773, "o", "    if proc_name in (\"C:\\\\Windows\\\\System32\\\\lsass.exe\", \"C:\\\\Windows\\\\System32\\\\wbem\\\\WmiPrvSE.exe\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.657906, "o", "        print(f\"ID: {row[0]} | Code: {row[1]} | Host: {row[2]} | User: {row[3]} | Proc: {proc_name}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.65801, "o", "> "]
[184.658144, "o", "        lines = [l.strip() for l in msg.split('\\n') if l.strip()][:5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.658198, "o", "        print(\"   Msg:\", \" | \".join(lines))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.658237, "o", "conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[184.659145, "o", "\u001b[?2004hroot@c64bdbbf713d:~# "]
[184.659249, "o", "python3 /tmp/check_unknown_sec.py\r\n\u001b[?2004l\r"]
