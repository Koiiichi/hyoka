[?2004l[?2004h> # Let's get all events from WS-05 and WS-06 and order by timestamp
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, host, user, target_user, 
[?2004l[?2004h>            image, parent_image, command_line, service_name, service_file_name, 
[?2004l[?2004h>            dst_ip, dst_port, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> rows = cursor.fetchall()
