[?2004l[?2004h>     SELECT event_id, event_code, host, user, image, parent_image, command_line, dst_ip, dst_port, message
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE process_guid IN ({placeholder})
[?2004l[?2004h> """, malicious_guids)
[?2004l[?2004h> 
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Total events with malicious process GUIDs: {len(rows)}")
