[?2004hroot@39a2d854e64f:~# cat << 'EOF' > /tmp/hunt.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's get all events from WS-05 and WS-06 and order by timestamp
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, host, user, target_user, 
[?2004l[?2004h>            image, parent_image, command_line, service_name, service_file_name, 
[?2004l[?2004h>            dst_ip, dst_port, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host IN ('WS-05.corp.example', 'WS-06.corp.example', 'WS-06')
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Total events on WS-05/06: {len(rows)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's print interesting non-benign looking events
[?2004l[?2004h> for row in rows:
[?2004l[?2004h>     eid, code, ts, host, user, tuser, img, pimg, cmd, sname, sfile, dst_ip, dst_port, msg = row
[?2004l[?2004h>     
