[75.561252, "o", "cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's get all events from WS-05 and WS-06 and order by timestamp\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, event_code, timestamp, host, user, target_user, \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.561446, "o", "           image, parent_image, command_line, service_name, service_file_name, \r\n\u001b[?2004l\r\u001b[?2004h>            dst_ip, dst_port, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.561557, "o", "    WHERE host IN ('WS-05.corp.example', 'WS-06.corp.example', 'WS-06')\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.561655, "o", "rows = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.56178, "o", "print(f\"Total events on WS-05/06: {len(rows)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.561895, "o", "\u001b[?2004h> "]
[75.563164, "o", "# Let's print interesting non-benign looking events\r\n\u001b[?2004l\r\u001b[?2004h> for row in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     eid, code, ts, host, user, tuser, img, pimg, cmd, sname, sfile, dst_ip, dst_port, msg = row\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Filtering out obvious noise to find the malicious timeline\r\n\u001b[?2004l\r\u001b[?2004h>     if code in (5156, 5158, 4658, 4656, 4690, 4703, 4663, 10):\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # If it is Sysmon 7 (Image load), only print if the image is suspicious\r\n\u001b[?2004l\r\u001b[?2004h>     if code == 7:\r\n\u001b[?2004l\r\u001b[?2004h>         if img and ('whoami' in img.lower() or 'powershell' in img.lower() or 'cmd.exe' in img.lower()):\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{ts} | {host} | EID: {eid} | Code: {code} | User: {user} | Image: {img} | Cmd: {cmd} | Svc: {sname} | Dst: {dst_ip}:{dst_port}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[75.563867, "o", "\u001b[?2004hroot@39a2d854e64f:~# "]
[75.563894, "o", "python3 /tmp/hunt.py > /tmp/timeline.txt\r\n\u001b[?2004l\r"]
[75.588641, "o", "\u001b[?2004hroot@39a2d854e64f:~# head -n 100 /tmp/timeline.txt\r\n\u001b[?2004l\r"]
