[113.218468, "o", "\u001b[?2004hroot@39a2d854e64f:~# "]
[119.390003, "i", "cat << 'EOF' > /tmp/analyze2.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nmalicious_guids = [\n    '{d273d0f0-8078-5f67-cb06-000000000800}', # cmd.exe\n    '{d273d0f0-8078-5f67-cc06-000000000800}', # powershell.exe\n    '{d273d0f0-808e-5f67-cf06-000000000800}'  # whoami.exe\n]\n\n# Let's find all events where process_guid is in malicious_guids\nplaceholder = ', '.join('?' for _ in malicious_guids)\ncursor.execute(f\"\"\"\n    SELECT event_id, event_code, host, user, image, parent_image, command_line, dst_ip, dst_port, message\n    FROM events \n    WHERE process_guid IN ({placeholder})\n\"\"\", malicious_guids)\n\nrows = cursor.fetchall()\nprint(f\"Total events with malicious process GUIDs: {len(rows)}\")\nfor r in rows:\n    print(r[:7], r[7:9])\n\nconn.close()\nEOF\npython3 /tmp/analyze2.py\n"]
[119.390751, "o", "cat << 'EOF' > /tmp/analyze2.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
