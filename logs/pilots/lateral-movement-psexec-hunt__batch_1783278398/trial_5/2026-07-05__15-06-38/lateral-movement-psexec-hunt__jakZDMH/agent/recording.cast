[75.55994, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's get all events from WS-05 and WS-06 and order by timestamp\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, host, user, target_user, \n           image, parent_image, command_line, service_name, service_file_name, \n           dst_ip, dst_port, message \n    FROM events \n    WHERE host IN ('WS-05.corp.example', 'WS-06.corp.example', 'WS-06')\n    ORDER BY timestamp;\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total events on WS-05/06: {len(rows)}\")\n\n# Let's print interesting non-benign looking events\nfor row in rows:\n    eid, code, ts, host, user, tuser, img, pimg, cmd, sname, sfile, dst_ip, dst_port, msg = row\n    \n    # Filtering out obvious noise to find the malicious timeline\n    if code in (5156, 5158, 4658, 4656, 4690, 4703, 4663, 10):\n        continue\n        \n    # If it is Sysmon 7 (Image load), only print if the image is suspicious\n    if code == 7:\n        if img and ('whoami' in img.lower() or 'powershell' in img.lower() or 'cmd.exe' in img.lower()):\n            pass\n        else:\n            continue\n            \n    print(f\"{ts} | {host} | EID: {eid} | Code: {code} | User: {user} | Image: {img} | Cmd: {cmd} | Svc: {sname} | Dst: {dst_ip}:{dst_port}\")\n\nconn.close()\nEOF\npython3 /tmp/hunt.py > /tmp/timeline.txt\nhead -n 100 /tmp/timeline.txt\n"]
[75.560534, "o", "cat << 'EOF' > /tmp/hunt.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
