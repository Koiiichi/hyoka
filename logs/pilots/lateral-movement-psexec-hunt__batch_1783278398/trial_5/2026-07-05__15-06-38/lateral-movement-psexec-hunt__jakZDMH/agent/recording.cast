[244.94704, "i", "cat << 'EOF' > /tmp/validate.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's see if there are any other process creation events (1, 4688) we haven't checked on any host\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, user, image, command_line \n    FROM events \n    WHERE event_code IN (1, 4688) \n      AND event_id NOT IN ('evt-00362', 'evt-00363', 'evt-01057', 'evt-01238', 'evt-01073', 'evt-01240', 'evt-02469', 'evt-02583', 'evt-02901', 'evt-02955', 'evt-02792')\n\"\"\")\nprint(\"Other process creation events:\")\nfor r in cursor.fetchall():\n    print(r)\n\n# Let's check other logons (4624) that might be from m.ward or otherwise suspicious on WS-06 or WS-05\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, user, target_user, logon_type, src_ip \n    FROM events \n    WHERE event_code = 4624 \n      AND event_id NOT IN ('evt-01209')\n\"\"\")\nprint(\"\\nOther logons:\")\nfor r in cursor.fetchall():\n    print(r)\n\n# Let's see if there are any other services created (4697, 7045)\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, service_name, service_file_name \n    FROM events \n    WHERE event_code IN (4697, 7045) \n      AND event_id NOT IN ('evt-01213', 'evt-01251')\n\"\"\")\nprint(\"\\nOther services:\")\nfor r in cursor.fetchall():\n    print(r)\n\nconn.close()\nEOF\npython3 /tmp/validate.py\n"]
