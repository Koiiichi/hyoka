[187.788504, "i", "cat << 'EOF' > /tmp/candidate_list.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's inspect the columns of candidate events to make sure we make an informed decision\ncandidates = [\n    'evt-01209', # 4624 logon to WS-06\n    'evt-01213', # 4697 service 'Updater' created on WS-06\n    'evt-01251', # 7045 service 'Updater' created on WS-06\n    'evt-01057', # Sysmon 1 cmd.exe /C start ... on WS-06\n    'evt-01238', # 4688 powershell -enc on WS-06\n    'evt-01073', # Sysmon 1 powershell -enc on WS-06\n    'evt-02513', # Sysmon 3 powershell network connection to 10.10.10.5:80\n    'evt-02901', # Sysmon 1 whoami.exe on WS-06\n    'evt-02955', # 4688 whoami.exe on WS-06\n    'evt-01367', # Sysmon 3 powershell network connection from WS-05 to WS-06 (port 135)\n    'evt-01370', # Sysmon 3 powershell network connection from WS-05 to WS-06 (port 49726)\n    'evt-01365', # Sysmon 22 DNS query for WS-06 by WS-05 powershell\n    'evt-02625', # Sysmon 22 DNS query by WS-06 powershell\n    'evt-02937', # Sysmon 5 whoami process termination\n    'evt-01076'  # Sysmon 5 cmd process termination\n]\n\ncursor.execute(f\"\"\"\n    SELECT event_id, event_code, host, user, image, parent_image, command_line, dst_ip, dst_port\n    FROM events \n    WHERE event_id IN ({','.join('?' for _ in candidates)})\n    ORDER BY timestamp;\n\"\"\", candidates)\n\nfor r in cursor.fetchall():\n    print(r)\n\nconn.close()\nEOF\npython3 /tmp/candidate_list.py\n"]
[187.78879, "o", "cat << 'EOF' > /tmp/candidate_list.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
