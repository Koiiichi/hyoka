[75.589314, "o", ":15.138Z | WS-06.corp.example | EID: evt-00203 | Code: 12 | User:  | Image: C:\\windows\\System32\\svchost.exe | Cmd:  | Svc:  | Dst: None:None\r\n2026-05-06T00:00:15.139Z | WS-06.corp.example | EID: evt-00204 | Code: 12 | User:  | Image: C:\\windows\\System32\\svchost.exe | Cmd:  | Svc:  | Dst: None:None\r\n2026-05-06T00:00:15.139Z | WS-06.corp.example | EID: evt-00205 | Code: 12 | User:  | Image: C:\\windows\\System32\\svchost.exe | Cmd:  | Svc:  | Dst: None:None\r\n2026-05-06T00:00:15.139Z | WS-06.corp.example | EID: evt-00206 | Code: 12 | User:  | Image: C:\\windows\\System32\\svchost.exe | Cmd:  | Svc:  | Dst: None:None\r\n2026-05-06T00:00:15.141Z | WS-06.corp.example | EID: evt-00207 | Code: 12 | User:  | Image: C:\\windows\\System32\\svchost.exe | Cmd:  | Svc:  | Dst: None:None\r\n2026-05-06T00:00:15.141Z | WS-06.corp.example | EID: evt-00208 | Code: 12 | User:  | Image: C:\\windows\\System32\\svchost.exe | Cmd:  | Svc:  | Dst: None:None\r\n2026-05-06T00:00:15.141Z | WS-06.corp.example | EID: evt-00209 | Code: 12 | User:  | Image: C:\\windows\\System32\\svchost.exe | Cmd:  | Svc:  | Dst: None:None\r\n2026-05-06T00:00:15.141Z | WS-06.corp.example | EID: evt-00210 | Code: 12 | User:  | Image: C:\\windows\\System32\\svchost.exe | Cmd:  | Svc:  | Dst: None:None\r\n2026-05-06T00:00:15.142Z | WS-06.corp.example | EID: evt-00211 | Code: 12 | User:  | Image: C:\\windows\\System32\\svchost.exe | Cmd:  | Svc:  | Dst: None:None\r\n2026-05-06T00:00:15.142Z | WS-06.corp.example | EID: evt-00212 | Code: 12 | User:  | Image: C:\\windows\\System32\\svchost.exe | Cmd:  | Svc:  | Dst: None:None\r\n2026-05-06T00:00:15.143Z | WS-06.corp.example | EID: evt-00213 | Code: 12 | User:  | Image: C:\\windows\\System32\\svchost.exe | Cmd:  | Svc:  | Dst: None:None\r\n\u001b[?2004hroot@39a2d854e64f:~# "]
[81.719073, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's get all events from WS-05 and WS-06 and order by timestamp\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, host, user, target_user, \n           image, parent_image, command_line, service_name, service_file_name, \n           dst_ip, dst_port, message \n    FROM events \n    ORDER BY timestamp;\n\"\"\")\n\nrows = cursor.fetchall()\nprint(f\"Total events: {len(rows)}\")\n\nfor row in rows:\n    eid, code, ts, host, user, tuser, img, pimg, cmd, sname, sfile, dst_ip, dst_port, msg = row\n    \n    # Highly active noise filters\n    if code in (5156, 5158, 4658, 4656, 4690, 4703, 4663, 10, 11, 12, 13):\n        # But keep if they have powershell or other keywords\n        text = str(row).lower()\n        if 'powershell' not in text and 'whoami' not in text and 'updater' not in text and '10.10.10.5' not in text:\n            continue\n            \n    if code == 7:\n        text = str(row).lower()\n        if 'powershell' not in text and 'whoami' not in text and 'updater' not in text:\n            continue\n            \n    print(f\"{ts} | {host} | EID: {eid} | Code: {code} | User: {user} | Image: {img} | Cmd: {cmd} | Svc: {sname} | Dst: {dst_ip}:{dst_port}\")\n\nconn.close()\nEOF\npython3 /tmp/hunt.py > /tmp/timeline.txt\ncat /tmp/timeline.txt\n"]
