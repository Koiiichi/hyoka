[90.845638, "o", "\u001b[?2004hroot@39a2d854e64f:~# "]
[99.906498, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Get all columns for easy inspection\ncursor.execute(\"SELECT * FROM events LIMIT 1\")\ncol_names = [description[0] for description in cursor.description]\n\ndef get_event_dict(row):\n    return dict(zip(col_names, row))\n\n# 1. Process creation on WS-06\n# We know cmd.exe (evt-01057) and powershell.exe (evt-01238) and whoami.exe (evt-02901, evt-02955) are malicious.\n# Let's find their process GUIDs to trace lineage!\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, user, image, parent_image, command_line, process_guid \n    FROM events \n    WHERE event_id IN ('evt-01057', 'evt-01238', 'evt-02901', 'evt-02955')\n\"\"\")\nfor r in cursor.fetchall():\n    print(r)\n\nconn.close()\nEOF\npython3 /tmp/analyze.py\n"]
[99.907098, "o", "cat << 'EOF' > /tmp/analyze.py\r\n\u001b[?2004l\r"]
[99.907144, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.908969, "o", "\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get all columns for easy inspection\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT * FROM events LIMIT 1\")\r\n\u001b[?2004l\r\u001b[?2004h> col_names = [description[0] for description in cursor.description]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def get_event_dict(row):\r\n\u001b[?2004l\r\u001b[?2004h>     return dict(zip(col_names, row))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 1. Process creation on WS-06\r\n\u001b[?2004l\r\u001b[?2004h> # We know cmd.exe (evt-01057) and powershell.exe (evt-01238) and whoami.exe (evt-02901, evt-02955) are malicious.\r\n\u001b[?2004l\r\u001b[?2004h> # Let's find their process GUIDs to trace lineage!\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, event_code, host, user, image, parent_image, command_line, process_guid \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE event_id IN ('evt-01057', 'evt-01238', 'evt-02901', 'evt-02955')\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
