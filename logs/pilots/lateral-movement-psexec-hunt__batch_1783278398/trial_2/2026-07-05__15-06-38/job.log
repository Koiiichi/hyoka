Sending keys: ['cat << \'EOF\' > /root/gather_malicious.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncur = conn.cursor()\n\nmalicious_ids = set()\n\n# 1. PowerShell channel logs (all events from PowerShell on WS-05, WS-06, and WS-06.corp.example)\n# Note: DC01 does not have any powershell logs, but just in case, we query all hosts\ncur.execute("""SELECT event_id FROM events WHERE \n    channel IN (\'Windows PowerShell\', \'Microsoft-Windows-PowerShell/Operational\')""")\nfor (eid,) in cur.fetchall():\n    if eid:\n        malicious_ids.add(eid)\n\n# 2. Every event on any machine where the image contains \'powershell.exe\' or \'powershell\'\ncur.execute("""SELECT event_id FROM events WHERE \n    image LIKE \'%powershell.exe\' OR image LIKE \'%powershell\'""")\nfor (eid,) in cur.fetchall():\n    if eid:\n        malicious_ids.add(eid)\n\n# 3. Service creation, timeout, and logon events on WS-06.corp.example\n# Service creations: evt-01213 (4697), evt-01251 (7045)\n# Service timeouts/failures: evt-01253 (7009), evt-01254 (7000)\n# Logon: evt-01209 (4624)\n# Sysmon 1 stager start: evt-01057\nws06_specific = [\'evt-01213\', \'evt-01251\', \'evt-01253\', \'evt-01254\', \'evt-01209\', \'evt-01057\']\nfor eid in ws06_specific:\n    malicious_ids.add(eid)\n\n# 4. Service registry creation and modification on WS-06.corp.example\n# Registry keys: evt-01050 to evt-01056, and cleanup modifications: evt-01357 to evt-01359\nreg_events = [\n    \'evt-01050\', \'evt-01051\', \'evt-01052\', \'evt-01053\', \'evt-01054\', \'evt-01055\', \'evt-01056\',\n    \'evt-01357\', \'evt-01358\', \'evt-01359\'\n]\nfor eid in reg_events:\n    malicious_ids.add(eid)\n\n# 5. Network connection events representing lateral movement transport\n# Incoming RPC/WMI connections on WS-06: evt-01364 (svchost on 135) and evt-01366 (services on 49726)\n# LSASS outbound ticket request on WS-05: evt-01372\nnetwork_events = [\'evt-01364\', \'evt-01366\', \'evt-01372\']\nfor eid in network_events:\n    malicious_ids.add(eid)\n\n# 6. Ticket request on DC01.corp.example: evt-01222\nmalicious_ids.add(\'evt-01222\')\n\n# Sort and write to findings.json\nfindings = sorted(list(malicious_ids))\nprint(f"Gathered {len(findings)} malicious events.")\nwith open(\'/root/findings.json\', \'w\') as f:\n    json.dump(findings, f)\nEOF\npython3 /root/gather_malicious.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
