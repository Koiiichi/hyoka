[249.45, "o", "onal\r\nevt-03590|12|WS-06.corp.example|Microsoft-Windows-Sysmon/Operational\r\nevt-03629|12|WS-05.corp.example|Microsoft-Windows-Sysmon/Operational\r\nevt-03824|12|WS-06.corp.example|Microsoft-Windows-Sysmon/Operational\r\nevt-04034|12|WS-05.corp.example|Microsoft-Windows-Sysmon/Operational\r\nevt-04064|12|WS-06.corp.example|Microsoft-Windows-Sysmon/Operational\r\nevt-04102|12|WS-05.corp.example|Microsoft-Windows-Sysmon/Operational\r\nevt-04121|12|WS-06.corp.example|Microsoft-Windows-Sysmon/Operational\r\nevt-04158|12|WS-05.corp.example|Microsoft-Windows-Sysmon/Operational\r\nevt-04176|12|WS-06.corp.example|Microsoft-Windows-Sysmon/Operational\r\nevt-04207|12|WS-05.corp.example|Microsoft-Windows-Sysmon/Operational\r\nevt-04342|12|WS-06.corp.example|Microsoft-Windows-Sysmon/Operational\r\n\u001b[?2004hroot@2f0f5cbca338:~# "]
[260.780541, "i", "cat << 'EOF' > /root/gather_malicious.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nmalicious_ids = set()\n\n# 1. PowerShell channel logs (all events from PowerShell on WS-05, WS-06, and WS-06.corp.example)\n# Note: DC01 does not have any powershell logs, but just in case, we query all hosts\ncur.execute(\"\"\"SELECT event_id FROM events WHERE \n    channel IN ('Windows PowerShell', 'Microsoft-Windows-PowerShell/Operational')\"\"\")\nfor (eid,) in cur.fetchall():\n    if eid:\n        malicious_ids.add(eid)\n\n# 2. Every event on any machine where the image contains 'powershell.exe' or 'powershell'\ncur.execute(\"\"\"SELECT event_id FROM events WHERE \n    image LIKE '%powershell.exe' OR image LIKE '%powershell'\"\"\")\nfor (eid,) in cur.fetchall():\n    if eid:\n        malicious_ids.add(eid)\n\n# 3. Service creation, timeout, and logon events on WS-06.corp.example\n# Service creations: evt-01213 (4697), evt-01251 (7045)\n# Service timeouts/failures: evt-01253 (7009), evt-01254 (7000)\n# Logon: evt-01209 (4624)\n# Sysmon 1 stager start: evt-01057\nws06_specific = ['evt-01213', 'evt-01251', 'evt-01253', 'evt-01254', 'evt-01209', 'evt-01057']\nfor eid in ws06_specific:\n    malicious_ids.add(eid)\n\n# 4. Service registry creation and modification on WS-06.corp.example\n# Registry keys: evt-01050 to evt-01056, and cleanup modifications: evt-01357 to evt-01359\nreg_events = [\n    'evt-01050', 'evt-01051', 'evt-01052', 'evt-01053', 'evt-01054', 'evt-01055', 'evt-01056',\n    'evt-01357', 'evt-01358', 'evt-01359'\n]\nfor eid in reg_events:\n    malicious_ids.add(eid)\n\n# 5. Network connection events representing lateral movement transport\n# Incoming RPC/WMI connections on WS-06: evt-01364 (svchost on 135) and evt-01366 (services on 49726)\n# LSASS outbound ticket request on WS-05: evt-01372\nnetwork_events = ['evt-01364', 'evt-01366', 'evt-01372']\nfor eid in network_events:\n    malicious_ids.add(eid)\n\n# 6. Ticket request on DC01.corp.example: evt-01222\nmalicious_ids.add('evt-01222')\n\n# Sort and write to findings.json\nfindings = sorted(list(malicious_ids))\nprint(f\"Gathered {len(findings)} malicious events.\")\nwith open('/root/findings.json', 'w') as f:\n    json.dump(findings, f)\nEOF\npython3 /root/gather_malicious.py\n"]
[260.780928, "o", "cat << 'EOF' > /root/gather_malicious.py\r\n\u001b[?2004l\r"]
[260.780951, "o", "\u001b[?2004h> "]
[260.781054, "o", "import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.781154, "o", "conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> malicious_ids = set()\r\n\u001b[?2004l\r"]
[260.781337, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[260.781415, "o", "> "]
[260.78161, "o", "# 1. PowerShell channel logs (all events from PowerShell on WS-05, WS-06, and WS-06.corp.example)\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.781818, "o", "> "]
[260.781922, "o", "# Note: DC01 does not have any powershell logs, but just in case, we query all hosts\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"\"\"SELECT event_id FROM events WHERE \r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.781965, "o", "    channel IN ('Windows PowerShell', 'Microsoft-Windows-PowerShell/Operational')\"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.781985, "o", "for (eid,) in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.782011, "o", ">     if eid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.782034, "o", "        malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.782056, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.78226, "o", "# 2. Every event on any machine where the image contains 'powershell.exe' or 'powershell'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.78228, "o", "cur.execute(\"\"\"SELECT event_id FROM events WHERE \r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.782536, "o", "    image LIKE '%powershell.exe' OR image LIKE '%powershell'\"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> for (eid,) in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     if eid:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.782724, "o", "# 3. Service creation, timeout, and logon events on WS-06.corp.example\r\n\u001b[?2004l\r"]
[260.782831, "o", "\u001b[?2004h> # Service creations: evt-01213 (4697), evt-01251 (7045)\r\n\u001b[?2004l\r"]
[260.782914, "o", "\u001b[?2004h> # Service timeouts/failures: evt-01253 (7009), evt-01254 (7000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.782943, "o", "# Logon: evt-01209 (4624)\r\n\u001b[?2004l\r\u001b[?2004h> # Sysmon 1 stager start: evt-01057\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.783047, "o", "ws06_specific = ['evt-01213', 'evt-01251', 'evt-01253', 'evt-01254', 'evt-01209', 'evt-01057']"]
[260.78492, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> for eid in ws06_specific:\r\n\u001b[?2004l\r\u001b[?2004h>     malicious_ids.add(eid)"]
[260.785061, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 4. Service registry creation and modification on WS-06.corp.example\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.785191, "o", "# Registry keys: evt-01050 to evt-01056, and cleanup modifications: evt-01357 to evt-01359\r\n\u001b[?2004l\r\u001b[?2004h> reg_events = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.785345, "o", "    'evt-01050', 'evt-01051', 'evt-01052', 'evt-01053', 'evt-01054', 'evt-01055', 'evt-01056',\r\n\u001b[?2004l\r\u001b[?2004h>     'evt-01357', 'evt-01358', 'evt-01359'\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.785444, "o", "for eid in reg_events:\r\n\u001b[?2004l\r\u001b[?2004h>     malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.785519, "o", "# 5. Network connection events representing lateral movement transport\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.785757, "o", "# Incoming RPC/WMI connections on WS-06: evt-01364 (svchost on 135) and evt-01366 (services on 49726)\r\n\u001b[?2004l\r\u001b[?2004h> # LSASS outbound ticket request on WS-05: evt-01372\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.785827, "o", "network_events = ['evt-01364', 'evt-01366', 'evt-01372']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.785885, "o", "for eid in network_events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.785909, "o", "    malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.785978, "o", "# 6. Ticket request on DC01.corp.example: evt-01222\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.786008, "o", "malicious_ids.add('evt-01222')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Sort and write to findings.json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.786125, "o", "findings = sorted(list(malicious_ids))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.786251, "o", "print(f\"Gathered {len(findings)} malicious events.\")\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.786351, "o", "    json.dump(findings, f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.786423, "o", "> EOF\r\n\u001b[?2004l\r"]
[260.787002, "o", "\u001b[?2004hroot@2f0f5cbca338:~# "]
[260.787159, "o", "python3 /root/gather_malicious.py\r\n\u001b[?2004l\r"]
[260.796953, "o", "Gathered 1247 malicious events.\r\n"]
[260.798769, "o", "\u001b[?2004hroot@2f0f5cbca338:~# "]
[265.092327, "i", "head -c 300 /root/findings.json\necho \"\"\ntail -c 100 /root/findings.json\necho \"\"\n"]
[265.092522, "o", "head -c 300 /root/findings.json\r\n\u001b[?2004l\r"]
[265.09323, "o", "[\"evt-00024\", \"evt-00025\", \"evt-00026\", \"evt-00027\", \"evt-00028\", \"evt-00029\", \"evt-00030\", \"evt-00031\", \"evt-00032\", \"evt-00033\", \"evt-00034\", \"evt-00040\", \"evt-00042\", \"evt-00045\", \"evt-00090\", \"evt-00091\", \"evt-00092\", \"evt-00093\", \"evt-00094\", \"evt-00095\", \"evt-00096\", \"evt-00097\", \"evt-00098\", "]
[265.093445, "o", "\u001b[?2004hroot@2f0f5cbca338:~# echo \"\"\r\n\u001b[?2004l\r\r\n\u001b[?2004hroot@2f0f5cbca338:~# tail -c 100 /root/findings.json\r\n\u001b[?2004l\r"]
[265.094747, "o", "t-04217\", \"evt-04218\", \"evt-04220\", \"evt-04221\", \"evt-04222\", \"evt-04223\", \"evt-04224\", \"evt-04342\"]"]
[265.094844, "o", "\u001b[?2004hroot@2f0f5cbca338:~# echo \"\"\r\n\u001b[?2004l\r\r\n\u001b[?2004hroot@2f0f5cbca338:~# "]
