[?2004hroot@2f0f5cbca338:~# cat << 'EOF' > /root/gather_malicious.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> malicious_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> # 1. PowerShell channel logs (all events from PowerShell on WS-05, WS-06, and WS-06.corp.example)
[?2004l[?2004h> # Note: DC01 does not have any powershell logs, but just in case, we query all hosts
[?2004l[?2004h> cur.execute("""SELECT event_id FROM events WHERE 
[?2004l[?2004h>     channel IN ('Windows PowerShell', 'Microsoft-Windows-PowerShell/Operational')""")
[?2004l[?2004h> for (eid,) in cur.fetchall():
[?2004l[?2004h>     if eid:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Every event on any machine where the image contains 'powershell.exe' or 'powershell'
[?2004l[?2004h> cur.execute("""SELECT event_id FROM events WHERE 
[?2004l[?2004h>     image LIKE '%powershell.exe' OR image LIKE '%powershell'""")
[?2004l[?2004h> for (eid,) in cur.fetchall():
[?2004l[?2004h>     if eid:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Service creation, timeout, and logon events on WS-06.corp.example
[?2004l[?2004h> # Service creations: evt-01213 (4697), evt-01251 (7045)
[?2004l[?2004h> # Service timeouts/failures: evt-01253 (7009), evt-01254 (7000)
[?2004l[?2004h> # Logon: evt-01209 (4624)
[?2004l[?2004h> # Sysmon 1 stager start: evt-01057
[?2004l[?2004h> ws06_specific = ['evt-01213', 'evt-01251', 'evt-01253', 'evt-01254', 'evt-01209', 'evt-01057']
[?2004l[?2004h> for eid in ws06_specific:
[?2004l[?2004h>     malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Service registry creation and modification on WS-06.corp.example
[?2004l[?2004h> # Registry keys: evt-01050 to evt-01056, and cleanup modifications: evt-01357 to evt-01359
[?2004l[?2004h> reg_events = [
[?2004l[?2004h>     'evt-01050', 'evt-01051', 'evt-01052', 'evt-01053', 'evt-01054', 'evt-01055', 'evt-01056',
[?2004l[?2004h>     'evt-01357', 'evt-01358', 'evt-01359'
[?2004l[?2004h> ]
[?2004l[?2004h> for eid in reg_events:
[?2004l[?2004h>     malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Network connection events representing lateral movement transport
[?2004l[?2004h> # Incoming RPC/WMI connections on WS-06: evt-01364 (svchost on 135) and evt-01366 (services on 49726)
[?2004l[?2004h> # LSASS outbound ticket request on WS-05: evt-01372
[?2004l[?2004h> network_events = ['evt-01364', 'evt-01366', 'evt-01372']
[?2004l[?2004h> for eid in network_events:
[?2004l[?2004h>     malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> # 6. Ticket request on DC01.corp.example: evt-01222
[?2004l[?2004h> malicious_ids.add('evt-01222')
[?2004l[?2004h> 
[?2004l[?2004h> # Sort and write to findings.json
[?2004l[?2004h> findings = sorted(list(malicious_ids))
[?2004l[?2004h> print(f"Gathered {len(findings)} malicious events.")
[?2004l[?2004h> with open('/root/findings.json', 'w') as f:
[?2004l[?2004h>     json.dump(findings, f)
[?2004l[?2004h> EOF
[?2004l[?2004hroot@2f0f5cbca338:~# python3 /root/gather_malicious.py
[?2004lGathered 1247 malicious events.
[?2004hroot@2f0f5cbca338:~# head -c 300 /root/findings.json
[?2004l["evt-00024", "evt-00025", "evt-00026", "evt-00027", "evt-00028", "evt-00029", "evt-00030", "evt-00031", "evt-00032", "evt-00033", "evt-00034", "evt-00040", "evt-00042", "evt-00045", "evt-00090", "evt-00091", "evt-00092", "evt-00093", "evt-00094", "evt-00095", "evt-00096", "evt-00097", "evt-00098", [?2004hroot@2f0f5cbca338:~# echo ""
[?2004l
[?2004hroot@2f0f5cbca338:~# tail -c 100 /root/findings.json
[?2004lt-04217", "evt-04218", "evt-04220", "evt-04221", "evt-04222", "evt-04223", "evt-04224", "evt-04342"][?2004hroot@2f0f5cbca338:~# echo ""
[?2004l
[?2004hroot@2f0f5cbca338:~# 