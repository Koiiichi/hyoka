[?2004hroot@3169dba63015:~# cat << 'EOF' > parse_ws06.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> curr = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Get all events from WS-06 between 00:00:40 and 00:01:20
[?2004l[?2004h> curr.execute("""SELECT event_id, timestamp, event_code, channel, provider, image, parent_image, command_line, service_name, service_file_name, target_image, target_object, src_ip, dst_ip, dst_port, details, message 
[?2004l[?2004h> FROM events 
[?2004l[?2004h> WHERE host = 'WS-06.corp.example' AND timestamp BETWEEN '2026-05-06T00:00:40Z' AND '2026-05-06T00:01:20Z'
[?2004l[?2004h> ORDER BY timestamp""")
[?2004l[?2004h> 
[?2004l[?2004h> rows = curr.fetchall()
[?2004l[?2004h> print(f"Total events on WS-06 in window: {len(rows)}")
[?2004l[?2004h> 
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     ev_id, ts, code, chan, prov, img, pimg, cmd, s_name, s_file, t_img, t_obj, src, dst, port, det, msg = r
[?2004l[?2004h>     # Summarize
[?2004l[?2004h>     desc = ""
[?2004l[?2004h>     if code == 1 or code == 4688:
[?2004l[?2004h>         desc = f"PROCESS START: img={img} pimg={pimg} cmd={cmd}"
[?2004l[?2004h>     elif code in (7045, 4697, 7009, 7036):
[?2004l[?2004h>         desc = f"SERVICE: s_name={s_name} s_file={s_file} msg={msg}"
[?2004l[?2004h>     elif code == 3:
[?2004l[?2004h>         desc = f"NET: src={src} dst={dst}:{port}"
[?2004l[?2004h>     elif code == 11:
[?2004l[?2004h>         desc = f"FILE CREATE: img={img} target={t_obj or det or msg[:50]}"
[?2004l[?2004h>     elif code == 12 or code == 13 or code == 14:
[?2004l[?2004h>         desc = f"REGISTRY: code={code} img={img} obj={t_obj} det={det}"
[?2004l[?2004h>     elif code == 22:
[?2004l[?2004h>         desc = f"DNS QUERY: img={img} msg={msg[:100]}"
[?2004l[?2004h>     elif code == 4104:
[?2004l[?2004h>         desc = f"POWERSHELL BLOCK: msg={msg[:200]}"
[?2004l[?2004h>     elif code == 4103:
[?2004l[?2004h>         desc = f"POWERSHELL PIPELINE: msg={msg[:100]}"
[?2004l[?2004h>     elif code == 10:
[?2004l[?2004h>         # ProcessAccess - can be noisy, let's only print if it accesses something interesting like lsass or similar, or just skip if too many
[?2004l[?2004h>         if "lsass" in (t_img or "").lower():
[?2004l[?2004h>             desc = f"PROCESS ACCESS LSASS: img={img} target={t_img}"
[?2004l[?2004h>         else:
[?2004l[?2004h>             continue
[?2004l[?2004h>     else:
[?2004l[?2004h>         desc = f"OTHER code={code} chan={chan} msg={msg[:100] if msg else ''}"
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"{ev_id} | {ts} | {code} | {desc}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@3169dba63015:~# python3 parse_ws06.py > summary.txt
[?2004l[?2004hroot@3169dba63015:~# cat summary.txt
