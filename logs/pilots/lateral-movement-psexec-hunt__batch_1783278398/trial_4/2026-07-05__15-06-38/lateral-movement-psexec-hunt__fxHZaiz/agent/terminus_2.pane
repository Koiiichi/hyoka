[?2004l[?2004h> FROM events 
[?2004l[?2004h> WHERE event_code IN (7045, 4697, 7036, 7040) 
[?2004l[?2004h> ORDER BY timestamp""")
[?2004l[?2004h> services = curr.fetchall()
[?2004l[?2004h> print("\n=== SERVICE EVENTS ===")
