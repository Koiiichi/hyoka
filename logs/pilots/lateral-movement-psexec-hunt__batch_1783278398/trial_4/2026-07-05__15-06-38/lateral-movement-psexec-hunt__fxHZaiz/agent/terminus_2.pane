[?2004hroot@3169dba63015:~# cat << 'EOF' > collate_malicious.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> curr = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's collect our highly confidence-malicious event IDs:
[?2004l[?2004h> # 1. WS-05 PowerShell command running Invoke-PsExec
[?2004l[?2004h> # 2. WS-06 logon from WS-05
[?2004l[?2004h> # 3. Service creation (Updater service)
[?2004l[?2004h> # 4. Process creations (cmd.exe, powershell.exe, whoami.exe)
[?2004l[?2004h> # 5. Network connection & DNS query of the stager
[?2004l[?2004h> # 6. PowerShell Script block log
[?2004l[?2004h> 
[?2004l[?2004h> events = [
[?2004l[?2004h>     # 1. WS-05 Lateral Movement Execution
[?2004l[?2004h>     ("evt-01295", "PowerShell 800 - Invoke-PsExec command on WS-05"),
[?2004l[?2004h>     
[?2004l[?2004h>     # 2. WS-06 Incoming Lateral Movement Logon
[?2004l[?2004h>     ("evt-01209", "Security 4624 - Successful Network Logon of m.ward on WS-06 from WS-05"),
[?2004l[?2004h>     
[?2004l[?2004h>     # 3. WS-06 Service Installation (Updater persistence / execution)
[?2004l[?2004h>     ("evt-01055", "Sysmon 13 - Service Registry DisplayName set for Updater"),
[?2004l[?2004h>     ("evt-01213", "Security 4697 - Service Installation of Updater on WS-06"),
[?2004l[?2004h>     ("evt-01214", "Security 4674 - Operation on Privileged Object (Service installation of Updater) by m.ward"),
[?2004l[?2004h>     ("evt-01251", "System 7045 - Service Installation of Updater on WS-06"),
[?2004l[?2004h>     ("evt-01253", "System 7009 - Timeout waiting for Updater service"),
[?2004l[?2004h>     ("evt-01254", "System 7000 - Service Updater failed to start (normal for non-service executables run as services)"),
[?2004l[?2004h>     
[?2004l[?2004h>     # 4. WS-06 Process Creations
[?2004l[?2004h>     ("evt-01057", "Sysmon 1 - Process creation of cmd.exe /C start /b C:\Windows\System32\WindowsPowerShell... (the stager wrapper)"),
[?2004l[?2004h>     ("evt-01073", "Sysmon 1 - Process creation of powershell.exe with stager base64 code"),
[?2004l[?2004h>     ("evt-02901", "Sysmon 1 - Process creation of whoami.exe"),
[?2004l[?2004h>     ("evt-02955", "Security 4688 - Process creation of whoami.exe"),
[?2004l[?2004h>     
[?2004l[?2004h>     # 5. WS-06 PowerShell Script Block Logging
[?2004l[?2004h>     ("evt-01827", "PowerShell 4104 - Script Block Logging of the stager code execution"),
[?2004l[?2004h>     
[?2004l[?2004h>     # 6. WS-06 Network Connection & DNS Query to C2
[?2004l[?2004h>     ("evt-02513", "Sysmon 3 - Network connection from powershell.exe to C2 server 10.10.10.5 on port 80"),
[?2004l[?2004h>     ("evt-02625", "Sysmon 22 - DNS query from powershell.exe (part of C2/stager execution)"),
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> # Let's verify if there are other process creations or interesting commands on WS-06
[?2004l[?2004h> # We'll print the events list with their host & event_code from database
[?2004l[?2004h> for ev_id, desc in events:
[?2004l[?2004h>     curr.execute("SELECT host, event_code, channel FROM events WHERE event_id = ?", (ev_id,))
[?2004l[?2004h>     res = curr.fetchone()
[?2004l[?2004h>     print(f"{ev_id} | {res[0]} | Code: {res[1]} | Chan: {res[2]} | {desc}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@3169dba63015:~# python3 collate_malicious.py
[?2004l/root/collate_malicious.py:30: SyntaxWarning: invalid escape sequence '\W'
