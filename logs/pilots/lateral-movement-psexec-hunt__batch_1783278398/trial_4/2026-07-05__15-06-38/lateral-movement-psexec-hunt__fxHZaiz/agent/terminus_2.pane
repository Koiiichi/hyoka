[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> curr = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> curr.execute("""SELECT event_id, timestamp, host, user, image, parent_image, command_line, event_code 
