[?2004hroot@3169dba63015:~# cat << 'EOF' > dc01_hunt.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> curr = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> curr.execute("""SELECT event_id, timestamp, event_code, channel, host, user, image, parent_image, command_line, message 
[?2004l[?2004h> FROM events 
[?2004l[?2004h> WHERE host = 'DC01.corp.example' 
[?2004l[?2004h> ORDER BY timestamp""")
[?2004l[?2004h> 
[?2004l[?2004h> for r in curr.fetchall():
[?2004l[?2004h>     ev_id, ts, code, chan, host, user, img, pimg, cmd, msg = r
[?2004l[?2004h>     # Truncate
[?2004l[?2004h>     cmd_trunc = cmd[:150] if cmd else ""
[?2004l[?2004h>     msg_trunc = msg[:150].replace('\n', ' ') if msg else ""
[?2004l[?2004h>     print(f"{ev_id} | {ts} | {code} | {chan} | {user} | img:{img} | cmd:{cmd_trunc} | msg:{msg_trunc}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
