[?2004hroot@3169dba63015:~# cat << 'EOF' > ws06_malicious_events.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> curr = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's see the processes and parent process GUIDs for the stager
[?2004l[?2004h> # cmd.exe process GUID: {d273d0f0-8078-5f67-cb06-000000000800} (from check_dns.py)
[?2004l[?2004h> # powershell.exe process GUID: {d273d0f0-8078-5f67-cc06-000000000800} (from check_powershell_starts.py)
[?2004l[?2004h> 
[?2004l[?2004h> guids = ['{d273d0f0-8078-5f67-cb06-000000000800}', '{d273d0f0-8078-5f67-cc06-000000000800}']
[?2004l[?2004h> all_mal_evs = []
[?2004l[?2004h> 
[?2004l[?2004h> for g in guids:
[?2004l[?2004h>     curr.execute("SELECT event_id, event_code, channel, image, message FROM events WHERE process_guid = ?", (g,))
[?2004l[?2004h>     for r in curr.fetchall():
[?2004l[?2004h>         all_mal_evs.append(r)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(all_mal_evs)} events associated with malicious process GUIDs:")
[?2004l[?2004h> for ev in sorted(all_mal_evs, key=lambda x: x[0]):
[?2004l[?2004h>     # Truncate image/msg
[?2004l[?2004h>     img = ev[3] if ev[3] else ""
[?2004l[?2004h>     msg = ev[4][:100].replace('\n', ' ') if ev[4] else ""
[?2004l[?2004h>     print(f"{ev[0]} | Code: {ev[1]} | Chan: {ev[2]} | Img: {img} | Msg: {msg}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
