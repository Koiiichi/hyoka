[170.474861, "o", "    curr.execute(\"SELECT event_id, timestamp, event_code, channel, message FROM events WHERE process_guid = ? ORDER BY timestamp\", (p_guid,))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.475048, "o", "    print(f\"=== Events for process GUID {p_guid} ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
