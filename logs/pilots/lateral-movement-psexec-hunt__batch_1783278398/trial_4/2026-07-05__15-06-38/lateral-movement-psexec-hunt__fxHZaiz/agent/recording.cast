[133.930801, "i", "cat << 'EOF' > list_all_processes.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"SELECT event_id, timestamp, host, user, image, parent_image, command_line, event_code \nFROM events \nWHERE event_code IN (1, 4688)\nORDER BY timestamp\"\"\")\n\nfor r in curr.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | img: {r[4]} | pimg: {r[5]} | cmd: {r[6]}\")\n\nEOF\npython3 list_all_processes.py\n"]
