[194.901489, "i", "cat << 'EOF' > ws06_malicious_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\n# Let's see the processes and parent process GUIDs for the stager\n# cmd.exe process GUID: {d273d0f0-8078-5f67-cb06-000000000800} (from check_dns.py)\n# powershell.exe process GUID: {d273d0f0-8078-5f67-cc06-000000000800} (from check_powershell_starts.py)\n\nguids = ['{d273d0f0-8078-5f67-cb06-000000000800}', '{d273d0f0-8078-5f67-cc06-000000000800}']\nall_mal_evs = []\n\nfor g in guids:\n    curr.execute(\"SELECT event_id, event_code, channel, image, message FROM events WHERE process_guid = ?\", (g,))\n    for r in curr.fetchall():\n        all_mal_evs.append(r)\n\nprint(f\"Found {len(all_mal_evs)} events associated with malicious process GUIDs:\")\nfor ev in sorted(all_mal_evs, key=lambda x: x[0]):\n    # Truncate image/msg\n    img = ev[3] if ev[3] else \"\"\n    msg = ev[4][:100].replace('\\n', ' ') if ev[4] else \"\"\n    print(f\"{ev[0]} | Code: {ev[1]} | Chan: {ev[2]} | Img: {img} | Msg: {msg}\")\n\nEOF\npython3 ws06_malicious_events.py\n"]
[194.902685, "o", "cat << 'EOF' > ws06_malicious_events.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> curr = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's see the processes and parent process GUIDs for the stager\r\n\u001b[?2004l\r\u001b[?2004h> # cmd.exe process GUID: {d273d0f0-8078-5f67-cb06-000000000800} (from check_dns.py)\r\n\u001b[?2004l\r\u001b[?2004h> # powershell.exe process GUID: {d273d0f0-8078-5f67-cc06-000000000800} (from check_powershell_starts.py)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> guids = ['{d273d0f0-8078-5f67-cb06-000000000800}', '{d273d0f0-8078-5f67-cc06-000000000800}']\r\n\u001b[?2004l\r\u001b[?2004h> all_mal_evs = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for g in guids:\r\n\u001b[?2004l\r\u001b[?2004h>     curr.execute(\"SELECT event_id, event_code, channel, image, message FROM events WHERE process_guid = ?\", (g,))\r\n\u001b[?2004l\r\u001b[?2004h>     for r in curr.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>         all_mal_evs.append(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(all_mal_evs)} events associated with malicious process GUIDs:\")\r\n\u001b[?2004l\r\u001b[?2004h> for ev in sorted(all_mal_evs, key=lambda x: x[0]):\r\n\u001b[?2004l\r\u001b[?2004h>     # Truncate image/msg\r\n\u001b[?2004l\r\u001b[?2004h>     img = ev[3] if ev[3] else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     msg = ev[4][:100].replace('\\n', ' ') if ev[4] else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{ev[0]} | Code: {ev[1]} | Chan: {ev[2]} | Img: {img} | Msg: {msg}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
