[146.726546, "i", "cat << 'EOF' > ws05_ps_hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"SELECT event_id, timestamp, event_code, message \nFROM events \nWHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103)\nORDER BY timestamp\"\"\")\n\nfor r in curr.fetchall():\n    ev_id, ts, code, msg = r\n    if 'Invoke-PsExec' in str(msg) or 'Updater' in str(msg) or 'powershell' in str(msg).lower() or 'ward' in str(msg).lower():\n        print(f\"{ev_id} | {ts} | {code} | {str(msg)[:200].strip()}\")\n\nEOF\npython3 ws05_ps_hunt.py\n"]
