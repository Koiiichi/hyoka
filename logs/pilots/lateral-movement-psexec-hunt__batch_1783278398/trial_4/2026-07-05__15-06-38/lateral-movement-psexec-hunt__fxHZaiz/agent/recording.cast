[170.472424, "i", "cat << 'EOF' > check_dns.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT event_id, timestamp, host, event_code, image, message FROM events WHERE event_id = 'evt-02625'\")\nprint(\"=== evt-02625 ===\")\nprint(curr.fetchone())\n\n# Let's search for connections to 10.10.10.5 across the entire database\ncurr.execute(\"SELECT event_id, timestamp, host, event_code, image, src_ip, dst_ip, dst_port FROM events WHERE dst_ip = '10.10.10.5'\")\nprint(\"=== Connections to 10.10.10.5 ===\")\nfor r in curr.fetchall():\n    print(r)\n\n# Let's search for events on WS-06 associated with process GUID of powershell.exe: {d273d0f0-8078-5f67-cb06-000000000800}\n# Wait, let's verify if the powershell stager had a process GUID\ncurr.execute(\"SELECT process_guid FROM events WHERE event_id = 'evt-01057'\")\np_guid = curr.fetchone()[0]\nprint(f\"Stager process GUID: {p_guid}\")\n\nif p_guid:\n    curr.execute(\"SELECT event_id, timestamp, event_code, channel, message FROM events WHERE process_guid = ? ORDER BY timestamp\", (p_guid,))\n    print(f\"=== Events for process GUID {p_guid} ===\")\n    for r in curr.fetchall():\n        print(r[:4])\n\nEOF\npython3 check_dns.py\n"]
