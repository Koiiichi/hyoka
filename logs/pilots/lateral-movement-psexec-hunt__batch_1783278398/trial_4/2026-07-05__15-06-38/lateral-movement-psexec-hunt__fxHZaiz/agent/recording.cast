[35.41503, "i", "cat << 'EOF' > trace3.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"SELECT event_id, timestamp, event_code, channel, host, user, image, parent_image, command_line, message \nFROM events \nWHERE host = 'WS-06.corp.example' AND timestamp BETWEEN '2026-05-06T00:00:40Z' AND '2026-05-06T00:00:52Z'\nORDER BY timestamp\"\"\")\n\nfor r in curr.fetchall():\n    ev_id, ts, code, chan, host, user, img, pimg, cmd, msg = r\n    if cmd and len(cmd) > 100: cmd = cmd[:100] + \"...\"\n    if msg and len(msg) > 100: msg = msg[:100] + \"...\"\n    print(f\"{ev_id} | {ts} | {code} | {chan} | {user} | {img} | {pimg} | {cmd} | {msg}\")\n\nEOF\npython3 trace3.py > ws06_stager.txt\ncat ws06_stager.txt\n"]
