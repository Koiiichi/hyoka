.928Z | 4688 | PROCESS START: img= pimg= cmd=\"C:\\windows\\system32\\whoami.exe\"\r\n\r\nSubject:\r\nSecurity ID:\t\tS-1-5-18\r\nAccou\r\n\r\nSubject :\r\nSecurity ID:\t\tS-1-5-18\r\nAccount Name:\t\tWS-06$\r\n\r\n\r\nSubject:\r\nSecurity ID:\t\tS-1-5-18\r\nAccount Name:\t\tWS-06$\r\n\r\n\r\nSubject:\r\nSecurity ID:\t\tS-1-5-18\r\nAccount Name:\t\tWS-06\r\n\r\nSubject :\r\nSecurity ID:\t\tS-1-5-18\r\nAccount Name:\t\tWS-06$\r\n\r\nevt-02961 | 2026-05-06T00:01:10.930Z | 4689 | OTHER code=4689 chan=security msg=A process has exited.\r\n\r\nSubject:\r\nSecurity ID:\t\tS-1-5-18\r\nAccount Name:\t\tWS-06$\r\nAccount Domain:\r\nevt-03019 | 2026-05-06T00:01:15.003Z | 9 | OTHER code=9 chan=Microsoft-Windows-Sysmon/Operational msg=\r\nevt-03022 | 2026-05-06T00:01:15.006Z | 12 | REGISTRY: code=12 img=C:\\Windows\\System32\\WindowsPowershell\\v1.0\\powershell.exe obj=HKU\\.DEFAULT\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections det=\r\nevt-03090 | 2026-05-06T00:01:16.060Z | 5 | OTHER code=5 chan=Microsoft-Windows-Sysmon/Operational msg=\r\nevt-03108 | 2026-05-06T00:01:16.070Z | 10 | PROCESS ACCESS LSASS: img=C:\\windows\\system32\\svchost.exe target=C:\\windows\\system32\\lsass.exe\r\nevt-03161 | 2026-05-06T00:01:17.107Z | 4689 | OTHER code=4689 chan=security msg=A process has exited.\r\n\r\nSubject:\r\nSecurity ID:\t\tS-1-5-18\r\nAccount Name:\t\tWS-06$\r\nAccount Domain:\r\n\r\nApplication Information:\r\nP\r\n\r\nApplication Information:\r\nProcess ID:\r\n"]
[51.069943, "o", "\u001b[?2004hroot@3169dba63015:~# "]
[59.657275, "i", "cat << 'EOF' > detailed_hunt.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\n# Let's get all process executions\ncurr.execute(\"\"\"SELECT event_id, timestamp, host, user, image, parent_image, command_line, event_code, message\nFROM events \nWHERE event_code IN (1, 4688) \nORDER BY timestamp\"\"\")\n\nprocesses = curr.fetchall()\nprint(\"=== PROCESS CREATIONS ===\")\nfor p in processes:\n    ev_id, ts, host, user, img, pimg, cmd, code, msg = p\n    print(f\"{ev_id} | {ts} | {host} | {user} | img: {img} | pimg: {pimg} | cmd: {cmd}\")\n\n# Let's get service creations or modifications\ncurr.execute(\"\"\"SELECT event_id, timestamp, host, event_code, service_name, service_file_name, message \nFROM events \nWHERE event_code IN (7045, 4697, 7036, 7040) \nORDER BY timestamp\"\"\")\nservices = curr.fetchall()\nprint(\"\\n=== SERVICE EVENTS ===\")\nfor s in services:\n    ev_id, ts, host, code, s_name, s_file, msg = s\n    # Only print interesting ones, or if code is 7045/4697\n    if code in (7045, 4697) or (s_name and 'powershell' in str(s_file).lower()):\n        print(f\"{ev_id} | {ts} | {host} | code: {code} | name: {s_name} | file: {s_file} | msg: {msg}\")\n\n# Let's get PowerShell Script blocks\ncurr.execute(\"\"\"SELECT event_id, timestamp, host, event_code, message \nFROM events \nWHERE event_code = 4104 \nORDER BY timestamp\"\"\")\nps_blocks = curr.fetchall()\nprint(\"\\n=== POWERSHELL SCRIPT BLOCKS ===\")\nfor ps in ps_blocks:\n    ev_id, ts, host, code, msg = ps\n    # Truncate msg to first 300 chars\n    msg_trunc = msg[:300].replace('\\n', ' ') if msg else \"\"\n    print(f\"{ev_id} | {ts} | {host} | msg: {msg_trunc}...\")\n\n# Let's get Network connections\ncurr.execute(\"\"\"SELECT event_id, timestamp, host, event_code, image, src_ip, dst_ip, dst_port \nFROM events \nWHERE event_code IN (3, 5156) \nORDER BY timestamp\"\"\")\nnet = curr.fetchall()\nprint(\"\\n=== NETWORK CONNECTIONS ===\")\nfor n in net:\n    ev_id, ts, host, code, img, src, dst, port = n\n    print(f\"{ev_id} | {ts} | {host} | code: {code} | img: {img} | {src} -> {dst}:{port}\")\n\nEOF\npython3 detailed_hunt.py > detailed_output.txt\ncat detailed_output.txt | grep -v -E \"OfficeC2RClient|Conhost|conhost|chrome|svchost|System\"\n"]
