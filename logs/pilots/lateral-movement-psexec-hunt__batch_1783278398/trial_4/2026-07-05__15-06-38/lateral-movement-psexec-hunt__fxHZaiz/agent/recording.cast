[161.962373, "i", "cat << 'EOF' > check_evt_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\n# Detail of Sysmon 13 (evt-01055)\ncurr.execute(\"SELECT * FROM events WHERE event_id = 'evt-01055'\")\nprint(\"=== evt-01055 ===\")\nprint(curr.fetchone())\n\n# Detail of Sysmon 1 (evt-01057)\ncurr.execute(\"SELECT * FROM events WHERE event_id = 'evt-01057'\")\nprint(\"=== evt-01057 ===\")\nprint(curr.fetchone())\n\n# Let's see what network connections were made by powershell.exe on WS-06.corp.example\ncurr.execute(\"SELECT event_id, timestamp, event_code, image, src_ip, dst_ip, dst_port, message FROM events WHERE host = 'WS-06.corp.example' AND event_code IN (3, 22) ORDER BY timestamp\")\nprint(\"=== WS-06 NET/DNS ===\")\nfor r in curr.fetchall():\n    print(r)\n\nEOF\npython3 check_evt_details.py\n"]
[161.962843, "o", "cat << 'EOF' > check_evt_details.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
