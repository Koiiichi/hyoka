[176.906547, "i", "cat << 'EOF' > find_powershell_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT event_id, timestamp, event_code, channel, host, image, parent_image, command_line, process_guid FROM events WHERE image LIKE '%powershell%' OR command_line LIKE '%powershell%' OR parent_image LIKE '%powershell%'\")\nfor r in curr.fetchall():\n    ev_id, ts, code, chan, host, img, pimg, cmd, guid = r\n    cmd_t = cmd[:100] if cmd else \"\"\n    print(f\"{ev_id} | {ts} | {code} | {chan} | {host} | img:{img} | pimg:{pimg} | cmd:{cmd_t} | guid:{guid}\")\n\nEOF\npython3 find_powershell_events.py\n"]
[176.906825, "o", "cat << 'EOF' > find_powershell_events.py\r\n\u001b[?2004l\r"]
[176.906837, "o", "\u001b[?2004h> "]
