[222.029627, "i", "cat << 'EOF' > ws05_net_conn.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT event_id, timestamp, event_code, image, src_ip, dst_ip, dst_port, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (3, 22) ORDER BY timestamp\")\nfor r in curr.fetchall():\n    print(r)\n\nEOF\npython3 ws05_net_conn.py\n"]
