[127.964955, "i", "cat << 'EOF' > dc01_hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"SELECT event_id, timestamp, event_code, channel, host, user, image, parent_image, command_line, message \nFROM events \nWHERE host = 'DC01.corp.example' \nORDER BY timestamp\"\"\")\n\nfor r in curr.fetchall():\n    ev_id, ts, code, chan, host, user, img, pimg, cmd, msg = r\n    # Truncate\n    cmd_trunc = cmd[:150] if cmd else \"\"\n    msg_trunc = msg[:150].replace('\\n', ' ') if msg else \"\"\n    print(f\"{ev_id} | {ts} | {code} | {chan} | {user} | img:{img} | cmd:{cmd_trunc} | msg:{msg_trunc}\")\n\nEOF\npython3 dc01_hunt.py > dc01_output.txt\ncat dc01_output.txt\n"]
