[91.544008, "i", "cat << 'EOF' > ws05_timeline.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\n# Get all process creations on WS-05\ncurr.execute(\"\"\"SELECT event_id, timestamp, event_code, user, image, parent_image, command_line \nFROM events \nWHERE host = 'WS-05.corp.example' AND event_code IN (1, 4688)\nORDER BY timestamp\"\"\")\n\nprint(\"=== PROCESS CREATIONS ON WS-05 ===\")\nfor r in curr.fetchall():\n    ev_id, ts, code, user, img, pimg, cmd = r\n    if cmd and ('SearchInBing' in cmd or 'OfficeC2RClient' in cmd):\n        continue\n    print(f\"{ev_id} | {ts} | {code} | {user} | img: {img} | pimg: {pimg} | cmd: {cmd}\")\n\n# Get all PowerShell 4104 events on WS-05\ncurr.execute(\"\"\"SELECT event_id, timestamp, event_code, user, message \nFROM events \nWHERE host = 'WS-05.corp.example' AND event_code = 4104\nORDER BY timestamp\"\"\")\n\nprint(\"\\n=== POWERSHELL 4104 ON WS-05 ===\")\nfor r in curr.fetchall():\n    ev_id, ts, code, user, msg = r\n    msg_trunc = msg[:200].replace('\\n', ' ') if msg else \"\"\n    print(f\"{ev_id} | {ts} | {code} | {user} | msg: {msg_trunc}\")\n\nEOF\npython3 ws05_timeline.py\n"]
