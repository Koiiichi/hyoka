[45.468373, "i", "cat << 'EOF' > parse_ws06.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\n# Get all events from WS-06 between 00:00:40 and 00:01:20\ncurr.execute(\"\"\"SELECT event_id, timestamp, event_code, channel, provider, image, parent_image, command_line, service_name, service_file_name, target_image, target_object, src_ip, dst_ip, dst_port, details, message \nFROM events \nWHERE host = 'WS-06.corp.example' AND timestamp BETWEEN '2026-05-06T00:00:40Z' AND '2026-05-06T00:01:20Z'\nORDER BY timestamp\"\"\")\n\nrows = curr.fetchall()\nprint(f\"Total events on WS-06 in window: {len(rows)}\")\n\nfor r in rows:\n    ev_id, ts, code, chan, prov, img, pimg, cmd, s_name, s_file, t_img, t_obj, src, dst, port, det, msg = r\n    # Summarize\n    desc = \"\"\n    if code == 1 or code == 4688:\n        desc = f\"PROCESS START: img={img} pimg={pimg} cmd={cmd}\"\n    elif code in (7045, 4697, 7009, 7036):\n        desc = f\"SERVICE: s_name={s_name} s_file={s_file} msg={msg}\"\n    elif code == 3:\n        desc = f\"NET: src={src} dst={dst}:{port}\"\n    elif code == 11:\n        desc = f\"FILE CREATE: img={img} target={t_obj or det or msg[:50]}\"\n    elif code == 12 or code == 13 or code == 14:\n        desc = f\"REGISTRY: code={code} img={img} obj={t_obj} det={det}\"\n    elif code == 22:\n        desc = f\"DNS QUERY: img={img} msg={msg[:100]}\"\n    elif code == 4104:\n        desc = f\"POWERSHELL BLOCK: msg={msg[:200]}\"\n    elif code == 4103:\n        desc = f\"POWERSHELL PIPELINE: msg={msg[:100]}\"\n    elif code == 10:\n        # ProcessAccess - can be noisy, let's only print if it accesses something interesting like lsass or similar, or just skip if too many\n        if \"lsass\" in (t_img or \"\").lower():\n            desc = f\"PROCESS ACCESS LSASS: img={img} target={t_img}\"\n        else:\n            continue\n    else:\n        desc = f\"OTHER code={code} chan={chan} msg={msg[:100] if msg else ''}\"\n    \n    print(f\"{ev_id} | {ts} | {code} | {desc}\")\n\nEOF\npython3 parse_ws06.py > summary.txt\ncat summary.txt\n"]
[45.469008, "o", "cat << 'EOF' > parse_ws06.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
