[240.71284, "i", "cat << 'EOF' > ws06_registry.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"SELECT event_id, timestamp, event_code, image, target_object, details \nFROM events \nWHERE host = 'WS-06.corp.example' AND event_code IN (12, 13, 14) AND (target_object LIKE '%Updater%' OR details LIKE '%Updater%')\nORDER BY timestamp\"\"\")\nfor r in curr.fetchall():\n    print(r)\n\nEOF\npython3 ws06_registry.py\n"]
