[176.907168, "o", "curr.execute(\"SELECT event_id, timestamp, event_code, channel, host, image, parent_image, command_line, process_guid FROM events WHERE image LIKE '%powershell%' OR command_line LIKE '%powershell%' OR parent_image LIKE '%powershell%'\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.907269, "o", "for r in curr.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     ev_id, ts, code, chan, host, img, pimg, cmd, guid = r\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.907638, "o", "    cmd_t = cmd[:100] if cmd else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{ev_id} | {ts} | {code} | {chan} | {host} | img:{img} | pimg:{pimg} | cmd:{cmd_t} | guid:{guid}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
