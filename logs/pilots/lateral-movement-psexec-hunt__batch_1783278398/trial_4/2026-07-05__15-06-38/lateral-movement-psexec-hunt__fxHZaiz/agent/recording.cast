[256.637202, "i", "cat << 'EOF' > generate_findings.py\nimport json\n\nmalicious_events = [\n    # WS-05\n    \"evt-01295\", # PowerShell 800 - Invoke-PsExec\n    \"evt-01365\", # Sysmon 22 - DNS query for WS-06\n    \"evt-01367\", # Sysmon 3 - TCP connection to WS-06 (135)\n    \"evt-01370\", # Sysmon 3 - TCP connection to WS-06 (49726)\n    \n    # WS-06 inbound network\n    \"evt-01209\", # Security 4624 - Incoming Logon from WS-05\n    \"evt-01364\", # Sysmon 3 - TCP inbound on 135 from WS-05\n    \"evt-01366\", # Sysmon 3 - TCP inbound on 49726 from WS-05\n    \n    # WS-06 Service Registration\n    \"evt-01054\", # Sysmon 13 - Registry value set ImagePath (Updater)\n    \"evt-01055\", # Sysmon 13 - Registry value set DisplayName (Updater)\n    \"evt-01056\", # Sysmon 13 - Registry value set ObjectName (Updater)\n    \"evt-01213\", # Security 4697 - Service installation (Updater)\n    \"evt-01214\", # Security 4674 - Privilege use by m.ward (Updater)\n    \"evt-01251\", # System 7045 - Service installation (Updater)\n    \"evt-01253\", # System 7009 - Service timeout (Updater)\n    \"evt-01254\", # System 7000 - Service failed to start (Updater)\n    \n    # WS-06 Service Deletion / Cleanup\n    \"evt-01357\", # Sysmon 13 - DeleteFlag set on Updater\n    \"evt-01358\", # Sysmon 13 - Start set to disabled on Updater\n    \"evt-01359\", # Sysmon 12 - Registry key Updater deleted\n    \n    # WS-06 Stager wrapper & stager processes\n    \"evt-01057\", # Sysmon 1 - cmd.exe wrapper started by services.exe\n    \"evt-01073\", # Sysmon 1 - powershell.exe stager started by cmd.exe\n    \"evt-01827\", # PowerShell 4104 - Script Block log\n    \n    # WS-06 C2 activity\n    \"evt-02513\", # Sysmon 3 - TCP connection to C2 (10.10.10.5:80)\n    \"evt-02625\", # Sysmon 22 - DNS query by powershell.exe\n    \n    # WS-06 recon\n    \"evt-02901\", # Sysmon 1 - whoami.exe process creation\n    \"evt-02955\", # Security 4688 - whoami.exe process creation\n    \"evt-02957\", # Security 4658 - Handle closed (whoami.exe)\n    \"evt-02958\", # Security 4656 - Handle requested (whoami.exe)\n    \"evt-02959\", # Security 4663 - Object access (whoami.exe)\n    \"evt-02960\", # Security 4658 - Handle closed (whoami.exe)\n    \"evt-02961\", # Security 4689 - Process exit (whoami.exe)\n]\n\n# Sort the events\nmalicious_events.sort()\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(malicious_events, f, indent=2)\n\nprint(f\"Wrote {len(malicious_events)} event IDs to /root/findings.json\")\n\nEOF\npython3 generate_findings.py\n"]
