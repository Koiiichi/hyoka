[151.763466, "i", "cat << 'EOF' > search_keywords.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\nkeywords = ['Invoke-PsExec', 'Updater', 'whoami']\nfor kw in keywords:\n    curr.execute(\"SELECT event_id, timestamp, host, event_code, channel FROM events WHERE message LIKE ? OR details LIKE ? OR command_line LIKE ? OR service_name LIKE ? OR service_file_name LIKE ?\", (f'%{kw}%', f'%{kw}%', f'%{kw}%', f'%{kw}%', f'%{kw}%'))\n    print(f\"=== KEYWORD: {kw} ===\")\n    for r in curr.fetchall():\n        print(r)\n\nEOF\npython3 search_keywords.py\n"]
