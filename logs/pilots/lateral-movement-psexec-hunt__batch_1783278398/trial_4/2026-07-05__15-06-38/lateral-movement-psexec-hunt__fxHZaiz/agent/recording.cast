[51.047187, "i", "cat << 'EOF' > extract_ioc.py\nimport re\n\nwith open('summary.txt', 'r') as f:\n    for line in f:\n        # Skip noisy registry operations from svchost.exe and OfficeC2RClient\n        if 'REGISTRY:' in line and ('svchost.exe' in line or 'OfficeC2RClient' in line or 'Explorer.EXE' in line):\n            continue\n        # Skip noisy OTHER events\n        if 'OTHER code=' in line and ('4656' in line or '4658' in line or '4663' in line or '4690' in line or '5156' in line or '5158' in line or '4703' in line):\n            continue\n        if 'POWERSHELL PIPELINE' in line:\n            continue\n        print(line.strip())\nEOF\npython3 extract_ioc.py\n"]
