[182.34222, "i", "cat << 'EOF' > check_powershell_starts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\nguids = ['{b34bc01c-7dfc-5f67-de11-000000000400}', '{d273d0f0-8078-5f67-cc06-000000000800}']\nfor g in guids:\n    curr.execute(\"SELECT event_id, timestamp, event_code, host, image, parent_image, command_line FROM events WHERE process_guid = ? AND event_code IN (1, 4688, 400)\", (g,))\n    print(f\"=== GUID {g} ===\")\n    print(curr.fetchall())\n\nEOF\npython3 check_powershell_starts.py\n"]
[182.342537, "o", "cat << 'EOF' > check_powershell_starts.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
