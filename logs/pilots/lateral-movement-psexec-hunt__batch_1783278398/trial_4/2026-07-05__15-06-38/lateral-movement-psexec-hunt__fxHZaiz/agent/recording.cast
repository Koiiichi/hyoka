[214.486221, "i", "cat << 'EOF' > ws05_stager_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT COUNT(*), MIN(timestamp), MAX(timestamp) FROM events WHERE process_guid = '{b34bc01c-7dfc-5f67-de11-000000000400}'\")\nprint(\"Stager events on WS-05:\", curr.fetchone())\n\n# Let's see event codes of these events\ncurr.execute(\"SELECT event_code, COUNT(*) FROM events WHERE process_guid = '{b34bc01c-7dfc-5f67-de11-000000000400}' GROUP BY event_code\")\nprint(\"By Event Code:\", curr.fetchall())\n\nEOF\npython3 ws05_stager_events.py\n"]
