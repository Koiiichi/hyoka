[22.633176, "i", "cat << 'EOF' > trace.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\n# Let's get service creation events\ncurr.execute(\"SELECT event_id, timestamp, event_code, host, message FROM events WHERE event_code IN (7045, 4697, 7036)\")\nprint(\"=== Services ===\")\nfor row in curr.fetchall():\n    print(row)\n\n# Let's get process creations\ncurr.execute(\"SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line FROM events WHERE event_code IN (1, 4688)\")\nprint(\"=== Process Creations ===\")\nfor row in curr.fetchall():\n    print(row)\n\nEOF\npython3 trace.py\n"]
