[77.22056, "i", "cat << 'EOF' > pivot_hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\n# Look for logons, remote shares, etc. around the service creation\ncurr.execute(\"\"\"SELECT event_id, timestamp, event_code, channel, host, user, logon_type, src_ip, dst_ip, message \nFROM events \nWHERE timestamp BETWEEN '2026-05-06T00:00:20Z' AND '2026-05-06T00:00:50Z'\n  AND (host = 'WS-06.corp.example' OR host = 'WS-05.corp.example')\nORDER BY timestamp\"\"\")\n\nfor r in curr.fetchall():\n    ev_id, ts, code, chan, host, user, l_type, src, dst, msg = r\n    if code in (4624, 4625, 5140, 5145, 4697, 7045) or 'Updater' in str(msg) or 'Admin' in str(msg):\n        print(f\"{ev_id} | {ts} | {host} | code:{code} | user:{user} | l_type:{l_type} | src:{src} | dst:{dst} | msg[:100]: {str(msg)[:100].strip()}\")\n\nEOF\npython3 pivot_hunt.py\n"]
