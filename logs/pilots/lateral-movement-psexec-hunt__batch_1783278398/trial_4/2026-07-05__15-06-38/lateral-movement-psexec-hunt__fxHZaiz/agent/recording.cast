[70.566818, "i", "cat << 'EOF' > get_service.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT event_id, timestamp, event_code, host, service_name, service_file_name, message FROM events WHERE service_name LIKE '%Updater%' OR message LIKE '%Updater%' OR service_file_name LIKE '%powershell%'\")\nfor r in curr.fetchall():\n    print(r[:6])\n\nEOF\npython3 get_service.py\n"]
