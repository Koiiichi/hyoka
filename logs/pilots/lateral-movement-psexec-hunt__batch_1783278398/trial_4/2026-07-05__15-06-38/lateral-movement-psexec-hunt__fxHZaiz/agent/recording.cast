[170.474202, "o", "# Wait, let's verify if the powershell stager had a process GUID\r\n\u001b[?2004l\r"]
[170.474224, "o", "\u001b[?2004h> "]
[170.474389, "o", "curr.execute(\"SELECT process_guid FROM events WHERE event_id = 'evt-01057'\")\r\n\u001b[?2004l\r"]
[170.474563, "o", "\u001b[?2004h> "]
[170.474657, "o", "p_guid = curr.fetchone()[0]\r\n\u001b[?2004l\r"]
