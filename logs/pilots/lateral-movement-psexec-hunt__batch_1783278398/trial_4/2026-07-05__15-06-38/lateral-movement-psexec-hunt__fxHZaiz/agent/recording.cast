[85.372905, "i", "cat << 'EOF' > ws05_hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\n# Get all process executions and PowerShell block logging on WS-05\ncurr.execute(\"\"\"SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, message \nFROM events \nWHERE host = 'WS-05.corp.example' \n  AND (event_code IN (1, 4688, 4104, 800, 7045, 4697) OR message LIKE '%powershell%')\nORDER BY timestamp\"\"\")\n\nfor r in curr.fetchall():\n    ev_id, ts, code, user, img, pimg, cmd, msg = r\n    # filter out some noisy Windows Search / Bing stuff if possible, but let's see them first\n    if cmd and ('SearchInBing' in cmd or 'OfficeC2RClient' in cmd):\n        continue\n    cmd_trunc = cmd[:150] if cmd else \"\"\n    msg_trunc = msg[:150].replace('\\n', ' ') if msg else \"\"\n    print(f\"{ev_id} | {ts} | {code} | {user} | img:{img} | cmd:{cmd_trunc} | msg:{msg_trunc}\")\n\nEOF\npython3 ws05_hunt.py > ws05_output.txt\ncat ws05_output.txt\n"]
[85.373337, "o", "cat << 'EOF' > ws05_hunt.py\r\n\u001b[?2004l\r"]
[85.374405, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> curr = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get all process executions and PowerShell block logging on WS-05\r\n\u001b[?2004l\r\u001b[?2004h> curr.execute(\"\"\"SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, message \r\n\u001b[?2004l\r\u001b[?2004h> FROM events \r\n\u001b[?2004l\r\u001b[?2004h> WHERE host = 'WS-05.corp.example' \r\n\u001b[?2004l\r\u001b[?2004h>   AND (event_code IN (1, 4688, 4104, 800, 7045, 4697) OR message LIKE '%powershell%')\r\n\u001b[?2004l\r\u001b[?2004h> ORDER BY timestamp\"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for r in curr.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     ev_id, ts, code, user, img, pimg, cmd, msg = r\r\n\u001b[?2004l\r\u001b[?2004h>     # filter out some noisy Windows Search / Bing stuff if possible, but let's see them first\r\n\u001b[?2004l\r\u001b[?2004h>     if cmd and ('SearchInBing' in cmd or 'OfficeC2RClient' in cmd):\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     cmd_trunc = cmd[:150] if cmd else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     msg_trunc = msg[:150].replace('\\n', ' ') if msg else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{ev_id} | {ts} | {code} | {user} | img:{img} | cmd:{cmd_trunc} | msg:{msg_trunc}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
