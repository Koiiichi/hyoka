Sending keys: ['cat << \'EOF\' > collate_malicious.py\nimport sqlite3\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncurr = conn.cursor()\n\n# Let\'s collect our highly confidence-malicious event IDs:\n# 1. WS-05 PowerShell command running Invoke-PsExec\n# 2. WS-06 logon from WS-05\n# 3. Service creation (Updater service)\n# 4. Process creations (cmd.exe, powershell.exe, whoami.exe)\n# 5. Network connection & DNS query of the stager\n# 6. PowerShell Script block log\n\nevents = [\n    # 1. WS-05 Lateral Movement Execution\n    ("evt-01295", "PowerShell 800 - Invoke-PsExec command on WS-05"),\n    \n    # 2. WS-06 Incoming Lateral Movement Logon\n    ("evt-01209", "Security 4624 - Successful Network Logon of m.ward on WS-06 from WS-05"),\n    \n    # 3. WS-06 Service Installation (Updater persistence / execution)\n    ("evt-01055", "Sysmon 13 - Service Registry DisplayName set for Updater"),\n    ("evt-01213", "Security 4697 - Service Installation of Updater on WS-06"),\n    ("evt-01214", "Security 4674 - Operation on Privileged Object (Service installation of Updater) by m.ward"),\n    ("evt-01251", "System 7045 - Service Installation of Updater on WS-06"),\n    ("evt-01253", "System 7009 - Timeout waiting for Updater service"),\n    ("evt-01254", "System 7000 - Service Updater failed to start (normal for non-service executables run as services)"),\n    \n    # 4. WS-06 Process Creations\n    ("evt-01057", "Sysmon 1 - Process creation of cmd.exe /C start /b C:\\Windows\\System32\\WindowsPowerShell... (the stager wrapper)"),\n    ("evt-01073", "Sysmon 1 - Process creation of powershell.exe with stager base64 code"),\n    ("evt-02901", "Sysmon 1 - Process creation of whoami.exe"),\n    ("evt-02955", "Security 4688 - Process creation of whoami.exe"),\n    \n    # 5. WS-06 PowerShell Script Block Logging\n    ("evt-01827", "PowerShell 4104 - Script Block Logging of the stager code execution"),\n    \n    # 6. WS-06 Network Connection & DNS Query to C2\n    ("ev