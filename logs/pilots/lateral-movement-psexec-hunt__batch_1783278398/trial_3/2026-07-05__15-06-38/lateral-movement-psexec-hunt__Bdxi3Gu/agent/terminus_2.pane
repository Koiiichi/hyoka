[?2004hroot@b8637b54f4c1:~# cat << 'EOF' > timeline.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Query events on WS-05 and WS-06 during the time range
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, service_name, service_file_name, src_ip, dst_ip, dst_port, details
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE (host LIKE 'WS-05%' OR host LIKE 'WS-06%')
[?2004l[?2004h>       AND timestamp >= '2026-05-06T00:00:30'
[?2004l[?2004h>       AND timestamp <= '2026-05-06T00:01:10'
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     d = dict(r)
[?2004l[?2004h>     d = {k: v for k, v in d.items() if v is not None and v != ''}
[?2004l[?2004h>     # Skip very noisy events if they are obviously benign. 
[?2004l[?2004h>     # Let's see how many there are first.
[?2004l[?2004h>     print(f"{d.get('timestamp')} | {d.get('host')} | {d.get('event_code')} | ID: {d.get('event_id')}")
[?2004l[?2004h>     print(json.dumps(d, indent=2))
[?2004l[?2004h>     print("-"*40)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@b8637b54f4c1:~# python3 timeline.py > /tmp/timeline.txt
[?2004l[?2004hroot@b8637b54f4c1:~# wc -l /tmp/timeline.txt
[?2004l21973 /tmp/timeline.txt
[?2004hroot@b8637b54f4c1:~# cat << 'EOF' > filter_timeline.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # We filter for Event Codes: 1, 4688, 3, 11, 4624 (type 3/10), 4697, 7045, 4104
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, service_name, service_file_name, src_ip, dst_ip, dst_port, details
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE (host LIKE 'WS-05%' OR host LIKE 'WS-06%')
[?2004l[?2004h>       AND timestamp >= '2026-05-06T00:00:30'
[?2004l[?2004h>       AND timestamp <= '2026-05-06T00:01:10'
[?2004l[?2004h>       AND event_code IN (1, 4688, 3, 11, 4624, 4697, 7045, 4104)
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     d = dict(r)
[?2004l[?2004h>     d = {k: v for k, v in d.items() if v is not None and v != ''}
[?2004l[?2004h>     
[?2004l[?2004h>     # For 4624, only show logon type 3/10 or non-standard local system
[?2004l[?2004h>     if d.get('event_code') == 4624:
[?2004l[?2004h>         # Skip machine account logins to minimize noise if we can, but let's be careful.
[?2004l[?2004h>         user = d.get('user', '')
[?2004l[?2004h>         if 'WS-05$' in user or 'WS-06$' in user or 'ANONYMOUS' in user:
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h>     print(f"{d.get('timestamp')} | {d.get('host')} | {d.get('event_code')} | ID: {d.get('event_id')}")
[?2004l[?2004h>     print(json.dumps(d, indent=2))
[?2004l[?2004h>     print("-"*40)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@b8637b54f4c1:~# python3 filter_timeline.py > /tmp/clean_timeline.txt
[?2004l[?2004hroot@b8637b54f4c1:~# cat /tmp/clean_timeline.txt
