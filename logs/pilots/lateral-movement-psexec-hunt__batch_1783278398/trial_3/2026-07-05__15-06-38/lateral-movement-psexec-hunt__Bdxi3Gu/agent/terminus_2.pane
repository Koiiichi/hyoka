[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # We will select events that are clearly related to this intrusion:
[?2004l[?2004h> # 1. On WS-05:
[?2004l[?2004h> # - PowerShell logs (800, 4103) executing the stager, Invoke-PsExec, and the API calls.
[?2004l[?2004h> #   Let's fetch all 800 and 4103 events on WS-05 during the entire time. Since the entire PowerShell session on WS-05 is the attacker's agent, all 800 and 4103 events on WS-05 of this PowerShell session are malicious.
[?2004l[?2004h> #   Let's check the HostId of the powershell process on WS-05.
[?2004l[?2004h> #   The HostId was '1c1cb5c9-d305-49c1-9d7f-e864a6237819'. Let's verify if there are other HostIds.
[?2004l[?2004h> # 2. On WS-06:
[?2004l[?2004h> # - Logon event (4624) for m.ward at 00:00:48.850Z (evt-01209)
[?2004l[?2004h> # - Service install event (4697) for Updater (evt-01213)
[?2004l[?2004h> # - Service timeout/failure (7009, 7000): evt-01253, evt-01254
[?2004l[?2004h> # - Process creation (1/4688) for cmd.exe / powershell stager: evt-01057
[?2004l[?2004h> # - PowerShell script block (4104): evt-01827
[?2004l[?2004h> # - Network connection (3) to 10.10.10.5: evt-02513
[?2004l[?2004h> # - Process creation (1) for whoami.exe: evt-02901
[?2004l[?2004h> # - Any Sysmon events related to cmd.exe/powershell.exe stager process or whoami on WS-06.
[?2004l[?2004h> 
[?2004l[?2004h> # Let's write a python script to search and identify all these and print them.
[?2004l[?2004h> 
[?2004l[?2004h> print("=== WS-05 Host IDs ===")
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT DISTINCT 
[?2004l[?2004h>         SUBSTR(message, INSTR(message, 'HostId=') + 7, 36) AS host_id
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host LIKE 'WS-05%' AND event_code IN (800, 4103) AND message LIKE '%HostId=%'
[?2004l[?2004h> """)
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(r)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@b8637b54f4c1:~# python3 find_malicious_ids.py
[?2004l=== WS-05 Host IDs ===
