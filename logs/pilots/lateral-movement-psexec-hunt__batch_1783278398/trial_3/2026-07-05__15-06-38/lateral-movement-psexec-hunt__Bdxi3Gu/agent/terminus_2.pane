[?2004hroot@b8637b54f4c1:~# cat << 'EOF' > parse_ps_hosts.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> for hid in ['1c1cb5c9-d305-49c1-9d7f-e864a6237819', '31ad459d-aec0-455f-bfd8-4ad41aacd9c0']:
[?2004l[?2004h>     print(f"\n=== Host ID {hid} ===")
[?2004l[?2004h>     cursor.execute("""
[?2004l[?2004h>         SELECT event_id, timestamp, event_code, message 
[?2004l[?2004h>         FROM events 
[?2004l[?2004h>         WHERE host LIKE 'WS-05%' AND event_code IN (800, 4103) AND message LIKE ?
[?2004l[?2004h>         ORDER BY timestamp
[?2004l[?2004h>     """, ('%' + hid + '%',))
[?2004l[?2004h>     rows = cursor.fetchall()
