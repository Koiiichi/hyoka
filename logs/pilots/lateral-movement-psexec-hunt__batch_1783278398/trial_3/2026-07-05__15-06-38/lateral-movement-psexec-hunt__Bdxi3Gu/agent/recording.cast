[91.274914, "o", "\u001b[?2004hroot@b8637b54f4c1:~# "]
[98.933405, "i", "cat << 'EOF' > parse_ps_ws05.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Fetch all event 800 and 4103 on WS-05\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, message \n    FROM events \n    WHERE host LIKE 'WS-05%' AND event_code IN (800, 4103) \n    ORDER BY timestamp\n\"\"\")\n\nseen = set()\nfor r in cursor.fetchall():\n    ev_id, ts, code, msg = r\n    # Try to extract the command line or payload\n    # In event 800: \"Pipeline execution details for command line: <cmd>\"\n    # In event 4103: \"CommandInvocation(<cmd>): <details>\"\n    # Let's clean and print\n    lines = msg.split('\\n')\n    cmd_line = \"\"\n    for line in lines:\n        if \"Pipeline execution details for command line:\" in line:\n            cmd_line = line.split(\"Pipeline execution details for command line:\")[1].strip()\n            break\n        elif \"CommandInvocation\" in line:\n            cmd_line = line.strip()\n            break\n    if not cmd_line:\n        # Just take the first few non-empty lines of message\n        non_empty = [l.strip() for l in lines if l.strip()]\n        cmd_line = \" | \".join(non_empty[:2])\n        \n    if cmd_line not in seen:\n        seen.add(cmd_line)\n        print(f\"{ts} | {code} | {ev_id} | {cmd_line[:200]}\")\n\nEOF\npython3 parse_ps_ws05.py\n"]
[98.933954, "o", "cat << 'EOF' > parse_ps_ws05.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
