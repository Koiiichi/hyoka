[11.218714, "i", "cat << 'EOF' > dump_events.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ninteresting_codes = [1, 3, 11, 17, 18, 22, 23, 4104, 4624, 4688, 4697, 5140, 5145, 7045]\ncodes_str = ','.join(map(str, interesting_codes))\n\ncursor.execute(f\"SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, service_name, service_file_name, target_image, src_ip, dst_ip, dst_port, details, message FROM events WHERE event_code IN ({codes_str}) ORDER BY timestamp\")\n\nfor r in cursor.fetchall():\n    d = dict(r)\n    # filter out None values for readability\n    d = {k: v for k, v in d.items() if v is not None}\n    print(json.dumps(d, indent=2))\n\nEOF\npython3 dump_events.py > /tmp/dumped_events.json\nhead -n 100 /tmp/dumped_events.json\n"]
[11.218977, "o", "cat << 'EOF' > dump_events.py\r\n\u001b[?2004l\r"]
[11.218997, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
