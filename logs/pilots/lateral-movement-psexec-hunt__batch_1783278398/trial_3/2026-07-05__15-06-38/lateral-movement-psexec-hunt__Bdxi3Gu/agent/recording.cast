[35.401565, "i", "cat << 'EOF' > decode.py\nimport base64\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"SELECT command_line FROM events WHERE event_id = 'evt-01057'\")\nrow = cursor.fetchone()\nif row:\n    cmd = row[0]\n    # Extract base64 part\n    parts = cmd.split('-enc')\n    if len(parts) > 1:\n        b64 = parts[1].strip()\n        # Decode unicode bytes\n        decoded = base64.b64decode(b64).decode('utf-16-le', errors='ignore')\n        print(decoded)\nEOF\npython3 decode.py\n"]
