[116.282162, "i", "cat << 'EOF' > parse_ps_hosts.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nfor hid in ['1c1cb5c9-d305-49c1-9d7f-e864a6237819', '31ad459d-aec0-455f-bfd8-4ad41aacd9c0']:\n    print(f\"\\n=== Host ID {hid} ===\")\n    cursor.execute(\"\"\"\n        SELECT event_id, timestamp, event_code, message \n        FROM events \n        WHERE host LIKE 'WS-05%' AND event_code IN (800, 4103) AND message LIKE ?\n        ORDER BY timestamp\n    \"\"\", ('%' + hid + '%',))\n    rows = cursor.fetchall()\n    print(f\"Total events: {len(rows)}\")\n    seen = set()\n    for r in rows[:20]:\n        ev_id, ts, code, msg = r\n        # Extract command line\n        lines = msg.split('\\n')\n        cmd = \"\"\n        for l in lines:\n            if \"Pipeline execution details for command line:\" in l:\n                cmd = l.split(\"Pipeline execution details for command line:\")[1].strip()\n                break\n        if not cmd:\n            non_empty = [l.strip() for l in lines if l.strip()]\n            cmd = \" | \".join(non_empty[:2])\n        if cmd not in seen:\n            seen.add(cmd)\n            print(f\"  {ts} | {code} | {ev_id} | {cmd[:150]}\")\n\nEOF\npython3 parse_ps_hosts.py\n"]
