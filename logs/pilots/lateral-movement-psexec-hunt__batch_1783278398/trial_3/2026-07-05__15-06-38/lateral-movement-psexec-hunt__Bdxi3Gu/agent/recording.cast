[98.934196, "o", "> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r"]
[98.936207, "o", "\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Fetch all event 800 and 4103 on WS-05\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, event_code, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host LIKE 'WS-05%' AND event_code IN (800, 4103) \r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> seen = set()\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     ev_id, ts, code, msg = r\r\n\u001b[?2004l\r\u001b[?2004h>     # Try to extract the command line or payload\r\n\u001b[?2004l\r\u001b[?2004h>     # In event 800: \"Pipeline execution details for command line: <cmd>\"\r\n\u001b[?2004l\r\u001b[?2004h>     # In event 4103: \"CommandInvocation(<cmd>): <details>\"\r\n\u001b[?2004l\r\u001b[?2004h>     # Let's clean and print\r\n\u001b[?2004l\r\u001b[?2004h>     lines = msg.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd_line = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h>         if \"Pipeline execution details for command line:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>             cmd_line = line.split(\"Pipeline execution details for command line:\")[1].strip()\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>         elif \"CommandInvocation\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>             cmd_line = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>     if not cmd_line:\r\n\u001b[?2004l\r\u001b[?2004h>         # Just take the first few non-empty lines of message\r\n\u001b[?2004l\r\u001b[?2004h>         non_empty = [l.strip() for l in lines if l.strip()]\r\n\u001b[?2004l\r\u001b[?2004h>         cmd_line = \" | \".join(non_empty[:2])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     if cmd_line not in seen:\r\n\u001b[?2004l\r\u001b[?2004h>         seen.add(cmd_line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
