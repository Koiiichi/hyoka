[11.234349, "o", "{\r\n  \"event_id\": \"evt-00289\",\r\n  \"timestamp\": \"2026-05-06T00:00:20.206Z\",\r\n  \"event_code\": 4624,\r\n  \"host\": \"DC01.corp.example\",\r\n  \"user\": \"-\",\r\n  \"image\": \"\",\r\n  \"parent_image\": \"\",\r\n  \"command_line\": \"\",\r\n  \"service_name\": \"\",\r\n  \"service_file_name\": \"\",\r\n  \"target_image\": \"\",\r\n  \"src_ip\": \"::1\",\r\n  \"details\": \"\",\r\n  \"message\": \"An account was successfully logged on.\\r\\n\\r\\nSubject:\\r\\n\\tSecurity ID:\\t\\tS-1-0-0\\r\\n\\tAccount Name:\\t\\t-\\r\\n\\tAccount Domain:\\t\\t-\\r\\n\\tLogon ID:\\t\\t0x0\\r\\n\\r\\nLogon Information:\\r\\n\\tLogon Type:\\t\\t3\\r\\n\\tRestricted Admin Mode:\\t-\\r\\n\\tVirtual Account:\\t\\tNo\\r\\n\\tElevated Token:\\t\\tYes\\r\\n\\r\\nImpersonation Level:\\t\\tImpersonation\\r\\n\\r\\nNew Logon:\\r\\n\\tSecurity ID:\\t\\tS-1-5-18\\r\\n\\tAccount Name:\\t\\tDC01$\\r\\n\\tAccount Domain:\\t\\tCORP.LOCAL\\r\\n\\tLogon ID:\\t\\t0x4B0AD12\\r\\n\\tLinked Logon ID:\\t\\t0x0\\r\\n\\tNetwork Account Name:\\t-\\r\\n\\tNetwork Account Domain:\\t-\\r\\n\\tLogon GUID:\\t\\t{522fdbd8-3086-ab92-67c8-817020489547}\\r\\n\\r\\nProcess Information:\\r\\n\\tProcess ID:\\t\\t0x0\\r\\n\\tProcess Name:\\t\\t-\\r\\n\\r\\nNetwork Information:\\r\\n\\tWorkstation Name:\\t-\\r\\n\\tSource Network Address:\\t::1\\r\\n\\tSource Port:\\t\\t52986\\r\\n\\r\\nDetailed Authentication Information:\\r\\n\\tLogon Process:\\t\\tKerberos\\r\\n\\tAuthentication Package:\\tKerberos\\r\\n\\tTransited Services:\\t-\\r\\n\\tPackage Name (NTLM only):\\t-\\r\\n\\tKey Length:\\t\\t0\\r\\n\\r\\nThis event is generated when a logon session is created. It is generated on the computer that was accessed.\\r\\n\\r\\nThe subject fields indicate the account on the local system which requested the logon. This is most commonly a service such as the Server service, or a local process such as Winlogon.exe or Services.exe.\\r\\n\\r\\nThe logon type field indicates the kind of logon that occurred. The most common types are 2 (interactive) and 3 (network).\\r\\n\\r\\nThe New Logon fields indicate the account for whom the new logon was created, i.e. the account that was logged on.\\r\\n\\r\\nThe network fields indicate where a remote logon request originated. Workstation name is not always available and may be left blank in some cases.\\r\\n\\r\\nThe impersonation level field indicates the extent to which a process in the logon session can impersonate.\\r\\n\\r\\nThe authentication information fields provide detailed information about this specific logon request.\\r\\n\\t- Logon GUID is a unique identifier that can be used to correlate this event with a KDC event.\\r\\n\\t- Transited services indicate which intermediate services have participated in this logon request.\\r\\n\\t-\"\r\n}\r\n{\r\n  \"event_id\": \"evt-00362\",\r\n  \"timestamp\": \"2026-05-06T00:00:30.263Z\",\r\n  \"event_code\": 4688,\r\n  \"host\": \"WS-06.corp.example\",\r\n  \"user\": \"WS-06$\",\r\n  \"image\": \"\",\r\n  \"parent_image\": \"\",\r\n  \"command_line\": \"\\\"C:\\\\Program Files\\\\Common Files\\\\Microsoft Shared\\\\ClickToRun\\\\OfficeC2RClient.exe\\\" /frequentupdate SCHEDULEDTASK displaylevel=False\",\r\n  \"service_name\": \"\",\r\n  \"service_file_name\": \"\",\r\n  \"target_image\": \"\",\r\n  \"details\": \"\",\r\n  \"message\": \"A new process has been created.\\r\\n\\r\\nCreator Subject:\\r\\n\\tSecurity ID:\\t\\tS-1-5-18\\r\\n\\tAccount Name:\\t\\tWS-06$\\r\\n\\tAccount Domain:\\t\\tCORP\\r\\n\\tLogon ID:\\t\\t0x3E7\\r\\n\\r\\nTarget Subject:\\r\\n\\tSecurity ID:\\t\\tS-1-0-0\\r\\n\\tAccount Name:\\t\\t-\\r\\n\\tAccount Domain:\\t\\t-\\r\\n\\tLogon ID:\\t\\t0x0\\r\\n\\r\\nProcess Information:\\r\\n\\tNew Process ID:\\t\\t0xfec\\r\\n\\tNew Process Name:\\tC:\\\\Program Files\\\\Common Files\\\\microsoft shared\\\\ClickToRun\\\\OfficeC2RClient.exe\\r\\n\\tToken Elevation Type:\\t%%1936\\r\\n\\tMandatory Label:\\t\\tS-1-16-16384\\r\\n\\tCreator Process ID:\\t0x4a0\\r\\n\\tCreator Process Name:\\tC:\\\\Windows\\\\System32\\\\svchost.exe\\r\\n\\tProcess Command Line:\\t\\\"C:\\\\Program Files\\\\Common Files\\\\Microsoft Shared\\\\ClickToRun\\\\OfficeC2RClient.exe\\\" /frequentupdate SCHEDULEDTASK displaylevel=False\\r\\n\\r\\nToken Elevation Type indicates the type of token that was assigned to the new process in accordance with User Account Control policy.\\r\\n\\r\\nType 1 is a full token with no privileges removed or groups disabled.  A full token is only used if User Account Control is disabled or if the user is the built-in Administrator acco"]
[11.234382, "o", "unt or a service account.\\r\\n\\r\\nType 2 is an elevated token with no privileges removed or groups disabled.  An elevated token is used when User Account Control is enabled and the user chooses to start the program using Run as administrator.  An elevated token is also used when an application is configured to always require administrative privilege or to always require maximum privilege, and the user is a member of the Administrators group.\\r\\n\\r\\nType 3 is a limited token with administrative privileges removed and administrative groups disabled.  The limited token is used when User Account Control is enabled, the application does not require administrative privilege, and the user does not choose to start the program using Run as administrator.\"\r\n}\r\n{\r\n  \"event_id\": \"evt-00363\",\r\n  \"timestamp\": \"2026-05-06T00:00:30.264Z\",\r\n  \"event_code\": 1,\r\n  \"host\": \"WS-06.corp.example\",\r\n  \"user\": \"NT AUTHORITY\\\\SYSTEM\",\r\n  \"image\": \"C:\\\\Program Files\\\\Common Files\\\\microsoft shared\\\\ClickToRun\\\\OfficeC2RClient.exe\",\r\n  \"parent_image\": \"C:\\\\Windows\\\\System32\\\\svchost.exe\",\r\n  \"command_line\": \"\\\"C:\\\\Program Files\\\\Common Files\\\\Microsoft Shared\\\\ClickToRun\\\\OfficeC2RClient.exe\\\" /frequentupdate SCHEDULEDTASK displaylevel=False\",\r\n  \"service_name\": \"\",\r\n  \"service_file_name\": \"\",\r\n  \"target_image\": \"\",\r\n  \"details\": \"\",\r\n  \"message\": \"\"\r\n}\r\n{\r\n  \"event_id\": \"evt-00495\",\r\n  \"timestamp\": \"2026-05-06T00:00:30.345Z\",\r\n  \"event_code\": 11,\r\n  \"host\": \"WS-06.corp.example\",\r\n  \"user\": \"\",\r\n  \"image\": \"C:\\\\Program Files\\\\Common Files\\\\Microsoft Shared\\\\ClickToRun\\\\OfficeC2RClient.exe\",\r\n  \"parent_image\": \"\",\r\n  \"command_line\": \"\",\r\n  \"service_name\": \"\",\r\n  \"service_file_name\": \"\",\r\n  \"target_image\": \"\",\r\n  \"details\": \"\",\r\n  \"message\": \"\"\r\n}\r\n{\r\n  \"event_id\": \"evt-00700\",\r\n  \"timestamp\": \"2026-05-06T00:00:34.482Z\",\r\n  \"event_code\": 4624,\r\n  \"host\": \"DC01.corp.example\",\r\n  \"user\": \"-\",\r\n  \"image\": \"\",\r\n  \"parent_image\": \"\",\r\n  \"command_line\": \"\",\r\n  \"service_name\": \"\",\r\n  \"service_file_name\": \"\",\r\n  \"target_image\": \"\",\r\n  \"src_ip\": \"fe80::9582:39e0:356b:ef4e\",\r\n  \"details\": \"\",\r\n  \"message\": \"An account was successfully logged on.\\r\\n\\r\\nSubject:\\r\\n\\tSecurity ID:\\t\\tS-1-0-0\\r\\n\\tAccount Name:\\t\\t-\\r\\n\\tAccount Domain:\\t\\t-\\r\\n\\tLogon ID:\\t\\t0x0\\r\\n\\r\\nLogon Information:\\r\\n\\tLogon Type:\\t\\t3\\r\\n\\tRestricted Admin Mode:\\t-\\r\\n\\tVirtual Account:\\t\\tNo\\r\\n\\tElevated Token:\\t\\tYes\\r\\n\\r\\nImpersonation Level:\\t\\tImpersonation\\r\\n\\r\\nNew Logon:\\r\\n\\tSecurity ID:\\t\\tS-1-5-18\\r\\n\\tAccount Name:\\t\\tDC01$\\r\\n\\tAccount Domain:\\t\\tCORP.LOCAL\\r\\n\\tLogon ID:\\t\\t0x4B0B08C\\r\\n\\tLinked Logon ID:\\t\\t0x0\\r\\n\\tNetwork Account Name:\\t-\\r\\n\\tNetwork Account Domain:\\t-\\r\\n\\tLogon GUID:\\t\\t{f3561a74-bfe7-eded-5cb8-e16b6202f17b}\\r\\n\\r\\nProcess Information:\\r\\n\\tProcess ID:\\t\\t0x0\\r\\n\\tProcess Name:\\t\\t-\\r\\n\\r\\nNetwork Information:\\r\\n\\tWorkstation Name:\\t-\\r\\n\\tSource Network Address:\\tfe80::9582:39e0:356b:ef4e\\r\\n\\tSource Port:\\t\\t52988\\r\\n\\r\\nDetailed Authentication Information:\\r\\n\\tLogon Process:\\t\\tKerberos\\r\\n\\tAuthentication Package:\\tKerberos\\r\\n\\tTransited Services:\\t-\\r\\n\\tPackage Name (NTLM only):\\t-\\r\\n\\tKey Length:\\t\\t0\\r\\n\\r\\nThis event is generated when a logon session is created. It is generated on the computer that was accessed.\\r\\n\\r\\nThe subject fields indicate the account on the local system which requested the logon. This is most commonly a service such as the Server service, or a local process such as Winlogon.exe or Services.exe.\\r\\n\\r\\nThe logon type field indicates the kind of logon that occurred. The most common types are 2 (interactive) and 3 (network).\\r\\n\\r\\nThe New Logon fields indicate the account for whom the new logon was created, i.e. the account that was logged on.\\r\\n\\r\\nThe network fields indicate where a remote logon request originated. Workstation name is not always available and may be left blank in some cases.\\r\\n\\r\\nThe impersonation level field indicates the extent to which a process in the logon session can impersonate.\\r\\n\\r\\nThe authentication information fields provide detailed information about this specific logon request"]
[11.234583, "o", ".\\r\\n\\t- Logon GUID is a unique identifier that can be used to correlate this event with a KDC event.\\r\\n\\t- Transited services indicate which intermediate services have participated in t\"\r\n}\r\n{\r\n  \"event_id\": \"evt-00703\",\r\n  \"timestamp\": \"2026-05-06T00:00:34.484Z\",\r\n  \"event_code\": 4624,\r\n  \"host\": \"DC01.corp.example\",\r\n  \"user\": \"-\",\r\n  \"image\": \"\",\r\n  \"parent_image\": \"\",\r\n  \"command_line\": \"\",\r\n  \"service_name\": \"\",\r\n  \"service_file_name\": \"\",\r\n  \"target_image\": \"\",\r\n  \"src_ip\": \"::1\",\r\n  \"details\": \"\",\r\n  \"message\": \"An account was successfully logged on.\\r\\n\\r\\nSubject:\\r\\n\\tSecurity ID:\\t\\tS-1-0-0\\r\\n\\tAccount Name:\\t\\t-\\r\\n\\tAccount Domain:\\t\\t-\\r\\n\\tLogon ID:\\t\\t0x0\\r\\n\\r\\nLogon Information:\\r\\n\\tLogon Type:\\t\\t3\\r\\n\\tRestricted Admin Mode:\\t-\\r\\n\\tVirtual Account:\\t\\tNo\\r\\n\\tElevated Token:\\t\\tYes\\r\\n\\r\\nImpersonation Level:\\t\\tImpersonation\\r\\n\\r\\nNew Logon:\\r\\n\\tSecurity ID:\\t\\tS-1-5-18\\r\\n\\tAccount Name:\\t\\tDC01$\\r\\n\\tAccount Domain:\\t\\tCORP.LOCAL\\r\\n\\tLogon ID:\\t\\t0x4B0B1B0\\r\\n\\tLinked Logon ID:\\t\\t0x0\\r\\n\\tNetwork Account Name:\\t-\\r\\n\\tNetwork Account Domain:\\t-\\r\\n\\tLogon GUID:\\t\\t{f3561a74-bfe7-eded-5cb8-e16b6202f17b}\\r\\n\\r\\nProcess Information:\\r\\n\\tProcess ID:\\t\\t0x0\\r\\n\\tProcess Name:\\t\\t-\\r\\n\\r\\nNetwork Information:\\r\\n\\tWorkstation Name:\\t-\\r\\n\\tSource Network Address:\\t::1\\r\\n\\tSource Port:\\t\\t0\\r\\n\\r\\nDetailed Authentication Information:\\r\\n\\tLogon Process:\\t\\tKerberos\\r\\n\\tAuthentication Package:\\tKerberos\\r\\n\\tTransited Services:\\t-\\r\\n\\tPackage Name (NTLM only):\\t-\\r\\n\\tKey Length:\\t\\t0\\r\\n\\r\\nThis event is generated when a logon session is created. It is generated on the computer that was accessed.\\r\\n\\r\\nThe subject fields indicate the account on the local system which requested the logon. This is most commonly a service such as the Server service, or a local process such as Winlogon.exe or Services.exe.\\r\\n\\r\\nThe logon type field indicates the kind of logon that occurred. The most common types are 2 (interactive) and 3 (network).\\r\\n\\r\\nThe New Logon fields indicate the account for whom the new logon was created, i.e. the account that was logged on.\\r\\n\\r\\nThe network fields indicate where a remote logon request originated. Workstation name is not always available and may be left blank in some cases.\\r\\n\\r\\nThe impersonation level field indicates the extent to which a process in the logon session can impersonate.\\r\\n\\r\\nThe authentication information fields provide detailed information about this specific logon request.\\r\\n\\t- Logon GUID is a unique identifier that can be used to correlate this event with a KDC event.\\r\\n\\t- Transited services indicate which intermediate services have participated in this logon request.\\r\\n\\t- Pac\"\r\n}\r\n{\r\n  \"event_id\": \"evt-00709\",\r\n  \"timestamp\": \"2026-05-06T00:00:34.487Z\",\r\n  \"event_code\": 4624,\r\n  \"host\": \"DC01.corp.example\",\r\n  \"user\": \"-\",\r\n  \"image\": \"\",\r\n\u001b[?2004hroot@b8637b54f4c1:~# "]
[16.767372, "i", "cat << 'EOF' > query_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== PROCESS CREATIONS (1, 4688) ===\")\ncursor.execute(\"\"\"SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line \n                  FROM events \n                  WHERE event_code IN (1, 4688) \n                  ORDER BY timestamp\"\"\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nprint(\"\\n=== SERVICES (7045, 4697) ===\")\ncursor.execute(\"\"\"SELECT event_id, timestamp, event_code, host, service_name, service_file_name, details \n                  FROM events \n                  WHERE event_code IN (7045, 4697) \n                  ORDER BY timestamp\"\"\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nprint(\"\\n=== NETWORK CONNECTIONS (3) ===\")\ncursor.execute(\"\"\"SELECT event_id, timestamp, event_code, host, user, image, src_ip, dst_ip, dst_port \n                  FROM events \n                  WHERE event_code = 3 \n                  ORDER BY timestamp\"\"\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nprint(\"\\n=== SHARES (5140, 5145) ===\")\ncursor.execute(\"\"\"SELECT event_id, timestamp, event_code, host, user, details, message \n                  FROM events \n                  WHERE event_code IN (5140, 5145) \n                  ORDER BY timestamp\"\"\")\nfor r in cursor.fetchall():\n    # extract some fields from message if possible or just print event\n    print(r['event_id'], r['timestamp'], r['event_code'], r['host'], r['user'], r['details'])\n\nprint(\"\\n=== POWERSHELL (4104) ===\")\ncursor.execute(\"\"\"SELECT event_id, timestamp, event_code, host, details \n                  FROM events \n                  WHERE event_code = 4104 \n                  ORDER BY timestamp\"\"\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nEOF\npython3 query_events.py\n"]
