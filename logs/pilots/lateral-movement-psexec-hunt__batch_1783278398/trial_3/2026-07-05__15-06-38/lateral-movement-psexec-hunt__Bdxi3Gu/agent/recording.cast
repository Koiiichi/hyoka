[55.556151, "i", "cat << 'EOF' > filter_timeline.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# We filter for Event Codes: 1, 4688, 3, 11, 4624 (type 3/10), 4697, 7045, 4104\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, service_name, service_file_name, src_ip, dst_ip, dst_port, details\n    FROM events\n    WHERE (host LIKE 'WS-05%' OR host LIKE 'WS-06%')\n      AND timestamp >= '2026-05-06T00:00:30'\n      AND timestamp <= '2026-05-06T00:01:10'\n      AND event_code IN (1, 4688, 3, 11, 4624, 4697, 7045, 4104)\n    ORDER BY timestamp\n\"\"\")\n\nfor r in cursor.fetchall():\n    d = dict(r)\n    d = {k: v for k, v in d.items() if v is not None and v != ''}\n    \n    # For 4624, only show logon type 3/10 or non-standard local system\n    if d.get('event_code') == 4624:\n        # Skip machine account logins to minimize noise if we can, but let's be careful.\n        user = d.get('user', '')\n        if 'WS-05$' in user or 'WS-06$' in user or 'ANONYMOUS' in user:\n            continue\n\n    print(f\"{d.get('timestamp')} | {d.get('host')} | {d.get('event_code')} | ID: {d.get('event_id')}\")\n    print(json.dumps(d, indent=2))\n    print(\"-\"*40)\n\nEOF\npython3 filter_timeline.py > /tmp/clean_timeline.txt\ncat /tmp/clean_timeline.txt\n"]
