[214.20693, "i", "cat << 'EOF' > evaluate.py\ncandidates_ws06 = [\n    \"evt-01057\", # Sysmon 1: cmd.exe spawning stager\n    \"evt-01209\", # Security 4624: m.ward remote login\n    \"evt-01213\", # Security 4697: Service installation \"Updater\"\n    \"evt-01253\", # System 7009: Updater service timeout\n    \"evt-01254\", # System 7000: Updater service failed to start\n    \"evt-01364\", # Sysmon 3: Incoming connection on port 135 from WS-05\n    \"evt-01366\", # Sysmon 3: Incoming connection on port 49726 from WS-05\n    \"evt-01827\", # PowerShell 4104: Script block execution of stager on WS-06\n    \"evt-02513\", # Sysmon 3: Connection from powershell.exe to 10.10.10.5:80\n    \"evt-02625\", # Sysmon 22: DNS query by powershell.exe on WS-06\n    \"evt-02901\", # Sysmon 1: whoami.exe execution\n    \"evt-02955\", # Security 4688: whoami.exe execution\n]\n\ncandidates_ws05 = [\n    \"evt-01365\", # Sysmon 22: DNS lookup from powershell.exe on WS-05\n    \"evt-01367\", # Sysmon 3: Outgoing connection to WS-06 on port 135\n    \"evt-01370\", # Sysmon 3: Outgoing connection to WS-06 on port 49726\n]\n\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nprint(\"=== WS-06 CANDIDATES ===\")\nfor cid in candidates_ws06:\n    cursor.execute(\"SELECT event_id, timestamp, event_code, host, image, command_line FROM events WHERE event_id = ?\", (cid,))\n    print(cursor.fetchone())\n\nprint(\"\\n=== WS-05 CANDIDATES ===\")\nfor cid in candidates_ws05:\n    cursor.execute(\"SELECT event_id, timestamp, event_code, host, image, command_line FROM events WHERE event_id = ?\", (cid,))\n    print(cursor.fetchone())\n\nEOF\npython3 evaluate.py\n"]
