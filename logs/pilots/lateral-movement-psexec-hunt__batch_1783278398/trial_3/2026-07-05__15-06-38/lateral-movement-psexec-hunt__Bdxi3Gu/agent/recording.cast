[110.108207, "i", "cat << 'EOF' > find_malicious_ids.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# We will select events that are clearly related to this intrusion:\n# 1. On WS-05:\n# - PowerShell logs (800, 4103) executing the stager, Invoke-PsExec, and the API calls.\n#   Let's fetch all 800 and 4103 events on WS-05 during the entire time. Since the entire PowerShell session on WS-05 is the attacker's agent, all 800 and 4103 events on WS-05 of this PowerShell session are malicious.\n#   Let's check the HostId of the powershell process on WS-05.\n#   The HostId was '1c1cb5c9-d305-49c1-9d7f-e864a6237819'. Let's verify if there are other HostIds.\n# 2. On WS-06:\n# - Logon event (4624) for m.ward at 00:00:48.850Z (evt-01209)\n# - Service install event (4697) for Updater (evt-01213)\n# - Service timeout/failure (7009, 7000): evt-01253, evt-01254\n# - Process creation (1/4688) for cmd.exe / powershell stager: evt-01057\n# - PowerShell script block (4104): evt-01827\n# - Network connection (3) to 10.10.10.5: evt-02513\n# - Process creation (1) for whoami.exe: evt-02901\n# - Any Sysmon events related to cmd.exe/powershell.exe stager process or whoami on WS-06.\n\n# Let's write a python script to search and identify all these and print them.\n\nprint(\"=== WS-05 Host IDs ===\")\ncursor.execute(\"\"\"\n    SELECT DISTINCT \n        SUBSTR(message, INSTR(message, 'HostId=') + 7, 36) AS host_id\n    FROM events \n    WHERE host LIKE 'WS-05%' AND event_code IN (800, 4103) AND message LIKE '%HostId=%'\n\"\"\")\nfor r in cursor.fetchall():\n    print(r)\n\nEOF\npython3 find_malicious_ids.py\n"]
