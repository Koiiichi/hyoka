powershell.exe on WS-05.\n        # Wait, let\'s look if we can extract Process ID of the powershell.exe.\n        \n    # WS-06 Malicious Process Events\n    is_ws06_malicious = False\n    if \'WS-06\' in host:\n        if p_guid in mal_ws06_guids:\n            is_ws06_malicious = True\n        else:\n            for g in mal_ws06_guids:\n                if g in msg or g in details:\n                    is_ws06_malicious = True\n                    break\n        \n        # Security logs corresponding to these events\n        # evt-01226 (cmd), evt-01238 (powershell), evt-01240 (conhost), evt-02955 (whoami)\n        if eid in (\'evt-01226\', \'evt-01238\', \'evt-01240\', \'evt-02955\'):\n            is_ws06_malicious = True\n            \n        # The service creation registry events and service installation events on WS-06\n        # Updater service\n        if eid in (\'evt-01050\', \'evt-01051\', \'evt-01052\', \'evt-01053\', \'evt-01054\', \'evt-01055\', \'evt-01056\', \'evt-01251\'):\n            is_ws06_malicious = True\n            \n        target = (r[\'target_object\'] or "").lower()\n        service_name = (r[\'service_name\'] or "").lower()\n        if \'updater\' in cmd.lower() or \'updater\' in target or \'updater\' in service_name:\n            is_ws06_malicious = True\n\n    if is_ws05_malicious:\n        malicious_ids.add(eid)\n    if is_ws06_malicious:\n        malicious_ids.add(eid)\n\nprint(f"Total unique malicious events collected: {len(malicious_ids)}")\nEOF\npython3 /tmp/get_all_malicious_events.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
