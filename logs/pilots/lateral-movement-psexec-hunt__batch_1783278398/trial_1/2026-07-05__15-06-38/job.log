sg:\n        malicious_ws06.add(r[\'event_id\'])\n\n# Also let\'s check if the service "Updater" events are collected\n# HKLM\\System\\CurrentControlSet\\Services\\Updater registry keys\n# Event IDs: evt-01055, evt-01056, and evt-01251 (Service Install)\n# Let\'s check for any event containing \'Updater\' or service registry keys\nfor r in rows:\n    cmd = (r[\'command_line\'] or "").lower()\n    target = (r[\'target_object\'] or "").lower()\n    service_name = (r[\'service_name\'] or "").lower()\n    if \'updater\' in cmd or \'updater\' in target or \'updater\' in service_name:\n        malicious_ws06.add(r[\'event_id\'])\n\nprint(f"Found {len(malicious_ws06)} malicious event IDs on WS-06.")\nprint(sorted(list(malicious_ws06)))\nEOF\npython3 /tmp/get_ws06_malicious.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
