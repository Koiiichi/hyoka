[?2004l[?2004h> malicious_keywords = ['powershell', 'cmd.exe', 'whoami', 'updater', 'services.exe', 'schtasks', 'wmi', 'conhost.exe', 'psexec', 'paexec']
[?2004l[?2004h> for r in events_by_host['WS-06.corp.example']:
[?2004l[?2004h>     ts = r['timestamp']
[?2004l[?2004h>     if '2026-05-06T00:00:00' <= ts <= '2026-05-06T00:05:00':
[?2004l[?2004h>         cmd = r['command_line'] or ""
[?2004l[?2004h>         img = r['image'] or ""
[?2004l[?2004h>         parent = r['parent_image'] or ""
[?2004l[?2004h>         e_code = r['event_code']
[?2004l[?2004h>         usr = r['user'] or ""
[?2004l[?2004h>         tgt_usr = r['target_user'] or ""
[?2004l[?2004h>         
[?2004l[?2004h>         # Print if it has anything suspicious or related to execution
[?2004l[?2004h>         is_suspicious = False
[?2004l[?2004h>         if any(k in cmd.lower() or k in img.lower() or k in parent.lower() for k in malicious_keywords):
[?2004l[?2004h>             is_suspicious = True
[?2004l[?2004h>         if e_code in (1, 3, 11, 12, 13, 22, 4688, 7045, 4697, 7009, 4104):
[?2004l[?2004h>             is_suspicious = True
[?2004l[?2004h>             
[?2004l[?2004h>         if is_suspicious:
[?2004l[?2004h>             print(f"{ts} | {r['event_id']} | Event {e_code} | Host: {r['host']} | User: {usr} (Tgt: {tgt_usr}) | Image: {img} | Parent: {parent} | Cmd: {cmd[:150]} | Msg: {str(r['message'])[:100]}")
