[?2004hroot@c50e0daa8a0b:~# cat << 'EOF' > /tmp/get_logon_events.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Get Logon ID from evt-01209
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE event_id = 'evt-01209'")
[?2004l[?2004h> evt = dict(cur.fetchone())
[?2004l[?2004h> msg = evt['message'] or ""
[?2004l[?2004h> print("evt-01209 Message:")
[?2004l[?2004h> print(msg)
[?2004l[?2004h> 
[?2004l[?2004h> # Try to parse Logon ID
[?2004l[?2004h> logon_id_match = re.search(r'Logon ID:\s+(0x[0-9a-fA-F]+)', msg)
[?2004l[?2004h> if logon_id_match:
[?2004l[?2004h>     logon_id = logon_id_match.group(1)
[?2004l[?2004h>     print(f"Parsed Logon ID: {logon_id}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Now find all Security events on WS-06 with this Logon ID
[?2004l[?2004h>     cur.execute(f"""
[?2004l[?2004h>         SELECT event_id, event_code, timestamp, user, message 
[?2004l[?2004h>         FROM events 
[?2004l[?2004h>         WHERE host LIKE '%WS-06%'
[?2004l[?2004h>           AND (message LIKE '%{logon_id}%' OR details LIKE '%{logon_id}%')
[?2004l[?2004h>     """)
[?2004l[?2004h>     print("=== Related Security Events on WS-06 ===")
[?2004l[?2004h>     for r in cur.fetchall():
[?2004l[?2004h>         print(f"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | Msg: {r['message'][:150]}")
[?2004l[?2004h> else:
[?2004l[?2004h>     print("Could not find Logon ID in message")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
