[?2004hroot@c50e0daa8a0b:~# cat << 'EOF' > /tmp/inspect_dc01.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE host LIKE '%DC01%'")
[?2004l[?2004h> rows = [dict(r) for r in cur.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total DC01 events: {len(rows)}")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     ts = r['timestamp']
[?2004l[?2004h>     eid = r['event_id']
[?2004l[?2004h>     ecode = r['event_code']
[?2004l[?2004h>     usr = r['user'] or ""
[?2004l[?2004h>     msg = r['message'] or ""
[?2004l[?2004h>     details = r['details'] or ""
[?2004l[?2004h>     # Print summary
[?2004l[?2004h>     # check if anything suspicious
[?2004l[?2004h>     is_interesting = False
[?2004l[?2004h>     if ecode not in (5156, 5158, 4658, 4690, 4656, 4663):
[?2004l[?2004h>         is_interesting = True
[?2004l[?2004h>     
[?2004l[?2004h>     if is_interesting:
[?2004l[?2004h>         print(f"{ts} | {eid} | Code {ecode} | User: {usr} | Msg: {msg[:100]}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@c50e0daa8a0b:~# python3 /tmp/inspect_dc01.py
[?2004lTotal DC01 events: 161
