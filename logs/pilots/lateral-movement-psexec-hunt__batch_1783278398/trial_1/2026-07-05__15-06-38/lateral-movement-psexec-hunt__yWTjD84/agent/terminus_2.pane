[?2004hroot@c50e0daa8a0b:~# cat << 'EOF' > /tmp/hunt.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> import base64
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's get all process creation events (Sysmon 1, Security 4688)
[?2004l[?2004h> processes = {}
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE event_code IN (1, 4688)")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     processes[r['event_id']] = dict(r)
[?2004l[?2004h>     # Check for powershell, cmd, or whoami, etc.
[?2004l[?2004h>     cmd_line = r['command_line'] or ""
[?2004l[?2004h>     if any(x in cmd_line.lower() for x in ['powershell', 'cmd.exe', 'whoami', 'wmi', 'csc.exe', 'cvtres.exe', 'net.exe', 'nltest', 'ipconfig', 'ping']):
