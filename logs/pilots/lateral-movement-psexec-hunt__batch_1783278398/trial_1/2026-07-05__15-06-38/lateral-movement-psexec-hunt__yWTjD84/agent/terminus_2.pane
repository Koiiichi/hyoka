[?2004hroot@c50e0daa8a0b:~# cat << 'EOF' > /tmp/get_all_malicious_events.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT * FROM events")
[?2004l[?2004h> rows = [dict(r) for r in cur.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> malicious_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious Process GUIDs on WS-05
[?2004l[?2004h> mal_ws05_guids = {'{b34bc01c-7dfc-5f67-de11-000000000400}'}
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious Process GUIDs on WS-06
[?2004l[?2004h> mal_ws06_guids = {
[?2004l[?2004h>     '{d273d0f0-8078-5f67-cb06-000000000800}', # cmd
[?2004l[?2004h>     '{d273d0f0-8078-5f67-cc06-000000000800}', # powershell
[?2004l[?2004h>     '{d273d0f0-8078-5f67-cd06-000000000800}', # conhost
[?2004l[?2004h>     '{d273d0f0-808e-5f67-cf06-000000000800}'  # whoami
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Let's verify if there are any other process creations on WS-06 or WS-05 that have these GUIDs as parent
[?2004l[?2004h> # Let's search message contents for any parent process GUID or process GUID
[?2004l[?2004h> # Also let's search for Security Event IDs that map to these process creations (e.g. sharing command line, timestamp, user, image)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     eid = r['event_id']
[?2004l[?2004h>     host = r['host']
[?2004l[?2004h>     ecode = r['event_code']
[?2004l[?2004h>     msg = r['message'] or ""
[?2004l[?2004h>     details = r['details'] or ""
[?2004l[?2004h>     p_guid = r['process_guid']
[?2004l[?2004h>     cmd = r['command_line'] or ""
[?2004l[?2004h>     img = r['image'] or ""
[?2004l[?2004h>     
[?2004l[?2004h>     # WS-05 Malicious Process Events
[?2004l[?2004h>     is_ws05_malicious = False
[?2004l[?2004h>     if 'WS-05' in host:
[?2004l[?2004h>         if p_guid in mal_ws05_guids:
[?2004l[?2004h>             is_ws05_malicious = True
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Check if any known GUID is in message or details
[?2004l[?2004h>             for g in mal_ws05_guids:
[?2004l[?2004h>                 if g in msg or g in details:
[?2004l[?2004h>                     is_ws05_malicious = True
[?2004l[?2004h>                     break
[?2004l[?2004h>         # Check for Security logs that correspond to the malicious process
[?2004l[?2004h>         # On WS-05, we have WFP events, are they related to process ID 6404?
[?2004l[?2004h>         # In Sysmon, code 3, network connection has process ID of the powershell.exe process.
[?2004l[?2004h>         # Let's verify Process ID for the powershell.exe on WS-05.
[?2004l[?2004h>         # Wait, let's look if we can extract Process ID of the powershell.exe.
[?2004l[?2004h>         
[?2004l[?2004h>     # WS-06 Malicious Process Events
[?2004l[?2004h>     is_ws06_malicious = False
[?2004l[?2004h>     if 'WS-06' in host:
[?2004l[?2004h>         if p_guid in mal_ws06_guids:
[?2004l[?2004h>             is_ws06_malicious = True
[?2004l[?2004h>         else:
[?2004l[?2004h>             for g in mal_ws06_guids:
[?2004l[?2004h>                 if g in msg or g in details:
[?2004l[?2004h>                     is_ws06_malicious = True
[?2004l[?2004h>                     break
[?2004l[?2004h>         
[?2004l[?2004h>         # Security logs corresponding to these events
[?2004l[?2004h>         # evt-01226 (cmd), evt-01238 (powershell), evt-01240 (conhost), evt-02955 (whoami)
[?2004l[?2004h>         if eid in ('evt-01226', 'evt-01238', 'evt-01240', 'evt-02955'):
[?2004l[?2004h>             is_ws06_malicious = True
[?2004l[?2004h>             
[?2004l[?2004h>         # The service creation registry events and service installation events on WS-06
[?2004l[?2004h>         # Updater service
[?2004l[?2004h>         if eid in ('evt-01050', 'evt-01051', 'evt-01052', 'evt-01053', 'evt-01054', 'evt-01055', 'evt-01056', 'evt-01251'):
[?2004l[?2004h>             is_ws06_malicious = True
[?2004l[?2004h>             
[?2004l[?2004h>         target = (r['target_object'] or "").lower()
[?2004l[?2004h>         service_name = (r['service_name'] or "").lower()
[?2004l[?2004h>         if 'updater' in cmd.lower() or 'updater' in target or 'updater' in service_name:
[?2004l[?2004h>             is_ws06_malicious = True
[?2004l[?2004h> 
[?2004l[?2004h>     if is_ws05_malicious:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>     if is_ws06_malicious:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total unique malicious events collected: {len(malicious_ids)}")
