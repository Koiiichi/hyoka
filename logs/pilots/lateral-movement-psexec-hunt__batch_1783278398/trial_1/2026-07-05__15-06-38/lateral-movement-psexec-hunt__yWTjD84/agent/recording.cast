n session can impersonate.\r\r\n\r\r\nThe authentication information fields provide detailed information about this specific logon request.\r\r\n\t- Logon GUID is a unique identifier that can be used to correlate this event with a KDC event.\r\r\n\t- Transited services indicate which intermediate services have participated in this logon request.\r\r\n\t-\r\n"]
[220.725297, "o", "\u001b[?2004hroot@c50e0daa8a0b:~# "]
[225.473611, "i", "cat << 'EOF' > /tmp/inspect_dc01.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host LIKE '%DC01%'\")\nrows = [dict(r) for r in cur.fetchall()]\n\nprint(f\"Total DC01 events: {len(rows)}\")\nfor r in rows:\n    ts = r['timestamp']\n    eid = r['event_id']\n    ecode = r['event_code']\n    usr = r['user'] or \"\"\n    msg = r['message'] or \"\"\n    details = r['details'] or \"\"\n    # Print summary\n    # check if anything suspicious\n    is_interesting = False\n    if ecode not in (5156, 5158, 4658, 4690, 4656, 4663):\n        is_interesting = True\n    \n    if is_interesting:\n        print(f\"{ts} | {eid} | Code {ecode} | User: {usr} | Msg: {msg[:100]}\")\n\nEOF\npython3 /tmp/inspect_dc01.py\n"]
[225.4739, "o", "cat << 'EOF' > /tmp/inspect_dc01.py\r\n\u001b[?2004l\r"]
