[314.489317, "i", "cat << 'EOF' > /tmp/check_ws05_sec_sys.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND channel IN ('Security', 'security', 'System', 'system')\n    ORDER BY timestamp\n\"\"\")\nfor r in cur.fetchall():\n    print(f\"{r['timestamp']} | {r['event_id']} | Code {r['event_code']} | User: {r['user']} | Msg: {r['message'][:120] if r['message'] else ''}\")\n\nEOF\npython3 /tmp/check_ws05_sec_sys.py\n"]
