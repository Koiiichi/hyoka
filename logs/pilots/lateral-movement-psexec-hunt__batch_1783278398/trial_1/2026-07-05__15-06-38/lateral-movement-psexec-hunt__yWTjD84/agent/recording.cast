[263.242513, "i", "cat << 'EOF' > /tmp/check_ws06_shortname.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-06'\")\nrows = [dict(r) for r in cur.fetchall()]\n\nprint(f\"Total events on WS-06 shortname: {len(rows)}\")\nfrom collections import Counter\nprint(Counter(r['event_code'] for r in rows))\n\n# Let's inspect some of them\nfor r in rows[:10]:\n    print(f\"{r['timestamp']} | {r['event_id']} | Code {r['event_code']} | Image: {r['image']} | Msg: {r['message'][:100] if r['message'] else ''}\")\n\nEOF\npython3 /tmp/check_ws06_shortname.py\n"]
