[328.288487, "i", "cat << 'EOF' > /tmp/map_pids.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's find any Sysmon events containing 3192 or 3200 in their message or details\ncur.execute(\"\"\"\n    SELECT event_id, event_code, image, message, details \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND channel LIKE '%Sysmon%'\n      AND (message LIKE '%3192%' OR message LIKE '%3200%' \n           OR details LIKE '%3192%' OR details LIKE '%3200%')\n\"\"\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | Code {r['event_code']} | Image: {r['image']} | Details: {r['details'][:100]}\")\n\nEOF\npython3 /tmp/map_pids.py\n"]
