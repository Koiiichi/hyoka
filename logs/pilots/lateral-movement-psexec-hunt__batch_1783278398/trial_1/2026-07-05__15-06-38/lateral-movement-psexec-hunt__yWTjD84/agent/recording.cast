[139.667723, "o", "    SELECT event_id, timestamp, event_code, image, parent_image, command_line, process_guid \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.667771, "o", "    FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host LIKE '%WS-06%' AND event_code IN (1, 4688)\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
