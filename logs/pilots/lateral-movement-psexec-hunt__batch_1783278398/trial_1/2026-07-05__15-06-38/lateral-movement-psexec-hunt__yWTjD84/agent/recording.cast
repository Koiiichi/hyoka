[139.666779, "i", "cat << 'EOF' > /tmp/get_ws06_procs.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, parent_image, command_line, process_guid \n    FROM events \n    WHERE host LIKE '%WS-06%' AND event_code IN (1, 4688)\n\"\"\")\nfor r in cur.fetchall():\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | {r['image']} | GUID: {r['process_guid']} | Parent: {r['parent_image']} | Cmd: {r['command_line'][:150] if r['command_line'] else ''}\")\n\nEOF\npython3 /tmp/get_ws06_procs.py\n"]
[139.667276, "o", "cat << 'EOF' > /tmp/get_ws06_procs.py\r\n\u001b[?2004l\r"]
