[115.092145, "i", "cat << 'EOF' > /tmp/ws05_powershell_details.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT * FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (image LIKE '%powershell.exe%' \n           OR parent_image LIKE '%powershell.exe%'\n           OR target_image LIKE '%powershell.exe%'\n           OR message LIKE '%powershell.exe%')\n\"\"\")\nrows = [dict(r) for r in cur.fetchall()]\n\nprint(f\"Found {len(rows)} powershell-related events on WS-05\")\n\n# Group and print by event_code\nfrom collections import defaultdict\nby_code = defaultdict(list)\nfor r in rows:\n    by_code[r['event_code']].append(r)\n\nfor code in sorted(by_code.keys()):\n    print(f\"=== Code {code} ({len(by_code[code])} events) ===\")\n    for r in by_code[code][:10]:\n        print(f\"{r['timestamp']} | {r['event_id']} | {r['user']} | {r['image']} | {r['command_line']} | {r['message'][:150] if r['message'] else ''}\")\n\nEOF\npython3 /tmp/ws05_powershell_details.py\n"]
