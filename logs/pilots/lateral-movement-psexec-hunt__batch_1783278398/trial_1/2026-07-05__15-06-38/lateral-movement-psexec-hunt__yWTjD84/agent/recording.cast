[283.771386, "i", "cat << 'EOF' > /tmp/check_ws05_malicious_pwsh.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Load findings\nwith open('/root/findings.json') as f:\n    findings = set(json.load(f))\n\n# Find all PowerShell events on WS-05\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103, 4104)\n\"\"\")\nws05_pwsh_events = [dict(r) for r in cur.fetchall()]\n\nin_findings = [e for e in ws05_pwsh_events if e['event_id'] in findings]\nnot_in_findings = [e for e in ws05_pwsh_events if e['event_id'] not in findings]\n\nprint(f\"WS-05 PowerShell events: Total={len(ws05_pwsh_events)}, In findings={len(in_findings)}, Not in findings={len(not_in_findings)}\")\nif not_in_findings:\n    print(\"Sample of NOT in findings:\")\n    for e in not_in_findings[:10]:\n        print(f\"{e['timestamp']} | {e['event_id']} | Code {e['event_code']} | {e['message'][:150] if e['message'] else ''}\")\n\nEOF\npython3 /tmp/check_ws05_malicious_pwsh.py\n"]
[283.771698, "o", "cat << 'EOF' > /tmp/check_ws05_malicious_pwsh.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
