[245.281773, "o", "An account was logged off.\r\r\n\r\r\nSubject:\r\r\n\tSecurity ID:\t\tS-1-5-21-4228717743-1032521047-1810997296-1112\r\r\n\tAccount Name:\t\tWS-05$\r\r\n\tAccount Domain:\t\tCORP\r\r\n\tLogon ID:\t\t0x4AEA74B\r\r\n\r\r\nLogon Type:\t\t\t3\r\r\n\r\r\nThis event is generated when a logon session is destroyed. It may be positively correlated with a logon event using the Logon ID value. Logon IDs are only unique between reboots on the same computer.\r\n"]
[245.282414, "o", "\u001b[?2004hroot@c50e0daa8a0b:~# "]
[254.643663, "i", "cat << 'EOF' > /tmp/evaluate_all.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events\")\nrows = [dict(r) for r in cur.fetchall()]\n\nmalicious = set()\n\n# Malicious GUIDs\nmal_guids = {\n    '{b34bc01c-7dfc-5f67-de11-000000000400}', # WS-05 powershell\n    '{d273d0f0-8078-5f67-cb06-000000000800}', # WS-06 cmd\n    '{d273d0f0-8078-5f67-cc06-000000000800}', # WS-06 powershell\n    '{d273d0f0-8078-5f67-cd06-000000000800}', # WS-06 conhost\n    '{d273d0f0-808e-5f67-cf06-000000000800}'  # WS-06 whoami\n}\n\n# Let's check for any event in WS-05 and WS-06 that belongs to these GUIDs\nfor r in rows:\n    eid = r['event_id']\n    host = r['host']\n    guid = r['process_guid']\n    msg = r['message'] or \"\"\n    details = r['details'] or \"\"\n    \n    if guid in mal_guids:\n        malicious.add(eid)\n    else:\n        for g in mal_guids:\n            if g in msg or g in details:\n                malicious.add(eid)\n                break\n\n# Let's add other events we verified manually:\n# 1. DC01 Kerberos ticket request\nmalicious.add('evt-01222')\n\n# 2. WS-06 Security process creations (no GUIDs in Security channel)\n# cmd.exe\nmalicious.add('evt-01226')\n# powershell.exe\nmalicious.add('evt-01238')\n# conhost.exe\nmalicious.add('evt-01240')\n# whoami.exe\nmalicious.add('evt-02955')\n\n# 3. WS-06 lateral movement authentication and service installation\n# Special privileges assigned to new logon\nmalicious.add('evt-01208')\n# An account was successfully logged on (m.ward)\nmalicious.add('evt-01209')\n# Group membership information\nmalicious.add('evt-01210')\n# A handle to an object was requested\nmalicious.add('evt-01211')\n# A handle to an object was requested\nmalicious.add('evt-01212')\n# A service was installed in the system\nmalicious.add('evt-01213')\n# An operation was attempted on a privileged object\nmalicious.add('evt-01214')\n# Service manager service installation registry event\nmalicious.add('evt-01251')\n# Service display name setting\nmalicious.add('evt-01055')\n# Service object name setting\nmalicious.add('evt-01056')\n\n# Logoff of m.ward's session on WS-06\nmalicious.add('evt-03552')\n\nprint(f\"Total collected: {len(malicious)}\")\nprint(\"By Host:\")\nhost_counts = {}\nfor eid in malicious:\n    r = next(row for row in rows if row['event_id'] == eid)\n    h = r['host']\n    host_counts[h] = host_counts.get(h, 0) + 1\nprint(host_counts)\n\nEOF\npython3 /tmp/evaluate_all.py\n"]
[254.643878, "o", "cat << 'EOF' > /tmp/evaluate_all.py\r\n"]
