[183.6915, "i", "cat << 'EOF' > /tmp/lateral_movement_hunt.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's search for all Logon (4624) events on WS-06\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, host, event_code, user, logon_type, src_ip, details, message\n    FROM events \n    WHERE host LIKE '%WS-06%' AND event_code = 4624\n\"\"\")\nprint(\"=== Logons on WS-06 ===\")\nfor r in cur.fetchall():\n    print(f\"{r['timestamp']} | {r['event_id']} | User: {r['user']} | Logon Type: {r['logon_type']} | Src IP: {r['src_ip']}\")\n\n# Let's search for all events of WFP or SMB or Service installation on WS-06 that relate to WS-05 (172.18.39.5)\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, src_ip, dst_ip, dst_port, service_name, message\n    FROM events \n    WHERE src_ip = '172.18.39.5' OR dst_ip = '172.18.39.5'\n\"\"\")\nprint(\"=== Connections involving WS-05 ===\")\nfor r in cur.fetchall():\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | Host: {r['host']} | User: {r['user']} | Src: {r['src_ip']} | Dst: {r['dst_ip']} | Port: {r['dst_port']}\")\n\nEOF\npython3 /tmp/lateral_movement_hunt.py\n"]
[183.691997, "o", "cat << 'EOF' > /tmp/lateral_movement_hunt.py\r\n\u001b[?2004l\r\u001b[?2004h"]
