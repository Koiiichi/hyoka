[18.54181, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport json\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's get all process creation events (Sysmon 1, Security 4688)\nprocesses = {}\ncur.execute(\"SELECT * FROM events WHERE event_code IN (1, 4688)\")\nfor r in cur.fetchall():\n    processes[r['event_id']] = dict(r)\n    # Check for powershell, cmd, or whoami, etc.\n    cmd_line = r['command_line'] or \"\"\n    if any(x in cmd_line.lower() for x in ['powershell', 'cmd.exe', 'whoami', 'wmi', 'csc.exe', 'cvtres.exe', 'net.exe', 'nltest', 'ipconfig', 'ping']):\n        print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image']} | {r['command_line']}\")\n\nEOF\npython3 /tmp/hunt.py\n"]
