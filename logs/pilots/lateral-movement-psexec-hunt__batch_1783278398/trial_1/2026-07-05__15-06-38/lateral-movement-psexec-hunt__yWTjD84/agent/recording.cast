[68.198797, "i", "cat << 'EOF' > /tmp/powershell_hunt.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, host, event_code, message \n    FROM events \n    WHERE (channel LIKE '%PowerShell%' OR event_code IN (800, 4103, 4104)) \n    ORDER BY timestamp\n\"\"\")\nrows = cur.fetchall()\n\nprint(f\"Found {len(rows)} PowerShell events\")\n\n# Let's group messages that look similar or print unique commands/scripts\nseen_blocks = set()\nfor r in rows:\n    msg = r['message'] or \"\"\n    # Extract command lines or script block text from message\n    # Let's just write them to a file for analysis\n    host = r['host']\n    eid = r['event_id']\n    ecode = r['event_code']\n    ts = r['timestamp']\n    \n    # Try to extract the actual command being executed\n    cmd_lines = []\n    for line in msg.split('\\n'):\n        if \"Command Line:\" in line or \"CommandLine=\" in line or \"ScriptBlockText\" in line or \"Pipeline execution details\" in line:\n            cmd_lines.append(line.strip())\n    \n    cmd_desc = \" \".join(cmd_lines)\n    if not cmd_desc:\n        # fall back to some substring of message\n        cmd_desc = msg.replace('\\r', '').replace('\\n', ' ')[:120]\n        \n    # Deduplicate slightly\n    key = (host, ecode, cmd_desc[:100])\n    if key not in seen_blocks:\n        seen_blocks.add(key)\n        print(f\"{ts} | {eid} | {ecode} | {host} | {cmd_desc[:250]}\")\n\nEOF\npython3 /tmp/powershell_hunt.py > /tmp/powershell_timeline.txt\nwc -l /tmp/powershell_timeline.txt\nhead -n 100 /tmp/powershell_timeline.txt\n"]
