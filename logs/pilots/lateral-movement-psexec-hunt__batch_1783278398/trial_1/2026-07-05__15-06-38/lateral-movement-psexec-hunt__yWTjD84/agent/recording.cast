[239.847582, "i", "cat << 'EOF' > /tmp/get_malicious_dc01.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host LIKE '%DC01%' ORDER BY timestamp\")\nrows = [dict(r) for r in cur.fetchall()]\n\n# Let's inspect events that have 'm.ward' or are related to m.ward\nfor r in rows:\n    msg = (r['message'] or \"\").lower()\n    details = (r['details'] or \"\").lower()\n    usr = (r['user'] or \"\").lower()\n    tusr = (r['target_user'] or \"\").lower()\n    eid = r['event_id']\n    \n    if 'm.ward' in msg or 'm.ward' in details or 'm.ward' in usr or 'm.ward' in tusr:\n         print(f\"{r['timestamp']} | {eid} | Code {r['event_code']} | Msg: {msg[:100]}\")\n\nEOF\npython3 /tmp/get_malicious_dc01.py\n"]
