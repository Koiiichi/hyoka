[335.405109, "i", "cat << 'EOF' > /tmp/get_ws05_pid_6404_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND channel = 'Security'\n      AND (message LIKE '%6404%')\n\"\"\")\nprint(\"=== Security events for PID 6404 on WS-05 ===\")\nfor r in cur.fetchall():\n    print(f\"{r['timestamp']} | {r['event_id']} | Code {r['event_code']} | Msg: {r['message'][:120] if r['message'] else ''}\")\n\nEOF\npython3 /tmp/get_ws05_pid_6404_events.py\n"]
