[194.108989, "i", "cat << 'EOF' > /tmp/get_logon_events.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Get Logon ID from evt-01209\ncur.execute(\"SELECT * FROM events WHERE event_id = 'evt-01209'\")\nevt = dict(cur.fetchone())\nmsg = evt['message'] or \"\"\nprint(\"evt-01209 Message:\")\nprint(msg)\n\n# Try to parse Logon ID\nlogon_id_match = re.search(r'Logon ID:\\s+(0x[0-9a-fA-F]+)', msg)\nif logon_id_match:\n    logon_id = logon_id_match.group(1)\n    print(f\"Parsed Logon ID: {logon_id}\")\n    \n    # Now find all Security events on WS-06 with this Logon ID\n    cur.execute(f\"\"\"\n        SELECT event_id, event_code, timestamp, user, message \n        FROM events \n        WHERE host LIKE '%WS-06%'\n          AND (message LIKE '%{logon_id}%' OR details LIKE '%{logon_id}%')\n    \"\"\")\n    print(\"=== Related Security Events on WS-06 ===\")\n    for r in cur.fetchall():\n        print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | Msg: {r['message'][:150]}\")\nelse:\n    print(\"Could not find Logon ID in message\")\n\nEOF\npython3 /tmp/get_logon_events.py\n"]
