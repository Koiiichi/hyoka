[27.154677, "i", "cat << 'EOF' > /tmp/hunt2.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== Services installed ===\")\ncur.execute(\"SELECT event_id, timestamp, host, event_code, service_name, service_file_name, message FROM events WHERE event_code IN (7045, 4697, 7009)\")\nfor r in cur.fetchall():\n    print(dict(r))\n\nprint(\"=== Network Connections (Sysmon 3) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, image, src_ip, dst_ip, dst_port FROM events WHERE event_code = 3\")\nfor r in cur.fetchall():\n    print(dict(r))\n\nprint(\"=== Registry / Sysmon 12, 13, 14 ===\")\ncur.execute(\"SELECT event_id, timestamp, host, event_code, image, target_object, details FROM events WHERE event_code IN (12, 13, 14) AND (target_object LIKE '%service%' OR image LIKE '%powershell%') LIMIT 20\")\nfor r in cur.fetchall():\n    print(dict(r))\nEOF\npython3 /tmp/hunt2.py\n"]
