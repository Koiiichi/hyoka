[153.520257, "o", "\u001b[?2004hroot@c50e0daa8a0b:~# "]
[161.191745, "i", "cat << 'EOF' > /tmp/verify_ws05_pid.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's search for events on WS-05 with process_guid b34bc01c-7dfc-5f67-de11-000000000400\ncur.execute(\"\"\"\n    SELECT event_id, event_code, image, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND process_guid = '{b34bc01c-7dfc-5f67-de11-000000000400}'\n\"\"\")\nfor r in cur.fetchall():\n    print(f\"GUID Event: {r['event_id']} | Code: {r['event_code']} | Image: {r['image']} | Msg: {r['message'][:100] if r['message'] else ''}\")\n\n# Let's search for any network connection events (code 3 or 5156/5158) with Process ID or process name\ncur.execute(\"\"\"\n    SELECT event_id, event_code, image, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code IN (3, 5156, 5158)\n\"\"\")\nprint(\"=== Network Events on WS-05 ===\")\nfor r in cur.fetchall()[:10]:\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Image: {r['image']} | Msg: {r['message'][:120] if r['message'] else ''}\")\n\nEOF\npython3 /tmp/verify_ws05_pid.py\n"]
[161.192435, "o", "cat << 'EOF' > /tmp/verify_ws05_pid.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
