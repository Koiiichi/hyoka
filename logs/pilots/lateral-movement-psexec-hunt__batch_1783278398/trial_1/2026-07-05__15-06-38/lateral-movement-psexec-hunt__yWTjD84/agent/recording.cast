[51.084432, "o", "cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT * FROM events ORDER BY timestamp\")\r\n\u001b[?2004l\r"]
[51.084561, "o", "\u001b[?2004h> rows = [dict(r) for r in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.084596, "o", "# Let's inspect event logs. What hosts do we have?\r\n\u001b[?2004l\r"]
[51.084768, "o", "\u001b[?2004h> hosts = set(r['host'] for r in rows if r['host'])\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Hosts:\", hosts)"]
[51.084808, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Group events by host\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.08493, "o", "events_by_host = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.08596, "o", "for h in hosts:\r\n\u001b[?2004l\r\u001b[?2004h>     events_by_host[h] = []\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     if r['host']:\r\n\u001b[?2004l\r\u001b[?2004h>         events_by_host[r['host']].append(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's write a script that does thorough hunting:\r\n\u001b[?2004l\r\u001b[?2004h> # 1. We know WS-06 is compromised starting around 2026-05-06T00:00:47\r\n\u001b[?2004l\r\u001b[?2004h> # Let's inspect everything on WS-06 between 2026-05-06T00:00:00 and 2026-05-06T00:15:00\r\n\u001b[?2004l\r\u001b[?2004h> print(\"--- WS-06 Timeline (first few mins) ---\")\r\n\u001b[?2004l\r\u001b[?2004h> malicious_keywords = ['powershell', 'cmd.exe', 'whoami', 'updater', 'services.exe', 'schtasks', 'wmi', 'conhost.exe', 'psexec', 'paexec']\r\n\u001b[?2004l\r\u001b[?2004h> for r in events_by_host['WS-06.corp.example']:\r\n\u001b[?2004l\r\u001b[?2004h>     ts = r['timestamp']\r\n\u001b[?2004l\r\u001b[?2004h>     if '2026-05-06T00:00:00' <= ts <= '2026-05-06T00:05:00':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.086167, "o", "        cmd = r['command_line'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.086215, "o", "        img = r['image'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.086296, "o", "        parent = r['parent_image'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         e_code = r['event_code']\r\n\u001b[?2004l\r\u001b[?2004h>         usr = r['user'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         tgt_usr = r['target_user'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.086508, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         # Print if it has anything suspicious or related to execution\r\n\u001b[?2004l\r\u001b[?2004h>         is_suspicious = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.086836, "o", "        if any(k in cmd.lower() or k in img.lower() or k in parent.lower() for k in malicious_keywords):\r\n\u001b[?2004l\r\u001b[?2004h>             is_suspicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         if e_code in (1, 3, 11, 12, 13, 22, 4688, 7045, 4697, 7009, 4104):\r\n\u001b[?2004l\r\u001b[?2004h>             is_suspicious = True\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>         if is_suspicious:\r\n\u001b[?2004l\r"]
[51.086907, "o", "\u001b[?2004h> "]
[51.087178, "o", "            print(f\"{ts} | {r['event_id']} | Event {e_code} | Host: {r['host']} | User: {usr} (Tgt: {tgt_usr}) | Image: {img} | Parent: {parent} | Cmd: {cmd[:150]} | Msg: {str(r['message'])[:100]}\")"]
[51.087338, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
