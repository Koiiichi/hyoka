-enc  SQBmACgAJABQAFMAVgBFAHIAUwBpAE8AbgBUAGEAYgBsAEUALgBQAFMAVgBFAFIAcwBJAE8Abg\r\n2026-05-06T00:00:48.865Z | evt-01240 | Code: 4688 |  | GUID: None | Parent:  | Cmd: \\??\\C:\\windows\\system32\\conhost.exe 0xffffffff -ForceV1\r\n2026-05-06T00:00:54.636Z | evt-02469 | Code: 1 | C:\\Windows\\System32\\wbem\\WmiPrvSE.exe | GUID: {d273d0f0-807e-5f67-ce06-000000000800} | Parent: C:\\Windows\\System32\\svchost.exe | Cmd: C:\\windows\\system32\\wbem\\wmiprvse.exe -secured -Embedding\r\n2026-05-06T00:00:54.710Z | evt-02583 | Code: 4688 |  | GUID: None | Parent:  | Cmd: C:\\windows\\system32\\wbem\\wmiprvse.exe -secured -Embedding\r\n2026-05-06T00:01:09.899Z | evt-02901 | Code: 1 | C:\\Windows\\System32\\whoami.exe | GUID: {d273d0f0-808e-5f67-cf06-000000000800} | Parent: C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe | Cmd: \"C:\\windows\\system32\\whoami.exe\"\r\n2026-05-06T00:01:10.928Z | evt-02955 | Code: 4688 |  | GUID: None | Parent:  | Cmd: \"C:\\windows\\system32\\whoami.exe\"\r\n"]
[139.68019, "o", "\u001b[?2004hroot@c50e0daa8a0b:~# "]
[153.474656, "i", "cat << 'EOF' > /tmp/get_all_malicious_events.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events\")\nrows = [dict(r) for r in cur.fetchall()]\n\nmalicious_ids = set()\n\n# Malicious Process GUIDs on WS-05\nmal_ws05_guids = {'{b34bc01c-7dfc-5f67-de11-000000000400}'}\n\n# Malicious Process GUIDs on WS-06\nmal_ws06_guids = {\n    '{d273d0f0-8078-5f67-cb06-000000000800}', # cmd\n    '{d273d0f0-8078-5f67-cc06-000000000800}', # powershell\n    '{d273d0f0-8078-5f67-cd06-000000000800}', # conhost\n    '{d273d0f0-808e-5f67-cf06-000000000800}'  # whoami\n}\n\n# Let's verify if there are any other process creations on WS-06 or WS-05 that have these GUIDs as parent\n# Let's search message contents for any parent process GUID or process GUID\n# Also let's search for Security Event IDs that map to these process creations (e.g. sharing command line, timestamp, user, image)\nfor r in rows:\n    eid = r['event_id']\n    host = r['host']\n    ecode = r['event_code']\n    msg = r['message'] or \"\"\n    details = r['details'] or \"\"\n    p_guid = r['process_guid']\n    cmd = r['command_line'] or \"\"\n    img = r['image'] or \"\"\n    \n    # WS-05 Malicious Process Events\n    is_ws05_malicious = False\n    if 'WS-05' in host:\n        if p_guid in mal_ws05_guids:\n            is_ws05_malicious = True\n        else:\n            # Check if any known GUID is in message or details\n            for g in mal_ws05_guids:\n                if g in msg or g in details:\n                    is_ws05_malicious = True\n                    break\n        # Check for Security logs that correspond to the malicious process\n        # On WS-05, we have WFP events, are they related to process ID 6404?\n        # In Sysmon, code 3, network connection has process ID of the powershell.exe process.\n        # Let's verify Process ID for the powershell.exe on WS-05.\n        # Wait, let's look if we can extract Process ID of the powershell.exe.\n        \n    # WS-06 Malicious Process Events\n    is_ws06_malicious = False\n    if 'WS-06' in host:\n        if p_guid in mal_ws06_guids:\n            is_ws06_malicious = True\n        else:\n            for g in mal_ws06_guids:\n                if g in msg or g in details:\n                    is_ws06_malicious = True\n                    break\n        \n        # Security logs corresponding to these events\n        # evt-01226 (cmd), evt-01238 (powershell), evt-01240 (conhost), evt-02955 (whoami)\n        if eid in ('evt-01226', 'evt-01238', 'evt-01240', 'evt-02955'):\n            is_ws06_malicious = True\n            \n        # The service creation registry events and service installation events on WS-06\n        # Updater service\n        if eid in ('evt-01050', 'evt-01051', 'evt-01052', 'evt-01053', 'evt-01054', 'evt-01055', 'evt-01056', 'evt-01251'):\n            is_ws06_malicious = True\n            \n        target = (r['target_object'] or \"\").lower()\n        service_name = (r['service_name'] or \"\").lower()\n        if 'updater' in cmd.lower() or 'updater' in target or 'updater' in service_name:\n            is_ws06_malicious = True\n\n    if is_ws05_malicious:\n        malicious_ids.add(eid)\n    if is_ws06_malicious:\n        malicious_ids.add(eid)\n\nprint(f\"Total unique malicious events collected: {len(malicious_ids)}\")\nEOF\npython3 /tmp/get_all_malicious_events.py\n"]
