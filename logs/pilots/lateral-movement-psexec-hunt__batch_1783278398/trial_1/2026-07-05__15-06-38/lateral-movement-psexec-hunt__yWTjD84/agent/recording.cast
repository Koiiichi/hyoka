[92.038898, "i", "cat << 'EOF' > /tmp/ws05_powershell.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND (event_code IN (800, 4103, 4104))\n    ORDER BY timestamp\n\"\"\")\nrows = cur.fetchall()\n\nprint(f\"WS-05 has {len(rows)} PowerShell events.\")\n# Let's print some messages to see if they are benign management scripts\nfor i, r in enumerate(rows[:20]):\n    print(f\"Event {r['event_id']} ({r['event_code']}):\")\n    print(r['message'][:300])\n    print(\"-\"*40)\n\nEOF\npython3 /tmp/ws05_powershell.py\n"]
