[51.083493, "i", "cat << 'EOF' > /tmp/investigate.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events ORDER BY timestamp\")\nrows = [dict(r) for r in cur.fetchall()]\n\n# Let's inspect event logs. What hosts do we have?\nhosts = set(r['host'] for r in rows if r['host'])\nprint(\"Hosts:\", hosts)\n\n# Group events by host\nevents_by_host = {}\nfor h in hosts:\n    events_by_host[h] = []\nfor r in rows:\n    if r['host']:\n        events_by_host[r['host']].append(r)\n\n# Let's write a script that does thorough hunting:\n# 1. We know WS-06 is compromised starting around 2026-05-06T00:00:47\n# Let's inspect everything on WS-06 between 2026-05-06T00:00:00 and 2026-05-06T00:15:00\nprint(\"--- WS-06 Timeline (first few mins) ---\")\nmalicious_keywords = ['powershell', 'cmd.exe', 'whoami', 'updater', 'services.exe', 'schtasks', 'wmi', 'conhost.exe', 'psexec', 'paexec']\nfor r in events_by_host['WS-06.corp.example']:\n    ts = r['timestamp']\n    if '2026-05-06T00:00:00' <= ts <= '2026-05-06T00:05:00':\n        cmd = r['command_line'] or \"\"\n        img = r['image'] or \"\"\n        parent = r['parent_image'] or \"\"\n        e_code = r['event_code']\n        usr = r['user'] or \"\"\n        tgt_usr = r['target_user'] or \"\"\n        \n        # Print if it has anything suspicious or related to execution\n        is_suspicious = False\n        if any(k in cmd.lower() or k in img.lower() or k in parent.lower() for k in malicious_keywords):\n            is_suspicious = True\n        if e_code in (1, 3, 11, 12, 13, 22, 4688, 7045, 4697, 7009, 4104):\n            is_suspicious = True\n            \n        if is_suspicious:\n            print(f\"{ts} | {r['event_id']} | Event {e_code} | Host: {r['host']} | User: {usr} (Tgt: {tgt_usr}) | Image: {img} | Parent: {parent} | Cmd: {cmd[:150]} | Msg: {str(r['message'])[:100]}\")\n\nEOF\npython3 /tmp/investigate.py > /tmp/timeline_ws06.txt\nhead -n 100 /tmp/timeline_ws06.txt\n"]
