[59.471047, "i", "cat << 'EOF' > /tmp/investigate.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events ORDER BY timestamp\")\nrows = [dict(r) for r in cur.fetchall()]\n\nhosts = set(r['host'] for r in rows if r['host'])\nprint(\"Hosts:\", hosts)\n\n# Filter rules to exclude known noisy background activity\ndef is_noisy(r):\n    img = (r['image'] or \"\").lower()\n    parent = (r['parent_image'] or \"\").lower()\n    cmd = (r['command_line'] or \"\").lower()\n    service_name = (r['service_name'] or \"\").lower()\n    \n    if 'officec2rclient.exe' in img or 'officec2rclient.exe' in parent:\n        return True\n    if 'clicktorun' in img or 'clicktorun' in parent:\n        return True\n    if 'wmiprvse.exe' in img and 'svchost.exe' in parent:\n        # WMI provider host is normal unless we see specific command lines\n        if not cmd or cmd == 'c:\\\\windows\\\\system32\\\\wbem\\\\wmiprvse.exe -secured -embedding':\n            return True\n    if 'svchost.exe' in img and not cmd:\n        return True\n    # filter out background noise on some registry events\n    if r['event_code'] in (12, 13, 14):\n        target = (r['target_object'] or \"\").lower()\n        if 'office' in target or 'clicktorun' in target:\n            return True\n        if 'cryptography\\\\providers' in target:\n            return True\n    return False\n\nwith open('/tmp/timeline_filtered.txt', 'w') as f:\n    for r in rows:\n        if is_noisy(r):\n            continue\n        \n        ts = r['timestamp']\n        eid = r['event_id']\n        ecode = r['event_code']\n        host = r['host']\n        usr = r['user'] or \"\"\n        img = r['image'] or \"\"\n        parent = r['parent_image'] or \"\"\n        cmd = r['command_line'] or \"\"\n        \n        # Let's print clean representation\n        f.write(f\"{ts} | {eid} | {ecode} | {host} | {usr} | {img} | {parent} | {cmd[:200]} | {r['message'][:200] if r['message'] else ''}\\n\")\n\nprint(\"Filtered timeline written to /tmp/timeline_filtered.txt\")\nEOF\npython3 /tmp/investigate.py\nwc -l /tmp/timeline_filtered.txt\nhead -n 50 /tmp/timeline_filtered.txt\n"]
