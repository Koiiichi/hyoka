[78.125783, "i", "cat << 'EOF' > /tmp/hunt_all.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events\")\nrows = [dict(r) for r in cur.fetchall()]\n\n# Let's count how many powershell events exist per host\nfrom collections import Counter\npwsh_hosts = Counter(r['host'] for r in rows if r['event_code'] in (800, 4103, 4104))\nprint(\"PowerShell events count per host:\", pwsh_hosts)\n\n# Let's search for standard lateral movement or credentials dumping tools\n# like Mimikatz (sekurlsa, logonpasswords), psexec, secretsdump, wmic, winrm\nfor r in rows:\n    cmd = (r['command_line'] or \"\").lower()\n    img = (r['image'] or \"\").lower()\n    service_file = (r['service_file_name'] or \"\").lower()\n    eid = r['event_id']\n    host = r['host']\n    \n    # check for suspicious strings\n    for keyword in ['mimikatz', 'sekurlsa', 'logonpasswords', 'psexec', 'paexec', 'secretsdump', 'lsass', 'procdump', 'rundll32.exe comsvcs', 'sam_', 'system_', 'security_', 'active directory', 'ntds.dit']:\n        if keyword in cmd or keyword in service_file:\n            print(f\"SUSPICIOUS {keyword} on {host}: {eid} | {r['event_code']} | {cmd or service_file}\")\n\nEOF\npython3 /tmp/hunt_all.py\n"]
