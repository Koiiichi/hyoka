[122.419847, "i", "cat << 'EOF' > /tmp/get_ws05_guid.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT * FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (image LIKE '%powershell.exe%' \n           OR parent_image LIKE '%powershell.exe%'\n           OR target_image LIKE '%powershell.exe%')\n\"\"\")\nrows = [dict(r) for r in cur.fetchall()]\n\nguids = set()\nfor r in rows:\n    if r['process_guid']:\n        guids.add(r['process_guid'])\n\nprint(\"Process GUIDs found on WS-05:\", guids)\n\n# Let's search for ALL events on WS-05 with these GUIDs or parent GUIDs\nall_malicious_ws05 = []\nfor r in rows:\n    all_malicious_ws05.append(r['event_id'])\n\n# Let's search for any network connection or registry modification with these GUIDs\nif guids:\n    guid_list = \"', '\".join(guids)\n    cur.execute(f\"\"\"\n        SELECT * FROM events \n        WHERE host = 'WS-05.corp.example'\n          AND (process_guid IN ('{guid_list}') \n               OR details LIKE '%{list(guids)[0]}%'\n               OR message LIKE '%{list(guids)[0]}%')\n    \"\"\")\n    for r in cur.fetchall():\n        all_malicious_ws05.append(r['event_id'])\n\nprint(f\"Found {len(set(all_malicious_ws05))} malicious event IDs on WS-05 so far.\")\nprint(set(all_malicious_ws05))\nEOF\npython3 /tmp/get_ws05_guid.py\n"]
