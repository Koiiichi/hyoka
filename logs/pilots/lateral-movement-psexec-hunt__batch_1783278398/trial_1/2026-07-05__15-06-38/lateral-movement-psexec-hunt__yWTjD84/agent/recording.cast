[199.488485, "o", "An account was successfully logged on.\r\r\n\r\r\nSubject:\r\r\n\tSecurity ID:\t\tS-1-0-0\r\r\n\tAccount Name:\t\t-\r\r\n\tAccount Domain:\t\t-\r\r\n\tLogon ID:\t\t0x0\r\r\n\r\r\nLogon Information:\r\r\n\tLogon Type:\t\t3\r\r\n\tRestricted Admin Mode:\t-\r\r\n\tVirtual Account:\t\tNo\r\r\n\tElevated Token:\t\tYes\r\r\n\r\r\nImpersonation Level:\t\tImpersonation\r\r\n\r\r\nNew Logon:\r\r\n\tSecurity ID:\t\tS-1-5-21-4228717743-1032521047-1810997296-1104\r\r\n\tAccount Name:\t\tm.ward\r\r\n\tAccount Domain:\t\tCORP.LOCAL\r\r\n\tLogon ID:\t\t0x2990D17\r\r\n\tLinked Logon ID:\t\t0x0\r\r\n\tNetwork Account Name:\t-\r\r\n\tNetwork Account Domain:\t-\r\r\n\tLogon GUID:\t\t{f1b93498-ce83-d667-f3b7-7d3bc595a088}\r\r\n\r\r\nProcess Information:\r\r\n\tProcess ID:\t\t0x0\r\r\n\tProcess Name:\t\t-\r\r\n\r\r\nNetwork Information:\r\r\n\tWorkstation Name:\t-\r\r\n\tSource Network Address:\t172.18.39.5\r\r\n\tSource Port:\t\t56608\r\r\n\r\r\nDetailed Authentication Information:\r\r\n\tLogon Process:\t\tKerberos\r\r\n\tAuthentication Package:\tKerberos\r\r\n\tTransited Services:\t-\r\r\n\tPackage Name (NTLM only):\t-\r\r\n\tKey Length:\t\t0\r\r\n\r\r\nThis event is generated when a logon session is created. It is generated on the computer that was accessed.\r\r\n\r\r\nThe subject fields indicate the account on the local system which requested the logon. This is most commonly a service such as the Server service, or a local process such as Winlogon.exe or Services.exe.\r\r\n\r\r\nThe logon type field indicates the kind of logon that occurred. The most common types are 2 (interactive) and 3 (network).\r\r\n\r\r\nThe New Logon fields indicate the account for whom the new logon was created, i.e. the account that was logged on.\r\r\n\r\r\nThe network fields indicate where a remote logon request originated. Workstation name is not always available and may be left blank in some cases.\r\r\n\r\r\nThe impersonation level field indicates the extent to which a process in the logon session can impersonate.\r\r\n\r\r\nThe authentication information fields provide detailed information about this specific logon request.\r\r\n\t- Logon GUID is a unique identifier that can be used to correlate this event with a KDC event.\r\r\n\t- Transited services indicate which intermediate services\r\n"]
[199.489779, "o", "\u001b[?2004hroot@c50e0daa8a0b:~# "]
[204.93587, "i", "cat << 'EOF' > /tmp/get_correlated_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, host, message \n    FROM events \n    WHERE host LIKE '%WS-06%'\n      AND (message LIKE '%0x2990D17%'\n           OR message LIKE '%0x2990d17%'\n           OR message LIKE '%f1b93498-ce83-d667-f3b7-7d3bc595a088%'\n           OR details LIKE '%0x2990D17%'\n           OR details LIKE '%0x2990d17%'\n           OR details LIKE '%f1b93498-ce83-d667-f3b7-7d3bc595a088%')\n\"\"\")\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} correlated events on WS-06\")\nfor r in rows:\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | Msg: {r['message'][:150] if r['message'] else ''}\")\n\nEOF\npython3 /tmp/get_correlated_events.py\n"]
[204.938002, "o", "cat << 'EOF' > /tmp/get_correlated_events.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
