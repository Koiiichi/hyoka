[133.225261, "o", "            # process_guid, details, message, etc.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.225355, "o", "            # Let's check if message or details contains the parent GUID\r\n\u001b[?2004l\r\u001b[?2004h>             msg = r['message'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.225394, "o", "            details = r['details'] or \"\"\r\n"]
[133.225495, "o", "\u001b[?2004l\r"]
[133.225558, "o", "\u001b[?2004h>             for g in list(known_guids):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.22566, "o", "                if g in msg or g in details:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.225742, "o", "                    if r['process_guid']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.22586, "o", "                        known_guids.add(r['process_guid'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[133.225985, "o", "\u001b[?2004h> "]
[133.226052, "o", "print(\"All malicious GUIDs on WS-06:\", known_guids)\r\n\u001b[?2004l\r"]
[133.226103, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.226221, "o", "# Now let's collect all event IDs associated with these GUIDs on WS-06\r\n\u001b[?2004l\r\u001b[?2004h> malicious_ws06 = set()"]
[133.226346, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.226416, "o", "    msg = r['message'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     details = r['details'] or \"\""]
[133.226479, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.226499, "o", "    guid_in_msg = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.226628, "o", "    for g in known_guids:\r\n\u001b[?2004l\r"]
[133.226664, "o", "\u001b[?2004h>         if g in msg or g in details or r['process_guid'] == g:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.226796, "o", "            guid_in_msg = True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>     if guid_in_msg:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.226836, "o", "        malicious_ws06.add(r['event_id'])\r\n\u001b[?2004l\r"]
[133.226871, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[133.226937, "o", "> "]
[133.227038, "o", "# Also let's check if the service \"Updater\" events are collected\r\n\u001b[?2004l\r\u001b[?2004h> # HKLM\\System\\CurrentControlSet\\Services\\Updater registry keys\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.227066, "o", "> "]
[133.227222, "o", "# Event IDs: evt-01055, evt-01056, and evt-01251 (Service Install)\r\n\u001b[?2004l\r\u001b[?2004h> # Let's check for any event containing 'Updater' or service registry keys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.227251, "o", "for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.22748, "o", "    cmd = (r['command_line'] or \"\").lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.227544, "o", "    target = (r['target_object'] or \"\").lower()\r\n\u001b[?2004l\r\u001b[?2004h>     service_name = (r['service_name'] or \"\").lower()\r\n\u001b[?2004l\r"]
[133.227624, "o", "\u001b[?2004h> "]
[133.227763, "o", "    if 'updater' in cmd or 'updater' in target or 'updater' in service_name:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ws06.add(r['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.227852, "o", "print(f\"Found {len(malicious_ws06)} malicious event IDs on WS-06.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.227973, "o", "print(sorted(list(malicious_ws06)))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[133.229087, "o", "\u001b[?2004hroot@c50e0daa8a0b:~# python3 /tmp/get_ws06_malicious.py\r\n\u001b[?2004l\r"]
