[99.369491, "i", "cat << 'EOF' > /tmp/beacon_trace.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events\")\nrows = [dict(r) for r in cur.fetchall()]\n\n# Let's inspect which processes are running this beacon\n# We see it in PowerShell logs (800, 4103, 4104), but what processes created them?\n# We need to trace by process GUID or process ID if possible, or timestamps\npwsh_processes = {}\nfor r in rows:\n    if r['event_code'] in (1, 4688):\n        # process creation\n        cmd = (r['command_line'] or \"\").lower()\n        if 'powershell' in cmd or 'cmd.exe' in cmd:\n            print(f\"Process Creation: {r['timestamp']} | {r['event_id']} | {r['host']} | {r['image']} | {r['command_line'][:150]} | GUID: {r['process_guid']}\")\n\nEOF\npython3 /tmp/beacon_trace.py\n"]
