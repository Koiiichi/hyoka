[351.296584, "i", "cat << 'EOF' > /tmp/consolidate_findings.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events\")\nrows = [dict(r) for r in cur.fetchall()]\n\nmalicious = set()\n\n# 1. WS-05 PowerShell engine events\nws05_pwsh_count = 0\nfor r in rows:\n    if r['host'] == 'WS-05.corp.example' and (r['event_code'] in (400, 600, 800, 4103, 4104)):\n        malicious.add(r['event_id'])\n        ws05_pwsh_count += 1\nprint(f\"WS-05 PowerShell engine events: {ws05_pwsh_count}\")\n\n# 2. WS-05 Sysmon events for the malicious process GUID\nws05_sysmon_count = 0\nmal_ws05_guids = {'{b34bc01c-7dfc-5f67-de11-000000000400}'}\nfor r in rows:\n    if r['host'] == 'WS-05.corp.example':\n        guid = r['process_guid']\n        msg = r['message'] or \"\"\n        details = r['details'] or \"\"\n        if guid in mal_ws05_guids:\n            malicious.add(r['event_id'])\n            ws05_sysmon_count += 1\n        else:\n            for g in mal_ws05_guids:\n                if g in msg or g in details:\n                    malicious.add(r['event_id'])\n                    ws05_sysmon_count += 1\n                    break\nprint(f\"WS-05 Sysmon events (GUID): {ws05_sysmon_count}\")\n\n# 3. WS-05 Security events for PID 6404\nws05_sec_count = 0\nfor r in rows:\n    if r['host'] == 'WS-05.corp.example' and r['event_code'] in (5156, 5158):\n        msg = r['message'] or \"\"\n        if '6404' in msg:\n            malicious.add(r['event_id'])\n            ws05_sec_count += 1\nprint(f\"WS-05 Security events: {ws05_sec_count}\")\n\n# 4. WS-06 shortname events (PowerShell stager)\nws06_short_count = 0\nfor r in rows:\n    if r['host'] == 'WS-06':\n        malicious.add(r['event_id'])\n        ws06_short_count += 1\nprint(f\"WS-06 shortname events: {ws06_short_count}\")\n\n# 5. WS-06.corp.example Sysmon events for the malicious process GUIDs\nws06_sysmon_count = 0\nmal_ws06_guids = {\n    '{d273d0f0-8078-5f67-cb06-000000000800}', # cmd\n    '{d273d0f0-8078-5f67-cc06-000000000800}', # powershell\n    '{d273d0f0-8078-5f67-cd06-000000000800}', # conhost\n    '{d273d0f0-808e-5f67-cf06-000000000800}'  # whoami\n}\nfor r in rows:\n    if r['host'] == 'WS-06.corp.example':\n        guid = r['process_guid']\n        msg = r['message'] or \"\"\n        details = r['details'] or \"\"\n        if guid in mal_ws06_guids:\n            malicious.add(r['event_id'])\n            ws06_sysmon_count += 1\n        else:\n            for g in mal_ws06_guids:\n                if g in msg or g in details:\n                    malicious.add(r['event_id'])\n                    ws06_sysmon_count += 1\n                    break\nprint(f\"WS-06 Sysmon events (GUIDs): {ws06_sysmon_count}\")\n\n# 6. WS-06.corp.example Security process creations & authentication\nws06_sec_count = 0\nws06_sec_ids = {\n    'evt-01226', 'evt-01238', 'evt-01240', 'evt-02955', # process creations\n    'evt-01208', 'evt-01209', 'evt-01210', 'evt-01211', 'evt-01212', 'evt-01213', 'evt-01214', # logon / service install\n    'evt-03552' # logoff\n}\nfor r in rows:\n    if r['event_id'] in ws06_sec_ids:\n        malicious.add(r['event_id'])\n        ws06_sec_count += 1\nprint(f\"WS-06 Security events: {ws06_sec_count}\")\n\n# 7. WS-06.corp.example Updater service manager installation & registry events\nws06_updater_count = 0\nws06_updater_ids = {'evt-01251', 'evt-01055', 'evt-01056'}\nfor r in rows:\n    if r['event_id'] in ws06_updater_ids:\n        malicious.add(r['event_id'])\n        ws06_updater_count += 1\nprint(f\"WS-06 Updater service events: {ws06_updater_count}\")\n\n# 8. DC01 Kerberos ticket request\ndc01_count = 0\nif 'evt-01222' in [r['event_id'] for r in rows]:\n    malicious.add('evt-01222')\n    dc01_count += 1\nprint(f\"DC01 Kerberos events: {dc01_count}\")\n\nprint(f\"TOTAL UNIQUE MALICIOUS EVENTS: {len(malicious)}\")\n\n# Save findings\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(malicious)), f)\nprint(\"Saved findings to /root/findings.json\")\n\nEOF\npython3 /tmp/consolidate_findings.py\n"]
