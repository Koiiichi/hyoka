[232.535585, "i", "cat << 'EOF' > /tmp/find_dc01_kerberos.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host LIKE '%DC01%' AND event_code = 4769\")\nfor r in cur.fetchall():\n    print(f\"{r['timestamp']} | {r['event_id']} | {r['user']} | {r['message'][:200]}\")\n\nEOF\npython3 /tmp/find_dc01_kerberos.py\n"]
