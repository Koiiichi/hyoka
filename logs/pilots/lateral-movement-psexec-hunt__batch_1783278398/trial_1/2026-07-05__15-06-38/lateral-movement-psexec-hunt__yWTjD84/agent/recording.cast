[39.739489, "i", "cat << 'EOF' > /tmp/hunt3.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's fetch all rows from database to analyze locally\ncur.execute(\"SELECT * FROM events\")\nrows = [dict(r) for r in cur.fetchall()]\n\n# Find some obvious malicious markers:\n# - powershell with base64 (-enc or -encodedcommand)\n# - Service installation \"Updater\" or similar\n# - Network connections from powershell, cmd, services, rundll32, regsvr32, mshta etc.\n# - Pipe creation (17, 18) for cobalt strike or psexec pipes\n# - Process injection (8, 10 - Sysmon 10 is ProcessAccess, but 8 is CreateRemoteThread, let's look for process access with full control)\n# - lateral movement using WMI or SMB\n\nmalicious_ids = set()\nsuspects = []\n\nfor r in rows:\n    eid = r['event_id']\n    ecode = r['event_code']\n    cmd = r['command_line'] or \"\"\n    image = r['image'] or \"\"\n    parent = r['parent_image'] or \"\"\n    service_file = r['service_file_name'] or \"\"\n    service_name = r['service_name'] or \"\"\n    msg = r['message'] or \"\"\n\n    # Check service creations\n    if ecode in (7045, 4697):\n        if \"Updater\" in service_name or \"Updater\" in service_file or \"powershell\" in service_file.lower() or \"cmd.exe\" in service_file.lower():\n            malicious_ids.add(eid)\n            suspects.append((r['timestamp'], eid, f\"Malicious Service: {service_name} -> {service_file}\"))\n\n    # Check process creations\n    if ecode in (1, 4688):\n        # check encoded powershell\n        if \"-enc\" in cmd.lower() or \"-encodedcommand\" in cmd.lower():\n            malicious_ids.add(eid)\n            suspects.append((r['timestamp'], eid, f\"Encoded PowerShell: {cmd[:200]}\"))\n        # check whoami under SYSTEM\n        if \"whoami\" in cmd.lower() and r['user'] in ('NT AUTHORITY\\\\SYSTEM', 'SYSTEM', 'NT AUTHORITY\\\\SYSTEM (S-1-5-18)'):\n            malicious_ids.add(eid)\n            suspects.append((r['timestamp'], eid, f\"SYSTEM whoami: {cmd}\"))\n        # other weird processes\n        if \"conhost.exe\" in image.lower() and \"powershell\" in parent.lower():\n            # is this part of the chain? conhost spawned by the malicious powershell?\n            # conhost.exe spawned by powershell in evt-01240\n            # Let's correlate by checking if parent is our malicious powershell\n            pass\n\n# Let's inspect Sysmon 10 (Process Access)\n# Cobalt strike or remote thread or LSASS dumping\n# Count the target images for Sysmon 10\nsysmon10 = [r for r in rows if r['event_code'] == 10]\nfor s in sysmon10:\n    # look for lsass access or unusual source image accessing other things\n    src = s['source_image'] if 'source_image' in s else s['image']\n    tgt = s['target_image']\n    # If source is powershell.exe and accessing lsass or target is weird\n    if \"powershell.exe\" in src.lower() and \"lsass.exe\" in tgt.lower():\n        malicious_ids.add(s['event_id'])\n        suspects.append((s['timestamp'], s['event_id'], f\"PowerShell accessing LSASS: {src} -> {tgt}\"))\n\n# Output all suspects sorted by timestamp\nsuspects.sort(key=lambda x: x[0])\nfor ts, eid, desc in suspects:\n    print(f\"{ts} | {eid} | {desc}\")\n\nEOF\npython3 /tmp/hunt3.py\n"]
