[320.900477, "i", "cat << 'EOF' > /tmp/get_ws05_pids.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Find processes on WS-05 with process ID or parent process ID matching 3192 or 3200\ncur.execute(\"\"\"\n    SELECT event_id, event_code, image, command_line, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (message LIKE '%3192%' OR message LIKE '%3200%' OR details LIKE '%3192%' OR details LIKE '%3200%')\n\"\"\")\nfor r in cur.fetchall()[:20]:\n    print(f\"{r['event_id']} | Code {r['event_code']} | Image: {r['image']} | Cmd: {r['command_line']} | Msg: {r['message'][:120] if r['message'] else ''}\")\n\nEOF\npython3 /tmp/get_ws05_pids.py\n"]
