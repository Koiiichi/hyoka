[133.222329, "i", "cat << 'EOF' > /tmp/get_ws06_malicious.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host LIKE '%WS-06%'\")\nrows = [dict(r) for r in cur.fetchall()]\n\n# Let's find the malicious process GUIDs we know about on WS-06\n# cmd.exe (evt-01057): {d273d0f0-8078-5f67-cb06-000000000800}\n# powershell.exe (evt-01073): {d273d0f0-8078-5f67-cc06-000000000800}\n# Also powershell.exe in evt-01238, let's see if there is a GUID.\nknown_guids = {'{d273d0f0-8078-5f67-cb06-000000000800}', '{d273d0f0-8078-5f67-cc06-000000000800}'}\n\n# Let's iterate over rows to find any more process creations where the parent is one of the known malicious processes,\n# and add their GUIDs to the known malicious set.\nfor _ in range(5): # iterative convergence\n    for r in rows:\n        if r['event_code'] in (1, 4688):\n            parent_guid = r['process_guid'] # Wait, parent process GUID is often recorded, let's check field names\n            # Actually in Sysmon, we have process_guid and parent_process_guid? No, the schema showed:\n            # process_guid, details, message, etc.\n            # Let's check if message or details contains the parent GUID\n            msg = r['message'] or \"\"\n            details = r['details'] or \"\"\n            for g in list(known_guids):\n                if g in msg or g in details:\n                    if r['process_guid']:\n                        known_guids.add(r['process_guid'])\n\nprint(\"All malicious GUIDs on WS-06:\", known_guids)\n\n# Now let's collect all event IDs associated with these GUIDs on WS-06\nmalicious_ws06 = set()\nfor r in rows:\n    msg = r['message'] or \"\"\n    details = r['details'] or \"\"\n    guid_in_msg = False\n    for g in known_guids:\n        if g in msg or g in details or r['process_guid'] == g:\n            guid_in_msg = True\n            break\n    if guid_in_msg:\n        malicious_ws06.add(r['event_id'])\n\n# Also let's check if the service \"Updater\" events are collected\n# HKLM\\System\\CurrentControlSet\\Services\\Updater registry keys\n# Event IDs: evt-01055, evt-01056, and evt-01251 (Service Install)\n# Let's check for any event containing 'Updater' or service registry keys\nfor r in rows:\n    cmd = (r['command_line'] or \"\").lower()\n    target = (r['target_object'] or \"\").lower()\n    service_name = (r['service_name'] or \"\").lower()\n    if 'updater' in cmd or 'updater' in target or 'updater' in service_name:\n        malicious_ws06.add(r['event_id'])\n\nprint(f\"Found {len(malicious_ws06)} malicious event IDs on WS-06.\")\nprint(sorted(list(malicious_ws06)))\nEOF\npython3 /tmp/get_ws06_malicious.py\n"]
