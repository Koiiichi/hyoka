[85.300542, "i", "cat << 'EOF' > /tmp/hunt_other_hosts.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host LIKE '%DC01%' OR host LIKE '%WS-05%'\")\nrows = [dict(r) for r in cur.fetchall()]\n\nprint(f\"Total events on DC01 and WS-05: {len(rows)}\")\n\n# Let's count event codes on these hosts\nfrom collections import Counter\nc_dc01 = Counter(r['event_code'] for r in rows if 'DC01' in r['host'])\nc_ws05 = Counter(r['event_code'] for r in rows if 'WS-05' in r['host'])\nprint(\"DC01 Event Codes:\", c_dc01)\nprint(\"WS-05 Event Codes:\", c_ws05)\n\n# Process creations on DC01 or WS-05\nprint(\"=== Process Creations on DC01 or WS-05 ===\")\nfor r in rows:\n    if r['event_code'] in (1, 4688):\n        print(f\"{r['timestamp']} | {r['event_id']} | {r['host']} | {r['user']} | {r['image']} | {r['command_line']}\")\n\nEOF\npython3 /tmp/hunt_other_hosts.py\n"]
