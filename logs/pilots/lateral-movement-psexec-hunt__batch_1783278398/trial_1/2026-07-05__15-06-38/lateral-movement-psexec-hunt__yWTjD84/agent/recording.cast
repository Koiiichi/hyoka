[107.645674, "i", "cat << 'EOF' > /tmp/correlate_ws05.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example'\")\nrows = [dict(r) for r in cur.fetchall()]\n\n# Let's extract all process IDs from the PowerShell events on WS-05\n# In Event 800, the message has: \"HostId=\" or \"DetailSequence=\"\n# Let's see what is inside the messages\npids = set()\nfor r in rows:\n    if r['event_code'] in (800, 4103, 4104):\n        msg = r['message'] or \"\"\n        # Let's search for Process ID or Host ID\n        # Usually in Sysmon or Security logs we have ProcessId / ProcessGuid.\n        # Let's see if we can find any Sysmon events on WS-05 with process name powershell.exe or similar\n        pass\n\n# Let's look at Sysmon events on WS-05 (channel 'Microsoft-Windows-Sysmon/Operational')\nsysmon_ws05 = [r for r in rows if 'Sysmon' in (r['channel'] or \"\")]\nprint(f\"Found {len(sysmon_ws05)} Sysmon events on WS-05\")\n\n# Let's group Sysmon events by process image\nfrom collections import defaultdict\nby_image = defaultdict(list)\nfor s in sysmon_ws05:\n    img = s['image'] or \"\"\n    by_image[img].append(s)\n\nfor img, evs in by_image.items():\n    print(f\"Image: {img} -> {len(evs)} events (Codes: {set(e['event_code'] for e in evs)})\")\n\nEOF\npython3 /tmp/correlate_ws05.py\n"]
