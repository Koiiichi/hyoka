[273.939162, "i", "cat << 'EOF' > /tmp/evaluate_all.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events\")\nrows = [dict(r) for r in cur.fetchall()]\n\nmalicious = set()\n\n# Malicious GUIDs\nmal_guids = {\n    '{b34bc01c-7dfc-5f67-de11-000000000400}', # WS-05 powershell\n    '{d273d0f0-8078-5f67-cb06-000000000800}', # WS-06 cmd\n    '{d273d0f0-8078-5f67-cc06-000000000800}', # WS-06 powershell\n    '{d273d0f0-8078-5f67-cd06-000000000800}', # WS-06 conhost\n    '{d273d0f0-808e-5f67-cf06-000000000800}'  # WS-06 whoami\n}\n\nfor r in rows:\n    eid = r['event_id']\n    host = r['host']\n    guid = r['process_guid']\n    msg = r['message'] or \"\"\n    details = r['details'] or \"\"\n    \n    # All events on host 'WS-06' shortname are PowerShell events of the malicious stager\n    if host == 'WS-06':\n        malicious.add(eid)\n        continue\n        \n    if guid in mal_guids:\n        malicious.add(eid)\n    else:\n        for g in mal_guids:\n            if g in msg or g in details:\n                malicious.add(eid)\n                break\n\n# Manual additions\nmalicious.add('evt-01222') # DC01 Kerberos ticket request\nmalicious.add('evt-01226') # WS-06 Security process creation (cmd)\nmalicious.add('evt-01238') # WS-06 Security process creation (powershell)\nmalicious.add('evt-01240') # WS-06 Security process creation (conhost)\nmalicious.add('evt-02955') # WS-06 Security process creation (whoami)\n\nmalicious.add('evt-01208') # Special privileges assigned to new logon\nmalicious.add('evt-01209') # An account was successfully logged on (m.ward)\nmalicious.add('evt-01210') # Group membership information\nmalicious.add('evt-01211') # A handle to an object was requested\nmalicious.add('evt-01212') # A handle to an object was requested\nmalicious.add('evt-01213') # A service was installed in the system\nmalicious.add('evt-01214') # An operation was attempted on a privileged object\nmalicious.add('evt-01251') # Service manager service installation registry event\nmalicious.add('evt-01055') # Service display name setting\nmalicious.add('evt-01056') # Service object name setting\nmalicious.add('evt-03552') # Logoff of m.ward's session on WS-06\n\nprint(f\"Total collected: {len(malicious)}\")\nprint(\"By Host:\")\nhost_counts = {}\nfor eid in malicious:\n    r = next(row for row in rows if row['event_id'] == eid)\n    h = r['host']\n    host_counts[h] = host_counts.get(h, 0) + 1\nprint(host_counts)\n\n# Let's save the list to findings.json\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(malicious)), f)\n\nprint(\"Findings saved to /root/findings.json\")\nEOF\npython3 /tmp/evaluate_all.py\n"]
[273.939577, "o", "cat << 'EOF' > /tmp/evaluate_all.py\r\n\u001b[?2004l\r"]
[273.93963, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.939849, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.939931, "o", "conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r"]
[273.940024, "o", "\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT * FROM events\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.940215, "o", "rows = [dict(r) for r in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> malicious = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.940263, "o", "# Malicious GUIDs\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.940296, "o", "> mal_guids = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.940475, "o", "    '{b34bc01c-7dfc-5f67-de11-000000000400}', # WS-05 powershell\r\n\u001b[?2004l\r\u001b[?2004h>     '{d273d0f0-8078-5f67-cb06-000000000800}', # WS-06 cmd\r\n\u001b[?2004l\r"]
[273.940565, "o", "\u001b[?2004h> "]
[273.940807, "o", "    '{d273d0f0-8078-5f67-cc06-000000000800}', # WS-06 powershell\r\n\u001b[?2004l\r\u001b[?2004h>     '{d273d0f0-8078-5f67-cd06-000000000800}', # WS-06 conhost\r\n\u001b[?2004l\r"]
[273.940868, "o", "\u001b[?2004h> "]
[273.941024, "o", "    '{d273d0f0-808e-5f67-cf06-000000000800}'  # WS-06 whoami\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.941057, "o", "for r in rows:\r\n\u001b[?2004l\r"]
[273.941115, "o", "\u001b[?2004h> "]
[273.941204, "o", "    eid = r['event_id']\r\n\u001b[?2004l\r\u001b[?2004h>     host = r['host']\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.941231, "o", "> "]
[273.941351, "o", "    guid = r['process_guid']\r\n\u001b[?2004l\r\u001b[?2004h>     msg = r['message'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.941372, "o", "    details = r['details'] or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[273.941547, "o", "\u001b[?2004h> "]
[273.941687, "o", "    # All events on host 'WS-06' shortname are PowerShell events of the malicious stager\r\n\u001b[?2004l\r\u001b[?2004h>     if host == 'WS-06':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.941738, "o", "        malicious.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n"]
[273.941748, "o", "\u001b[?2004l\r\u001b[?2004h"]
[273.941902, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.941957, "o", "    if guid in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious.add(eid)\r\n"]
[273.942114, "o", "\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.942334, "o", "        for g in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h>             if g in msg or g in details:\r\n\u001b[?2004l\r\u001b[?2004h>                 malicious.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.94251, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Manual additions\r\n\u001b[?2004l\r\u001b[?2004h> malicious.add('evt-01222') # DC01 Kerberos ticket request\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.942709, "o", "malicious.add('evt-01226') # WS-06 Security process creation (cmd)\r\n\u001b[?2004l\r\u001b[?2004h> malicious.add('evt-01238') # WS-06 Security process creation (powershell)\r\n\u001b[?2004l\r"]
[273.942965, "o", "\u001b[?2004h> malicious.add('evt-01240') # WS-06 Security process creation (conhost)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.943093, "o", "malicious.add('evt-02955') # WS-06 Security process creation (whoami)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.943218, "o", "malicious.add('evt-01208') # Special privileges assigned to new logon\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.943249, "o", "malicious.add('evt-01209') # An account was successfully logged on (m.ward)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.943407, "o", "malicious.add('evt-01210') # Group membership information\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.943448, "o", "malicious.add('evt-01211') # A handle to an object was requested\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.943545, "o", "malicious.add('evt-01212') # A handle to an object was requested\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.943764, "o", "malicious.add('evt-01213') # A service was installed in the system\r\n\u001b[?2004l\r\u001b[?2004h> malicious.add('evt-01214') # An operation was attempted on a privileged object\r\n"]
[273.9439, "o", "\u001b[?2004l\r"]
[273.943933, "o", "\u001b[?2004h> "]
[273.944048, "o", "malicious.add('evt-01251') # Service manager service installation registry event\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.944237, "o", "malicious.add('evt-01055') # Service display name setting\r\n\u001b[?2004l\r\u001b[?2004h> malicious.add('evt-01056') # Service object name setting\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.944368, "o", "malicious.add('evt-03552') # Logoff of m.ward's session on WS-06\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.944395, "o", "print(f\"Total collected: {len(malicious)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.944492, "o", "print(\"By Host:\")\r\n\u001b[?2004l\r\u001b[?2004h> host_counts = {}\r\n\u001b[?2004l\r\u001b[?2004h> for eid in malicious:\r\n\u001b[?2004l\r"]
[273.944661, "o", "\u001b[?2004h> "]
[273.944691, "o", "    r = next(row for row in rows if row['event_id'] == eid)\r\n\u001b[?2004l\r\u001b[?2004h>     h = r['host']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.944911, "o", "    host_counts[h] = host_counts.get(h, 0) + 1\r\n\u001b[?2004l\r\u001b[?2004h> print(host_counts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.945025, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.945156, "o", "# Let's save the list to findings.json\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.945238, "o", "    json.dump(sorted(list(malicious)), f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.945351, "o", "print(\"Findings saved to /root/findings.json\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
