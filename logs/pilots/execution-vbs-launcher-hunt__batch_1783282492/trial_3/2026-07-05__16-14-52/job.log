bj: {row[\'target_object\']}")\n\n# Let\'s search for correlated security events (e.g., 4688, 4624, 4672, etc.)\n# For 4688 events that correspond to our Sysmon 1 events (by PID, host, time, command line)\n# Let\'s extract command lines of malicious processes\nmal_cmdlines = []\ncursor.execute("SELECT command_line, host FROM events WHERE event_id IN ( {}" .format(", ".join(f"\'{x}\'" for x in malicious_events)) + ")")\nfor row in cursor.fetchall():\n    if row[\'command_line\']:\n        mal_cmdlines.append((row[\'command_line\'].strip(), row[\'host\']))\n\nfor cmd, host in mal_cmdlines:\n    # search for 4688 with similar command line on same host\n    cursor.execute("SELECT event_id FROM events WHERE event_code = 4688 AND host = ? AND command_line LIKE ?", (host, f"%{cmd}%"))\n    for row in cursor.fetchall():\n        malicious_events.add(row[\'event_id\'])\n\nprint(f"Identified {len(malicious_events)} events so far.")\nEOF\npython3 hunt.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
