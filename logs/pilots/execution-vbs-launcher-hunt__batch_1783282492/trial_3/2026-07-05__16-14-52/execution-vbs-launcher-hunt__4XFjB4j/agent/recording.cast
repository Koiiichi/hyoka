[110.932845, "o", "# Let's inspect PowerShell Operational channel and Windows PowerShell channel!\r\n\u001b[?2004l\r\u001b[?2004h> # Since these events don't have process_guid or a clearly parsed decimal PID, let's look at how they specify PID.\r\n\u001b[?2004l\r"]
[110.932863, "o", "\u001b[?2004h> "]
[110.93304, "o", "# Let's search for PID in operational and classic PowerShell logs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.933123, "o", "for row in cursor.execute(\"SELECT event_id, host, event_code, channel, message FROM events WHERE channel LIKE '%PowerShell%'\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.933226, "o", "    msg = row['message'] or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.933372, "o", "    # Sometimes message is empty but details has it, or message has the PID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.933465, "o", "    # Let's extract PID from message (PowerShell logs sometimes have ID or Host ID)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.933555, "o", "    # E.g. \"Host Application = ...\" or \"Process ID = 2316\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.933624, "o", "    pids_found = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.933728, "o", "    for m in re.finditer(r'Process ID\\s*=\\s*(\\d+)', msg, re.IGNORECASE):\r\n\u001b[?2004l\r\u001b[?2004h>         pids_found.append(int(m.group(1)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.933843, "o", "    for m in re.finditer(r'ProcessID\\s*=\\s*(\\d+)', msg, re.IGNORECASE):\r\n\u001b[?2004l\r\u001b[?2004h>         pids_found.append(int(m.group(1)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.933916, "o", "    for m in re.finditer(r'processId:\\s*(\\d+)', msg, re.IGNORECASE):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.933937, "o", "        pids_found.append(int(m.group(1)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.934089, "o", "    # If nothing in message, what about other fields? \r\n\u001b[?2004l\r\u001b[?2004h>     # Let's see if we can find any other indicator\r\n\u001b[?2004l\r"]
[110.934144, "o", "\u001b[?2004h>     is_mal = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
