[174.393674, "i", "cat << 'EOF' > check_other_hosts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's inspect DNS queries (Code 22) or network connections on WS-06 or DC01\nprint(\"=== DNS and Net on DC01 / WS-06 ===\")\ncursor.execute(\"SELECT event_id, host, event_code, image, command_line, src_ip, dst_ip, dst_port, details FROM events WHERE host != 'WS-05.corp.example' AND event_code IN (3, 22, 5156)\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\n# Let's see if there are any other registry keys added (Code 12, 13) or files created (Code 11) on other hosts that look suspicious\nprint(\"\\n=== Registry/Files on DC01 / WS-06 ===\")\ncursor.execute(\"SELECT event_id, host, event_code, image, target_object, details FROM events WHERE host != 'WS-05.corp.example' AND event_code IN (11, 12, 13, 4670)\")\nfor r in cursor.fetchall():\n    # filter out obvious ones if we want, or just print\n    print(dict(r))\n\nEOF\npython3 check_other_hosts.py\n"]
