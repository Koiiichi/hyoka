[164.56063, "i", "cat << 'EOF' > classify_all_sysmon.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's get the malicious process guids first\nmalicious_guids = set()\ncursor.execute(\"SELECT process_guid FROM events WHERE event_code = 1 AND command_line LIKE '%launcher.vbs%'\")\nfor r in cursor.fetchall():\n    if r['process_guid']:\n        malicious_guids.add(r['process_guid'])\n\nadded = True\nwhile added:\n    added = False\n    cursor.execute(\"SELECT process_guid, parent_process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IS NOT NULL\")\n    for r in cursor.fetchall():\n        guid = r['process_guid']\n        pguid = r['parent_process_guid']\n        if pguid in malicious_guids and guid not in malicious_guids:\n            malicious_guids.add(guid)\n            added = True\n\nprint(\"Malicious GUIDs:\", malicious_guids)\n\n# Now, let's query all Sysmon events on WS-05 and find those NOT generated by these process GUIDs\n# (i.e. process_guid and parent_process_guid not in malicious_guids)\nprint(\"\\n=== NON-MALICIOUS SYSMON EVENTS ON WS-05 ===\")\ncursor.execute(\"SELECT event_id, event_code, image, command_line, details, target_object, src_ip, dst_ip, dst_port, process_guid, parent_process_guid FROM events WHERE host = 'WS-05.corp.example' AND channel = 'Microsoft-Windows-Sysmon/Operational'\")\nnon_mal_events = []\nfor r in cursor.fetchall():\n    p_g = r['process_guid']\n    p_p_g = r['parent_process_guid']\n    if p_g not in malicious_guids and p_p_g not in malicious_guids:\n        non_mal_events.append(r)\n\nby_code = {}\nfor r in non_mal_events:\n    by_code[r['event_code']] = by_code.get(r['event_code'], []) + [r]\n\nfor code, events in sorted(by_code.items()):\n    print(f\"\\n--- Code {code} (Count: {len(events)}) ---\")\n    for r in events[:5]:\n        print(f\"{r['event_id']} | img: {r['image']} | cmd: {r['command_line']} | det: {r['details']} | obj: {r['target_object']} | net: {r['src_ip']}->{r['dst_ip']}:{r['dst_port']}\")\n\nEOF\npython3 classify_all_sysmon.py\n"]
