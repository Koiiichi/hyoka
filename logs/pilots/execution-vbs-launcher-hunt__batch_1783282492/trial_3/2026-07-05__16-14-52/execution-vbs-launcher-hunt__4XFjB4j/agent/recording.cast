[66.00068, "i", "cat << 'EOF' > security_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's list all Security events (not in Sysmon channel) on WS-05 where user is m.ward or related to these times.\n# Let's see the channel distribution first.\ncursor.execute(\"SELECT channel, COUNT(*) FROM events GROUP BY channel\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\n# Let's see Security event codes on WS-05:\ncursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host = 'WS-05.corp.example' AND channel = 'Security' GROUP BY event_code\")\nfor r in cursor.fetchall():\n    print(dict(r))\nEOF\npython3 security_events.py\n"]
