[17.959374, "o", "# Let's search for events on WS-05 first and trace the process tree from launcher.vbs\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's print some info to start\r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== SUSPICIOUS PROCESSES ===\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (1, 4688)\"): \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{row['event_id']} | {row['timestamp']} | {row['user']} | {row['image']} | {row['parent_image']} | {row['command_line']} | {row['process_guid']} | {row['parent_process_guid']}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
