[110.919671, "i", "cat << 'EOF' > find_all_malicious_events.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmalicious_ids = set()\n\n# Let's extract malicious processes first\nmalicious_pids = set() # (host, pid_decimal)\nmalicious_guids = set() # guid\n\n# We know launcher.vbs is malicious\n# Let's find its pid and guid\ncursor.execute(\"SELECT event_id, host, process_guid, message FROM events WHERE event_code = 1 AND command_line LIKE '%launcher.vbs%'\")\nfor r in cursor.fetchall():\n    malicious_ids.add(r['event_id'])\n    malicious_guids.add(r['process_guid'])\n    # Extacting ProcessId from message or elsewhere\n    # Wait, let's extract PID from message using regex if possible\n    m = re.search(r'ProcessId:\\s*(\\d+)', r['message'])\n    if m:\n        malicious_pids.add((r['host'], int(m.group(1))))\n\n# Also let's search for the 4688 events for wscript.exe or powershell\n# 4688 has process ID in hex or message\n# Let's write a recursive finder that matches parent-child by GUID\nadded = True\nwhile added:\n    added = False\n    cursor.execute(\"SELECT event_id, host, process_guid, parent_process_guid, message, command_line FROM events WHERE event_code IN (1, 4688)\")\n    for r in cursor.fetchall():\n        if r['event_id'] in malicious_ids:\n            continue\n        guid = r['process_guid']\n        pguid = r['parent_process_guid']\n        if pguid in malicious_guids:\n            malicious_ids.add(r['event_id'])\n            if guid:\n                malicious_guids.add(guid)\n                added = True\n            m = re.search(r'ProcessId:\\s*(\\d+)', r['message'] or '')\n            if m:\n                malicious_pids.add((r['host'], int(m.group(1))))\n\nprint(f\"Malicious Process GUIDs: {malicious_guids}\")\nprint(f\"Malicious PIDs: {malicious_pids}\")\n\n# Let's also parse the Security log process creation (4688) for launcher.vbs or children\n# In 4688, we have New Process ID (hex format, e.g. 0x123) and Creator Process ID (hex)\n# Let's get PIDs of processes in 4688 that match our malicious ones\nfor row in cursor.execute(\"SELECT event_id, host, message, command_line FROM events WHERE event_code = 4688\"):\n    if row['event_id'] in malicious_ids:\n        continue\n    # Check if command line contains launcher.vbs or if Creator Process ID matches a malicious PID\n    cmd = row['command_line'] or ''\n    msg = row['message'] or ''\n    # Search for Creator Process ID in message\n    # e.g., Creator Process ID: 0x988\n    # Let's extract New Process ID and Creator Process ID\n    # Format: Creator Process ID:\t0x988\n    # New Process ID:\t0x8c4\n    m_creator = re.search(r'Creator Process ID:\\s*(0x[0-9a-fA-F]+)', msg)\n    m_new = re.search(r'New Process ID:\\s*(0x[0-9a-fA-F]+)', msg)\n    \n    is_mal = False\n    if 'launcher.vbs' in cmd or 'launcher.vbs' in msg:\n        is_mal = True\n    elif m_creator:\n        creator_pid = int(m_creator.group(1), 16)\n        if (row['host'], creator_pid) in malicious_pids:\n            is_mal = True\n            \n    if is_mal:\n        malicious_ids.add(row['event_id'])\n        if m_new:\n            new_pid = int(m_new.group(1), 16)\n            malicious_pids.add((row['host'], new_pid))\n            print(f\"Added 4688 event {row['event_id']} with PID {new_pid} (hex {m_new.group(1)})\")\n\n# Let's print out all event codes for Sysmon and search for matching process_guid or parent_process_guid\ncursor.execute(\"SELECT event_id, event_code, host, message FROM events WHERE process_guid IS NOT NULL OR parent_process_guid IS NOT NULL\")\nfor row in cursor.fetchall():\n    # Wait, process_guid or parent_process_guid matching\n    # Actually we already checked Sysmon events by querying DB for process_guid in list_events.py.\n    # Let's find all Sysmon events (and others) that have process_guid or parent_process_guid in malicious_guids\n    pass\n\n# Let's find any event in the DB where process_guid in malicious_guids OR parent_process_guid in malicious_guids\ncursor.execute(\"SELECT event_id, event_code, host, image, command_line FROM events\")\nfor row in cursor.execute(\"SELECT event_id"]
[110.920669, "i", ", event_code, host, process_guid, parent_process_guid, message FROM events\"):\n    p_g = row['process_guid']\n    p_p_g = row['parent_process_guid']\n    if p_g in malicious_guids or p_p_g in malicious_guids:\n        malicious_ids.add(row['event_id'])\n\n# Now let's handle Security logs! \n# Security logs don't have process_guid, but they have Process ID (in hex or decimal in message), and host.\n# Let's inspect each Security log on WS-05 and see if the process ID belongs to malicious_pids\nfor row in cursor.execute(\"SELECT event_id, host, event_code, message FROM events WHERE channel = 'Security' AND host = 'WS-05.corp.example'\"):\n    msg = row['message'] or ''\n    # Let's search for Process ID or ProcessId in message\n    # In some events, like 4656/4663/4690, the message has \"Process ID:\t\t0x988\"\n    # In some events, like 4673 (Privilege service called), it has \"Process ID:\t\t0x988\"\n    # In some events, like 4670 (Permissions changed), let's see\n    # In 5156/5158 (Connection/Port bind), it has \"Process ID:\t\t2440\" (sometimes decimal! Let's check)\n    \n    # Let's search for hex and decimal PIDs in message\n    pids_found = []\n    for m in re.finditer(r'Process ID:\\s*(0x[0-9a-fA-F]+)', msg):\n        pids_found.append(int(m.group(1), 16))\n    for m in re.finditer(r'Process ID:\\s*(\\d+)(?!\\w)', msg):\n         pids_found.append(int(m.group(1)))\n    for m in re.finditer(r'ProcessId:\\s*(\\d+)(?!\\w)', msg):\n         pids_found.append(int(m.group(1)))\n         \n    is_mal = False\n    for pid in pids_found:\n        if (row['host'], pid) in malicious_pids:\n            is_mal = True\n            break\n            \n    if is_mal:\n        malicious_ids.add(row['event_id'])\n\n# Let's inspect PowerShell Operational channel and Windows PowerShell channel!\n# Since these events don't have process_guid or a clearly parsed decimal PID, let's look at how they specify PID.\n# Let's search for PID in operational and classic PowerShell logs\nfor row in cursor.execute(\"SELECT event_id, host, event_code, channel, message FROM events WHERE channel LIKE '%PowerShell%'\"):\n    msg = row['message'] or ''\n    # Sometimes message is empty but details has it, or message has the PID\n    # Let's extract PID from message (PowerShell logs sometimes have ID or Host ID)\n    # E.g. \"Host Application = ...\" or \"Process ID = 2316\"\n    pids_found = []\n    for m in re.finditer(r'Process ID\\s*=\\s*(\\d+)', msg, re.IGNORECASE):\n        pids_found.append(int(m.group(1)))\n    for m in re.finditer(r'ProcessID\\s*=\\s*(\\d+)', msg, re.IGNORECASE):\n        pids_found.append(int(m.group(1)))\n    for m in re.finditer(r'processId:\\s*(\\d+)', msg, re.IGNORECASE):\n        pids_found.append(int(m.group(1)))\n    # If nothing in message, what about other fields? \n    # Let's see if we can find any other indicator\n    is_mal = False\n    for pid in pids_found:\n        if (row['host'], pid) in malicious_pids:\n            is_mal = True\n            break\n    if is_mal:\n        malicious_ids.add(row['event_id'])\n\nprint(f\"Total Malicious Event IDs identified: {len(malicious_ids)}\")\n\nEOF\npython3 find_all_malicious_events.py\n"]
