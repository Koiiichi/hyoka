[56.481505, "i", "cat << 'EOF' > list_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Malicious process guids\nmal_guids = {'{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'}\n\n# Let's find any other child processes\nadded = True\nwhile added:\n    added = False\n    cursor.execute(\"SELECT process_guid, parent_process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IS NOT NULL\")\n    for row in cursor.fetchall():\n        p = row['process_guid']\n        parent = row['parent_process_guid']\n        if parent in mal_guids and p not in mal_guids:\n            mal_guids.add(p)\n            added = True\n\nprint(\"Malicious Process GUIDs:\", mal_guids)\n\n# Find all events matching these process GUIDs\nevents_by_code = {}\nall_matching_events = []\n\ncursor.execute(\"SELECT event_id, event_code, host, image, command_line, process_guid, parent_process_guid FROM events\")\nfor row in cursor.fetchall():\n    # Check if process_guid or parent_process_guid matches\n    is_mal = False\n    p_guid = row['process_guid']\n    parent_guid = row['parent_process_guid']\n    if p_guid in mal_guids or parent_guid in mal_guids:\n        is_mal = True\n    \n    # If it is a Security 4688 event, sometimes process_guid is not present or populated differently.\n    # Let's check if the command line matches one of our malicious processes\n    # Also, check logon events or other security events that are directly related to our process.\n    \n    if is_mal:\n        all_matching_events.append(row)\n        events_by_code[row['event_code']] = events_by_code.get(row['event_code'], 0) + 1\n\nprint(\"Malicious events by event_code:\")\nfor code, count in sorted(events_by_code.items()):\n    print(f\"Code {code}: {count}\")\n\n# Print a sample of each code\nprint(\"\\nSamples:\")\nfor code in sorted(events_by_code.keys()):\n    print(f\"\\n--- CODE {code} ---\")\n    sampled = 0\n    for row in all_matching_events:\n        if row['event_code'] == code:\n            print(f\"{row['event_id']} | {row['host']} | {row['image']} | {row['command_line']}\")\n            sampled += 1\n            if sampled >= 3:\n                break\n\nEOF\npython3 list_events.py\n"]
