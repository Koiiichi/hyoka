[110.9343, "o", "        if (row['host'], pid) in malicious_pids:\r\n\u001b[?2004l\r\u001b[?2004h>             is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>             break"]
[110.93434, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     if is_mal:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(row['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.934347, "o", "\u001b[?2004h> "]
