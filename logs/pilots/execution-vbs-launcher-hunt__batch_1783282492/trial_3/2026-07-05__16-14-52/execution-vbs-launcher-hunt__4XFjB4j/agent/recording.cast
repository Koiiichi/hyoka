[184.917112, "o", "> "]
[184.917233, "o", "            malicious_ids.add(r['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h>             if guid:\r\n\u001b[?2004l\r"]
[184.917248, "o", "\u001b[?2004h"]
[184.917501, "o", ">                 malicious_guids.add(guid)\r\n"]
[184.917524, "o", "\u001b[?2004l\r"]
[184.917648, "o", "\u001b[?2004h>                 added = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.917742, "o", "            m = re.search(r'ProcessId:\\s*(\\d+)', r['message'] or '')\r\n\u001b[?2004l\r\u001b[?2004h>             if m:\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.917954, "o", ">                 malicious_pids.add((r['host'], int(m.group(1))))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 3. 4688 tracking (matching Creator PID / command line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.91813, "o", "for row in cursor.execute(\"SELECT event_id, host, message, command_line FROM events WHERE event_code = 4688\"):\r\n\u001b[?2004l\r\u001b[?2004h>     if row['event_id'] in malicious_ids:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = row['command_line'] or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.91817, "o", "    msg = row['message'] or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.918271, "o", "    m_creator = re.search(r'Creator Process ID:\\s*(0x[0-9a-fA-F]+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.918363, "o", "    m_new = re.search(r'New Process ID:\\s*(0x[0-9a-fA-F]+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     is_mal = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.918374, "o", "    if 'launcher.vbs' in cmd or 'launcher.vbs' in msg:"]
[184.918451, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = True\r\n\u001b[?2004l\r"]
[184.918473, "o", "\u001b[?2004h"]
[184.918577, "o", ">     elif m_creator:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.918654, "o", "        creator_pid = int(m_creator.group(1), 16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.918876, "o", "        if (row['host'], creator_pid) in malicious_pids:\r\n\u001b[?2004l\r\u001b[?2004h>             is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     if is_mal:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(row['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h>         if m_new:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.918896, "o", "            new_pid = int(m_new.group(1), 16)\r\n\u001b[?2004l\r\u001b[?2004h>             malicious_pids.add((row['host'], new_pid))\r\n\u001b[?2004l\r"]
[184.918945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.919087, "o", "# 4. Any event with malicious process_guid or parent_process_guid\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.execute(\"SELECT event_id, process_guid, parent_process_guid FROM events\"):\r\n\u001b[?2004l\r\u001b[?2004h>     p_g = row['process_guid']\r\n\u001b[?2004l\r"]
[184.919192, "o", "\u001b[?2004h>     p_p_g = row['parent_process_guid']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.919263, "o", "    if p_g in malicious_guids or p_p_g in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.919427, "o", "        malicious_ids.add(row['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.91945, "o", "# 5. Security events matching PIDs\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.execute(\"SELECT event_id, host, message, details FROM events WHERE channel = 'Security'\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.919525, "o", "    msg = (row['message'] or '') + \" \" + (row['details'] or '')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.919543, "o", "    pids_found = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.919714, "o", "    for m in re.finditer(r'Process ID:\\s*(0x[0-9a-fA-F]+)', msg):\r\n\u001b[?2004l\r\u001b[?2004h>         pids_found.append(int(m.group(1), 16))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.919802, "o", "    for m in re.finditer(r'Process ID:\\s*(\\d+)(?!\\w)', msg):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.919899, "o", "         pids_found.append(int(m.group(1)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.919983, "o", "    for m in re.finditer(r'ProcessId:\\s*(\\d+)(?!\\w)', msg):\r\n\u001b[?2004l\r"]
[184.920081, "o", "\u001b[?2004h>          pids_found.append(int(m.group(1)))\r\n\u001b[?2004l\r\u001b[?2004h>          \r\n\u001b[?2004l\r\u001b[?2004h>     is_mal = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.920246, "o", "    for pid in pids_found:\r\n\u001b[?2004l\r\u001b[?2004h>         if (row['host'], pid) in malicious_pids:\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.920264, "o", ">             is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>     if is_mal:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.92034, "o", "        malicious_ids.add(row['event_id'])\r\n"]
[184.920368, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.920478, "o", "# 6. ALL PowerShell events on WS-05\r\n\u001b[?2004l\r"]
[184.920597, "o", "\u001b[?2004h> "]
[184.920642, "o", "for row in cursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND channel LIKE '%PowerShell%'\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.920743, "o", "    malicious_ids.add(row['event_id'])\r\n\u001b[?2004l\r"]
[184.920783, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.920862, "o", "findings = sorted(list(malicious_ids))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.920874, "o", "print(f\"Total flagged malicious events: {len(findings)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.920972, "o", "\u001b[?2004h> "]
[184.921036, "o", "# Let's write the output\r\n\u001b[?2004l\r"]
[184.921226, "o", "\u001b[?2004h> with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r"]
[184.921245, "o", "\u001b[?2004h> "]
[184.921252, "o", "    json.dump(findings, f)\r\n\u001b[?2004l\r"]
[184.921443, "o", "\u001b[?2004h> print(\"Saved findings to /root/findings.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.921522, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[184.922406, "o", "\u001b[?2004hroot@cf92ba90aad2:~# "]
