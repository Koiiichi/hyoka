ple||C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe||||{860ba2e3-9f13-5f52-2703-000000000400}\r\nevt-02057|800|2026-05-06T00:01:08.271Z|WS-05.corp.example||||||\r\nevt-02058|800|2026-05-06T00:01:08.272Z|WS-05.corp.example||||||\r\nevt-02059|800|2026-05-06T00:01:08.274Z|WS-05.corp.example||||||\r\nevt-02060|4103|2026-05-06T00:01:08.274Z|WS-05.corp.example||||||\r\nevt-02061|4103|2026-05-06T00:01:08.275Z|WS-05.corp.example||||||\r\nevt-02062|800|2026-05-06T00:01:08.275Z|WS-05.corp.example||||||\r\nevt-02063|800|2026-05-06T00:01:08.276Z|WS-05.corp.example||||||\r\nevt-02064|4103|2026-05-06T00:01:08.278Z|WS-05.corp.example||||||\r\nevt-02065|4103|2026-05-06T00:01:08.278Z|WS-05.corp.example||||||\r\nevt-02066|800|2026-05-06T00:01:08.278Z|WS-05.corp.example||||||\r\nevt-02067|800|2026-05-06T00:01:08.279Z|WS-05.corp.example||||||\r\n\u001b[?2004hroot@cf92ba90aad2:~# "]
[17.957593, "i", "cat << 'EOF' > hunt.py\nimport sqlite3\nimport json\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's find all processes created starting with launcher.vbs or wscript.exe\n# Process GUIDs of interest:\n# Let's search for events on WS-05 first and trace the process tree from launcher.vbs\n\n# Let's print some info to start\nprint(\"=== SUSPICIOUS PROCESSES ===\")\nfor row in cursor.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (1, 4688)\"): \n    print(f\"{row['event_id']} | {row['timestamp']} | {row['user']} | {row['image']} | {row['parent_image']} | {row['command_line']} | {row['process_guid']} | {row['parent_process_guid']}\")\n\nEOF\npython3 hunt.py\n"]
