[110.931395, "o", "    # In some events, like 4656/4663/4690, the message has \"Process ID:\u0007"]
[110.931453, "o", "\u00070x988\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.931579, "o", "    # In some events, like 4673 (Privilege service called), it has \"Process ID:\u0007\u00070x988\"\r\n\u001b[?2004l\r"]
[110.93164, "o", "\u001b[?2004h>     # In some events, like 4670 (Permissions changed), let's see\r\n\u001b[?2004l\r"]
[110.931721, "o", "\u001b[?2004h> "]
[110.931781, "o", "    # In 5156/5158 (Connection/Port bind), it has \"Process ID:\u0007\u0007"]
[110.931912, "o", "2440\" (sometimes decimal! Let's check)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Let's search for hex and decimal PIDs in message\r\n\u001b[?2004l\r\u001b[?2004h>     pids_found = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.932017, "o", "    for m in re.finditer(r'Process ID:\\s*(0x[0-9a-fA-F]+)', msg):\r\n\u001b[?2004l\r\u001b[?2004h>         pids_found.append(int(m.group(1), 16))\r\n\u001b[?2004l\r\u001b[?2004h"]
