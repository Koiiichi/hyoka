[42.277091, "i", "cat << 'EOF' > non_ws05.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== WS-06 EVENTS ===\")\nfor row in cursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host = 'WS-06.corp.example' GROUP BY event_code\"):\n    print(f\"{row[0]}: {row[1]}\")\n\nprint(\"=== DC01 EVENTS ===\")\nfor row in cursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host = 'DC01.corp.example' GROUP BY event_code\"):\n    print(f\"{row[0]}: {row[1]}\")\n\nprint(\"=== m.ward EVENTS on other hosts ===\")\nfor row in cursor.execute(\"SELECT event_id, event_code, host, user, target_user, logon_type, ip_address FROM (\" \\\n                          \"SELECT event_id, event_code, host, user, target_user, logon_type, src_ip as ip_address FROM events \" \\\n                          \"UNION SELECT event_id, event_code, host, user, target_user, logon_type, dst_ip as ip_address FROM events) \" \\\n                          \"WHERE user LIKE '%ward%' OR target_user LIKE '%ward%'\"):\n    print(dict(row))\nEOF\npython3 non_ws05.py\n"]
