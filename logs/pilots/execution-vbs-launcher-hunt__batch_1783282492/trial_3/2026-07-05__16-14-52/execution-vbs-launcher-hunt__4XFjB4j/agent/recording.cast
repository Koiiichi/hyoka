[28.423263, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # We will recursively find child processes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.42332, "o", "added = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.423514, "o", "while added:\r\n\u001b[?2004l\r\u001b[?2004h>     added = False\r\n\u001b[?2004l\r\u001b[?2004h>     # Query child processes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.423822, "o", "    cursor.execute(\"SELECT process_guid, parent_process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IS NOT NULL\")"]
[28.423942, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.42405, "o", "        p_guid = row['process_guid']\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.424151, "o", ">         parent_guid = row['parent_process_guid']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.424177, "o", "        if parent_guid in process_guids and p_guid not in process_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.424363, "o", "            process_guids.add(p_guid)\r\n\u001b[?2004l\r\u001b[?2004h>             added = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.424562, "o", "print(f\"Process GUIDs traced: {process_guids}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.424736, "o", "# Find all event IDs for these processes (creation / termination / network / file / registry)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.424886, "o", "# Sysmon events have process_guid or parent_process_guid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.425008, "o", "# Let's search all events for references to these process GUIDs\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.425086, "o", "> "]
[28.425135, "o", "for guid in process_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.425328, "o", "    cursor.execute(\"SELECT event_id, event_code, host, image, command_line, details, target_object FROM events WHERE process_guid = ? OR parent_process_guid = ?\", (guid, guid))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.425415, "o", "    for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.425505, "o", "        malicious_events.add(row['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.425711, "o", "        print(f\"Direct association: {row['event_id']} | code: {row['event_code']} | image: {row['image']} | cmd: {row['command_line']} | details: {row['details']} | obj: {row['target_object']}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.425834, "o", "# Let's search for correlated security events (e.g., 4688, 4624, 4672, etc.)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.425971, "o", "# For 4688 events that correspond to our Sysmon 1 events (by PID, host, time, command line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.426141, "o", "# Let's extract command lines of malicious processes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.426169, "o", "mal_cmdlines = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.426386, "o", "cursor.execute(\"SELECT command_line, host FROM events WHERE event_id IN ( {}\" .format(\", \".join(f\"'{x}'\" for x in malicious_events)) + \")\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.426491, "o", "for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     if row['command_line']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.426681, "o", ">         mal_cmdlines.append((row['command_line'].strip(), row['host']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.426711, "o", "> \r\n\u001b[?2004l\r"]
[28.426777, "o", "\u001b[?2004h> "]
[28.426831, "o", "for cmd, host in mal_cmdlines:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.427388, "o", "    # search for 4688 with similar command line on same host\r\n\u001b[?2004l\r\u001b[?2004h>     cursor.execute(\"SELECT event_id FROM events WHERE event_code = 4688 AND host = ? AND command_line LIKE ?\", (host, f\"%{cmd}%\"))\r\n\u001b[?2004l\r\u001b[?2004h>     for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_events.add(row['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Identified {len(malicious_events)} events so far.\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[28.428547, "o", "\u001b[?2004hroot@cf92ba90aad2:~# "]
[28.428632, "o", "python3 hunt.py\r\n\u001b[?2004l\r"]
[28.441744, "o", "Process GUIDs traced: {'{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f13-5f52-2803-000000000400}', '{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'}\r\n"]
