[85.960517, "i", "cat << 'EOF' > baseline.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's count events per host\nprint(\"=== HOSTS ===\")\ncursor.execute(\"SELECT host, COUNT(*) FROM events GROUP BY host\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\n# Let's count events per channel on each host\nprint(\"\\n=== HOST/CHANNELS ===\")\ncursor.execute(\"SELECT host, channel, COUNT(*) FROM events GROUP BY host, channel\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\n# Let's look at DC01.corp.example events\nprint(\"\\n=== DC01.corp.example EVENTS ===\")\ncursor.execute(\"SELECT event_code, COUNT(*), MIN(timestamp), MAX(timestamp) FROM events WHERE host = 'DC01.corp.example' GROUP BY event_code\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\n# Let's look at WS-06.corp.example events\nprint(\"\\n=== WS-06.corp.example EVENTS ===\")\ncursor.execute(\"SELECT event_code, COUNT(*), MIN(timestamp), MAX(timestamp) FROM events WHERE host = 'WS-06.corp.example' GROUP BY event_code\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nEOF\npython3 baseline.py\n"]
