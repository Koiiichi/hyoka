[149.28723, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[149.287345, "o", "    if row['event_id'] not in malicious_ids:\r\n\u001b[?2004l\r\u001b[?2004h>         remaining_events.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.287506, "o", "        key = (row['channel'], row['event_code'])\r\n\u001b[?2004l\r\u001b[?2004h>         remaining_by_code[key] = remaining_by_code.get(key, 0) + 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.287703, "o", "print(\"\\n=== REMAINING BENIGN EVENTS ON WS-05 ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.287957, "o", "for key, count in sorted(remaining_by_code.items()):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{key}: {count}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's inspect some of these remaining events\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n--- SAMPLES OF REMAINING EVENTS ---\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.288126, "o", "for (channel, code), count in sorted(remaining_by_code.items()):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\n--- {channel} | Code {code} (Count: {count}) ---\")\r\n\u001b[?2004l\r\u001b[?2004h>     sampled = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for r in remaining_events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.288265, "o", "        if r['channel'] == channel and r['event_code'] == code:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.288398, "o", "            print(f\"{r['event_id']} | user: {r['user']} | img: {r['image']} | cmd: {r['command_line']} | msg: {r['message'][:150] if r['message'] else ''}\")\r\n\u001b[?2004l\r\u001b[?2004h>             sampled += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.288425, "o", "> "]
