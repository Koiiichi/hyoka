[28.421023, "i", "cat << 'EOF' > hunt.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's collect all events related to the intrusion\nmalicious_events = set()\n\n# Suspicious process GUIDs\nprocess_guids = set()\n\n# Initial known malicious process execution\n# wscript.exe: {860ba2e3-9f13-5f52-2603-000000000400}\n# powershell.exe: {860ba2e3-9f13-5f52-2703-000000000400}\n# whoami.exe: {860ba2e3-9f2e-5f52-2a03-000000000400}\ninitial_guids = ['{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}']\nfor g in initial_guids:\n    process_guids.add(g)\n\n# We will recursively find child processes\nadded = True\nwhile added:\n    added = False\n    # Query child processes\n    cursor.execute(\"SELECT process_guid, parent_process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IS NOT NULL\")\n    for row in cursor.fetchall():\n        p_guid = row['process_guid']\n        parent_guid = row['parent_process_guid']\n        if parent_guid in process_guids and p_guid not in process_guids:\n            process_guids.add(p_guid)\n            added = True\n\nprint(f\"Process GUIDs traced: {process_guids}\")\n\n# Find all event IDs for these processes (creation / termination / network / file / registry)\n# Sysmon events have process_guid or parent_process_guid\n# Let's search all events for references to these process GUIDs\nfor guid in process_guids:\n    cursor.execute(\"SELECT event_id, event_code, host, image, command_line, details, target_object FROM events WHERE process_guid = ? OR parent_process_guid = ?\", (guid, guid))\n    for row in cursor.fetchall():\n        malicious_events.add(row['event_id'])\n        print(f\"Direct association: {row['event_id']} | code: {row['event_code']} | image: {row['image']} | cmd: {row['command_line']} | details: {row['details']} | obj: {row['target_object']}\")\n\n# Let's search for correlated security events (e.g., 4688, 4624, 4672, etc.)\n# For 4688 events that correspond to our Sysmon 1 events (by PID, host, time, command line)\n# Let's extract command lines of malicious processes\nmal_cmdlines = []\ncursor.execute(\"SELECT command_line, host FROM events WHERE event_id IN ( {}\" .format(\", \".join(f\"'{x}'\" for x in malicious_events)) + \")\")\nfor row in cursor.fetchall():\n    if row['command_line']:\n        mal_cmdlines.append((row['command_line'].strip(), row['host']))\n\nfor cmd, host in mal_cmdlines:\n    # search for 4688 with similar command line on same host\n    cursor.execute(\"SELECT event_id FROM events WHERE event_code = 4688 AND host = ? AND command_line LIKE ?\", (host, f\"%{cmd}%\"))\n    for row in cursor.fetchall():\n        malicious_events.add(row['event_id'])\n\nprint(f\"Identified {len(malicious_events)} events so far.\")\nEOF\npython3 hunt.py\n"]
