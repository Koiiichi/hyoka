[72.409766, "i", "cat << 'EOF' > detailed_hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's see what WMI event we have\nprint(\"=== WMI ===\")\ncursor.execute(\"SELECT * FROM events WHERE channel = 'Microsoft-Windows-WMI-Activity/Operational'\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\n# Let's inspect PowerShell events\nprint(\"\\n=== PowerShell Operational ===\")\n# Let's count by event_code for PowerShell\ncursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE channel = 'Microsoft-Windows-PowerShell/Operational' GROUP BY event_code\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\n# Let's see unique messages or scripts executed\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE channel = 'Microsoft-Windows-PowerShell/Operational' ORDER BY timestamp LIMIT 5\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\n# Let's inspect Windows PowerShell channel\nprint(\"\\n=== Windows PowerShell ===\")\ncursor.execute(\"SELECT event_code, COUNT(*) FROM events WHERE channel = 'Windows PowerShell' GROUP BY event_code\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nEOF\npython3 detailed_hunt.py\n"]
