[110.947893, "o", "Malicious Process GUIDs: {'{860ba2e3-9f2e-5f52-2a03-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2803-000000000400}'}\r\nMalicious PIDs: {('WS-05.corp.example', 7700), ('WS-05.corp.example', 2316), ('WS-05.corp.example', 2440), ('WS-05.corp.example', 9152)}\r\n"]
[110.948029, "o", "Added 4688 event evt-00247 with PID 2440 (hex 0x988)\r\nAdded 4688 event evt-00328 with PID 2316 (hex 0x90c)\r\n"]
[110.94826, "o", "Added 4688 event evt-00343 with PID 7700 (hex 0x1e14)\r\nAdded 4688 event evt-01817 with PID 9152 (hex 0x23c0)\r\n"]
[110.956644, "o", "Total Malicious Event IDs identified: 828\r\n"]
[110.959147, "o", "\u001b[?2004hroot@cf92ba90aad2:~# "]
[124.632052, "i", "cat << 'EOF' > verify.py\nimport sqlite3\nimport re\nimport json\n\n# Let's import the previous logic and run verification\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nmalicious_ids = set()\nmalicious_pids = set()\nmalicious_guids = set()\n\n# Find initial wscript.exe\ncursor.execute(\"SELECT event_id, host, process_guid, message FROM events WHERE event_code = 1 AND command_line LIKE '%launcher.vbs%'\")\nfor r in cursor.fetchall():\n    malicious_ids.add(r['event_id'])\n    if r['process_guid']:\n        malicious_guids.add(r['process_guid'])\n    m = re.search(r'ProcessId:\\s*(\\d+)', r['message'] or '')\n    if m:\n        malicious_pids.add((r['host'], int(m.group(1))))\n\n# Recursively find Sysmon child processes\nadded = True\nwhile added:\n    added = False\n    cursor.execute(\"SELECT event_id, host, process_guid, parent_process_guid, message FROM events WHERE event_code IN (1, 4688)\")\n    for r in cursor.fetchall():\n        if r['event_id'] in malicious_ids:\n            continue\n        guid = r['process_guid']\n        pguid = r['parent_process_guid']\n        if pguid in malicious_guids:\n            malicious_ids.add(r['event_id'])\n            if guid:\n                malicious_guids.add(guid)\n                added = True\n            m = re.search(r'ProcessId:\\s*(\\d+)', r['message'] or '')\n            if m:\n                malicious_pids.add((r['host'], int(m.group(1))))\n\n# Also map 4688 events\nfor row in cursor.execute(\"SELECT event_id, host, message, command_line FROM events WHERE event_code = 4688\"):\n    if row['event_id'] in malicious_ids:\n        continue\n    cmd = row['command_line'] or ''\n    msg = row['message'] or ''\n    m_creator = re.search(r'Creator Process ID:\\s*(0x[0-9a-fA-F]+)', msg)\n    m_new = re.search(r'New Process ID:\\s*(0x[0-9a-fA-F]+)', msg)\n    \n    is_mal = False\n    if 'launcher.vbs' in cmd or 'launcher.vbs' in msg:\n        is_mal = True\n    elif m_creator:\n        creator_pid = int(m_creator.group(1), 16)\n        if (row['host'], creator_pid) in malicious_pids:\n            is_mal = True\n            \n    if is_mal:\n        malicious_ids.add(row['event_id'])\n        if m_new:\n            new_pid = int(m_new.group(1), 16)\n            malicious_pids.add((row['host'], new_pid))\n\n# Sysmon events matching process_guid or parent_process_guid\nfor row in cursor.execute(\"SELECT event_id, process_guid, parent_process_guid FROM events\"):\n    p_g = row['process_guid']\n    p_p_g = row['parent_process_guid']\n    if p_g in malicious_guids or p_p_g in malicious_guids:\n        malicious_ids.add(row['event_id'])\n\n# Security events matching PIDs\nfor row in cursor.execute(\"SELECT event_id, host, message, details FROM events WHERE channel = 'Security'\"):\n    msg = (row['message'] or '') + \" \" + (row['details'] or '')\n    pids_found = []\n    for m in re.finditer(r'Process ID:\\s*(0x[0-9a-fA-F]+)', msg):\n        pids_found.append(int(m.group(1), 16))\n    for m in re.finditer(r'Process ID:\\s*(\\d+)(?!\\w)', msg):\n         pids_found.append(int(m.group(1)))\n    for m in re.finditer(r'ProcessId:\\s*(\\d+)(?!\\w)', msg):\n         pids_found.append(int(m.group(1)))\n         \n    is_mal = False\n    for pid in pids_found:\n        if (row['host'], pid) in malicious_pids:\n            is_mal = True\n            break\n    if is_mal:\n        malicious_ids.add(row['event_id'])\n\n# PowerShell events (Operational and standard)\n# In Windows PowerShell, the message often contains \"Host Application = C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -noP -sta -w 1 -enc ...\"\n# Or PID in message/details. Let's do a more robust matching for PowerShell logs!\n# Let's inspect any remaining events in PowerShell channel that didn't get caught by PID, and check if they are from our powershell instance\nfor row in cursor.execute(\"SELECT event_id, host, channel, message, details FROM events WHERE channel LIKE '%PowerShell%'\"):\n    if row['event_id'] in malicious_ids:\n        continue\n    msg = (row['message'] or '') + \" \" + (row['details'] or '')\n    # Check if this PowerShell log mentions our encoded powersh"]
[124.632085, "i", "ell command line, or contains the malicious script, or mentions our PIDs\n    is_mal = False\n    # If it contains the encoded script, or parts of whoami, or launcher.vbs\n    if 'launcher.vbs' in msg or 'SQBmACgAJABQAF' in msg or 'whoami' in msg:\n        is_mal = True\n    # What if it lists Process ID in some other format? \n    # Let's print remaining PowerShell events to see if we missed any\n    # Wait, let's extract ANY digits from Process ID fields in details\n    pids = []\n    for m in re.finditer(r'Process\\s*ID\\s*=\\s*(\\d+)', msg, re.IGNORECASE):\n        pids.append(int(m.group(1)))\n    for m in re.finditer(r'ProcessID\\s*=\\s*(\\d+)', msg, re.IGNORECASE):\n        pids.append(int(m.group(1)))\n    for pid in pids:\n        if (row['host'], pid) in malicious_pids:\n            is_mal = True\n            break\n            \n    if is_mal:\n        malicious_ids.add(row['event_id'])\n\nprint(f\"Malicious process PIDs: {malicious_pids}\")\nprint(f\"Total identified: {len(malicious_ids)}\")\n\n# Let's inspect remaining PowerShell events\nremaining_ps = []\nfor row in cursor.execute(\"SELECT event_id, event_code, message, details FROM events WHERE channel LIKE '%PowerShell%' ORDER BY timestamp\"):\n    if row['event_id'] not in malicious_ids:\n        remaining_ps.append(row)\nprint(f\"Remaining PowerShell events: {len(remaining_ps)}\")\nif remaining_ps:\n    print(\"First few remaining PS events:\")\n    for r in remaining_ps[:10]:\n        print(f\"{r['event_id']} | code {r['event_code']} | msg: {r['message'][:200]} | details: {r['details']}\")\n\nEOF\npython3 verify.py\n"]
