[?2004l[?2004h> malicious_pids = set()
[?2004l[?2004h> malicious_guids = set()
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Base process identification (launcher.vbs / wscript.exe)
[?2004l[?2004h> cursor.execute("SELECT event_id, host, process_guid, message FROM events WHERE event_code = 1 AND command_line LIKE '%launcher.vbs%'")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     malicious_ids.add(r['event_id'])
