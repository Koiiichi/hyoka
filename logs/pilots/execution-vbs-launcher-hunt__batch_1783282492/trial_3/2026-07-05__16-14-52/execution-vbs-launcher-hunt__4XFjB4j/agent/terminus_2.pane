[?2004l[?2004h>     m = re.search(r'ProcessId:\s*(\d+)', r['message'] or '')
[?2004l[?2004h>     if m:
[?2004l[?2004h>         malicious_pids.add((r['host'], int(m.group(1))))
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Recursive child process tracking
[?2004l[?2004h> added = True
[?2004l[?2004h> while added:
[?2004l[?2004h>     added = False
[?2004l[?2004h>     cursor.execute("SELECT event_id, host, process_guid, parent_process_guid, message FROM events WHERE event_code IN (1, 4688)")
[?2004l[?2004h>     for r in cursor.fetchall():
[?2004l[?2004h>         if r['event_id'] in malicious_ids:
[?2004l[?2004h>             continue
[?2004l[?2004h>         guid = r['process_guid']
[?2004l[?2004h>         pguid = r['parent_process_guid']
[?2004l[?2004h>         if pguid in malicious_guids:
[?2004l[?2004h>             malicious_ids.add(r['event_id'])
[?2004l[?2004h>             if guid:
[?2004l[?2004h>                 malicious_guids.add(guid)
[?2004l[?2004h>                 added = True
[?2004l[?2004h>             m = re.search(r'ProcessId:\s*(\d+)', r['message'] or '')
[?2004l[?2004h>             if m:
[?2004l[?2004h>                 malicious_pids.add((r['host'], int(m.group(1))))
[?2004l[?2004h> 
[?2004l[?2004h> # 3. 4688 tracking (matching Creator PID / command line)
[?2004l[?2004h> for row in cursor.execute("SELECT event_id, host, message, command_line FROM events WHERE event_code = 4688"):
[?2004l[?2004h>     if row['event_id'] in malicious_ids:
[?2004l[?2004h>         continue
[?2004l[?2004h>     cmd = row['command_line'] or ''
[?2004l[?2004h>     msg = row['message'] or ''
[?2004l[?2004h>     m_creator = re.search(r'Creator Process ID:\s*(0x[0-9a-fA-F]+)', msg)
[?2004l[?2004h>     m_new = re.search(r'New Process ID:\s*(0x[0-9a-fA-F]+)', msg)
[?2004l[?2004h>     
[?2004l[?2004h>     is_mal = False
[?2004l[?2004h>     if 'launcher.vbs' in cmd or 'launcher.vbs' in msg:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>     elif m_creator:
[?2004l[?2004h>         creator_pid = int(m_creator.group(1), 16)
[?2004l[?2004h>         if (row['host'], creator_pid) in malicious_pids:
[?2004l[?2004h>             is_mal = True
[?2004l[?2004h>             
[?2004l[?2004h>     if is_mal:
[?2004l[?2004h>         malicious_ids.add(row['event_id'])
[?2004l[?2004h>         if m_new:
[?2004l[?2004h>             new_pid = int(m_new.group(1), 16)
[?2004l[?2004h>             malicious_pids.add((row['host'], new_pid))
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Any event with malicious process_guid or parent_process_guid
[?2004l[?2004h> for row in cursor.execute("SELECT event_id, process_guid, parent_process_guid FROM events"):
[?2004l[?2004h>     p_g = row['process_guid']
[?2004l[?2004h>     p_p_g = row['parent_process_guid']
[?2004l[?2004h>     if p_g in malicious_guids or p_p_g in malicious_guids:
[?2004l[?2004h>         malicious_ids.add(row['event_id'])
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Security events matching PIDs
[?2004l[?2004h> for row in cursor.execute("SELECT event_id, host, message, details FROM events WHERE channel = 'Security'"):
[?2004l[?2004h>     msg = (row['message'] or '') + " " + (row['details'] or '')
[?2004l[?2004h>     pids_found = []
[?2004l[?2004h>     for m in re.finditer(r'Process ID:\s*(0x[0-9a-fA-F]+)', msg):
[?2004l[?2004h>         pids_found.append(int(m.group(1), 16))
