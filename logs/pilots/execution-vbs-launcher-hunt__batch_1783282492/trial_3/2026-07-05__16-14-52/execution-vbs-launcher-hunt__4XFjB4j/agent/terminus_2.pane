[?2004hroot@cf92ba90aad2:~# cat << 'EOF' > list_events.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious process guids
[?2004l[?2004h> mal_guids = {'{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'}
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find any other child processes
[?2004l[?2004h> added = True
[?2004l[?2004h> while added:
[?2004l[?2004h>     added = False
[?2004l[?2004h>     cursor.execute("SELECT process_guid, parent_process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IS NOT NULL")
[?2004l[?2004h>     for row in cursor.fetchall():
[?2004l[?2004h>         p = row['process_guid']
[?2004l[?2004h>         parent = row['parent_process_guid']
[?2004l[?2004h>         if parent in mal_guids and p not in mal_guids:
[?2004l[?2004h>             mal_guids.add(p)
[?2004l[?2004h>             added = True
[?2004l[?2004h> 
[?2004l[?2004h> print("Malicious Process GUIDs:", mal_guids)
[?2004l[?2004h> 
[?2004l[?2004h> # Find all events matching these process GUIDs
[?2004l[?2004h> events_by_code = {}
[?2004l[?2004h> all_matching_events = []
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, host, image, command_line, process_guid, parent_process_guid FROM events")
[?2004l[?2004h> for row in cursor.fetchall():
[?2004l[?2004h>     # Check if process_guid or parent_process_guid matches
[?2004l[?2004h>     is_mal = False
[?2004l[?2004h>     p_guid = row['process_guid']
[?2004l[?2004h>     parent_guid = row['parent_process_guid']
[?2004l[?2004h>     if p_guid in mal_guids or parent_guid in mal_guids:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>     
[?2004l[?2004h>     # If it is a Security 4688 event, sometimes process_guid is not present or populated differently.
[?2004l[?2004h>     # Let's check if the command line matches one of our malicious processes
[?2004l[?2004h>     # Also, check logon events or other security events that are directly related to our process.
[?2004l[?2004h>     
[?2004l[?2004h>     if is_mal:
[?2004l[?2004h>         all_matching_events.append(row)
[?2004l[?2004h>         events_by_code[row['event_code']] = events_by_code.get(row['event_code'], 0) + 1
[?2004l[?2004h> 
[?2004l[?2004h> print("Malicious events by event_code:")
[?2004l[?2004h> for code, count in sorted(events_by_code.items()):
[?2004l[?2004h>     print(f"Code {code}: {count}")
[?2004l[?2004h> 
[?2004l[?2004h> # Print a sample of each code
[?2004l[?2004h> print("\nSamples:")
[?2004l[?2004h> for code in sorted(events_by_code.keys()):
[?2004l[?2004h>     print(f"\n--- CODE {code} ---")
