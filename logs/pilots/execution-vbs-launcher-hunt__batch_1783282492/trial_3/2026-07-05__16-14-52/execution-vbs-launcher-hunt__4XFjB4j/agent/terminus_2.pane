[?2004l[?2004h>     for row in all_matching_events:
[?2004l[?2004h>         if row['event_code'] == code:
[?2004l[?2004h>             print(f"{row['event_id']} | {row['host']} | {row['image']} | {row['command_line']}")
[?2004l[?2004h>             sampled += 1
[?2004l[?2004h>             if sampled >= 3:
[?2004l[?2004h>                 break
