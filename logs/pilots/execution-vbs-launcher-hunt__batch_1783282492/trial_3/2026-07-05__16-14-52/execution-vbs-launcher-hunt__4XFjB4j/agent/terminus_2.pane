[?2004hroot@cf92ba90aad2:~# cat << 'EOF' > classify_all_sysmon.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's get the malicious process guids first
[?2004l[?2004h> malicious_guids = set()
[?2004l[?2004h> cursor.execute("SELECT process_guid FROM events WHERE event_code = 1 AND command_line LIKE '%launcher.vbs%'")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     if r['process_guid']:
[?2004l[?2004h>         malicious_guids.add(r['process_guid'])
[?2004l[?2004h> 
[?2004l[?2004h> added = True
[?2004l[?2004h> while added:
[?2004l[?2004h>     added = False
[?2004l[?2004h>     cursor.execute("SELECT process_guid, parent_process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IS NOT NULL")
[?2004l[?2004h>     for r in cursor.fetchall():
[?2004l[?2004h>         guid = r['process_guid']
[?2004l[?2004h>         pguid = r['parent_process_guid']
[?2004l[?2004h>         if pguid in malicious_guids and guid not in malicious_guids:
[?2004l[?2004h>             malicious_guids.add(guid)
[?2004l[?2004h>             added = True
[?2004l[?2004h> 
[?2004l[?2004h> print("Malicious GUIDs:", malicious_guids)
[?2004l[?2004h> 
[?2004l[?2004h> # Now, let's query all Sysmon events on WS-05 and find those NOT generated by these process GUIDs
[?2004l[?2004h> # (i.e. process_guid and parent_process_guid not in malicious_guids)
[?2004l[?2004h> print("\n=== NON-MALICIOUS SYSMON EVENTS ON WS-05 ===")
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, image, command_line, details, target_object, src_ip, dst_ip, dst_port, process_guid, parent_process_guid FROM events WHERE host = 'WS-05.corp.example' AND channel = 'Microsoft-Windows-Sysmon/Operational'")
[?2004l[?2004h> non_mal_events = []
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     p_g = r['process_guid']
[?2004l[?2004h>     p_p_g = r['parent_process_guid']
[?2004l[?2004h>     if p_g not in malicious_guids and p_p_g not in malicious_guids:
[?2004l[?2004h>         non_mal_events.append(r)
[?2004l[?2004h> 
[?2004l[?2004h> by_code = {}
[?2004l[?2004h> for r in non_mal_events:
[?2004l[?2004h>     by_code[r['event_code']] = by_code.get(r['event_code'], []) + [r]
[?2004l[?2004h> 
[?2004l[?2004h> for code, events in sorted(by_code.items()):
[?2004l[?2004h>     print(f"\n--- Code {code} (Count: {len(events)}) ---")
[?2004l[?2004h>     for r in events[:5]:
[?2004l[?2004h>         print(f"{r['event_id']} | img: {r['image']} | cmd: {r['command_line']} | det: {r['details']} | obj: {r['target_object']} | net: {r['src_ip']}->{r['dst_ip']}:{r['dst_port']}")
[?2004l[?2004h> 
