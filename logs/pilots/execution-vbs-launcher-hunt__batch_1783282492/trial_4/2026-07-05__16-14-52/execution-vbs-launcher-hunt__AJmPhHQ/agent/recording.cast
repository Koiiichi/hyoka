[106.887647, "o", "cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 5156\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     msg = row['message']\r\n\u001b[?2004l\r\u001b[?2004h>     pid = re.search(r'Process ID:\\s+(\\d+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     app = re.search(r'Application Name:\\s+(\\S+)', msg)\r\n\u001b[?2004l\r"]
