[26.675245, "i", "cat << 'EOF' > dump_all.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's inspect event_code = 4104\nprint(\"=== PowerShell Script Block Logging (4104) ===\")\ncursor.execute(\"SELECT event_id, host, message FROM events WHERE event_code = 4104\")\nfor row in cursor.fetchall():\n    print(f\"ID: {row['event_id']} | Host: {row['host']} | Message: {row['message'][:200]}\")\n\n# Let's inspect processes spawned on other hosts\nprint(\"\\n=== Processes on Other Hosts ===\")\ncursor.execute(\"SELECT event_id, event_code, host, user, image, parent_image, command_line FROM events WHERE host != 'WS-05.corp.example' AND event_code IN (1, 4688)\")\nfor row in cursor.fetchall():\n    print(dict(row))\n\n# Let's inspect network connections\nprint(\"\\n=== Network Connections ===\")\ncursor.execute(\"SELECT event_id, event_code, host, image, src_ip, dst_ip, dst_port, timestamp FROM events WHERE event_code IN (3, 5156) AND (src_ip = '172.18.39.5' OR dst_ip = '10.10.10.5')\")\nfor row in cursor.fetchall():\n    print(dict(row))\n\nEOF\npython3 dump_all.py\n"]
[26.676157, "o", "cat << 'EOF' > dump_all.py"]
