[106.886649, "i", "cat << 'EOF' > parse_5156.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 5156\")\nfor row in cursor.fetchall():\n    msg = row['message']\n    pid = re.search(r'Process ID:\\s+(\\d+)', msg)\n    app = re.search(r'Application Name:\\s+(\\S+)', msg)\n    dst_ip = re.search(r'Destination Address:\\s+(\\S+)', msg)\n    dst_port = re.search(r'Destination Port:\\s+(\\d+)', msg)\n    \n    pid_val = pid.group(1) if pid else 'N/A'\n    app_val = app.group(1) if app else 'N/A'\n    dst_ip_val = dst_ip.group(1) if dst_ip else 'N/A'\n    dst_port_val = dst_port.group(1) if dst_port else 'N/A'\n    \n    print(f\"{row['event_id']} | PID: {pid_val} | App: {app_val} | Dst: {dst_ip_val}:{dst_port_val}\")\n\nEOF\npython3 parse_5156.py\n"]
[106.886877, "o", "cat << 'EOF' > parse_5156.py\r\n\u001b[?2004l\r"]
