[20.171246, "i", "cat << 'EOF' > decode_ps.py\nimport sqlite3\nimport base64\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"SELECT event_id, command_line FROM events WHERE event_code = 1 AND image LIKE '%powershell.exe'\")\nfor event_id, cmd in cursor.fetchall():\n    print(f\"Event ID: {event_id}\")\n    match = re.search(r'-enc\\s+([A-Za-z0-9+/=]+)', cmd, re.IGNORECASE)\n    if match:\n        encoded = match.group(1)\n        # Add padding if necessary\n        encoded += '=' * (-len(encoded) % 4)\n        decoded = base64.b64decode(encoded).decode('utf-16le', errors='ignore')\n        print(decoded)\n    else:\n        print(\"No enc found\")\nEOF\npython3 decode_ps.py\n"]
