[33.808178, "i", "cat << 'EOF' > dump_details.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== File Creations (Sysmon 11) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, image, target_object, details FROM events WHERE event_code = 11\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nprint(\"\\n=== Registry Value Set (Sysmon 13) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, image, target_object, details FROM events WHERE event_code = 13 LIMIT 30\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nprint(\"\\n=== Pipes (17, 18) ===\")\ncursor.execute(\"SELECT event_id, event_code, timestamp, host, image, target_object, details FROM events WHERE event_code IN (17, 18)\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nprint(\"\\n=== DNS Queries (Sysmon 22) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, image, query_name, details FROM events WHERE event_code = 22\")\n# Let's see what columns are there for event_code = 22\n# We'll just select everything and print keys\ncursor.execute(\"SELECT * FROM events WHERE event_code = 22\")\nfor r in cursor.fetchall():\n    d = dict(r)\n    print({k: v for k, v in d.items() if v is not None})\n\nEOF\npython3 dump_details.py\n"]
[33.810628, "o", "cat << 'EOF' > dump_details.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== File Creations (Sysmon 11) ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, timestamp, host, image, target_object, details FROM events WHERE event_code = 11\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(dict(r))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== Registry Value Set (Sysmon 13) ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, timestamp, host, image, target_object, details FROM events WHERE event_code = 13 LIMIT 30\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(dict(r))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== Pipes (17, 18) ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, event_code, timestamp, host, image, target_object, details FROM events WHERE event_code IN (17, 18)\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(dict(r))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== DNS Queries (Sysmon 22) ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, timestamp, host, image, query_name, details FROM events WHERE event_code = 22\")\r\n\u001b[?2004l\r\u001b[?2004h> # Let's see what columns are there for event_code = 22\r\n\u001b[?2004l\r\u001b[?2004h> # We'll just select everything and print keys\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT * FROM events WHERE event_code = 22\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     d = dict(r)\r\n\u001b[?2004l\r\u001b[?2004h>     print({k: v for k, v in d.items() if v is not None})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
