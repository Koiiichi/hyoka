[106.887737, "o", "    dst_ip = re.search(r'Destination Address:\\s+(\\S+)', msg)\r\n\u001b[?2004l\r"]
[106.887752, "o", "\u001b[?2004h> "]
[106.888063, "o", "    dst_port = re.search(r'Destination Port:\\s+(\\d+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     pid_val = pid.group(1) if pid else 'N/A'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.88812, "o", "    app_val = app.group(1) if app else 'N/A'\r\n\u001b[?2004l\r\u001b[?2004h>     dst_ip_val = dst_ip.group(1) if dst_ip else 'N/A'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.888258, "o", "    dst_port_val = dst_port.group(1) if dst_port else 'N/A'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.888344, "o", "    print(f\"{row['event_id']} | PID: {pid_val} | App: {app_val} | Dst: {dst_ip_val}:{dst_port_val}\")\r\n\u001b[?2004l\r"]
[106.888667, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
