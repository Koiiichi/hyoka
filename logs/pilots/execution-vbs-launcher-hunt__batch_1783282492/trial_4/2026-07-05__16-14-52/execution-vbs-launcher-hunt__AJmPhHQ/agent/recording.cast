[84.422556, "i", "cat << 'EOF' > examine_powershell_logs.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# The malicious process GUID is {860ba2e3-9f13-5f52-2703-000000000400}\n# Let's see if any events in the DB reference it, either in process_guid, parent_process_guid, or message\ncursor.execute(\"SELECT event_id, event_code, host, message FROM events WHERE message LIKE '%{860ba2e3-9f13-5f52-2703-000000000400}%'\")\nprint(\"=== Events referencing malicious process GUID in message ===\")\nfor row in cursor.fetchall():\n    print(f\"ID: {row['event_id']} | Code: {row['event_code']} | Host: {row['host']}\")\n\n# Let's inspect event_code = 4104\ncursor.execute(\"SELECT * FROM events WHERE event_code = 4104\")\nprint(\"\\n=== All 4104 events ===\")\nfor row in cursor.fetchall():\n    print({k: v for k, v in dict(row).items() if v is not None})\n\nEOF\npython3 examine_powershell_logs.py\n"]
[84.424478, "o", "cat << 'EOF' > examine_powershell_logs.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # The malicious process GUID is {860ba2e3-9f13-5f52-2703-000000000400}\r\n\u001b[?2004l\r\u001b[?2004h> # Let's see if any events in the DB reference it, either in process_guid, parent_process_guid, or message\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, event_code, host, message FROM events WHERE message LIKE '%{860ba2e3-9f13-5f52-2703-000000000400}%'\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== Events referencing malicious process GUID in message ===\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"ID: {row['event_id']} | Code: {row['event_code']} | Host: {row['host']}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's inspect event_code = 4104\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT * FROM events WHERE event_code = 4104\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== All 4104 events ===\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print({k: v for k, v in dict(row).items() if v is not None})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
