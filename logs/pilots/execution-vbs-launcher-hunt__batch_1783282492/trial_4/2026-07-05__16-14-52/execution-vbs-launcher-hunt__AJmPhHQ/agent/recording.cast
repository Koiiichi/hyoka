[74.016005, "i", "cat << 'EOF' > examine_fleet.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Check all process creation events across all machines\nprint(\"=== All Process Creation Events ===\")\ncursor.execute(\"SELECT event_id, event_code, host, user, image, parent_image, command_line, timestamp FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\n# Check network connection events to non-standard IPs/ports\nprint(\"\\n=== Non-local Network Connections ===\")\ncursor.execute(\"SELECT event_id, event_code, host, image, src_ip, dst_ip, dst_port, timestamp FROM events WHERE event_code IN (3, 5156) AND dst_ip NOT IN ('0:0:0:0:0:0:0:1', '127.0.0.1') ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(dict(r))\n\nEOF\npython3 examine_fleet.py\n"]
[74.016933, "o", "cat << 'EOF' > examine_fleet.py\r\n\u001b[?2004l\r"]
[74.017153, "o", "\u001b[?2004h> "]
