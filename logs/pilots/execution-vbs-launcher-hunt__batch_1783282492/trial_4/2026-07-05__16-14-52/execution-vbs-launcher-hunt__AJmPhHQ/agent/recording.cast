[136.284629, "i", "cat << 'EOF' > examine_other_hosts.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Events on DC01 ===\")\ncursor.execute(\"SELECT event_id, event_code, image, command_line, target_object, src_ip, dst_ip, dst_port FROM events WHERE host = 'DC01.corp.example'\")\nfor r in cursor.fetchall():\n    d = {k: v for k, v in dict(r).items() if v is not None and v != ''}\n    print(d)\n\nprint(\"\\n=== Events on WS-06 ===\")\ncursor.execute(\"SELECT event_id, event_code, image, command_line, target_object, src_ip, dst_ip, dst_port FROM events WHERE host = 'WS-06.corp.example'\")\nfor r in cursor.fetchall():\n    d = {k: v for k, v in dict(r).items() if v is not None and v != ''}\n    # Let's ignore some common noise if possible, but there are only 372 events, let's look at non-standard event codes first\n    if d.get('event_code') not in (7, 10, 12, 4656, 4658, 4690):\n        print(d)\n\nEOF\npython3 examine_other_hosts.py\n"]
