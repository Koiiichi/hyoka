[47.132935, "i", "cat << 'EOF' > track_malicious.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Malicious Process Guids\n# wscript: {860ba2e3-9f13-5f52-2603-000000000400}\n# powershell: {860ba2e3-9f13-5f52-2703-000000000400}\n\nguids = ['{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}']\n\nprint(\"=== Events related by GUID ===\")\ncursor.execute(\"SELECT event_id, event_code, timestamp, host, image, parent_image, parent_process_guid, process_guid, command_line, message FROM events WHERE process_guid IN (?, ?) OR parent_process_guid IN (?, ?)\", guids + guids)\n\nrows = cursor.fetchall()\nmalicious_ids = set()\nfor r in rows:\n    d = dict(r)\n    malicious_ids.add(d['event_id'])\n    print(f\"ID: {d['event_id']} | Code: {d['event_code']} | Timestamp: {d['timestamp']} | Image: {d['image']} | Parent: {d['parent_image']} | CMD: {d['command_line']}\")\n\nEOF\npython3 track_malicious.py\n"]
[47.133616, "o", "cat << 'EOF' > track_malicious.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
[47.133751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.135511, "o", "conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Malicious Process Guids\r\n\u001b[?2004l\r\u001b[?2004h> # wscript: {860ba2e3-9f13-5f52-2603-000000000400}\r\n\u001b[?2004l\r\u001b[?2004h> # powershell: {860ba2e3-9f13-5f52-2703-000000000400}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> guids = ['{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== Events related by GUID ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, event_code, timestamp, host, image, parent_image, parent_process_guid, process_guid, command_line, message FROM events WHERE process_guid IN (?, ?) OR parent_process_guid IN (?, ?)\", guids + guids)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> rows = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> malicious_ids = set()\r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     d = dict(r)\r\n\u001b[?2004l\r\u001b[?2004h>     malicious_ids.add(d['event_id'])\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"ID: {d['event_id']} | Code: {d['event_code']} | Timestamp: {d['timestamp']} | Image: {d['image']} | Parent: {d['parent_image']} | CMD: {d['command_line']}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[47.136491, "o", "\u001b[?2004hroot@c70abaf980fb:~# "]
[47.136624, "o", "python3 track_malicious.py\r\n\u001b[?2004l\r"]
[47.146536, "o", "=== Events related by GUID ===\r\n"]
