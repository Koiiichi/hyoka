[33.827638, "o", "\u001b[?2004hroot@c70abaf980fb:~# "]
[38.734273, "i", "cat << 'EOF' > dump_details.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nwith open('details.txt', 'w') as f:\n    f.write(\"=== File Creations (Sysmon 11) ===\\n\")\n    cursor.execute(\"SELECT event_id, timestamp, host, image, target_object, details FROM events WHERE event_code = 11\")\n    for r in cursor.fetchall():\n        f.write(str(dict(r)) + \"\\n\")\n\n    f.write(\"\\n=== Registry Value Set (Sysmon 13) ===\\n\")\n    cursor.execute(\"SELECT event_id, timestamp, host, image, target_object, details FROM events WHERE event_code = 13\")\n    for r in cursor.fetchall():\n        f.write(str(dict(r)) + \"\\n\")\n\n    f.write(\"\\n=== Pipes (17, 18) ===\\n\")\n    cursor.execute(\"SELECT event_id, event_code, timestamp, host, image, target_object, details FROM events WHERE event_code IN (17, 18)\")\n    for r in cursor.fetchall():\n        f.write(str(dict(r)) + \"\\n\")\n\n    f.write(\"\\n=== DNS Queries (Sysmon 22) ===\\n\")\n    cursor.execute(\"SELECT * FROM events WHERE event_code = 22\")\n    for r in cursor.fetchall():\n        d = dict(r)\n        clean_d = {k: v for k, v in d.items() if v is not None}\n        f.write(str(clean_d) + \"\\n\")\n\nEOF\npython3 dump_details.py\nhead -n 50 details.txt\n"]
