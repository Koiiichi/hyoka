[55.914747, "i", "cat << 'EOF' > examine_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's inspect the file creation event evt-01723\ncursor.execute(\"SELECT * FROM events WHERE event_id = 'evt-01723'\")\nprint(\"=== File creation event details ===\")\nfor row in cursor.fetchall():\n    print({k: v for k, v in dict(row).items() if v is not None})\n\n# Let's find other process creation, network connection, file writes, and registry changes.\n# Let's see what registry modifications powershell did\ncursor.execute(\"SELECT event_id, event_code, target_object, details FROM events WHERE process_guid = '{860ba2e3-9f13-5f52-2703-000000000400}' AND event_code IN (12, 13, 14)\")\nprint(\"\\n=== Registry events from malicious PowerShell ===\")\nfor row in cursor.fetchall():\n    print(dict(row))\n\nEOF\npython3 examine_events.py\n"]
