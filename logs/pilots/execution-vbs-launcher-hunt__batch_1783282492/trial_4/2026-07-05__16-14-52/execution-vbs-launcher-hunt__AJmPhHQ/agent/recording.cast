[84.438097, "o", "\u001b[?2004hroot@c70abaf980fb:~# "]
[91.037038, "i", "cat << 'EOF' > list_all_related.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nguids = ['{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}']\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, image, parent_image, parent_process_guid, process_guid, command_line, details, message \n    FROM events \n    WHERE process_guid IN (?, ?) \n       OR parent_process_guid IN (?, ?) \n       OR image LIKE '%powershell.exe' AND command_line LIKE '%-enc%'\n       OR image LIKE '%wscript.exe' AND command_line LIKE '%launcher.vbs%'\n\"\"\", guids + guids)\n\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} related events:\")\nfor r in rows:\n    d = dict(r)\n    print(f\"{d['event_id']} | {d['event_code']} | {d['image']} | {d['command_line']} | {d['parent_image']} | {d['process_guid']} | {d['parent_process_guid']}\")\n\nEOF\npython3 list_all_related.py\n"]
[91.038345, "o", "cat << 'EOF' > list_all_related.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> guids = ['{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.038373, "o", "    SELECT event_id, event_code, host, image, parent_image, parent_process_guid, process_guid, command_line, details, message \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.038382, "o", "> "]
