[?2004l[?2004h>         encoded = match.group(1)
[?2004l[?2004h>         # Add padding if necessary
[?2004l[?2004h>         encoded += '=' * (-len(encoded) % 4)
[?2004l[?2004h>         decoded = base64.b64decode(encoded).decode('utf-16le', errors='ignore')
