[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Query any security network event (5156) or firewall rules related to WS-05 and the relevant timestamp/ports
[?2004l[?2004h> cursor.execute("SELECT * FROM events WHERE event_code IN (5156, 5158) AND (message LIKE '%10.10.10.5%' OR message LIKE '%80%')")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(dict(r))
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search all events on WS-05 in the exact time range of the attack
[?2004l[?2004h> # The attack starts at 2026-05-06T00:00:15.108Z and whoami is run at 2026-05-06T00:00:44.088Z.
[?2004l[?2004h> cursor.execute("SELECT event_code, COUNT(*) FROM events WHERE host = 'WS-05.corp.example' GROUP BY event_code")
[?2004l[?2004h> print("\n=== Event counts by code on WS-05 ===")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(dict(r))
