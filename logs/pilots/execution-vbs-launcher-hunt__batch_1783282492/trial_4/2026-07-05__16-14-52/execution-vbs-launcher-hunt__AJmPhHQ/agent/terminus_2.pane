[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious Process Guids
[?2004l[?2004h> # wscript: {860ba2e3-9f13-5f52-2603-000000000400}
[?2004l[?2004h> # powershell: {860ba2e3-9f13-5f52-2703-000000000400}
[?2004l[?2004h> 
[?2004l[?2004h> guids = ['{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}']
[?2004l[?2004h> 
[?2004l[?2004h> print("=== Events related by GUID ===")
[?2004l[?2004h> cursor.execute("SELECT event_id, event_code, timestamp, host, image, parent_image, parent_process_guid, process_guid, command_line, message FROM events WHERE process_guid IN (?, ?) OR parent_process_guid IN (?, ?)", guids + guids)
[?2004l[?2004h> 
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> malicious_ids = set()
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     d = dict(r)
[?2004l[?2004h>     malicious_ids.add(d['event_id'])
[?2004l[?2004h>     print(f"ID: {d['event_id']} | Code: {d['event_code']} | Timestamp: {d['timestamp']} | Image: {d['image']} | Parent: {d['parent_image']} | CMD: {d['command_line']}")
[?2004l[?2004h> 
