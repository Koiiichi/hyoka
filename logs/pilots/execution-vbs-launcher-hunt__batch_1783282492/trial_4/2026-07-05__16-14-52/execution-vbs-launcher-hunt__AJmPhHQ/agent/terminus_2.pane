[?2004hroot@c70abaf980fb:~# cat << 'EOF' > parse_5156.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT event_id, message FROM events WHERE host = 'WS-05.corp.example' AND event_code = 5156")
[?2004l[?2004h> for row in cursor.fetchall():
[?2004l[?2004h>     msg = row['message']
[?2004l[?2004h>     pid = re.search(r'Process ID:\s+(\d+)', msg)
[?2004l[?2004h>     app = re.search(r'Application Name:\s+(\S+)', msg)
[?2004l[?2004h>     dst_ip = re.search(r'Destination Address:\s+(\S+)', msg)
[?2004l[?2004h>     dst_port = re.search(r'Destination Port:\s+(\d+)', msg)
[?2004l[?2004h>     
[?2004l[?2004h>     pid_val = pid.group(1) if pid else 'N/A'
[?2004l[?2004h>     app_val = app.group(1) if app else 'N/A'
[?2004l[?2004h>     dst_ip_val = dst_ip.group(1) if dst_ip else 'N/A'
[?2004l[?2004h>     dst_port_val = dst_port.group(1) if dst_port else 'N/A'
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"{row['event_id']} | PID: {pid_val} | App: {app_val} | Dst: {dst_ip_val}:{dst_port_val}")
[?2004l[?2004h> 
