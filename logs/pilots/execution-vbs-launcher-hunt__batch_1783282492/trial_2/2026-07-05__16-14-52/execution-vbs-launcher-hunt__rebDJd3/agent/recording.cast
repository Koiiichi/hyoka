[57.928107, "i", "cat << 'EOF' > timeline.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's list all events sorted by timestamp\ncur.execute(\"SELECT event_id, timestamp, event_code, host, user, image, command_line, target_object, details FROM events ORDER BY timestamp ASC\")\nrows = cur.fetchall()\n\nprint(f\"Total events: {len(rows)}\")\nprint(\"First 20 events:\")\nfor r in rows[:20]:\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | Host: {r['host']} | Image: {r['image'] or ''} | CMD: {r['command_line'] or ''} | Target: {r['target_object'] or ''} | Details: {r['details'] or ''}\")\n\nprint(\"\\nLast 20 events:\")\nfor r in rows[-20:]:\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | Host: {r['host']} | Image: {r['image'] or ''} | CMD: {r['command_line'] or ''} | Target: {r['target_object'] or ''} | Details: {r['details'] or ''}\")\n\nEOF\npython3 timeline.py | head -n 45\n"]
