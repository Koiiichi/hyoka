[259.009767, "i", "cat << 'EOF' > parse_remaining.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nimport final_classification\nmal_ids = final_classification.malicious_events\n\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example'\")\nremaining_non_system = 0\nfor r in cur.fetchall():\n    eid = r['event_id']\n    if eid in mal_ids:\n        continue\n    img = (r['image'] or '').lower()\n    \n    is_system = False\n    for sys_term in ('explorer.exe', 'svchost.exe', 'lsass.exe', 'csrss.exe', 'msmpeng.exe', 'windowsazureguestagent.exe', 'system', 'adws', 'dns.exe'):\n        if sys_term in img:\n            is_system = True\n            break\n            \n    if not is_system:\n        remaining_non_system += 1\n        print(f\"{r['timestamp']} | {eid} | Code {r['event_code']} | Img: {r['image']} | CMD: {r['command_line'] or ''} | Msg: {(r['message'] or '')[:100]}\")\n\nprint(\"Total remaining non-system on WS-05:\", remaining_non_system)\nEOF\npython3 parse_remaining.py\n"]
