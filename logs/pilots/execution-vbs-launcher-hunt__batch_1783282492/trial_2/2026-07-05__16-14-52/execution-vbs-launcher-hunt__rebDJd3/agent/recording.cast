[118.606268, "i", "cat << 'EOF' > parse_wfp_5158.py\nimport sqlite3\nimport re\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, host, message FROM events WHERE event_code = 5158\")\nfor r in cur.fetchall():\n    msg = r['message'] or ''\n    app_match = re.search(r'Application Name:\\s*(.*)', msg)\n    port_match = re.search(r'Port:\\s*(.*)', msg)\n    app = app_match.group(1).strip() if app_match else 'None'\n    port = port_match.group(1).strip() if port_match else 'None'\n    \n    if 'powershell' in app.lower() or 'wscript' in app.lower() or 'whoami' in app.lower():\n        print(f\"{r['event_id']} | {r['host']} | App: {app} | Port: {port}\")\nEOF\npython3 parse_wfp_5158.py\n"]
