[253.276707, "i", "cat << 'EOF' > parse_remaining.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's run the classification and print what is remaining (excluding Explorer, svchost, lsass, csrss, Defender/MsMpEng, and Azure guest agent)\nimport final_classification\nmal_ids = final_classification.malicious_events\n\ncur.execute(\"SELECT * FROM events\")\nremaining_non_system = 0\nfor r in cur.fetchall():\n    eid = r['event_id']\n    if eid in mal_ids:\n        continue\n    img = (r['image'] or '').lower()\n    host = r['host']\n    \n    # filter out standard system process images\n    is_system = False\n    for sys_term in ('explorer.exe', 'svchost.exe', 'lsass.exe', 'csrss.exe', 'msmpeng.exe', 'windowsazureguestagent.exe', 'system', 'adws', 'dns.exe'):\n        if sys_term in img:\n            is_system = True\n            break\n            \n    if not is_system:\n        remaining_non_system += 1\n        print(f\"{r['timestamp']} | {eid} | {host} | Code {r['event_code']} | Img: {r['image']} | CMD: {r['command_line'] or ''} | Msg: {(r['message'] or '')[:100]}\")\n\nprint(\"Total remaining non-system:\", remaining_non_system)\nEOF\npython3 parse_remaining.py\n"]
