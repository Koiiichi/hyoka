[221.95804, "o", "\u001b[?2004hroot@3db2c36e1277:~# "]
[245.305436, "i", "cat << 'EOF' > final_classification.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events\")\nall_events = [dict(row) for row in cur.fetchall()]\n\nmalicious_guids = set()\ncur.execute(\"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND command_line LIKE '%launcher.vbs%'\")\nfor r in cur.fetchall():\n    if r['process_guid']:\n        malicious_guids.add(r['process_guid'])\n\nwhile True:\n    placeholders = ','.join('?' for _ in malicious_guids)\n    query = f\"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IN ({placeholders})\"\n    cur.execute(query, list(malicious_guids))\n    children = {row['process_guid'] for row in cur.fetchall() if row['process_guid']}\n    new_children = children - malicious_guids\n    if not new_children:\n        break\n    malicious_guids.update(new_children)\n\nmalicious_events = set()\nreasons = {}\n\nmal_pids = {'0x988', '0x90c', '0x1e14', '0x23c0'}\nsuspicious_proc_names = ('wscript.exe', 'powershell.exe', 'conhost.exe', 'whoami.exe')\n\nfor ev in all_events:\n    eid = ev['event_id']\n    code = ev['event_code']\n    host = ev['host']\n    img = ev['image'] or ''\n    pimg = ev['parent_image'] or ''\n    cmd = ev['command_line'] or ''\n    pguid = ev['process_guid'] or ''\n    ppguid = ev['parent_process_guid'] or ''\n    msg = ev['message'] or ''\n    \n    if pguid in malicious_guids or ppguid in malicious_guids:\n        malicious_events.add(eid)\n        reasons[eid] = \"Sysmon GUID match\"\n        continue\n        \n    if host == 'WS-05.corp.example' and code in (400, 800, 4103, 4104, 40961, 40962, 53504):\n        malicious_events.add(eid)\n        reasons[eid] = f\"PowerShell Log (code {code})\"\n        continue\n        \n    if code in (4688, 4689):\n        is_mal = False\n        for term in suspicious_proc_names:\n            if term in msg.lower() or term in cmd.lower() or term in img.lower():\n                is_mal = True\n                break\n        if is_mal:\n            malicious_events.add(eid)\n            reasons[eid] = f\"Security Process event {code}\"\n            continue\n            \n    if code in (5156, 5158) and host == 'WS-05.corp.example':\n        if 'powershell.exe' in msg.lower() or '10.10.10.5' in msg:\n            malicious_events.add(eid)\n            reasons[eid] = f\"WFP malicious event {code}\"\n            continue\n            \n    if code in (4656, 4658, 4663, 4690, 4673):\n        pid_matches = re.findall(r'Process ID:\\s*(0x[0-9a-fA-F]+)', msg)\n        is_mal = False\n        for pid in pid_matches:\n            if pid.lower() in mal_pids:\n                is_mal = True\n                break\n        if is_mal:\n            malicious_events.add(eid)\n            reasons[eid] = f\"Security Audit PID match {code}\"\n            continue\n\nprint(f\"Total Classified Malicious: {len(malicious_events)}\")\nprint(f\"Remaining: {2067 - len(malicious_events)}\")\n\nprint(\"=== Remaining events on WS-05 ===\")\nws05_remaining_count = 0\nfor ev in all_events:\n    if ev['event_id'] not in malicious_events and ev['host'] == 'WS-05.corp.example':\n        ws05_remaining_count += 1\n        if ws05_remaining_count <= 20:\n            print(f\"{ev['timestamp']} | {ev['event_id']} | Code: {ev['event_code']} | Img: {ev['image'] or ''} | Msg: {ev['message'][:100]}\")\n\nprint(f\"Total remaining on WS-05: {ws05_remaining_count}\")\n\nEOF\npython3 final_classification.py\n"]
[245.306237, "o", "cat << 'EOF' > final_classification.py\r\n\u001b[?2004l\r"]
