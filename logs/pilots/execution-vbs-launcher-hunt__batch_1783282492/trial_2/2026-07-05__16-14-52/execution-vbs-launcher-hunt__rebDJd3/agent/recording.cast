[214.078668, "i", "cat << 'EOF' > find_security_audits.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's map process IDs from process creations\n# We know:\n# powershell.exe: PID 2316 (0x90c)\n# whoami.exe: PID 9152 (0x23c0)\n# Let's find PID for wscript.exe and conhost.exe\n\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE event_code = 1 AND image LIKE '%wscript.exe%'\")\nwscript_pid_sysmon = cur.fetchone()['message'] # we can extract from message or details\n\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE event_code = 4688\")\nfor r in cur.fetchall():\n    msg = r['message'] or ''\n    proc_match = re.search(r'New Process Name:\\s*(.*)', msg)\n    pid_match = re.search(r'New Process ID:\\s*(.*)', msg)\n    if proc_match and pid_match:\n        print(f\"Proc: {proc_match.group(1).strip()} | PID: {pid_match.group(1).strip()}\")\n\nEOF\npython3 find_security_audits.py\n"]
