[125.910242, "o", "for r in rows:\r\n\u001b[?2004l\r"]
[125.911756, "o", "\u001b[?2004h>     img = r['image'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     pimg = r['parent_image'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = r['command_line'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     code = r['event_code']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # If it is one of our malicious processes, we can identify it\r\n\u001b[?2004l\r\u001b[?2004h>     is_known_malicious = False\r\n\u001b[?2004l\r\u001b[?2004h>     for term in ('wscript.exe', 'powershell.exe', 'conhost.exe', 'whoami.exe'):\r\n\u001b[?2004l\r\u001b[?2004h>         if term in img.lower() or term in pimg.lower() or term in cmd.lower():\r\n\u001b[?2004l\r\u001b[?2004h>             is_known_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     if not is_known_malicious:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"{r['timestamp']} | {r['event_id']} | Code {code} | Img: {img} | CMD: {cmd} | Target: {r['target_object'] or ''} | Details: {r['details'] or ''}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[125.912664, "o", "\u001b[?2004hroot@3db2c36e1277:~# python3 detailed_analysis.py\r\n\u001b[?2004l\r"]
