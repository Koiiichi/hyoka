[106.881359, "i", "cat << 'EOF' > find_message_ioc.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, host, message FROM events WHERE message LIKE '%10.10.10.5%'\")\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} events referencing 10.10.10.5 in message:\")\nfor r in rows:\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Host: {r['host']}\")\n\nEOF\npython3 find_message_ioc.py\n"]
