[125.908615, "i", "cat << 'EOF' > detailed_analysis.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's select all events from WS-05 that happened after 00:00:14\ncur.execute(\"SELECT event_id, event_code, timestamp, image, parent_image, command_line, target_object, details FROM events WHERE host = 'WS-05.corp.example' AND timestamp >= '2026-05-06T00:00:14Z' ORDER BY timestamp ASC\")\nrows = cur.fetchall()\nprint(f\"Total WS-05 events in intrusion window: {len(rows)}\")\n\n# Let's see if there are events by processes other than our 4 malicious ones\nfor r in rows:\n    img = r['image'] or ''\n    pimg = r['parent_image'] or ''\n    cmd = r['command_line'] or ''\n    code = r['event_code']\n    \n    # If it is one of our malicious processes, we can identify it\n    is_known_malicious = False\n    for term in ('wscript.exe', 'powershell.exe', 'conhost.exe', 'whoami.exe'):\n        if term in img.lower() or term in pimg.lower() or term in cmd.lower():\n            is_known_malicious = True\n            break\n            \n    if not is_known_malicious:\n        print(f\"{r['timestamp']} | {r['event_id']} | Code {code} | Img: {img} | CMD: {cmd} | Target: {r['target_object'] or ''} | Details: {r['details'] or ''}\")\n\nEOF\npython3 detailed_analysis.py\n"]
