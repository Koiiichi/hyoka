[140.306155, "o", "\u001b[?2004hroot@3db2c36e1277:~# "]
[147.234313, "i", "cat << 'EOF' >> classify.py\n\n# Let's see if any of the remaining events have process names matching our malicious processes\nprint(\"=== Non-classified events referencing malicious process names ===\")\nsuspicious_terms = ('powershell', 'wscript', 'conhost', 'whoami', 'launcher')\nfound_suspicious_remaining = 0\nfor ev in non_malicious:\n    eid = ev['event_id']\n    code = ev['event_code']\n    host = ev['host']\n    img = ev['image'] or ''\n    pimg = ev['parent_image'] or ''\n    cmd = ev['command_line'] or ''\n    msg = ev['message'] or ''\n    \n    # Check if any suspicious term is in the fields\n    has_term = False\n    for term in suspicious_terms:\n        if (term in img.lower() or \n            term in pimg.lower() or \n            term in cmd.lower() or \n            term in msg.lower()):\n            has_term = True\n            break\n            \n    if has_term:\n        found_suspicious_remaining += 1\n        # Let's print details\n        print(f\"{ev['timestamp']} | {eid} | Host: {host} | Code: {code} | Img: {img} | CMD: {cmd} | Msg: {msg[:100]}\")\n\nprint(f\"Found {found_suspicious_remaining} suspicious remaining events.\")\nEOF\npython3 classify.py\n"]
[147.234637, "o", "cat << 'EOF' >> classify.py\r\n\u001b[?2004l\r"]
[147.234855, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's see if any of the remaining events have process names matching our malicious processes\r\n\u001b[?2004l\r"]
[147.234902, "o", "\u001b[?2004h> "]
[147.23499, "o", "print(\"=== Non-classified events referencing malicious process names ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.235142, "o", "suspicious_terms = ('powershell', 'wscript', 'conhost', 'whoami', 'launcher')\r\n\u001b[?2004l\r\u001b[?2004h> found_suspicious_remaining = 0\r\n\u001b[?2004l\r\u001b[?2004h> for ev in non_malicious:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.235236, "o", "    eid = ev['event_id']\r\n\u001b[?2004l\r\u001b[?2004h>     code = ev['event_code']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.235263, "o", "    host = ev['host']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.235378, "o", "    img = ev['image'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     pimg = ev['parent_image'] or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.23543, "o", "    cmd = ev['command_line'] or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.235596, "o", "    msg = ev['message'] or ''\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.235651, "o", "    # Check if any suspicious term is in the fields\r\n\u001b[?2004l\r\u001b[?2004h>     has_term = False\r\n\u001b[?2004l\r"]
[147.235724, "o", "\u001b[?2004h>     for term in suspicious_terms:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.236369, "o", "        if (term in img.lower() or \r\n\u001b[?2004l\r\u001b[?2004h>             term in pimg.lower() or \r\n\u001b[?2004l\r\u001b[?2004h>             term in cmd.lower() or \r\n\u001b[?2004l\r\u001b[?2004h>             term in msg.lower()):\r\n\u001b[?2004l\r\u001b[?2004h>             has_term = True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     if has_term:\r\n\u001b[?2004l\r\u001b[?2004h>         found_suspicious_remaining += 1\r\n\u001b[?2004l\r\u001b[?2004h>         # Let's print details\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"{ev['timestamp']} | {eid} | Host: {host} | Code: {code} | Img: {img} | CMD: {cmd} | Msg: {msg[:100]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {found_suspicious_remaining} suspicious remaining events.\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[147.237357, "o", "\u001b[?2004hroot@3db2c36e1277:~# "]
[147.237381, "o", "python3 classify.py\r\n\u001b[?2004l\r"]
