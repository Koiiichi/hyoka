[221.939376, "i", "cat << 'EOF' > find_audits.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmal_pids = {'0x988', '0x90c', '0x1e14', '0x23c0'}\n\ncur.execute(\"SELECT event_id, event_code, host, message FROM events WHERE event_code IN (4656, 4658, 4663, 4690, 4673)\")\nrows = cur.fetchall()\n\nmatched = []\nfor r in rows:\n    msg = r['message'] or ''\n    # search for Process ID: followed by spaces and one of our mal_pids\n    # or Process ID: 0x...\n    pid_matches = re.findall(r'Process ID:\\s*(0x[0-9a-fA-F]+)', msg)\n    for pid in pid_matches:\n        if pid.lower() in mal_pids:\n            matched.append(r['event_id'])\n            print(f\"Malicious Audit Event: {r['event_id']} | Code: {r['event_code']} | PID: {pid}\")\n            break\n\nprint(f\"Total matched audit events: {len(matched)}\")\nEOF\npython3 find_audits.py\n"]
