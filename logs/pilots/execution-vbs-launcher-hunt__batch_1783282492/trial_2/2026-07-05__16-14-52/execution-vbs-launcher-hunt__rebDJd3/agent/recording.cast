[274.160393, "o", "    # Category 3: Security 4688/4689 process events for our malicious processes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.160481, "o", "    if code in (4688, 4689):\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.160572, "o", "        for term in suspicious_proc_names:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.160692, "o", "            if term in msg.lower() or term in cmd.lower() or term in img.lower():\r\n\u001b[?2004l\r"]
[274.16071, "o", "\u001b[?2004h> "]
[274.160813, "o", "                is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.160834, "o", "        if is_mal:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.160968, "o", "            malicious_event_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>             cats['Security Process Creation/Exit'] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.160995, "o", "> "]
[274.161064, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.161126, "o", "    # Category 4: WFP logs for malicious processes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.161207, "o", "    if code in (5156, 5158) and host == 'WS-05.corp.example':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.161318, "o", "        if 'powershell.exe' in msg.lower() or '10.10.10.5' in msg:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.161395, "o", "            malicious_event_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>             cats['WFP traffic'] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.161474, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.161643, "o", "    # Category 5: Security audit events matching PIDs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.16168, "o", "    if code in (4656, 4658, 4663, 4690, 4673):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.161823, "o", "        pid_matches = re.findall(r'Process ID:\\s*(0x[0-9a-fA-F]+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.162017, "o", "        is_mal = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.162187, "o", "        for pid in pid_matches:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.162213, "o", "            if pid.lower() in mal_pids:\r\n\u001b[?2004l\r\u001b[?2004h>                 is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.162279, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.162329, "o", "        if is_mal:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.162381, "o", "            malicious_event_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.162557, "o", "            cats['Security Audit'] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.162647, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[274.162668, "o", "> "]
[274.162786, "o", "print(\"[*] Malicious event counts by category:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.162877, "o", "for k, v in cats.items():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  {k}: {v}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.162955, "o", "total_mal = len(malicious_event_ids)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.163039, "o", "print(f\"[*] Total Malicious Events Identified: {total_mal}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 4. Write to findings.json\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.163057, "o", "> "]
[274.163136, "o", "findings_list = sorted(list(malicious_event_ids))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.163309, "o", "with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(findings_list, f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[274.163339, "o", "> print(\"[*] Successfully wrote findings to /root/findings.json\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[274.16418, "o", "\u001b[?2004hroot@3db2c36e1277:~# python3 solve.py\r\n\u001b[?2004l\r"]
