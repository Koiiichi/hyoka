[274.156142, "i", "cat << 'EOF' > solve.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# 1. Fetch all events\ncur.execute(\"SELECT * FROM events\")\nall_events = [dict(row) for row in cur.fetchall()]\n\n# 2. Trace malicious process GUIDs recursively\nmalicious_guids = set()\ncur.execute(\"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND command_line LIKE '%launcher.vbs%'\")\nfor r in cur.fetchall():\n    if r['process_guid']:\n        malicious_guids.add(r['process_guid'])\n\nwhile True:\n    placeholders = ','.join('?' for _ in malicious_guids)\n    query = f\"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IN ({placeholders})\"\n    cur.execute(query, list(malicious_guids))\n    children = {row['process_guid'] for row in cur.fetchall() if row['process_guid']}\n    new_children = children - malicious_guids\n    if not new_children:\n        break\n    malicious_guids.update(new_children)\n\nprint(f\"[*] Malicious process GUIDs ({len(malicious_guids)}): {malicious_guids}\")\n\n# 3. Identify all malicious events across categories\nmalicious_event_ids = set()\ncats = {\n    'Sysmon GUID': 0,\n    'PowerShell operational': 0,\n    'Security Process Creation/Exit': 0,\n    'WFP traffic': 0,\n    'Security Audit': 0\n}\n\nmal_pids = {'0x988', '0x90c', '0x1e14', '0x23c0'}\nsuspicious_proc_names = ('wscript.exe', 'powershell.exe', 'conhost.exe', 'whoami.exe')\n\nfor ev in all_events:\n    eid = ev['event_id']\n    code = ev['event_code']\n    host = ev['host']\n    img = ev['image'] or ''\n    pimg = ev['parent_image'] or ''\n    cmd = ev['command_line'] or ''\n    pguid = ev['process_guid'] or ''\n    ppguid = ev['parent_process_guid'] or ''\n    msg = ev['message'] or ''\n    \n    # Category 1: Sysmon process GUID matching\n    if pguid in malicious_guids or ppguid in malicious_guids:\n        malicious_event_ids.add(eid)\n        cats['Sysmon GUID'] += 1\n        continue\n        \n    # Category 2: PowerShell console/operational/engine logs on WS-05\n    if host == 'WS-05.corp.example' and code in (400, 800, 4103, 4104, 40961, 40962, 53504):\n        malicious_event_ids.add(eid)\n        cats['PowerShell operational'] += 1\n        continue\n        \n    # Category 3: Security 4688/4689 process events for our malicious processes\n    if code in (4688, 4689):\n        is_mal = False\n        for term in suspicious_proc_names:\n            if term in msg.lower() or term in cmd.lower() or term in img.lower():\n                is_mal = True\n                break\n        if is_mal:\n            malicious_event_ids.add(eid)\n            cats['Security Process Creation/Exit'] += 1\n            continue\n            \n    # Category 4: WFP logs for malicious processes\n    if code in (5156, 5158) and host == 'WS-05.corp.example':\n        if 'powershell.exe' in msg.lower() or '10.10.10.5' in msg:\n            malicious_event_ids.add(eid)\n            cats['WFP traffic'] += 1\n            continue\n            \n    # Category 5: Security audit events matching PIDs\n    if code in (4656, 4658, 4663, 4690, 4673):\n        pid_matches = re.findall(r'Process ID:\\s*(0x[0-9a-fA-F]+)', msg)\n        is_mal = False\n        for pid in pid_matches:\n            if pid.lower() in mal_pids:\n                is_mal = True\n                break\n        if is_mal:\n            malicious_event_ids.add(eid)\n            cats['Security Audit'] += 1\n            continue\n\nprint(\"[*] Malicious event counts by category:\")\nfor k, v in cats.items():\n    print(f\"  {k}: {v}\")\n\ntotal_mal = len(malicious_event_ids)\nprint(f\"[*] Total Malicious Events Identified: {total_mal}\")\n\n# 4. Write to findings.json\nfindings_list = sorted(list(malicious_event_ids))\nwith open('/root/findings.json', 'w') as f:\n    json.dump(findings_list, f)\n\nprint(\"[*] Successfully wrote findings to /root/findings.json\")\n\nEOF\npython3 solve.py\n"]
