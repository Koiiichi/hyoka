[164.007285, "i", "cat << 'EOF' > analyze_suspicious.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Run the classification logic as before to get non_malicious\nall_events = []\ncur.execute(\"SELECT * FROM events\")\nall_events = [dict(row) for row in cur.fetchall()]\n\nmalicious_guids = set()\ncur.execute(\"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND command_line LIKE '%launcher.vbs%'\")\nfor r in cur.fetchall():\n    if r['process_guid']:\n        malicious_guids.add(r['process_guid'])\n\nwhile True:\n    placeholders = ','.join('?' for _ in malicious_guids)\n    query = f\"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IN ({placeholders})\"\n    cur.execute(query, list(malicious_guids))\n    children = {row['process_guid'] for row in cur.fetchall() if row['process_guid']}\n    new_children = children - malicious_guids\n    if not new_children:\n        break\n    malicious_guids.update(new_children)\n\nmalicious_event_ids = set()\nfor ev in all_events:\n    eid = ev['event_id']\n    code = ev['event_code']\n    host = ev['host']\n    img = ev['image'] or ''\n    pimg = ev['parent_image'] or ''\n    cmd = ev['command_line'] or ''\n    pguid = ev['process_guid'] or ''\n    ppguid = ev['parent_process_guid'] or ''\n    msg = ev['message'] or ''\n    \n    if pguid in malicious_guids or ppguid in malicious_guids:\n        malicious_event_ids.add(eid)\n        continue\n    if host == 'WS-05.corp.example' and code in (800, 4103, 4104):\n        malicious_event_ids.add(eid)\n        continue\n    if code in (5156, 5158) and host == 'WS-05.corp.example':\n        if 'powershell.exe' in msg.lower() or '10.10.10.5' in msg:\n            malicious_event_ids.add(eid)\n            continue\n\nsuspicious_terms = ('powershell', 'wscript', 'conhost', 'whoami', 'launcher')\nsuspicious_remaining = []\nfor ev in all_events:\n    if ev['event_id'] in malicious_event_ids:\n        continue\n    img = ev['image'] or ''\n    pimg = ev['parent_image'] or ''\n    cmd = ev['command_line'] or ''\n    msg = ev['message'] or ''\n    has_term = False\n    for term in suspicious_terms:\n        if term in img.lower() or term in pimg.lower() or term in cmd.lower() or term in msg.lower():\n            has_term = True\n            break\n    if has_term:\n        suspicious_remaining.append(ev)\n\nprint(f\"Total suspicious remaining: {len(suspicious_remaining)}\")\n# Group them by event_code, host, image and a simplified description\ngroups = {}\nfor ev in suspicious_remaining:\n    img = ev['image'] or ''\n    code = ev['event_code']\n    host = ev['host']\n    # extract target image if any from message\n    target_img_match = re.search(r'TargetImage:\\s*(.*)', ev['message'] or '')\n    target_img = target_img_match.group(1).strip() if target_img_match else 'None'\n    \n    # check if source process guid is mentioned in message\n    src_guid_match = re.search(r'SourceProcessGUID:\\s*(.*)', ev['message'] or '')\n    src_guid = src_guid_match.group(1).strip() if src_guid_match else 'None'\n    \n    tgt_guid_match = re.search(r'TargetProcessGUID:\\s*(.*)', ev['message'] or '')\n    tgt_guid = tgt_guid_match.group(1).strip() if tgt_guid_match else 'None'\n\n    key = (code, host, img, target_img, src_guid, tgt_guid)\n    groups[key] = groups.get(key, 0) + 1\n\nfor k, count in sorted(groups.items(), key=lambda x: x[1], reverse=True):\n    print(f\"Count: {count} | Code: {k[0]} | Host: {k[1]} | Img: {k[2]} | TgtImg: {k[3]} | SrcGUID: {k[4]} | TgtGUID: {k[5]}\")\n\nEOF\npython3 analyze_suspicious.py\n"]
