[34.213346, "i", "cat << 'EOF' >> trace.py\n\n# Let's count these malicious events by event_code\ncode_counts = {}\ncur.execute(f\"SELECT event_code, COUNT(*) as cnt FROM events WHERE event_id IN ({','.join('?' for _ in all_malicious_events)}) GROUP BY event_code\", list(all_malicious_events))\nfor row in cur.fetchall():\n    code_counts[row['event_code']] = row['cnt']\nprint(\"Malicious events by code:\", code_counts)\n\n# Let's check if there are other processes of interest, like on DC01 or WS-06\n# Let's list all process creations (1 and 4688) on all hosts to be absolutely sure we didn't miss anything.\ncur.execute(\"SELECT event_id, event_code, host, user, image, command_line FROM events WHERE event_code IN (1, 4688)\")\nprint(\"\\nAll process creations:\")\nfor row in cur.fetchall():\n    print(dict(row))\n\nEOF\npython3 trace.py\n"]
