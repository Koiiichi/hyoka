[24.049549, "i", "cat << 'EOF' > trace.py\nimport sqlite3\nimport json\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's find the main actors\n# We know evt-00073 (wscript.exe) is malicious.\n# Let's find its process GUID and any related events.\ncur.execute(\"SELECT * FROM events WHERE event_id = 'evt-00073'\")\nwscript_row = cur.fetchone()\nwscript_guid = wscript_row['process_guid']\nprint(f\"wscript.exe GUID: {wscript_guid}\")\n\n# Let's find powershell.exe\ncur.execute(\"SELECT * FROM events WHERE event_id = 'evt-00259'\")\nps_row = cur.fetchone()\nps_guid = ps_row['process_guid']\nprint(f\"powershell.exe GUID: {ps_guid}\")\n\nEOF\npython3 trace.py\n"]
[24.049998, "o", "cat << 'EOF' > trace.py\r\n\u001b[?2004l\r"]
