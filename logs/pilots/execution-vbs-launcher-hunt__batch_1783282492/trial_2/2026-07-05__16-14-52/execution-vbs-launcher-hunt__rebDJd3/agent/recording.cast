[125.931591, "o", "\u001b[?2004hroot@3db2c36e1277:~# "]
[131.775617, "i", "cat << 'EOF' > detailed_analysis.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's select all events from WS-05 that happened after 00:00:14, excluding PowerShell event codes 800, 4103, 4104\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, image, parent_image, command_line, target_object, details \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND timestamp >= '2026-05-06T00:00:14Z'\n      AND event_code NOT IN (800, 4103, 4104)\n    ORDER BY timestamp ASC\n\"\"\")\nrows = cur.fetchall()\nprint(f\"Total WS-05 non-PowerShell events in intrusion window: {len(rows)}\")\n\nfor r in rows:\n    img = r['image'] or ''\n    pimg = r['parent_image'] or ''\n    cmd = r['command_line'] or ''\n    code = r['event_code']\n    \n    is_known_malicious = False\n    for term in ('wscript.exe', 'powershell.exe', 'conhost.exe', 'whoami.exe'):\n        if term in img.lower() or term in pimg.lower() or term in cmd.lower():\n            is_known_malicious = True\n            break\n            \n    if not is_known_malicious:\n        print(f\"{r['timestamp']} | {r['event_id']} | Code {code} | Img: {img} | CMD: {cmd} | Target: {r['target_object'] or ''} | Details: {r['details'] or ''}\")\n\nEOF\npython3 detailed_analysis.py\n"]
