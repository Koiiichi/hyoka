[91.997888, "i", "cat << 'EOF' > check_net.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's search all event code 3 (Sysmon network connection) where source or dest is not local host or known external IPs\ncur.execute(\"SELECT * FROM events WHERE event_code = 3\")\nprint(\"=== Sysmon Network Connection Events ===\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['host']} | {r['image']} | {r['src_ip']} -> {r['dst_ip']}:{r['dst_port']}\")\n\n# Let's check 5156 (WFP Connection Allowed)\ncur.execute(\"SELECT event_id, host, src_ip, dst_ip, dst_port, details FROM events WHERE event_code = 5156\")\nprint(\"=== WFP 5156 Network Events ===\")\nfor r in cur.fetchall()[:20]:\n    print(f\"{r['event_id']} | {r['host']} | {r['src_ip']} -> {r['dst_ip']}:{r['dst_port']} | {r['details'] or ''}\")\nEOF\npython3 check_net.py\n"]
