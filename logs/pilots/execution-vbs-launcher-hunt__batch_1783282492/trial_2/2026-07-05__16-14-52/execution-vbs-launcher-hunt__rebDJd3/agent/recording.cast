[264.131697, "i", "cat << 'EOF' > parse_remaining_wfp.py\nimport sqlite3\nimport re\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nimport final_classification\nmal_ids = final_classification.malicious_events\n\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158)\")\nfor r in cur.fetchall():\n    eid = r['event_id']\n    if eid in mal_ids:\n        continue\n    \n    msg = r['message'] or ''\n    app_match = re.search(r'Application Name:\\s*(.*)', msg)\n    app = app_match.group(1).strip() if app_match else 'None'\n    \n    # Only print if it's not known benign system applications like guestagent, svchost, msmpeng, system\n    is_benign = False\n    for term in ('guestagent', 'svchost.exe', 'msmpeng.exe', 'system', 'lsass.exe'):\n        if term in app.lower():\n            is_benign = True\n            break\n            \n    if not is_benign:\n        print(f\"{eid} | Code {r['event_code']} | App: {app}\")\n\nEOF\npython3 parse_remaining_wfp.py\n"]
