[29.245774, "i", "cat << 'EOF' >> trace.py\n\n# Let's write a function to recursively find all child processes and their events.\nmalicious_guids = {wscript_guid, ps_guid}\n\n# Loop to find child processes recursively\nwhile True:\n    placeholders = ','.join('?' for _ in malicious_guids)\n    query = f\"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IN ({placeholders})\"\n    cur.execute(query, list(malicious_guids))\n    children = {row['process_guid'] for row in cur.fetchall() if row['process_guid']}\n    new_children = children - malicious_guids\n    if not new_children:\n        break\n    malicious_guids.update(new_children)\n\nprint(f\"All malicious process GUIDs: {malicious_guids}\")\n\n# Now let's find all events associated with these process GUIDs\n# An event could be associated via: \n# - process_guid\n# - parent_process_guid\nall_malicious_events = set()\n\nplaceholders = ','.join('?' for _ in malicious_guids)\n\n# 1. Events where process_guid is malicious\ncur.execute(f\"SELECT event_id, event_code, image, command_line FROM events WHERE process_guid IN ({placeholders})\", list(malicious_guids))\nfor row in cur.fetchall():\n    all_malicious_events.add(row['event_id'])\n\n# 2. Events where parent_process_guid is malicious\ncur.execute(f\"SELECT event_id, event_code, image, command_line FROM events WHERE parent_process_guid IN ({placeholders})\", list(malicious_guids))\nfor row in cur.fetchall():\n    all_malicious_events.add(row['event_id'])\n\nprint(f\"Collected {len(all_malicious_events)} events directly associated with malicious processes.\")\nEOF\npython3 trace.py\n"]
