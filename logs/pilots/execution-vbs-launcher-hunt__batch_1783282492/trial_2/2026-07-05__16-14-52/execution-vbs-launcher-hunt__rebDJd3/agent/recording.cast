[153.152466, "i", "cat << 'EOF' > inspect_10.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE event_code = 10 LIMIT 3\")\nfor r in cur.fetchall():\n    print(f\"Event: {r['event_id']} | Host: {r['host']}\")\n    for k in r.keys():\n        if r[k] is not None and r[k] != '':\n            print(f\"  {k}: {r[k]}\")\nEOF\npython3 inspect_10.py\n"]
