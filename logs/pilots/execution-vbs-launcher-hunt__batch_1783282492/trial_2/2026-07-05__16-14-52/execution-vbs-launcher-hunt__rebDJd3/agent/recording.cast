[189.540899, "i", "cat << 'EOF' > parse_misc.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Explorer file creation\ncur.execute(\"SELECT event_id, event_code, host, timestamp, image, target_object, details, message FROM events WHERE event_code = 11 AND image LIKE '%explorer.exe%'\")\nfor r in cur.fetchall():\n    print(f\"Explorer File: {r['event_id']} | Target: {r['target_object']} | Details: {r['details']} | Msg: {r['message'][:200]}\")\n\n# codes 400, 40961, 53504, 40962\ncur.execute(\"SELECT event_id, event_code, host, timestamp, image, target_object, details, message FROM events WHERE event_code IN (400, 40961, 53504, 40962)\")\nfor r in cur.fetchall():\n    print(f\"Misc Code: {r['event_id']} | Code: {r['event_code']} | Msg: {r['message'][:200]}\")\n\nEOF\npython3 parse_misc.py\n"]
