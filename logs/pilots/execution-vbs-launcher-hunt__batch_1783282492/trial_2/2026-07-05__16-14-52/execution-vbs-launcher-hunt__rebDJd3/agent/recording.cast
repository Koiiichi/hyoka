[180.979215, "i", "cat << 'EOF' > parse_4688_4689.py\nimport sqlite3\nimport re\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nsuspicious_proc_names = ('wscript.exe', 'powershell.exe', 'conhost.exe', 'whoami.exe')\n\n# Let's search 4688\ncur.execute(\"SELECT event_id, message FROM events WHERE event_code = 4688\")\nfor r in cur.fetchall():\n    msg = r['message'] or ''\n    # check if any of suspicious names is in message\n    for term in suspicious_proc_names:\n        if term in msg.lower():\n            print(f\"4688 Malicious: {r['event_id']} | Term: {term}\")\n            break\n\n# Let's search 4689\ncur.execute(\"SELECT event_id, message FROM events WHERE event_code = 4689\")\nfor r in cur.fetchall():\n    msg = r['message'] or ''\n    for term in suspicious_proc_names:\n        if term in msg.lower():\n            print(f\"4689 Malicious: {r['event_id']} | Term: {term}\")\n            break\n\nEOF\npython3 parse_4688_4689.py\n"]
