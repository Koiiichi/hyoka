-06T00:00:53.189Z | evt-01951 | Code 10 | Img: C:\\windows\\system32\\svchost.exe | CMD:  | Target:  | Details: \r\n2026-05-06T00:00:53.190Z | evt-01952 | Code 10 | Img: C:\\windows\\system32\\svchost.exe | CMD:  | Target:  | Details: \r\n2026-05-06T00:00:54.201Z | evt-01953 | Code 10 | Img: C:\\windows\\system32\\svchost.exe | CMD:  | Target:  | Details: \r\n2026-05-06T00:00:54.202Z | evt-01954 | Code 10 | Img: C:\\windows\\system32\\svchost.exe | CMD:  | Target:  | Details: \r\n2026-05-06T00:00:54.206Z | evt-01961 | Code 10 | Img: C:\\windows\\system32\\svchost.exe | CMD:  | Target:  | Details: \r\n2026-05-06T00:00:54.206Z | evt-01962 | Code 10 | Img: C:\\windows\\system32\\svchost.exe | CMD:  | Target:  | Details: \r\n2026-05-06T00:00:54.207Z | evt-01963 | Code 10 | Img: C:\\windows\\system32\\svchost.exe | CMD:  | Target:  | Details: \r\n2026-05-06T00:00:54.207Z | evt-01964 | Code 10 | Img: C:\\windows\\system32\\svchost.exe | CMD:  | Target:  | Details: \r\n2026-05-06T00:00:54.207Z | evt-01965 | Code 10 | Img: C:\\windows\\system32\\svchost.exe | CMD:  | Target:  | Details: \r\n2026-05-06T00:00:54.208Z | evt-01966 | Code 10 | Img: C:\\windows\\system32\\svchost.exe | CMD:  | Target:  | Details: \r\n2026-05-06T00:01:00.217Z | evt-01989 | Code 11 | Img: C:\\windows\\System32\\svchost.exe | CMD:  | Target:  | Details: \r\n2026-05-06T00:01:00.218Z | evt-01991 | Code 5158 | Img:  | CMD:  | Target:  | Details: \r\n2026-05-06T00:01:00.218Z | evt-01992 | Code 5156 | Img:  | CMD:  | Target:  | Details: \r\n"]
[131.793244, "o", "\u001b[?2004hroot@3db2c36e1277:~# "]
[140.269969, "i", "cat << 'EOF' > classify.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Retrieve all events\ncur.execute(\"SELECT * FROM events\")\nall_events = [dict(row) for row in cur.fetchall()]\n\n# Let's find malicious process GUIDs recursively first\nmalicious_guids = set()\n# Initial malicious process: wscript.exe running launcher.vbs\ncur.execute(\"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND command_line LIKE '%launcher.vbs%'\")\nfor r in cur.fetchall():\n    if r['process_guid']:\n        malicious_guids.add(r['process_guid'])\n\n# Recursively find all child processes\nwhile True:\n    placeholders = ','.join('?' for _ in malicious_guids)\n    query = f\"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IN ({placeholders})\"\n    cur.execute(query, list(malicious_guids))\n    children = {row['process_guid'] for row in cur.fetchall() if row['process_guid']}\n    new_children = children - malicious_guids\n    if not new_children:\n        break\n    malicious_guids.update(new_children)\n\nprint(f\"Malicious process GUIDs count: {len(malicious_guids)}\")\nprint(f\"Malicious process GUIDs: {malicious_guids}\")\n\n# Identify malicious events\nmalicious_event_ids = set()\nreasons = {}\n\nfor ev in all_events:\n    eid = ev['event_id']\n    code = ev['event_code']\n    host = ev['host']\n    img = ev['image'] or ''\n    pimg = ev['parent_image'] or ''\n    cmd = ev['command_line'] or ''\n    pguid = ev['process_guid'] or ''\n    ppguid = ev['parent_process_guid'] or ''\n    msg = ev['message'] or ''\n    target = ev['target_object'] or ''\n    \n    # 1. Directly associated with malicious process GUIDs\n    if pguid in malicious_guids or ppguid in malicious_guids:\n        malicious_event_ids.add(eid)\n        reasons[eid] = f\"Process GUID match: pguid={pguid}, ppguid={ppguid}\"\n        continue\n        \n    # 2. PowerShell pipeline execution and module/script block logging (which only exists on WS-05 for our malicious process)\n    if host == 'WS-05.corp.example' and code in (800, 4103, 4104):\n        malicious_event_ids.add(eid)\n        reasons[eid] = f\"PowerShell event on WS-05 (code {code})\"\n        continue\n        \n    # 3. WFP events matching PowerShell outbound connection to 10.10.10.5 or inbound binds\n    if code in (5156, 5158) and host == 'WS-05.corp.example':\n        # Let's check if the message mentions PowerShell or the C2 IP\n        if 'powershell.exe' in msg.lower() or '10.10.10.5' in msg:\n            malicious_event_ids.add(eid)\n            reasons[eid] = f\"WFP malicious traffic: code={code}\"\n            continue\n\n# Let's inspect non-malicious events to see if we missed anything\nnon_malicious = [ev for ev in all_events if ev['event_id'] not in malicious_event_ids]\nprint(f\"Directly classified malicious: {len(malicious_event_ids)}\")\nprint(f\"Remaining non-malicious: {len(non_malicious)}\")\n\nEOF\npython3 classify.py\n"]
