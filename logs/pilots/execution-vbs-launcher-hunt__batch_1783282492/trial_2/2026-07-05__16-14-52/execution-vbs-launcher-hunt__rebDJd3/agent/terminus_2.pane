[?2004hroot@3db2c36e1277:~# cat << 'EOF' > parse_wfp_5158.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT event_id, host, message FROM events WHERE event_code = 5158")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     app_match = re.search(r'Application Name:\s*(.*)', msg)
[?2004l[?2004h>     port_match = re.search(r'Port:\s*(.*)', msg)
[?2004l[?2004h>     app = app_match.group(1).strip() if app_match else 'None'
[?2004l[?2004h>     port = port_match.group(1).strip() if port_match else 'None'
[?2004l[?2004h>     
[?2004l[?2004h>     if 'powershell' in app.lower() or 'wscript' in app.lower() or 'whoami' in app.lower():
[?2004l[?2004h>         print(f"{r['event_id']} | {r['host']} | App: {app} | Port: {port}")
