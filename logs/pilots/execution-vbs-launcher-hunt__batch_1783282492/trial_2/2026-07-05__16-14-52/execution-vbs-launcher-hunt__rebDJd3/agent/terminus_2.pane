[?2004hroot@3db2c36e1277:~# cat << 'EOF' > classify.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Retrieve all events
[?2004l[?2004h> cur.execute("SELECT * FROM events")
[?2004l[?2004h> all_events = [dict(row) for row in cur.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find malicious process GUIDs recursively first
[?2004l[?2004h> malicious_guids = set()
[?2004l[?2004h> # Initial malicious process: wscript.exe running launcher.vbs
[?2004l[?2004h> cur.execute("SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND command_line LIKE '%launcher.vbs%'")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     if r['process_guid']:
[?2004l[?2004h>         malicious_guids.add(r['process_guid'])
[?2004l[?2004h> 
[?2004l[?2004h> # Recursively find all child processes
[?2004l[?2004h> while True:
[?2004l[?2004h>     placeholders = ','.join('?' for _ in malicious_guids)
[?2004l[?2004h>     query = f"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IN ({placeholders})"
[?2004l[?2004h>     cur.execute(query, list(malicious_guids))
[?2004l[?2004h>     children = {row['process_guid'] for row in cur.fetchall() if row['process_guid']}
[?2004l[?2004h>     new_children = children - malicious_guids
[?2004l[?2004h>     if not new_children:
[?2004l[?2004h>         break
[?2004l[?2004h>     malicious_guids.update(new_children)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Malicious process GUIDs count: {len(malicious_guids)}")
[?2004l[?2004h> print(f"Malicious process GUIDs: {malicious_guids}")
[?2004l[?2004h> 
[?2004l[?2004h> # Identify malicious events
[?2004l[?2004h> malicious_event_ids = set()
[?2004l[?2004h> reasons = {}
[?2004l[?2004h> 
[?2004l[?2004h> for ev in all_events:
[?2004l[?2004h>     eid = ev['event_id']
[?2004l[?2004h>     code = ev['event_code']
[?2004l[?2004h>     host = ev['host']
[?2004l[?2004h>     img = ev['image'] or ''
[?2004l[?2004h>     pimg = ev['parent_image'] or ''
[?2004l[?2004h>     cmd = ev['command_line'] or ''
[?2004l[?2004h>     pguid = ev['process_guid'] or ''
[?2004l[?2004h>     ppguid = ev['parent_process_guid'] or ''
[?2004l[?2004h>     msg = ev['message'] or ''
[?2004l[?2004h>     target = ev['target_object'] or ''
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. Directly associated with malicious process GUIDs
[?2004l[?2004h>     if pguid in malicious_guids or ppguid in malicious_guids:
[?2004l[?2004h>         malicious_event_ids.add(eid)
[?2004l[?2004h>         reasons[eid] = f"Process GUID match: pguid={pguid}, ppguid={ppguid}"
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 2. PowerShell pipeline execution and module/script block logging (which only exists on WS-05 for our malicious process)
[?2004l[?2004h>     if host == 'WS-05.corp.example' and code in (800, 4103, 4104):
[?2004l[?2004h>         malicious_event_ids.add(eid)
[?2004l[?2004h>         reasons[eid] = f"PowerShell event on WS-05 (code {code})"
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. WFP events matching PowerShell outbound connection to 10.10.10.5 or inbound binds
[?2004l[?2004h>     if code in (5156, 5158) and host == 'WS-05.corp.example':
[?2004l[?2004h>         # Let's check if the message mentions PowerShell or the C2 IP
[?2004l[?2004h>         if 'powershell.exe' in msg.lower() or '10.10.10.5' in msg:
[?2004l[?2004h>             malicious_event_ids.add(eid)
[?2004l[?2004h>             reasons[eid] = f"WFP malicious traffic: code={code}"
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect non-malicious events to see if we missed anything
[?2004l[?2004h> non_malicious = [ev for ev in all_events if ev['event_id'] not in malicious_event_ids]
[?2004l[?2004h> print(f"Directly classified malicious: {len(malicious_event_ids)}")
[?2004l[?2004h> print(f"Remaining non-malicious: {len(non_malicious)}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@3db2c36e1277:~# python3 classify.py
[?2004lMalicious process GUIDs count: 4
Malicious process GUIDs: {'{860ba2e3-9f2e-5f52-2a03-000000000400}', '{860ba2e3-9f13-5f52-2803-000000000400}', '{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}'}
Directly classified malicious: 821
