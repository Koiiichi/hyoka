[?2004l[?2004h>     code = ev['event_code']
[?2004l[?2004h>     host = ev['host']
[?2004l[?2004h>     img = ev['image'] or ''
[?2004l[?2004h>     pimg = ev['parent_image'] or ''
[?2004l[?2004h>     cmd = ev['command_line'] or ''
[?2004l[?2004h>     pguid = ev['process_guid'] or ''
[?2004l[?2004h>     ppguid = ev['parent_process_guid'] or ''
[?2004l[?2004h>     msg = ev['message'] or ''
[?2004l[?2004h>     
[?2004l[?2004h>     if pguid in malicious_guids or ppguid in malicious_guids:
[?2004l[?2004h>         malicious_events.add(eid)
