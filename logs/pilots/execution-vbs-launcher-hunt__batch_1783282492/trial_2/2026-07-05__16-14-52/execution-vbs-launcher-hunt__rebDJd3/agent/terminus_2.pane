[?2004hroot@3db2c36e1277:~# cat << 'EOF' > find_audits.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> mal_pids = {'0x988', '0x90c', '0x1e14', '0x23c0'}
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, host, message FROM events WHERE event_code IN (4656, 4658, 4663, 4690, 4673)")
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> matched = []
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     # search for Process ID: followed by spaces and one of our mal_pids
[?2004l[?2004h>     # or Process ID: 0x...
[?2004l[?2004h>     pid_matches = re.findall(r'Process ID:\s*(0x[0-9a-fA-F]+)', msg)
[?2004l[?2004h>     for pid in pid_matches:
[?2004l[?2004h>         if pid.lower() in mal_pids:
[?2004l[?2004h>             matched.append(r['event_id'])
[?2004l[?2004h>             print(f"Malicious Audit Event: {r['event_id']} | Code: {r['event_code']} | PID: {pid}")
[?2004l[?2004h>             break
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total matched audit events: {len(matched)}")
[?2004l[?2004h> EOF
