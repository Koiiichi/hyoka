[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> import base64
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find the main actors
[?2004l[?2004h> # We know evt-00073 (wscript.exe) is malicious.
[?2004l[?2004h> # Let's find its process GUID and any related events.
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE event_id = 'evt-00073'")
[?2004l[?2004h> wscript_row = cur.fetchone()
[?2004l[?2004h> wscript_guid = wscript_row['process_guid']
[?2004l[?2004h> print(f"wscript.exe GUID: {wscript_guid}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find powershell.exe
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE event_id = 'evt-00259'")
[?2004l[?2004h> ps_row = cur.fetchone()
[?2004l[?2004h> ps_guid = ps_row['process_guid']
[?2004l[?2004h> print(f"powershell.exe GUID: {ps_guid}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
