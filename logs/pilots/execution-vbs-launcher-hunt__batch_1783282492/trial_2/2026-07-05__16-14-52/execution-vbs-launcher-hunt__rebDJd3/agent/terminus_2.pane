[?2004l[?2004h>             term in msg.lower()):
[?2004l[?2004h>             has_term = True
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>     if has_term:
[?2004l[?2004h>         found_suspicious_remaining += 1
[?2004l[?2004h>         # Let's print details
[?2004l[?2004h>         print(f"{ev['timestamp']} | {eid} | Host: {host} | Code: {code} | Img: {img} | CMD: {cmd} | Msg: {msg[:100]}")
