[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, host, message FROM events WHERE event_code IN (5156, 5158)")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     app_match = re.search(r'Application Name:\s*(.*)', msg)
[?2004l[?2004h>     dst_match = re.search(r'Destination Address:\s*(.*)', msg)
[?2004l[?2004h>     dst_port_match = re.search(r'Destination Port:\s*(.*)', msg)
[?2004l[?2004h>     direction_match = re.search(r'Direction:\s*(.*)', msg)
[?2004l[?2004h>     
[?2004l[?2004h>     app = app_match.group(1).strip() if app_match else 'None'
[?2004l[?2004h>     dst = dst_match.group(1).strip() if dst_match else 'None'
[?2004l[?2004h>     port = dst_port_match.group(1).strip() if dst_port_match else 'None'
[?2004l[?2004h>     direction = direction_match.group(1).strip() if direction_match else 'None'
[?2004l[?2004h>     
[?2004l[?2004h>     # Print if it is not connecting to local loopback (::1 or 127.0.0.1) or Azure DNS/Metadata (168.63.129.16)
[?2004l[?2004h>     if dst not in ('::1', '127.0.0.1', '168.63.129.16', 'None') and not dst.startswith('fe80'):
[?2004l[?2004h>         print(f"{r['event_id']} | {r['host']} | Code: {r['event_code']} | Dir: {direction} | App: {app} | Dst: {dst}:{port}")
