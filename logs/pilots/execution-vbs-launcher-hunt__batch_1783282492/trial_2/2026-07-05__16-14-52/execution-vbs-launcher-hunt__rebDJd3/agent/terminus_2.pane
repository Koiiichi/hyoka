[?2004l[?2004h>             malicious_events.add(eid)
[?2004l[?2004h>             reasons[eid] = f"WFP malicious event {code}"
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>     if code in (4656, 4658, 4663, 4690, 4673):
