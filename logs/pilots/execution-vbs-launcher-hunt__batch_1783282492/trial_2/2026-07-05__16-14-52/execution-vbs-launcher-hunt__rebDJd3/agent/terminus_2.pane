[?2004hroot@3db2c36e1277:~# cat << 'EOF' > detailed_analysis.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's select all events from WS-05 that happened after 00:00:14
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, timestamp, image, parent_image, command_line, target_object, details FROM events WHERE host = 'WS-05.corp.example' AND timestamp >= '2026-05-06T00:00:14Z' ORDER BY timestamp ASC")
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> print(f"Total WS-05 events in intrusion window: {len(rows)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's see if there are events by processes other than our 4 malicious ones
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     img = r['image'] or ''
[?2004l[?2004h>     pimg = r['parent_image'] or ''
[?2004l[?2004h>     cmd = r['command_line'] or ''
[?2004l[?2004h>     code = r['event_code']
[?2004l[?2004h>     
[?2004l[?2004h>     # If it is one of our malicious processes, we can identify it
[?2004l[?2004h>     is_known_malicious = False
[?2004l[?2004h>     for term in ('wscript.exe', 'powershell.exe', 'conhost.exe', 'whoami.exe'):
[?2004l[?2004h>         if term in img.lower() or term in pimg.lower() or term in cmd.lower():
[?2004l[?2004h>             is_known_malicious = True
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>     if not is_known_malicious:
[?2004l[?2004h>         print(f"{r['timestamp']} | {r['event_id']} | Code {code} | Img: {img} | CMD: {cmd} | Target: {r['target_object'] or ''} | Details: {r['details'] or ''}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
