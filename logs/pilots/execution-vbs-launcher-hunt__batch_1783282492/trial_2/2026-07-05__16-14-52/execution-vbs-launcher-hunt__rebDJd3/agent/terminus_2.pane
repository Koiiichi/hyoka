[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's map process IDs from process creations
[?2004l[?2004h> # We know:
[?2004l[?2004h> # powershell.exe: PID 2316 (0x90c)
[?2004l[?2004h> # whoami.exe: PID 9152 (0x23c0)
[?2004l[?2004h> # Let's find PID for wscript.exe and conhost.exe
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, message FROM events WHERE event_code = 1 AND image LIKE '%wscript.exe%'")
[?2004l[?2004h> wscript_pid_sysmon = cur.fetchone()['message'] # we can extract from message or details
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, message FROM events WHERE event_code = 4688")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     proc_match = re.search(r'New Process Name:\s*(.*)', msg)
[?2004l[?2004h>     pid_match = re.search(r'New Process ID:\s*(.*)', msg)
[?2004l[?2004h>     if proc_match and pid_match:
[?2004l[?2004h>         print(f"Proc: {proc_match.group(1).strip()} | PID: {pid_match.group(1).strip()}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
