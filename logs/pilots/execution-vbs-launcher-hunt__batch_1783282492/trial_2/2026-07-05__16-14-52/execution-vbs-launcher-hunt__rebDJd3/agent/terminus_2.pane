[?2004l[?2004h>     if not new_children:
[?2004l[?2004h>         break
[?2004l[?2004h>     malicious_guids.update(new_children)
[?2004l[?2004h> 
[?2004l[?2004h> malicious_events = set()
[?2004l[?2004h> reasons = {}
[?2004l[?2004h> 
