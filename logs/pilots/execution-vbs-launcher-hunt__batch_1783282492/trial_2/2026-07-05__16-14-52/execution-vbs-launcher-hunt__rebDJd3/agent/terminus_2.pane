[?2004l[?2004h> 
[?2004l[?2004h> # Let's see if any of the remaining events have process names matching our malicious processes
[?2004l[?2004h> print("=== Non-classified events referencing malicious process names ===")
[?2004l[?2004h> suspicious_terms = ('powershell', 'wscript', 'conhost', 'whoami', 'launcher')
