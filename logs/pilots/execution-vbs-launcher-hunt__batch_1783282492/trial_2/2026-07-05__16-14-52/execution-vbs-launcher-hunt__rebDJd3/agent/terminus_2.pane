[?2004l[?2004h>     placeholders = ','.join('?' for _ in malicious_guids)
[?2004l[?2004h>     query = f"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IN ({placeholders})"
[?2004l[?2004h>     cur.execute(query, list(malicious_guids))
[?2004l[?2004h>     children = {row['process_guid'] for row in cur.fetchall() if row['process_guid']}
