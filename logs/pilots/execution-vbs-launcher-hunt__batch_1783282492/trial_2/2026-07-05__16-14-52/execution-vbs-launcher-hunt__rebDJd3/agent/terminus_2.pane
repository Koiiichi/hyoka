[?2004hroot@3db2c36e1277:~# cat << 'EOF' >> trace.py
[?2004l[?2004h> 
[?2004l[?2004h> # Let's write a function to recursively find all child processes and their events.
[?2004l[?2004h> malicious_guids = {wscript_guid, ps_guid}
[?2004l[?2004h> 
[?2004l[?2004h> # Loop to find child processes recursively
[?2004l[?2004h> while True:
[?2004l[?2004h>     placeholders = ','.join('?' for _ in malicious_guids)
[?2004l[?2004h>     query = f"SELECT process_guid FROM events WHERE event_code IN (1, 4688) AND parent_process_guid IN ({placeholders})"
[?2004l[?2004h>     cur.execute(query, list(malicious_guids))
[?2004l[?2004h>     children = {row['process_guid'] for row in cur.fetchall() if row['process_guid']}
[?2004l[?2004h>     new_children = children - malicious_guids
[?2004l[?2004h>     if not new_children:
[?2004l[?2004h>         break
[?2004l[?2004h>     malicious_guids.update(new_children)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"All malicious process GUIDs: {malicious_guids}")
[?2004l[?2004h> 
[?2004l[?2004h> # Now let's find all events associated with these process GUIDs
[?2004l[?2004h> # An event could be associated via: 
[?2004l[?2004h> # - process_guid
[?2004l[?2004h> # - parent_process_guid
[?2004l[?2004h> all_malicious_events = set()
[?2004l[?2004h> 
[?2004l[?2004h> placeholders = ','.join('?' for _ in malicious_guids)
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Events where process_guid is malicious
[?2004l[?2004h> cur.execute(f"SELECT event_id, event_code, image, command_line FROM events WHERE process_guid IN ({placeholders})", list(malicious_guids))
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     all_malicious_events.add(row['event_id'])
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Events where parent_process_guid is malicious
[?2004l[?2004h> cur.execute(f"SELECT event_id, event_code, image, command_line FROM events WHERE parent_process_guid IN ({placeholders})", list(malicious_guids))
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     all_malicious_events.add(row['event_id'])
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Collected {len(all_malicious_events)} events directly associated with malicious processes.")
[?2004l[?2004h> EOF
