uids or ppguid in malicious_guids:\n        malicious_event_ids.add(eid)\n        cats[\'Sysmon GUID\'] += 1\n        continue\n        \n    # Category 2: PowerShell console/operational/engine logs on WS-05\n    if host == \'WS-05.corp.example\' and code in (400, 800, 4103, 4104, 40961, 40962, 53504):\n        malicious_event_ids.add(eid)\n        cats[\'PowerShell operational\'] += 1\n        continue\n        \n    # Category 3: Security 4688/4689 process events for our malicious processes\n    if code in (4688, 4689):\n        is_mal = False\n        for term in suspicious_proc_names:\n            if term in msg.lower() or term in cmd.lower() or term in img.lower():\n                is_mal = True\n                break\n        if is_mal:\n            malicious_event_ids.add(eid)\n            cats[\'Security Process Creation/Exit\'] += 1\n            continue\n            \n    # Category 4: WFP logs for malicious processes\n    if code in (5156, 5158) and host == \'WS-05.corp.example\':\n        if \'powershell.exe\' in msg.lower() or \'10.10.10.5\' in msg:\n            malicious_event_ids.add(eid)\n            cats[\'WFP traffic\'] += 1\n            continue\n            \n    # Category 5: Security audit events matching PIDs\n    if code in (4656, 4658, 4663, 4690, 4673):\n        pid_matches = re.findall(r\'Process ID:\\s*(0x[0-9a-fA-F]+)\', msg)\n        is_mal = False\n        for pid in pid_matches:\n            if pid.lower() in mal_pids:\n                is_mal = True\n                break\n        if is_mal:\n            malicious_event_ids.add(eid)\n            cats[\'Security Audit\'] += 1\n            continue\n\nprint("[*] Malicious event counts by category:")\nfor k, v in cats.items():\n    print(f"  {k}: {v}")\n\ntotal_mal = len(malicious_event_ids)\nprint(f"[*] Total Malicious Events Identified: {total_mal}")\n\n# 4. Write to findings.json\nfindings_list = sorted(list(malicious_event_ids))\nwith open(\'/root/findings.json\', \'w\') as f:\n    json.dump(findings_list, f)\n\nprint("[*] Successfully wrote findings to /root/findings.json")\n\nEOF\npython3 solve.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
