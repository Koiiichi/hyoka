)\nsuspicious_remaining = []\nfor ev in all_events:\n    if ev[\'event_id\'] in malicious_event_ids:\n        continue\n    img = ev[\'image\'] or \'\'\n    pimg = ev[\'parent_image\'] or \'\'\n    cmd = ev[\'command_line\'] or \'\'\n    msg = ev[\'message\'] or \'\'\n    has_term = False\n    for term in suspicious_terms:\n        if term in img.lower() or term in pimg.lower() or term in cmd.lower() or term in msg.lower():\n            has_term = True\n            break\n    if has_term:\n        suspicious_remaining.append(ev)\n\nprint(f"Total suspicious remaining: {len(suspicious_remaining)}")\n# Group them by event_code, host, image and a simplified description\ngroups = {}\nfor ev in suspicious_remaining:\n    img = ev[\'image\'] or \'\'\n    code = ev[\'event_code\']\n    host = ev[\'host\']\n    # extract target image if any from message\n    target_img_match = re.search(r\'TargetImage:\\s*(.*)\', ev[\'message\'] or \'\')\n    target_img = target_img_match.group(1).strip() if target_img_match else \'None\'\n    \n    # check if source process guid is mentioned in message\n    src_guid_match = re.search(r\'SourceProcessGUID:\\s*(.*)\', ev[\'message\'] or \'\')\n    src_guid = src_guid_match.group(1).strip() if src_guid_match else \'None\'\n    \n    tgt_guid_match = re.search(r\'TargetProcessGUID:\\s*(.*)\', ev[\'message\'] or \'\')\n    tgt_guid = tgt_guid_match.group(1).strip() if tgt_guid_match else \'None\'\n\n    key = (code, host, img, target_img, src_guid, tgt_guid)\n    groups[key] = groups.get(key, 0) + 1\n\nfor k, count in sorted(groups.items(), key=lambda x: x[1], reverse=True):\n    print(f"Count: {count} | Code: {k[0]} | Host: {k[1]} | Img: {k[2]} | TgtImg: {k[3]} | SrcGUID: {k[4]} | TgtGUID: {k[5]}")\n\nEOF\npython3 analyze_suspicious.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
