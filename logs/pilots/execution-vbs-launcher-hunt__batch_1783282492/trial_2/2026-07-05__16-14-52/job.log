 = False\n        for term in suspicious_proc_names:\n            if term in msg.lower() or term in cmd.lower() or term in img.lower():\n                is_mal = True\n                break\n        if is_mal:\n            malicious_events.add(eid)\n            reasons[eid] = f"Security Process event {code}"\n            continue\n            \n    if code in (5156, 5158) and host == \'WS-05.corp.example\':\n        if \'powershell.exe\' in msg.lower() or \'10.10.10.5\' in msg:\n            malicious_events.add(eid)\n            reasons[eid] = f"WFP malicious event {code}"\n            continue\n            \n    if code in (4656, 4658, 4663, 4690, 4673):\n        pid_matches = re.findall(r\'Process ID:\\s*(0x[0-9a-fA-F]+)\', msg)\n        is_mal = False\n        for pid in pid_matches:\n            if pid.lower() in mal_pids:\n                is_mal = True\n                break\n        if is_mal:\n            malicious_events.add(eid)\n            reasons[eid] = f"Security Audit PID match {code}"\n            continue\n\nprint(f"Total Classified Malicious: {len(malicious_events)}")\nprint(f"Remaining: {2067 - len(malicious_events)}")\n\nprint("=== Remaining events on WS-05 ===")\nws05_remaining_count = 0\nfor ev in all_events:\n    if ev[\'event_id\'] not in malicious_events and ev[\'host\'] == \'WS-05.corp.example\':\n        ws05_remaining_count += 1\n        if ws05_remaining_count <= 20:\n            print(f"{ev[\'timestamp\']} | {ev[\'event_id\']} | Code: {ev[\'event_code\']} | Img: {ev[\'image\'] or \'\'} | Msg: {ev[\'message\'][:100]}")\n\nprint(f"Total remaining on WS-05: {ws05_remaining_count}")\n\nEOF\npython3 final_classification.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
