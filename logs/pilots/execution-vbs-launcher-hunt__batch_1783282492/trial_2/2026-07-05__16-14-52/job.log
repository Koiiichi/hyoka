Sending keys: ['cat << \'EOF\' > parse_wfp.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute("SELECT event_id, event_code, host, message FROM events WHERE event_code IN (5156, 5158)")\nfor r in cur.fetchall():\n    msg = r[\'message\'] or \'\'\n    app_match = re.search(r\'Application Name:\\s*(.*)\', msg)\n    dst_match = re.search(r\'Destination Address:\\s*(.*)\', msg)\n    dst_port_match = re.search(r\'Destination Port:\\s*(.*)\', msg)\n    direction_match = re.search(r\'Direction:\\s*(.*)\', msg)\n    \n    app = app_match.group(1).strip() if app_match else \'None\'\n    dst = dst_match.group(1).strip() if dst_match else \'None\'\n    port = dst_port_match.group(1).strip() if dst_port_match else \'None\'\n    direction = direction_match.group(1).strip() if direction_match else \'None\'\n    \n    # Print if it is not connecting to local loopback (::1 or 127.0.0.1) or Azure DNS/Metadata (168.63.129.16)\n    if dst not in (\'::1\', \'127.0.0.1\', \'168.63.129.16\', \'None\') and not dst.startswith(\'fe80\'):\n        print(f"{r[\'event_id\']} | {r[\'host\']} | Code: {r[\'event_code\']} | Dir: {direction} | App: {app} | Dst: {dst}:{port}")\nEOF\npython3 parse_wfp.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
