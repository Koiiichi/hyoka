[161.618234, "i", "cat << 'EOF' > /tmp/inspect_object_access.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, target_object, details, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690) \n    ORDER BY timestamp\n\"\"\")\nrows = [dict(row) for row in cur.fetchall()]\n\nprint(f\"Total object access events: {len(rows)}\")\n# print first few and check if user is m.ward\nm_ward_count = 0\nsystem_count = 0\nfor r in rows:\n    msg = r['message'] or ''\n    user = r['user'] or ''\n    if 'm.ward' in msg or 'm.ward' in user:\n        m_ward_count += 1\n        print(f\"Malicious? ID: {r['event_id']} | Code: {r['event_code']} | User: {r['user']} | Target: {r['target_object']} | Details: {r['details']}\")\n    else:\n        system_count += 1\n\nprint(f\"Summary: m.ward count: {m_ward_count}, system count: {system_count}\")\n\nEOF\npython3 /tmp/inspect_object_access.py\n"]
