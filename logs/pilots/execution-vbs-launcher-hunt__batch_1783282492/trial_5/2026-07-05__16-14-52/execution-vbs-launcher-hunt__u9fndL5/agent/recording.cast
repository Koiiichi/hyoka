[126.851565, "o", "cur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.851697, "o", "rows = [dict(row) for row in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> stats = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.851817, "o", "flagged_ids = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.851905, "o", "    ev_id = r['event_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.851959, "o", "    code = r['event_code']\r\n\u001b[?2004l\r"]
[126.85211, "o", "\u001b[?2004h>     guid = r.get('process_guid')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.852263, "o", "    pguid = r.get('parent_process_guid')\r\n\u001b[?2004l\r\u001b[?2004h>     msg = r.get('message') or ''\r\n\u001b[?2004l\r\u001b[?2004h>     details = r.get('details') or ''\r\n\u001b[?2004l\r"]
[126.852288, "o", "\u001b[?2004h> "]
[126.852397, "o", "    cl = r.get('command_line') or ''\r\n\u001b[?2004l\r\u001b[?2004h>     img = r.get('image') or ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.85242, "o", "    chan = r.get('channel') or ''\r\n\u001b[?2004l\r"]
[126.852433, "o", "\u001b[?2004h"]
[126.852698, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.852813, "o", "    is_mal = False\r\n\u001b[?2004l\r\u001b[?2004h>     reason = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.853008, "o", "    # Rule 1: Sysmon matches guid\r\n\u001b[?2004l\r\u001b[?2004h>     if guid in mal_guids or pguid in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>         reason = \"Sysmon Guid Match\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.853048, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.853382, "o", "        for g in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.853408, "o", "            if g in msg or g in details:\r\n\u001b[?2004l\r\u001b[?2004h>                 is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>                 reason = f\"Message Guid Match {g}\"\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.853638, "o", "    # Rule 2: Security 4688 / 4689 / 4673\r\n\u001b[?2004l\r\u001b[?2004h>     if not is_mal:\r\n\u001b[?2004l\r\u001b[?2004h>         if code == 4688:\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.853669, "o", "> "]
[126.85391, "o", "            if 'launcher.vbs' in cl or 'whoami.exe' in cl or ('powershell.exe' in cl and '-enc' in cl) or 'conhost.exe' in cl:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.854131, "o", "                # Wait, conhost.exe can be benign. Let's make sure it has the same timestamp as our powershell/launcher.\r\n\u001b[?2004l\r\u001b[?2004h>                 if 'conhost.exe' in cl and '0xffffffff' in cl and r['timestamp'] >= '2026-05-06T00:00:15Z' and r['timestamp'] <= '2026-05-06T00:00:18Z':"]
[126.854272, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                     is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.854405, "o", "                    reason = \"Security 4688 conhost.exe Match\"\r\n\u001b[?2004l\r\u001b[?2004h>                 elif 'conhost.exe' not in cl:\r\n\u001b[?2004l\r\u001b[?2004h>                     is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.854539, "o", "                    reason = \"Security 4688 Command Match\"\r\n\u001b[?2004l\r\u001b[?2004h>         elif code == 4689:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.854656, "o", "            # process termination for whoami, wscript, powershell, or conhost inside our window\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.854685, "o", "            # Let's see if the process name matches\r\n\u001b[?2004l\r"]
[126.854825, "o", "\u001b[?2004h> "]
[126.854933, "o", "            if 'whoami.exe' in msg or 'wscript.exe' in msg or 'powershell.exe' in msg:\r\n\u001b[?2004l\r\u001b[?2004h>                 is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.854954, "o", "> "]
[126.855087, "o", "                reason = \"Security 4689 Malicious Process Exit\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.855115, "o", "        elif code == 4673:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.855543, "o", "            # Privilege Use on whoami.exe\r\n\u001b[?2004l\r\u001b[?2004h>             if 'whoami.exe' in msg or 'whoami.exe' in details or (r['timestamp'] >= '2026-05-06T00:00:44.080Z' and r['timestamp'] <= '2026-05-06T00:00:44.100Z'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.855566, "o", "                is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>                 reason = \"Security 4673 Privilege Use around whoami\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.856378, "o", "    # Rule 3: PowerShell logs\r\n\u001b[?2004l\r\u001b[?2004h>     if not is_mal and code in (4103, 4104, 800, 400):\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>         reason = \"PowerShell Log Event\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if is_mal:\r\n\u001b[?2004l\r\u001b[?2004h>         flagged_ids.append(ev_id)\r\n\u001b[?2004l\r\u001b[?2004h>         stats_key = f\"{code} | {chan[:20]} | {img[:30]} | {reason}\"\r\n\u001b[?2004l\r\u001b[?2004h>         stats[stats_key] = stats.get(stats_key, 0) + 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.856504, "o", "print(f\"Total flagged events: {len(flagged_ids)}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Breakdown of flagged events:\")\r\n\u001b[?2004l\r\u001b[?2004h> for k, v in sorted(stats.items(), key=lambda x: x[1], reverse=True):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  {k} : {v}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
