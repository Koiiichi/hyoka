[171.659238, "i", "cat << 'EOF' > /tmp/inspect_m_ward_processes.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's inspect all events for m.ward on WS-05\ncur.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND (user = 'm.ward' OR user = 'CORP\\\\m.ward')\")\nrows = [dict(row) for row in cur.fetchall()]\n\nprint(f\"Total m.ward events: {len(rows)}\")\ncode_counts = {}\nfor r in rows:\n    code = r['event_code']\n    code_counts[code] = code_counts.get(code, 0) + 1\n\nprint(\"Event Code counts under m.ward:\")\nfor k, v in sorted(code_counts.items(), key=lambda x: x[1], reverse=True):\n    print(f\"  Code {k} : {v}\")\n\nEOF\npython3 /tmp/inspect_m_ward_processes.py\n"]
