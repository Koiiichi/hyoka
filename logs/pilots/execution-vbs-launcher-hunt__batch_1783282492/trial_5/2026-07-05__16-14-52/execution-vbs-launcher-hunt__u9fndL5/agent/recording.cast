[90.854891, "i", "cat << 'EOF' > /tmp/timeline.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, channel, user, image, parent_image, command_line, target_object, details\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND timestamp >= '2026-05-06T00:00:15.100Z'\n    ORDER BY timestamp\n\"\"\")\nrows = [dict(row) for row in cur.fetchall()]\n\nprint(f\"Total events on WS-05 from 00:00:15 onwards: {len(rows)}\")\nfor r in rows:\n    cl = (r['command_line'] or '')[:100]\n    to = (r['target_object'] or '')[:100]\n    print(f\"{r['event_id']} | {r['timestamp']} | Code={r['event_code']} | Chan={r['channel'][:15]} | Img={r['image']} | CL={cl} | Target={to}\")\n\nEOF\npython3 /tmp/timeline.py > /tmp/full_timeline.txt\nwc -l /tmp/full_timeline.txt\n"]
