[78.786728, "i", "cat << 'EOF' > /tmp/inspect_pids.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's inspect the specific events we already know\ncur.execute(\"SELECT * FROM events WHERE event_id IN ('evt-00073', 'evt-00247', 'evt-00259', 'evt-01817', 'evt-01820')\")\nfor row in cur.fetchall():\n    print(f\"ID: {row['event_id']}, Code: {row['event_code']}, Host: {row['host']}, Msg: {row['message'][:200]}\")\n    # print non-empty fields\n    d = dict(row)\n    for k, v in d.items():\n        if v is not None and v != '' and k not in ('message', 'command_line'):\n            print(f\"  {k}: {v}\")\n    print(\"-\" * 40)\n\nEOF\npython3 /tmp/inspect_pids.py\n"]
