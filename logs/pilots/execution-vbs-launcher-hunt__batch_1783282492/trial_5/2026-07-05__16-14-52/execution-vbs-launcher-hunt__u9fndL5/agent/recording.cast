[111.201218, "i", "cat << 'EOF' > /tmp/mal_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Malicious process GUIDs\nmal_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe\n    '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost.exe\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}', # whoami.exe\n}\n\n# Process IDs of malicious processes\nmal_pids = {2440, 2316, 9152} # wscript, powershell, whoami\n# Note: conhost process ID wasn't explicitly shown but we can match it by GUID or parent.\n\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\nrows = [dict(row) for row in cur.fetchall()]\n\nflagged = []\n\nfor r in rows:\n    ev_id = r['event_id']\n    code = r['event_code']\n    guid = r.get('process_guid')\n    pguid = r.get('parent_process_guid')\n    msg = r.get('message') or ''\n    details = r.get('details') or ''\n    cl = r.get('command_line') or ''\n    img = r.get('image') or ''\n    chan = r.get('channel') or ''\n    user = r.get('user') or ''\n    \n    # Check 1: Sysmon events directly associated with malicious process GUIDs\n    is_mal = False\n    if guid in mal_guids or pguid in mal_guids:\n        is_mal = True\n    else:\n        for g in mal_guids:\n            if g in msg or g in details:\n                is_mal = True\n                break\n                \n    # Check 2: Security 4688 / 4689 process events for the malicious executables\n    if not is_mal and code in (4688, 4689):\n        # For 4688, check if command_line contains launcher.vbs, the powershell base64, or whoami\n        if code == 4688:\n            if 'launcher.vbs' in cl or 'whoami.exe' in cl or ('powershell.exe' in cl and '-enc' in cl):\n                is_mal = True\n        # For 4689, let's look at the process name in the message\n        elif code == 4689:\n            if 'wscript.exe' in msg or 'whoami.exe' in msg or 'powershell.exe' in msg:\n                # Let's verify if the timestamp matches\n                is_mal = True\n\n    # Check 3: PowerShell (4103, 4104, 800, 400) events containing malicious script keywords\n    if not is_mal and code in (4103, 4104, 800, 400):\n        # Since there is only one powershell process on the system, ALL powershell execution events are malicious!\n        is_mal = True\n        \n    # Check 4: Other security logs (e.g. Privilege Use 4673) matching whoami.exe or powershell.exe execution window\n    if not is_mal and code == 4673:\n        # Let's see if whoami was running around this exact millisecond (2026-05-06T00:00:44)\n        if 'whoami.exe' in msg or 'whoami.exe' in details or (r['timestamp'] >= '2026-05-06T00:00:44Z' and r['timestamp'] <= '2026-05-06T00:00:45Z'):\n            is_mal = True\n            \n    if is_mal:\n        flagged.append(r)\n\nprint(f\"Flagged {len(flagged)} malicious events:\")\nfor f in flagged:\n    print(f\"{f['event_id']} | {f['timestamp']} | Code={f['event_code']} | Chan={f['channel'][:15]} | Img={f.get('image')} | CL={(f.get('command_line') or '')[:50]}\")\n\nEOF\npython3 /tmp/mal_events.py > /tmp/flagged_output.txt\nhead -n 50 /tmp/flagged_output.txt\ntail -n 50 /tmp/flagged_output.txt\n"]
[111.201995, "o", "cat << 'EOF' > /tmp/mal_events.py\r\n\u001b[?2004l\r"]
