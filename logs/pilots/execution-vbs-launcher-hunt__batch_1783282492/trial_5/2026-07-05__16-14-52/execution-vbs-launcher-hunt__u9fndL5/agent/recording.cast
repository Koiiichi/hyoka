\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     is_mal = False\r\n\u001b[?2004l\r\u001b[?2004h>     reason = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Rule 1: User is m.ward\r\n\u001b[?2004l\r\u001b[?2004h>     if user in ('m.ward', 'CORP\\\\m.ward'):\r\n\u001b[?2004l\r\u001b[?2004h>         is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
