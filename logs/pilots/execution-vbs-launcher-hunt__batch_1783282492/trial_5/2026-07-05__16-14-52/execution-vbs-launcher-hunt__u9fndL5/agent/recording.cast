[126.851107, "o", "    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.851171, "o", "    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe\r\n\u001b[?2004l\r\u001b[?2004h"]
