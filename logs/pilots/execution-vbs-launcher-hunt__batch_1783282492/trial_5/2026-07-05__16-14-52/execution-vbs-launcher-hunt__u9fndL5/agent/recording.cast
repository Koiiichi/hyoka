[140.865041, "i", "cat << 'EOF' > /tmp/inspect_extra.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Inspect other potential events\nextra_codes = (600, 4703, 4673, 9, 4672, 4624, 4627, 4634, 4670, 5857, 40961, 40962, 53504)\ncur.execute(\"SELECT event_id, timestamp, event_code, host, user, image, command_line, details, message FROM events WHERE event_code IN %s ORDER BY timestamp\" % str(extra_codes))\nfor row in cur.fetchall():\n    print(f\"ID: {row['event_id']} | Code: {row['event_code']} | Host: {row['host']} | User: {row['user']} | Image: {row['image']} | CL: {(row['command_line'] or '')[:100]} | Msg: {row['message'][:150].strip()}\")\n\nEOF\npython3 /tmp/inspect_extra.py\n"]
