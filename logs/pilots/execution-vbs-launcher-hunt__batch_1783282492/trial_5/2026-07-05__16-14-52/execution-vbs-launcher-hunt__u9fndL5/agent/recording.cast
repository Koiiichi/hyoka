[41.994876, "i", "cat << 'EOF' > /tmp/hunt_filtered.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmal_guids = {'{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f13-5f52-2803-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'}\n\ncur.execute(\"SELECT * FROM events\")\nall_events = [dict(row) for row in cur.fetchall()]\n\n# Filter for event codes that are NOT 7, 10, or 12\ninteresting_codes = {1, 3, 5, 11, 13, 17, 18, 22, 23, 4688, 4624, 4625, 7045}\n\nmal_events = []\nfor ev in all_events:\n    pguid = ev.get('process_guid')\n    ppguid = ev.get('parent_process_guid')\n    \n    is_mal = False\n    if pguid in mal_guids or ppguid in mal_guids:\n        is_mal = True\n    else:\n        msg = ev.get('message') or ''\n        details = ev.get('details') or ''\n        for g in mal_guids:\n            if g in msg or g in details:\n                is_mal = True\n                break\n                \n    if is_mal and ev['event_code'] in interesting_codes:\n        mal_events.append(ev)\n\nmal_events.sort(key=lambda x: x.get('timestamp') or '')\n\nprint(f\"Found {len(mal_events)} interesting malicious events:\")\nfor ev in mal_events:\n    print(f\"{ev['event_id']} | {ev['timestamp']} | Code={ev['event_code']} | {ev.get('image')} | CL={ev.get('command_line') or ''} | Target={ev.get('target_object') or ''} | Dst={ev.get('dst_ip')}:{ev.get('dst_port')} | Details={ev.get('details') or ''}\")\n\nEOF\npython3 /tmp/hunt_filtered.py\n"]
[41.995918, "o", "cat << 'EOF' > /tmp/hunt_filtered.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
