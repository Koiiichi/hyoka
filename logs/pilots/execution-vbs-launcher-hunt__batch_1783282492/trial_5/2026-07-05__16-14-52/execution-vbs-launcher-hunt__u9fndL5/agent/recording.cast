3-945924832-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections | \r\nevt-02032 | 2026-05-06T00:01:05.256Z | 12 | Microsoft-Windows-Sysmon/Operational | C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe |  | HKU\\S-1-5-21-2079883792-3656946353-945924832-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections | \r\n"]
[27.637013, "o", "\u001b[?2004hroot@0eb806b2266a:~# "]
[34.757708, "i", "cat << 'EOF' > /tmp/hunt_detailed.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmal_guids = {'{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f13-5f52-2803-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'}\n\ncur.execute(\"SELECT * FROM events\")\nall_events = [dict(row) for row in cur.fetchall()]\n\n# Filter events associated with malicious processes\nmal_events = []\nfor ev in all_events:\n    pguid = ev.get('process_guid')\n    ppguid = ev.get('parent_process_guid')\n    ev_id = ev.get('event_id')\n    ev_code = ev.get('event_code')\n    \n    is_mal = False\n    if pguid in mal_guids or ppguid in mal_guids:\n        is_mal = True\n    else:\n        msg = ev.get('message') or ''\n        details = ev.get('details') or ''\n        for g in mal_guids:\n            if g in msg or g in details:\n                is_mal = True\n                break\n                \n    if is_mal:\n        mal_events.append(ev)\n\nmal_events.sort(key=lambda x: x.get('timestamp') or '')\n\nprint(f\"Total malicious-associated events: {len(mal_events)}\")\nprint(\"Non-Event7 and Non-Event10 details:\")\nfor ev in mal_events:\n    if ev['event_code'] not in (7, 10):\n        print(f\"{ev['event_id']} | {ev['timestamp']} | {ev['event_code']} | {ev['channel']} | {ev.get('image')} | {ev.get('command_line') or ''} | {ev.get('target_object') or ''} | {ev.get('details') or ''} | Src={ev.get('src_ip')} Dst={ev.get('dst_ip')}:{ev.get('dst_port')}\")\n\nEOF\npython3 /tmp/hunt_detailed.py > /tmp/mal_non7_10.txt\nhead -n 100 /tmp/mal_non7_10.txt\n"]
