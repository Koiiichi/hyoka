[64.497705, "i", "cat << 'EOF' > /tmp/hunt_other_hosts.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Query for events of interest on DC01 and WS-06\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, service_name, target_object, details, message\n    FROM events\n    WHERE host != 'WS-05.corp.example'\n      AND event_code IN (1, 3, 11, 13, 22, 4688, 4624, 4625, 7045, 4672, 4697, 4776)\n    ORDER BY timestamp\n\"\"\")\nrows = [dict(row) for row in cur.fetchall()]\n\nprint(f\"Found {len(rows)} interesting events on DC01/WS-06:\")\nfor r in rows:\n    print(f\"{r['event_id']} | {r['timestamp']} | Host={r['host']} | Code={r['event_code']} | User={r['user']} | Image={r['image']} | CL={r['command_line'] or ''} | Target={r['target_object'] or ''} | Details={r['details'] or ''}\")\n\nEOF\npython3 /tmp/hunt_other_hosts.py\n"]
[64.497874, "o", "cat << 'EOF' > /tmp/hunt_other_hosts.py\r\n\u001b[?2004l\r"]
[64.498039, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.498068, "o", "> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.498215, "o", "# Query for events of interest on DC01 and WS-06\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.498412, "o", "    SELECT event_id, timestamp, event_code, host, user, image, parent_image, command_line, service_name, target_object, details, message\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events\r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host != 'WS-05.corp.example'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.49865, "o", "      AND event_code IN (1, 3, 11, 13, 22, 4688, 4624, 4625, 7045, 4672, 4697, 4776)\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.498672, "o", "> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> rows = [dict(row) for row in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(rows)} interesting events on DC01/WS-06:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.49889, "o", "> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{r['event_id']} | {r['timestamp']} | Host={r['host']} | Code={r['event_code']} | User={r['user']} | Image={r['image']} | CL={r['command_line'] or ''} | Target={r['target_object'] or ''} | Details={r['details'] or ''}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
