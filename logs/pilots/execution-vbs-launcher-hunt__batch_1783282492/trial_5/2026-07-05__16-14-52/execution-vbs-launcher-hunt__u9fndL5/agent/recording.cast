[27.599205, "i", "cat << 'EOF' > /tmp/hunt_detailed.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Malicious GUIDs\nmal_guids = {'{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f13-5f52-2803-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'}\n\n# Query events with any of these process GUIDs\nall_mal_events = []\n\n# Find exact matching on process_guid or parent_process_guid\ncur.execute(\"SELECT * FROM events\")\nall_events = [dict(row) for row in cur.fetchall()]\n\nfor ev in all_events:\n    # check if any GUID matches\n    pguid = ev.get('process_guid')\n    ppguid = ev.get('parent_process_guid')\n    ev_id = ev.get('event_id')\n    ev_code = ev.get('event_code')\n    \n    is_mal = False\n    if pguid in mal_guids or ppguid in mal_guids:\n        is_mal = True\n    else:\n        # check message or details for the guid\n        msg = ev.get('message') or ''\n        details = ev.get('details') or ''\n        for g in mal_guids:\n            if g in msg or g in details:\n                is_mal = True\n                break\n                \n    if is_mal:\n        all_mal_events.append(ev)\n\n# Sort by timestamp\nall_mal_events.sort(key=lambda x: x.get('timestamp') or '')\n\nprint(f\"Found {len(all_mal_events)} related events:\")\nfor ev in all_mal_events:\n    print(f\"{ev['event_id']} | {ev['timestamp']} | {ev['event_code']} | {ev['channel']} | {ev.get('image')} | {ev.get('command_line') or ''} | {ev.get('target_object') or ''} | {ev.get('details') or ''}\")\n\nEOF\npython3 /tmp/hunt_detailed.py\n"]
