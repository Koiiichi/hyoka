[126.849955, "i", "cat << 'EOF' > /tmp/mal_stats.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Malicious process GUIDs\nmal_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe\n    '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost.exe\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}', # whoami.exe\n}\n\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\nrows = [dict(row) for row in cur.fetchall()]\n\nstats = {}\nflagged_ids = []\n\nfor r in rows:\n    ev_id = r['event_id']\n    code = r['event_code']\n    guid = r.get('process_guid')\n    pguid = r.get('parent_process_guid')\n    msg = r.get('message') or ''\n    details = r.get('details') or ''\n    cl = r.get('command_line') or ''\n    img = r.get('image') or ''\n    chan = r.get('channel') or ''\n    \n    is_mal = False\n    reason = \"\"\n    \n    # Rule 1: Sysmon matches guid\n    if guid in mal_guids or pguid in mal_guids:\n        is_mal = True\n        reason = \"Sysmon Guid Match\"\n    else:\n        for g in mal_guids:\n            if g in msg or g in details:\n                is_mal = True\n                reason = f\"Message Guid Match {g}\"\n                break\n                \n    # Rule 2: Security 4688 / 4689 / 4673\n    if not is_mal:\n        if code == 4688:\n            if 'launcher.vbs' in cl or 'whoami.exe' in cl or ('powershell.exe' in cl and '-enc' in cl) or 'conhost.exe' in cl:\n                # Wait, conhost.exe can be benign. Let's make sure it has the same timestamp as our powershell/launcher.\n                if 'conhost.exe' in cl and '0xffffffff' in cl and r['timestamp'] >= '2026-05-06T00:00:15Z' and r['timestamp'] <= '2026-05-06T00:00:18Z':\n                    is_mal = True\n                    reason = \"Security 4688 conhost.exe Match\"\n                elif 'conhost.exe' not in cl:\n                    is_mal = True\n                    reason = \"Security 4688 Command Match\"\n        elif code == 4689:\n            # process termination for whoami, wscript, powershell, or conhost inside our window\n            # Let's see if the process name matches\n            if 'whoami.exe' in msg or 'wscript.exe' in msg or 'powershell.exe' in msg:\n                is_mal = True\n                reason = \"Security 4689 Malicious Process Exit\"\n        elif code == 4673:\n            # Privilege Use on whoami.exe\n            if 'whoami.exe' in msg or 'whoami.exe' in details or (r['timestamp'] >= '2026-05-06T00:00:44.080Z' and r['timestamp'] <= '2026-05-06T00:00:44.100Z'):\n                is_mal = True\n                reason = \"Security 4673 Privilege Use around whoami\"\n\n    # Rule 3: PowerShell logs\n    if not is_mal and code in (4103, 4104, 800, 400):\n        is_mal = True\n        reason = \"PowerShell Log Event\"\n\n    if is_mal:\n        flagged_ids.append(ev_id)\n        stats_key = f\"{code} | {chan[:20]} | {img[:30]} | {reason}\"\n        stats[stats_key] = stats.get(stats_key, 0) + 1\n\nprint(f\"Total flagged events: {len(flagged_ids)}\")\nprint(\"Breakdown of flagged events:\")\nfor k, v in sorted(stats.items(), key=lambda x: x[1], reverse=True):\n    print(f\"  {k} : {v}\")\n\nEOF\npython3 /tmp/mal_stats.py\n"]
[126.850289, "o", "cat << 'EOF' > /tmp/mal_stats.py\r\n\u001b[?2004l\r"]
[126.850419, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
