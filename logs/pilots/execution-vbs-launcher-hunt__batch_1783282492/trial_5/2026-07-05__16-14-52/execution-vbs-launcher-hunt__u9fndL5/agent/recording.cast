[171.678095, "o", "\u001b[?2004hroot@0eb806b2266a:~# "]
[185.79321, "i", "cat << 'EOF' > /tmp/compile_malicious.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmal_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe\n    '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost.exe\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}', # whoami.exe\n}\n\ncur.execute(\"SELECT * FROM events ORDER BY timestamp\")\nall_events = [dict(row) for row in cur.fetchall()]\n\nflagged = []\n\nfor ev in all_events:\n    # Skip other hosts completely since they are benign\n    if ev.get('host') != 'WS-05.corp.example':\n        continue\n        \n    ev_id = ev['event_id']\n    code = ev['event_code']\n    guid = ev.get('process_guid')\n    pguid = ev.get('parent_process_guid')\n    msg = ev.get('message') or ''\n    details = ev.get('details') or ''\n    cl = ev.get('command_line') or ''\n    img = ev.get('image') or ''\n    chan = ev.get('channel') or ''\n    user = ev.get('user') or ''\n    \n    is_mal = False\n    reason = \"\"\n    \n    # Rule 1: User is m.ward\n    if user in ('m.ward', 'CORP\\\\m.ward'):\n        is_mal = True\n        reason = \"User is m.ward\"\n        \n    # Rule 2: Sysmon ProcessGuid or ParentProcessGuid matches\n    elif guid in mal_guids or pguid in mal_guids:\n        is_mal = True\n        reason = \"Sysmon GUID match\"\n        \n    # Rule 3: Message or Details contain malicious GUIDs\n    elif any(g in msg or g in details for g in mal_guids):\n        is_mal = True\n        reason = \"GUID found in msg/details\"\n        \n    # Rule 4: PowerShell Operational or Engine logs\n    elif code in (4103, 4104, 800, 400, 600, 40961, 40962, 53504):\n        is_mal = True\n        reason = \"PowerShell log\"\n        \n    # Rule 5: Security events for malicious command lines or process IDs\n    elif code == 4688:\n        if 'launcher.vbs' in cl or 'whoami.exe' in cl or 'powershell.exe' in cl or 'conhost.exe' in cl:\n            is_mal = True\n            reason = \"Malicious process creation (4688)\"\n            \n    elif code == 4689:\n        if 'wscript.exe' in msg or 'whoami.exe' in msg or 'powershell.exe' in msg or 'conhost.exe' in msg:\n            is_mal = True\n            reason = \"Malicious process exit (4689)\"\n            \n    elif code == 4673:\n        if 'whoami.exe' in msg or 'whoami.exe' in details:\n            is_mal = True\n            reason = \"whoami privilege use\"\n            \n    if is_mal:\n        # Exclude known benign triggers if any\n        # Let's inspect raw access reads or standard Defender unless clearly flagged\n        # If we are raw access read from System process, let's keep it if we decide, but wait, let's check\n        if code == 9 and img == 'System':\n            # Sysmon Code 9 from System process is standard OS response. Let's exclude it to be safe and avoid false positives.\n            continue\n            \n        flagged.append((ev_id, code, chan, img, reason, ev['timestamp']))\n\nprint(f\"Flagged {len(flagged)} malicious events.\")\n# Print a random sample or count by reason\nreason_counts = {}\nfor f in flagged:\n    reason_counts[f[4]] = reason_counts.get(f[4], 0) + 1\nfor k, v in reason_counts.items():\n    print(f\"Reason '{k}' count: {v}\")\n\nEOF\npython3 /tmp/compile_malicious.py\n"]
