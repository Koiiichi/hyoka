[111.205593, "o", "            if 'launcher.vbs' in cl or 'whoami.exe' in cl or ('powershell.exe' in cl and '-enc' in cl):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.205809, "o", "                is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.205958, "o", "        # For 4689, let's look at the process name in the message\r\n\u001b[?2004l\r\u001b[?2004h>         elif code == 4689:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.206076, "o", "            if 'wscript.exe' in msg or 'whoami.exe' in msg or 'powershell.exe' in msg:\r\n\u001b[?2004l\r\u001b[?2004h>                 # Let's verify if the timestamp matches\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.206143, "o", "                is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.206284, "o", "    # Check 3: PowerShell (4103, 4104, 800, 400) events containing malicious script keywords\r\n\u001b[?2004l\r\u001b[?2004h>     if not is_mal and code in (4103, 4104, 800, 400):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.206401, "o", "        # Since there is only one powershell process on the system, ALL powershell execution events are malicious!\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.206471, "o", "        is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.20661, "o", "    # Check 4: Other security logs (e.g. Privilege Use 4673) matching whoami.exe or powershell.exe execution window\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.206685, "o", "    if not is_mal and code == 4673:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.20683, "o", "        # Let's see if whoami was running around this exact millisecond (2026-05-06T00:00:44)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.207004, "o", "        if 'whoami.exe' in msg or 'whoami.exe' in details or (r['timestamp'] >= '2026-05-06T00:00:44Z' and r['timestamp'] <= '2026-05-06T00:00:45Z'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.207136, "o", "            is_mal = True\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     if is_mal:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.207307, "o", "        flagged.append(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.207711, "o", "\u001b[?2004h> print(f\"Flagged {len(flagged)} malicious events:\")\r\n\u001b[?2004l\r\u001b[?2004h> for f in flagged:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{f['event_id']} | {f['timestamp']} | Code={f['event_code']} | Chan={f['channel'][:15]} | Img={f.get('image')} | CL={(f.get('command_line') or '')[:50]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
