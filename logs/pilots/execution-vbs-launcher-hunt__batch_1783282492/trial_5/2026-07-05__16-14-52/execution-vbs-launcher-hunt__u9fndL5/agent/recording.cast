d pguid not in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h>             mal_guids.add(pguid)\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"Child mal process: ID={p['event_id']}, Code={p['event_code']}, GUID={pguid}, Image={p['image']}, Parent={p['parent_image']}, CL={p.get('command_line')[:100]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
