[193.436524, "i", "cat << 'EOF' > /tmp/check_unflagged.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Get our list of flagged IDs\nimport sys\nsys.path.append('/tmp')\nfrom compile_malicious import flagged\nflagged_ids = {f[0] for f in flagged}\n\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, channel, user, image, command_line, target_object, message\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n      AND timestamp >= '2026-05-06T00:00:15.108Z'\n      AND timestamp <= '2026-05-06T00:01:08.280Z'\n    ORDER BY timestamp\n\"\"\")\nrows = [dict(row) for row in cur.fetchall()]\n\nunflagged = [r for r in rows if r['event_id'] not in flagged_ids]\nprint(f\"Total unflagged events on WS-05 in malicious window: {len(unflagged)}\")\n\n# Count by event code and image\ncounts = {}\nfor u in unflagged:\n    img = u.get('image') or ''\n    key = f\"{u['event_code']} | {u['channel'][:20]} | {img[:35]}\"\n    counts[key] = counts.get(key, 0) + 1\n\nprint(\"Unflagged event breakdown:\")\nfor k, v in sorted(counts.items(), key=lambda x: x[1], reverse=True):\n    print(f\"  {k} : {v}\")\n\n# Print a few examples of high count codes\nprint(\"\\nExamples of unflagged:\")\nfor u in unflagged[:30]:\n    print(f\"{u['event_id']} | {u['timestamp']} | Code={u['event_code']} | User={u['user']} | Image={u['image']} | CL={(u['command_line'] or '')[:50]} | Msg={(u['message'] or '').strip()[:100].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/check_unflagged.py\n"]
