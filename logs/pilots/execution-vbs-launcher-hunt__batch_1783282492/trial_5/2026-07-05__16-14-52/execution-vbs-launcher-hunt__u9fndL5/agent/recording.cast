[51.552345, "i", "cat << 'EOF' > /tmp/hunt_sec.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's search all events on WS-05.corp.example within the critical window\n# We'll filter for channel='Security' or EventCode in Security channels\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, service_name, target_object, details, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' \n      AND timestamp >= '2026-05-06T00:00:14Z'\n      AND timestamp <= '2026-05-06T00:00:50Z'\n    ORDER BY timestamp\n\"\"\")\nrows = [dict(row) for row in cur.fetchall()]\n\nprint(f\"Total events in window: {len(rows)}\")\nfor r in rows:\n    code = r['event_code']\n    # filter out typical high volume noisy event codes if necessary, but let's see them first\n    # High volume: 4658, 4690, 4656, 4663, 5156, 5158 (or we can summarize them)\n    if code in (4658, 4690, 4656, 4663, 5156, 5158, 4103, 800):\n        continue\n    print(f\"{r['event_id']} | {r['timestamp']} | Code={code} | User={r['user']} | Image={r['image']} | CL={r['command_line'] or ''} | Service={r['service_name']} | Target={r['target_object'] or ''} | Details={r['details'] or ''}\")\n\nEOF\npython3 /tmp/hunt_sec.py\n"]
