Operational|WS-05.corp.example|||||||\r\nevt-02062|2026-05-06T00:01:08.275Z|800|Windows PowerShell|WS-05.corp.example|||||||\r\nevt-02063|2026-05-06T00:01:08.276Z|800|Windows PowerShell|WS-05.corp.example|||||||\r\nevt-02064|2026-05-06T00:01:08.278Z|4103|Microsoft-Windows-PowerShell/Operational|WS-05.corp.example|||||||\r\nevt-02065|2026-05-06T00:01:08.278Z|4103|Microsoft-Windows-PowerShell/Operational|WS-05.corp.example|||||||\r\nevt-02066|2026-05-06T00:01:08.278Z|800|Windows PowerShell|WS-05.corp.example|||||||\r\nevt-02067|2026-05-06T00:01:08.279Z|800|Windows PowerShell|WS-05.corp.example|||||||\r\n\u001b[?2004hroot@0eb806b2266a:~# "]
[20.630147, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's get the process_guid of the launcher wscript and powershell\ncur.execute(\"SELECT event_id, event_code, host, user, image, parent_image, parent_process_guid, process_guid, command_line FROM events WHERE event_code IN (1, 4688) AND host = 'WS-05.corp.example'\")\nprocesses = [dict(row) for row in cur.fetchall()]\n\n# Find the initial malicious processes\nmal_guids = set()\nfor p in processes:\n    cl = p.get('command_line') or ''\n    img = p.get('image') or ''\n    p_img = p.get('parent_image') or ''\n    if 'launcher.vbs' in cl or 'powershell.exe' in img and p_img.endswith('wscript.exe'):\n        if p.get('process_guid'):\n            mal_guids.add(p.get('process_guid'))\n        print(f\"Initial mal process: ID={p['event_id']}, Code={p['event_code']}, GUID={p.get('process_guid')}, Image={img}, CL={cl[:100]}\")\n\n# Recursively find children based on parent_process_guid\nlast_len = 0\nwhile len(mal_guids) > last_len:\n    last_len = len(mal_guids)\n    for p in processes:\n        pguid = p.get('process_guid')\n        ppguid = p.get('parent_process_guid')\n        if ppguid in mal_guids and pguid and pguid not in mal_guids:\n            mal_guids.add(pguid)\n            print(f\"Child mal process: ID={p['event_id']}, Code={p['event_code']}, GUID={pguid}, Image={p['image']}, Parent={p['parent_image']}, CL={p.get('command_line')[:100]}\")\n\nprint(f\"Malicious process GUIDs: {mal_guids}\")\n\nEOF\npython3 /tmp/hunt.py\n"]
[20.630416, "o", "cat << 'EOF' > /tmp/hunt.py\r\n\u001b[?2004l\r"]
