[146.12023, "i", "cat << 'EOF' > /tmp/inspect_extra_ws05.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nextra_codes = (600, 4703, 4673, 9, 4672, 4624, 4627, 4634, 4670, 5857, 40961, 40962, 53504)\ncur.execute(\"SELECT event_id, timestamp, event_code, host, user, image, command_line, details, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN %s ORDER BY timestamp\" % str(extra_codes))\nfor row in cur.fetchall():\n    cl = (row['command_line'] or '')[:100]\n    msg = (row['message'] or '').replace('\\n', ' ').replace('\\r', '')[:120].strip()\n    print(f\"ID: {row['event_id']} | Code: {row['event_code']} | User: {row['user']} | Image: {row['image']} | CL: {cl} | Msg: {msg}\")\n\nEOF\npython3 /tmp/inspect_extra_ws05.py\n"]
[146.120775, "o", "cat << 'EOF' > /tmp/inspect_extra_ws05.py\r\n\u001b[?2004l\r"]
