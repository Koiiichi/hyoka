[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     # Check 4: Other security logs (e.g. Privilege Use 4673) matching whoami.exe or powershell.exe execution window
[?2004l[?2004h>     if not is_mal and code == 4673:
