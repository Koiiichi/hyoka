[?2004hroot@0eb806b2266a:~# cat << 'EOF' > /tmp/hunt.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's get the process_guid of the launcher wscript and powershell
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, host, user, image, parent_image, parent_process_guid, process_guid, command_line FROM events WHERE event_code IN (1, 4688) AND host = 'WS-05.corp.example'")
[?2004l[?2004h> processes = [dict(row) for row in cur.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> # Find the initial malicious processes
[?2004l[?2004h> mal_guids = set()
[?2004l[?2004h> for p in processes:
[?2004l[?2004h>     cl = p.get('command_line') or ''
[?2004l[?2004h>     img = p.get('image') or ''
[?2004l[?2004h>     p_img = p.get('parent_image') or ''
[?2004l[?2004h>     if 'launcher.vbs' in cl or 'powershell.exe' in img and p_img.endswith('wscript.exe'):
[?2004l[?2004h>         if p.get('process_guid'):
[?2004l[?2004h>             mal_guids.add(p.get('process_guid'))
[?2004l[?2004h>         print(f"Initial mal process: ID={p['event_id']}, Code={p['event_code']}, GUID={p.get('process_guid')}, Image={img}, CL={cl[:100]}")
[?2004l[?2004h> 
[?2004l[?2004h> # Recursively find children based on parent_process_guid
[?2004l[?2004h> last_len = 0
[?2004l[?2004h> while len(mal_guids) > last_len:
[?2004l[?2004h>     last_len = len(mal_guids)
[?2004l[?2004h>     for p in processes:
[?2004l[?2004h>         pguid = p.get('process_guid')
[?2004l[?2004h>         ppguid = p.get('parent_process_guid')
[?2004l[?2004h>         if ppguid in mal_guids and pguid and pguid not in mal_guids:
[?2004l[?2004h>             mal_guids.add(pguid)
[?2004l[?2004h>             print(f"Child mal process: ID={p['event_id']}, Code={p['event_code']}, GUID={pguid}, Image={p['image']}, Parent={p['parent_image']}, CL={p.get('command_line')[:100]}")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Malicious process GUIDs: {mal_guids}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@0eb806b2266a:~# python3 /tmp/hunt.py
[?2004lInitial mal process: ID=evt-00073, Code=1, GUID={860ba2e3-9f13-5f52-2603-000000000400}, Image=C:\Windows\System32\wscript.exe, CL="C:\windows\System32\WScript.exe" "C:\Users\m.ward\Desktop\launcher.vbs" 
Initial mal process: ID=evt-00247, Code=4688, GUID=None, Image=, CL="C:\windows\System32\WScript.exe" "C:\Users\m.ward\Desktop\launcher.vbs" 
Initial mal process: ID=evt-00259, Code=1, GUID={860ba2e3-9f13-5f52-2703-000000000400}, Image=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe, CL="C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" -noP -sta -w 1 -enc  SQBmACgAJABQAFMAVgB
Child mal process: ID=evt-00289, Code=1, GUID={860ba2e3-9f13-5f52-2803-000000000400}, Image=C:\Windows\System32\conhost.exe, Parent=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe, CL=\??\C:\windows\system32\conhost.exe 0xffffffff -ForceV1
Child mal process: ID=evt-01820, Code=1, GUID={860ba2e3-9f2e-5f52-2a03-000000000400}, Image=C:\Windows\System32\whoami.exe, Parent=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe, CL="C:\windows\system32\whoami.exe"
Malicious process GUIDs: {'{860ba2e3-9f13-5f52-2803-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}', '{860ba2e3-9f13-5f52-2603-000000000400}'}
[?2004hroot@0eb806b2266a:~# cat << 'EOF' > /tmp/hunt_detailed.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious GUIDs
[?2004l[?2004h> mal_guids = {'{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f13-5f52-2803-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'}
[?2004l[?2004h> 
[?2004l[?2004h> # Query events with any of these process GUIDs
[?2004l[?2004h> all_mal_events = []
[?2004l[?2004h> 
[?2004l[?2004h> # Find exact matching on process_guid or parent_process_guid
[?2004l[?2004h> cur.execute("SELECT * FROM events")
[?2004l[?2004h> all_events = [dict(row) for row in cur.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> for ev in all_events:
[?2004l[?2004h>     # check if any GUID matches
[?2004l[?2004h>     pguid = ev.get('process_guid')
[?2004l[?2004h>     ppguid = ev.get('parent_process_guid')
[?2004l[?2004h>     ev_id = ev.get('event_id')
[?2004l[?2004h>     ev_code = ev.get('event_code')
[?2004l[?2004h>     
[?2004l[?2004h>     is_mal = False
[?2004l[?2004h>     if pguid in mal_guids or ppguid in mal_guids:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>     else:
[?2004l[?2004h>         # check message or details for the guid
[?2004l[?2004h>         msg = ev.get('message') or ''
[?2004l[?2004h>         details = ev.get('details') or ''
[?2004l[?2004h>         for g in mal_guids:
[?2004l[?2004h>             if g in msg or g in details:
[?2004l[?2004h>                 is_mal = True
[?2004l[?2004h>                 break
[?2004l[?2004h>                 
[?2004l[?2004h>     if is_mal:
[?2004l[?2004h>         all_mal_events.append(ev)
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by timestamp
[?2004l[?2004h> all_mal_events.sort(key=lambda x: x.get('timestamp') or '')
[?2004l[?2004h> 
