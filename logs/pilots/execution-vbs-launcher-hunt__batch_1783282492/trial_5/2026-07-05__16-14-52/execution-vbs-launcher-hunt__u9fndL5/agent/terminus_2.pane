[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search all events on WS-05.corp.example within the critical window
[?2004l[?2004h> # We'll filter for channel='Security' or EventCode in Security channels
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, service_name, target_object, details, message
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example' 
[?2004l[?2004h>       AND timestamp >= '2026-05-06T00:00:14Z'
[?2004l[?2004h>       AND timestamp <= '2026-05-06T00:00:50Z'
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> rows = [dict(row) for row in cur.fetchall()]
