[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect the specific events we already know
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE event_id IN ('evt-00073', 'evt-00247', 'evt-00259', 'evt-01817', 'evt-01820')")
[?2004l[?2004h> for row in cur.fetchall():
