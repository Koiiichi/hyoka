[?2004hroot@0eb806b2266a:~# cat << 'EOF' > /tmp/hunt_filtered.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> mal_guids = {'{860ba2e3-9f13-5f52-2603-000000000400}', '{860ba2e3-9f13-5f52-2703-000000000400}', '{860ba2e3-9f13-5f52-2803-000000000400}', '{860ba2e3-9f2e-5f52-2a03-000000000400}'}
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT * FROM events")
[?2004l[?2004h> all_events = [dict(row) for row in cur.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> # Filter for event codes that are NOT 7, 10, or 12
[?2004l[?2004h> interesting_codes = {1, 3, 5, 11, 13, 17, 18, 22, 23, 4688, 4624, 4625, 7045}
[?2004l[?2004h> 
[?2004l[?2004h> mal_events = []
[?2004l[?2004h> for ev in all_events:
[?2004l[?2004h>     pguid = ev.get('process_guid')
[?2004l[?2004h>     ppguid = ev.get('parent_process_guid')
[?2004l[?2004h>     
[?2004l[?2004h>     is_mal = False
[?2004l[?2004h>     if pguid in mal_guids or ppguid in mal_guids:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>     else:
[?2004l[?2004h>         msg = ev.get('message') or ''
[?2004l[?2004h>         details = ev.get('details') or ''
[?2004l[?2004h>         for g in mal_guids:
[?2004l[?2004h>             if g in msg or g in details:
[?2004l[?2004h>                 is_mal = True
[?2004l[?2004h>                 break
[?2004l[?2004h>                 
[?2004l[?2004h>     if is_mal and ev['event_code'] in interesting_codes:
[?2004l[?2004h>         mal_events.append(ev)
[?2004l[?2004h> 
[?2004l[?2004h> mal_events.sort(key=lambda x: x.get('timestamp') or '')
[?2004l[?2004h> 
