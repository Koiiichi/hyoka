[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> mal_guids = {
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript.exe
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell.exe
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost.exe
[?2004l[?2004h>     '{860ba2e3-9f2e-5f52-2a03-000000000400}', # whoami.exe
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT * FROM events ORDER BY timestamp")
[?2004l[?2004h> all_events = [dict(row) for row in cur.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> flagged_ids = []
[?2004l[?2004h> 
[?2004l[?2004h> for ev in all_events:
[?2004l[?2004h>     # Only WS-05.corp.example has malicious events
[?2004l[?2004h>     if ev.get('host') != 'WS-05.corp.example':
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     ev_id = ev['event_id']
[?2004l[?2004h>     code = ev['event_code']
[?2004l[?2004h>     guid = ev.get('process_guid')
[?2004l[?2004h>     pguid = ev.get('parent_process_guid')
[?2004l[?2004h>     msg = ev.get('message') or ''
[?2004l[?2004h>     details = ev.get('details') or ''
[?2004l[?2004h>     cl = ev.get('command_line') or ''
[?2004l[?2004h>     img = ev.get('image') or ''
[?2004l[?2004h>     user = ev.get('user') or ''
[?2004l[?2004h>     
[?2004l[?2004h>     is_mal = False
[?2004l[?2004h>     
[?2004l[?2004h>     # Rule 1: User is m.ward
[?2004l[?2004h>     if user in ('m.ward', 'CORP\\m.ward'):
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     # Rule 2: Sysmon ProcessGuid or ParentProcessGuid matches
[?2004l[?2004h>     elif guid in mal_guids or pguid in mal_guids:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     # Rule 3: Message or Details contain malicious GUIDs
[?2004l[?2004h>     elif any(g in msg or g in details for g in mal_guids):
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     # Rule 4: PowerShell Operational or Engine logs
[?2004l[?2004h>     elif code in (4103, 4104, 800, 400, 600, 40961, 40962, 53504):
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     # Rule 5: Security events for malicious command lines or process IDs
[?2004l[?2004h>     elif code == 4688:
[?2004l[?2004h>         if 'launcher.vbs' in cl or 'whoami.exe' in cl or 'powershell.exe' in cl or 'conhost.exe' in cl:
[?2004l[?2004h>             is_mal = True
[?2004l[?2004h>             
[?2004l[?2004h>     elif code == 4689:
[?2004l[?2004h>         if 'wscript.exe' in msg or 'whoami.exe' in msg or 'powershell.exe' in msg or 'conhost.exe' in msg:
[?2004l[?2004h>             is_mal = True
[?2004l[?2004h>             
[?2004l[?2004h>     elif code == 4673:
[?2004l[?2004h>         if 'whoami.exe' in msg or 'whoami.exe' in details:
[?2004l[?2004h>             is_mal = True
[?2004l[?2004h>             
[?2004l[?2004h>     if is_mal:
[?2004l[?2004h>         # Exclude low-level disk access (RawAccessRead) from System process
[?2004l[?2004h>         if code == 9 and img == 'System':
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         flagged_ids.append(ev_id)
[?2004l[?2004h> 
[?2004l[?2004h> # Deduplicate and sort
[?2004l[?2004h> flagged_ids = sorted(list(set(flagged_ids)))
[?2004l[?2004h> 
[?2004l[?2004h> findings_path = '/root/findings.json'
[?2004l[?2004h> with open(findings_path, 'w') as f:
[?2004l[?2004h>     json.dump(flagged_ids, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Successfully wrote {len(flagged_ids)} unique malicious event IDs to {findings_path}.")
[?2004l[?2004h> 
[?2004l[?2004h> # Validation check
