he message\n        elif code == 4689:\n            if \'wscript.exe\' in msg or \'whoami.exe\' in msg or \'powershell.exe\' in msg:\n                # Let\'s verify if the timestamp matches\n                is_mal = True\n\n    # Check 3: PowerShell (4103, 4104, 800, 400) events containing malicious script keywords\n    if not is_mal and code in (4103, 4104, 800, 400):\n        # Since there is only one powershell process on the system, ALL powershell execution events are malicious!\n        is_mal = True\n        \n    # Check 4: Other security logs (e.g. Privilege Use 4673) matching whoami.exe or powershell.exe execution window\n    if not is_mal and code == 4673:\n        # Let\'s see if whoami was running around this exact millisecond (2026-05-06T00:00:44)\n        if \'whoami.exe\' in msg or \'whoami.exe\' in details or (r[\'timestamp\'] >= \'2026-05-06T00:00:44Z\' and r[\'timestamp\'] <= \'2026-05-06T00:00:45Z\'):\n            is_mal = True\n            \n    if is_mal:\n        flagged.append(r)\n\nprint(f"Flagged {len(flagged)} malicious events:")\nfor f in flagged:\n    print(f"{f[\'event_id\']} | {f[\'timestamp\']} | Code={f[\'event_code\']} | Chan={f[\'channel\'][:15]} | Img={f.get(\'image\')} | CL={(f.get(\'command_line\') or \'\')[:50]}")\n\nEOF\npython3 /tmp/mal_events.py > /tmp/flagged_output.txt\nhead -n 50 /tmp/flagged_output.txt\ntail -n 50 /tmp/flagged_output.txt\n'] min_timeout_sec: 1.5 max_timeout_sec: 180.0
