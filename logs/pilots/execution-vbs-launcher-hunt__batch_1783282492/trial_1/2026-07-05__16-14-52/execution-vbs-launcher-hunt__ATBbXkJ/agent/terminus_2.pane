[?2004hroot@0b1af857fd56:~# cat << 'EOF' > /tmp/security_match2.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Map malicious process GUIDs to PIDs
[?2004l[?2004h> cur.execute("SELECT event_id, image, process_guid, message FROM events WHERE event_code = 1")
[?2004l[?2004h> proc_creates = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> malicious_guids = {
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost
[?2004l[?2004h>     '{860ba2e3-9f2e-5f52-2a03-000000000400}'  # whoami
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> pid_to_name = {}
[?2004l[?2004h> for row in proc_creates:
[?2004l[?2004h>     guid = row['process_guid']
[?2004l[?2004h>     if guid in malicious_guids:
[?2004l[?2004h>         msg = row['message']
[?2004l[?2004h>         m = re.search(r'ProcessId:\s*(\d+)', msg)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             pid = int(m.group(1))
[?2004l[?2004h>             pid_to_name[pid] = row['image']
[?2004l[?2004h> 
[?2004l[?2004h> # Also let's find wscript's PID if it's not in Sysmon event 1
[?2004l[?2004h> # Wait, is wscript in Sysmon event 1? Yes, evt-00073 is Event 1 for wscript.
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE channel = 'Security'")
[?2004l[?2004h> sec_events = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> matched_sec_ids = []
[?2004l[?2004h> for ev in sec_events:
[?2004l[?2004h>     msg = str(ev['message']) + " " + str(ev['details'])
[?2004l[?2004h>     matched = False
[?2004l[?2004h>     for pid, name in pid_to_name.items():
[?2004l[?2004h>         hex_pid = f"0x{pid:x}"
[?2004l[?2004h>         # Check if the event message/details mentions this PID
[?2004l[?2004h>         # Usually, process IDs in Security events are represented as Hex (e.g. 0x90c)
[?2004l[?2004h>         # Let's check for hex PID in word boundaries or just in string
[?2004l[?2004h>         # Also creator process ID is in hex
[?2004l[?2004h>         if hex_pid.lower() in msg.lower():
[?2004l[?2004h>             matched = True
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>         # Wait! Is it possible that the PID is in decimal in some fields?
[?2004l[?2004h>         # Security events usually use hex PIDs (e.g., Creator Process ID: 0x90c, New Process ID: 0x1e14).
[?2004l[?2004h>         # So checking hex_pid.lower() in msg.lower() is extremely accurate.
[?2004l[?2004h>         
[?2004l[?2004h>     if matched:
[?2004l[?2004h>         matched_sec_ids.append(ev['event_id'])
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Matched {len(matched_sec_ids)} Security Events:", matched_sec_ids)
[?2004l[?2004h> EOF
