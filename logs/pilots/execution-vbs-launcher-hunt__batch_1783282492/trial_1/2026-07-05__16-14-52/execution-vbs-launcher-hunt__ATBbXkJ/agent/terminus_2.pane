[?2004hroot@0b1af857fd56:~# cat << 'EOF' > /tmp/security_match.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's map process names to their Sysmon event 1 IDs and PIDs
[?2004l[?2004h> cur.execute("SELECT event_id, image, command_line, process_guid, message, details FROM events WHERE event_code = 1")
[?2004l[?2004h> proc_creates = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> malicious_guids = {
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell
[?2004l[?2004h>     '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost
[?2004l[?2004h>     '{860ba2e3-9f2e-5f52-2a03-000000000400}'  # whoami
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> pid_to_name = {}
[?2004l[?2004h> 
[?2004l[?2004h> # Parse PIDs from Sysmon event message
[?2004l[?2004h> # Example Sysmon event 1 message contains:
[?2004l[?2004h> # ProcessId: 2316
[?2004l[?2004h> import re
[?2004l[?2004h> for row in proc_creates:
[?2004l[?2004h>     guid = row['process_guid']
[?2004l[?2004h>     if guid in malicious_guids:
[?2004l[?2004h>         msg = row['message']
[?2004l[?2004h>         m = re.search(r'ProcessId:\s*(\d+)', msg)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             pid = int(m.group(1))
[?2004l[?2004h>             pid_to_name[pid] = row['image']
[?2004l[?2004h> 
[?2004l[?2004h> print("Malicious PIDs:", pid_to_name)
[?2004l[?2004h> 
[?2004l[?2004h> # Now search Security events for these PIDs
[?2004l[?2004h> # Process ID in Security logs can be in hex (e.g., 0x90c) or decimal.
[?2004l[?2004h> # Let's search all events in the Security channel (or channel != 'Sysmon')
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE channel = 'Security'")
[?2004l[?2004h> sec_events = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> matched_sec_events = []
[?2004l[?2004h> for ev in sec_events:
[?2004l[?2004h>     msg = str(ev['message']) + " " + str(ev['details'])
[?2004l[?2004h>     matched = False
[?2004l[?2004h>     for pid, name in pid_to_name.items():
[?2004l[?2004h>         hex_pid = f"0x{pid:x}"
[?2004l[?2004h>         # Look for the PID or hex PID in the security event
[?2004l[?2004h>         # We should be careful about false positives, so let's check for specific patterns like:
[?2004l[?2004h>         # "New Process ID: 0x..." or "Process ID: 0x..." or "Creator Process ID: 0x..."
[?2004l[?2004h>         # Or simply search for the hex_pid or decimal pid in context.
[?2004l[?2004h>         # Let's check if the hex_pid is in the event message/details
[?2004l[?2004h>         if hex_pid.lower() in msg.lower() or str(pid) in msg:
[?2004l[?2004h>             # Let's print out the event code and first 100 chars of message
[?2004l[?2004h>             matched_sec_events.append(ev)
[?2004l[?2004h>             break
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(matched_sec_events)} matching Security events:")
[?2004l[?2004h> for ev in matched_sec_events:
[?2004l[?2004h>     print(f"ID: {ev['event_id']}, Code: {ev['event_code']}, Host: {ev['host']}, Msg: {ev['message'][:100].strip()}")
[?2004l[?2004h> EOF
