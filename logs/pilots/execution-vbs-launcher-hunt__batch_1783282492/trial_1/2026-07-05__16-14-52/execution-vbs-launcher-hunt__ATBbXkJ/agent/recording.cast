[248.551325, "i", "cat << 'EOF' > /tmp/categorize_v2.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events\")\nevents = [dict(r) for r in cur.fetchall()]\n\n# Malicious Process GUIDs\nmalicious_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell\n    '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}'  # whoami\n}\n\n# Malicious PIDs\nmalicious_pids = {2440, 2316, 7700, 9152}\n\n# Let's map event categories\nmatched_events = []\n\nfor ev in events:\n    eid = ev['event_id']\n    ec = ev['event_code']\n    pg = ev['process_guid']\n    ppg = ev['parent_process_guid']\n    msg = str(ev['message']) + \" \" + str(ev['details'])\n    \n    # Check if this event is associated with our malicious processes\n    is_associated = False\n    if pg in malicious_guids or ppg in malicious_guids:\n        is_associated = True\n    else:\n        # Check for hex or decimal PIDs in the message/details\n        for pid in malicious_pids:\n            hex_pid = f\"0x{pid:x}\"\n            if hex_pid.lower() in msg.lower():\n                is_associated = True\n                break\n            # Check for \"Process ID: <decimal>\" or \"Process ID:\t\t<decimal>\"\n            # Using regex to find the decimal PID in the message\n            if re.search(rf'ProcessId:\\s*{pid}\\b', msg, re.IGNORECASE):\n                is_associated = True\n                break\n            if re.search(rf'Process ID:\\s*{pid}\\b', msg, re.IGNORECASE):\n                is_associated = True\n                break\n            if ev['channel'] == 'Sysmon' and f\"ProcessId: {pid}\" in msg:\n                is_associated = True\n                break\n\n    if is_associated:\n        matched_events.append(ev)\n\nprint(f\"Total matched events: {len(matched_events)}\")\nfrom collections import Counter\nec_counts = Counter(ev['event_code'] for ev in matched_events)\nfor ec, count in sorted(ec_counts.items()):\n    print(f\"Event Code {ec}: {count} events\")\nEOF\npython3 /tmp/categorize_v2.py\n"]
