vt-01098', 'evt-01723']\nterm_events = ['evt-00272', 'evt-01858']\nexit_events = ['evt-00340', 'evt-01832']\nprivilege_events = ['evt-00257', 'evt-00341', 'evt-00346', 'evt-00643', 'evt-01819', 'evt-01821']\n\nall_malicious = sorted(list(set(\n    proc_creates + \n    network_events + \n    registry_sets + \n    powershell_ops + \n    pipe_events + \n    file_events + \n    term_events + \n    exit_events + \n    privilege_events\n)))\n\nprint(\"Total events compiled:\", len(all_malicious))\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(all_malicious, f, indent=2)\nEOF\npython3 /tmp/generate_findings2.py\n"]
