[123.961301, "i", "cat << 'EOF' > /tmp/trace.py\nimport sqlite3\nimport json\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's read all events to do processing in Python (it's small, 2000 events total)\ncur.execute(\"SELECT * FROM events\")\nall_events = [dict(r) for r in cur.fetchall()]\n\n# We will track malicious process GUIDs and process IDs\nmalicious_guids = {'{860ba2e3-9f13-5f52-2603-000000000400}'} # wscript\nmalicious_pids = {'2324'} # wscript PID is 2324? Wait, let's find it\n\n# First, let's locate the wscript event to get its PID and GUID\nfor ev in all_events:\n    if ev['event_id'] == 'evt-00073':\n        if ev['process_guid']:\n            malicious_guids.add(ev['process_guid'])\n\n# Find all process creation events to build the process tree\nparent_to_child_guid = {}\nguid_to_info = {}\nfor ev in all_events:\n    # Event 1 (Sysmon process creation)\n    if ev['event_code'] == 1:\n        pguid = ev['process_guid']\n        ppguid = ev['parent_process_guid']\n        guid_to_info[pguid] = ev\n        if ppguid:\n            parent_to_child_guid.setdefault(ppguid, []).append(pguid)\n\n# Recursively find all child GUIDs starting from wscript\ndef get_descendants(guid):\n    desc = []\n    for child in parent_to_child_guid.get(guid, []):\n        desc.append(child)\n        desc.extend(get_descendants(child))\n    return desc\n\nwscript_guid = '{860ba2e3-9f13-5f52-2603-000000000400}'\nmalicious_process_guids = [wscript_guid] + get_descendants(wscript_guid)\nprint(\"Malicious process GUIDs:\", malicious_process_guids)\n\n# Let's map malicious process GUIDs to their PIDs (from Sysmon Event 1 or details)\nmalicious_pids = set()\nfor guid in malicious_process_guids:\n    if guid in guid_to_info:\n        # We can extract PID from message or command line? Wait, we can look up the process creation Event 1\n        # In Event 1, we can find ProcessId if we parse the message. But wait, we can just find any events where process_guid is in malicious_process_guids!\n        pass\n\nEOF\npython3 /tmp/trace.py\n"]
