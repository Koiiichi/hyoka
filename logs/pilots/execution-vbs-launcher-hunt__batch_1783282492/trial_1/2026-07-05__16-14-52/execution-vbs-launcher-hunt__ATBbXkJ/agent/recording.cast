[164.983611, "i", "cat << 'EOF' > /tmp/security_match.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's map process names to their Sysmon event 1 IDs and PIDs\ncur.execute(\"SELECT event_id, image, command_line, process_guid, message, details FROM events WHERE event_code = 1\")\nproc_creates = cur.fetchall()\n\nmalicious_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell\n    '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}'  # whoami\n}\n\npid_to_name = {}\n\n# Parse PIDs from Sysmon event message\n# Example Sysmon event 1 message contains:\n# ProcessId: 2316\nimport re\nfor row in proc_creates:\n    guid = row['process_guid']\n    if guid in malicious_guids:\n        msg = row['message']\n        m = re.search(r'ProcessId:\\s*(\\d+)', msg)\n        if m:\n            pid = int(m.group(1))\n            pid_to_name[pid] = row['image']\n\nprint(\"Malicious PIDs:\", pid_to_name)\n\n# Now search Security events for these PIDs\n# Process ID in Security logs can be in hex (e.g., 0x90c) or decimal.\n# Let's search all events in the Security channel (or channel != 'Sysmon')\ncur.execute(\"SELECT * FROM events WHERE channel = 'Security'\")\nsec_events = cur.fetchall()\n\nmatched_sec_events = []\nfor ev in sec_events:\n    msg = str(ev['message']) + \" \" + str(ev['details'])\n    matched = False\n    for pid, name in pid_to_name.items():\n        hex_pid = f\"0x{pid:x}\"\n        # Look for the PID or hex PID in the security event\n        # We should be careful about false positives, so let's check for specific patterns like:\n        # \"New Process ID: 0x...\" or \"Process ID: 0x...\" or \"Creator Process ID: 0x...\"\n        # Or simply search for the hex_pid or decimal pid in context.\n        # Let's check if the hex_pid is in the event message/details\n        if hex_pid.lower() in msg.lower() or str(pid) in msg:\n            # Let's print out the event code and first 100 chars of message\n            matched_sec_events.append(ev)\n            break\n\nprint(f\"Found {len(matched_sec_events)} matching Security events:\")\nfor ev in matched_sec_events:\n    print(f\"ID: {ev['event_id']}, Code: {ev['event_code']}, Host: {ev['host']}, Msg: {ev['message'][:100].strip()}\")\nEOF\npython3 /tmp/security_match.py\n"]
