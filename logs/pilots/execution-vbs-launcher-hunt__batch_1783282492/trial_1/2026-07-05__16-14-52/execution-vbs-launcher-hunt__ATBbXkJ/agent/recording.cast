[154.658236, "i", "cat << 'EOF' > /tmp/summary.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmalicious_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell\n    '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}'  # whoami\n}\n\ncur.execute(\"SELECT * FROM events\")\nevents = cur.fetchall()\n\ncounts = {}\nfor ev in events:\n    pg = ev['process_guid']\n    ppg = ev['parent_process_guid']\n    ec = ev['event_code']\n    eid = ev['event_id']\n    \n    # check if process_guid or parent_process_guid is malicious\n    is_mal = False\n    if pg in malicious_guids or ppg in malicious_guids:\n        is_mal = True\n    else:\n        # check if message or details mentions any of the malicious guids\n        msg = str(ev['message']) + \" \" + str(ev['details'])\n        for mg in malicious_guids:\n            if mg in msg:\n                is_mal = True\n                break\n                \n    if is_mal:\n        counts[ec] = counts.get(ec, 0) + 1\n\nfor ec, count in sorted(counts.items()):\n    print(f\"Event Code {ec}: {count} events\")\nEOF\npython3 /tmp/summary.py\n"]
[154.659735, "o", "cat << 'EOF' > /tmp/summary.py\r\n\u001b[?2004l\r"]
