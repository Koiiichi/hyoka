[222.186192, "o", "oduct: Microsoft® Windows® Operating System\r\r\nCompany: Microsoft Corporation\r\r\nOriginalFileName: imm32\r\r\nHashes: SHA1=76BB2AB8D3CB6DB6D23F4771334C9AA9C231B03A,MD5=025CC332EDC4B1A38290F3E36BCEF4FB,SHA256=0FE3C1C575EA1B0257B2EB12527EC35E3004CD88EA5BAEC7095386A9F9EB70AD,IMPHASH=24F54B6761C10BA12481CF6C780605BF\r\r\nSigned: true\r\r\nSignature: Microsoft Windows\r\r\nSignatureStatus: Valid\r\nevt-01858|5|2026-05-06T00:00:44.106Z||||Process terminated:\r\r\nRuleName: -\r\r\nUtcTime: 2020-09-04 20:10:22.915\r\r\nProcessGuid: {860ba2e3-9f2e-5f52-2a03-000000000400}\r\r\nProcessId: 9152\r\r\nImage: C:\\Windows\\System32\\whoami.exe\r\n\u001b[?2004hroot@0b1af857fd56:~# "]
[235.613264, "i", "cat << 'EOF' > /tmp/categorize.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events\")\nevents = [dict(r) for r in cur.fetchall()]\n\n# Malicious Process GUIDs\nmalicious_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell\n    '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}'  # whoami\n}\n\n# Malicious PIDs\nmalicious_pids = {2440, 2316, 7700, 9152}\n\n# Let's map event categories\n# We will store events into different lists\nproc_create_sysmon = [] # Event 1\nproc_create_security = [] # Event 4688\nnetwork_sysmon = [] # Event 3\nnetwork_security = [] # Event 5156 / 5158\ndns_sysmon = [] # Event 22\npowershell_script = [] # Event 4104 / 4103\npipe_sysmon = [] # Event 17 / 18\nfile_sysmon = [] # Event 11\nreg_set_sysmon = [] # Event 13\nreg_other_sysmon = [] # Event 12\nproc_term_sysmon = [] # Event 5\nproc_access_sysmon = [] # Event 10\nsecurity_other = [] # Other Security events (4656, 4658, 4663, 4673, 4690, 4689)\n\nfor ev in events:\n    eid = ev['event_id']\n    ec = ev['event_code']\n    pg = ev['process_guid']\n    ppg = ev['parent_process_guid']\n    msg = str(ev['message']) + \" \" + str(ev['details'])\n    \n    # Check if this event is associated with our malicious processes\n    is_associated = False\n    if pg in malicious_guids or ppg in malicious_guids:\n        is_associated = True\n    else:\n        # Check for hex or decimal PIDs in the message/details\n        for pid in malicious_pids:\n            hex_pid = f\"0x{pid:x}\"\n            if hex_pid.lower() in msg.lower():\n                is_associated = True\n                break\n            # Also check if it's Sysmon and matches process ID\n            if ev['channel'] == 'Sysmon' and f\"ProcessId: {pid}\" in msg:\n                is_associated = True\n                break\n\n    if not is_associated:\n        continue\n        \n    # Categorize\n    if ec == 1:\n        proc_create_sysmon.append(eid)\n    elif ec == 4688:\n        proc_create_security.append(eid)\n    elif ec == 3:\n        network_sysmon.append(eid)\n    elif ec in (5156, 5158):\n        network_security.append(eid)\n    elif ec == 22:\n        dns_sysmon.append(eid)\n    elif ec in (4103, 4104):\n        powershell_script.append(eid)\n    elif ec in (17, 18):\n        pipe_sysmon.append(eid)\n    elif ec == 11:\n        file_sysmon.append(eid)\n    elif ec == 13:\n        reg_set_sysmon.append(eid)\n    elif ec == 12:\n        reg_other_sysmon.append(eid)\n    elif ec == 5:\n        proc_term_sysmon.append(eid)\n    elif ec == 10:\n        proc_access_sysmon.append(eid)\n    elif ev['channel'] == 'Security':\n        security_other.append(eid)\n\nprint(f\"Process Create Sysmon (1): {proc_create_sysmon}\")\nprint(f\"Process Create Security (4688): {proc_create_security}\")\nprint(f\"Network Sysmon (3): {network_sysmon}\")\nprint(f\"Network Security (5156/5158): {network_security}\")\nprint(f\"DNS Sysmon (22): {dns_sysmon}\")\nprint(f\"PowerShell Script (4103/4104): {powershell_script}\")\nprint(f\"Pipe Sysmon (17/18): {pipe_sysmon}\")\nprint(f\"File Sysmon (11): {file_sysmon}\")\nprint(f\"Registry Set Sysmon (13): {reg_set_sysmon}\")\nprint(f\"Registry Other Sysmon (12): {len(reg_other_sysmon)} events\")\nprint(f\"Process Term Sysmon (5): {proc_term_sysmon}\")\nprint(f\"Process Access Sysmon (10): {len(proc_access_sysmon)} events\")\nprint(f\"Security Other: {len(security_other)} events\")\nEOF\npython3 /tmp/categorize.py\n"]
