[174.258507, "i", "cat << 'EOF' > /tmp/security_match2.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Map malicious process GUIDs to PIDs\ncur.execute(\"SELECT event_id, image, process_guid, message FROM events WHERE event_code = 1\")\nproc_creates = cur.fetchall()\n\nmalicious_guids = {\n    '{860ba2e3-9f13-5f52-2603-000000000400}', # wscript\n    '{860ba2e3-9f13-5f52-2703-000000000400}', # powershell\n    '{860ba2e3-9f13-5f52-2803-000000000400}', # conhost\n    '{860ba2e3-9f2e-5f52-2a03-000000000400}'  # whoami\n}\n\npid_to_name = {}\nfor row in proc_creates:\n    guid = row['process_guid']\n    if guid in malicious_guids:\n        msg = row['message']\n        m = re.search(r'ProcessId:\\s*(\\d+)', msg)\n        if m:\n            pid = int(m.group(1))\n            pid_to_name[pid] = row['image']\n\n# Also let's find wscript's PID if it's not in Sysmon event 1\n# Wait, is wscript in Sysmon event 1? Yes, evt-00073 is Event 1 for wscript.\n\ncur.execute(\"SELECT * FROM events WHERE channel = 'Security'\")\nsec_events = cur.fetchall()\n\nmatched_sec_ids = []\nfor ev in sec_events:\n    msg = str(ev['message']) + \" \" + str(ev['details'])\n    matched = False\n    for pid, name in pid_to_name.items():\n        hex_pid = f\"0x{pid:x}\"\n        # Check if the event message/details mentions this PID\n        # Usually, process IDs in Security events are represented as Hex (e.g. 0x90c)\n        # Let's check for hex PID in word boundaries or just in string\n        # Also creator process ID is in hex\n        if hex_pid.lower() in msg.lower():\n            matched = True\n            break\n            \n        # Wait! Is it possible that the PID is in decimal in some fields?\n        # Security events usually use hex PIDs (e.g., Creator Process ID: 0x90c, New Process ID: 0x1e14).\n        # So checking hex_pid.lower() in msg.lower() is extremely accurate.\n        \n    if matched:\n        matched_sec_ids.append(ev['event_id'])\n\nprint(f\"Matched {len(matched_sec_ids)} Security Events:\", matched_sec_ids)\nEOF\npython3 /tmp/security_match2.py\n"]
[174.259286, "o", "cat << 'EOF' > /tmp/security_match2.py\r\n\u001b[?2004l\r"]
