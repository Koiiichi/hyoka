[319.651011, "i", "cat << 'EOF' > /tmp/generate_findings.py\nimport json\n\n# Let's collect the event IDs we discussed:\n\n# 1. Process Creates (Sysmon 1 and Security 4688)\nproc_creates = [\n    'evt-00073', 'evt-00247', # wscript\n    'evt-00259', 'evt-00328', # powershell\n    'evt-00289', 'evt-00343', # conhost\n    'evt-01820', 'evt-01817'  # whoami\n]\n\n# 2. Network and WFP (Sysmon 3, 22, Security 5156, 5158)\nnetwork_events = [\n    'evt-01478', # Sysmon 3 connection to 10.10.10.5\n    'evt-01651', # Sysmon 22 DNS query localhost\n    'evt-01410', # Security 5156 permit to 10.10.10.5\n    'evt-01409'  # Security 5158 bind\n]\n\n# 3. Registry modification (Sysmon 13) by wscript.exe\nregistry_sets = [\n    'evt-00234', 'evt-00235', 'evt-00236', 'evt-00237', \n    'evt-00238', 'evt-00239', 'evt-00240', 'evt-00241', \n    'evt-00265'\n]\n\n# 4. PowerShell operational logs (4103, 4104) on WS-05\npowershell_ops = [\n    'evt-00918', 'evt-01252', 'evt-01326', 'evt-01371', 'evt-01373', 'evt-01412', \n    'evt-01413', 'evt-01414', 'evt-01415', 'evt-01417', 'evt-01419', 'evt-01421', \n    'evt-01423', 'evt-01445', 'evt-01505', 'evt-01507', 'evt-01510', 'evt-01599', \n    'evt-01645', 'evt-01646', 'evt-01647', 'evt-01648', 'evt-01665', 'evt-01668', \n    'evt-01670', 'evt-01672', 'evt-01675', 'evt-01676', 'evt-01712', 'evt-01714', \n    'evt-01716', 'evt-01718', 'evt-01720', 'evt-01721', 'evt-01736', 'evt-01738', \n    'evt-01740', 'evt-01742', 'evt-01757', 'evt-01758', 'evt-01772', 'evt-01774', \n    'evt-01776', 'evt-01778', 'evt-01782', 'evt-01784', 'evt-01789', 'evt-01790', \n    'evt-01796', 'evt-01798', 'evt-01800', 'evt-01802', 'evt-01804', 'evt-01807', \n    'evt-01809', 'evt-01810', 'evt-01812', 'evt-01813', 'evt-01814', 'evt-01815', \n    'evt-01871', 'evt-01874', 'evt-01876', 'evt-01878', 'evt-01887', 'evt-01888', \n    'evt-01904', 'evt-01906', 'evt-01908', 'evt-01910', 'evt-01959', 'evt-01960', \n    'evt-01979', 'evt-01981', 'evt-01983', 'evt-01985', 'evt-01988', 'evt-01990', \n    'evt-02018', 'evt-02020', 'evt-02022', 'evt-02024', 'evt-02030', 'evt-02031', \n    'evt-02060', 'evt-02061', 'evt-02064', 'evt-02065'\n]\n\n# 5. Pipe Events (Sysmon 17, 18) by powershell\npipe_events = ['evt-01107', 'evt-01816', 'evt-01818']\n\n# 6. File Creations (Sysmon 11) by powershell\nfile_events = ['evt-01022', 'evt-01023', 'evt-01098', 'evt-01723']\n\n# 7. Process Terminations (Sysmon 5)\nterm_events = ['evt-00272', 'evt-01858']\n\n# Combine all into a single list of distinct IDs\nall_malicious = sorted(list(set(\n    proc_creates + \n    network_events + \n    registry_sets + \n    powershell_ops + \n    pipe_events + \n    file_events + \n    term_events\n)))\n\nprint(\"Total events compiled:\", len(all_malicious))\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(all_malicious, f, indent=2)\nEOF\npython3 /tmp/generate_findings.py\n"]
