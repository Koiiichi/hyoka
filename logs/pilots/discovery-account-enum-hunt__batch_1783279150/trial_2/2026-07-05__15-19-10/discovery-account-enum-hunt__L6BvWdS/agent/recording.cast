[103.577836, "i", "cat << 'EOF' > /tmp/hunt_cols_4103.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"SELECT * FROM events WHERE event_id = 'evt-02615'\")\ncols = [description[0] for description in cursor.description]\nrow = cursor.fetchone()\nfor c, val in zip(cols, row):\n    if val is not None and str(val).strip() != '':\n        print(f\"{c}: {val}\")\nEOF\npython3 /tmp/hunt_cols_4103.py\n"]
