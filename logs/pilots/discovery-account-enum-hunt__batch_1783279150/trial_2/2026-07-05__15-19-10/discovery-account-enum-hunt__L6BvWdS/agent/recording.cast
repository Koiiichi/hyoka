[86.290088, "i", "cat << 'EOF' > /tmp/hunt_ps.py\nimport sqlite3, re\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Group event 800 by HostApplication/command\ncursor.execute(\"SELECT message, COUNT(*) FROM events WHERE event_code = 800 GROUP BY message\")\nprint(\"Event 800 unique messages:\")\nfor msg, count in cursor.fetchall():\n    # extract HostApplication line\n    ha = [line for line in (msg or '').split('\\n') if 'HostApplication=' in line]\n    ha_str = ha[0].strip() if ha else msg[:100]\n    print(f\"  Count: {count} | {ha_str[:150]}\")\n\nEOF\npython3 /tmp/hunt_ps.py\n"]
