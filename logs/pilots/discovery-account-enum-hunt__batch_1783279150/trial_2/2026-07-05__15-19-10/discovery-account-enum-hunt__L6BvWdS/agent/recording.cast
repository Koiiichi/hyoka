[168.66277, "i", "cat << 'EOF' > /tmp/hunt_net.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Get all network events\ncursor.execute(\"\"\"SELECT event_id, timestamp, host, event_code, src_ip, dst_ip, dst_port, image, message \n                  FROM events \n                  WHERE event_code IN (3, 5156, 5158) \n                  ORDER BY timestamp\"\"\")\nrows = cursor.fetchall()\nprint(f\"Network events total: {len(rows)}\")\nfor r in rows:\n    # Filter to internal corp traffic to keep it clean, or let's print all to see any C2\n    print(f\"{r[0]} | {r[1]} | Host: {r[2]} | Code: {r[3]} | Src: {r[4]} | Dst: {r[5]} | Port: {r[6]} | Image: {r[7]}\")\n\nEOF\npython3 /tmp/hunt_net.py\n"]
[168.663124, "o", "cat << 'EOF' > /tmp/hunt_net.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
