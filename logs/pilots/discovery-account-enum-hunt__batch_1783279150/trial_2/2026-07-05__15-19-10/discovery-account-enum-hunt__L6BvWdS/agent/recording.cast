[16.510809, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3, base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Find PowerShell command lines\ncursor.execute(\"SELECT event_id, timestamp, host, user, command_line, message FROM events WHERE command_line LIKE '%powershell%' OR message LIKE '%powershell%' OR command_line LIKE '%-enc%' OR message LIKE '%-enc%'\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} potential PowerShell events\")\nfor row in rows[:20]:\n    print(row[0], row[1], row[2], row[3], (row[4] or '')[:100])\n\nEOF\npython3 /tmp/hunt.py\n"]
[16.511045, "o", "cat << 'EOF' > /tmp/hunt.py\r\n\u001b[?2004l\r"]
