[21.661932, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3, re, base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's search for base64 encoded strings in the messages/command lines\n# Also let's look for event codes like 1 (Process creation), 4688 (Process creation), 3 (Network connection), 11 (File creation), etc.\n\nprint(\"--- Process Creation Events (1, 4688) ---\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, event_code, image, command_line, message FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp\")\nfor row in cursor.fetchall():\n    print(f\"{row[0]} | {row[1]} | {row[2]} | {row[3]} | {row[4]} | {row[5]} | {row[6]}\")\n\nEOF\npython3 /tmp/hunt.py\n"]
