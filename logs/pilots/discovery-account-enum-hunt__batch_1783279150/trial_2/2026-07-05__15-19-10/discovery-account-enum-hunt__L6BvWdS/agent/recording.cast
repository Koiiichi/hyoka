[96.609879, "i", "cat << 'EOF' > /tmp/hunt_ps3.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, message FROM events WHERE event_code = 4103\")\nother = 0\nenc = 0\nfor r_id, msg in cursor.fetchall():\n    msg_lower = (msg or '').lower()\n    if '-enc' in msg_lower or '-encodedcommand' in msg_lower:\n        enc += 1\n    else:\n        other += 1\n        print(f\"Non-encoded 4103 Event: {r_id}\")\n        print((msg or '')[:300])\n        print(\"-\"*40)\n\nprint(f\"4103 Encoded: {enc}, Other: {other}\")\nEOF\npython3 /tmp/hunt_ps3.py\n"]
