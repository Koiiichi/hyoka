[75.30014, "i", "cat << 'EOF' > /tmp/hunt_cols.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"SELECT * FROM events WHERE event_code = 11\")\ncols = [description[0] for description in cursor.description]\nrows = cursor.fetchall()\nfor row in rows:\n    print(f\"Event: {row[0]} | host: {row[5]}\")\n    for c, val in zip(cols, row):\n        if val is not None and str(val).strip() != '' and c not in ('event_id', 'event_code', 'channel', 'provider', 'host'):\n            print(f\"  {c}: {val}\")\nEOF\npython3 /tmp/hunt_cols.py\n"]
