[47.203539, "i", "cat << 'EOF' > /tmp/hunt_general.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Distinct hosts\ncursor.execute(\"SELECT host, COUNT(*) FROM events GROUP BY host\")\nprint(\"Hosts:\")\nfor h in cursor.fetchall():\n    print(f\"  {h[0]}: {h[1]}\")\n\n# Distinct users\ncursor.execute(\"SELECT DISTINCT user FROM events WHERE user IS NOT NULL AND user != ''\")\nprint(\"Users:\")\nfor u in cursor.fetchall():\n    print(f\"  {u[0]}\")\n\n# Event codes per host\ncursor.execute(\"SELECT host, event_code, COUNT(*) FROM events GROUP BY host, event_code ORDER BY host, count(*) DESC\")\nprint(\"Event codes per host:\")\nfor r in cursor.fetchall()[:30]:\n    print(f\"  Host: {r[0]} | Code: {r[1]} | Count: {r[2]}\")\n\nEOF\npython3 /tmp/hunt_general.py\n"]
[47.203888, "o", "cat << 'EOF' > /tmp/hunt_general.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.204006, "o", "conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Distinct hosts\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.204302, "o", "cursor.execute(\"SELECT host, COUNT(*) FROM events GROUP BY host\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Hosts:\")\r\n\u001b[?2004l\r\u001b[?2004h> for h in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  {h[0]}: {h[1]}\")\r\n\u001b[?2004l\r"]
[47.204334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Distinct users\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT DISTINCT user FROM events WHERE user IS NOT NULL AND user != ''\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Users:\")\r\n\u001b[?2004l\r\u001b[?2004h> for u in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  {u[0]}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.204742, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.204866, "o", "# Event codes per host\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.205102, "o", "cursor.execute(\"SELECT host, event_code, COUNT(*) FROM events GROUP BY host, event_code ORDER BY host, count(*) DESC\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.20519, "o", "print(\"Event codes per host:\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall()[:30]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.205398, "o", "    print(f\"  Host: {r[0]} | Code: {r[1]} | Count: {r[2]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
