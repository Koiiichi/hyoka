[86.308193, "o", "\u001b[?2004hroot@7315b3566e2a:~# "]
[91.729024, "i", "cat << 'EOF' > /tmp/hunt_ps2.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, message FROM events WHERE event_code = 800\")\nother = 0\nenc = 0\nfor r_id, msg in cursor.fetchall():\n    if '-enc' in msg or '-encodedcommand' in msg.lower():\n        enc += 1\n    else:\n        other += 1\n        print(f\"Non-encoded PS Event: {r_id}\")\n        print(msg[:300])\n        print(\"-\"*40)\n\nprint(f\"Encoded: {enc}, Other: {other}\")\nEOF\npython3 /tmp/hunt_ps2.py\n"]
[91.729376, "o", "cat << 'EOF' > /tmp/hunt_ps2.py\r\n\u001b[?2004l\r\u001b[?2004h"]
