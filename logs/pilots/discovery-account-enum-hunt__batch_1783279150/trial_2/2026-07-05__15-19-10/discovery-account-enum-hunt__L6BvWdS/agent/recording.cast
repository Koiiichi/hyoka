[27.759892, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3, re, base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's search for messages containing '-enc'\ncursor.execute(\"SELECT event_id, timestamp, host, event_code, message FROM events WHERE message LIKE '%-enc%' OR details LIKE '%-enc%' OR command_line LIKE '%-enc%'\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} events with '-enc'\")\nfor r in rows:\n    print(f\"EventID: {r[0]} | Time: {r[1]} | Host: {r[2]} | Code: {r[3]}\")\n    # Try to find base64 string in message\n    match = re.search(r'-enc\\s+([A-Za-z0-9+/=]+)', r[4] or '')\n    if match:\n        encoded = match.group(1)\n        try:\n            decoded = base64.b64decode(encoded).decode('utf-16le', errors='ignore')\n            print(f\"Decoded: {decoded[:300]}...\")\n        except Exception as e:\n            print(f\"Error decoding: {e}\")\n    else:\n        print(\"No base64 match in message\")\n\nEOF\npython3 /tmp/hunt.py\n"]
