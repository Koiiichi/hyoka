[263.935036, "i", "cat << 'EOF' > /tmp/check_sec_ws5.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"SELECT event_id, event_code, message \n                  FROM events \n                  WHERE host = 'WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4689, 4690, 4799)\"\"\")\nrows = cursor.fetchall()\nprint(f\"Total: {len(rows)}\")\nfor r_id, code, msg in rows:\n    msg_lower = (msg or '').lower()\n    is_mal = False\n    for pattern in ('net.exe', 'net1.exe', 'm.ward', 'administrators'):\n        if pattern in msg_lower:\n            is_mal = True\n            break\n    print(f\"EventID: {r_id} | Code: {code} | Suspected Malicious: {is_mal}\")\n    if not is_mal:\n        print(\"  BENIGN MESSAGE SAMPLE:\", msg_lower[:200])\n\nEOF\npython3 /tmp/check_sec_ws5.py\n"]
