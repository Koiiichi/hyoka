[110.704101, "i", "cat << 'EOF' > /tmp/hunt_access.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"SELECT event_id, timestamp, host, user, image, target_image, granted_access, details, message \n                  FROM events \n                  WHERE event_code = 10 AND host = 'WS-06.corp.example'\"\"\")\nrows = cursor.fetchall()\nprint(f\"WS-06 Event 10 total: {len(rows)}\")\n# Group by source image and target image and granted access\nstats = {}\nfor r in rows:\n    key = (r[4], r[5], r[6])\n    stats[key] = stats.get(key, 0) + 1\n\nfor key, count in sorted(stats.items(), key=lambda x: x[1], reverse=True):\n    print(f\"  Source: {key[0]} | Target: {key[1]} | Access: {key[2]} | Count: {count}\")\n\nEOF\npython3 /tmp/hunt_access.py\n"]
