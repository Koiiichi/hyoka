[34.56638, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3, re, base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's pull the full HostApplication or message from one of the events\ncursor.execute(\"SELECT event_id, message FROM events WHERE event_id = 'evt-02656'\")\nmsg = cursor.fetchone()[1]\n\n# Find the full base64 string. In event 800 (Pipeline execution), it's in HostApplication.\n# Let's search for HostApplication in the message\nfor line in msg.split('\\n'):\n    if 'HostApplication' in line:\n        print(\"Found HostApplication line:\", line)\n        m = re.search(r'-enc\\s+([^\\s]+)', line)\n        if m:\n            b64_str = m.group(1)\n            print(\"Base64 String:\", b64_str)\n            # Fix padding\n            b64_str += '=' * ((4 - len(b64_str) % 4) % 4)\n            try:\n                dec = base64.b64decode(b64_str).decode('utf-16le')\n                print(\"FULL DECODED:\")\n                print(dec)\n            except Exception as e:\n                print(\"Decode error:\", e)\nEOF\npython3 /tmp/hunt.py\n"]
