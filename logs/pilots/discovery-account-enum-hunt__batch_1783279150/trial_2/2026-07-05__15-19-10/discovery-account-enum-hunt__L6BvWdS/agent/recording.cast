[223.561064, "i", "cat << 'EOF' > /tmp/check_images.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"SELECT event_id, timestamp, image, details, message \n                  FROM events \n                  WHERE event_code = 7 AND host = 'WS-05.corp.example'\"\"\")\nrows = cursor.fetchall()\nprint(f\"WS-05 Sysmon 7 total: {len(rows)}\")\nstats = {}\nfor r in rows:\n    # let's look at image and find the parent or loading process\n    stats[r[2]] = stats.get(r[2], []) + [r[0]]\n\nfor img, evts in stats.items():\n    print(f\"  Image: {img} | Count: {len(evts)} | EventIDs: {evts[:5]}...\")\n\nEOF\npython3 /tmp/check_images.py\n"]
