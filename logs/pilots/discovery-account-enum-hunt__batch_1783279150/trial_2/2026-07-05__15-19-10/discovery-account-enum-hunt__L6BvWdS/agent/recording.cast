[124.49938, "i", "cat << 'EOF' > /tmp/hunt_reg.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"SELECT event_id, timestamp, host, event_code, image, target_object, details \n                  FROM events \n                  WHERE host = 'WS-05.corp.example' AND event_code IN (12, 13) \n                  ORDER BY timestamp\"\"\")\nrows = cursor.fetchall()\nprint(f\"WS-05 Registry events: {len(rows)}\")\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | Code: {r[3]} | Image: {r[4]} | Target: {r[5]} | Details: {r[6]}\")\n\nEOF\npython3 /tmp/hunt_reg.py\n"]
