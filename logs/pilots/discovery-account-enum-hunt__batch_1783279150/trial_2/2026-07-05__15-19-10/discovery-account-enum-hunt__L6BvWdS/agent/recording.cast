unt Domain:\t\tCORP\r\r\n\tLogon ID:\t\t0x697C9CB\r\r\n\r\r\nLogon Type:\t\t\t3\r\r\n\r\r\nThis event is generated when a logon session is destroyed. It may be positively correlated with a logon event using the Logon ID value. Logon IDs are only unique between reboots on the same computer.\r\n\u001b[?2004hroot@7315b3566e2a:~# "]
[203.647811, "i", "cat << 'EOF' > /tmp/summarize.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's see what is in the events table\ncursor.execute(\"SELECT host, event_code, COUNT(*) FROM events GROUP BY host, event_code ORDER BY host, event_code\")\nfor row in cursor.fetchall():\n    print(f\"Host: {row[0]} | Code: {row[1]} | Count: {row[2]}\")\n\nEOF\npython3 /tmp/summarize.py\n"]
[203.648253, "o", "cat << 'EOF' > /tmp/summarize.py\r\n\u001b[?2004l\r"]
