[217.837567, "i", "cat << 'EOF' > /tmp/check_ps_hosts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Extract HostId or other context details from messages\ncursor.execute(\"SELECT event_id, event_code, message FROM events WHERE event_code IN (800, 4103)\")\nrows = cursor.fetchall()\nprint(f\"Total PowerShell events: {len(rows)}\")\nhost_ids = set()\nfor r_id, code, msg in rows:\n    if not msg:\n        continue\n    for line in msg.split('\\n'):\n        if 'HostId=' in line or 'Host ID:' in line:\n            host_ids.add(line.strip())\nprint(\"Unique Host IDs found:\")\nfor h in host_ids:\n    print(\" \", h)\nEOF\npython3 /tmp/check_ps_hosts.py\n"]
[217.837844, "o", "cat << 'EOF' > /tmp/check_ps_hosts.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
