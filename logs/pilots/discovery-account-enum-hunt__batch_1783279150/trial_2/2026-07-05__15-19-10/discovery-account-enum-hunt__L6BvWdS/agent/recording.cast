[131.00233, "i", "cat << 'EOF' > /tmp/hunt_reg_ws6.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"SELECT event_id, timestamp, host, event_code, image, target_object, details \n                  FROM events \n                  WHERE host = 'WS-06.corp.example' AND event_code IN (12, 13) \n                  ORDER BY timestamp\"\"\")\nrows = cursor.fetchall()\nprint(f\"WS-06 Registry events: {len(rows)}\")\nfor r in rows:\n    # let's only print things that are NOT standard time or internet settings if we want, or just print them all\n    target = r[5] or ''\n    if 'HKLM\\\\System\\\\CurrentControlSet\\\\Services\\\\W32Time' in target or 'Internet Settings' in target:\n        continue\n    print(f\"{r[0]} | {r[1]} | Code: {r[3]} | Image: {r[4]} | Target: {r[5]} | Details: {r[6]}\")\n\nEOF\npython3 /tmp/hunt_reg_ws6.py\n"]
