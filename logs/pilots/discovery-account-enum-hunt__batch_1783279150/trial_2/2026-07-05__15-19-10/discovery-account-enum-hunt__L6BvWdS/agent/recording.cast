[232.398972, "i", "cat << 'EOF' > /tmp/check_reg_ws5.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"SELECT event_id, event_code, image, target_object \n                  FROM events \n                  WHERE host = 'WS-05.corp.example' AND event_code IN (12, 13)\"\"\")\nrows = cursor.fetchall()\nstats = {}\nfor r_id, code, img, tgt in rows:\n    stats[img] = stats.get(img, []) + [r_id]\n\nfor img, evts in stats.items():\n    print(f\"Image: {img} | Count: {len(evts)} | EventIDs: {evts[:10]}...\")\n\nEOF\npython3 /tmp/check_reg_ws5.py\n"]
