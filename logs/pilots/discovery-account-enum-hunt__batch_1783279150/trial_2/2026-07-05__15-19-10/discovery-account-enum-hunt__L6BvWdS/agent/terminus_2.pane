[?2004l[?2004h> import sqlite3, re, base64
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search for messages containing '-enc'
[?2004l[?2004h> cursor.execute("SELECT event_id, timestamp, host, event_code, message FROM events WHERE message LIKE '%-enc%' OR details LIKE '%-enc%' OR command_line LIKE '%-enc%'")
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} events with '-enc'")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     print(f"EventID: {r[0]} | Time: {r[1]} | Host: {r[2]} | Code: {r[3]}")
[?2004l[?2004h>     # Try to find base64 string in message
[?2004l[?2004h>     match = re.search(r'-enc\s+([A-Za-z0-9+/=]+)', r[4] or '')
[?2004l[?2004h>     if match:
[?2004l[?2004h>         encoded = match.group(1)
[?2004l[?2004h>         try:
[?2004l[?2004h>             decoded = base64.b64decode(encoded).decode('utf-16le', errors='ignore')
[?2004l[?2004h>             print(f"Decoded: {decoded[:300]}...")
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print(f"Error decoding: {e}")
[?2004l[?2004h>     else:
[?2004l[?2004h>         print("No base64 match in message")
[?2004l[?2004h> 
