[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Total PowerShell events: {len(rows)}")
[?2004l[?2004h> host_ids = set()
[?2004l[?2004h> for r_id, code, msg in rows:
[?2004l[?2004h>     if not msg:
[?2004l[?2004h>         continue
[?2004l[?2004h>     for line in msg.split('\n'):
[?2004l[?2004h>         if 'HostId=' in line or 'Host ID:' in line:
[?2004l[?2004h>             host_ids.add(line.strip())
[?2004l[?2004h> print("Unique Host IDs found:")
