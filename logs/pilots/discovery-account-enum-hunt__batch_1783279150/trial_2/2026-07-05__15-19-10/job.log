Sending keys: ['cat << \'EOF\' > /tmp/collect_malicious.py\nimport sqlite3\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncursor = conn.cursor()\n\nmalicious_ids = set()\n\n# 1. PowerShell 800 and 4103\ncursor.execute("SELECT event_id FROM events WHERE host = \'WS-05.corp.example\' AND event_code IN (800, 4103)")\nfor r in cursor.fetchall():\n    malicious_ids.add(r[0])\n\n# 2. Process Create (1, 4688) and Terminate (5)\ncursor.execute("SELECT event_id FROM events WHERE host = \'WS-05.corp.example\' AND event_code IN (1, 4688) AND (command_line LIKE \'%net.exe%\' OR command_line LIKE \'%net1%\' OR image LIKE \'%net.exe\' OR image LIKE \'%net1.exe\')")\nfor r in cursor.fetchall():\n    malicious_ids.add(r[0])\ncursor.execute("SELECT event_id FROM events WHERE host = \'WS-05.corp.example\' AND event_code = 5 AND (image LIKE \'%net.exe\' OR image LIKE \'%net1.exe\')")\nfor r in cursor.fetchall():\n    malicious_ids.add(r[0])\n\n# 3. Pipes (17, 18) by powershell or net1\ncursor.execute("SELECT event_id FROM events WHERE host = \'WS-05.corp.example\' AND event_code IN (17, 18) AND (image LIKE \'%powershell.exe\' OR image LIKE \'%net1.exe\')")\nfor r in cursor.fetchall():\n    malicious_ids.add(r[0])\n\n# 4. ProcessAccess (10) where image is powershell, net, net1, csrss, conhost, lsass targeting net/net1\ncursor.execute("""SELECT event_id FROM events \n                  WHERE host = \'WS-05.corp.example\' AND event_code = 10 \n                  AND image != \'C:\\\\windows\\\\system32\\\\svchost.exe\'""")\nfor r in cursor.fetchall():\n    malicious_ids.add(r[0])\n\n# 5. ImageLoaded (7) loaded by net.exe or net1.exe\ncursor.execute("SELECT event_id FROM events WHERE host = \'WS-05.corp.example\' AND event_code = 7 AND (image LIKE \'%net.exe\' OR image LIKE \'%net1.exe\')")\nfor r in cursor.fetchall():\n    malicious_ids.add(r[0])\n\n# 6. Registry (12, 13) by powershell\ncursor.execute("SELECT event_id FROM events WHERE host = \'WS-05.corp.example\' AND event_code IN (12, 13) AND image LIKE \'%powershell.exe\'")\nfor r in cursor.fetchall():\n    malicious_ids.add(r[0])\n\n# 7. Security audit events (4656, 4658, 4663, 4689, 4690, 4799) on WS-05 associated with net/net1\n# We already verified that all 25 events are indeed malicious\ncursor.execute("""SELECT event_id FROM events \n                  WHERE host = \'WS-05.corp.example\' AND event_code IN (4656, 4658, 4663, 4689, 4690, 4799)""")\nfor r in cursor.fetchall():\n    malicious_ids.add(r[0])\n\nprint(f"Collected {len(malicious_ids)} malicious event IDs")\nEOF\npython3 /tmp/collect_malicious.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
