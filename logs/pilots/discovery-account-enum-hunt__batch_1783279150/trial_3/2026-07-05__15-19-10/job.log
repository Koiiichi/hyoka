Sending keys: ['cat << \'EOF\' > /tmp/diff.py\nimport sqlite3\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncursor = conn.cursor()\n\n# Malicious set\nmal_ids = set()\n\n# 1. PowerShell\ncursor.execute("SELECT event_id FROM events WHERE event_code IN (800, 4103)")\nmal_ids.update(r[0] for r in cursor.fetchall())\n\n# 2. process_guid of malicious powershell\ncursor.execute("SELECT event_id FROM events WHERE process_guid=\'{b34bc01c-2f95-5f69-5f01-000000000900}\'")\nmal_ids.update(r[0] for r in cursor.fetchall())\n\n# 3. m.ward on WS-05\ncursor.execute("SELECT event_id FROM events WHERE host=\'WS-05.corp.example\' AND (user LIKE \'%m.ward%\' OR target_user LIKE \'%m.ward%\')")\nmal_ids.update(r[0] for r in cursor.fetchall())\n\n# 4. net/net1 terminate\ncursor.execute("SELECT event_id FROM events WHERE host=\'WS-05.corp.example\' AND event_code=5 AND (image LIKE \'%net.exe\' OR image LIKE \'%net1.exe\')")\nmal_ids.update(r[0] for r in cursor.fetchall())\n\n# 5. pipe of net1\ncursor.execute("SELECT event_id FROM events WHERE host=\'WS-05.corp.example\' AND event_code IN (17, 18) AND image LIKE \'%net1.exe\'")\nmal_ids.update(r[0] for r in cursor.fetchall())\n\n# 6. net to net1 ProcessAccess\ncursor.execute("SELECT event_id FROM events WHERE event_code=10 AND image LIKE \'%net.exe\' AND target_image LIKE \'%net1.exe\'")\nmal_ids.update(r[0] for r in cursor.fetchall())\n\n# Now search ALL events for any reference to m.ward, powershell.exe, net.exe, net1.exe\ncursor.execute("""\nSELECT event_id, event_code, host, user, image, target_image, parent_image, command_line, message\nFROM events\n""")\ncols = [d[0] for d in cursor.description]\nfor row in cursor.fetchall():\n    d = dict(zip(cols, row))\n    eid = d[\'event_id\']\n    if eid in mal_ids:\n        continue\n    \n    text = " ".join(str(v) for v in d.values() if v is not None).lower()\n    if any(term in text for term in [\'m.ward\', \'powershell\', \'net.exe\', \'net1.exe\']):\n        print(f"Potential missed event: {eid} | {d[\'event_code\']} | {d[\'host\']} | {d[\'user\']} | {d[\'image\']} | {d[\'target_image\']} | {d[\'parent_image\']} | {d[\'command_line\']}")\n\nEOF\npython3 /tmp/diff.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
