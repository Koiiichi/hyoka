Sending keys: ['cat << \'EOF\' > /tmp/collect.py\nimport sqlite3\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncursor = conn.cursor()\n\n# Let\'s list candidate event IDs\nmalicious_ids = set()\n\n# 1. All 800 and 4103 events on WS-05\ncursor.execute("SELECT event_id FROM events WHERE event_code IN (800, 4103)")\nfor (eid,) in cursor.fetchall():\n    malicious_ids.add(eid)\n\n# 2. All events where process_guid is the malicious powershell\ncursor.execute("SELECT event_id FROM events WHERE process_guid=\'{b34bc01c-2f95-5f69-5f01-000000000900}\'")\nfor (eid,) in cursor.fetchall():\n    malicious_ids.add(eid)\n\n# 3. All events run under user m.ward on WS-05\ncursor.execute("SELECT event_id FROM events WHERE host=\'WS-05.corp.example\' AND (user LIKE \'%m.ward%\' OR target_user LIKE \'%m.ward%\')")\nfor (eid,) in cursor.fetchall():\n    malicious_ids.add(eid)\n\n# 4. Terminate events of net.exe and net1.exe on WS-05\ncursor.execute("SELECT event_id FROM events WHERE host=\'WS-05.corp.example\' AND event_code=5 AND (image LIKE \'%net.exe\' OR image LIKE \'%net1.exe\')")\nfor (eid,) in cursor.fetchall():\n    malicious_ids.add(eid)\n\n# 5. Pipe events of net1.exe\ncursor.execute("SELECT event_id FROM events WHERE host=\'WS-05.corp.example\' AND event_code IN (17, 18) AND image LIKE \'%net1.exe\'")\nfor (eid,) in cursor.fetchall():\n    malicious_ids.add(eid)\n\n# 6. ProcessAccess where net.exe calls net1.exe\ncursor.execute("SELECT event_id FROM events WHERE event_code=10 AND image LIKE \'%net.exe\' AND target_image LIKE \'%net1.exe\'")\nfor (eid,) in cursor.fetchall():\n    malicious_ids.add(eid)\n\nprint(f"Total malicious events collected so far: {len(malicious_ids)}")\nprint(sorted(list(malicious_ids)))\nEOF\npython3 /tmp/collect.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
