[235.949575, "o", "\u001b[?2004h> "]
[235.949771, "o", "cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=5 AND (image LIKE '%net.exe' OR image LIKE '%net1.exe')\")\r\n\u001b[?2004l\r\u001b[?2004h> for (eid,) in cursor.fetchall():\r\n\u001b[?2004l\r"]
[235.949846, "o", "\u001b[?2004h>     malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.949872, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.950026, "o", "# 5. Pipe events of net1.exe\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.950142, "o", "cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code IN (17, 18) AND image LIKE '%net1.exe'\")\r\n\u001b[?2004l\r\u001b[?2004h> for (eid,) in cursor.fetchall():\r\n\u001b[?2004l\r"]
[235.950261, "o", "\u001b[?2004h>     malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.950325, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.950428, "o", "# 6. ProcessAccess where net.exe calls net1.exe\r\n\u001b[?2004l\r"]
[235.950452, "o", "\u001b[?2004h> "]
[235.95076, "o", "cursor.execute(\"SELECT event_id FROM events WHERE event_code=10 AND image LIKE '%net.exe' AND target_image LIKE '%net1.exe'\")\r\n\u001b[?2004l\r\u001b[?2004h> for (eid,) in cursor.fetchall():\r\n"]
[235.950835, "o", "\u001b[?2004l\r\u001b[?2004h>     malicious_ids.add(eid)\r\n\u001b[?2004l\r"]
[235.950874, "o", "\u001b[?2004h"]
[235.951002, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.951028, "o", "print(f\"Total malicious events collected so far: {len(malicious_ids)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.951126, "o", "> print(sorted(list(malicious_ids)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.951226, "o", "EOF\r\n\u001b[?2004l\r"]
