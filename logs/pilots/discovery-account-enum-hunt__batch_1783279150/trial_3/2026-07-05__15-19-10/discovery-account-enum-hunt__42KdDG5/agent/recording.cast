[301.066367, "o", "> malicious_ids.update(r[0] for r in cursor.fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 2. All events where process_guid is the malicious powershell\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id FROM events WHERE process_guid='{b34bc01c-2f95-5f69-5f01-000000000900}'\")\r\n\u001b[?2004l\r\u001b[?2004h> malicious_ids.update(r[0] for r in cursor.fetchall())\r\n\u001b[?2004l\r"]
[301.066572, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 3. All events run under user m.ward / CORP\\\\m.ward on WS-05\r\n\u001b[?2004l\r\u001b[?2004h> "]
[301.066803, "o", "cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND (user LIKE '%m.ward%' OR target_user LIKE '%m.ward%')\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[301.06753, "o", "malicious_ids.update(r[0] for r in cursor.fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[301.067565, "o", "# 4. Terminate events of net.exe and net1.exe on WS-05\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=5 AND (image LIKE '%net.exe' OR image LIKE '%net1.exe')\")\r\n\u001b[?2004l\r\u001b[?2004h> malicious_ids.update(r[0] for r in cursor.fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 5. Pipe events of net1.exe\r\n\u001b[?2004l\r\u001b[?2004h> "]
[301.067657, "o", "cursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code IN (17, 18) AND image LIKE '%net1.exe'\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[301.06768, "o", "malicious_ids.update(r[0] for r in cursor.fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[301.067768, "o", "\u001b[?2004h> "]
[301.067803, "o", "# 6. ProcessAccess where net.exe calls net1.exe\r\n\u001b[?2004l\r\u001b[?2004h> "]
[301.067986, "o", "cursor.execute(\"SELECT event_id FROM events WHERE event_code=10 AND image LIKE '%net.exe' AND target_image LIKE '%net1.exe'\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[301.068121, "o", "malicious_ids.update(r[0] for r in cursor.fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> findings = sorted(list(malicious_ids))\r\n\u001b[?2004l\r"]
[301.068172, "o", "\u001b[?2004h> "]
[301.068414, "o", "print(f\"Writing {len(findings)} events to /root/findings.json\")\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(findings, f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[301.069354, "o", "\u001b[?2004hroot@7aa0b2a952c4:~# "]
