[70.42607, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nquery = \"\"\"\nSELECT event_id, event_code, timestamp, host, user, image, parent_image, command_line, details, message\nFROM events\nWHERE event_code NOT IN (7, 10, 800, 4103, 4104, 5156, 5158, 4656, 4658, 4690, 4663, 4673)\nORDER BY timestamp;\n\"\"\"\n\ncursor.execute(query)\ncols = [d[0] for d in cursor.description]\nfor row in cursor.fetchall():\n    d = dict(zip(cols, row))\n    # print in a compact way\n    cmd = d['command_line'] or ''\n    if len(cmd) > 100: cmd = cmd[:100] + '...'\n    img = d['image'] or ''\n    det = d['details'] or ''\n    if len(det) > 100: det = det[:100] + '...'\n    msg = d['message'] or ''\n    if len(msg) > 100: msg = msg[:100] + '...'\n    print(f\"{d['event_id']} | {d['event_code']} | {d['timestamp']} | {d['host']} | {d['user']} | {img} | {cmd} | {det} | {msg[:50]}\")\nEOF\npython3 /tmp/analyze.py\n"]
