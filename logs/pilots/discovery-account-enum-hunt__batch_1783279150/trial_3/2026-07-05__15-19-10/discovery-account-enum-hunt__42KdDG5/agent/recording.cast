[123.601274, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's pull all events where host is WS-05 or WS-06 or DC01\n# We exclude very specific benign things:\n# - svchost.exe (except when it starts anomalous processes, but here we look at all event codes)\n# - WaAppAgent, Wa3rdPartyHost, OfficeClickToRun\n# - SYSTEM / network service logs that are clearly standard system noise\n\ncursor.execute(\"\"\"\nSELECT event_id, event_code, timestamp, host, user, target_user, image, parent_image, command_line, service_name, details, message\nFROM events\nORDER BY timestamp;\n\"\"\")\ncols = [d[0] for d in cursor.description]\n\nfor r in cursor.fetchall():\n    d = dict(zip(cols, r))\n    img = d['image'] or ''\n    p_img = d['parent_image'] or ''\n    cmd = d['command_line'] or ''\n    usr = d['user'] or ''\n    tgt = d['target_user'] or ''\n    code = d['event_code']\n    \n    # Filtering rules\n    if 'WaAppAgent' in img or 'WaAppAgent' in p_img:\n        continue\n    if 'OfficeClickToRun' in img or 'OfficeClickToRun' in p_img:\n        continue\n    if 'sppsvc.exe' in img or 'sppsvc.exe' in p_img:\n        continue\n    if img == 'C:\\\\Windows\\\\System32\\\\svchost.exe' and code in (7, 10, 11, 12, 13, 5156, 5158, 4656, 4658, 4690, 4663, 4673):\n        continue\n    if img == 'C:\\\\windows\\\\System32\\\\svchost.exe' and code in (7, 10, 11, 12, 13):\n        continue\n    if img == 'C:\\\\windows\\\\system32\\\\svchost.exe' and code in (7, 10, 11, 12, 13):\n        continue\n    if 'lsass.exe' in img and code in (7, 10, 3):\n        continue\n    if 'csrss.exe' in img:\n        continue\n    if 'services.exe' in img:\n        continue\n    if code in (5156, 5158, 4656, 4658, 4690, 4663, 4673):\n        continue\n    \n    # Let's print the rest\n    print(f\"{d['event_id']} | {code} | {d['timestamp']} | {d['host']} | {usr} | {img} | {cmd[:60]} | {d['details'][:50] if d['details'] else ''}\")\n\nEOF\npython3 /tmp/hunt.py > /tmp/hunt_results.txt\nhead -n 100 /tmp/hunt_results.txt\n"]
