[301.064747, "i", "cat << 'EOF' > /tmp/write_findings.py\nimport json\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nmalicious_ids = set()\n\n# 1. PowerShell Pipeline (800) and Script Block (4103) events on WS-05\ncursor.execute(\"SELECT event_id FROM events WHERE event_code IN (800, 4103)\")\nmalicious_ids.update(r[0] for r in cursor.fetchall())\n\n# 2. All events where process_guid is the malicious powershell\ncursor.execute(\"SELECT event_id FROM events WHERE process_guid='{b34bc01c-2f95-5f69-5f01-000000000900}'\")\nmalicious_ids.update(r[0] for r in cursor.fetchall())\n\n# 3. All events run under user m.ward / CORP\\\\m.ward on WS-05\ncursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND (user LIKE '%m.ward%' OR target_user LIKE '%m.ward%')\")\nmalicious_ids.update(r[0] for r in cursor.fetchall())\n\n# 4. Terminate events of net.exe and net1.exe on WS-05\ncursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=5 AND (image LIKE '%net.exe' OR image LIKE '%net1.exe')\")\nmalicious_ids.update(r[0] for r in cursor.fetchall())\n\n# 5. Pipe events of net1.exe\ncursor.execute(\"SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code IN (17, 18) AND image LIKE '%net1.exe'\")\nmalicious_ids.update(r[0] for r in cursor.fetchall())\n\n# 6. ProcessAccess where net.exe calls net1.exe\ncursor.execute(\"SELECT event_id FROM events WHERE event_code=10 AND image LIKE '%net.exe' AND target_image LIKE '%net1.exe'\")\nmalicious_ids.update(r[0] for r in cursor.fetchall())\n\nfindings = sorted(list(malicious_ids))\nprint(f\"Writing {len(findings)} events to /root/findings.json\")\nwith open('/root/findings.json', 'w') as f:\n    json.dump(findings, f)\n\nEOF\npython3 /tmp/write_findings.py\n"]
[301.065565, "o", "cat << 'EOF' > /tmp/write_findings.py\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
