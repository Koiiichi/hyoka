[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's pull all events where host is WS-05 or WS-06 or DC01
[?2004l[?2004h> # We exclude very specific benign things:
[?2004l[?2004h> # - svchost.exe (except when it starts anomalous processes, but here we look at all event codes)
[?2004l[?2004h> # - WaAppAgent, Wa3rdPartyHost, OfficeClickToRun
[?2004l[?2004h> # - SYSTEM / network service logs that are clearly standard system noise
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h> SELECT event_id, event_code, timestamp, host, user, target_user, image, parent_image, command_line, service_name, details, message
[?2004l[?2004h> FROM events
[?2004l[?2004h> ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> cols = [d[0] for d in cursor.description]
[?2004l[?2004h> 
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     d = dict(zip(cols, r))
[?2004l[?2004h>     img = d['image'] or ''
[?2004l[?2004h>     p_img = d['parent_image'] or ''
[?2004l[?2004h>     cmd = d['command_line'] or ''
[?2004l[?2004h>     usr = d['user'] or ''
[?2004l[?2004h>     tgt = d['target_user'] or ''
[?2004l[?2004h>     code = d['event_code']
[?2004l[?2004h>     
[?2004l[?2004h>     # Filtering rules
[?2004l[?2004h>     if 'WaAppAgent' in img or 'WaAppAgent' in p_img:
[?2004l[?2004h>         continue
[?2004l[?2004h>     if 'OfficeClickToRun' in img or 'OfficeClickToRun' in p_img:
[?2004l[?2004h>         continue
[?2004l[?2004h>     if 'sppsvc.exe' in img or 'sppsvc.exe' in p_img:
[?2004l[?2004h>         continue
[?2004l[?2004h>     if img == 'C:\\Windows\\System32\\svchost.exe' and code in (7, 10, 11, 12, 13, 5156, 5158, 4656, 4658, 4690, 4663, 4673):
[?2004l[?2004h>         continue
[?2004l[?2004h>     if img == 'C:\\windows\\System32\\svchost.exe' and code in (7, 10, 11, 12, 13):
[?2004l[?2004h>         continue
[?2004l[?2004h>     if img == 'C:\\windows\\system32\\svchost.exe' and code in (7, 10, 11, 12, 13):
[?2004l[?2004h>         continue
[?2004l[?2004h>     if 'lsass.exe' in img and code in (7, 10, 3):
[?2004l[?2004h>         continue
[?2004l[?2004h>     if 'csrss.exe' in img:
[?2004l[?2004h>         continue
[?2004l[?2004h>     if 'services.exe' in img:
[?2004l[?2004h>         continue
[?2004l[?2004h>     if code in (5156, 5158, 4656, 4658, 4690, 4663, 4673):
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # Let's print the rest
[?2004l[?2004h>     print(f"{d['event_id']} | {code} | {d['timestamp']} | {d['host']} | {usr} | {img} | {cmd[:60]} | {d['details'][:50] if d['details'] else ''}")
[?2004l[?2004h> 
