[?2004hroot@7aa0b2a952c4:~# cat << 'EOF' > /tmp/collect.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's list candidate event IDs
[?2004l[?2004h> malicious_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> # 1. All 800 and 4103 events on WS-05
[?2004l[?2004h> cursor.execute("SELECT event_id FROM events WHERE event_code IN (800, 4103)")
[?2004l[?2004h> for (eid,) in cursor.fetchall():
[?2004l[?2004h>     malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> # 2. All events where process_guid is the malicious powershell
[?2004l[?2004h> cursor.execute("SELECT event_id FROM events WHERE process_guid='{b34bc01c-2f95-5f69-5f01-000000000900}'")
[?2004l[?2004h> for (eid,) in cursor.fetchall():
[?2004l[?2004h>     malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> # 3. All events run under user m.ward on WS-05
[?2004l[?2004h> cursor.execute("SELECT event_id FROM events WHERE host='WS-05.corp.example' AND (user LIKE '%m.ward%' OR target_user LIKE '%m.ward%')")
[?2004l[?2004h> for (eid,) in cursor.fetchall():
[?2004l[?2004h>     malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Terminate events of net.exe and net1.exe on WS-05
[?2004l[?2004h> cursor.execute("SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code=5 AND (image LIKE '%net.exe' OR image LIKE '%net1.exe')")
[?2004l[?2004h> for (eid,) in cursor.fetchall():
[?2004l[?2004h>     malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Pipe events of net1.exe
[?2004l[?2004h> cursor.execute("SELECT event_id FROM events WHERE host='WS-05.corp.example' AND event_code IN (17, 18) AND image LIKE '%net1.exe'")
[?2004l[?2004h> for (eid,) in cursor.fetchall():
[?2004l[?2004h>     malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> # 6. ProcessAccess where net.exe calls net1.exe
[?2004l[?2004h> cursor.execute("SELECT event_id FROM events WHERE event_code=10 AND image LIKE '%net.exe' AND target_image LIKE '%net1.exe'")
[?2004l[?2004h> for (eid,) in cursor.fetchall():
[?2004l[?2004h>     malicious_ids.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total malicious events collected so far: {len(malicious_ids)}")
[?2004l[?2004h> print(sorted(list(malicious_ids)))
