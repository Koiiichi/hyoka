[?2004hroot@7aa0b2a952c4:~# cat << 'EOF' > /tmp/analyze.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> query = """
[?2004l[?2004h> SELECT event_id, event_code, timestamp, host, user, image, parent_image, command_line, details, message
[?2004l[?2004h> FROM events
[?2004l[?2004h> WHERE event_code NOT IN (7, 10, 800, 4103, 4104, 5156, 5158, 4656, 4658, 4690, 4663, 4673)
[?2004l[?2004h> ORDER BY timestamp;
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute(query)
[?2004l[?2004h> cols = [d[0] for d in cursor.description]
[?2004l[?2004h> for row in cursor.fetchall():
[?2004l[?2004h>     d = dict(zip(cols, row))
[?2004l[?2004h>     # print in a compact way
[?2004l[?2004h>     cmd = d['command_line'] or ''
[?2004l[?2004h>     if len(cmd) > 100: cmd = cmd[:100] + '...'
[?2004l[?2004h>     img = d['image'] or ''
[?2004l[?2004h>     det = d['details'] or ''
[?2004l[?2004h>     if len(det) > 100: det = det[:100] + '...'
[?2004l[?2004h>     msg = d['message'] or ''
[?2004l[?2004h>     if len(msg) > 100: msg = msg[:100] + '...'
[?2004l[?2004h>     print(f"{d['event_id']} | {d['event_code']} | {d['timestamp']} | {d['host']} | {d['user']} | {img} | {cmd} | {det} | {msg[:50]}")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@7aa0b2a952c4:~# python3 /tmp/analyze.py
