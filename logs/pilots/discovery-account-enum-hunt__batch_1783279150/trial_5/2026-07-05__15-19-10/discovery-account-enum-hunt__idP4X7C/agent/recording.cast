[290.51179, "i", "cat << 'EOF' > list_all_candidates.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, user, image, parent_image, command_line, target_object, details\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n    ORDER BY timestamp\n\"\"\")\nrows = cursor.fetchall()\n\nmalicious_ids = []\n\nfor r in rows:\n    code = r['event_code']\n    eid = r['event_id']\n    img = r['image'] or ''\n    pimg = r['parent_image'] or ''\n    cmd = r['command_line'] or ''\n    obj = r['target_object'] or ''\n    det = r['details'] or ''\n    usr = r['user'] or ''\n    \n    # Classify based on our clear understanding:\n    is_malicious = False\n    \n    # 1. Any PowerShell pipeline (800) or module (4103) logs from this host\n    if code in (800, 4103):\n        is_malicious = True\n        \n    # 2. Any net/net1 execution process creations (1, 4688)\n    elif code in (1, 4688) and ('net.exe' in img or 'net1.exe' in img or 'net.exe' in cmd or 'net1' in cmd):\n        is_malicious = True\n        \n    # 3. Any net/net1 process exits (5, 4689)\n    elif code in (5, 4689) and ('net.exe' in img or 'net1.exe' in img):\n        is_malicious = True\n        \n    # 4. Pipe events associated with powershell or net/net1 (17, 18)\n    elif code in (17, 18) and ('powershell.exe' in img or 'net1.exe' in img):\n        is_malicious = True\n        \n    # 5. Security audit group membership enumeration (4799)\n    elif code == 4799 and 'net1.exe' in det:\n        is_malicious = True\n        \n    # 6. Object / Registry handle accesses and duplications by net1.exe (4656, 4663, 4658, 4690)\n    elif code in (4656, 4663, 4658, 4690) and 'net1.exe' in det:\n        is_malicious = True\n        \n    # 7. Process Access events where powershell or net/net1 is source or target\n    elif code == 10 and ('powershell.exe' in img or 'net.exe' in img or 'net1.exe' in img or 'net.exe' in obj or 'net1.exe' in obj):\n        is_malicious = True\n        \n    # 8. Registry events (12, 13, 14) from powershell.exe (beacon querying connections)\n    elif code in (12, 13, 14) and 'powershell.exe' in img:\n        is_malicious = True\n        \n    if is_malicious:\n        malicious_ids.append(eid)\n\nprint(f\"Total identified malicious event IDs: {len(malicious_ids)}\")\nprint(\", \".join(malicious_ids[:50]))\nEOF\npython3 list_all_candidates.py\n"]
