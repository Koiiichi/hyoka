[247.718561, "o", "\u001b[?2004hroot@534402c71650:~# "]
[259.509047, "i", "cat << 'EOF' > mward_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, image, parent_image, command_line\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n      AND (user LIKE '%m.ward%' OR target_user LIKE '%m.ward%')\n    ORDER BY timestamp\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Total m.ward events on WS-05: {len(rows)}\")\nfor r in rows:\n    print(f\"{r['event_id']} | Code: {r['event_code']} | Img: {r['image']} | PImg: {r['parent_image']} | Cmd: {r['command_line']}\")\nEOF\npython3 mward_events.py\n"]
[259.509382, "o", "cat << 'EOF' > mward_events.py\r\n\u001b[?2004l\r"]
