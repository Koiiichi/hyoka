[24.499415, "i", "cat << 'EOF' > test_ps.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, message, details\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (4103, 800)\n    ORDER BY timestamp\n    LIMIT 20\n\"\"\")\nfor r in cursor.fetchall():\n    print(f\"ID: {r['event_id']} Code: {r['event_code']}\")\n    print(f\"Details: {r['details']}\")\n    print(f\"Message: {r['message'][:300]}...\")\n    print(\"-\"*40)\nEOF\npython3 test_ps.py\n"]
