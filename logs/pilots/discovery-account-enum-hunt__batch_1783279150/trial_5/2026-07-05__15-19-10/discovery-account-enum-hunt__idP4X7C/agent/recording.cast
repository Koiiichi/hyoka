[338.21368, "i", "cat << 'EOF' > ws05_non_malicious.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Get all malicious IDs first\nimport list_all_candidates\nmalicious_set = set(list_all_candidates.malicious_ids)\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, image, parent_image, command_line, target_object\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n\"\"\")\nrows = cursor.fetchall()\n\nbenign_counts = {}\nbenign_examples = {}\nfor r in rows:\n    eid = r['event_id']\n    code = r['event_code']\n    if eid not in malicious_set:\n        benign_counts[code] = benign_counts.get(code, 0) + 1\n        if code not in benign_examples:\n            benign_examples[code] = []\n        if len(benign_examples[code]) < 3:\n            benign_examples[code].append(f\"{eid} | {r['image']} | {r['command_line']}\")\n\nprint(\"=== Non-malicious event counts on WS-05 ===\")\nfor code, count in sorted(benign_counts.items()):\n    print(f\"Code {code}: {count} events\")\n    for ex in benign_examples[code]:\n        print(f\"  Example: {ex}\")\nEOF\npython3 ws05_non_malicious.py\n"]
