[34.702507, "o", "cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.70304, "o", "for host in ['DC01.corp.example', 'WS-05.corp.example', 'WS-06.corp.example']:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"=== Host: {host} ===\")\r\n\u001b[?2004l\r\u001b[?2004h>     cursor.execute(\"\"\"\r\n"]
[34.70319, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[34.703228, "o", "        SELECT event_code, COUNT(*) \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.703337, "o", "        FROM events \r\n\u001b[?2004l\r\u001b[?2004h>         WHERE host = ? \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.703512, "o", ">         GROUP BY event_code \r\n\u001b[?2004l\r"]
[34.703759, "o", "\u001b[?2004h> "]
[34.703985, "o", "        ORDER BY COUNT(*) DESC\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\", (host,))\r\n\u001b[?2004l\r"]
[34.704019, "o", "\u001b[?2004h"]
[34.704326, "o", ">     for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.70438, "o", "        print(f\"  Code {r['event_code']}: {r['COUNT(*)']}\")"]
[34.704486, "o", "\r\n\u001b[?2004l\r"]
[34.704763, "o", "\u001b[?2004h"]
[34.704889, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[34.705839, "o", "\u001b[?2004hroot@534402c71650:~# "]
[34.705977, "o", "python3 summarize.py\r\n\u001b[?2004l\r"]
