[94.434332, "o", "\u001b[?2004hroot@534402c71650:~# "]
[102.56988, "i", "cat << 'EOF' > dc01_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, target_user, logon_type, service_name, command_line, details, message\n    FROM events\n    WHERE host = 'DC01.corp.example'\n    ORDER BY timestamp\n\"\"\")\nfor r in cursor.fetchall():\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | User: {r['user']} | T_User: {r['target_user']} | Svc: {r['service_name']} | Cmd: {r['command_line']} | Det: {r['details']}\")\nEOF\npython3 dc01_events.py\n"]
[102.570183, "o", "cat << 'EOF' > dc01_events.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
