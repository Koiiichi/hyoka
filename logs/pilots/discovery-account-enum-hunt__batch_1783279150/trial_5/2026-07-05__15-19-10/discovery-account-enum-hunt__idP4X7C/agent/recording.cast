[102.570668, "o", "\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, event_code, user, target_user, logon_type, service_name, command_line, details, message\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events\r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'DC01.corp.example'\r\n\u001b[?2004l\r"]
[102.570759, "o", "\u001b[?2004h>     ORDER BY timestamp\r\n\u001b[?2004l\r"]
