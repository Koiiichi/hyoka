[394.28982, "i", "cat << 'EOF' > generate_findings.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT *\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n    ORDER BY timestamp\n\"\"\")\nrows = cursor.fetchall()\n\nmalicious_ids = []\n\nfor r in rows:\n    code = r['event_code']\n    eid = r['event_id']\n    img = (r['image'] or '').lower()\n    pimg = (r['parent_image'] or '').lower()\n    cmd = (r['command_line'] or '').lower()\n    obj = (r['target_object'] or '').lower()\n    det = (r['details'] or '').lower()\n    msg = (r['message'] or '').lower()\n    \n    is_malicious = False\n    \n    # 1. PowerShell 800 / 4103 (beacon loop)\n    if code in (800, 4103):\n        is_malicious = True\n        \n    # 2. Process creations (1, 4688) for net/net1/powershell\n    elif code in (1, 4688) and ('net.exe' in img or 'net1.exe' in img or 'powershell.exe' in img or 'net.exe' in cmd or 'net1' in cmd):\n        is_malicious = True\n        \n    # 3. Process exits (5, 4689) for net/net1/powershell\n    elif code in (5, 4689) and ('net.exe' in img or 'net1.exe' in img or 'net.exe' in msg or 'net1.exe' in msg or 'net.exe' in det or 'net1.exe' in det):\n        is_malicious = True\n        \n    # 4. Pipe events associated with powershell or net/net1 (17, 18)\n    elif code in (17, 18) and ('powershell' in img or 'powershell' in msg or 'powershell' in det or 'net1.exe' in img or 'net1.exe' in msg or 'net1.exe' in det):\n        is_malicious = True\n        \n    # 5. Security audit group membership enumeration (4799)\n    elif code == 4799 and ('net1.exe' in det or 'net1.exe' in msg):\n        is_malicious = True\n        \n    # 6. Object / Registry handle accesses and duplications by net/net1 (4656, 4663, 4658, 4690)\n    elif code in (4656, 4663, 4658, 4690) and ('net1.exe' in det or 'net1.exe' in msg or 'net.exe' in det or 'net.exe' in msg or '0x10a7df' in msg or '0x10a7df' in det):\n        is_malicious = True\n        \n    # 7. ProcessAccess (10) where powershell or net/net1 is source or target\n    elif code == 10 and ('powershell' in img or 'net.exe' in img or 'net1.exe' in img or 'powershell' in obj or 'net.exe' in obj or 'net1.exe' in obj):\n        is_malicious = True\n        \n    # 8. Registry modifications by powershell (12, 13, 14)\n    elif code in (12, 13, 14) and ('powershell' in img or 'powershell' in msg or 'powershell' in det):\n        is_malicious = True\n        \n    if is_malicious:\n        malicious_ids.append(eid)\n\nprint(f\"Total malicious event IDs found: {len(malicious_ids)}\")\nwith open('/root/findings.json', 'w') as f:\n    json.dump(malicious_ids, f)\nprint(\"Written findings to /root/findings.json\")\nEOF\npython3 generate_findings.py\n"]
[394.290148, "o", "cat << 'EOF' > generate_findings.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.290261, "o", "import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.290351, "o", "conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.290395, "o", "cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[394.290679, "o", "\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT *\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events\r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'WS-05.corp.example'\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> rows = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> malicious_ids = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.290711, "o", "    code = r['event_code']\r\n\u001b[?2004l\r"]
[394.290912, "o", "\u001b[?2004h>     eid = r['event_id']\r\n\u001b[?2004l\r\u001b[?2004h>     img = (r['image'] or '').lower()\r\n\u001b[?2004l\r\u001b[?2004h>     pimg = (r['parent_image'] or '').lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.291044, "o", "    cmd = (r['command_line'] or '').lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.291204, "o", "    obj = (r['target_object'] or '').lower()\r\n\u001b[?2004l\r\u001b[?2004h>     det = (r['details'] or '').lower()\r\n\u001b[?2004l\r\u001b[?2004h>     msg = (r['message'] or '').lower()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[394.291226, "o", "\u001b[?2004h> "]
[394.291299, "o", "    is_malicious = False\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.29148, "o", "    # 1. PowerShell 800 / 4103 (beacon loop)\r\n\u001b[?2004l\r\u001b[?2004h>     if code in (800, 4103):\r\n\u001b[?2004l\r"]
[394.291658, "o", "\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.291744, "o", "    # 2. Process creations (1, 4688) for net/net1/powershell\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.291914, "o", "    elif code in (1, 4688) and ('net.exe' in img or 'net1.exe' in img or 'powershell.exe' in img or 'net.exe' in cmd or 'net1' in cmd):\r\n\u001b[?2004l\r\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[394.291937, "o", "\u001b[?2004h"]
[394.292052, "o", ">     # 3. Process exits (5, 4689) for net/net1/powershell\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.292253, "o", "    elif code in (5, 4689) and ('net.exe' in img or 'net1.exe' in img or 'net.exe' in msg or 'net1.exe' in msg or 'net.exe' in det or 'net1.exe' in det):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.292419, "o", "        is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.29251, "o", "    # 4. Pipe events associated with powershell or net/net1 (17, 18)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.292653, "o", "    elif code in (17, 18) and ('powershell' in img or 'powershell' in msg or 'powershell' in det or 'net1.exe' in img or 'net1.exe' in msg or 'net1.exe' in det):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.292813, "o", "        is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.292873, "o", "    # 5. Security audit group membership enumeration (4799)\r\n\u001b[?2004l\r\u001b[?2004h>     elif code == 4799 and ('net1.exe' in det or 'net1.exe' in msg):\r\n\u001b[?2004l\r\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[394.29304, "o", "\u001b[?2004h>     # 6. Object / Registry handle accesses and duplications by net/net1 (4656, 4663, 4658, 4690)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.293145, "o", "    elif code in (4656, 4663, 4658, 4690) and ('net1.exe' in det or 'net1.exe' in msg or 'net.exe' in det or 'net.exe' in msg or '0x10a7df' in msg or '0x10a7df' in det):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.293228, "o", "        is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[394.293262, "o", "> "]
[394.293341, "o", "    # 7. ProcessAccess (10) where powershell or net/net1 is source or target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.293462, "o", "    elif code == 10 and ('powershell' in img or 'net.exe' in img or 'net1.exe' in img or 'powershell' in obj or 'net.exe' in obj or 'net1.exe' in obj):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.293566, "o", "        is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.293647, "o", "    # 8. Registry modifications by powershell (12, 13, 14)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.293775, "o", "    elif code in (12, 13, 14) and ('powershell' in img or 'powershell' in msg or 'powershell' in det):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.293848, "o", "        is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     if is_malicious:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.293899, "o", "        malicious_ids.append(eid)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[394.293954, "o", "> "]
[394.294037, "o", "print(f\"Total malicious event IDs found: {len(malicious_ids)}\")\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.294126, "o", "    json.dump(malicious_ids, f)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Written findings to /root/findings.json\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
