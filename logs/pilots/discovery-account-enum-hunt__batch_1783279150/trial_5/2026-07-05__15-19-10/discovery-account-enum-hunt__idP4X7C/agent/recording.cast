[241.011911, "i", "cat << 'EOF' > classify.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, details, message\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n    ORDER BY timestamp\n\"\"\")\nrows = cursor.fetchall()\n\nprint(f\"Total WS-05 events: {len(rows)}\")\nfor r in rows:\n    code = r['event_code']\n    eid = r['event_id']\n    img = r['image'] or ''\n    pimg = r['parent_image'] or ''\n    cmd = r['command_line'] or ''\n    obj = r['target_object'] or ''\n    \n    # Skip WFP\n    if code in (5156, 5158):\n        continue\n        \n    # Skip PowerShell 800/4103 for now to focus on other events\n    if code in (800, 4103):\n        continue\n        \n    print(f\"{r['timestamp']} | {eid} | Code: {code} | Img: {img} | PImg: {pimg} | Cmd: {cmd} | Obj: {obj}\")\nEOF\npython3 classify.py\n"]
