[88.149766, "o", "\u001b[?2004hroot@534402c71650:~# "]
[94.42263, "i", "cat << 'EOF' > find_cmds.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code = 800\n    ORDER BY timestamp\n\"\"\")\nfor r in cursor.fetchall():\n    msg = r['message']\n    if 'iex' in msg.lower() or 'net' in msg.lower() or 'group' in msg.lower() or 'user' in msg.lower():\n        for line in msg.split('\\n'):\n            if 'command line:' in line.lower():\n                print(f\"{r['timestamp']} | {r['event_id']} | {line.strip()}\")\nEOF\npython3 find_cmds.py\n"]
[94.422765, "o", "cat << 'EOF' > find_cmds.py\r\n\u001b[?2004l\r"]
