[34.701883, "i", "cat << 'EOF' > summarize.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nfor host in ['DC01.corp.example', 'WS-05.corp.example', 'WS-06.corp.example']:\n    print(f\"=== Host: {host} ===\")\n    cursor.execute(\"\"\"\n        SELECT event_code, COUNT(*) \n        FROM events \n        WHERE host = ? \n        GROUP BY event_code \n        ORDER BY COUNT(*) DESC\n    \"\"\", (host,))\n    for r in cursor.fetchall():\n        print(f\"  Code {r['event_code']}: {r['COUNT(*)']}\")\n\nEOF\npython3 summarize.py\n"]
[34.702201, "o", "cat << 'EOF' > summarize.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
