[181.772251, "o", "\u001b[?2004hroot@534402c71650:~# "]
[188.493588, "i", "cat << 'EOF' > ws05_wfp.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158)\n    ORDER BY timestamp\n\"\"\")\nfor r in cursor.fetchall():\n    msg = r['message']\n    # Extract Application name or process ID if available\n    app = \"\"\n    for line in msg.split('\\n'):\n        if \"Application Name:\" in line or \"Application:\" in line or \"Source Address:\" in line or \"Destination Address:\" in line or \"Destination Port:\" in line:\n            app += line.strip() + \" | \"\n    print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | {app}\")\nEOF\npython3 ws05_wfp.py\n"]
[188.493853, "o", "cat << 'EOF' > ws05_wfp.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
