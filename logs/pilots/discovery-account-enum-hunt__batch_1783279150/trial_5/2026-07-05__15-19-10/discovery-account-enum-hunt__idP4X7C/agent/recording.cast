[301.593048, "o", "\u001b[?2004hroot@534402c71650:~# "]
[310.2124, "i", "cat << 'EOF' > list_non_ps.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, image, parent_image, command_line, target_object, details\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n    ORDER BY timestamp\n\"\"\")\nrows = cursor.fetchall()\n\nfor r in rows:\n    code = r['event_code']\n    eid = r['event_id']\n    img = r['image'] or ''\n    pimg = r['parent_image'] or ''\n    cmd = r['command_line'] or ''\n    obj = r['target_object'] or ''\n    det = r['details'] or ''\n    \n    # Skip 800 and 4103\n    if code in (800, 4103):\n        continue\n        \n    is_malicious = False\n    if code in (1, 4688) and ('net.exe' in img or 'net1.exe' in img or 'net.exe' in cmd or 'net1' in cmd):\n        is_malicious = True\n    elif code in (5, 4689) and ('net.exe' in img or 'net1.exe' in img):\n        is_malicious = True\n    elif code in (17, 18) and ('powershell.exe' in img or 'net1.exe' in img):\n        is_malicious = True\n    elif code == 4799 and 'net1.exe' in det:\n        is_malicious = True\n    elif code in (4656, 4663, 4658, 4690) and 'net1.exe' in det:\n        is_malicious = True\n    elif code == 10 and ('powershell.exe' in img or 'net.exe' in img or 'net1.exe' in img or 'net.exe' in obj or 'net1.exe' in obj):\n        is_malicious = True\n    elif code in (12, 13, 14) and 'powershell.exe' in img:\n        is_malicious = True\n        \n    if is_malicious:\n         print(f\"{eid} | Code: {code} | Img: {img} | PImg: {pimg} | Cmd: {cmd} | Obj: {obj} | Det: {det[:50]}\")\nEOF\npython3 list_non_ps.py\n"]
