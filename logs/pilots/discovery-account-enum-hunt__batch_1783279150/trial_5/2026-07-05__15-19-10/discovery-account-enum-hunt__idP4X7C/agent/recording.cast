[88.135475, "i", "cat << 'EOF' > ps_analyze.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code = 800\n    ORDER BY timestamp\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Total 800 events: {len(rows)}\")\nfor i, r in enumerate(rows):\n    msg = r['message']\n    # extract the pipeline execution detail command line\n    cmd = \"\"\n    for line in msg.split('\\n'):\n        if \"Pipeline execution details for command line:\" in line:\n            cmd = line.split(\"Pipeline execution details for command line:\")[1].strip()\n            break\n    if not cmd:\n        # let's try another way to extract command\n        cmd = msg[:100].replace('\\n', ' ')\n    print(f\"{r['timestamp']} | {r['event_id']} | {cmd}\")\nEOF\npython3 ps_analyze.py | head -n 40\n"]
[88.135767, "o", "cat << 'EOF' > ps_analyze.py"]
