[371.672233, "i", "cat << 'EOF' > compare.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nimport list_all_candidates\nimport list_all_candidates_v2\n\nset1 = set(list_all_candidates.malicious_ids)\nset2 = set(list_all_candidates_v2.malicious_ids)\n\ndiff = set2 - set1\nprint(f\"Difference size: {len(diff)}\")\nfor eid in sorted(list(diff)):\n    cursor.execute(\"SELECT event_code, image, command_line, target_object, message FROM events WHERE event_id = ?\", (eid,))\n    r = cursor.fetchone()\n    print(f\"{eid} | Code: {r['event_code']} | Img: {r['image']} | Cmd: {r['command_line']} | Msg: {r['message'][:100].strip()}\")\nEOF\npython3 compare.py\n"]
