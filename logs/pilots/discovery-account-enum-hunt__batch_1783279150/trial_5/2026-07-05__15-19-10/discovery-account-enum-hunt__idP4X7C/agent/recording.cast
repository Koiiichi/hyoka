[63.37385, "i", "cat << 'EOF' > find_ps_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, message\n    FROM events\n    WHERE (image LIKE '%powershell%' OR parent_image LIKE '%powershell%' OR command_line LIKE '%powershell%' OR message LIKE '%powershell%')\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} PowerShell-related events.\")\n# Let's group by event_code to see what types of events they are\ncounts = {}\nfor r in rows:\n    counts[r['event_code']] = counts.get(r['event_code'], 0) + 1\nfor code, count in sorted(counts.items()):\n    print(f\"  Code {code}: {count} events\")\nEOF\npython3 find_ps_events.py\n"]
