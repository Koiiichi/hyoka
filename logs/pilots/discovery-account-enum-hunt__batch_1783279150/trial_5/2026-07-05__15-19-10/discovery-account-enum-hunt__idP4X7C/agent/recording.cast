[231.311242, "i", "cat << 'EOF' > parse_hostid.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code = 800\n\"\"\")\nhost_ids = set()\nfor r in cursor.fetchall():\n    msg = r['message']\n    for line in msg.split('\\n'):\n        if 'HostId=' in line:\n            host_ids.add(line.strip())\nprint(f\"Distinct HostIds: {host_ids}\")\nEOF\npython3 parse_hostid.py\n"]
