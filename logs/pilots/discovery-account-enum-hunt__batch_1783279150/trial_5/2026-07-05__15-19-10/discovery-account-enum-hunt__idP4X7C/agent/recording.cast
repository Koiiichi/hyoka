[241.031153, "o", "\u001b[?2004hroot@534402c71650:~# "]
[247.700091, "i", "cat << 'EOF' > classify.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, details\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n    ORDER BY timestamp\n\"\"\")\nrows = cursor.fetchall()\n\nwith open('/root/classify_output.txt', 'w') as f:\n    f.write(f\"Total WS-05 events: {len(rows)}\\n\")\n    for r in rows:\n        code = r['event_code']\n        eid = r['event_id']\n        img = r['image'] or ''\n        pimg = r['parent_image'] or ''\n        cmd = r['command_line'] or ''\n        obj = r['target_object'] or ''\n        det = r['details'] or ''\n        usr = r['user'] or ''\n        \n        # Skip WFP\n        if code in (5156, 5158):\n            continue\n            \n        # Skip PowerShell 800/4103\n        if code in (800, 4103):\n            continue\n            \n        f.write(f\"{r['timestamp']} | {eid} | Code: {code} | User: {usr} | Img: {img} | PImg: {pimg} | Cmd: {cmd} | Obj: {obj} | Det: {det[:100]}\\n\")\nEOF\npython3 classify.py\nhead -n 50 /root/classify_output.txt\n"]
[247.700425, "o", "cat << 'EOF' > classify.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
