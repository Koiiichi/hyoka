[219.409453, "i", "cat << 'EOF' > details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\nfor eid in ('evt-00083', 'evt-01028'):\n    cursor.execute(\"SELECT * FROM events WHERE event_id = ?\", (eid,))\n    r = cursor.fetchone()\n    print(f\"=== {eid} ===\")\n    for key in r.keys():\n        if r[key] is not None:\n            print(f\"  {key}: {r[key]}\")\nEOF\npython3 details.py\n"]
