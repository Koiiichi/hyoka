[121.856493, "i", "cat << 'EOF' > ws06_sysmon10.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT image, target_image, COUNT(*)\n    FROM events\n    WHERE host = 'WS-06.corp.example' AND event_code = 10\n    GROUP BY image, target_image\n    ORDER BY COUNT(*) DESC\n\"\"\")\nfor r in cursor.fetchall():\n    print(f\"{r['COUNT(*)']} | {r['image']} -> {r['target_image']}\")\nEOF\npython3 ws06_sysmon10.py\n"]
[121.856697, "o", "cat << 'EOF' > ws06_sysmon10.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
