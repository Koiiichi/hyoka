[176.061352, "o", "\u001b[?2004hroot@534402c71650:~# "]
[181.75096, "i", "cat << 'EOF' > ws05_all.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, target_object, details, command_line, src_ip, dst_ip, dst_port\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n    ORDER BY timestamp\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Total events on WS-05: {len(rows)}\")\nfor r in rows:\n    code = r['event_code']\n    if code in (5156, 5158):\n        # check if it relates to the beacon IP or m.ward's activities\n        # Let's see what IPs are in WFP logs\n        print(f\"{r['timestamp']} | {r['event_id']} | WFP {code} | Src: {r['src_ip']} -> Dst: {r['dst_ip']}:{r['dst_port']}\")\n    elif code in (800, 4103):\n        # too many, let's just print a summary of how many we saw\n        pass\n    else:\n        print(f\"{r['timestamp']} | {r['event_id']} | Code: {code} | Img: {r['image']} | Obj: {r['target_object']} | Cmd: {r['command_line']}\")\nEOF\npython3 ws05_all.py\n"]
[181.751486, "o", "cat << 'EOF' > ws05_all.py\r\n\u001b[?2004l\r"]
