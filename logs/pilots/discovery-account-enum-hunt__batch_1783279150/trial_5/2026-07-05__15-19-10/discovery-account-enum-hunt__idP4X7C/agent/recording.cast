[301.581463, "i", "cat << 'EOF' > ws05_event10.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, image, target_image, granted_access\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code = 10\n    ORDER BY timestamp\n\"\"\")\nfor r in cursor.fetchall():\n    img = r['image'] or ''\n    timg = r['target_image'] or ''\n    if 'powershell' in img.lower() or 'net' in img.lower() or 'net1' in img.lower() or 'net' in timg.lower() or 'net1' in timg.lower():\n        print(f\"{r['timestamp']} | {r['event_id']} | Source: {img} -> Target: {timg} | Access: {r['granted_access']}\")\nEOF\npython3 ws05_event10.py\n"]
[301.581991, "o", "cat << 'EOF' > ws05_event10.py\r\n\u001b[?2004l\r\u001b[?2004h"]
