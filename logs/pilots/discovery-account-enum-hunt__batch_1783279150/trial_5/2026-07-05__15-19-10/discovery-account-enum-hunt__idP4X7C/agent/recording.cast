[142.633041, "i", "cat << 'EOF' > ws06_time.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, details, message\n    FROM events\n    WHERE host = 'WS-06.corp.example'\n      AND timestamp >= '2026-05-06T00:08:15Z'\n      AND timestamp <= '2026-05-06T00:08:25Z'\n    ORDER BY timestamp\n\"\"\")\nfor r in cursor.fetchall():\n    if r['event_code'] in (1, 4688, 11, 12, 13, 17, 18, 22, 4798, 4799):\n        print(f\"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | User: {r['user']} | Img: {r['image']} | Cmd: {r['command_line']} | Det: {r['details']}\")\nEOF\npython3 ws06_time.py\n"]
[142.633429, "o", "cat << 'EOF' > ws06_time.py\r\n\u001b[?2004l\r"]
