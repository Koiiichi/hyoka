[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect events on WS-05 around '2026-05-06T00:00:00.000Z' to '2026-05-06T00:10:00.000Z'
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, channel, host, user, target_user, image, parent_image, command_line, service_name, details, message
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example'
[?2004l[?2004h>       AND timestamp >= '2026-05-06T00:00:00Z'
[?2004l[?2004h>       AND timestamp <= '2026-05-06T00:10:00Z'
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} events on WS-05 in the first 10 mins.")
[?2004l[?2004h> for r in rows[:100]:
[?2004l[?2004h>     # filter out some noisy events or print concisely
[?2004l[?2004h>     print(f"{r['timestamp']} | {r['event_id']} | {r['event_code']} | {r['user']} | {r['image'] or ''} | {r['command_line'] or ''} | {r['details'] or ''}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
