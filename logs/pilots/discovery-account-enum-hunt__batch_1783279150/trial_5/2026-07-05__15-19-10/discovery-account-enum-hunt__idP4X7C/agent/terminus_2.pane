[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, message
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE (image LIKE '%powershell%' OR parent_image LIKE '%powershell%' OR command_line LIKE '%powershell%' OR message LIKE '%powershell%')
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} PowerShell-related events.")
[?2004l[?2004h> # Let's group by event_code to see what types of events they are
[?2004l[?2004h> counts = {}
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     counts[r['event_code']] = counts.get(r['event_code'], 0) + 1
[?2004l[?2004h> for code, count in sorted(counts.items()):
[?2004l[?2004h>     print(f"  Code {code}: {count} events")
