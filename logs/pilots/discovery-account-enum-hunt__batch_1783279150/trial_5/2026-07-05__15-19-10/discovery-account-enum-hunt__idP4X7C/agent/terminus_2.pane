This event is generated when a logon session is destroyed. It may be positively correlated with a logon event using the Logon ID value. Logon IDs are only unique between reboots on the same computer.
[?2004hroot@534402c71650:~# cat << 'EOF' > ws06_sysmon10.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT image, target_image, COUNT(*)
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-06.corp.example' AND event_code = 10
[?2004l[?2004h>     GROUP BY image, target_image
[?2004l[?2004h>     ORDER BY COUNT(*) DESC
[?2004l[?2004h> """)
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(f"{r['COUNT(*)']} | {r['image']} -> {r['target_image']}")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@534402c71650:~# python3 ws06_sysmon10.py
