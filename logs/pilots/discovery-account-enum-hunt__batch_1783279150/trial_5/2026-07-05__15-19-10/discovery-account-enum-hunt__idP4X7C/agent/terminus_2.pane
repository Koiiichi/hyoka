[?2004hroot@534402c71650:~# cat << 'EOF' > ws05_wfp.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, message
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158)
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     msg = r['message']
[?2004l[?2004h>     # Extract Application name or process ID if available
[?2004l[?2004h>     app = ""
[?2004l[?2004h>     for line in msg.split('\n'):
[?2004l[?2004h>         if "Application Name:" in line or "Application:" in line or "Source Address:" in line or "Destination Address:" in line or "Destination Port:" in line:
[?2004l[?2004h>             app += line.strip() + " | "
[?2004l[?2004h>     print(f"{r['timestamp']} | {r['event_id']} | Code: {r['event_code']} | {app}")
[?2004l[?2004h> EOF
