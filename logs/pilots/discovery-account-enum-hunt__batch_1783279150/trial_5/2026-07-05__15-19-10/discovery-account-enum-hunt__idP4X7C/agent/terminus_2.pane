[?2004hroot@534402c71650:~# cat << 'EOF' > ws05_all.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, image, target_object, details, command_line, src_ip, dst_ip, dst_port
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example'
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Total events on WS-05: {len(rows)}")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     code = r['event_code']
[?2004l[?2004h>     if code in (5156, 5158):
[?2004l[?2004h>         # check if it relates to the beacon IP or m.ward's activities
[?2004l[?2004h>         # Let's see what IPs are in WFP logs
[?2004l[?2004h>         print(f"{r['timestamp']} | {r['event_id']} | WFP {code} | Src: {r['src_ip']} -> Dst: {r['dst_ip']}:{r['dst_port']}")
[?2004l[?2004h>     elif code in (800, 4103):
[?2004l[?2004h>         # too many, let's just print a summary of how many we saw
[?2004l[?2004h>         pass
[?2004l[?2004h>     else:
[?2004l[?2004h>         print(f"{r['timestamp']} | {r['event_id']} | Code: {code} | Img: {r['image']} | Obj: {r['target_object']} | Cmd: {r['command_line']}")
[?2004l[?2004h> EOF
