[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, details
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example'
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> with open('/root/classify_output.txt', 'w') as f:
[?2004l[?2004h>     f.write(f"Total WS-05 events: {len(rows)}\n")
[?2004l[?2004h>     for r in rows:
[?2004l[?2004h>         code = r['event_code']
[?2004l[?2004h>         eid = r['event_id']
[?2004l[?2004h>         img = r['image'] or ''
[?2004l[?2004h>         pimg = r['parent_image'] or ''
[?2004l[?2004h>         cmd = r['command_line'] or ''
[?2004l[?2004h>         obj = r['target_object'] or ''
[?2004l[?2004h>         det = r['details'] or ''
[?2004l[?2004h>         usr = r['user'] or ''
[?2004l[?2004h>         
[?2004l[?2004h>         # Skip WFP
[?2004l[?2004h>         if code in (5156, 5158):
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         # Skip PowerShell 800/4103
[?2004l[?2004h>         if code in (800, 4103):
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         f.write(f"{r['timestamp']} | {eid} | Code: {code} | User: {usr} | Img: {img} | PImg: {pimg} | Cmd: {cmd} | Obj: {obj} | Det: {det[:100]}\n")
[?2004l[?2004h> EOF
