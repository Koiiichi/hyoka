[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, message
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example' AND event_code = 800
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cursor.fetchall()
