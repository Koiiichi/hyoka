[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import base64
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, host, user, message FROM events WHERE event_code IN (800, 4103);")
