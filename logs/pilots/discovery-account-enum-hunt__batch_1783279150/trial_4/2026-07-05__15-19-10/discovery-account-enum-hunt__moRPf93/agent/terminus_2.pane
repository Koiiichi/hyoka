[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, message
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-06.corp.example' 
[?2004l[?2004h>       AND timestamp >= '2026-05-06T00:08:15Z'
[?2004l[?2004h>       AND timestamp <= '2026-05-06T00:08:25Z'
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     eid, ts, code, usr, img, pimg, cmd, tobj, msg = row
