[?2004hroot@93dc786d498e:~# cat << 'EOF' > /tmp/parse_wfp.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, host, message FROM events WHERE event_code = 5156 ORDER BY timestamp;")
[?2004l[?2004h> 
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     eid, ts, host, msg = row
[?2004l[?2004h>     if not msg:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract App Name
[?2004l[?2004h>     app_match = re.search(r'Application Name:\s*(.*)', msg)
[?2004l[?2004h>     app = app_match.group(1).strip() if app_match else "Unknown"
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract Direction
[?2004l[?2004h>     dir_match = re.search(r'Direction:\s*(.*)', msg)
[?2004l[?2004h>     direction = dir_match.group(1).strip() if dir_match else "Unknown"
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract IPs and Ports
[?2004l[?2004h>     src_match = re.search(r'Source Address:\s*(\S+)', msg)
[?2004l[?2004h>     src_ip = src_match.group(1).strip() if src_match else "Unknown"
[?2004l[?2004h>     
[?2004l[?2004h>     dst_match = re.search(r'Destination Address:\s*(\S+)', msg)
[?2004l[?2004h>     dst_ip = dst_match.group(1).strip() if dst_match else "Unknown"
[?2004l[?2004h>     
[?2004l[?2004h>     port_match = re.search(r'Destination Port:\s*(\S+)', msg)
[?2004l[?2004h>     dst_port = port_match.group(1).strip() if port_match else "Unknown"
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"{ts} | {eid} | {host} | App: {app} | {direction} | {src_ip} -> {dst_ip}:{dst_port}")
[?2004l[?2004h> EOF
