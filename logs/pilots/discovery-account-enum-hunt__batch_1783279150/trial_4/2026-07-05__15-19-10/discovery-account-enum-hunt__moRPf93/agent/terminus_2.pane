[?2004l[?2004h>     pimg_lower = pimg.lower() if pimg else ''
[?2004l[?2004h>     cmd_lower = cmd.lower() if cmd else ''
[?2004l[?2004h>     usr_lower = usr.lower() if usr else ''
[?2004l[?2004h>     msg_lower = msg.lower() if msg else ''
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if this is powershell, net, net1
[?2004l[?2004h>     is_mal = False
[?2004l[?2004h>     if 'powershell' in img_lower or 'powershell' in pimg_lower or 'powershell' in cmd_lower or 'powershell' in msg_lower:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>     if 'net.exe' in img_lower or 'net.exe' in pimg_lower or 'net.exe' in cmd_lower:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>     if 'net1.exe' in img_lower or 'net1.exe' in pimg_lower or 'net1.exe' in cmd_lower:
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>     if usr_lower == 'corp\\m.ward' or usr_lower == 'm.ward':
[?2004l[?2004h>         is_mal = True
[?2004l[?2004h>         
[?2004l[?2004h>     if is_mal:
[?2004l[?2004h>         malicious.append((eid, ts, code, img, cmd, usr))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(malicious)} malicious events on WS-05")
