[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, timestamp, event_code, image, parent_image, command_line, user, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example';
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> malicious = []
