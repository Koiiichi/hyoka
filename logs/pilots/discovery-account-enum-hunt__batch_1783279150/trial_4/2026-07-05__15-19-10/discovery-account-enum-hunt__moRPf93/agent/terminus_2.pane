[?2004hroot@93dc786d498e:~# cat << 'EOF' > /tmp/count_malicious.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, host, user, image, parent_image, command_line, target_object, process_guid, message 
[?2004l[?2004h>     FROM events;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> all_rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> malicious_guids = {
[?2004l[?2004h>     '{b34bc01c-2f95-5f69-5f01-000000000900}', # powershell.exe
[?2004l[?2004h>     '{b34bc01c-34db-5f69-7701-000000000900}', # net.exe (localgroup admin)
[?2004l[?2004h>     '{b34bc01c-34db-5f69-7801-000000000900}', # net1.exe (localgroup admin)
[?2004l[?2004h>     '{b34bc01c-369c-5f69-7901-000000000900}', # net.exe (user)
[?2004l[?2004h>     '{b34bc01c-369c-5f69-7a01-000000000900}', # net1.exe (user)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> malicious_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> for row in all_rows:
[?2004l[?2004h>     eid, code, host, usr, img, pimg, cmd, tobj, guid, msg = row
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. Matches by malicious GUID
[?2004l[?2004h>     if guid in malicious_guids:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 2. PowerShell Pipeline / Module Logging on WS-05
[?2004l[?2004h>     if host == 'WS-05.corp.example' and code in (800, 4103):
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Security events on WS-05 related to net/net1 execution (since they may not have a process_guid)
[?2004l[?2004h>     if host == 'WS-05.corp.example':
[?2004l[?2004h>         if cmd and any(x in cmd.lower() for x in ('net.exe', 'net1.exe', 'localgroup administrators', 'net1 localgroup', 'net user', 'net1 user')):
[?2004l[?2004h>             malicious_ids.add(eid)
[?2004l[?2004h>             continue
[?2004l[?2004h>         if code in (4656, 4658, 4663, 4690) and usr == 'm.ward':
[?2004l[?2004h>             # These are security audit logs generated by the net/net1 processes
[?2004l[?2004h>             # Let's double check if we want to include them.
[?2004l[?2004h>             # Yes, they are triggered entirely by the net/net1 process querying SAM/LSA!
[?2004l[?2004h>             malicious_ids.add(eid)
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total malicious events identified: {len(malicious_ids)}")
