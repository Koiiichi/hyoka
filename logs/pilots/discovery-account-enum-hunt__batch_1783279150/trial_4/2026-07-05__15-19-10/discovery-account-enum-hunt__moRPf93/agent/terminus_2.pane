[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, host, user, message FROM events WHERE event_id = 'evt-00018';")
[?2004l[?2004h> row = cur.fetchone()
[?2004l[?2004h> if row:
[?2004l[?2004h>     eid, ts, host, user, msg = row
