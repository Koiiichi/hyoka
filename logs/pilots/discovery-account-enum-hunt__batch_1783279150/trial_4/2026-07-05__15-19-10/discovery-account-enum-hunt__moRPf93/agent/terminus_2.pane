[?2004l[?2004h>         continue
[?2004l[?2004h>     # Try to find -enc or -encodedcommand
[?2004l[?2004h>     match = re.search(r'-enc\s+([A-Za-z0-9+/=]+)', msg, re.IGNORECASE)
[?2004l[?2004h>     if match:
[?2004l[?2004h>         encoded = match.group(1)
[?2004l[?2004h>         # Pad base64
