[22.461724, "o", "\u001b[?2004hroot@93dc786d498e:~# "]
[26.780949, "i", "cat << 'EOF' > /tmp/decode_pwsh.py\nimport sqlite3\nimport re\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\"SELECT event_id, timestamp, host, user, message FROM events WHERE event_code IN (800, 4103);\")\nfor row in cur.fetchall():\n    eid, ts, host, user, msg = row\n    if not msg:\n        continue\n    # Try to find -enc or -encodedcommand\n    match = re.search(r'-enc\\s+([A-Za-z0-9+/=]+)', msg, re.IGNORECASE)\n    if match:\n        encoded = match.group(1)\n        # Pad base64\n        padded = encoded + \"=\" * ((4 - len(encoded) % 4) % 4)\n        try:\n            decoded = base64.b64decode(padded).decode('utf-16le', errors='ignore')\n            print(f\"=== {eid} | {ts} | {host} | {user} ===\")\n            print(decoded[:500]) # Print first 500 chars\n            print(\"\\n\")\n        except Exception as e:\n            pass\nEOF\npython3 /tmp/decode_pwsh.py\n"]
