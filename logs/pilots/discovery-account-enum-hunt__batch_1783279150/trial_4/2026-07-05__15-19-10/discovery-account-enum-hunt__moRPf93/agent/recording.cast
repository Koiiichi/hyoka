[107.695711, "i", "cat << 'EOF' > /tmp/all_commands.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\"SELECT event_id, timestamp, event_code, message FROM events WHERE event_code IN (800, 4103) ORDER BY timestamp;\")\nfor row in cur.fetchall():\n    eid, ts, code, msg = row\n    if not msg:\n        continue\n    if code == 800:\n        # Extract command line from \"Pipeline execution details for command line: <cmd>\"\n        m = re.search(r'command line:\\s*(.*)', msg, re.DOTALL)\n        if m:\n            cmd = m.group(1).strip()\n            print(f\"{ts} | 800 | {eid} | {cmd}\")\n    elif code == 4103:\n        # check if message contains interesting command payload\n        # sometimes 4103 contains CommandName or ParameterValues\n        print(f\"{ts} | 4103 | {eid} | {msg[:100]}...\")\nEOF\npython3 /tmp/all_commands.py > /tmp/pwsh_commands.txt\nhead -n 50 /tmp/pwsh_commands.txt\n"]
