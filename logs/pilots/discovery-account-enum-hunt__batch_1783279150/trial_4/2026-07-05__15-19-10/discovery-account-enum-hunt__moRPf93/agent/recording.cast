[265.880594, "i", "cat << 'EOF' > /tmp/list_malicious_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\"\"\"\n    SELECT event_id, event_code, host, user, image, parent_image, command_line, target_object, process_guid, message \n    FROM events;\n\"\"\")\n\nall_rows = cur.fetchall()\n\nmalicious_guids = {\n    '{b34bc01c-2f95-5f69-5f01-000000000900}', # powershell.exe\n    '{b34bc01c-34db-5f69-7701-000000000900}', # net.exe (localgroup admin)\n    '{b34bc01c-34db-5f69-7801-000000000900}', # net1.exe (localgroup admin)\n    '{b34bc01c-369c-5f69-7901-000000000900}', # net.exe (user)\n    '{b34bc01c-369c-5f69-7a01-000000000900}', # net1.exe (user)\n}\n\nmalicious_ids = set()\n\nfor row in all_rows:\n    eid, code, host, usr, img, pimg, cmd, tobj, guid, msg = row\n    \n    # 1. Matches by malicious GUID\n    if guid in malicious_guids:\n        malicious_ids.add(eid)\n        continue\n        \n    # 2. PowerShell Pipeline / Module Logging on WS-05\n    if host == 'WS-05.corp.example' and code in (800, 4103):\n        malicious_ids.add(eid)\n        continue\n        \n    # 3. Security events on WS-05 related to net/net1 execution\n    if host == 'WS-05.corp.example':\n        if cmd and any(x in cmd.lower() for x in ('net.exe', 'net1.exe', 'localgroup administrators', 'net1 localgroup', 'net user', 'net1 user')):\n            malicious_ids.add(eid)\n            continue\n        if code in (4656, 4658, 4663, 4690, 4688, 4689, 4799) and usr == 'm.ward':\n            malicious_ids.add(eid)\n            continue\n\n# Let's inspect the types of events in malicious_ids\nevents_by_code = {}\nfor row in all_rows:\n    eid, code, host, usr, img, pimg, cmd, tobj, guid, msg = row\n    if eid in malicious_ids:\n        events_by_code[code] = events_by_code.get(code, 0) + 1\n\nprint(\"Malicious events by event_code:\")\nfor code, count in sorted(events_by_code.items()):\n    print(f\"  Code {code}: {count}\")\n\nprint(f\"Total: {len(malicious_ids)}\")\nEOF\npython3 /tmp/list_malicious_events.py\n"]
[265.881083, "o", "cat << 'EOF' > /tmp/list_malicious_events.py\r\n"]
