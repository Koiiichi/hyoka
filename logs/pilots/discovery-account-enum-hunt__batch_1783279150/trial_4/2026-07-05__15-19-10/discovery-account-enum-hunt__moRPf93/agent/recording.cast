[208.877333, "i", "cat << 'EOF' > /tmp/get_malicious_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, image, parent_image, command_line, user, message \n    FROM events \n    WHERE host = 'WS-05.corp.example';\n\"\"\")\n\nmalicious = []\nfor row in cur.fetchall():\n    eid, ts, code, img, pimg, cmd, usr, msg = row\n    img_lower = img.lower() if img else ''\n    pimg_lower = pimg.lower() if pimg else ''\n    cmd_lower = cmd.lower() if cmd else ''\n    usr_lower = usr.lower() if usr else ''\n    msg_lower = msg.lower() if msg else ''\n    \n    # Check if this is powershell, net, net1\n    is_mal = False\n    if 'powershell' in img_lower or 'powershell' in pimg_lower or 'powershell' in cmd_lower or 'powershell' in msg_lower:\n        is_mal = True\n    if 'net.exe' in img_lower or 'net.exe' in pimg_lower or 'net.exe' in cmd_lower:\n        is_mal = True\n    if 'net1.exe' in img_lower or 'net1.exe' in pimg_lower or 'net1.exe' in cmd_lower:\n        is_mal = True\n    if usr_lower == 'corp\\\\m.ward' or usr_lower == 'm.ward':\n        is_mal = True\n        \n    if is_mal:\n        malicious.append((eid, ts, code, img, cmd, usr))\n\nprint(f\"Found {len(malicious)} malicious events on WS-05\")\nfor m in malicious[:20]:\n    print(m)\nEOF\npython3 /tmp/get_malicious_events.py\n"]
