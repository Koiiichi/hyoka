[92.265106, "i", "cat << 'EOF' > /tmp/classify_pwsh.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\"SELECT event_id, timestamp, event_code, message FROM events WHERE event_code IN (800, 4103) ORDER BY timestamp;\")\nrows = cur.fetchall()\nprint(f\"Total rows: {len(rows)}\")\nfor row in rows[:50]:\n    eid, ts, code, msg = row\n    if not msg:\n        print(f\"{eid} | {ts} | {code} | [empty]\")\n        continue\n    # extract some snippet of the message\n    first_line = msg.split('\\n')[0]\n    if len(first_line) > 100:\n        first_line = first_line[:100] + \"...\"\n    print(f\"{eid} | {ts} | {code} | {first_line}\")\nEOF\npython3 /tmp/classify_pwsh.py\n"]
