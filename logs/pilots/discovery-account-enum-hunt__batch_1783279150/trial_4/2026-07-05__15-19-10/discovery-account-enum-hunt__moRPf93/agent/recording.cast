[113.054102, "i", "cat << 'EOF' > /tmp/filter_pwsh.py\nimport re\n\nwith open('/tmp/pwsh_commands.txt', 'r') as f:\n    content = f.read()\n\n# Let's split by lines, but we can also just grep for iex or net.exe or other things\n# Let's find any command containing 'net' or 'iex' or 'user' or 'Group'\nlines = content.split('\\n')\nfor line in lines:\n    if 'Pipeline execution details for command line:' in line or '| 800 |' in line:\n        # Let's simplify and print lines that are not huge (longer than 200 chars are probably the base64 noise)\n        if len(line) < 300:\n            print(line)\nEOF\npython3 /tmp/filter_pwsh.py\n"]
