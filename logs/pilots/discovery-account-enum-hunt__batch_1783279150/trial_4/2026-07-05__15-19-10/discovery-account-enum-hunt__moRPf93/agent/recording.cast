[144.08019, "i", "cat << 'EOF' > /tmp/filter_ws06_time.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, image, parent_image, command_line, target_object, message\n    FROM events\n    WHERE host = 'WS-06.corp.example' \n      AND timestamp >= '2026-05-06T00:08:15Z'\n      AND timestamp <= '2026-05-06T00:08:25Z'\n    ORDER BY timestamp;\n\"\"\")\n\nfor row in cur.fetchall():\n    eid, ts, code, usr, img, pimg, cmd, tobj, msg = row\n    # filter out known noisy benign events\n    if code in (10, 7):\n        if img and 'svchost.exe' in img.lower():\n            continue\n    print(f\"{eid} | {ts} | {code} | img: {img} | pimg: {pimg} | cmd: {cmd} | tobj: {tobj}\")\nEOF\npython3 /tmp/filter_ws06_time.py\n"]
[144.080638, "o", "cat << 'EOF' > /tmp/filter_ws06_time.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
