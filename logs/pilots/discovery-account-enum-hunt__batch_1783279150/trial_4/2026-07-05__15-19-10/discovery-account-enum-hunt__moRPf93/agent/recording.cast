[282.329469, "i", "cat << 'EOF' > /tmp/write_findings.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\"\"\"\n    SELECT event_id, event_code, host, user, image, parent_image, command_line, process_guid \n    FROM events;\n\"\"\")\n\nall_rows = cur.fetchall()\n\nmalicious_guids = {\n    '{b34bc01c-2f95-5f69-5f01-000000000900}', # powershell.exe\n    '{b34bc01c-34db-5f69-7701-000000000900}', # net.exe (localgroup admin)\n    '{b34bc01c-34db-5f69-7801-000000000900}', # net1.exe (localgroup admin)\n    '{b34bc01c-369c-5f69-7901-000000000900}', # net.exe (user)\n    '{b34bc01c-369c-5f69-7a01-000000000900}', # net1.exe (user)\n}\n\nmalicious_ids = set()\n\nfor row in all_rows:\n    eid, code, host, usr, img, pimg, cmd, guid = row\n    \n    # 1. Matches by malicious GUID\n    if guid in malicious_guids:\n        malicious_ids.add(eid)\n        continue\n        \n    # 2. PowerShell Pipeline / Module Logging on WS-05\n    if host == 'WS-05.corp.example' and code in (800, 4103):\n        malicious_ids.add(eid)\n        continue\n        \n    # 3. Security events on WS-05 related to net/net1 execution\n    if host == 'WS-05.corp.example':\n        if cmd and any(x in cmd.lower() for x in ('net.exe', 'net1.exe', 'localgroup administrators', 'net1 localgroup', 'net user', 'net1 user')):\n            malicious_ids.add(eid)\n            continue\n        if code in (4656, 4658, 4663, 4690, 4688, 4689, 4799) and usr == 'm.ward':\n            malicious_ids.add(eid)\n            continue\n\nfindings = sorted(list(malicious_ids))\nprint(f\"Writing {len(findings)} malicious event IDs to /root/findings.json\")\nwith open('/root/findings.json', 'w') as f:\n    json.dump(findings, f)\nEOF\npython3 /tmp/write_findings.py\n"]
[282.329838, "o", "cat << 'EOF' > /tmp/write_findings.py\r\n\u001b[?2004l\r"]
[282.329915, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.330552, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, event_code, host, user, image, parent_image, command_line, process_guid \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> all_rows = cur.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> malicious_guids = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.33057, "o", "    '{b34bc01c-2f95-5f69-5f01-000000000900}', # powershell.exe\r\n\u001b[?2004l\r"]
[282.332205, "o", "\u001b[?2004h>     '{b34bc01c-34db-5f69-7701-000000000900}', # net.exe (localgroup admin)\r\n\u001b[?2004l\r\u001b[?2004h>     '{b34bc01c-34db-5f69-7801-000000000900}', # net1.exe (localgroup admin)\r\n\u001b[?2004l\r\u001b[?2004h>     '{b34bc01c-369c-5f69-7901-000000000900}', # net.exe (user)\r\n\u001b[?2004l\r\u001b[?2004h>     '{b34bc01c-369c-5f69-7a01-000000000900}', # net1.exe (user)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> malicious_ids = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for row in all_rows:\r\n\u001b[?2004l\r\u001b[?2004h>     eid, code, host, usr, img, pimg, cmd, guid = row\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # 1. Matches by malicious GUID\r\n\u001b[?2004l\r\u001b[?2004h>     if guid in malicious_guids:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # 2. PowerShell Pipeline / Module Logging on WS-05\r\n\u001b[?2004l\r\u001b[?2004h>     if host == 'WS-05.corp.example' and code in (800, 4103):\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # 3. Security events on WS-05 related to net/net1 execution\r\n\u001b[?2004l\r\u001b[?2004h>     if host == 'WS-05.corp.example':\r\n\u001b[?2004l\r\u001b[?2004h>         if cmd and any(x in cmd.lower() for x in ('net.exe', 'net1.exe', 'localgroup administrators', 'net1 localgroup', 'net user', 'net1 user')):\r\n\u001b[?2004l\r\u001b[?2004h>             malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.33224, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.332456, "o", "        if code in (4656, 4658, 4663, 4690, 4688, 4689, 4799) and usr == 'm.ward':\r\n\u001b[?2004l\r\u001b[?2004h>             malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.332574, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.332683, "o", "findings = sorted(list(malicious_ids))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.332723, "o", "print(f\"Writing {len(findings)} malicious event IDs to /root/findings.json\")\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[282.332828, "o", ">     json.dump(findings, f)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[282.33391, "o", "\u001b[?2004hroot@93dc786d498e:~# "]
[282.333972, "o", "python3 /tmp/write_findings.py\r\n\u001b[?2004l\r"]
[282.351781, "o", "Writing 486 malicious event IDs to /root/findings.json\r\n"]
[282.354138, "o", "\u001b[?2004hroot@93dc786d498e:~# "]
[287.25057, "i", "head -n 20 /root/findings.json\n"]
[287.251056, "o", "head -n 20 /root/findings.json\r\n\u001b[?2004l\r"]
