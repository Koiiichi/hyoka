[144.095972, "o", "\u001b[?2004hroot@93dc786d498e:~# "]
[149.693011, "i", "cat << 'EOF' > /tmp/ws06_abnormal.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, user, target_user, image, parent_image, command_line, target_object, message\n    FROM events\n    WHERE host = 'WS-06.corp.example';\n\"\"\")\n\nfor row in cur.fetchall():\n    eid, ts, code, usr, tusr, img, pimg, cmd, tobj, msg = row\n    img_lower = img.lower() if img else ''\n    pimg_lower = pimg.lower() if pimg else ''\n    cmd_lower = cmd.lower() if cmd else ''\n    \n    # Filter out standard system processes\n    if any(x in img_lower for x in ('svchost.exe', 'lsass.exe', 'csrss.exe', 'sppsvc.exe', 'wmiprvse.exe', 'services.exe', 'dwm.exe', 'fontdrvhost.exe')):\n        continue\n    if any(x in pimg_lower for x in ('svchost.exe', 'services.exe')):\n        if code in (10, 7, 12, 13):\n            continue\n            \n    print(f\"{eid} | {ts} | {code} | usr: {usr} | tusr: {tusr} | img: {img} | pimg: {pimg} | cmd: {cmd} | tobj: {tobj}\")\nEOF\npython3 /tmp/ws06_abnormal.py\n"]
[149.694671, "o", "cat << 'EOF' > /tmp/ws06_abnormal.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, event_code, user, target_user, image, parent_image, command_line, target_object, message\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events\r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'WS-06.corp.example';\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for row in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     eid, ts, code, usr, tusr, img, pimg, cmd, tobj, msg = row\r\n\u001b[?2004l\r\u001b[?2004h>     img_lower = img.lower() if img else ''\r\n\u001b[?2004l\r\u001b[?2004h>     pimg_lower = pimg.lower() if pimg else ''\r\n\u001b[?2004l\r\u001b[?2004h>     cmd_lower = cmd.lower() if cmd else ''\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Filter out standard system processes\r\n\u001b[?2004l\r\u001b[?2004h>     if any(x in img_lower for x in ('svchost.exe', 'lsass.exe', 'csrss.exe', 'sppsvc.exe', 'wmiprvse.exe', 'services.exe', 'dwm.exe', 'fontdrvhost.exe')):\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     if any(x in pimg_lower for x in ('svchost.exe', 'services.exe')):\r\n\u001b[?2004l\r\u001b[?2004h>         if code in (10, 7, 12, 13):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
