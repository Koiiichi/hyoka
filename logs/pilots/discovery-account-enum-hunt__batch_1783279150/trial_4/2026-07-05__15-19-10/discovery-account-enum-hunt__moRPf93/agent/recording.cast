[26.809242, "o", "\u001b[?2004hroot@93dc786d498e:~# "]
[31.576956, "i", "cat << 'EOF' > /tmp/decode_pwsh_full.py\nimport sqlite3\nimport re\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\"SELECT event_id, timestamp, host, user, message FROM events WHERE event_id = 'evt-00018';\")\nrow = cur.fetchone()\nif row:\n    eid, ts, host, user, msg = row\n    match = re.search(r'-enc\\s+([A-Za-z0-9+/=]+)', msg, re.IGNORECASE)\n    if match:\n        encoded = match.group(1)\n        padded = encoded + \"=\" * ((4 - len(encoded) % 4) % 4)\n        decoded = base64.b64decode(padded).decode('utf-16le', errors='ignore')\n        print(decoded)\nEOF\npython3 /tmp/decode_pwsh_full.py\n"]
