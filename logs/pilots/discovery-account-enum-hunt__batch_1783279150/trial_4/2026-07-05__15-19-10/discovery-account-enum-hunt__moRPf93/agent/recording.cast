[176.076011, "i", "cat << 'EOF' > /tmp/parse_wfp.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\"SELECT event_id, timestamp, host, message FROM events WHERE event_code = 5156 ORDER BY timestamp;\")\n\nfor row in cur.fetchall():\n    eid, ts, host, msg = row\n    if not msg:\n        continue\n    \n    # Extract App Name\n    app_match = re.search(r'Application Name:\\s*(.*)', msg)\n    app = app_match.group(1).strip() if app_match else \"Unknown\"\n    \n    # Extract Direction\n    dir_match = re.search(r'Direction:\\s*(.*)', msg)\n    direction = dir_match.group(1).strip() if dir_match else \"Unknown\"\n    \n    # Extract IPs and Ports\n    src_match = re.search(r'Source Address:\\s*(\\S+)', msg)\n    src_ip = src_match.group(1).strip() if src_match else \"Unknown\"\n    \n    dst_match = re.search(r'Destination Address:\\s*(\\S+)', msg)\n    dst_ip = dst_match.group(1).strip() if dst_match else \"Unknown\"\n    \n    port_match = re.search(r'Destination Port:\\s*(\\S+)', msg)\n    dst_port = port_match.group(1).strip() if port_match else \"Unknown\"\n    \n    print(f\"{ts} | {eid} | {host} | App: {app} | {direction} | {src_ip} -> {dst_ip}:{dst_port}\")\nEOF\npython3 /tmp/parse_wfp.py\n"]
