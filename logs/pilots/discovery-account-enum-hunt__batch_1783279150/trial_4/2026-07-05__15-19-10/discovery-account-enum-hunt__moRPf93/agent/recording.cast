[246.653605, "i", "cat << 'EOF' > /tmp/check_benign_ws05.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\"\"\"\n    SELECT event_id, event_code, user, image, parent_image, command_line, target_object, process_guid, message \n    FROM events \n    WHERE host = 'WS-05.corp.example';\n\"\"\")\n\nall_rows = cur.fetchall()\n\nmalicious_guids = {\n    '{b34bc01c-2f95-5f69-5f01-000000000900}', # powershell.exe\n    '{b34bc01c-34db-5f69-7701-000000000900}', # net.exe (localgroup admin)\n    '{b34bc01c-34db-5f69-7801-000000000900}', # net1.exe (localgroup admin)\n    '{b34bc01c-369c-5f69-7901-000000000900}', # net.exe (user)\n    '{b34bc01c-369c-5f69-7a01-000000000900}', # net1.exe (user)\n}\n\nbenign = []\nfor row in all_rows:\n    eid, code, usr, img, pimg, cmd, tobj, guid, msg = row\n    \n    is_mal = False\n    if guid in malicious_guids:\n        is_mal = True\n    elif code in (800, 4103):\n        is_mal = True\n    elif cmd and any(x in cmd.lower() for x in ('net.exe', 'net1.exe', 'localgroup administrators', 'net1 localgroup', 'net user', 'net1 user')):\n        is_mal = True\n    elif code in (4656, 4658, 4663, 4690) and usr == 'm.ward':\n        is_mal = True\n    elif code in (4688, 4689, 4799) and usr == 'm.ward':\n        is_mal = True\n        \n    if not is_mal:\n        benign.append((eid, code, usr, img, cmd))\n\nprint(f\"Total benign events on WS-05: {len(benign)}\")\nfor b in benign[:30]:\n    print(b)\nEOF\npython3 /tmp/check_benign_ws05.py\n"]
