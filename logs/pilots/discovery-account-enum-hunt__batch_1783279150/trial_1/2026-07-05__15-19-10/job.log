Sending keys: ['cat << \'EOF\' > /root/hunt.py\nimport sqlite3\nimport base64\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncursor = conn.cursor()\n\n# Let\'s inspect some powershell execution details\ncursor.execute("""\n    SELECT event_id, event_code, timestamp, host, user, command_line, message \n    FROM events \n    WHERE event_code IN (800, 4103) AND host = \'WS-05.corp.example\'\n    ORDER BY timestamp ASC;\n""")\n\npowershell_events = cursor.fetchall()\nprint(f"Total WS-05 PowerShell events: {len(powershell_events)}")\n\n# Group them by HostApplication or print some unique commands\ncommands_seen = set()\nfor row in powershell_events:\n    evt_id, code, ts, host, user, cmd_line, msg = row\n    # extract what actually was executed\n    if msg:\n        for line in msg.split(\'\\n\'):\n            if \'command line:\' in line.lower() or \'commandline:\' in line.lower() or \'pipeline execution details\' in line.lower():\n                commands_seen.add(line.strip())\n\nprint("Unique commands in message:")\nfor cmd in sorted(list(commands_seen))[:30]:\n    print(cmd)\n\nconn.close()\nEOF\npython3 /root/hunt.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
