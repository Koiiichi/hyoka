Sending keys: ['cat << \'EOF\' > /root/hunt_timeline.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncursor = conn.cursor()\n\n# Let\'s get all Event 800 and 4103 records on WS-05, and find actual executed commands/scripts.\ncursor.execute("""\n    SELECT event_id, event_code, timestamp, message \n    FROM events \n    WHERE event_code IN (800, 4103) AND host = \'WS-05.corp.example\'\n    ORDER BY timestamp ASC;\n""")\n\nevents = cursor.fetchall()\n\n# Let\'s extract command lines from Event 800\nprint("=== TIMELINE OF POWERSHELL EXECUTIONS ===")\nfor row in events:\n    evt_id, code, ts, msg = row\n    if not msg:\n        continue\n    # Try to find \'Pipeline execution details for command line:\' or similar\n    match = re.search(r\'Pipeline execution details for command line:\\s*(.*)\', msg, re.DOTALL)\n    if match:\n        cmd = match.group(1).split(\'\\n\')[0].strip()\n        # Filter out some very repetitive stager/loop functions to see the real tasks\n        # Common stager functions: sleep, webclient, random, aes, headers\n        ignore_keywords = [\n            \'Start-Sleep\', \'AesCryptoServiceProvider\', \'Get-Random\', \'WebClient\', \n            \'Headers.Add\', \'TaskURIs\', \'StringWriter\', \'Remove-Variable packet\', \n            \'0..255 | ForEach-Object\', \'Compare-Object\', \'$packet =\',\n            \'BitConverter\', \'$Script:Headers\', \'$5793.Headers\'\n        ]\n        if not any(k in cmd for k in ignore_keywords):\n            print(f"{ts} | {evt_id} | Code {code} | {cmd}")\n\nconn.close()\nEOF\npython3 /root/hunt_timeline.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
