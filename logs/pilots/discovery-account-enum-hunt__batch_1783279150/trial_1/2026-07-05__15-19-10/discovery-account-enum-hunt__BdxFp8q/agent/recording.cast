[165.479625, "i", "cat << 'EOF' > /root/search_conn.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, src_ip, dst_ip, dst_port, message\n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code IN (3, 5156) AND (\n        dst_ip = '172.18.39.6' \n        OR (timestamp BETWEEN '2026-05-06T00:08:15.000Z' AND '2026-05-06T00:08:18.000Z')\n    )\n    ORDER BY timestamp ASC;\n\"\"\")\nfor row in cursor.fetchall():\n    print(row[:6])\n    if row[6]:\n        print(row[6][:300])\nconn.close()\nEOF\npython3 /root/search_conn.py\n"]
