[130.462051, "i", "cat << 'EOF' > /root/search_wfp_powershell.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158) AND message LIKE '%powershell%'\n    ORDER BY timestamp ASC;\n\"\"\")\nfor row in cursor.fetchall():\n    print(f\"{row[0]} | Code: {row[1]} | TS: {row[2]}\")\n    print(row[3][:300])\n    print(\"-\"*80)\nconn.close()\nEOF\npython3 /root/search_wfp_powershell.py\n"]
[130.463644, "o", "cat << 'EOF' > /root/search_wfp_powershell.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, event_code, timestamp, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158) AND message LIKE '%powershell%'\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp ASC;\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{row[0]} | Code: {row[1]} | TS: {row[2]}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
