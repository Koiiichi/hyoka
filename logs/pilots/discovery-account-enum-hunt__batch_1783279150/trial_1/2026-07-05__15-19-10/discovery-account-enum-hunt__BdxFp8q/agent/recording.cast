[281.506981, "i", "cat << 'EOF' > /root/compile_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nmalicious_guids = [\n    '{b34bc01c-2f95-5f69-5f01-000000000900}',\n    '{b34bc01c-34db-5f69-7701-000000000900}',\n    '{b34bc01c-34db-5f69-7801-000000000900}',\n    '{b34bc01c-369c-5f69-7901-000000000900}',\n    '{b34bc01c-369c-5f69-7a01-000000000900}'\n]\n\n# Group 1: Events by malicious GUIDs\ncursor.execute(f\"SELECT event_id FROM events WHERE process_guid IN ({','.join(['?' for _ in malicious_guids])})\", malicious_guids)\nevt_guid = {r[0] for r in cursor.fetchall()}\n\n# Group 2: PowerShell 800 and 4103 events on WS-05\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103)\")\nevt_ps = {r[0] for r in cursor.fetchall()}\n\n# Group 3: User 'm.ward' on WS-05\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND user = 'm.ward'\")\nevt_user = {r[0] for r in cursor.fetchall()}\n\nfinal_set = evt_guid | evt_ps | evt_user\n\nprint(f\"GUID events: {len(evt_guid)}\")\nprint(f\"PowerShell events: {len(evt_ps)}\")\nprint(f\"User 'm.ward' events: {len(evt_user)}\")\nprint(f\"Total distinct malicious events: {len(final_set)}\")\n\nconn.close()\nEOF\npython3 /root/compile_events.py\n"]
