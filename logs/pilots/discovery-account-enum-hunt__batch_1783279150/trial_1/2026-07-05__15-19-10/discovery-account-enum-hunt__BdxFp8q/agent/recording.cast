[226.62078, "i", "cat << 'EOF' > /root/verify_ps_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Count Event 800/4103 logs on WS-05\ncursor.execute(\"SELECT COUNT(*) FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103);\")\ntotal = cursor.fetchone()[0]\n\n# Count those that match the malicious powershell user CORP\\m.ward and ConsoleHost\ncursor.execute(\"SELECT COUNT(*) FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103) AND message LIKE '%m.ward%'\")\nmatching = cursor.fetchone()[0]\n\nprint(f\"Total PowerShell events: {total}\")\nprint(f\"PowerShell events with m.ward: {matching}\")\nconn.close()\nEOF\npython3 /root/verify_ps_events.py\n"]
