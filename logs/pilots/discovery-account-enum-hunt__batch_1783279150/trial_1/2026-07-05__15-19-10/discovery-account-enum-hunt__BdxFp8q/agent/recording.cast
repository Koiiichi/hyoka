[81.081628, "i", "cat << 'EOF' > /root/inspect_columns.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"SELECT * FROM events WHERE event_id = 'evt-00042'\")\nrow = cursor.fetchone()\ncolnames = [d[0] for d in cursor.description]\nfor name, val in zip(colnames, row):\n    if val is not None and str(val).strip() != '':\n        print(f\"{name}: {val}\")\nconn.close()\nEOF\npython3 /root/inspect_columns.py\n"]
