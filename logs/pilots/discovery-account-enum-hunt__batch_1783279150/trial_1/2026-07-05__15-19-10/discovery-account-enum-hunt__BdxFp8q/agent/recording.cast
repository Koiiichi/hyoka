[195.893268, "i", "cat << 'EOF' > /root/inspect_wmi_dc01.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, message, details \n    FROM events \n    WHERE host = 'DC01.corp.example' AND event_code = 5858\n    ORDER BY timestamp ASC;\n\"\"\")\nfor row in cursor.fetchall()[:20]:\n    print(f\"ID: {row[0]} | TS: {row[1]}\")\n    if row[2]: print(f\"Msg: {row[2][:300]}\")\n    if row[3]: print(f\"Details: {row[3][:300]}\")\n    print(\"-\"*80)\nconn.close()\nEOF\npython3 /root/inspect_wmi_dc01.py\n"]
