[58.098542, "o", "Unique commands in message:\r\nPipeline execution details for command line:                                     $taskURI = $Script:TaskURIs | Get-Random\r\nPipeline execution details for command line:                                 $5793 = New-Object System.Net.WebClient\r\nPipeline execution details for command line:                                 $Script:Headers.GetEnumerator() | ForEach-Object {$5793.Headers.Add($_.Name, $_.Value)}\r\nPipeline execution details for command line:                                 $script:Headers.GetEnumerator() | % {$5793.Headers.Add($_.Name, $_.Value)}\r\nPipeline execution details for command line:                                 $taskURI = $script:TaskURIs | Get-Random\r\nPipeline execution details for command line:                 $AES=New-Object System.Security.Cryptography.AesCryptoServiceProvider;\r\nPipeline execution details for command line:                 $StringWriter = New-Object IO.StringWriter\r\nPipeline execution details for command line:                 $output = iex \"$cmdargs\" | out-string\r\nPipeline execution details for command line:             $AES=New-Object System.Security.Cryptography.AesCryptoServiceProvider;\r\nPipeline execution details for command line:             0..255 | ForEach-Object {\r\n"]
[58.098607, "o", "Pipeline execution details for command line:             Start-Sleep -Seconds $sleepTime;\r\nPipeline execution details for command line:             if (@(Compare-Object $mac $expected -sync 0).Length -ne 0) {\r\nPipeline execution details for command line:         \"`n\"+($output | Format-Table -wrap | Out-String)\r\nPipeline execution details for command line:         $IV = [byte] 0..255 | Get-Random -count 16\r\nPipeline execution details for command line:         $IV=[BitConverter]::GetBytes($(Get-Random));\r\nPipeline execution details for command line:         $packet = New-Object Byte[] (12 + $data.Length)\r\nPipeline execution details for command line:         Remove-Variable packet;\r\n"]
[58.100427, "o", "\u001b[?2004hroot@0a798827f9bf:~# "]
[66.058796, "i", "cat << 'EOF' > /root/hunt_timeline.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's get all Event 800 and 4103 records on WS-05, and find actual executed commands/scripts.\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, message \n    FROM events \n    WHERE event_code IN (800, 4103) AND host = 'WS-05.corp.example'\n    ORDER BY timestamp ASC;\n\"\"\")\n\nevents = cursor.fetchall()\n\n# Let's extract command lines from Event 800\nprint(\"=== TIMELINE OF POWERSHELL EXECUTIONS ===\")\nfor row in events:\n    evt_id, code, ts, msg = row\n    if not msg:\n        continue\n    # Try to find 'Pipeline execution details for command line:' or similar\n    match = re.search(r'Pipeline execution details for command line:\\s*(.*)', msg, re.DOTALL)\n    if match:\n        cmd = match.group(1).split('\\n')[0].strip()\n        # Filter out some very repetitive stager/loop functions to see the real tasks\n        # Common stager functions: sleep, webclient, random, aes, headers\n        ignore_keywords = [\n            'Start-Sleep', 'AesCryptoServiceProvider', 'Get-Random', 'WebClient', \n            'Headers.Add', 'TaskURIs', 'StringWriter', 'Remove-Variable packet', \n            '0..255 | ForEach-Object', 'Compare-Object', '$packet =',\n            'BitConverter', '$Script:Headers', '$5793.Headers'\n        ]\n        if not any(k in cmd for k in ignore_keywords):\n            print(f\"{ts} | {evt_id} | Code {code} | {cmd}\")\n\nconn.close()\nEOF\npython3 /root/hunt_timeline.py\n"]
