[176.138451, "i", "cat << 'EOF' > /root/search_ws06_conn_clean.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, message\n    FROM events \n    WHERE host = 'WS-06.corp.example' AND event_code IN (3, 5156)\n    AND timestamp BETWEEN '2026-05-06T00:08:15.000Z' AND '2026-05-06T00:08:25.000Z'\n    ORDER BY timestamp ASC;\n\"\"\")\nfor row in cursor.fetchall():\n    evt_id, code, ts, msg = row\n    if not msg:\n        continue\n    # extract src, dst and ports if possible\n    src_ip = \"\"\n    dst_ip = \"\"\n    dst_port = \"\"\n    app = \"\"\n    for line in msg.split('\\n'):\n        if \"Source Address:\" in line or \"Source Address\" in line:\n            src_ip = line.split()[-1]\n        if \"Destination Address:\" in line or \"Destination Address\" in line:\n            dst_ip = line.split()[-1]\n        if \"Destination Port:\" in line or \"Destination Port\" in line:\n            dst_port = line.split()[-1]\n        if \"Application Name:\" in line or \"Application Name\" in line:\n            app = line.split()[-1]\n    \n    # Filter broadcast / local multicast\n    if dst_ip in ['224.0.0.252', '172.18.39.255', '239.255.255.250']:\n        continue\n    print(f\"{ts} | {evt_id} | Code: {code} | Src: {src_ip} | Dst: {dst_ip}:{dst_port} | App: {app}\")\n\nconn.close()\nEOF\npython3 /root/search_ws06_conn_clean.py\n"]
