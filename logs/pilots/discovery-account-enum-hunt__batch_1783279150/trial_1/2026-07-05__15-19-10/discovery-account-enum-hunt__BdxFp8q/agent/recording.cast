[241.775713, "i", "cat << 'EOF' > /root/check_remaining_ws05.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Get the list of IDs from the previous script\n# (We will just compute them dynamically here)\nmalicious_guids = [\n    '{b34bc01c-2f95-5f69-5f01-000000000900}',\n    '{b34bc01c-34db-5f69-7701-000000000900}',\n    '{b34bc01c-34db-5f69-7801-000000000900}',\n    '{b34bc01c-369c-5f69-7901-000000000900}',\n    '{b34bc01c-369c-5f69-7a01-000000000900}'\n]\nsecurity_proc_ids = ['evt-00172', 'evt-00173', 'evt-01108', 'evt-01109']\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, image, parent_image, command_line, details, message\n    FROM events \n    WHERE host = 'WS-05.corp.example'\n    AND event_id NOT IN (SELECT event_id FROM events WHERE process_guid IN (?,?,?,?,?))\n    AND event_id NOT IN ('evt-00172', 'evt-00173', 'evt-01108', 'evt-01109')\n    AND event_code NOT IN (800, 4103)\n    ORDER BY timestamp ASC;\n\"\"\", malicious_guids)\n\nrows = cursor.fetchall()\nprint(f\"Remaining events on WS-05: {len(rows)}\")\nfor r in rows[:100]:\n    print(f\"{r[2]} | {r[0]} | Code: {r[1]} | Img: {r[3]} | Parent: {r[4]} | Cmd: {r[5]}\")\nconn.close()\nEOF\npython3 /root/check_remaining_ws05.py | head -n 40\n"]
