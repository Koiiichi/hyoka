[251.000209, "i", "cat << 'EOF' > /root/check_security_ws05.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, target_user, details, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n    AND channel = 'Security'\n    AND (\n        (timestamp BETWEEN '2026-05-06T00:00:07.000Z' AND '2026-05-06T00:00:12.000Z')\n        OR (timestamp BETWEEN '2026-05-06T00:07:36.000Z' AND '2026-05-06T00:07:41.000Z')\n    )\n    ORDER BY timestamp ASC;\n\"\"\")\nfor r in cursor.fetchall():\n    print(f\"{r[2]} | {r[0]} | Code: {r[1]} | User: {r[3]} | Target: {r[4]}\")\n    if r[5] or r[6]:\n        print(f\"  Details/Msg: {str(r[5])[:150]} / {str(r[6])[:150]}\")\nconn.close()\nEOF\npython3 /root/check_security_ws05.py\n"]
[251.000847, "o", "cat << 'EOF' > /root/check_security_ws05.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
