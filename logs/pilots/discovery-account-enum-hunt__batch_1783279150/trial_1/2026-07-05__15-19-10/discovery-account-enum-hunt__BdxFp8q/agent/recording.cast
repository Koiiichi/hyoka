[99.192742, "i", "cat << 'EOF' > /root/inspect_ws06_files.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, target_object, details, message \n    FROM events \n    WHERE host = 'WS-06.corp.example' AND event_code IN (11, 18)\n    ORDER BY timestamp ASC;\n\"\"\")\nfor row in cursor.fetchall():\n    print(f\"ID: {row[0]} | Code: {row[1]} | TS: {row[2]}\")\n    print(f\"User: {row[3]} | Image: {row[4]}\")\n    print(f\"Target/Details: {row[5]} / {row[6]}\")\n    if row[7]:\n        print(f\"Msg: {row[7][:500]}\")\n    print(\"-\"*80)\nconn.close()\nEOF\npython3 /root/inspect_ws06_files.py\n"]
