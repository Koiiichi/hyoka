[73.097618, "i", "cat << 'EOF' > /root/hunt_4103.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's select all 4103 events on WS-05\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, message \n    FROM events \n    WHERE event_code = 4103 AND host = 'WS-05.corp.example' AND (\n        timestamp LIKE '2026-05-06T00:00:08%'\n        OR timestamp LIKE '2026-05-06T00:07:37%'\n    )\n    ORDER BY timestamp ASC;\n\"\"\")\n\nfor row in cursor.fetchall():\n    print(f\"ID: {row[0]} | TS: {row[1]}\")\n    print(row[2][:1000])\n    print(\"-\"*80)\n\nconn.close()\nEOF\npython3 /root/hunt_4103.py | head -n 40\n"]
