[159.072922, "i", "cat << 'EOF' > /root/inspect_reg.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, target_object, details \n    FROM events \n    WHERE process_guid = '{b34bc01c-2f95-5f69-5f01-000000000900}' AND event_code IN (12, 13)\n    ORDER BY timestamp ASC;\n\"\"\")\nfor row in cursor.fetchall():\n    print(row)\nconn.close()\nEOF\npython3 /root/inspect_reg.py\n"]
