[281.509898, "o", "print(f\"PowerShell events: {len(evt_ps)}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"User 'm.ward' events: {len(evt_user)}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total distinct malicious events: {len(final_set)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[281.510853, "o", "\u001b[?2004hroot@0a798827f9bf:~# python3 /root/compile_events.py\r\n\u001b[?2004l\r"]
[281.524038, "o", "GUID events: 114\r\nPowerShell events: 343\r\nUser 'm.ward' events: 29\r\nTotal distinct malicious events: 486\r\n"]
[281.525994, "o", "\u001b[?2004hroot@0a798827f9bf:~# "]
[289.657694, "i", "cat << 'EOF' > /root/save_findings.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nmalicious_guids = [\n    '{b34bc01c-2f95-5f69-5f01-000000000900}', # powershell.exe\n    '{b34bc01c-34db-5f69-7701-000000000900}', # net.exe localgroup Admins\n    '{b34bc01c-34db-5f69-7801-000000000900}', # net1.exe localgroup Admins\n    '{b34bc01c-369c-5f69-7901-000000000900}', # net.exe user\n    '{b34bc01c-369c-5f69-7a01-000000000900}'  # net1.exe user\n]\n\n# Group 1: Events by malicious GUIDs\ncursor.execute(f\"SELECT event_id FROM events WHERE process_guid IN ({','.join(['?' for _ in malicious_guids])})\", malicious_guids)\nevt_guid = {r[0] for r in cursor.fetchall()}\n\n# Group 2: PowerShell 800 and 4103 events on WS-05\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103)\")\nevt_ps = {r[0] for r in cursor.fetchall()}\n\n# Group 3: User 'm.ward' on WS-05\ncursor.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND user = 'm.ward'\")\nevt_user = {r[0] for r in cursor.fetchall()}\n\nfinal_set = sorted(list(evt_guid | evt_ps | evt_user))\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(final_set, f)\n\nprint(f\"Saved {len(final_set)} malicious event IDs to /root/findings.json\")\nconn.close()\nEOF\npython3 /root/save_findings.py\n"]
[289.657985, "o", "cat << 'EOF' > /root/save_findings.py\r\n"]
