[235.020909, "i", "cat << 'EOF' > /root/get_malicious.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Define the malicious process guids\nmalicious_guids = [\n    '{b34bc01c-2f95-5f69-5f01-000000000900}', # powershell.exe\n    '{b34bc01c-34db-5f69-7701-000000000900}', # net.exe localgroup Admins\n    '{b34bc01c-34db-5f69-7801-000000000900}', # net1.exe localgroup Admins\n    '{b34bc01c-369c-5f69-7901-000000000900}', # net.exe user\n    '{b34bc01c-369c-5f69-7a01-000000000900}'  # net1.exe user\n]\n\n# Security log process creation IDs\nsecurity_proc_ids = ['evt-00172', 'evt-00173', 'evt-01108', 'evt-01109']\n\n# Fetch all events matching these GUIDs\nquery = f\"\"\"\n    SELECT event_id, event_code, host, image, parent_image \n    FROM events \n    WHERE process_guid IN ({','.join(['?' for _ in malicious_guids])})\n\"\"\"\ncursor.execute(query, malicious_guids)\nrows1 = cursor.fetchall()\n\n# Fetch all Event 800 and 4103 on WS-05\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, image, parent_image \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103)\n\"\"\")\nrows2 = cursor.fetchall()\n\n# Security process creations\ncursor.execute(f\"\"\"\n    SELECT event_id, event_code, host, image, parent_image \n    FROM events \n    WHERE event_id IN ({','.join(['?' for _ in security_proc_ids])})\n\"\"\", security_proc_ids)\nrows3 = cursor.fetchall()\n\nall_malicious_events = set()\nfor r in rows1 + rows2 + rows3:\n    all_malicious_events.add(r[0])\n\nprint(f\"Total unique malicious events collected: {len(all_malicious_events)}\")\nconn.close()\nEOF\npython3 /root/get_malicious.py\n"]
