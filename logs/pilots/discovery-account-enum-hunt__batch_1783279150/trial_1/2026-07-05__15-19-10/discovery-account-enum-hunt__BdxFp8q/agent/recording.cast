[140.16399, "i", "cat << 'EOF' > /root/find_guids.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, image, parent_image, process_guid \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code IN (1, 7, 10, 11, 12, 13, 18)\n    ORDER BY timestamp ASC;\n\"\"\")\nfor row in cursor.fetchall()[:100]:\n    print(row)\nconn.close()\nEOF\npython3 /root/find_guids.py | head -n 40\n"]
