[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import base64
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect some powershell execution details
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, host, user, command_line, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE event_code IN (800, 4103) AND host = 'WS-05.corp.example'
[?2004l[?2004h>     ORDER BY timestamp ASC;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> powershell_events = cursor.fetchall()
[?2004l[?2004h> print(f"Total WS-05 PowerShell events: {len(powershell_events)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Group them by HostApplication or print some unique commands
[?2004l[?2004h> commands_seen = set()
[?2004l[?2004h> for row in powershell_events:
[?2004l[?2004h>     evt_id, code, ts, host, user, cmd_line, msg = row
[?2004l[?2004h>     # extract what actually was executed
[?2004l[?2004h>     if msg:
[?2004l[?2004h>         for line in msg.split('\n'):
[?2004l[?2004h>             if 'command line:' in line.lower() or 'commandline:' in line.lower() or 'pipeline execution details' in line.lower():
[?2004l[?2004h>                 commands_seen.add(line.strip())
[?2004l[?2004h> 
[?2004l[?2004h> print("Unique commands in message:")
[?2004l[?2004h> for cmd in sorted(list(commands_seen))[:30]:
[?2004l[?2004h>     print(cmd)
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
