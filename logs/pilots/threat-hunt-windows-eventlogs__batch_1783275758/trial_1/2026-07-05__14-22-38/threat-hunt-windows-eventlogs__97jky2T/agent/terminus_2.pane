[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> curr = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's gather all events from the database
[?2004l[?2004h> curr.execute("SELECT event_id, event_code, host, timestamp, user, image, target_image, message FROM events;")
[?2004l[?2004h> all_events = curr.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> malicious = set()
[?2004l[?2004h> 
[?2004l[?2004h> for eid, code, host, ts, user, img, tg_img, msg in all_events:
[?2004l[?2004h>     # 1. Sysmon process guid checks
[?2004l[?2004h>     # We know the malicious GUIDs
[?2004l[?2004h>     m_guids = ['{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}']
[?2004l[?2004h>     
[?2004l[?2004h>     # Check message or any other fields for these guids
[?2004l[?2004h>     has_guid = False
[?2004l[?2004h>     for g in m_guids:
[?2004l[?2004h>         if g in (msg or ""):
[?2004l[?2004h>             has_guid = True
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>     # 2. PowerShell Event Codes (800, 4103) - we verified all are from the malicious session
[?2004l[?2004h>     is_powershell_log = (code in [800, 4103])
[?2004l[?2004h>     
[?2004l[?2004h>     # 3. Security Event Log PID checks (Process ID 0x670, 0x1968 or decimal equivalents 1648, 6504)
[?2004l[?2004h>     has_pid = False
[?2004l[?2004h>     # We look for structured PID patterns in the message to avoid arbitrary number matching
[?2004l[?2004h>     # e.g., 'Process ID:0x670', 'Creator Process ID:0x670', 'Source Process ID:0x670'
[?2004l[?2004h>     # Let's search for hex or decimal in message
[?2004l[?2004h>     pid_patterns = [
[?2004l[?2004h>         r'Process ID:\s*(0x670|1648|0x1968|6504)\b',
