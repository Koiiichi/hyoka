[154.439135, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT event_id, host, timestamp, user, message FROM events WHERE event_code = 4624 AND host LIKE 'WS-05%';\")\nrows = curr.fetchall()\nprint(\"Logon events on WS-05:\", len(rows))\nfor row in rows:\n    print(row[0], row[1], row[2], row[3])\nEOF\npython3 /tmp/hunt.py\n"]
