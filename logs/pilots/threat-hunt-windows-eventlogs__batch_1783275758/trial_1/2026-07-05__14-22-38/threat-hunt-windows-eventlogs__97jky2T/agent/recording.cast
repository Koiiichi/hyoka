[33.877392, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\nprint(\"=== PROCESS CREATION EVENTS (1, 4688) ===\")\ncurr.execute(\"\"\"SELECT event_id, event_code, host, timestamp, user, image, message \n               FROM events \n               WHERE event_code IN (1, 4688) \n               ORDER BY timestamp;\"\"\")\nfor row in curr.fetchall():\n    print(row[0], row[1], row[2], row[3], row[4], row[5])\n    # print full command line / message\n    print(row[6])\n    print(\"-\"*50)\nEOF\npython3 /tmp/hunt.py\n"]
