[60.618469, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\nprint(\"=== DC01 Events ===\")\ncurr.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host LIKE 'DC01%' GROUP BY event_code;\")\nprint(curr.fetchall())\n\nprint(\"=== WS-06 Events ===\")\ncurr.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host LIKE 'WS-06%' GROUP BY event_code;\")\nprint(curr.fetchall())\nEOF\npython3 /tmp/hunt.py\n"]
