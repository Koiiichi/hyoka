[167.411457, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\nprint(\"=== Event 5 (Process terminated) ===\")\ncurr.execute(\"SELECT event_id, image, message FROM events WHERE event_code = 5 AND host LIKE 'WS-05%';\")\nfor row in curr.fetchall():\n    print(row[0], row[1])\n\nprint(\"=== Event 9 (RawAccessRead) ===\")\ncurr.execute(\"SELECT event_id, image, message FROM events WHERE event_code = 9 AND host LIKE 'WS-05%';\")\nfor row in curr.fetchall():\n    print(row[0], row[1])\n    print(row[2][:200])\n\nprint(\"=== Event 17 & 18 (Pipes) ===\")\ncurr.execute(\"SELECT event_id, event_code, image, message FROM events WHERE event_code IN (17, 18) AND host LIKE 'WS-05%';\")\nfor row in curr.fetchall():\n    print(row[0], row[1], row[2])\n\nprint(\"=== Event 4689 (Process Exit) ===\")\ncurr.execute(\"SELECT event_id, message FROM events WHERE event_code = 4689 AND host LIKE 'WS-05%';\")\nfor row in curr.fetchall():\n    print(row[0])\n    # extract process name / ID\n    for line in row[1].split('\\n'):\n        if \"Process Name:\" in line or \"Process ID:\" in line:\n            print(\"  \", line.strip())\nEOF\npython3 /tmp/hunt.py\n"]
