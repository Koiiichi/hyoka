[66.304702, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\nprint(\"=== 4624 Logon Events ===\")\ncurr.execute(\"SELECT event_id, host, timestamp, user, message FROM events WHERE event_code = 4624;\")\nfor row in curr.fetchall():\n    print(row[0], row[1], row[2], row[3])\n    # extract Logon Type and Source Network Address if present in message\n    msg = row[4]\n    logon_type = \"\"\n    ip = \"\"\n    for line in msg.split('\\n'):\n        if \"Logon Type:\" in line:\n            logon_type = line.strip()\n        if \"Source Network Address:\" in line:\n            ip = line.strip()\n    print(f\"  {logon_type} | {ip}\")\n\nprint(\"=== Event 5 (Process Terminated) ===\")\ncurr.execute(\"SELECT event_id, host, timestamp, image, message FROM events WHERE event_code = 5;\")\nfor row in curr.fetchall():\n    print(row[0], row[1], row[2], row[3])\nEOF\npython3 /tmp/hunt.py\n"]
