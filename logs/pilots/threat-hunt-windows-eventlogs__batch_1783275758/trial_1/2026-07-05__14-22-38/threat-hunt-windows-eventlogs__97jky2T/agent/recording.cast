[143.455909, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\n# Find all event_ids directly associated with the powershell session or its child\ncurr.execute(\"\"\"\nSELECT event_id, event_code, host, image, target_image, message \nFROM events \nWHERE \n    process_guid IN ('{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}') \n    OR event_code IN (800, 4103)\n    OR message LIKE '%{297bc33e-65d0-5f2d-8207-000000000400}%'\n    OR message LIKE '%{297bc33e-660d-5f2d-8407-000000000400}%'\n;\"\"\")\n\nevents = curr.fetchall()\nprint(\"Count of matched malicious events:\", len(events))\n\n# Let's see some breakdown of event_codes\nfrom collections import Counter\nc = Counter([e[1] for e in events])\nprint(\"Event code breakdown:\", c)\nEOF\npython3 /tmp/hunt.py\n"]
