[51.687194, "i", "cat << 'EOF' > /tmp/powershell.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\ncurr.execute(\"\"\"SELECT event_id, timestamp, message \n               FROM events \n               WHERE event_code IN (800, 4103) \n               ORDER BY timestamp;\"\"\")\n\nseen = set()\nnoise = [\n    'Add-Member', 'Win32Constants', 'IMAGE_NT_HEADERS', 'System.Object', 'NoteProperty', \n    'IMAGE_REL_BASED', 'TypeBuilder', 'DefineField', 'DefineConstructor', 'System.Reflection', \n    'FieldBuilder', 'CustomAttributeBuilder', 'AssemblyBuilder', 'ModuleBuilder', 'LocalBuilder', \n    'CallingConventions', 'MethodBuilder', 'DefineMethod', 'DefinePInvokeMethod', 'ILGenerator', \n    'Emit', 'OpCodes', 'UnsafeNativeMethods', 'Marshal', 'IntPtr', 'UInt32', 'Int32', 'UInt16', 'Byte[]'\n]\nfor event_id, timestamp, message in curr.fetchall():\n    # Check message for commands\n    # Let's extract command lines or command names\n    lines = []\n    for line in message.split('\\n'):\n        line = line.strip()\n        if not line:\n            continue\n        if any(n in line for n in noise):\n            continue\n        if len(line) < 10:\n            continue\n        lines.append(line)\n    \n    if lines:\n        joined = \" \".join(lines)[:300]\n        if joined in seen:\n            continue\n        seen.add(joined)\n        print(f\"{timestamp} [{event_id}] {joined}\")\nEOF\npython3 /tmp/powershell.py | head -n 40\n"]
