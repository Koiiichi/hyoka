[24.498313, "o", "# Let's find PowerShell script block logging or module logging events that contain interesting strings\r\n\u001b[?2004l\r\u001b[?2004h> curr.execute(\"SELECT event_id, event_code, host, timestamp, message FROM events WHERE event_code IN (800, 4103) LIMIT 10;\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in curr.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(row[0], row[1], row[2], row[3])\r\n\u001b[?2004l\r\u001b[?2004h>     print(row[4][:200])\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"-\"*50)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
