[204.769509, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"SELECT event_id, event_code, message \n               FROM events \n               WHERE event_code IN (5156, 5158) AND host LIKE 'WS-05%'\n                 AND (message LIKE '%powershell.exe%' \n                      OR message LIKE '%0x670%' \n                      OR message LIKE '%1648%');\"\"\")\nrows = curr.fetchall()\nprint(\"Matched WFP events:\", len(rows))\nfor r in rows[:10]:\n    print(r[0], r[1])\n    # extract application name and direction/port\n    app = \"\"\n    direction = \"\"\n    port = \"\"\n    ip = \"\"\n    for line in r[2].split('\\n'):\n        if \"Application Name:\" in line:\n            app = line.strip()\n        if \"Direction:\" in line:\n            direction = line.strip()\n        if \"Source Address:\" in line:\n            ip = line.strip()\n        if \"Source Port:\" in line:\n            port = line.strip()\n    print(f\"  {app} | {direction} | {ip}:{port}\")\nEOF\npython3 /tmp/hunt.py\n"]
