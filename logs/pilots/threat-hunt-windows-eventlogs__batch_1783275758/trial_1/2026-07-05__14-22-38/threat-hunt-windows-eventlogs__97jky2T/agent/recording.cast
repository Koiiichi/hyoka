[195.425666, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"SELECT event_id, event_code, message \n               FROM events \n               WHERE event_code IN (4673, 4703, 4670) AND host LIKE 'WS-05%';\"\"\")\nfor row in curr.fetchall():\n    print(row[0], row[1])\n    # extract Process ID, Service Name, Privilege etc.\n    lines = []\n    for line in row[2].split('\\n'):\n        line = line.strip()\n        if any(k in line for k in ['Process ID', 'Service Name', 'Privilege', 'Process Name', 'Account Name', 'Object Name']):\n            lines.append(line)\n    print(\"  \", \" | \".join(lines))\nEOF\npython3 /tmp/hunt.py\n"]
