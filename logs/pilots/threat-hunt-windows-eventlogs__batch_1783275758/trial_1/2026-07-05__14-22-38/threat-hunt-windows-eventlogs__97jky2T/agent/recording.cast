[218.478449, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\nprint(\"=== Other small-count events on WS-05 ===\")\ncurr.execute(\"\"\"SELECT event_id, event_code, image, message \n               FROM events \n               WHERE host LIKE 'WS-05%'\n                 AND event_code IN (4656, 4658, 4663, 4670, 4690);\"\"\")\nfor row in curr.fetchall():\n    print(row[0], row[1], row[2])\n    # print some details\n    for line in row[3].split('\\n'):\n        if any(k in line for k in ['Object Name', 'Process ID', 'Accesses', 'Account Name']):\n            print(\"  \", line.strip())\nEOF\npython3 /tmp/hunt.py\n"]
