[122.572438, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"SELECT event_id, host, image, target_image, granted_access, COUNT(*)\n               FROM events \n               WHERE event_code = 10 \n               GROUP BY host, image, target_image, granted_access;\"\"\")\nfor row in curr.fetchall():\n    print(row)\nEOF\npython3 /tmp/hunt.py\n"]
