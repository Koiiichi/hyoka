SE):\r\n\u001b[?2004l\r\u001b[?2004h>             has_pid = True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # 4. Prefetch file creation we found earlier\r\n\u001b[?2004l\r\u001b[?2004h>     is_prefetch = (code == 11 and \"WHOAMI.EXE\" in (msg or \"\"))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if has_guid or is_powershell_log or has_pid or is_prefetch:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Total malicious candidate events identified:\", len(malicious))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's inspect some of these to check if we missed anything or got any false positives\r\n\u001b[?2004l\r\u001b[?2004h> # Let's see the count per event code\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> codes = []\r\n\u001b[?2004l\r\u001b[?2004h> curr.execute(\"SELECT event_id, event_code FROM events;\")\r\n\u001b[?2004l\r\u001b[?2004h> for eid, code in curr.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     if eid in malicious:\r\n\u001b[?2004l\r\u001b[?2004h>         codes.append(code)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Breakdown:\", Counter(codes))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
