[40.025206, "i", "cat << 'EOF' > /tmp/powershell.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\n# Let's extract PowerShell 800 events\ncurr.execute(\"\"\"SELECT event_id, timestamp, message \n               FROM events \n               WHERE event_code = 800 \n               ORDER BY timestamp;\"\"\")\n\nseen = set()\nfor event_id, timestamp, message in curr.fetchall():\n    # extract command line from message\n    # Format usually starts with 'Pipeline execution details for command line: ' or contains it\n    m = re.search(r'Pipeline execution details for command line:\\s*(.*)', message)\n    if m:\n        cmd = m.group(1).strip()\n        # Simple deduplication of identical consecutive commands or common beacon noise\n        if cmd in seen:\n            continue\n        seen.add(cmd)\n        print(f\"{timestamp} [{event_id}] {cmd[:150]}\")\nEOF\npython3 /tmp/powershell.py\n"]
