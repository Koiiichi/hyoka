[92.04087, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"SELECT event_id, event_code, host, timestamp, user \n               FROM events \n               WHERE (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%') \n                 AND host NOT LIKE 'WS-05%';\"\"\")\nprint(\"Non-WS-05 pgustavo events:\", curr.fetchall())\nEOF\npython3 /tmp/hunt.py\n"]
