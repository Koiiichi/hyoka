[247.805919, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"SELECT event_id, event_code, message \n               FROM events \n               WHERE host LIKE 'WS-05%' AND event_code IN (400, 600);\"\"\")\nfor row in curr.fetchall():\n    print(row[0], row[1])\n    # check if 'ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b' (the malicious session's Host ID) is in message\n    if 'ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b' in row[2]:\n        print(\"  -> Matches malicious session Host ID!\")\n    else:\n        print(\"  -> Does NOT match malicious session Host ID!\")\nEOF\npython3 /tmp/hunt.py\n"]
