[136.070959, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"SELECT DISTINCT image, process_guid \n               FROM events \n               WHERE (image LIKE '%powershell.exe%' OR message LIKE '%powershell.exe%') \n                 AND process_guid IS NOT NULL AND process_guid != '';\"\"\")\nprint(curr.fetchall())\nEOF\npython3 /tmp/hunt.py\n"]
