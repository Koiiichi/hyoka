[70.721452, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\nprint(\"=== Event 3 IP combinations ===\")\ncurr.execute(\"SELECT host, src_ip, dst_ip, dst_port, COUNT(*) FROM events WHERE event_code = 3 GROUP BY host, src_ip, dst_ip, dst_port;\")\nfor row in curr.fetchall():\n    print(row)\n\nprint(\"=== Event 5156 IP combinations ===\")\ncurr.execute(\"SELECT host, src_ip, dst_ip, dst_port, COUNT(*) FROM events WHERE event_code = 5156 GROUP BY host, src_ip, dst_ip, dst_port;\")\nfor row in curr.fetchall():\n    print(row)\nEOF\npython3 /tmp/hunt.py\n"]
