[45.56997, "i", "cat << 'EOF' > /tmp/powershell.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\ncurr.execute(\"\"\"SELECT event_id, timestamp, message \n               FROM events \n               WHERE event_code = 800 \n               ORDER BY timestamp;\"\"\")\n\nseen = set()\nfor event_id, timestamp, message in curr.fetchall():\n    m = re.search(r'Pipeline execution details for command line:\\s*(.*)', message)\n    if m:\n        cmd = m.group(1).strip()\n        # Filter out boring/common stuff to see unique actions\n        if any(x in cmd for x in ['Add-Member', 'Win32Constants', 'IMAGE_NT_HEADERS', 'System.Object', 'NoteProperty', 'IMAGE_REL_BASED']):\n            continue\n        if cmd in seen:\n            continue\n        seen.add(cmd)\n        print(f\"{timestamp} [{event_id}] {cmd[:200]}\")\nEOF\npython3 /tmp/powershell.py\n"]
