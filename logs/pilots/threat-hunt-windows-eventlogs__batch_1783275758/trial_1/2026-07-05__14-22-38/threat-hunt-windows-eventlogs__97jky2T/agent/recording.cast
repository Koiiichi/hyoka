[29.958045, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT host, COUNT(*) FROM events GROUP BY host;\")\nprint(\"Events per host:\", curr.fetchall())\n\ncurr.execute(\"SELECT user, COUNT(*) FROM events GROUP BY user;\")\nprint(\"Events per user:\", curr.fetchall())\n\ncurr.execute(\"SELECT DISTINCT host, user FROM events WHERE user IS NOT NULL AND user != '';\")\nprint(\"Host/User pairs:\", curr.fetchall())\n\nEOF\npython3 /tmp/hunt.py\n"]
