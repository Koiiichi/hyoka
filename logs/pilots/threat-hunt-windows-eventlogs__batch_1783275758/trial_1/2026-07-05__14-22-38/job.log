Sending keys: ['cat << \'EOF\' > /tmp/hunt.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncurr = conn.cursor()\n\n# Let\'s gather all events from the database\ncurr.execute("SELECT event_id, event_code, host, timestamp, user, image, target_image, message FROM events;")\nall_events = curr.fetchall()\n\nmalicious = set()\n\nfor eid, code, host, ts, user, img, tg_img, msg in all_events:\n    # 1. Sysmon process guid checks\n    # We know the malicious GUIDs\n    m_guids = [\'{297bc33e-65d0-5f2d-8207-000000000400}\', \'{297bc33e-660d-5f2d-8407-000000000400}\']\n    \n    # Check message or any other fields for these guids\n    has_guid = False\n    for g in m_guids:\n        if g in (msg or ""):\n            has_guid = True\n            break\n            \n    # 2. PowerShell Event Codes (800, 4103) - we verified all are from the malicious session\n    is_powershell_log = (code in [800, 4103])\n    \n    # 3. Security Event Log PID checks (Process ID 0x670, 0x1968 or decimal equivalents 1648, 6504)\n    has_pid = False\n    # We look for structured PID patterns in the message to avoid arbitrary number matching\n    # e.g., \'Process ID:\t\t0x670\', \'Creator Process ID:\t0x670\', \'Source Process ID:\t0x670\'\n    # Let\'s search for hex or decimal in message\n    pid_patterns = [\n        r\'Process ID:\\s*(0x670|1648|0x1968|6504)\\b\',\n        r\'Creator Process ID:\\s*(0x670|1648|0x1968|6504)\\b\',\n        r\'Source Process ID:\\s*(0x670|1648|0x1968|6504)\\b\',\n        r\'Target Process ID:\\s*(0x670|1648|0x1968|6504)\\b\'\n    ]\n    for pat in pid_patterns:\n        if re.search(pat, msg or "", re.IGNORECASE):\n            has_pid = True\n            break\n\n    # 4. Prefetch file creation we found earlier\n    is_prefetch = (code == 11 and "WHOAMI.EXE" in (msg or ""))\n\n    if has_guid or is_powershell_log or has_pid or is_prefetch:\n        malicious.add(eid)\n\nprint("Total malicious candidate events identified:", len(malicious))\n\n# Let\'s inspect some of these to check if we missed anything or got any false positives\n# Let\'s see the count per event code\nfrom collections import Counter\ncodes = []\ncurr.execute("SELECT event_id, event_code FROM events;")\nfor eid, code in curr.fetchall():\n    if eid in malicious:\n        codes.append(code)\nprint("Breakdown:", Counter(codes))\n\nEOF\npython3 /tmp/hunt.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
