Sending keys: ['cat << \'EOF\' > /tmp/hunt.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncurr = conn.cursor()\n\n# Let\'s gather all events from the database\ncurr.execute("SELECT event_id, event_code, host, timestamp, user, image, target_image, message FROM events;")\nall_events = curr.fetchall()\n\nmalicious = set()\n\n# Host ID of the malicious powershell session\nmal_host_id = \'ac1be91d-8fb6-4897-bfb3-cb8f2fb5568b\'\n\n# Malicious Process GUIDs\nmal_guids = [\'{297bc33e-65d0-5f2d-8207-000000000400}\', \'{297bc33e-660d-5f2d-8407-000000000400}\']\n\nfor eid, code, host, ts, user, img, tg_img, msg in all_events:\n    msg_str = msg or ""\n    \n    # 1. Sysmon process guid check\n    has_guid = False\n    for g in mal_guids:\n        if g in msg_str:\n            has_guid = True\n            break\n            \n    # 2. PowerShell logging (800, 4103) - we verified all are from the malicious session\n    is_powershell_log = (code in [800, 4103])\n    \n    # 3. PowerShell Engine logs (400, 600) matching the Host ID\n    is_powershell_engine = (code in [400, 600] and mal_host_id in msg_str)\n    \n    # 4. Security Event Log PID checks\n    has_pid = False\n    pid_patterns = [\n        r\'Process ID:\\s*(0x670|1648|0x1968|6504)\\b\',\n        r\'Creator Process ID:\\s*(0x670|1648|0x1968|6504)\\b\',\n        r\'Source Process ID:\\s*(0x670|1648|0x1968|6504)\\b\',\n        r\'Target Process ID:\\s*(0x670|1648|0x1968|6504)\\b\'\n    ]\n    for pat in pid_patterns:\n        if re.search(pat, msg_str, re.IGNORECASE):\n            has_pid = True\n            break\n            \n    # 5. Prefetch file creation\n    is_prefetch = (code == 11 and "WHOAMI.EXE" in msg_str)\n\n    if has_guid or is_powershell_log or is_powershell_engine or has_pid or is_prefetch:\n        # Exclude benign sysmain access event\n        if eid == \'evt-04328\':\n            continue\n        malicious.add(eid)\n\nprint("Total malicious candidate events:", len(malicious))\nEOF\npython3 /tmp/hunt.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
