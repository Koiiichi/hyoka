[99.391468, "o", "\u001b[?2004h>       AND event_code NOT IN (800, 4103)\r\n\u001b[?2004l\r\u001b[?2004h>       AND event_code < 4000\r\n\u001b[?2004l\r\u001b[?2004h>     GROUP BY event_code, process_guid, image\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY event_code, 4 DESC\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
