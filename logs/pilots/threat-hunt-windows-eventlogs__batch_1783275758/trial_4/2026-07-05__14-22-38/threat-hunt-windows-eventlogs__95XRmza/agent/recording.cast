[66.444824, "i", "cat << 'EOF' > /tmp/search_user.py\nimport sqlite3\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Search all events containing 'pgustavo'\ncur.execute(\"SELECT event_id, timestamp, event_code, host, message FROM events WHERE message LIKE '%pgustavo%'\")\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} events with 'pgustavo' in message:\")\n# Group them by event_code and host\ncounts = {}\nfor r in rows:\n    key = (r[2], r[3])\n    counts[key] = counts.get(key, 0) + 1\nfor k, v in sorted(counts.items()):\n    print(f\"Event Code {k[0]} on {k[1]}: {v} events\")\n\n# Let's print the event ids and details for non-Powershell (not 800, 4103) events of pgustavo\nprint(\"\\nNon-powershell events:\")\nfor r in rows:\n    if r[2] not in (800, 4103):\n        print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4][:150].strip().replace('\\n', ' ')}...\")\n\nEOF\npython3 /tmp/search_user.py\n"]
