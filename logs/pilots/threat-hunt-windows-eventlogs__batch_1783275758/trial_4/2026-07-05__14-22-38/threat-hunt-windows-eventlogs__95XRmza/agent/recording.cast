[31.405192, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport json\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Let's search for events containing this process_guid\nguid = '{297bc33e-65d0-5f2d-8207-000000000400}'\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, image, target_image, message\n    FROM events\n    WHERE process_guid = ?\n       OR message LIKE ?\n    ORDER BY timestamp ASC\n\"\"\", (guid, f'%{guid}%'))\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} events matching the guid directly:\")\nfor r in rows[:20]:\n    print(r[0], r[1], r[2], r[3], r[4], r[5])\n\nEOF\npython3 /tmp/hunt.py\n"]
