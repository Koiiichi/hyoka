[108.698669, "i", "cat << 'EOF' > /tmp/verify_ps_processes.py\nimport sqlite3\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\ncur.execute(\"\"\"\n    SELECT DISTINCT process_guid, image, user\n    FROM events\n    WHERE image LIKE '%powershell.exe%'\n\"\"\")\nprint(\"Powershell processes:\")\nfor r in cur.fetchall():\n    print(r)\n\nEOF\npython3 /tmp/verify_ps_processes.py\n"]
