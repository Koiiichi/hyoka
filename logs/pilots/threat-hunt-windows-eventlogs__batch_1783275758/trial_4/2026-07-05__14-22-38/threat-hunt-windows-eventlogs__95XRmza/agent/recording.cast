[99.38879, "i", "cat << 'EOF' > /tmp/check_process_guids.py\nimport sqlite3\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Query Sysmon events (except 800, 4103, which are PowerShell engine logs and don't always have a standard process_guid field in the DB column)\ncur.execute(\"\"\"\n    SELECT event_code, process_guid, image, COUNT(*)\n    FROM events\n    WHERE host='WS-05.corp.example'\n      AND event_code NOT IN (800, 4103)\n      AND event_code < 4000\n    GROUP BY event_code, process_guid, image\n    ORDER BY event_code, 4 DESC\n\"\"\")\nprint(\"=== Sysmon Events on WS-05 grouped by Code, GUID, Image ===\")\nfor row in cur.fetchall():\n    print(row)\n\nEOF\npython3 /tmp/check_process_guids.py\n"]
