[88.040328, "i", "cat << 'EOF' > /tmp/analyze_ps.py\nimport sqlite3\nimport re\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\ncur.execute(\"SELECT host, event_code, COUNT(*) FROM events WHERE event_code IN (800, 4103) GROUP BY host, event_code\")\nprint(\"=== PS Log Counts per host/code ===\")\nfor row in cur.fetchall():\n    print(row)\n\nprint(\"\\n=== DC01 and WS-06 PS message samples ===\")\ncur.execute(\"SELECT event_id, host, event_code, message FROM events WHERE host IN ('DC01.corp.example', 'WS-06.corp.example') AND event_code IN (800, 4103) LIMIT 10\")\nfor row in cur.fetchall():\n    print(row[0], row[1], row[2], row[3][:150].strip().replace('\\n', ' '))\n\nEOF\npython3 /tmp/analyze_ps.py\n"]
