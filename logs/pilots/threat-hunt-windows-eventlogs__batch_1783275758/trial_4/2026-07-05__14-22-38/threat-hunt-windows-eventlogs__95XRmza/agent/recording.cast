[31.432327, "o", "\u001b[?2004hroot@7faedb350e9b:~# "]
[40.691935, "i", "cat << 'EOF' > /tmp/get_malicious_events.py\nimport sqlite3\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Let's select all details for events matching the guid\nguid = '{297bc33e-65d0-5f2d-8207-000000000400}'\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, event_code, host, user, image, target_image, message\n    FROM events\n    WHERE process_guid = ?\n       OR message LIKE ?\n    ORDER BY timestamp ASC\n\"\"\", (guid, f'%{guid}%'))\n\nrows = cur.fetchall()\nprint(f\"Total: {len(rows)}\")\nfor r in rows:\n    # Print summary of each event to understand what is happening\n    event_id, ts, code, host, usr, img, tgt, msg = r\n    \n    # Get a condensed message description\n    condensed = \"\"\n    if code == 3:\n        # Network connection\n        dst_ip = \"\"\n        dst_port = \"\"\n        for line in msg.split('\\n'):\n            if 'DestinationIp:' in line: dst_ip = line.split()[-1]\n            if 'DestinationPort:' in line: dst_port = line.split()[-1]\n        condensed = f\"Network Connection to {dst_ip}:{dst_port}\"\n    elif code in (12, 13, 14):\n        # Registry\n        reg_type = {12: \"Create/Delete Key\", 13: \"Set Value\", 14: \"Rename Key\"}[code]\n        target_object = \"\"\n        details = \"\"\n        for line in msg.split('\\n'):\n            if 'TargetObject:' in line: target_object = line.split()[-1]\n            if 'Details:' in line: details = line.split()[-1]\n        condensed = f\"Registry {reg_type} -> {target_object} ({details})\"\n    elif code in (7, 10, 11, 17, 18, 5, 9):\n        # 7: Image loaded, 10: Process access, 11: File create, 17/18: Pipe created/connected\n        condensed = f\"Event {code}\"\n        if code == 11:\n            tgt_file = \"\"\n            for line in msg.split('\\n'):\n                if 'TargetFilename:' in line: tgt_file = line.split()[-1]\n            condensed += f\" File Created: {tgt_file}\"\n        elif code == 10:\n            tgt_img = \"\"\n            for line in msg.split('\\n'):\n                if 'TargetImage:' in line: tgt_img = line.split()[-1]\n            condensed += f\" Access to: {tgt_img}\"\n        elif code == 7:\n            loaded = \"\"\n            for line in msg.split('\\n'):\n                if 'ImageLoaded:' in line: loaded = line.split()[-1]\n            condensed += f\" ImageLoaded: {loaded}\"\n    elif code in (5156, 5158):\n        # Security WFP connection\n        condensed = f\"WFP {code}\"\n    else:\n        condensed = msg.strip().replace('\\n', ' | ')[:120]\n\n    print(f\"{event_id} | {ts} | {code} | {img or usr or ''} | {condensed}\")\n\nEOF\npython3 /tmp/get_malicious_events.py > /tmp/malicious_timeline.txt\nhead -n 40 /tmp/malicious_timeline.txt\n"]
[40.692566, "o", "cat << 'EOF' > /tmp/get_malicious_events.py\r\n\u001b[?2004l\r"]
