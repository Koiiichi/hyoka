[165.091126, "o", ">     SELECT event_id, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.091305, "o", "    WHERE host='WS-05.corp.example' AND event_code=10\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> rows = cur.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total Sysmon 10 events: {len(rows)}\")\r\n\u001b[?2004l\r"]
