[158.697134, "i", "cat << 'EOF' > /tmp/extract_all_malicious.py\nimport sqlite3\nimport re\nimport json\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\ncur.execute(\"SELECT event_id, event_code, host, user, image, target_image, message, process_guid FROM events\")\nall_events = cur.fetchall()\n\nmalicious_ids = set()\nreasons = {}\n\n# Malicious Process GUIDs\nmal_guids = {'{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}'}\n# Malicious PIDs in Hex and Decimal\nmal_pids_hex = {'0x670', '0x1968'}\nmal_pids_dec = {'1648', '6504'}\n\nfor r in all_events:\n    eid, code, host, user, image, tgt_img, msg, guid = r\n    \n    # 1. Guid matches\n    if guid in mal_guids:\n        malicious_ids.add(eid)\n        reasons[eid] = f\"Process GUID match: {guid}\"\n        continue\n        \n    # 2. Host is WS-05 and event is PowerShell log\n    if host == 'WS-05.corp.example' and code in (800, 4103):\n        malicious_ids.add(eid)\n        reasons[eid] = f\"PowerShell Log on WS-05 (code {code})\"\n        continue\n        \n    # 3. Message contains malicious Process GUIDs\n    if any(g in msg for g in mal_guids):\n        malicious_ids.add(eid)\n        reasons[eid] = f\"Message contains malicious GUID\"\n        continue\n        \n    # 4. Message contains malicious PID references\n    # We want to be careful with false positives (e.g., if a benign message contains '1648' by chance, but let's check)\n    # Usually in windows event messages, Process ID is labeled like 'Process ID: 0x670' or 'ProcessId: 1648' or 'Creator Process ID: 0x670'\n    # Let's search with regex for Process ID labeled fields containing malicious PIDs\n    found_pid = False\n    for label in ['Process ID', 'ProcessID', 'Creator Process ID', 'Creator Process Name', 'Caller Process ID', 'SourceProcessId', 'SourceProcessGUID', 'ParentProcessId', 'New Process ID', 'Target Process ID']:\n        # pattern like Label: 0x670 or Label:\t0x670 or Label [whitespace] 1648\n        pattern = rf\"{re.escape(label)}[:\\t\\s]+(0x[0-9a-fA-F]+|\\d+)\"\n        m = re.search(pattern, msg, re.IGNORECASE)\n        if m:\n            pid_val = m.group(1).lower()\n            if pid_val in mal_pids_hex or pid_val in mal_pids_dec:\n                found_pid = True\n                reasons[eid] = f\"PID match in field '{label}': {pid_val}\"\n                break\n    if found_pid:\n        malicious_ids.add(eid)\n        continue\n\nprint(f\"Total malicious events identified: {len(malicious_ids)}\")\n\n# Let's list those not yet captured or check if we have any other events to check\n# Write all identified malicious events to a file for review\nwith open('/tmp/malicious_list.txt', 'w') as f:\n    for eid in sorted(malicious_ids):\n        f.write(f\"{eid} | {reasons[eid]}\\n\")\n\nEOF\npython3 /tmp/extract_all_malicious.py\n"]
