[66.471344, "o", "\u001b[?2004hroot@7faedb350e9b:~# "]
[72.270329, "i", "cat << 'EOF' > /tmp/search_user_2.py\nimport sqlite3\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Search all events containing 'pgustavo' excluding powershell script/pipeline events (800, 4103)\ncur.execute(\"SELECT event_id, timestamp, event_code, host, user, image, target_image, message FROM events WHERE (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%') AND event_code NOT IN (800, 4103) ORDER BY timestamp ASC\")\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} non-PowerShell events involving 'pgustavo':\")\n\nwith open('/tmp/pgustavo_events.txt', 'w') as f:\n    for r in rows:\n        eid, ts, code, host, usr, img, tgt, msg = r\n        # Print a short summary of the event\n        summary = msg.strip().replace('\\n', ' ').replace('\\r', '')\n        if len(summary) > 120:\n            summary = summary[:120] + \"...\"\n        f.write(f\"{eid} | {ts} | {code} | {host} | {usr or ''} | {img or ''} | {summary}\\n\")\n\nEOF\npython3 /tmp/search_user_2.py\ncat /tmp/pgustavo_events.txt\n"]
[72.271274, "o", "cat << 'EOF' > /tmp/search_user_2.py\r\n\u001b[?2004l\r"]
