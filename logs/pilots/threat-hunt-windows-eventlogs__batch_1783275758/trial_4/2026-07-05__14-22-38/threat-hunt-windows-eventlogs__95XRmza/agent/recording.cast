[207.607251, "i", "python3 -c \"\nimport sqlite3\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\nwith open('/tmp/malicious_list.txt') as f:\n    mal_ids = {line.split(' | ')[0] for line in f if line.strip()}\ncur.execute(\\\"SELECT event_id, event_code, message FROM events WHERE host='WS-05.corp.example' AND (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%')\\\")\nfor r in cur.fetchall():\n    if r[0] not in mal_ids:\n        print('EID:', r[0], 'Code:', r[1])\n        print('Message:', r[2])\n        print('-'*50)\n\"\n"]
