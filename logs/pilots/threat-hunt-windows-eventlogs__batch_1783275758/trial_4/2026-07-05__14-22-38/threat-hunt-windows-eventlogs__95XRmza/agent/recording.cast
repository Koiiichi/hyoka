[226.256337, "i", "cat << 'EOF' > /tmp/save_findings.py\nimport json\n\nwith open('/tmp/malicious_list.txt') as f:\n    lines = f.read().splitlines()\n\neids = []\nfor l in lines:\n    if not l.strip(): continue\n    eid = l.split(' | ')[0]\n    eids.append(eid)\n\nprint(f\"Saving {len(eids)} event IDs to /root/findings.json\")\n# Sort the event IDs to be neat\neids.sort()\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(eids, f)\n\nprint(\"Saved successfully!\")\nEOF\npython3 /tmp/save_findings.py\n"]
