[212.703647, "i", "cat << 'EOF' > /tmp/breakdown.py\nwith open('/tmp/malicious_list.txt') as f:\n    lines = f.read().splitlines()\n\ncounts = {}\nfor l in lines:\n    if not l.strip(): continue\n    eid, reason = l.split(' | ', 1)\n    # Categorize by reason\n    cat = reason.split(':')[0]\n    counts[cat] = counts.get(cat, 0) + 1\n\nfor k, v in sorted(counts.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{k}: {v}\")\n\nEOF\npython3 /tmp/breakdown.py\n"]
