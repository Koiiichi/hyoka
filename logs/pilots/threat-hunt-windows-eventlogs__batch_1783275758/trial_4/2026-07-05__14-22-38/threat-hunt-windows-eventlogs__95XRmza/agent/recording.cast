[114.658309, "o", "\u001b[?2004hroot@7faedb350e9b:~# "]
[120.408778, "i", "cat << 'EOF' > /tmp/check_wfp_2.py\nimport sqlite3\nimport re\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (5156, 5158)\")\nrows = cur.fetchall()\n\npids = {}\nfor eid, code, msg in rows:\n    m = re.search(r'Process ID:\\s+(\\d+)', msg)\n    pid = m.group(1) if m else 'None'\n    pids.setdefault(pid, []).append((eid, code))\n\nprint(\"Summary of WFP events on WS-05:\")\nfor pid, evs in sorted(pids.items()):\n    # Try to find process info for this pid\n    # We look for a process start or any sysmon event with this pid\n    cur.execute(\"SELECT image FROM events WHERE message LIKE ? LIMIT 1\", (f'%ProcessId: {pid}%',))\n    img_row = cur.fetchone()\n    img = img_row[0] if img_row else \"Unknown\"\n    if img == \"Unknown\":\n        cur.execute(\"SELECT image FROM events WHERE message LIKE ? LIMIT 1\", (f'%Process ID:\\t{pid}%',))\n        img_row = cur.fetchone()\n        img = img_row[0] if img_row else \"Unknown\"\n    print(f\"PID {pid} ({img}): {len(evs)} events\")\n\nEOF\npython3 /tmp/check_wfp_2.py\n"]
