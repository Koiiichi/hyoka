[126.131863, "i", "cat << 'EOF' > /tmp/check_wfp_destinations.py\nimport sqlite3\nimport re\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (5156, 5158)\")\nrows = cur.fetchall()\n\nfor eid, code, msg in rows:\n    # Parse out application name, destination address, and port\n    app = \"\"\n    dst = \"\"\n    port = \"\"\n    pid = \"\"\n    for line in msg.split('\\n'):\n        if 'Application Name:' in line:\n            app = line.split()[-1]\n        if 'Destination Address:' in line:\n            dst = line.split()[-1]\n        if 'Destination Port:' in line:\n            port = line.split()[-1]\n        if 'Process ID:' in line:\n            pid = line.split()[-1]\n    \n    # check if destination is external\n    is_local = False\n    if dst.startswith('127.') or dst == '::1' or dst.startswith('172.18.') or dst.startswith('fe80::'):\n        is_local = True\n    \n    if not is_local:\n        print(f\"{eid} | {code} | PID {pid} | {app} -> {dst}:{port}\")\n\nEOF\npython3 /tmp/check_wfp_destinations.py\n"]
