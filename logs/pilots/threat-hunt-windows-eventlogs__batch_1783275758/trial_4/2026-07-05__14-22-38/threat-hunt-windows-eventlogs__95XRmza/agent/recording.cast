[188.534722, "i", "cat << 'EOF' > /tmp/check_non_malicious.py\nimport sqlite3\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\nwith open('/tmp/malicious_list.txt') as f:\n    mal_ids = {line.split(' | ')[0] for line in f if line.strip()}\n\nprint(f\"Read {len(mal_ids)} malicious IDs from file.\")\n\ncur.execute(\"SELECT event_id, event_code, host, user, image, target_image, message FROM events\")\nall_events = cur.fetchall()\n\nnon_mal = [r for r in all_events if r[0] not in mal_ids]\nprint(f\"Total non-malicious events remaining: {len(non_mal)}\")\n\npy_counts = {}\nfor r in non_mal:\n    key = (r[2], r[1], r[4] or '')\n    py_counts[key] = py_counts.get(key, 0) + 1\n\nprint(\"\\n=== Grouped remaining events ===\")\nfor k, v in sorted(py_counts.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{k[0]} | Code {k[1]} | Image: {k[2]} | Count: {v}\")\n\nEOF\npython3 /tmp/check_non_malicious.py\n"]
