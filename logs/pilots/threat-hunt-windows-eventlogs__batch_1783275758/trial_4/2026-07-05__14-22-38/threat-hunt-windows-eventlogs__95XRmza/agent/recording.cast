MI\r\r\nProduct: Microsoft® Windows® Operating System\r\r\nCompany: Microsoft Corporation\r\r\nOriginalFileName: wmidcom.dll\r\r\nHashes: SHA1=4C7308C2A323D850C3E5DCB88A32A1C7DF9CBE4F,MD5=A9BC5F3E3C6406C3C5ABE804FBF7BC76,SHA256=A0177FD4B7690A680E5EAC9BDC78E21117B523622607BCA47305EB74984CF901,IMPHASH=8461651332BA942E21A64DBF3E9E80F8\r\r\nSigned: true\r\r\nSignature: Microsoft Windows\r\r\nSignatureStatus: Valid\r\nevt-05980|2026-05-06T14:35:12.033Z|7|DC01.corp.example|Image loaded:\r\r\nRuleName: -\r\r\nUtcTime: 2020-08-07 14:35:09.795\r\r\nProcessGuid: {9f85ce58-5cd3-5f2b-7402-000000000400}\r\r\nProcessId: 4164\r\r\nImage: C:\\Windows\\System32\\svchost.exe\r\r\nImageLoaded: C:\\Windows\\System32\\dpapi.dll\r\r\nFileVersion: 10.0.17763.1 (WinBuild.160101.0800)\r\r\nDescription: Data Protection API\r\r\nProduct: Microsoft® Windows® Operating System\r\r\nCompany: Microsoft Corporation\r\r\nOriginalFileName: dpapi.dll\r\r\nHashes: SHA1=C50FDD4A17CA9451C66413BA04ED2CC79883AD16,MD5=CF864B08CEA15894A4E6E676A7FE89A3,SHA256=0D1488B2FF471C1EF2F8F2742D685A8778B2C1512A044BDF2606C3ED92E0B512,IMPHASH=C591E3A4DDFE145A26EEC16DB70623B7\r\r\nSigned: true\r\r\nSignature: Microsoft Windows\r\r\nSignatureStatus: Valid\r\nevt-05991|2026-05-06T14:35:16.040Z|18|DC01.corp.example|Pipe Connected:\r\r\nRuleName: -\r\r\nEventType: ConnectPipe\r\r\nUtcTime: 2020-08-07 14:35:13.958\r\r\nProcessGuid: {9f85ce58-59ed-5f2b-5000-000000000400}\r\r\nProcessId: 3616\r\r\nPipeName: \\lsass\r\r\nImage: C:\\windows\\system32\\dns.exe\r\n\u001b[?2004hroot@7faedb350e9b:~# "]
[54.255478, "i", "cat << 'EOF' > /tmp/hunt_all.py\nimport sqlite3\nimport re\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\nprint(\"=== FILE CREATION EVENTS (11) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code=11\")\nfor row in cur.fetchall():\n    msg = row[5]\n    tgt = \"\"\n    for line in msg.split('\\n'):\n        if 'TargetFilename:' in line: tgt = line.split()[-1]\n    print(f\"{row[0]} | {row[1]} | {row[2]} | {row[4]} -> {tgt}\")\n\nprint(\"\\n=== UNIQUE NETWORK DESTINATIONS (3) ===\")\ncur.execute(\"SELECT DISTINCT host, image, message FROM events WHERE event_code=3\")\nfor row in cur.fetchall():\n    host, img, msg = row\n    dst = \"\"\n    for line in msg.split('\\n'):\n        if 'DestinationIp:' in line: dst = line.split()[-1]\n        if 'DestinationPort:' in line: dst += \":\" + line.split()[-1]\n    print(f\"{host} | {img} -> {dst}\")\n\nprint(\"\\n=== PROCESS CREATION EVENTS (1, 4688) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, image, message FROM events WHERE event_code IN (1, 4688)\")\nfor row in cur.fetchall():\n    print(f\"{row[0]} | {row[1]} | {row[2]} | {row[3]} | {row[4][:200]}...\")\n\nprint(\"\\n=== SUSPICIOUS POWERSHELL LOGS (4103/4104/800) ===\")\n# Let's count them or check for keywords like 'bypass', 'download', 'invoke', 'iex', etc.\ncur.execute(\"SELECT event_id, event_code, host, message FROM events WHERE event_code IN (4103, 4104, 800)\")\nlogs = cur.fetchall()\nprint(f\"Total PowerShell logs: {len(logs)}\")\nsusp_keywords = ['bypass', 'download', 'invoke', 'iex', 'enc', 'hidden', 'webclient', 'frombase64', 'http']\nsusp_count = 0\nfor row in logs:\n    msg_lower = row[3].lower()\n    if any(k in msg_lower for k in susp_keywords):\n        susp_count += 1\n        if susp_count <= 20:\n            print(f\"{row[0]} | {row[1]} | {row[2]} | {row[3][:150].strip()}...\")\nprint(f\"Found {susp_count} suspicious PowerShell logs out of {len(logs)}\")\n\nEOF\npython3 /tmp/hunt_all.py\n"]
