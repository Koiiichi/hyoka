[80.474782, "i", "cat << 'EOF' > /tmp/check_others.py\nimport sqlite3\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Query any Sysmon Event 3 (Network) or WFP (5156/5158) involving non-DC/non-local addresses on WS-06 or DC01\nprint(\"=== Non-local Connections on WS-06 or DC01 ===\")\ncur.execute(\"SELECT event_id, timestamp, host, event_code, message FROM events WHERE host IN ('WS-06.corp.example', 'DC01.corp.example') AND event_code IN (3, 5156, 5158)\")\nfor row in cur.fetchall():\n    eid, ts, host, code, msg = row\n    # extract src and dst IPs\n    src = \"\"\n    dst = \"\"\n    port = \"\"\n    for line in msg.split('\\n'):\n        if 'Source Address:' in line or 'SourceIp:' in line:\n            src = line.split()[-1]\n        if 'Destination Address:' in line or 'DestinationIp:' in line:\n            dst = line.split()[-1]\n        if 'Destination Port:' in line or 'DestinationPort:' in line:\n            port = line.split()[-1]\n    # Filter out local connections (e.g. 127.0.0.1, ::1, or corp domain IPs like 172.18.x.x, fe80::)\n    is_local = False\n    for ip in [src, dst]:\n        if ip.startswith('127.') or ip == '::1' or ip.startswith('172.18.') or ip.startswith('fe80:'):\n            is_local = True\n    if not is_local:\n        print(f\"{eid} | {ts} | {host} | {code} | {src} -> {dst}:{port}\")\n\nprint(\"\\n=== Any Process Creation on WS-06 or DC01 ===\")\ncur.execute(\"SELECT event_id, timestamp, host, event_code, message FROM events WHERE host IN ('WS-06.corp.example', 'DC01.corp.example') AND event_code IN (1, 4688)\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4][:200].strip()}\")\n\nEOF\npython3 /tmp/check_others.py\n"]
[80.47515, "o", "cat << 'EOF' > /tmp/check_others.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
