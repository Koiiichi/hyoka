[203.56547, "i", "cat << 'EOF' > /tmp/verify_pgustavo_security.py\nimport sqlite3\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\nwith open('/tmp/malicious_list.txt') as f:\n    mal_ids = {line.split(' | ')[0] for line in f if line.strip()}\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, host, user, message \n    FROM events \n    WHERE host='WS-05.corp.example' \n      AND (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%')\n\"\"\")\nrows = cur.fetchall()\n\nnot_captured = [r for r in rows if r[0] not in mal_ids]\nprint(f\"Found {len(not_captured)} security/other events involving 'pgustavo' NOT captured:\")\nfor r in not_captured:\n    print(r[0], r[1], r[3], r[4][:150].strip().replace('\\n', ' '))\n\nEOF\npython3 /tmp/verify_pgustavo_security.py\n"]
