[158.69933, "o", "\u001b[?2004l\r\u001b[?2004h> reasons = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Malicious Process GUIDs\r\n\u001b[?2004l\r\u001b[?2004h> mal_guids = {'{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}'}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.699411, "o", "# Malicious PIDs in Hex and Decimal\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.699552, "o", "mal_pids_hex = {'0x670', '0x1968'}\r\n\u001b[?2004l\r\u001b[?2004h> mal_pids_dec = {'1648', '6504'}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.699682, "o", "for r in all_events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.69976, "o", "    eid, code, host, user, image, tgt_img, msg, guid = r\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.699792, "o", "    # 1. Guid matches\r\n\u001b[?2004l\r\u001b[?2004h>     if guid in mal_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.699887, "o", "        malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.699998, "o", "        reasons[eid] = f\"Process GUID match: {guid}\"\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r"]
[158.701009, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # 2. Host is WS-05 and event is PowerShell log\r\n\u001b[?2004l\r\u001b[?2004h>     if host == 'WS-05.corp.example' and code in (800, 4103):\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>         reasons[eid] = f\"PowerShell Log on WS-05 (code {code})\"\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # 3. Message contains malicious Process GUIDs\r\n\u001b[?2004l\r\u001b[?2004h>     if any(g in msg for g in mal_guids):\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>         reasons[eid] = f\"Message contains malicious GUID\"\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # 4. Message contains malicious PID references\r\n\u001b[?2004l\r\u001b[?2004h>     # We want to be careful with false positives (e.g., if a benign message contains '1648' by chance, but let's check)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.701285, "o", "    # Usually in windows event messages, Process ID is labeled like 'Process ID: 0x670' or 'ProcessId: 1648' or 'Creator Process ID: 0x670'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.701306, "o", "    # Let's search with regex for Process ID labeled fields containing malicious PIDs\r\n\u001b[?2004l\r\u001b[?2004h"]
[158.701423, "o", ">     found_pid = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.701616, "o", "    for label in ['Process ID', 'ProcessID', 'Creator Process ID', 'Creator Process Name', 'Caller Process ID', 'SourceProcessId', 'SourceProcessGUID', 'ParentProcessId', 'New Process ID', 'Target Process ID']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.70169, "o", "        # pattern like Label: 0x670 or Label:"]
[158.702424, "o", "\u0007"]
[158.702455, "o", "0x670 or Label [whitespace] 1648\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.702578, "o", "        pattern = rf\"{re.escape(label)}[:\\t\\s]+(0x[0-9a-fA-F]+|\\d+)\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.702681, "o", "        m = re.search(pattern, msg, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h>         if m:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.702748, "o", "            pid_val = m.group(1).lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.703089, "o", "            if pid_val in mal_pids_hex or pid_val in mal_pids_dec:\r\n\u001b[?2004l\r\u001b[?2004h>                 found_pid = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.703168, "o", "                reasons[eid] = f\"PID match in field '{label}': {pid_val}\"\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>     if found_pid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.703206, "o", "        malicious_ids.add(eid)\r\n\u001b[?2004l\r"]
[158.703362, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[158.703834, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total malicious events identified: {len(malicious_ids)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's list those not yet captured or check if we have any other events to check\r\n\u001b[?2004l\r\u001b[?2004h> # Write all identified malicious events to a file for review\r\n\u001b[?2004l\r\u001b[?2004h> with open('/tmp/malicious_list.txt', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for eid in sorted(malicious_ids):\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(f\"{eid} | {reasons[eid]}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[158.70467, "o", "\u001b[?2004hroot@7faedb350e9b:~# "]
[158.704776, "o", "python3 /tmp/extract_all_malicious.py\r\n\u001b[?2004l\r"]
[158.766404, "o", "Total malicious events identified: 4859\r\n"]
[158.77031, "o", "\u001b[?2004hroot@7faedb350e9b:~# "]
[165.090408, "i", "cat << 'EOF' > /tmp/check_code10.py\nimport sqlite3\nimport re\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, message \n    FROM events \n    WHERE host='WS-05.corp.example' AND event_code=10\n\"\"\")\nrows = cur.fetchall()\nprint(f\"Total Sysmon 10 events: {len(rows)}\")\nmal_guids = {'{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}'}\n\nfor eid, msg in rows:\n    # extract SourceProcessGUID and TargetProcessGUID\n    src_guid = \"\"\n    tgt_guid = \"\"\n    for line in msg.split('\\n'):\n        if 'SourceProcessGUID:' in line: src_guid = line.split()[-1]\n        if 'TargetProcessGUID:' in line: tgt_guid = line.split()[-1]\n    \n    is_mal = src_guid in mal_guids or tgt_guid in mal_guids\n    print(f\"{eid} | Src: {src_guid} | Tgt: {tgt_guid} | Malicious: {is_mal}\")\n\nEOF\npython3 /tmp/check_code10.py > /tmp/code10_results.txt\ngrep \"Malicious: True\" /tmp/code10_results.txt\n"]
[165.090704, "o", "cat << 'EOF' > /tmp/check_code10.py\r\n\u001b[?2004l\r"]
[165.090734, "o", "\u001b[?2004h> "]
