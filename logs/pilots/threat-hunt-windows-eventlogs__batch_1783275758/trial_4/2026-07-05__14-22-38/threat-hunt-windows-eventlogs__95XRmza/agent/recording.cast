[114.624342, "i", "cat << 'EOF' > /tmp/check_wfp.py\nimport sqlite3\nimport re\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (5156, 5158)\")\nrows = cur.fetchall()\nprint(f\"Total WS-05 WFP events: {len(rows)}\")\npids = {}\nfor eid, code, msg in rows:\n    m = re.search(r'Process ID:\\s+(\\d+)', msg)\n    pid = m.group(1) if m else 'None'\n    pids[pid] = pids.get(pid, 0) + 1\n\nprint(\"WFP PIDs:\")\nfor pid, count in sorted(pids.items()):\n    print(f\"PID {pid}: {count} events\")\n\n# Let's see what processes these other PIDs are\nfor pid in pids:\n    if pid != '1648':\n        cur.execute(\"SELECT DISTINCT image, message FROM events WHERE message LIKE ?\", (f'%ProcessId: {pid}%',))\n        print(f\"\\nDetails for PID {pid}:\")\n        for r in cur.fetchall():\n            print(r[0] or 'No Image', r[1][:150].strip())\n\nEOF\npython3 /tmp/check_wfp.py\n"]
[114.624584, "o", "cat << 'EOF' > /tmp/check_wfp.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
