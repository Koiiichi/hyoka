[22.674562, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport base64\nimport re\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Let's get the parent command line\ncur.execute(\"SELECT message FROM events WHERE event_id = 'evt-00282'\")\nmsg = cur.fetchone()[0]\n\nm = re.search(r'-enc\\s+([A-Za-z0-9+/=]+)', msg.replace('\\r', '').replace('\\n', ''))\nif m:\n    enc = m.group(1)\n    print(\"Found Encoded string length:\", len(enc))\n    # Let's try decoding\n    try:\n        decoded = base64.b64decode(enc).decode('utf-16le')\n        print(\"Decoded PowerShell Script:\")\n        print(decoded)\n    except Exception as e:\n        print(\"Error decoding UTF-16LE:\", e)\n        # Maybe try regular ascii\n        try:\n            print(base64.b64decode(enc).decode('utf-8'))\n        except Exception as e2:\n            print(\"Error decoding UTF-8:\", e2)\nelse:\n    # Since the string was cut off in output, let's look for any other places or reconstruct\n    print(\"Could not extract whole -enc via regex, let's search events for PowerShell command lines or scripts.\")\n\nEOF\npython3 /tmp/hunt.py\n"]
