[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> con = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = con.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Query any Sysmon Event 3 (Network) or WFP (5156/5158) involving non-DC/non-local addresses on WS-06 or DC01
[?2004l[?2004h> print("=== Non-local Connections on WS-06 or DC01 ===")
[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, host, event_code, message FROM events WHERE host IN ('WS-06.corp.example', 'DC01.corp.example') AND event_code IN (3, 5156, 5158)")
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     eid, ts, host, code, msg = row
[?2004l[?2004h>     # extract src and dst IPs
[?2004l[?2004h>     src = ""
[?2004l[?2004h>     dst = ""
[?2004l[?2004h>     port = ""
[?2004l[?2004h>     for line in msg.split('\n'):
[?2004l[?2004h>         if 'Source Address:' in line or 'SourceIp:' in line:
[?2004l[?2004h>             src = line.split()[-1]
[?2004l[?2004h>         if 'Destination Address:' in line or 'DestinationIp:' in line:
[?2004l[?2004h>             dst = line.split()[-1]
[?2004l[?2004h>         if 'Destination Port:' in line or 'DestinationPort:' in line:
[?2004l[?2004h>             port = line.split()[-1]
[?2004l[?2004h>     # Filter out local connections (e.g. 127.0.0.1, ::1, or corp domain IPs like 172.18.x.x, fe80::)
[?2004l[?2004h>     is_local = False
[?2004l[?2004h>     for ip in [src, dst]:
[?2004l[?2004h>         if ip.startswith('127.') or ip == '::1' or ip.startswith('172.18.') or ip.startswith('fe80:'):
[?2004l[?2004h>             is_local = True
[?2004l[?2004h>     if not is_local:
[?2004l[?2004h>         print(f"{eid} | {ts} | {host} | {code} | {src} -> {dst}:{port}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== Any Process Creation on WS-06 or DC01 ===")
[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, host, event_code, message FROM events WHERE host IN ('WS-06.corp.example', 'DC01.corp.example') AND event_code IN (1, 4688)")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     print(f"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4][:200].strip()}")
