[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> con = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = con.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, host, user, image, target_image, message, process_guid FROM events")
[?2004l[?2004h> all_events = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> malicious_ids = set()
[?2004l[?2004h> reasons = {}
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious Process GUIDs
[?2004l[?2004h> mal_guids = {'{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}'}
[?2004l[?2004h> # Malicious PIDs in Hex and Decimal
[?2004l[?2004h> mal_pids_hex = {'0x670', '0x1968'}
[?2004l[?2004h> mal_pids_dec = {'1648', '6504'}
[?2004l[?2004h> 
[?2004l[?2004h> for r in all_events:
[?2004l[?2004h>     eid, code, host, user, image, tgt_img, msg, guid = r
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. Guid matches
[?2004l[?2004h>     if guid in mal_guids:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         reasons[eid] = f"Process GUID match: {guid}"
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 2. Host is WS-05 and event is PowerShell log
[?2004l[?2004h>     if host == 'WS-05.corp.example' and code in (800, 4103):
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         reasons[eid] = f"PowerShell Log on WS-05 (code {code})"
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Message contains malicious Process GUIDs
[?2004l[?2004h>     if any(g in msg for g in mal_guids):
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         reasons[eid] = f"Message contains malicious GUID"
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 4. Message contains malicious PID references
[?2004l[?2004h>     # We want to be careful with false positives (e.g., if a benign message contains '1648' by chance, but let's check)
[?2004l[?2004h>     # Usually in windows event messages, Process ID is labeled like 'Process ID: 0x670' or 'ProcessId: 1648' or 'Creator Process ID: 0x670'
[?2004l[?2004h>     # Let's search with regex for Process ID labeled fields containing malicious PIDs
[?2004l[?2004h>     found_pid = False
[?2004l[?2004h>     for label in ['Process ID', 'ProcessID', 'Creator Process ID', 'Creator Process Name', 'Caller Process ID', 'SourceProcessId', 'SourceProcessGUID', 'ParentProcessId', 'New Process ID', 'Target Process ID']:
[?2004l[?2004h>         # pattern like Label: 0x670 or Label:0x670 or Label [whitespace] 1648
[?2004l[?2004h>         pattern = rf"{re.escape(label)}[:\t\s]+(0x[0-9a-fA-F]+|\d+)"
[?2004l[?2004h>         m = re.search(pattern, msg, re.IGNORECASE)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             pid_val = m.group(1).lower()
[?2004l[?2004h>             if pid_val in mal_pids_hex or pid_val in mal_pids_dec:
[?2004l[?2004h>                 found_pid = True
[?2004l[?2004h>                 reasons[eid] = f"PID match in field '{label}': {pid_val}"
[?2004l[?2004h>                 break
[?2004l[?2004h>     if found_pid:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total malicious events identified: {len(malicious_ids)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's list those not yet captured or check if we have any other events to check
[?2004l[?2004h> # Write all identified malicious events to a file for review
[?2004l[?2004h> with open('/tmp/malicious_list.txt', 'w') as f:
[?2004l[?2004h>     for eid in sorted(malicious_ids):
[?2004l[?2004h>         f.write(f"{eid} | {reasons[eid]}\n")
[?2004l[?2004h> 
