[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> con = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = con.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Query all security events (not 4688) on WS-05
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host='WS-05.corp.example' 
[?2004l[?2004h>       AND event_code NOT IN (800, 4103, 5156, 5158, 4688)
[?2004l[?2004h>       AND event_code >= 4000
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} non-WFP, non-4688 security events on WS-05.")
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious PIDs
[?2004l[?2004h> # powershell.exe: 1648 = 0x670
[?2004l[?2004h> # whoami.exe: 6504 = 0x1968
[?2004l[?2004h> 
[?2004l[?2004h> for eid, code, msg in rows:
[?2004l[?2004h>     # search for process ID in message
[?2004l[?2004h>     m = re.search(r'(Process ID|Creator Process ID|Caller Process ID):\s*(0x[0-9a-fA-F]+|\d+)', msg, re.IGNORECASE)
[?2004l[?2004h>     pid = m.group(2) if m else 'None'
[?2004l[?2004h>     # check if it matches 0x670 or 0x1968 or 1648 or 6504
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     if pid.lower() in ('0x670', '0x1968', '1648', '6504'):
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     
[?2004l[?2004h>     # also let's just print them all to see if we missed any
[?2004l[?2004h>     print(f"{eid} | {code} | PID: {pid} | Malicious: {is_malicious} | {msg[:120].strip().replace('\n', ' ')}")
[?2004l[?2004h> 
