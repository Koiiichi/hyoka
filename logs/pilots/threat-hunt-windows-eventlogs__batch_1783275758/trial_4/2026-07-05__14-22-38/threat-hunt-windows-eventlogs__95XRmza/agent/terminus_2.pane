[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> con = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = con.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search for any event in the database that mentions the PID 1648 or hex 0x670 or the process GUIDs
[?2004l[?2004h> guid1 = '{297bc33e-65d0-5f2d-8207-000000000400}'
[?2004l[?2004h> guid2 = '{297bc33e-660d-5f2d-8407-000000000400}'
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, host, user, image, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE process_guid IN (?, ?)
[?2004l[?2004h>        OR message LIKE ?
[?2004l[?2004h>        OR message LIKE ?
[?2004l[?2004h>        OR message LIKE '%1648%'
[?2004l[?2004h>        OR message LIKE '%0x670%'
[?2004l[?2004h> """, (guid1, guid2, f'%{guid1}%', f'%{guid2}%'))
[?2004l[?2004h> 
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} potentially related events.")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect some that are NOT code 800, 4103, 3, 7, 12, 13, 17, 18, 22, 5156, 5158, 1, 4688
[?2004l[?2004h> weird_events = []
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     eid, code, host, user, image, msg = r
[?2004l[?2004h>     if code not in (800, 4103, 3, 7, 10, 11, 12, 13, 17, 18, 22, 5156, 5158, 1, 4688):
[?2004l[?2004h>         weird_events.append(r)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Weird related events ({len(weird_events)}):")
[?2004l[?2004h> for r in weird_events[:30]:
[?2004l[?2004h>     print(r[0], r[1], r[2], r[3], r[4], r[5][:150].strip().replace('\n', ' '))
[?2004l[?2004h> 
