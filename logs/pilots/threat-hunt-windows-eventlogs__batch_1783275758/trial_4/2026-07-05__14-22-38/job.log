Sending keys: ['cat << \'EOF\' > /tmp/check_related_events.py\nimport sqlite3\nimport re\n\ncon = sqlite3.connect(\'/root/data/eventlogs.db\')\ncur = con.cursor()\n\n# Let\'s search for any event in the database that mentions the PID 1648 or hex 0x670 or the process GUIDs\nguid1 = \'{297bc33e-65d0-5f2d-8207-000000000400}\'\nguid2 = \'{297bc33e-660d-5f2d-8407-000000000400}\'\n\ncur.execute("""\n    SELECT event_id, event_code, host, user, image, message \n    FROM events \n    WHERE process_guid IN (?, ?)\n       OR message LIKE ?\n       OR message LIKE ?\n       OR message LIKE \'%1648%\'\n       OR message LIKE \'%0x670%\'\n""", (guid1, guid2, f\'%{guid1}%\', f\'%{guid2}%\'))\n\nrows = cur.fetchall()\nprint(f"Found {len(rows)} potentially related events.")\n\n# Let\'s inspect some that are NOT code 800, 4103, 3, 7, 12, 13, 17, 18, 22, 5156, 5158, 1, 4688\nweird_events = []\nfor r in rows:\n    eid, code, host, user, image, msg = r\n    if code not in (800, 4103, 3, 7, 10, 11, 12, 13, 17, 18, 22, 5156, 5158, 1, 4688):\n        weird_events.append(r)\n\nprint(f"Weird related events ({len(weird_events)}):")\nfor r in weird_events[:30]:\n    print(r[0], r[1], r[2], r[3], r[4], r[5][:150].strip().replace(\'\\n\', \' \'))\n\nEOF\npython3 /tmp/check_related_events.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
