Sending keys: ['cat << \'EOF\' > /tmp/check_security_events.py\nimport sqlite3\nimport re\n\ncon = sqlite3.connect(\'/root/data/eventlogs.db\')\ncur = con.cursor()\n\n# Query all security events (not 4688) on WS-05\ncur.execute("""\n    SELECT event_id, event_code, message \n    FROM events \n    WHERE host=\'WS-05.corp.example\' \n      AND event_code NOT IN (800, 4103, 5156, 5158, 4688)\n      AND event_code >= 4000\n""")\nrows = cur.fetchall()\nprint(f"Found {len(rows)} non-WFP, non-4688 security events on WS-05.")\n\n# Malicious PIDs\n# powershell.exe: 1648 = 0x670\n# whoami.exe: 6504 = 0x1968\n\nfor eid, code, msg in rows:\n    # search for process ID in message\n    m = re.search(r\'(Process ID|Creator Process ID|Caller Process ID):\\s*(0x[0-9a-fA-F]+|\\d+)\', msg, re.IGNORECASE)\n    pid = m.group(2) if m else \'None\'\n    # check if it matches 0x670 or 0x1968 or 1648 or 6504\n    is_malicious = False\n    if pid.lower() in (\'0x670\', \'0x1968\', \'1648\', \'6504\'):\n        is_malicious = True\n    \n    # also let\'s just print them all to see if we missed any\n    print(f"{eid} | {code} | PID: {pid} | Malicious: {is_malicious} | {msg[:120].strip().replace(\'\\n\', \' \')}")\n\nEOF\npython3 /tmp/check_security_events.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
