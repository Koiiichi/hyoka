rmination (4689)\n    elif ec in (4688, 4689) and host == \'WS-05.corp.example\':\n        # check if it relates to whoami or powershell\n        if \'whoami.exe\' in msg or \'6504\' in msg or \'0x1968\' in msg or \'1648\' in msg or \'0x670\' in msg:\n            is_malicious = True\n            reason = f"Security process event ({ec}) for malicious process"\n            \n    # 6. Windows Filtering Platform (5156, 5158) related to powershell\n    elif ec in (5156, 5158) and host == \'WS-05.corp.example\':\n        if \'1648\' in msg or \'powershell.exe\' in msg.lower():\n            is_malicious = True\n            reason = f"WFP event ({ec}) for malicious process"\n            \n    # 7. Named pipe, Registry, DNSEvent or other Sysmon events with matching ProcessGuid\n    # Sysmon events usually have ProcessGuid or ProcessId inside the message\n    elif pguid is None or pguid == \'\':\n        # Parse process guid from message\n        for line in msg.split(\'\\n\'):\n            if \'ProcessGuid:\' in line:\n                g = line.split(\':\', 1)[1].strip()\n                if g in malicious_guids:\n                    is_malicious = True\n                    reason = f"Process GUID inside message match ({g})"\n            if \'ProcessId:\' in line:\n                pid_str = line.split(\':\', 1)[1].strip()\n                try:\n                    pid_val = int(pid_str)\n                    if pid_val in malicious_pids:\n                        is_malicious = True\n                        reason = f"Process ID inside message match ({pid_val})"\n                except ValueError:\n                    pass\n\n    if is_malicious:\n        candidates.append((eid, ec, ts, host, img, tgt_img, reason))\n\nprint(f"Total malicious candidate events found: {len(candidates)}")\n# print count of candidates by event code\nfrom collections import Counter\nec_counts = Counter([c[1] for c in candidates])\nprint("By event code:")\nfor ec, count in sorted(ec_counts.items()):\n    print(f"  Event Code {ec}: {count}")\n\n# Let\'s save candidates to a file to examine\nwith open(\'/tmp/mal_events.json\', \'w\') as f:\n    json.dump(candidates, f, indent=2)\n\nEOF\npython3 /tmp/malicious_candidates.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
