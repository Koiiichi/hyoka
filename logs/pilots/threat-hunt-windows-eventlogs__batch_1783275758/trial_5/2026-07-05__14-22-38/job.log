msg or \'0x1968\' in msg or \'1648\' in msg or \'0x670\' in msg:\n            is_malicious = True\n            reason = f"Security process event ({ec}) for malicious process"\n            \n    # 6. Windows Filtering Platform (5156, 5158) related to powershell\n    elif ec in (5156, 5158) and host == \'WS-05.corp.example\':\n        if \'1648\' in msg or \'powershell.exe\' in msg.lower():\n            is_malicious = True\n            reason = f"WFP event ({ec}) for malicious process"\n            \n    # 7. Other Sysmon events (Registry, named pipes, DNS, etc.)\n    else:\n        # check if process_guid or process_id matches inside the message\n        for line in msg.split(\'\\n\'):\n            if \'ProcessGuid:\' in line:\n                g = line.split(\':\', 1)[1].strip().replace(\'{\',\'\').replace(\'}\',\'\')\n                g_full = \'{\' + g + \'}\'\n                if g_full in malicious_guids:\n                    is_malicious = True\n                    reason = f"Process GUID inside message match ({g_full})"\n            if \'ProcessId:\' in line:\n                pid_str = line.split(\':\', 1)[1].strip()\n                try:\n                    pid_val = int(pid_str)\n                    if pid_val in malicious_pids:\n                        is_malicious = True\n                        reason = f"Process ID inside message match ({pid_val})"\n                except ValueError:\n                    pass\n\n    if is_malicious:\n        candidates.append({\n            "event_id": eid,\n            "event_code": ec,\n            "timestamp": ts,\n            "host": host,\n            "image": img,\n            "target_image": tgt_img,\n            "reason": reason\n        })\n\nprint(f"Total malicious candidate events found: {len(candidates)}")\nec_counts = {}\nfor c in candidates:\n    ec = c["event_code"]\n    ec_counts[ec] = ec_counts.get(ec, 0) + 1\n\nfor ec, count in sorted(ec_counts.items()):\n    print(f"  Event Code {ec}: {count}")\n\n# Save