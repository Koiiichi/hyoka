[?2004hroot@76c2de1d23be:~# cat << 'EOF' > /tmp/analyze_ws05.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, user, image, target_image, process_guid, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example' AND event_code NOT IN (800, 4103)
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> print(f"Total non-PS-pipeline events on WS-05: {len(rows)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Group them by event_code, image and process_guid to summarize
[?2004l[?2004h> summary = {}
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     eid, ec, ts, user, img, tgt_img, pguid, msg = r
[?2004l[?2004h>     key = (ec, img, tgt_img, pguid)
[?2004l[?2004h>     if key not in summary:
[?2004l[?2004h>         summary[key] = []
[?2004l[?2004h>     summary[key].append((eid, ts, msg))
[?2004l[?2004h> 
[?2004l[?2004h> print("\nSummary of WS-05 events:")
[?2004l[?2004h> for key, evs in sorted(summary.items(), key=lambda x: x[0]):
[?2004l[?2004h>     ec, img, tgt_img, pguid = key
[?2004l[?2004h>     print(f"Code: {ec} | Image: {img} | TargetImage: {tgt_img} | Guid: {pguid} | Count: {len(evs)} | First EID: {evs[0][0]}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
