[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's collect all Event ID 3 (Network Connections) and print them
[?2004l[?2004h> print("=== Network Connections (Event ID 3) ===")
[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, host, user, image, src_ip, dst_ip, dst_port, message FROM events WHERE event_code = 3;")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     print(f"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} -> {r[6]}:{r[7]}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's collect all Event ID 11 (File Create)
[?2004l[?2004h> print("\n=== File Creations (Event ID 11) ===")
[?2004l[?2004h> cur.execute("SELECT event_id, timestamp, host, image, message FROM events WHERE event_code = 11;")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     print(f"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4].strip()[:200]}")
[?2004l[?2004h> 
