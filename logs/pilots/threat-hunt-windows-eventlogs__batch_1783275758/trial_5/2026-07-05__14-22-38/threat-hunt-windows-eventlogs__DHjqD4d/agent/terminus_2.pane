[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> placeholder = ','.join('?' for _ in mal_eids)
[?2004l[?2004h> cur.execute(f"""
[?2004l[?2004h>     SELECT event_id, event_code, host, image, target_image, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE (message LIKE '%powershell%' OR message LIKE '%whoami%' 
[?2004l[?2004h>            OR message LIKE '%1648%' OR message LIKE '%6504%'
[?2004l[?2004h>            OR message LIKE '%297bc33e-65d0-5f2d-8207-000000000400%'
[?2004l[?2004h>            OR message LIKE '%297bc33e-660d-5f2d-8407-000000000400%')
[?2004l[?2004h>       AND event_id NOT IN ({placeholder});
[?2004l[?2004h> """, list(mal_eids))
[?2004l[?2004h> 
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> print(f"--- Full Details for {len(rows)} remaining events ---")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     print("="*50)
[?2004l[?2004h>     print(f"EID: {r[0]} | Code: {r[1]} | Host: {r[2]} | Image: {r[3]} | Target: {r[4]}")
[?2004l[?2004h>     print(r[5].strip())
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@76c2de1d23be:~# python3 /tmp/inspect_remaining_details.py > /tmp/remaining_details.txt
