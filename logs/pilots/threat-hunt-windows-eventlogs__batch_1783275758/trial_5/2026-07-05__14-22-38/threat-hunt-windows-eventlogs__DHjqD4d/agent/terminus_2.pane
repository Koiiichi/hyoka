[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT event_code, message FROM events WHERE event_code IN (800, 4103);")
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> host_apps = set()
[?2004l[?2004h> for ec, msg in rows:
[?2004l[?2004h>     # search for HostApplication inside the message
[?2004l[?2004h>     m = re.search(r'HostApplication=(.*)', msg)
[?2004l[?2004h>     if m:
[?2004l[?2004h>         host_apps.add((ec, m.group(1).strip()))
[?2004l[?2004h>     else:
[?2004l[?2004h>         # check other format if any
[?2004l[?2004h>         pass
[?2004l[?2004h> 
