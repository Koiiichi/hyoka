[246.177846, "i", "cat << 'EOF' > /tmp/generate_final_findings.py\nimport json\n\n# Load initial candidates\nwith open('/tmp/mal_events.json') as f:\n    mal_events = json.load(f)\n\nmal_eids = {e['event_id'] for e in mal_events}\n\n# Add the 9 engine/provider events (400, 600)\nadded_engine_eids = [\n    'evt-00136', 'evt-00138', 'evt-00140', 'evt-00142',\n    'evt-00144', 'evt-00145', 'evt-00146', 'evt-00147',\n    'evt-00148'\n]\nfor eid in added_engine_eids:\n    mal_eids.add(eid)\n\n# Add the 13 Security events (4656, 4658, 4663, 4673)\nadded_security_eids = [\n    'evt-00271', 'evt-00281', 'evt-00287', 'evt-00292',\n    'evt-00312', 'evt-00316', 'evt-00319', 'evt-00322',\n    'evt-02456', 'evt-02457', 'evt-02459', 'evt-02460',\n    'evt-02461'\n]\nfor eid in added_security_eids:\n    mal_eids.add(eid)\n\nfinal_list = sorted(list(mal_eids))\nprint(f\"Final count of malicious events: {len(final_list)}\")\n\n# Write to findings.json\nwith open('/root/findings.json', 'w') as f:\n    json.dump(final_list, f)\n\nprint(\"findings.json written successfully.\")\n\nEOF\npython3 /tmp/generate_final_findings.py\n"]
