[85.68066, "i", "cat << 'EOF' > /tmp/check_ps_hosts.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_code, message FROM events WHERE event_code IN (800, 4103);\")\nrows = cur.fetchall()\n\nhost_apps = set()\nfor ec, msg in rows:\n    # search for HostApplication inside the message\n    m = re.search(r'HostApplication=(.*)', msg)\n    if m:\n        host_apps.add((ec, m.group(1).strip()))\n    else:\n        # check other format if any\n        pass\n\nprint(f\"Found {len(host_apps)} unique HostApplication signatures in 800/4103:\")\nfor ha in host_apps:\n    print(ha[0], ha[1][:150])\n\nEOF\npython3 /tmp/check_ps_hosts.py\n"]
