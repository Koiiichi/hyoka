[40.861486, "o", "evt-04206|2026-05-06T14:33:45.279Z|WS-05.corp.example|10|C:\\windows\\system32\\svchost.exe|C:\\windows\\system32\\lsass.exe|0x2000|Process accessed:\r\r\nRuleName: -\r\r\nUtcTime: 2020-08-07 14:33:44.832\r\r\nSourceProcessGUID: {297bc33e-5c31-5f2b-2b00-000000000400}\r\r\nSourceProcessId: 1784\r\r\nSourceThreadId: 1876\r\r\nSourceImage: C:\\windows\\system32\\svchost.exe\r\r\nTargetProcessGUID: {297bc33e-5c2e-5f2b-0c00-000000000400}\r\r\nTargetProcessId: 768\r\r\nTargetImage: C:\\windows\\system32\\lsass.exe\r\r\nGrantedAccess: 0x2000\r\r\nCallTrace: C:\\windows\\SYSTEM32\\ntdll.dll+9c534|C:\\windows\\System32\\KERNELBASE.dll+2726e|c:\\windows\\system32\\sysmain.dll+7a8cb|c:\\windows\\system32\\sysmain.dll+52730|c:\\windows\\system32\\sysmain.dll+1c468|c:\\windows\\system32\\sysmain.dll+1bf95|c:\\windows\\system32\\sysmain.dll+74b0d|c:\\windows\\system32\\sysmain.dll+73b32|c:\\windows\\system32\\sysmain.dll+601a3|C:\\windows\\system32\\svchost.exe+314c|C:\\windows\\System32\\sechost.dll+2de2|C:\\windows\\System32\\KERNEL32.DLL+17bd4|C:\\windows\\SYSTEM32\\ntdll.dll+6ce51\r\n"]
[40.863247, "o", "\u001b[?2004hroot@76c2de1d23be:~# "]
[47.540972, "i", "cat << 'EOF' > /tmp/analyze_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\ndef dump_query(title, query):\n    print(f\"=== {title} ===\")\n    cur.execute(query)\n    rows = cur.fetchall()\n    for r in rows:\n        print(r)\n    print()\n\ndump_query(\"Event 11 (File Create)\", \"SELECT event_id, timestamp, host, image, message FROM events WHERE event_code = 11;\")\n\ndump_query(\"Event 3 (Network Connection)\", \"SELECT event_id, timestamp, host, image, src_ip, dst_ip, dst_port FROM events WHERE event_code = 3;\")\n\ndump_query(\"Event 10 (Process Access) - suspicious only\", \"\"\"\n    SELECT event_id, timestamp, host, image, target_image, granted_access\n    FROM events \n    WHERE event_code = 10 \n      AND (image LIKE '%powershell%' OR target_image LIKE '%lsass%' \n           OR (image LIKE '%svchost%' AND target_image NOT LIKE '%svchost%')\n           OR image LIKE '%whoami%');\n\"\"\")\n\ndump_query(\"Event 12, 13, 14 (Registry Events) - suspicious only\", \"\"\"\n    SELECT event_id, timestamp, host, event_code, image, message\n    FROM events \n    WHERE event_code IN (12, 13, 14)\n      AND (image LIKE '%powershell%' OR message LIKE '%pgustavo%' OR message LIKE '%Run%' OR message LIKE '%Services%')\n\"\"\")\n\nEOF\npython3 /tmp/analyze_events.py > /tmp/detailed_analysis.txt\ncat /tmp/detailed_analysis.txt\n"]
[47.541222, "o", "cat << 'EOF' > /tmp/analyze_events.py"]
[47.543187, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def dump_query(title, query):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"=== {title} ===\")\r\n\u001b[?2004l\r\u001b[?2004h>     cur.execute(query)\r\n\u001b[?2004l\r\u001b[?2004h>     rows = cur.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h>     for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>         print(r)\r\n\u001b[?2004l\r\u001b[?2004h>     print()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> dump_query(\"Event 11 (File Create)\", \"SELECT event_id, timestamp, host, image, message FROM events WHERE event_code = 11;\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> dump_query(\"Event 3 (Network Connection)\", \"SELECT event_id, timestamp, host, image, src_ip, dst_ip, dst_port FROM events WHERE event_code = 3;\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> dump_query(\"Event 10 (Process Access) - suspicious only\", \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, host, image, target_image, granted_access\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE event_code = 10 \r\n\u001b[?2004l\r\u001b[?2004h>       AND (image LIKE '%powershell%' OR target_image LIKE '%lsass%' \r\n\u001b[?2004l\r\u001b[?2004h>            OR (image LIKE '%svchost%' AND target_image NOT LIKE '%svchost%')\r\n\u001b[?2004l\r\u001b[?2004h>            OR image LIKE '%whoami%');\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> dump_query(\"Event 12, 13, 14 (Registry Events) - suspicious only\", \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, host, event_code, image, message\r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE event_code IN (12, 13, 14)\r\n\u001b[?2004l\r\u001b[?2004h>       AND (image LIKE '%powershell%' OR message LIKE '%pgustavo%' OR message LIKE '%Run%' OR message LIKE '%Services%')\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
