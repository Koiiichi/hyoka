[202.060435, "i", "cat << 'EOF' > /tmp/check_ps_engine.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Check 400/600 events\neids = ['evt-00136', 'evt-00138', 'evt-00140', 'evt-00142', 'evt-00144', 'evt-00145', 'evt-00146', 'evt-00147', 'evt-00148']\nfor eid in eids:\n    cur.execute(\"SELECT event_id, event_code, message FROM events WHERE event_id = ?;\", (eid,))\n    r = cur.fetchone()\n    if r:\n        print(\"=\"*50)\n        print(f\"{r[0]} | {r[1]}\")\n        # print any HostApplication line\n        for line in r[2].split('\\n'):\n            if 'HostApplication' in line or 'Host Application' in line or 'EngineState' in line:\n                print(line.strip())\n\n# Check the security events: 4656, 4658, 4663, 4673\nprint(\"\\n--- Security events (4656, 4658, 4663, 4673) ---\")\ncur.execute(\"\"\"\n    SELECT event_id, event_code, message \n    FROM events \n    WHERE event_code IN (4656, 4658, 4663, 4673) AND host = 'WS-05.corp.example';\n\"\"\")\nfor r in cur.fetchall():\n    print(\"=\"*50)\n    print(f\"{r[0]} | {r[1]}\")\n    for line in r[2].split('\\n'):\n        if any(k in line.lower() for k in ('object name', 'process name', 'service name', 'privilege')):\n            print(line.strip())\n\nEOF\npython3 /tmp/check_ps_engine.py\n"]
