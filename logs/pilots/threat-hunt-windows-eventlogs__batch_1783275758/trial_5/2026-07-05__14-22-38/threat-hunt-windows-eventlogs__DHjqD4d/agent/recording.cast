[111.939966, "i", "cat << 'EOF' > /tmp/inspect_details.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's find all events where process_guid is the malicious powershell {297bc33e-65d0-5f2d-8207-000000000400}\n# or malicious whoami {297bc33e-660d-5f2d-8407-000000000400}\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, image, target_image, message \n    FROM events \n    WHERE process_guid IN ('{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}');\n\"\"\")\n\np_events = cur.fetchall()\nprint(f\"Events directly associated with malicious GUIDs: {len(p_events)}\")\nfor r in p_events[:20]:\n    print(r[0], r[1], r[2], r[3], r[4])\n\n# Let's inspect other events that might be tied via PID/Image or other fields\n# For example, Event 5 (Process Terminated) for these PIDs\n# Process ID for powershell is 1648, whoami is 6504\nprint(\"\\n=== Event ID 5 (Process Terminated) ===\")\ncur.execute(\"SELECT event_id, timestamp, message FROM events WHERE event_code = 5;\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2].strip().replace('\\n', ' '))\n\n# Event ID 9 (RawAccessRead)\nprint(\"\\n=== Event ID 9 ===\")\ncur.execute(\"SELECT event_id, timestamp, host, message FROM events WHERE event_code = 9;\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3].strip().replace('\\n', ' '))\n\n# Let's inspect Event 10 (Process Access) where source or target is malicious\nprint(\"\\n=== Event ID 10 (Process Access) ===\")\ncur.execute(\"\"\"\n    SELECT event_id, timestamp, image, target_image, message \n    FROM events \n    WHERE event_code = 10 \n      AND (message LIKE '%1648%' OR message LIKE '%6504%' \n           OR image LIKE '%powershell%' OR target_image LIKE '%powershell%');\n\"\"\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3])\n\nEOF\npython3 /tmp/inspect_details.py\n"]
[111.940577, "o", "cat << 'EOF' > /tmp/inspect_details.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's find all events where process_guid is the malicious powershell {297bc33e-65d0-5f2d-8207-000000000400}\r\n\u001b[?2004l\r\u001b[?2004h> "]
