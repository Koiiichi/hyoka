[85.733518, "o", "\u001b[?2004hroot@76c2de1d23be:~# "]
[95.990822, "i", "cat << 'EOF' > /tmp/analyze_ws05.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, target_image, process_guid, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code NOT IN (800, 4103)\n    ORDER BY timestamp;\n\"\"\")\n\nrows = cur.fetchall()\nprint(f\"Total non-PS-pipeline events on WS-05: {len(rows)}\")\n\n# Group them by event_code, image and process_guid to summarize\nsummary = {}\nfor r in rows:\n    eid, ec, ts, user, img, tgt_img, pguid, msg = r\n    key = (ec, img, tgt_img, pguid)\n    if key not in summary:\n        summary[key] = []\n    summary[key].append((eid, ts, msg))\n\nprint(\"\\nSummary of WS-05 events:\")\nfor key, evs in sorted(summary.items(), key=lambda x: x[0]):\n    ec, img, tgt_img, pguid = key\n    print(f\"Code: {ec} | Image: {img} | TargetImage: {tgt_img} | Guid: {pguid} | Count: {len(evs)} | First EID: {evs[0][0]}\")\n\nEOF\npython3 /tmp/analyze_ws05.py\n"]
[95.9913, "o", "cat << 'EOF' > /tmp/analyze_ws05.py\r\n\u001b[?2004l\r"]
