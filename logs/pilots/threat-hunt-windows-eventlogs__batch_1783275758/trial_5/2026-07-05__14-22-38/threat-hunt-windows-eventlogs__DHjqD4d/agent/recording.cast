[129.569025, "o", "with open('/tmp/mal_events.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(candidates, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[129.569931, "o", "\u001b[?2004hroot@76c2de1d23be:~# python3 /tmp/malicious_candidates.py\r\n\u001b[?2004l\r"]
[129.594062, "o", "Total malicious candidate events found: 4838\r\n"]
[129.594249, "o", "By event code:\r\n  Event Code 1: 1\r\n  Event Code 3: 35\r\n  Event Code 5: 1\r\n  Event Code 7: 47\r\n  Event Code 10: 2\r\n  Event Code 12: 40\r\n  Event Code 17: 2\r\n  Event Code 18: 2\r\n  Event Code 22: 1\r\n"]
[129.594318, "o", "  Event Code 800: 2940\r\n  Event Code 4103: 1695\r\n  Event Code 4688: 1\r\n  Event Code 4689: 1\r\n  Event Code 5156: 35\r\n  Event Code 5158: 35\r\n"]
[129.594412, "o", "Traceback (most recent call last):\r\n  File \"/tmp/malicious_candidates.py\", line 91, in <module>\r\n"]
