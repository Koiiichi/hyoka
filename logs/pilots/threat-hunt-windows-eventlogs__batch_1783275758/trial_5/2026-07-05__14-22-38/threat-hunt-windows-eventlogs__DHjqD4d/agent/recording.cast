[178.412042, "i", "cat << 'EOF' > /tmp/final_verify.py\nimport sqlite3\nimport json\n\nwith open('/tmp/mal_events.json') as f:\n    mal_events = json.load(f)\nmal_eids = {e['event_id'] for e in mal_events}\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nplaceholder = ','.join('?' for _ in mal_eids)\ncur.execute(f\"\"\"\n    SELECT event_id, event_code, host, image, message \n    FROM events \n    WHERE (message LIKE '%powershell%' OR message LIKE '%whoami%' \n           OR message LIKE '%1648%' OR message LIKE '%6504%'\n           OR message LIKE '%297bc33e-65d0-5f2d-8207-000000000400%'\n           OR message LIKE '%297bc33e-660d-5f2d-8407-000000000400%')\n      AND event_id NOT IN ({placeholder});\n\"\"\", list(mal_eids))\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} remaining potential events matching keywords:\")\nfor r in rows[:20]:\n    print(f\"  {r[0]} | Code: {r[1]} | Host: {r[2]} | Image: {r[3]} | Message: {r[4].strip()[:150].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/final_verify.py\n"]
[178.412672, "o", "cat << 'EOF' > /tmp/final_verify.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
