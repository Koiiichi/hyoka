[246.179533, "o", "with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(final_list, f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"findings.json written successfully.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
