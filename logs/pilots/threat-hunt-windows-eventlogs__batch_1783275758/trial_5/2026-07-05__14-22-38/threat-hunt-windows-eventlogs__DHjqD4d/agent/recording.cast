[192.672908, "i", "cat << 'EOF' > /tmp/parse_remaining.py\nimport re\n\nwith open('/tmp/remaining_details.txt') as f:\n    content = f.read()\n\nblocks = content.split('==================================================')\nprint(f\"Total blocks: {len(blocks)}\")\n\nfor b in blocks:\n    if not b.strip():\n        continue\n    first_line = b.strip().split('\\n')[0]\n    # Extract EID, Code, Host, Image, Target\n    m = re.match(r'EID:\\s+(\\S+)\\s+\\|\\s+Code:\\s+(\\d+)\\s+\\|\\s+Host:\\s+(\\S+)\\s+\\|\\s+Image:\\s+(.*?)\\s+\\|\\s+Target:\\s+(.*)', first_line)\n    if m:\n        eid, code, host, img, tgt = m.groups()\n        # Print summary\n        print(\"-\"*30)\n        print(f\"{eid} | Code: {code} | Host: {host} | Image: {img} | Target: {tgt}\")\n        # Print some interesting lines in message\n        lines = b.strip().split('\\n')[1:]\n        interesting = []\n        for l in lines[:10]:\n            if any(k in l.lower() for k in ('hostapplication', 'targetfilename', 'object name', 'processguid', 'grantedaccess', 'process name', 'command line', 'subject', 'account name')):\n                interesting.append(l.strip())\n        print(\"  Int:\", interesting[:5])\n\nEOF\npython3 /tmp/parse_remaining.py\n"]
