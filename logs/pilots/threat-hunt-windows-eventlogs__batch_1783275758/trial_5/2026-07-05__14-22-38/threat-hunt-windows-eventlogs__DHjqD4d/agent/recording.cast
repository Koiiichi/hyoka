[75.392004, "i", "cat << 'EOF' > /tmp/check_others.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nfor h in ['DC01.corp.example', 'WS-06.corp.example']:\n    print(f\"\\n=== Host {h} ===\")\n    cur.execute(\"SELECT event_code, image, count(*) FROM events WHERE host = ? GROUP BY event_code, image ORDER BY 3 DESC;\", (h,))\n    for r in cur.fetchall():\n        print(r)\n\nEOF\npython3 /tmp/check_others.py\n"]
