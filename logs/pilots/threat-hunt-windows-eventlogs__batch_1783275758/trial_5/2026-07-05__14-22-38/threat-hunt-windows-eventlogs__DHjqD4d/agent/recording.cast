[26.848796, "i", "cat << 'EOF' > /tmp/analyze_ps.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Query event 800 and 4103\ncur.execute(\"SELECT event_id, timestamp, event_code, message FROM events WHERE event_code IN (800, 4103) ORDER BY timestamp;\")\n\nrows = cur.fetchall()\nprint(f\"Total rows: {len(rows)}\")\nfor rid, ts, ec, msg in rows[:50]:\n    # extract command line\n    lines = msg.split('\\n')\n    cmd_lines = [l for l in lines if 'Pipeline execution details' in l or 'CommandInvocation' in l or 'CommandLine' in l or 'New-Object' in l or '$' in l]\n    print(f\"{rid} | {ts} | {ec} | {cmd_lines}\")\n\nEOF\npython3 /tmp/analyze_ps.py > /tmp/ps_output.txt\nhead -n 40 /tmp/ps_output.txt\n"]
