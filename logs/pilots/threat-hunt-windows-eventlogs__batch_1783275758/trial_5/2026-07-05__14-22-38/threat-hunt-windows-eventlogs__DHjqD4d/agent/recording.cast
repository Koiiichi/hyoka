[142.464514, "o", "  Event Code 1: 1\r\n  Event Code 3: 35\r\n  Event Code 5: 1\r\n  Event Code 7: 47\r\n  Event Code 10: 2\r\n  Event Code 12: 40\r\n  Event Code 17: 2\r\n  Event Code 18: 2\r\n  Event Code 22: 1\r\n  Event Code 800: 2940\r\n  Event Code 4103: 1695\r\n  Event Code 4688: 1\r\n  Event Code 4689: 1\r\n  Event Code 5156: 35\r\n  Event Code 5158: 35\r\n"]
[142.477719, "o", "\u001b[?2004hroot@76c2de1d23be:~# "]
[152.023453, "i", "cat << 'EOF' > /tmp/check_remaining.py\nimport sqlite3\nimport json\n\n# Load malicious event IDs\nwith open('/tmp/mal_events.json') as f:\n    mal_events = json.load(f)\nmal_eids = {e['event_id'] for e in mal_events}\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Fetch all events on WS-05 not in mal_eids\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, image, target_image, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_id NOT IN (%s)\n    ORDER BY timestamp;\n\"\"\" % ','.join(f\"'{eid}'\" for eid in mal_eids))\n\nrows = cur.fetchall()\nprint(f\"Total remaining events on WS-05: {len(rows)}\")\n\n# Group remaining by (event_code, image)\ngrouped = {}\nfor r in rows:\n    eid, ec, ts, img, tgt, msg = r\n    key = (ec, img)\n    if key not in grouped:\n        grouped[key] = []\n    grouped[key].append((eid, ts, tgt, msg))\n\nfor key, evs in sorted(grouped.items()):\n    ec, img = key\n    print(f\"Code: {ec} | Image: {img} | Count: {len(evs)} | First EID: {evs[0][0]}\")\n    # if it is Event 11, 13, 10 or anything else interesting, print details\n    if ec in (1, 3, 5, 10, 11, 13, 14, 4688, 4689):\n        print(f\"  Details for Code {ec} | Image: {img}:\")\n        for eid, ts, tgt, msg in evs[:5]:\n            print(f\"    {eid} | {ts} | Target: {tgt} | {msg.strip()[:150].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/check_remaining.py\n"]
