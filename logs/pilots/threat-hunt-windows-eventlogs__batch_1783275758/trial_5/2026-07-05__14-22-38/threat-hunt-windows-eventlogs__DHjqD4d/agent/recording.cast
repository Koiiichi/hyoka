[162.897456, "i", "cat << 'EOF' > /tmp/check_sysmon_events.py\nimport json\n\nwith open('/tmp/mal_events.json') as f:\n    mal_events = json.load(f)\n\nprint(f\"Total malicious events: {len(mal_events)}\")\n# Group by event_code and host\ngroups = {}\nfor ev in mal_events:\n    key = (ev['event_code'], ev['host'])\n    groups[key] = groups.get(key, 0) + 1\n\nfor key, count in sorted(groups.items()):\n    print(f\"Event Code: {key[0]} | Host: {key[1]} | Count: {count}\")\n\n# Look at some non-pipeline events:\nnon_pipe = [e for e in mal_events if e['event_code'] not in (800, 4103)]\nprint(f\"\\nNon-pipeline malicious events ({len(non_pipe)}):\")\nfor ev in non_pipe[:30]:\n    print(f\"  EID: {ev['event_id']} | Code: {ev['event_code']} | Image: {ev['image']} | Target: {ev['target_image']} | Reason: {ev['reason']}\")\n\nEOF\npython3 /tmp/check_sysmon_events.py\n"]
