[33.414003, "i", "cat << 'EOF' > /tmp/check_other_events.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nprint(\"Event count by host for 800 and 4103:\")\ncur.execute(\"SELECT host, event_code, COUNT(*) FROM events WHERE event_code IN (800, 4103) GROUP BY host, event_code;\")\nfor row in cur.fetchall():\n    print(row)\n\nprint(\"\\nUnique users for 800 and 4103:\")\n# Note: for 800 and 4103, user might be null, but we can look inside message or other fields, or user field in the DB\ncur.execute(\"SELECT host, user, COUNT(*) FROM events WHERE event_code IN (800, 4103) GROUP BY host, user;\")\nfor row in cur.fetchall():\n    print(row)\n\nprint(\"\\nChecking other hosts for process creation (1, 4688) or other signs of life:\")\ncur.execute(\"SELECT host, event_code, COUNT(*) FROM events WHERE event_code NOT IN (800, 4103) GROUP BY host, event_code ORDER BY 3 DESC;\")\nfor row in cur.fetchall():\n    print(row)\n\nEOF\npython3 /tmp/check_other_events.py\n"]
