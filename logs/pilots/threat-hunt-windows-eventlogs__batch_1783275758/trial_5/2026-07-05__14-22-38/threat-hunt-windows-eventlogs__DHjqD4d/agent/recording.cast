[111.944368, "o", "    WHERE process_guid IN ('{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}');\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> p_events = cur.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Events directly associated with malicious GUIDs: {len(p_events)}\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in p_events[:20]:\r\n\u001b[?2004l\r\u001b[?2004h>     print(r[0], r[1], r[2], r[3], r[4])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's inspect other events that might be tied via PID/Image or other fields\r\n\u001b[?2004l\r\u001b[?2004h> # For example, Event 5 (Process Terminated) for these PIDs\r\n\u001b[?2004l\r\u001b[?2004h> # Process ID for powershell is 1648, whoami is 6504\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== Event ID 5 (Process Terminated) ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id, timestamp, message FROM events WHERE event_code = 5;\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r[0], r[1], r[2].strip().replace('\\n', ' '))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Event ID 9 (RawAccessRead)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== Event ID 9 ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id, timestamp, host, message FROM events WHERE event_code = 9;\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r[0], r[1], r[2], r[3].strip().replace('\\n', ' '))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's inspect Event 10 (Process Access) where source or target is malicious\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== Event ID 10 (Process Access) ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, image, target_image, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE event_code = 10 \r\n\u001b[?2004l\r\u001b[?2004h>       AND (message LIKE '%1648%' OR message LIKE '%6504%' \r\n\u001b[?2004l\r\u001b[?2004h>            OR image LIKE '%powershell%' OR target_image LIKE '%powershell%');\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r[0], r[1], r[2], r[3])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@76c2de1d23be:~# python3 /tmp/inspect_details.py\r\n\u001b[?2004l\r"]
