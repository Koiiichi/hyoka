[68.440947, "i", "cat << 'EOF' > /tmp/range.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\ncur.execute(\"SELECT MIN(timestamp), MAX(timestamp) FROM events;\")\nprint(\"Time range of DB:\", cur.fetchone())\n\nprint(\"\\nUnique users in DB:\")\ncur.execute(\"SELECT host, user, COUNT(*) FROM events GROUP BY host, user;\")\nfor r in cur.fetchall():\n    print(r)\n\nprint(\"\\nProcess creations on ALL hosts:\")\n# let's look at all event code 1 or 4688 across ALL hosts\ncur.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp;\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3], r[4])\n\nEOF\npython3 /tmp/range.py\n"]
