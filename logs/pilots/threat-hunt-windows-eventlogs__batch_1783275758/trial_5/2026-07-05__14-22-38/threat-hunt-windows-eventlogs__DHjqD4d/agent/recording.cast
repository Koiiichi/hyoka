[61.593843, "i", "cat << 'EOF' > /tmp/summary.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# 1. Unique network connection destinations\nprint(\"=== Unique network connection destinations (Event 3) ===\")\ncur.execute(\"SELECT host, image, dst_ip, dst_port, COUNT(*) FROM events WHERE event_code = 3 GROUP BY host, image, dst_ip, dst_port;\")\nfor r in cur.fetchall():\n    print(r)\n\n# 2. File creation details\nprint(\"\\n=== File Creations (Event 11) ===\")\ncur.execute(\"SELECT host, image, message FROM events WHERE event_code = 11;\")\nfor r in cur.fetchall():\n    # extract target filename from message\n    msg = r[2]\n    target = \"\"\n    for line in msg.split('\\n'):\n        if \"TargetFilename:\" in line or \"Target Filename:\" in line:\n            target = line.strip()\n    print(f\"{r[0]} | {r[1]} | {target}\")\n\n# 3. Process Access from PowerShell (Event 10)\nprint(\"\\n=== Process Access (Event 10) on WS-05 ===\")\ncur.execute(\"SELECT event_id, host, image, target_image, granted_access FROM events WHERE event_code = 10 AND image LIKE '%powershell%';\")\nfor r in cur.fetchall():\n    print(r)\n\n# 4. Any event containing CORP\\pgustavo or pgustavo on hosts other than WS-05\nprint(\"\\n=== Activity of pgustavo on other hosts ===\")\ncur.execute(\"SELECT event_id, host, event_code, message FROM events WHERE (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%') AND host != 'WS-05.corp.example';\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3][:200].replace('\\r', '').replace('\\n', ' '))\n\nEOF\npython3 /tmp/summary.py\n"]
