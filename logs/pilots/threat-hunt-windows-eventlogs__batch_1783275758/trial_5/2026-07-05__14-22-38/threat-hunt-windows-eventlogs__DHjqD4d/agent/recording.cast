[186.580184, "i", "cat << 'EOF' > /tmp/inspect_remaining_details.py\nimport sqlite3\nimport json\n\nwith open('/tmp/mal_events.json') as f:\n    mal_events = json.load(f)\nmal_eids = {e['event_id'] for e in mal_events}\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nplaceholder = ','.join('?' for _ in mal_eids)\ncur.execute(f\"\"\"\n    SELECT event_id, event_code, host, image, target_image, message \n    FROM events \n    WHERE (message LIKE '%powershell%' OR message LIKE '%whoami%' \n           OR message LIKE '%1648%' OR message LIKE '%6504%'\n           OR message LIKE '%297bc33e-65d0-5f2d-8207-000000000400%'\n           OR message LIKE '%297bc33e-660d-5f2d-8407-000000000400%')\n      AND event_id NOT IN ({placeholder});\n\"\"\", list(mal_eids))\n\nrows = cur.fetchall()\nprint(f\"--- Full Details for {len(rows)} remaining events ---\")\nfor r in rows:\n    print(\"=\"*50)\n    print(f\"EID: {r[0]} | Code: {r[1]} | Host: {r[2]} | Image: {r[3]} | Target: {r[4]}\")\n    print(r[5].strip())\n\nEOF\npython3 /tmp/inspect_remaining_details.py > /tmp/remaining_details.txt\ncat /tmp/remaining_details.txt\n"]
