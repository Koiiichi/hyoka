[129.568369, "o", "> "]
[129.568459, "o", "print(f\"Total malicious candidate events found: {len(candidates)}\")\r\n\u001b[?2004l\r\u001b[?2004h> # print count of candidates by event code\r\n\u001b[?2004l\r\u001b[?2004h"]
[129.568478, "o", "> "]
[129.568562, "o", "from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.568593, "o", "ec_counts = Counter([c[1] for c in candidates])\r\n\u001b[?2004l\r\u001b[?2004h"]
[129.568687, "o", "> "]
[129.568749, "o", "print(\"By event code:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
