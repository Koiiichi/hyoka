[129.560803, "i", "cat << 'EOF' > /tmp/malicious_candidates.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nmalicious_guids = {'{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}'}\nmalicious_pids = {1648, 6504}\nmalicious_pids_hex = {'0x670', '0x1968'} # 1648 in hex is 0x670, 6504 is 0x1968\n\ncandidates = []\n\ncur.execute(\"SELECT event_id, event_code, timestamp, host, user, image, target_image, process_guid, message FROM events;\")\nrows = cur.fetchall()\n\nfor r in rows:\n    eid, ec, ts, host, user, img, tgt_img, pguid, msg = r\n    \n    is_malicious = False\n    reason = \"\"\n    \n    # 1. Matches malicious process GUIDs\n    if pguid in malicious_guids:\n        is_malicious = True\n        reason = f\"Process GUID match ({pguid})\"\n        \n    # 2. Event ID 800 or 4103 (already verified to belong to malicious powershell)\n    elif ec in (800, 4103) and host == 'WS-05.corp.example':\n        is_malicious = True\n        reason = \"PowerShell execution event on WS-05\"\n        \n    # 3. Source process is malicious powershell/whoami\n    elif img and ('powershell' in img.lower() or 'whoami' in img.lower()) and host == 'WS-05.corp.example':\n        # double check GUID or PID\n        if pguid in malicious_guids or '1648' in msg or '6504' in msg:\n            is_malicious = True\n            reason = \"Malicious image and PID/GUID match in message\"\n            \n    # 4. Process Access (Event 10) initiated by powershell.exe (PID 1648)\n    elif ec == 10 and host == 'WS-05.corp.example':\n        # check if SourceProcessId is 1648/6504 or SourceProcessGUID in malicious_guids\n        if 'SourceProcessGUID: {297bc33e-65d0-5f2d-8207-000000000400}' in msg or 'SourceProcessId: 1648' in msg:\n            is_malicious = True\n            reason = \"Process Access initiated by malicious process\"\n            \n    # 5. Security event for process creation (4688) or termination (4689)\n    elif ec in (4688, 4689) and host == 'WS-05.corp.example':\n        # check if it relates to whoami or powershell\n        if 'whoami.exe' in msg or '6504' in msg or '0x1968' in msg or '1648' in msg or '0x670' in msg:\n            is_malicious = True\n            reason = f\"Security process event ({ec}) for malicious process\"\n            \n    # 6. Windows Filtering Platform (5156, 5158) related to powershell\n    elif ec in (5156, 5158) and host == 'WS-05.corp.example':\n        if '1648' in msg or 'powershell.exe' in msg.lower():\n            is_malicious = True\n            reason = f\"WFP event ({ec}) for malicious process\"\n            \n    # 7. Named pipe, Registry, DNSEvent or other Sysmon events with matching ProcessGuid\n    # Sysmon events usually have ProcessGuid or ProcessId inside the message\n    elif pguid is None or pguid == '':\n        # Parse process guid from message\n        for line in msg.split('\\n'):\n            if 'ProcessGuid:' in line:\n                g = line.split(':', 1)[1].strip()\n                if g in malicious_guids:\n                    is_malicious = True\n                    reason = f\"Process GUID inside message match ({g})\"\n            if 'ProcessId:' in line:\n                pid_str = line.split(':', 1)[1].strip()\n                try:\n                    pid_val = int(pid_str)\n                    if pid_val in malicious_pids:\n                        is_malicious = True\n                        reason = f\"Process ID inside message match ({pid_val})\"\n                except ValueError:\n                    pass\n\n    if is_malicious:\n        candidates.append((eid, ec, ts, host, img, tgt_img, reason))\n\nprint(f\"Total malicious candidate events found: {len(candidates)}\")\n# print count of candidates by event code\nfrom collections import Counter\nec_counts = Counter([c[1] for c in candidates])\nprint(\"By event code:\")\nfor ec, count in sorted(ec_counts.items()):\n    print(f\"  Event Code {ec}: {count}\")\n\n# Let's save candidates to a file to examine\nwith open('/tmp/mal_events.json', 'w') as f:\n    json.dump(candidates, f, indent=2)\n\nEOF\npython3 /tmp/malicious_candidates.py\n"]
