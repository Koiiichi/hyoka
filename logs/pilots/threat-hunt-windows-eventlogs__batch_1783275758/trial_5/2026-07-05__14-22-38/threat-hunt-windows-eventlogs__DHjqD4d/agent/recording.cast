[47.569717, "o", "0\\\\powershell.exe\\r\\nTargetObject: HKU\\\\S-1-5-21-1363495622-3806888128-621328882-1104\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings\\\\Connections')\r\n\r\n\u001b[?2004hroot@76c2de1d23be:~# "]
[54.838234, "i", "cat << 'EOF' > /tmp/timeline.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's collect all Event ID 3 (Network Connections) and print them\nprint(\"=== Network Connections (Event ID 3) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, src_ip, dst_ip, dst_port, message FROM events WHERE event_code = 3;\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} -> {r[6]}:{r[7]}\")\n\n# Let's collect all Event ID 11 (File Create)\nprint(\"\\n=== File Creations (Event ID 11) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, image, message FROM events WHERE event_code = 11;\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4].strip()[:200]}\")\n\n# Let's check processes created (Event 1 or 4688)\nprint(\"\\n=== Process Creations (Event ID 1, 4688) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code IN (1, 4688);\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5].strip()[:300]}\")\n\nEOF\npython3 /tmp/timeline.py\n"]
