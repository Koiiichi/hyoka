[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's select all events on WS-05, excluding 800 and 4103, ordered by timestamp
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, user, image, target_image, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host LIKE 'WS-05%'
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> with open('/tmp/timeline.txt', 'w') as f:
[?2004l[?2004h>     f.write(f"Total events on WS-05: {len(rows)}\n")
[?2004l[?2004h>     for r in rows:
[?2004l[?2004h>         eid, code, ts, user, image, target_image, msg = r
[?2004l[?2004h>         # Let's extract key details from the message if possible
[?2004l[?2004h>         details = ""
[?2004l[?2004h>         for line in msg.splitlines():
[?2004l[?2004h>             if any(k in line for k in ["CommandLine", "TargetObject", "DestinationIp", "DestinationPort", "QueryName", "GrantedAccess", "ImageLoaded", "PipeName"]):
[?2004l[?2004h>                 details += line.strip() + " | "
[?2004l[?2004h>         f.write(f"{eid} | {code} | {ts} | {user} | {image} | {target_image} | {details}\n")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@d293bee4c389:~# python3 /tmp/hunt_timeline.py
[?2004l[?2004hroot@d293bee4c389:~# wc -l /tmp/timeline.txt
[?2004l5189 /tmp/timeline.txt
[?2004hroot@d293bee4c389:~# cat << 'EOF' > /tmp/hunt_nonpowershell.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Query non-powershell-log events on WS-05
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, user, image, target_image, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host LIKE 'WS-05%' AND event_code NOT IN (800, 4103)
[?2004l[?2004h>     ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> print(f"Total non-powershell-log events on WS-05: {len(rows)}")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     eid, code, ts, user, image, target_image, msg = r
[?2004l[?2004h>     # Check if this event is associated with our malicious GUIDs or has suspicious content
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     for guid in ['{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}']:
[?2004l[?2004h>         if guid in msg:
[?2004l[?2004h>             is_malicious = True
[?2004l[?2004h>             
[?2004l[?2004h>     if "whoami" in msg.lower() or "10.10.10.5" in msg:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h> 
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         print(f"MALICIOUS: {eid} | {code} | {ts} | {user} | {image} | {target_image}")
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Let's print some of the other events to see if they are benign
[?2004l[?2004h>         # especially network connections or registry changes
[?2004l[?2004h>         if code in [1, 3, 10, 11, 12, 13, 17, 18, 22, 4688]:
[?2004l[?2004h>             print(f"SUSP/BENIGN: {eid} | {code} | {ts} | {user} | {image} | {target_image} | {msg[:100].replace('\n', ' ')}")
[?2004l[?2004h> 
