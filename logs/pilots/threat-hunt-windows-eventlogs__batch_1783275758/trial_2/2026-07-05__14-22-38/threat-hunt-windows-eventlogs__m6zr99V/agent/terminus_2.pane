[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's count events by category
[?2004l[?2004h> # 1. PowerShell process GUID {297bc33e-65d0-5f2d-8207-000000000400}
[?2004l[?2004h> cur.execute("SELECT count(*) FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'")
[?2004l[?2004h> print(f"Events with powershell GUID: {cur.fetchone()[0]}")
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Whoami process GUID {297bc33e-660d-5f2d-8407-000000000400}
[?2004l[?2004h> cur.execute("SELECT count(*) FROM events WHERE process_guid = '{297bc33e-660d-5f2d-8407-000000000400}'")
[?2004l[?2004h> print(f"Events with whoami GUID: {cur.fetchone()[0]}")
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Security 4688 whoami.exe
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, message FROM events WHERE event_code=4688 AND message LIKE '%whoami%'")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     print(f"whoami 4688: {r[0]} | {r[1]}")
[?2004l[?2004h> 
[?2004l[?2004h> # 4. WFP events (5156/5158) with dest IP 10.10.10.5
[?2004l[?2004h> cur.execute("SELECT event_code, count(*) FROM events WHERE event_code IN (5156, 5158) AND message LIKE '%10.10.10.5%' GROUP BY event_code")
[?2004l[?2004h> print("WFP events for 10.10.10.5:")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     print(f"  Code: {r[0]} | Count: {r[1]}")
[?2004l[?2004h> 
[?2004l[?2004h> # 5. PowerShell pipeline logs 800
[?2004l[?2004h> cur.execute("SELECT count(*) FROM events WHERE event_code = 800")
[?2004l[?2004h> print(f"PowerShell 800 events: {cur.fetchone()[0]}")
[?2004l[?2004h> 
