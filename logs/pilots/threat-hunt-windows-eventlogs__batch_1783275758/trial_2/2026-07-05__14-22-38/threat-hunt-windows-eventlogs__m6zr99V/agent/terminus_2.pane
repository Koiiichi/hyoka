[?2004l[?2004h> 
[?2004l[?2004h> # Find all event IDs containing Logon ID 0x2BA622 or 0x2ba622
[?2004l[?2004h> cur.execute("SELECT event_id, event_code, message FROM events WHERE message LIKE '%0x2BA622%' OR message LIKE '%0x2ba622%'")
[?2004l[?2004h> logon_id_events = {r[0]: (r[1], "logon_id") for r in cur.fetchall()}
