[?2004l[?2004h> 
[?2004l[?2004h> # Find all event IDs with WFP connections to 10.10.10.5
[?2004l[?2004h> cur.execute("SELECT event_id, event_code FROM events WHERE event_code IN (5156, 5158) AND message LIKE '%10.10.10.5%'")
[?2004l[?2004h> wfp_events = {r[0]: (r[1], "wfp") for r in cur.fetchall()}
[?2004l[?2004h> print(f"WFP events: {len(wfp_events)}")
