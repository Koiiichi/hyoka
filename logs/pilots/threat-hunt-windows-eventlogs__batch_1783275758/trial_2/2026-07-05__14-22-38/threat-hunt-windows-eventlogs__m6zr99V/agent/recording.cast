[116.384063, "i", "cat << 'EOF' > /tmp/hunt_nonpowershell.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Query non-powershell-log events on WS-05\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, target_image, message \n    FROM events \n    WHERE host LIKE 'WS-05%' AND event_code NOT IN (800, 4103)\n    ORDER BY timestamp\n\"\"\")\nrows = cur.fetchall()\nprint(f\"Total non-powershell-log events on WS-05: {len(rows)}\")\nfor r in rows:\n    eid, code, ts, user, image, target_image, msg = r\n    # Check if this event is associated with our malicious GUIDs or has suspicious content\n    is_malicious = False\n    for guid in ['{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}']:\n        if guid in msg:\n            is_malicious = True\n            \n    if \"whoami\" in msg.lower() or \"10.10.10.5\" in msg:\n        is_malicious = True\n\n    if is_malicious:\n        print(f\"MALICIOUS: {eid} | {code} | {ts} | {user} | {image} | {target_image}\")\n    else:\n        # Let's print some of the other events to see if they are benign\n        # especially network connections or registry changes\n        if code in [1, 3, 10, 11, 12, 13, 17, 18, 22, 4688]:\n            print(f\"SUSP/BENIGN: {eid} | {code} | {ts} | {user} | {image} | {target_image} | {msg[:100].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/hunt_nonpowershell.py\n"]
