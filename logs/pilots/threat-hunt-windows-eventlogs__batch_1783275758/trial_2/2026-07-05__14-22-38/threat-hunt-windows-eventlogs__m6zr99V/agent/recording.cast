[72.669794, "i", "cat << 'EOF' > /tmp/hunt_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's inspect PowerShell logs (800)\ncur.execute(\"SELECT host, user, count(*) FROM events WHERE event_code = 800 GROUP BY host, user\")\nprint(\"=== Event 800 distribution ===\")\nfor r in cur.fetchall():\n    print(r)\n\n# Let's inspect PowerShell logs (4103)\ncur.execute(\"SELECT host, user, count(*) FROM events WHERE event_code = 4103 GROUP BY host, user\")\nprint(\"=== Event 4103 distribution ===\")\nfor r in cur.fetchall():\n    print(r)\n\n# Let's check a few event 800 messages to see what they contain\ncur.execute(\"SELECT event_id, message FROM events WHERE event_code = 800 LIMIT 5\")\nprint(\"\\n=== Event 800 Sample ===\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1][:200].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/hunt_details.py\n"]
