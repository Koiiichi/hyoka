[163.556581, "i", "cat << 'EOF' > /tmp/hunt_groups.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's inspect Event 400 and 600\ncur.execute(\"SELECT event_id, event_code, host, message FROM events WHERE event_code IN (400, 600)\")\nprint(\"=== Event 400 and 600 ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3][:100].replace('\\n', ' '))\n\n# Let's count other registry events\ncur.execute(\"\"\"\n    SELECT count(*) \n    FROM events \n    WHERE host LIKE 'WS-05%' AND event_code IN (12, 13) AND process_guid != '{297bc33e-65d0-5f2d-8207-000000000400}'\n\"\"\")\nprint(f\"\\nOther Registry events on WS-05: {cur.fetchone()[0]}\")\n\nEOF\npython3 /tmp/hunt_groups.py\n"]
