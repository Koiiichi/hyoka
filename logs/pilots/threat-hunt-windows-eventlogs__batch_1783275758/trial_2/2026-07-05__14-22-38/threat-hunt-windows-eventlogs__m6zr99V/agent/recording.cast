[48.283962, "o", "\u001b[?2004hroot@d293bee4c389:~# "]
[53.423149, "i", "cat << 'EOF' > /tmp/hunt_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Find all events associated with process guid {297bc33e-65d0-5f2d-8207-000000000400}\ncur.execute(\"SELECT event_id, event_code, timestamp, host, user, image, message FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\")\nrows = cur.fetchall()\nprint(f\"Total events for {{297bc33e-65d0-5f2d-8207-000000000400}}: {len(rows)}\")\nfor r in rows:\n    print(f\"{r[0]} | Code: {r[1]} | TS: {r[2]} | Host: {r[3]} | User: {r[4]} | Image: {r[5]}\")\n\n# Let's inspect Sysmon 10 (Process Access)\nprint(\"\\n=== Sysmon 10 (Process Access) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, target_image, granted_access, message FROM events WHERE event_code = 10\")\nfor r in cur.fetchall():\n    msg = r[7]\n    source_process = \"\"\n    target_process = \"\"\n    for line in msg.splitlines():\n        if \"SourceImage:\" in line:\n            source_process = line.split()[-1]\n        if \"TargetImage:\" in line:\n            target_process = line.split()[-1]\n    # If the access is suspicious, or source_process is powershell, or target_process is lsass\n    if \"powershell\" in source_process.lower() or \"lsass\" in target_process.lower():\n        print(f\"{r[0]} | {r[1]} | {r[2]} | {source_process} -> {target_process} | {r[6]}\")\n\nEOF\npython3 /tmp/hunt_details.py\n"]
