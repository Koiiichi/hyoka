[151.605204, "i", "cat << 'EOF' > /tmp/hunt_groups.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's inspect WmiPrvSE.exe {297bc33e-65d2-5f2d-8307-000000000400} events\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE process_guid = '{297bc33e-65d2-5f2d-8307-000000000400}'\")\nprint(\"=== WmiPrvSE.exe events ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2][:300].replace('\\n', ' '))\n\n# Let's inspect backgroundTaskHost.exe {297bc33e-65d0-5f2d-8107-000000000400} events\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8107-000000000400}'\")\nprint(\"\\n=== backgroundTaskHost.exe events ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2][:300].replace('\\n', ' '))\n\n# Let's see if there are any other network connections or process access events on WS-05\n# that might be from other processes\ncur.execute(\"SELECT event_id, event_code, image, message FROM events WHERE host LIKE 'WS-05%' AND event_code = 3 AND process_guid != '{297bc33e-65d0-5f2d-8207-000000000400}'\")\nprint(\"\\n=== Other Network Connections on WS-05 ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3][:200].replace('\\n', ' '))\n\nEOF\npython3 /tmp/hunt_groups.py\n"]
