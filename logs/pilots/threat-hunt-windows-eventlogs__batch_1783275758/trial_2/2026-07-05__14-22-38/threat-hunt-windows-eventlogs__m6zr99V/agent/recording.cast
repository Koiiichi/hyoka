[29.423929, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's see unique process executions from Sysmon (1) and Security (4688)\ncur.execute(\"SELECT event_id, event_code, host, user, image, message FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp\")\nrows = cur.fetchall()\nprint(f\"Total process creation events: {len(rows)}\")\nfor r in rows:\n    print(f\"ID: {r[0]} | Code: {r[1]} | Host: {r[2]} | User: {r[3]} | Image: {r[4]}\")\n    # print command line\n    for line in r[5].splitlines():\n        if \"CommandLine\" in line or \"Process Command Line\" in line or \"ParentCommandLine\" in line:\n            print(\"  \" + line)\n\nEOF\npython3 /tmp/hunt.py\n"]
