[98.400304, "i", "cat << 'EOF' > /tmp/hunt_timeline.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's select all events on WS-05, excluding 800 and 4103, ordered by timestamp\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, target_image, message \n    FROM events \n    WHERE host LIKE 'WS-05%' AND event_code NOT IN (800, 4103, 5156, 5158)\n    ORDER BY timestamp\n\"\"\")\nrows = cur.fetchall()\nprint(f\"Total non-noise events on WS-05: {len(rows)}\")\nfor r in rows:\n    eid, code, ts, user, image, target_image, msg = r\n    # Summarize message\n    summary = \"\"\n    for line in msg.splitlines():\n        if any(k in line for k in [\"CommandLine\", \"TargetObject\", \"DestinationIp\", \"DestinationPort\", \"QueryName\", \"GrantedAccess\", \"ImageLoaded\", \"PipeName\"]):\n            summary += line.strip() + \" | \"\n    \n    print(f\"{eid} | {code} | {ts} | {user} | {image} | {target_image} | {summary}\")\n\nEOF\npython3 /tmp/hunt_timeline.py\n"]
[98.400618, "o", "cat << 'EOF' > /tmp/hunt_timeline.py\r\n\u001b[?2004l\r"]
