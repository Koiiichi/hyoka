[116.407631, "o", "\u001b[?2004hroot@d293bee4c389:~# "]
[124.655281, "i", "cat << 'EOF' > /tmp/hunt_groups.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's count events by category\n# 1. PowerShell process GUID {297bc33e-65d0-5f2d-8207-000000000400}\ncur.execute(\"SELECT count(*) FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\")\nprint(f\"Events with powershell GUID: {cur.fetchone()[0]}\")\n\n# 2. Whoami process GUID {297bc33e-660d-5f2d-8407-000000000400}\ncur.execute(\"SELECT count(*) FROM events WHERE process_guid = '{297bc33e-660d-5f2d-8407-000000000400}'\")\nprint(f\"Events with whoami GUID: {cur.fetchone()[0]}\")\n\n# 3. Security 4688 whoami.exe\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE event_code=4688 AND message LIKE '%whoami%'\")\nfor r in cur.fetchall():\n    print(f\"whoami 4688: {r[0]} | {r[1]}\")\n\n# 4. WFP events (5156/5158) with dest IP 10.10.10.5\ncur.execute(\"SELECT event_code, count(*) FROM events WHERE event_code IN (5156, 5158) AND message LIKE '%10.10.10.5%' GROUP BY event_code\")\nprint(\"WFP events for 10.10.10.5:\")\nfor r in cur.fetchall():\n    print(f\"  Code: {r[0]} | Count: {r[1]}\")\n\n# 5. PowerShell pipeline logs 800\ncur.execute(\"SELECT count(*) FROM events WHERE event_code = 800\")\nprint(f\"PowerShell 800 events: {cur.fetchone()[0]}\")\n\n# 6. PowerShell module logs 4103\ncur.execute(\"SELECT count(*) FROM events WHERE event_code = 4103\")\nprint(f\"PowerShell 4103 events: {cur.fetchone()[0]}\")\n\nEOF\npython3 /tmp/hunt_groups.py\n"]
[124.655696, "o", "cat << 'EOF' > /tmp/hunt_groups.py\r\n\u001b[?2004l\r"]
[124.655766, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
