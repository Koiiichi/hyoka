[63.628742, "i", "cat << 'EOF' > /tmp/hunt_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Check other hosts\nfor host in ['DC01.corp.example', 'WS-06.corp.example']:\n    print(f\"\\n=== Events on {host} ===\")\n    # Any Sysmon Event 1 or Security 4688 on these hosts?\n    cur.execute(\"SELECT event_id, event_code, image, message FROM events WHERE host = ? AND event_code IN (1, 4688)\", (host,))\n    res = cur.fetchall()\n    print(f\"Process creations: {len(res)}\")\n    for r in res:\n        print(r)\n\n    # Any Sysmon Event 3 (Network) on these hosts?\n    cur.execute(\"SELECT event_id, event_code, image, message FROM events WHERE host = ? AND event_code = 3 LIMIT 10\", (host,))\n    res = cur.fetchall()\n    print(f\"Network connections: {len(res)}\")\n    for r in res:\n        print(r[0], r[1], r[2])\n\n    # Any Sysmon Event 10 (Process Access) on these hosts?\n    cur.execute(\"SELECT event_id, event_code, image, message FROM events WHERE host = ? AND event_code = 10 LIMIT 10\", (host,))\n    res = cur.fetchall()\n    print(f\"Process access: {len(res)}\")\n    for r in res:\n        print(r[0], r[1], r[2])\n\nEOF\npython3 /tmp/hunt_details.py\n"]
