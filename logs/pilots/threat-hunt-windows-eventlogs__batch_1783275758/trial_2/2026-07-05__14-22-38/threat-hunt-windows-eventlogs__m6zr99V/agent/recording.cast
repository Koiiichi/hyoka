[39.965809, "i", "cat << 'EOF' > /tmp/hunt_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's check Sysmon 11 (File Created)\nprint(\"=== Sysmon 11 (File Created) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code = 11\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5].replace('\\n', ' ')}\")\n\n# Let's check Sysmon 17 & 18 (Pipes)\nprint(\"\\n=== Sysmon 17 & 18 (Pipes) ===\")\ncur.execute(\"SELECT event_id, event_code, timestamp, host, user, image, message FROM events WHERE event_code IN (17, 18)\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5]} | {r[6].replace('\\n', ' ')}\")\n\n# Let's check Sysmon 10 (Process Access)\nprint(\"\\n=== Sysmon 10 (Process Access) (sample) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code = 10 LIMIT 15\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5].replace('\\n', ' ')}\")\n\n# Let's check Sysmon 3 (Network)\nprint(\"\\n=== Sysmon 3 (Network) (sample) ===\")\ncur.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code = 3 LIMIT 15\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5].replace('\\n', ' ')}\")\n\nEOF\npython3 /tmp/hunt_details.py\n"]
