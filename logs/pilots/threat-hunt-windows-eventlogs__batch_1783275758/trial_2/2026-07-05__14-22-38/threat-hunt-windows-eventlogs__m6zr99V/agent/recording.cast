[116.386861, "o", "            print(f\"SUSP/BENIGN: {eid} | {code} | {ts} | {user} | {image} | {target_image} | {msg[:100].replace('\\n', ' ')}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
