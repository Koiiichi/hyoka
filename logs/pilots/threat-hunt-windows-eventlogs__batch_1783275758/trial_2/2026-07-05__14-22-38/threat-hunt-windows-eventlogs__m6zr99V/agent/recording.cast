[98.424092, "o", "\u001b[?2004hroot@d293bee4c389:~# "]
[103.652856, "i", "cat << 'EOF' > /tmp/hunt_timeline.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's select all events on WS-05, excluding 800 and 4103, ordered by timestamp\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, target_image, message \n    FROM events \n    WHERE host LIKE 'WS-05%'\n    ORDER BY timestamp\n\"\"\")\nrows = cur.fetchall()\n\nwith open('/tmp/timeline.txt', 'w') as f:\n    f.write(f\"Total events on WS-05: {len(rows)}\\n\")\n    for r in rows:\n        eid, code, ts, user, image, target_image, msg = r\n        # Let's extract key details from the message if possible\n        details = \"\"\n        for line in msg.splitlines():\n            if any(k in line for k in [\"CommandLine\", \"TargetObject\", \"DestinationIp\", \"DestinationPort\", \"QueryName\", \"GrantedAccess\", \"ImageLoaded\", \"PipeName\"]):\n                details += line.strip() + \" | \"\n        f.write(f\"{eid} | {code} | {ts} | {user} | {image} | {target_image} | {details}\\n\")\n\nEOF\npython3 /tmp/hunt_timeline.py\nwc -l /tmp/timeline.txt\n"]
