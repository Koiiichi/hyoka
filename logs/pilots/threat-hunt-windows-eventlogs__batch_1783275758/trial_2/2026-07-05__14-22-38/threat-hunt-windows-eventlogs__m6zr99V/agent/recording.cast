[88.283773, "i", "cat << 'EOF' > /tmp/hunt_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Get all event_codes and count for {297bc33e-65d0-5f2d-8207-000000000400}\ncur.execute(\"SELECT event_code, count(*) FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' GROUP BY event_code\")\nprint(\"=== Event codes for powershell C2 GUID ===\")\nfor r in cur.fetchall():\n    print(r)\n\n# Get all event_codes and count for {297bc33e-660d-5f2d-8407-000000000400}\ncur.execute(\"SELECT event_code, count(*) FROM events WHERE process_guid = '{297bc33e-660d-5f2d-8407-000000000400}' GROUP BY event_code\")\nprint(\"\\n=== Event codes for whoami GUID ===\")\nfor r in cur.fetchall():\n    print(r)\n\n# What are the events for {297bc33e-65d2-5f2d-8307-000000000400} (WmiPrvSE.exe)?\ncur.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE process_guid = '{297bc33e-65d2-5f2d-8307-000000000400}'\")\nprint(\"\\n=== WmiPrvSE events ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3].replace('\\n', ' '))\n\nEOF\npython3 /tmp/hunt_details.py\n"]
