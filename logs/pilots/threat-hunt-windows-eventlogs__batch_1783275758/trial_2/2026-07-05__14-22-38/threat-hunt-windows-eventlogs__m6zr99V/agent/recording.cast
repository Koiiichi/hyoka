[140.2991, "i", "cat << 'EOF' > /tmp/hunt_groups.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Find all event IDs with process guid {297bc33e-65d0-5f2d-8207-000000000400}\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}'\")\npowershell_guid_events = {r[0]: (r[1], \"powershell_guid\") for r in cur.fetchall()}\nprint(f\"PowerShell guid events: {len(powershell_guid_events)}\")\n\n# Find all event IDs with process guid {297bc33e-660d-5f2d-8407-000000000400}\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE process_guid = '{297bc33e-660d-5f2d-8407-000000000400}'\")\nwhoami_guid_events = {r[0]: (r[1], \"whoami_guid\") for r in cur.fetchall()}\nprint(f\"Whoami guid events: {len(whoami_guid_events)}\")\n\n# Find all event IDs containing Logon ID 0x2BA622 or 0x2ba622\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE message LIKE '%0x2BA622%' OR message LIKE '%0x2ba622%'\")\nlogon_id_events = {r[0]: (r[1], \"logon_id\") for r in cur.fetchall()}\nprint(f\"Logon ID events: {len(logon_id_events)}\")\n\n# Find all event IDs with WFP connections to 10.10.10.5\ncur.execute(\"SELECT event_id, event_code FROM events WHERE event_code IN (5156, 5158) AND message LIKE '%10.10.10.5%'\")\nwfp_events = {r[0]: (r[1], \"wfp\") for r in cur.fetchall()}\nprint(f\"WFP events: {len(wfp_events)}\")\n\n# Merge them and inspect\nall_malicious = {}\nall_malicious.update(powershell_guid_events)\nall_malicious.update(whoami_guid_events)\nall_malicious.update(logon_id_events)\nall_malicious.update(wfp_events)\nprint(f\"Total unique malicious events so far: {len(all_malicious)}\")\n\n# Let's count by event_code in our combined malicious set\ncodes = {}\nfor eid, (code, src) in all_malicious.items():\n    codes[code] = codes.get(code, 0) + 1\nprint(\"Count by event code in malicious set:\")\nfor code, count in sorted(codes.items()):\n    print(f\"  Event ID: {code} | Count: {count}\")\n\nEOF\npython3 /tmp/hunt_groups.py\n"]
