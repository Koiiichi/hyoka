[195.829517, "i", "cat << 'EOF' > /tmp/hunt_groups.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_code, count(*)\n    FROM events \n    WHERE host LIKE 'WS-05%'\n    AND event_code NOT IN (800, 4103, 5156, 5158)\n    AND (image LIKE '%powershell.exe' OR message LIKE '%powershell.exe%')\n    GROUP BY event_code\n\"\"\")\nprint(\"Powershell related events by code:\")\nfor r in cur.fetchall():\n    print(f\"  Code: {r[0]} | Count: {r[1]}\")\n\nEOF\npython3 /tmp/hunt_groups.py\n"]
