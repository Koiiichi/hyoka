[77.414615, "i", "cat << 'EOF' > /tmp/hunt_details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's see unique process_guid and image combinations\ncur.execute(\"SELECT host, image, process_guid, count(*) FROM events WHERE process_guid IS NOT NULL AND process_guid != '' GROUP BY host, image, process_guid\")\nfor r in cur.fetchall():\n    print(r)\n\nEOF\npython3 /tmp/hunt_details.py\n"]
