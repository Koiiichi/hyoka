[182.057466, "i", "cat << 'EOF' > /tmp/hunt_verify.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# LSASS access\ncur.execute(\"SELECT event_id, host, image, target_image, message FROM events WHERE event_code = 10 AND message LIKE '%lsass%'\")\nprint(\"=== LSASS access ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3], \"suspicious\" if \"0x1010\" in r[4] or \"0x1fffff\" in r[4] or \"0x1410\" in r[4] else \"normal\")\n\n# Run keys\ncur.execute(\"SELECT event_id, host, image, message FROM events WHERE event_code IN (12, 13) AND (message LIKE '%Run%' OR message LIKE '%Active Setup%')\")\nprint(\"=== Run keys ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3][:150].replace('\\n', ' '))\n\n# Other hosts\ncur.execute(\"SELECT event_id, host, event_code, message FROM events WHERE host != 'WS-05.corp.example' AND (message LIKE '%pgustavo%' OR message LIKE '%10.10.10.5%')\")\nprint(\"=== Other hosts ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3][:150].replace('\\n', ' '))\nEOF\npython3 /tmp/hunt_verify.py\n"]
