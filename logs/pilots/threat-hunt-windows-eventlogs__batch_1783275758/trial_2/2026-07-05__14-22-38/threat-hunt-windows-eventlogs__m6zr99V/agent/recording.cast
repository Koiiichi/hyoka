[249.475862, "i", "cat << 'EOF' > /tmp/hunt_compiler.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\ncore_events = set()\n\n# Whoami execution and exit\ncur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-660d-5f2d-8407-000000000400}' AND event_code IN (1, 5)\")\nfor r in cur.fetchall(): core_events.add(r[0])\n\ncur.execute(\"SELECT event_id FROM events WHERE event_code IN (4688, 4689) AND message LIKE '%whoami.exe%'\")\nfor r in cur.fetchall(): core_events.add(r[0])\n\n# Process Access\ncore_events.add('evt-00288')\ncore_events.add('evt-02451')\n\n# C2 Network\ncur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' AND event_code = 3\")\nfor r in cur.fetchall(): core_events.add(r[0])\n\n# C2 DNS\ncur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' AND event_code = 22\")\nfor r in cur.fetchall(): core_events.add(r[0])\n\n# C2 Registry\ncur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' AND event_code = 12\")\nfor r in cur.fetchall(): core_events.add(r[0])\n\n# C2 Pipes\ncur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' AND event_code IN (17, 18)\")\nfor r in cur.fetchall(): core_events.add(r[0])\n\nprint(\"Core events size:\", len(core_events))\n\n# Image Loads\nimage_loads = set()\ncur.execute(\"SELECT event_id FROM events WHERE process_guid IN ('{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}') AND event_code = 7\")\nfor r in cur.fetchall(): image_loads.add(r[0])\nprint(\"Image load events size:\", len(image_loads))\n\n# WFP\nwfp_events = set()\ncur.execute(\"SELECT event_id FROM events WHERE event_code = 5156 AND message LIKE '%10.10.10.5%'\")\nfor r in cur.fetchall(): wfp_events.add(r[0])\nprint(\"WFP events size:\", len(wfp_events))\n\n# Logon ID\nsec_logon_events = set()\ncur.execute(\"SELECT event_id FROM events WHERE (message LIKE '%0x2BA622%' OR message LIKE '%0x2ba622%') AND event_code IN (4656, 4658, 4663, 4673, 4690)\")\nfor r in cur.fetchall(): sec_logon_events.add(r[0])\nprint(\"Logon ID Security events size:\", len(sec_logon_events))\n\nEOF\npython3 /tmp/hunt_compiler.py\n"]
[249.476625, "o", "cat << 'EOF' > /tmp/hunt_compiler.py\r\n\u001b[?2004l\r"]
[249.478502, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> core_events = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Whoami execution and exit\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-660d-5f2d-8407-000000000400}' AND event_code IN (1, 5)\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall(): core_events.add(r[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id FROM events WHERE event_code IN (4688, 4689) AND message LIKE '%whoami.exe%'\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall(): core_events.add(r[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Process Access\r\n\u001b[?2004l\r\u001b[?2004h> core_events.add('evt-00288')\r\n\u001b[?2004l\r\u001b[?2004h> core_events.add('evt-02451')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # C2 Network\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' AND event_code = 3\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall(): core_events.add(r[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # C2 DNS\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' AND event_code = 22\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall(): core_events.add(r[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # C2 Registry\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' AND event_code = 12\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall(): core_events.add(r[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # C2 Pipes\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' AND event_code IN (17, 18)\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall(): core_events.add(r[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
