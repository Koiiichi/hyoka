[207.462811, "i", "cat << 'EOF' > /tmp/hunt_groups.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, image, target_image \n    FROM events \n    WHERE host LIKE 'WS-05%' AND event_code = 10 \n    AND (image LIKE '%powershell.exe' OR target_image LIKE '%powershell.exe' OR message LIKE '%powershell.exe%')\n\"\"\")\nfor r in cur.fetchall():\n    print(f\"ID: {r[0]} | Source: {r[1]} | Target: {r[2]}\")\n\nEOF\npython3 /tmp/hunt_groups.py\n"]
