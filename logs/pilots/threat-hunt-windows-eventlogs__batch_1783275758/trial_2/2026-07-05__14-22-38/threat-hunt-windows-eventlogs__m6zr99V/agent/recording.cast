[151.629783, "o", "\u001b[?2004hroot@d293bee4c389:~# "]
[158.819299, "i", "cat << 'EOF' > /tmp/hunt_groups.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's inspect Event 400 and 600\ncur.execute(\"SELECT event_id, event_code, host, message FROM events WHERE event_code IN (400, 600)\")\nprint(\"=== Event 400 and 600 ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3][:150].replace('\\n', ' '))\n\n# Let's inspect Sysmon Event 12 & 13 on WS-05 that are NOT from {297bc33e-65d0-5f2d-8207-000000000400}\ncur.execute(\"\"\"\n    SELECT event_id, event_code, image, message \n    FROM events \n    WHERE host LIKE 'WS-05%' AND event_code IN (12, 13) AND process_guid != '{297bc33e-65d0-5f2d-8207-000000000400}'\n\"\"\")\nprint(\"\\n=== Other Registry events on WS-05 ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2], r[3][:150].replace('\\n', ' '))\n\nEOF\npython3 /tmp/hunt_groups.py\n"]
