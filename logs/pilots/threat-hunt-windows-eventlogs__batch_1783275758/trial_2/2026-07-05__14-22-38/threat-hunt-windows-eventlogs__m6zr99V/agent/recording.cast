[24.070957, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport re\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's get the full message for evt-00282\ncur.execute(\"SELECT message FROM events WHERE event_id = 'evt-00282'\")\nmsg = cur.fetchone()[0]\nprint(\"=== evt-00282 message ===\")\nprint(msg)\n\n# Let's search for powershell command lines\ncur.execute(\"SELECT event_id, event_code, host, user, image, message FROM events WHERE message LIKE '%powershell%' AND (event_code=1 OR event_code=4688 OR event_code=800 OR event_code=4103)\")\nprint(f\"Found {len(cur.fetchall())} powershell related events\")\n\nEOF\npython3 /tmp/hunt.py\n"]
