[191.203873, "i", "cat << 'EOF' > /tmp/hunt_groups.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Check all events on WS-05 where image LIKE '%powershell.exe' or target_image LIKE '%powershell.exe' or message LIKE '%powershell.exe%'\n# but not 800 or 4103\ncur.execute(\"\"\"\n    SELECT event_id, event_code, message \n    FROM events \n    WHERE host LIKE 'WS-05%' AND event_code NOT IN (800, 4103, 5156, 5158)\n    AND (image LIKE '%powershell.exe' OR message LIKE '%powershell.exe%')\n\"\"\")\nrows = cur.fetchall()\nprint(f\"Total powershell-related events (excluding 800, 4103, 5156, 5158): {len(rows)}\")\nfor r in rows[:10]:\n    print(r[0], r[1], r[2][:150].replace('\\n', ' '))\n\n# Let's count how many we have in total of these\nEOF\npython3 /tmp/hunt_groups.py\n"]
