[223.85603, "i", "cat << 'EOF' > /tmp/hunt_candidates.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code FROM events WHERE process_guid = '{297bc33e-660d-5f2d-8407-000000000400}' AND event_code = 5\")\nwhoami_sysmon_exit = [r[0] for r in cur.fetchall()]\n\ncur.execute(\"SELECT event_id, event_code FROM events WHERE event_code = 4689 AND message LIKE '%whoami.exe%'\")\nwhoami_sec_exit = [r[0] for r in cur.fetchall()]\n\ncur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' AND event_code = 3\")\nc2_network = [r[0] for r in cur.fetchall()]\n\ncur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' AND event_code = 12\")\nc2_registry = [r[0] for r in cur.fetchall()]\n\ncur.execute(\"SELECT event_id FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' AND event_code IN (17, 18)\")\nc2_pipes = [r[0] for r in cur.fetchall()]\n\nprint(\"whoami sysmon exit:\", whoami_sysmon_exit)\nprint(\"whoami sec exit:\", whoami_sec_exit)\nprint(\"C2 network connections:\", len(c2_network))\nprint(\"C2 registry edits:\", len(c2_registry))\nprint(\"C2 pipes:\", len(c2_pipes))\nEOF\npython3 /tmp/hunt_candidates.py\n"]
