[130.632059, "i", "cat << 'EOF' > /tmp/hunt_groups.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Let's search for Security 4689 (Process Exit)\ncur.execute(\"SELECT event_id, message FROM events WHERE event_code = 4689\")\nprint(\"=== Event 4689 (Process Exit) ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1].replace('\\n', ' '))\n\n# Let's search for any other Security events with pgustavo or logon ID 0x2BA622\n# Since whoami 4688 has Logon ID: 0x2BA622\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE message LIKE '%0x2BA622%'\")\nprint(\"\\n=== Events with Logon ID 0x2BA622 ===\")\nfor r in cur.fetchall():\n    print(r[0], r[1], r[2].replace('\\n', ' ')) \n\nEOF\npython3 /tmp/hunt_groups.py\n"]
