[48.273396, "o", "print(\"\\n=== Sysmon 10 (Process Access) where SourceImage != svchost.exe/csrss.exe ===\")\r\n\u001b[?2004l\r"]
[48.273542, "o", "\u001b[?2004h> "]
[48.273699, "o", "cur.execute(\"SELECT event_id, timestamp, host, user, image, target_image, granted_access, message FROM events WHERE event_code = 10\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     msg = r[7]\r\n\u001b[?2004l\r"]
[48.273726, "o", "\u001b[?2004h> "]
[48.273854, "o", "    source_process = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.275653, "o", "    target_process = \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.275792, "o", ">     for line in msg.splitlines():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.275835, "o", "        if \"SourceImage:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.275908, "o", "            source_process = line.split()[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.276012, "o", "        if \"TargetImage:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h>             target_process = line.split()[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.276145, "o", "    # If the access is suspicious, or source_process is powershell, or target_process is lsass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.276246, "o", "    if \"powershell\" in source_process.lower() or \"lsass\" in target_process.lower():\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.276352, "o", "> "]
[48.276447, "o", "        print(f\"{r[0]} | {r[1]} | {r[2]} | {source_process} -> {target_process} | {r[6]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[48.277221, "o", "\u001b[?2004hroot@d293bee4c389:~# python3 /tmp/hunt_details.py\r\n\u001b[?2004l\r"]
