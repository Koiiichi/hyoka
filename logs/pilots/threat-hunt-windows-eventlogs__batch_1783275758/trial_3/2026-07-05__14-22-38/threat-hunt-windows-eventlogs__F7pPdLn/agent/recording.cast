[122.133369, "o", "\u001b[?2004hroot@990b70e412e9:~# "]
[127.53184, "i", "cat << 'EOF' > /tmp/parse_logons.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\nc.execute(\"SELECT event_id, timestamp, host, message FROM events WHERE event_code = 4624\")\nfor r_id, ts, host, msg in c.fetchall():\n    # extract Target UserName, Target Domain, Logon Type\n    username = re.search(r'Account Name:\\s*(\\S+)', msg)\n    domain = re.search(r'Account Domain:\\s*(\\S+)', msg)\n    logon_type = re.search(r'Logon Type:\\s*(\\d+)', msg)\n    logon_id = re.search(r'Logon ID:\\s*(\\S+)', msg)\n    \n    u = username.group(1) if username else \"None\"\n    d = domain.group(1) if domain else \"None\"\n    t = logon_type.group(1) if logon_type else \"None\"\n    lid = logon_id.group(1) if logon_id else \"None\"\n    \n    # Wait, there are multiple matches sometimes in 4624 (Subject and New Logon)\n    # Let's find all Account Name matches\n    all_users = re.findall(r'Account Name:\\s*(\\S+)', msg)\n    all_domains = re.findall(r'Account Domain:\\s*(\\S+)', msg)\n    \n    print(f\"{r_id} | {ts} | {host} | LogonType:{t} | Users:{all_users} | Domains:{all_domains} | LogonID:{lid}\")\n\nconn.close()\nEOF\npython3 /tmp/parse_logons.py\n"]
