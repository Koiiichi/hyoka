[122.115466, "i", "cat << 'EOF' > /tmp/check_logons.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\nc.execute(\"\"\"\n    SELECT event_id, timestamp, host, user, message \n    FROM events \n    WHERE event_code = 4624 \n    ORDER BY timestamp ASC\n\"\"\")\nlogons = c.fetchall()\nprint(f\"Total 4624 logon events: {len(logons)}\")\nfor l in logons:\n    print(f\"{l[0]} | {l[1]} | {l[2]} | {l[3]} | {l[4].strip().replace('\\n', ' ')[:150]}\")\n\nconn.close()\nEOF\npython3 /tmp/check_logons.py\n"]
