[225.679623, "o", "\u001b[?2004h> # 2. Events with pgustavo user or SID\r\n\u001b[?2004l\r"]
[225.679654, "o", "\u001b[?2004h> "]
[225.679807, "o", "c.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id FROM events \r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.67994, "o", "    WHERE host = 'WS-05.corp.example' \r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.679973, "o", "      AND (user LIKE '%pgustavo%' \r\n\u001b[?2004l\r\u001b[?2004h>            OR message LIKE '%pgustavo%' \r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.680061, "o", "           OR message LIKE '%S-1-5-21-1363495622-3806888128-621328882-1104%')\r\n\u001b[?2004l\r"]
[225.680227, "o", "\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in c.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     all_malicious.add(r[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.680331, "o", "# 3. Events with the malicious process GUIDs\r\n\u001b[?2004l\r\u001b[?2004h> c.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.680363, "o", "> "]
[225.680443, "o", "    SELECT event_id FROM events \r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.680523, "o", "    WHERE process_guid IN ('{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.68064, "o", "       OR message LIKE '%{297bc33e-65d0-5f2d-8207-000000000400}%'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.680825, "o", "       OR message LIKE '%{297bc33e-660d-5f2d-8407-000000000400}%'\r\n\u001b[?2004l\r"]
[225.680861, "o", "\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in c.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.680876, "o", "    all_malicious.add(r[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[225.681023, "o", "\u001b[?2004h> # 4. WFP events for the process IDs on WS-05\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.681053, "o", "c.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id FROM events\r\n\u001b[?2004l\r"]
[225.681072, "o", "\u001b[?2004h>     WHERE host = 'WS-05.corp.example'\r\n"]
[225.681212, "o", "\u001b[?2004l\r\u001b[?2004h>       AND event_code IN (5156, 5158)"]
[225.681571, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.681816, "o", "      AND (message LIKE '%1648%' OR message LIKE '%0x670%' \r\n\u001b[?2004l\r\u001b[?2004h>            OR message LIKE '%6504%' OR message LIKE '%0x1968%')\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in c.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     all_malicious.add(r[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.681984, "o", "# Let's write them to /root/findings.json\r\n\u001b[?2004l\r\u001b[?2004h> findings = sorted(list(all_malicious))\r\n\u001b[?2004l\r"]
[225.682107, "o", "\u001b[?2004h> with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.682211, "o", "    json.dump(findings, f)\r\n\u001b[?2004l\r"]
[225.682345, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.682927, "o", "print(f\"Successfully wrote {len(findings)} event IDs to /root/findings.json\")\r\n\u001b[?2004l\r\u001b[?2004h> conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[225.683417, "o", "\u001b[?2004hroot@990b70e412e9:~# "]
[225.683461, "o", "python3 /tmp/generate_findings.py\r\n\u001b[?2004l\r"]
[225.71578, "o", "Successfully wrote 4886 event IDs to /root/findings.json\r\n"]
[225.717523, "o", "\u001b[?2004hroot@990b70e412e9:~# "]
[229.708244, "i", "echo 'Done!'\n"]
[229.708451, "o", "echo 'Done!'\r\n\u001b[?2004l\r"]
[229.708932, "o", "Done!\r\n\u001b[?2004hroot@990b70e412e9:~# "]
