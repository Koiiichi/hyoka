[40.624484, "o", "\u001b[?2004hroot@990b70e412e9:~# "]
[48.448399, "i", "cat << 'EOF' > /tmp/trace_attack.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, timestamp, user, image, target_image, message \n    FROM events \n    WHERE event_code NOT IN (800, 4103) \n    ORDER BY timestamp ASC\n\"\"\")\nrows = cursor.fetchall()\n\nprint(f\"Total non-powershell events: {len(rows)}\")\nfor r in rows:\n    event_id, event_code, host, ts, user, image, target_image, msg = r\n    # Summarize message\n    summary = \"\"\n    if event_code == 3:\n        summary = f\"Network Conn: {image} -> dest_ip and port in db\"\n    elif event_code == 11:\n        summary = f\"File Create: {image} - {msg.strip().replace('\\n', ' ')[:100]}\"\n    elif event_code == 12 or event_code == 13:\n        summary = f\"Registry Event {event_code}: {image} - {msg.strip().replace('\\n', ' ')[:100]}\"\n    elif event_code == 10:\n        summary = f\"Process Access: {image} accessed {target_image} - {msg.strip().replace('\\n', ' ')[:100]}\"\n    elif event_code in (17, 18):\n        summary = f\"Pipe Event {event_code}: {image} - {msg.strip().replace('\\n', ' ')[:100]}\"\n    else:\n        summary = f\"{msg.strip().replace('\\n', ' ')[:100]}\"\n    print(f\"{event_id} | {ts} | {host} | EC:{event_code} | User:{user} | Img:{image} | {summary}\")\n\nconn.close()\nEOF\npython3 /tmp/trace_attack.py > /tmp/attack_trace.txt\nhead -n 100 /tmp/attack_trace.txt\n"]
