[194.370151, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\nc.execute('''\n    SELECT event_id, event_code, host, timestamp, user, image, message \n    FROM events \n    WHERE (user LIKE '%pgustavo%' OR message LIKE '%pgustavo%')\n      AND (process_guid IS NULL OR process_guid NOT IN ('{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}'))\n      AND event_id != 'evt-00303'\n      AND event_code NOT IN (800, 4103)\n''')\nprint('Other pgustavo events:')\nfor r in c.fetchall():\n    print(r[0], r[1], r[2], r[3], r[4], r[5], r[6].strip().replace('\\\\n', ' ')[:100])\nconn.close()\n\"\n"]
