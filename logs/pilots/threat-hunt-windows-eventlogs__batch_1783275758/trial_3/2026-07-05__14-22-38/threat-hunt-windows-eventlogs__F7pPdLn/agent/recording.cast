[33.719726, "i", "cat << 'EOF' > /tmp/parse_powershell.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Find unique command lines from event_code 800\ncursor.execute(\"SELECT event_id, timestamp, message FROM events WHERE event_code = 800\")\nrows = cursor.fetchall()\n\ncommands = []\nfor r_id, ts, msg in rows:\n    # extract command line\n    match = re.search(r'Pipeline execution details for command line:\\s*(.*)', msg, re.DOTALL)\n    if match:\n        cmd = match.group(1).strip()\n        # truncate or clean up if needed\n        commands.append((r_id, ts, cmd))\n\nprint(f\"Found {len(commands)} command executions in Event 800\")\n# Let's print unique command strings that don't look like standard boring ones\nseen = set()\nfor r_id, ts, cmd in commands:\n    short_cmd = cmd[:100]\n    if short_cmd not in seen:\n        seen.add(short_cmd)\n        print(f\"{r_id} | {ts} | {cmd[:200]}\")\n\nconn.close()\nEOF\npython3 /tmp/parse_powershell.py\n"]
