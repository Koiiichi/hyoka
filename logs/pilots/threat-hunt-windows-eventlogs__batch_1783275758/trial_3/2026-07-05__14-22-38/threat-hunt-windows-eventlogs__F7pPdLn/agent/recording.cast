[40.576229, "i", "cat << 'EOF' > /tmp/parse_powershell.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, timestamp, message FROM events WHERE event_code = 800\")\nrows = cursor.fetchall()\n\ncommands = []\nfor r_id, ts, msg in rows:\n    match = re.search(r'Pipeline execution details for command line:\\s*(.*)', msg, re.DOTALL)\n    if match:\n        cmd = match.group(1).strip()\n        commands.append((r_id, ts, cmd))\n\nprint(f\"Total commands: {len(commands)}\")\n# Let's filter out known noise and print suspicious/interesting commands\nsuspicious_keywords = ['pe', 'bytes', 'invoke', 'dll', 'ptr', 'virtualalloc', 'getprocaddress', 'loadlibrary', 'kernel32', 'lsass', 'sam', 'system', 'mimikatz', 'whoami', 'net ', 'ping', 'ipconfig', 'token', 'privilege', 'guid', 'hostname', 'domain']\nseen = set()\nfor r_id, ts, cmd in commands:\n    cmd_lower = cmd.lower()\n    if any(k in cmd_lower for k in suspicious_keywords):\n        # check if we already saw something similar\n        normalized = re.sub(r'\\d+', 'N', cmd_lower[:80])\n        if normalized not in seen:\n            seen.add(normalized)\n            print(f\"{r_id} | {ts} | {cmd[:300]}\")\n            if len(cmd) > 300:\n                print(f\"   [TRUNCATED... Total len {len(cmd)}]\")\n\nconn.close()\nEOF\npython3 /tmp/parse_powershell.py\n"]
