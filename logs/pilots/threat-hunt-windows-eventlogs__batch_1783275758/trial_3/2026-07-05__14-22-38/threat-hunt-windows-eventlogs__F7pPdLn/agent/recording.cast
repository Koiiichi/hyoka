[55.037304, "i", "cat << 'EOF' > /tmp/search_trace.py\nimport re\n\nwith open('/tmp/attack_trace.txt', 'r') as f:\n    lines = f.readlines()\n\nprint(\"=== SUSPICIOUS PROCESS ACCESS ===\")\nfor l in lines:\n    if 'EC:10' in l and 'lsass' in l.lower():\n        print(l.strip())\n\nprint(\"=== SUSPICIOUS FILE CREATIONS ===\")\nfor l in lines:\n    if 'EC:11' in l:\n        print(l.strip())\n\nprint(\"=== SUSPICIOUS NETWORK CONNECTIONS ===\")\n# Let's read directly from sqlite for network connections to look at ports and destinations\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\ncursor.execute(\"\"\"\n    SELECT event_id, timestamp, host, user, image, dst_ip, dst_port, message\n    FROM events \n    WHERE event_code IN (3, 5156, 5158) \n    AND dst_ip NOT IN ('127.0.0.1', '::1') \n    LIMIT 40\n\"\"\")\nrows = cursor.fetchall()\nfor r in rows:\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | Dest: {r[5]}:{r[6]}\")\n\nconn.close()\nEOF\npython3 /tmp/search_trace.py\n"]
