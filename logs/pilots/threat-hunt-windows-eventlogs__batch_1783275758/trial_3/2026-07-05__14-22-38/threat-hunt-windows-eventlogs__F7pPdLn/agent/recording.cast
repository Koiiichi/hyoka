[112.971973, "i", "cat << 'EOF' > /tmp/investigate_guids.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\n# Look at events for powershell guid\nc.execute(\"SELECT event_id, event_code, host, timestamp, user, image, target_image FROM events WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' OR message LIKE '%{297bc33e-65d0-5f2d-8207-000000000400}%'\")\nps_events = c.fetchall()\nprint(\"=== POWERSHELL GUID EVENTS ===\")\nfor e in ps_events:\n    # just print summaries\n    print(f\"{e[0]} | EC:{e[1]} | {e[2]} | {e[3]} | User:{e[4]} | Img:{e[5]} -> {e[6]}\")\n\n# Look at events for whoami guid\nc.execute(\"SELECT event_id, event_code, host, timestamp, user, image, target_image FROM events WHERE process_guid = '{297bc33e-660d-5f2d-8407-000000000400}' OR message LIKE '%{297bc33e-660d-5f2d-8407-000000000400}%'\")\nwhoami_evs = c.fetchall()\nprint(\"\\n=== WHOAMI GUID EVENTS ===\")\nfor e in whoami_evs:\n    print(f\"{e[0]} | EC:{e[1]} | {e[2]} | {e[3]} | User:{e[4]} | Img:{e[5]} -> {e[6]}\")\n\nconn.close()\nEOF\npython3 /tmp/investigate_guids.py > /tmp/guid_details.txt\nhead -n 40 /tmp/guid_details.txt\n"]
