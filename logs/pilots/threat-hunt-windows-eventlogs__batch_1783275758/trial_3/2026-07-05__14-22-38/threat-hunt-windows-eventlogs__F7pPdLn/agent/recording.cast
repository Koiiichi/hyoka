[62.249326, "i", "cat << 'EOF' > /tmp/search_db.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nprint(\"=== EVENT CODE 11 (File Create) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, image, message FROM events WHERE event_code = 11\")\nfor r in cursor.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5].strip().replace('\\n', ' ')[:150]}\")\n\nprint(\"\\n=== EVENT CODE 10 (Process Access) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, image, target_image, granted_access, message FROM events WHERE event_code = 10\")\nfor r in cursor.fetchall():\n    # check if suspicious\n    is_suspicious = False\n    msg = r[7].lower()\n    if 'lsass' in r[5].lower() or 'sam' in msg or 'granted' in msg or '0x1f1fff' in msg or '0x1410' in msg or '0x1010' in r[6].lower():\n        is_suspicious = True\n    if is_suspicious:\n        print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} -> {r[5]} | Access: {r[6]} | {r[7].strip().replace('\\n', ' ')[:100]}\")\n\nprint(\"\\n=== OTHER RARE EVENTS ===\")\ncursor.execute(\"SELECT event_id, event_code, host, user, image, message FROM events WHERE event_code NOT IN (800, 4103, 10, 12, 13, 3, 5156, 5158, 4656, 4658, 4690, 4663, 7)\")\nfor r in cursor.fetchall():\n    print(f\"{r[0]} | EC: {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5].strip().replace('\\n', ' ')[:150]}\")\n\nconn.close()\nEOF\npython3 /tmp/search_db.py\n"]
