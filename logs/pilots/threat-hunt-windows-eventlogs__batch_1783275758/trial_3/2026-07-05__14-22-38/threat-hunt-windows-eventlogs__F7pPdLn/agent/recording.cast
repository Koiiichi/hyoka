[142.56038, "i", "cat << 'EOF' > /tmp/get_ws05_timeline.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\nc.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, target_image, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND timestamp BETWEEN '2026-05-06T14:32:20Z' AND '2026-05-06T14:35:30Z'\n    ORDER BY timestamp ASC\n\"\"\")\nrows = c.fetchall()\nprint(f\"Total events on WS-05 in timeframe: {len(rows)}\")\n\n# Group them by event_code\nby_code = {}\nfor r in rows:\n    ec = r[1]\n    by_code[ec] = by_code.get(ec, 0) + 1\nprint(\"Event count by code in timeframe:\", by_code)\n\nconn.close()\nEOF\npython3 /tmp/get_ws05_timeline.py\n"]
