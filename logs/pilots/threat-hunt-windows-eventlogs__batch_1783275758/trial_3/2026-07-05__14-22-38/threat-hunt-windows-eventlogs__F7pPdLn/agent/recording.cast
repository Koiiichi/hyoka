[225.678082, "i", "cat << 'EOF' > /tmp/generate_findings.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\nall_malicious = set()\n\n# 1. 800 and 4103 on WS-05\nc.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103)\")\nfor r in c.fetchall():\n    all_malicious.add(r[0])\n\n# 2. Events with pgustavo user or SID\nc.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND (user LIKE '%pgustavo%' \n           OR message LIKE '%pgustavo%' \n           OR message LIKE '%S-1-5-21-1363495622-3806888128-621328882-1104%')\n\"\"\")\nfor r in c.fetchall():\n    all_malicious.add(r[0])\n\n# 3. Events with the malicious process GUIDs\nc.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE process_guid IN ('{297bc33e-65d0-5f2d-8207-000000000400}', '{297bc33e-660d-5f2d-8407-000000000400}')\n       OR message LIKE '%{297bc33e-65d0-5f2d-8207-000000000400}%'\n       OR message LIKE '%{297bc33e-660d-5f2d-8407-000000000400}%'\n\"\"\")\nfor r in c.fetchall():\n    all_malicious.add(r[0])\n\n# 4. WFP events for the process IDs on WS-05\nc.execute(\"\"\"\n    SELECT event_id FROM events\n    WHERE host = 'WS-05.corp.example'\n      AND event_code IN (5156, 5158)\n      AND (message LIKE '%1648%' OR message LIKE '%0x670%' \n           OR message LIKE '%6504%' OR message LIKE '%0x1968%')\n\"\"\")\nfor r in c.fetchall():\n    all_malicious.add(r[0])\n\n# Let's write them to /root/findings.json\nfindings = sorted(list(all_malicious))\nwith open('/root/findings.json', 'w') as f:\n    json.dump(findings, f)\n\nprint(f\"Successfully wrote {len(findings)} event IDs to /root/findings.json\")\nconn.close()\nEOF\npython3 /tmp/generate_findings.py\n"]
[225.678474, "o", "cat << 'EOF' > /tmp/generate_findings.py\r\n"]
[225.678677, "o", "\u001b[?2004l\r\u001b[?2004h> "]
