[76.965785, "i", "cat << 'EOF' > /tmp/extract_powershell.py\nimport sqlite3\nimport re\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Query all event codes 800 and 4103\ncursor.execute(\"SELECT event_id, timestamp, event_code, host, user, message FROM events WHERE event_code IN (800, 4103) ORDER BY timestamp ASC\")\nrows = cursor.fetchall()\n\nprint(f\"Found {len(rows)} PowerShell events\")\nsuspicious_ids = []\n\n# Let's inspect some of them\nfor r in rows:\n    event_id, ts, ec, host, user, msg = r\n    msg_lower = msg.lower()\n    \n    # We know the host running malicious power-shell is WS-05\n    # Wait, let's check if there are powershell events on other hosts too.\n    # Let's count powershell events per host first\nconn.close()\nEOF\npython3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\nc.execute('SELECT host, event_code, COUNT(*) FROM events WHERE event_code IN (800, 4103) GROUP BY host, event_code')\nfor r in c.fetchall(): print(r)\nconn.close()\n\"\n"]
