[88.818294, "o", "apps = set()\r\n\u001b[?2004l\r\u001b[?2004h> ids = set()\r\n\u001b[?2004l\r\u001b[?2004h> for r in c.fetchall():\r\n\u001b[?2004l\r"]
[88.818382, "o", "\u001b[?2004h>     msg = r[0]\r\n\u001b[?2004l\r\u001b[?2004h>     for line in msg.split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.81848, "o", "        if 'Host Application' in line or 'HostApplication' in line:\r\n\u001b[?2004l\r\u001b[?2004h>             apps.add(line.strip())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.818567, "o", "        if 'Host ID' in line or 'HostId' in line or 'Host ID' in line:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.819545, "o", "            ids.add(line.strip())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Unique Host Apps:\")\r\n\u001b[?2004l\r\u001b[?2004h> for a in apps:\r\n\u001b[?2004l\r\u001b[?2004h>     print(a[:150])\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nUnique Host IDs:\")\r\n\u001b[?2004l\r\u001b[?2004h> for i in ids:\r\n\u001b[?2004l\r\u001b[?2004h>     print(i)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
