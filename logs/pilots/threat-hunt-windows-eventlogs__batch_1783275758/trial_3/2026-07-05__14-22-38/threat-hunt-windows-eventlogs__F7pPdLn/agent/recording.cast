[88.817863, "i", "cat << 'EOF' > /tmp/inspect_apps.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\nc.execute('SELECT message FROM events WHERE event_code = 800')\n\napps = set()\nids = set()\nfor r in c.fetchall():\n    msg = r[0]\n    for line in msg.split('\\n'):\n        if 'Host Application' in line or 'HostApplication' in line:\n            apps.add(line.strip())\n        if 'Host ID' in line or 'HostId' in line or 'Host ID' in line:\n            ids.add(line.strip())\n\nprint(\"Unique Host Apps:\")\nfor a in apps:\n    print(a[:150])\nprint(\"\\nUnique Host IDs:\")\nfor i in ids:\n    print(i)\n\nconn.close()\nEOF\npython3 /tmp/inspect_apps.py\n"]
[88.818118, "o", "cat << 'EOF' > /tmp/inspect_apps.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
