[106.883717, "i", "cat << 'EOF' > /tmp/malicious_candidates.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\n# Let's find all event_ids directly associated with the PowerShell process GUID: {297bc33e-65d0-5f2d-8207-000000000400}\nc.execute(\"\"\"\n    SELECT event_id, event_code, host, timestamp, user, image, target_image, message \n    FROM events \n    WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' \n       OR message LIKE '%{297bc33e-65d0-5f2d-8207-000000000400}%'\n\"\"\")\nps_guid_events = c.fetchall()\nprint(f\"Events directly associated with PS process guid: {len(ps_guid_events)}\")\n\n# Also let's find the whoami process creation event(s) and any other events. \n# ParentProcessGuid of whoami: {297bc33e-65d0-5f2d-8207-000000000400}\n# ProcessGuid of whoami: {297bc33e-660d-5f2d-8407-000000000400}\nc.execute(\"\"\"\n    SELECT event_id, event_code, host, timestamp, user, image, target_image, message \n    FROM events \n    WHERE process_guid = '{297bc33e-660d-5f2d-8407-000000000400}' \n       OR message LIKE '%{297bc33e-660d-5f2d-8407-000000000400}%'\n\"\"\")\nwhoami_events = c.fetchall()\nprint(f\"Events associated with whoami process guid: {len(whoami_events)}\")\n\n# What about the security log process creation Event 4688 for whoami?\n# Creator Process Name: C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\n# Process Command Line: \"C:\\windows\\system32\\whoami.exe\" /user\n# This is evt-00303.\n\nconn.close()\nEOF\npython3 /tmp/malicious_candidates.py\n"]
