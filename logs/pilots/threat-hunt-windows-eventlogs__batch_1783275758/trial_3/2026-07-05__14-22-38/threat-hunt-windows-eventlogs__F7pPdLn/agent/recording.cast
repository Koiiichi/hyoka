[132.882176, "i", "cat << 'EOF' > /tmp/inspect_security.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\nc.execute(\"\"\"\n    SELECT event_id, event_code, host, timestamp, user, message \n    FROM events \n    WHERE event_code IN (4672, 4703, 4673, 5145, 5140, 4670) \n    ORDER BY timestamp ASC\n\"\"\")\nrows = c.fetchall()\nprint(f\"Total selected security events: {len(rows)}\")\nfor r in rows:\n    print(f\"{r[0]} | EC:{r[1]} | {r[2]} | {r[3]} | User:{r[4]} | {r[5].strip().replace('\\n', ' ')[:150]}\")\n\nconn.close()\nEOF\npython3 /tmp/inspect_security.py\n"]
