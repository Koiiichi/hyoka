[153.211621, "i", "cat << 'EOF' > /tmp/inspect_other_hosts.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\nprint(\"=== WS-06 EVENTS ===\")\nc.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host = 'WS-06.corp.example' GROUP BY event_code\")\nfor r in c.fetchall():\n    print(f\"WS-06 | EC:{r[0]} | Count:{r[1]}\")\n\n# Let's inspect Sysmon events on WS-06 (usually event codes < 100)\nc.execute(\"SELECT event_id, event_code, timestamp, user, image, message FROM events WHERE host = 'WS-06.corp.example' AND event_code < 100 LIMIT 20\")\nfor r in c.fetchall():\n    print(f\"WS-06 Sysmon: {r[0]} | EC:{r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5].strip().replace('\\n', ' ')[:100]}\")\n\nprint(\"\\n=== DC01 EVENTS ===\")\nc.execute(\"SELECT event_code, COUNT(*) FROM events WHERE host = 'DC01.corp.example' GROUP BY event_code\")\nfor r in c.fetchall():\n    print(f\"DC01 | EC:{r[0]} | Count:{r[1]}\")\n\n# Let's inspect Sysmon events on DC01\nc.execute(\"SELECT event_id, event_code, timestamp, user, image, message FROM events WHERE host = 'DC01.corp.example' AND event_code < 100 LIMIT 20\")\nfor r in c.fetchall():\n    print(f\"DC01 Sysmon: {r[0]} | EC:{r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5].strip().replace('\\n', ' ')[:100]}\")\n\nconn.close()\nEOF\npython3 /tmp/inspect_other_hosts.py\n"]
