[164.205705, "i", "cat << 'EOF' > /tmp/collect_intrusion_events.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\nmalicious_ids = set()\n\n# 1. All Event Code 800 on WS-05\nc.execute(\"SELECT event_id FROM events WHERE event_code = 800 AND host = 'WS-05.corp.example'\")\nfor r in c.fetchall():\n    malicious_ids.add(r[0])\n\n# 2. All Event Code 4103 on WS-05\nc.execute(\"SELECT event_id FROM events WHERE event_code = 4103 AND host = 'WS-05.corp.example'\")\nfor r in c.fetchall():\n    malicious_ids.add(r[0])\n\n# 3. All events associated with PowerShell GUID {297bc33e-65d0-5f2d-8207-000000000400}\nc.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' \n       OR message LIKE '%{297bc33e-65d0-5f2d-8207-000000000400}%'\n\"\"\")\nfor r in c.fetchall():\n    malicious_ids.add(r[0])\n\n# 4. All events associated with whoami GUID {297bc33e-660d-5f2d-8407-000000000400}\nc.execute(\"\"\"\n    SELECT event_id FROM events \n    WHERE process_guid = '{297bc33e-660d-5f2d-8407-000000000400}' \n       OR message LIKE '%{297bc33e-660d-5f2d-8407-000000000400}%'\n\"\"\")\nfor r in c.fetchall():\n    malicious_ids.add(r[0])\n\n# 5. Security event 4688 for whoami.exe: evt-00303\nmalicious_ids.add('evt-00303')\n\nprint(f\"Compiled {len(malicious_ids)} malicious event IDs\")\n\n# Let's save them to a temporary file\nwith open('/tmp/candidate_ids.json', 'w') as f:\n    json.dump(sorted(list(malicious_ids)), f, indent=2)\n\nconn.close()\nEOF\npython3 /tmp/collect_intrusion_events.py\n"]
[164.206543, "o", "cat << 'EOF' > /tmp/collect_intrusion_events.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
