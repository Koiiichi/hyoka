[83.151198, "i", "python3 -c \"\nimport sqlite3, re\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\nc.execute('SELECT message FROM events WHERE event_code = 800')\napps = set()\nhosts = set()\nfor r in c.fetchall():\n    msg = r[0]\n    # Extract Host Application and Host ID\n    app_m = re.search(r'Host Application\\s*=\\s*(.*)', msg, re.IGNORECASE)\n    id_m = re.search(r'Host ID\\s*=\\s*(.*)', msg, re.IGNORECASE)\n    app = app_m.group(1).strip() if app_m else 'None'\n    hid = id_m.group(1).strip() if id_m else 'None'\n    apps.add(app)\n    hosts.add(hid)\nprint('Unique Host Applications:')\nfor a in apps: print(a[:200])\nprint('Unique Host IDs:', hosts)\nconn.close()\n\"\n"]
