[?2004hroot@990b70e412e9:~# cat << 'EOF' > /tmp/trace_attack.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, host, timestamp, user, image, target_image, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE event_code NOT IN (800, 4103) 
[?2004l[?2004h>     ORDER BY timestamp ASC
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total non-powershell events: {len(rows)}")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     event_id, event_code, host, ts, user, image, target_image, msg = r
[?2004l[?2004h>     # Summarize message
[?2004l[?2004h>     summary = ""
[?2004l[?2004h>     if event_code == 3:
[?2004l[?2004h>         summary = f"Network Conn: {image} -> dest_ip and port in db"
[?2004l[?2004h>     elif event_code == 11:
[?2004l[?2004h>         summary = f"File Create: {image} - {msg.strip().replace('\n', ' ')[:100]}"
[?2004l[?2004h>     elif event_code == 12 or event_code == 13:
[?2004l[?2004h>         summary = f"Registry Event {event_code}: {image} - {msg.strip().replace('\n', ' ')[:100]}"
[?2004l[?2004h>     elif event_code == 10:
[?2004l[?2004h>         summary = f"Process Access: {image} accessed {target_image} - {msg.strip().replace('\n', ' ')[:100]}"
[?2004l[?2004h>     elif event_code in (17, 18):
[?2004l[?2004h>         summary = f"Pipe Event {event_code}: {image} - {msg.strip().replace('\n', ' ')[:100]}"
[?2004l[?2004h>     else:
[?2004l[?2004h>         summary = f"{msg.strip().replace('\n', ' ')[:100]}"
[?2004l[?2004h>     print(f"{event_id} | {ts} | {host} | EC:{event_code} | User:{user} | Img:{image} | {summary}")
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
[?2004l[?2004h> EOF
