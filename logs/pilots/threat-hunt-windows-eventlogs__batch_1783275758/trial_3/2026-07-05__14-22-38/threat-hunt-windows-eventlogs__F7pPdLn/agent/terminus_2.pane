[?2004l[?2004h> for r in c.fetchall():
[?2004l[?2004h>     malicious_ids.add(r[0])
[?2004l[?2004h> 
[?2004l[?2004h> # 2. All Event Code 4103 on WS-05
[?2004l[?2004h> c.execute("SELECT event_id FROM events WHERE event_code = 4103 AND host = 'WS-05.corp.example'")
[?2004l[?2004h> for r in c.fetchall():
[?2004l[?2004h>     malicious_ids.add(r[0])
[?2004l[?2004h> 
[?2004l[?2004h> # 3. All events associated with PowerShell GUID {297bc33e-65d0-5f2d-8207-000000000400}
[?2004l[?2004h> c.execute("""
[?2004l[?2004h>     SELECT event_id FROM events 
[?2004l[?2004h>     WHERE process_guid = '{297bc33e-65d0-5f2d-8207-000000000400}' 
[?2004l[?2004h>        OR message LIKE '%{297bc33e-65d0-5f2d-8207-000000000400}%'
[?2004l[?2004h> """)
[?2004l[?2004h> for r in c.fetchall():
[?2004l[?2004h>     malicious_ids.add(r[0])
[?2004l[?2004h> 
[?2004l[?2004h> # 4. All events associated with whoami GUID {297bc33e-660d-5f2d-8407-000000000400}
[?2004l[?2004h> c.execute("""
[?2004l[?2004h>     SELECT event_id FROM events 
[?2004l[?2004h>     WHERE process_guid = '{297bc33e-660d-5f2d-8407-000000000400}' 
[?2004l[?2004h>        OR message LIKE '%{297bc33e-660d-5f2d-8407-000000000400}%'
[?2004l[?2004h> """)
[?2004l[?2004h> for r in c.fetchall():
[?2004l[?2004h>     malicious_ids.add(r[0])
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Security event 4688 for whoami.exe: evt-00303
[?2004l[?2004h> malicious_ids.add('evt-00303')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Compiled {len(malicious_ids)} malicious event IDs")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's save them to a temporary file
[?2004l[?2004h> with open('/tmp/candidate_ids.json', 'w') as f:
[?2004l[?2004h>     json.dump(sorted(list(malicious_ids)), f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
