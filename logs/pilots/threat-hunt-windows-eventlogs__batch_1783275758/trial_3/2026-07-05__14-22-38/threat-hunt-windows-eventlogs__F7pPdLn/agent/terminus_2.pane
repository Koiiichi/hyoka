[?2004hroot@990b70e412e9:~# cat << 'EOF' > /tmp/parse_powershell.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Find unique command lines from event_code 800
[?2004l[?2004h> cursor.execute("SELECT event_id, timestamp, message FROM events WHERE event_code = 800")
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> commands = []
[?2004l[?2004h> for r_id, ts, msg in rows:
[?2004l[?2004h>     # extract command line
[?2004l[?2004h>     match = re.search(r'Pipeline execution details for command line:\s*(.*)', msg, re.DOTALL)
[?2004l[?2004h>     if match:
[?2004l[?2004h>         cmd = match.group(1).strip()
[?2004l[?2004h>         # truncate or clean up if needed
[?2004l[?2004h>         commands.append((r_id, ts, cmd))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(commands)} command executions in Event 800")
[?2004l[?2004h> # Let's print unique command strings that don't look like standard boring ones
[?2004l[?2004h> seen = set()
[?2004l[?2004h> for r_id, ts, cmd in commands:
[?2004l[?2004h>     short_cmd = cmd[:100]
[?2004l[?2004h>     if short_cmd not in seen:
[?2004l[?2004h>         seen.add(short_cmd)
[?2004l[?2004h>         print(f"{r_id} | {ts} | {cmd[:200]}")
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
