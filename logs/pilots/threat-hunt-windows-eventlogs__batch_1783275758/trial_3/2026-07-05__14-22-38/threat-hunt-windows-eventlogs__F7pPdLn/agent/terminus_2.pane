[?2004hroot@990b70e412e9:~# cat << 'EOF' > /tmp/parse_logons.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> c = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> c.execute("SELECT event_id, timestamp, host, message FROM events WHERE event_code = 4624")
[?2004l[?2004h> for r_id, ts, host, msg in c.fetchall():
[?2004l[?2004h>     # extract Target UserName, Target Domain, Logon Type
[?2004l[?2004h>     username = re.search(r'Account Name:\s*(\S+)', msg)
[?2004l[?2004h>     domain = re.search(r'Account Domain:\s*(\S+)', msg)
[?2004l[?2004h>     logon_type = re.search(r'Logon Type:\s*(\d+)', msg)
[?2004l[?2004h>     logon_id = re.search(r'Logon ID:\s*(\S+)', msg)
[?2004l[?2004h>     
[?2004l[?2004h>     u = username.group(1) if username else "None"
[?2004l[?2004h>     d = domain.group(1) if domain else "None"
[?2004l[?2004h>     t = logon_type.group(1) if logon_type else "None"
[?2004l[?2004h>     lid = logon_id.group(1) if logon_id else "None"
[?2004l[?2004h>     
[?2004l[?2004h>     # Wait, there are multiple matches sometimes in 4624 (Subject and New Logon)
[?2004l[?2004h>     # Let's find all Account Name matches
[?2004l[?2004h>     all_users = re.findall(r'Account Name:\s*(\S+)', msg)
[?2004l[?2004h>     all_domains = re.findall(r'Account Domain:\s*(\S+)', msg)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"{r_id} | {ts} | {host} | LogonType:{t} | Users:{all_users} | Domains:{all_domains} | LogonID:{lid}")
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
