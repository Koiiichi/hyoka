[?2004l[?2004h>       AND timestamp BETWEEN '2026-05-06T14:32:20Z' AND '2026-05-06T14:35:30Z'
[?2004l[?2004h>     ORDER BY timestamp ASC
[?2004l[?2004h> """)
[?2004l[?2004h> rows = c.fetchall()
