[91.782407, "i", "cat << 'EOF' > /tmp/analyze_ps.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, message \n    FROM events \n    WHERE event_code IN (800, 4103)\n\"\"\")\nps_events = cursor.fetchall()\nprint(f\"Total PowerShell events: {len(ps_events)}\")\n\nsessions = {}\nfor r in ps_events:\n    eid, ec, host, msg = r\n    if not msg:\n        continue\n    # extract Host ID or HostId\n    host_id_match = re.search(r'Host\\s*ID\\s*=\\s*([a-fA-F0-9-]+)', msg, re.IGNORECASE) or re.search(r'HostId=([a-fA-F0-9-]+)', msg, re.IGNORECASE)\n    host_id = host_id_match.group(1) if host_id_match else \"unknown\"\n    \n    # extract UserId or User\n    user_match = re.search(r'UserId=([^\\s\\n]+)', msg, re.IGNORECASE) or re.search(r'User\\s*=\\s*([^\\s\\n]+)', msg, re.IGNORECASE)\n    user = user_match.group(1) if user_match else \"unknown\"\n    \n    sessions.setdefault(host_id, []).append((eid, ec, host, user))\n\nprint(f\"Found {len(sessions)} unique PowerShell Host/Session IDs:\")\nfor hid, evs in sessions.items():\n    print(f\"Host ID: {hid} | Event Count: {len(evs)} | Sample Host: {evs[0][2]} | Sample User: {evs[0][3]}\")\n\nEOF\npython3 /tmp/analyze_ps.py\n"]
