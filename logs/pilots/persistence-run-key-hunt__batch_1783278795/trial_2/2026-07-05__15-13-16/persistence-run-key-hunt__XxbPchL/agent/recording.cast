[44.691979, "i", "cat << 'EOF' > /tmp/details.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nprint(\"=== ALL EVENTS ON WS-06 ===\")\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, target_user, image, parent_image, command_line, target_image, target_object, details, message, dst_ip, dst_port, process_guid \n    FROM events \n    WHERE host = 'WS-06.corp.example' \n    ORDER BY timestamp\n\"\"\")\ncolumns = [d[0] for d in cursor.description]\nfor r in cursor.fetchall():\n    d = dict(zip(columns, r))\n    print(\"-\"*40)\n    for k, v in d.items():\n        if v is not None and v != '':\n            print(f\"{k}: {v}\")\n\nprint(\"\\n=== SUSPICIOUS EVENTS ON DC01 ===\")\n# Let's pull event codes 3, 10, 11, 12, 13, 18, 4697, 5140, 5145, etc. from DC01\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, target_user, image, parent_image, command_line, target_image, target_object, details, message, dst_ip, dst_port, process_guid \n    FROM events \n    WHERE host = 'DC01.corp.example' \n      AND event_code IN (3, 5, 7, 9, 10, 11, 12, 13, 18, 5140, 5145, 4624, 4697) \n    ORDER BY timestamp\n\"\"\")\ncolumns = [d[0] for d in cursor.description]\nfor r in cursor.fetchall():\n    d = dict(zip(columns, r))\n    # Check if this event looks normal (e.g. standard machine accounts, common svchost paths, etc.)\n    # Let's just print them all, and we can filter or look through\n    print(\"-\"*40)\n    for k, v in d.items():\n        if v is not None and v != '':\n            # truncate long fields unless it's registry value\n            val = str(v)\n            if len(val) > 200 and k != 'details' and k != 'message':\n                val = val[:200] + \"...\"\n            print(f\"{k}: {val}\")\n\nEOF\npython3 /tmp/details.py > /tmp/details.out\nhead -n 200 /tmp/details.out\n"]
[44.692327, "o", "cat << 'EOF' > /tmp/details.py\r\n\u001b[?2004l\r"]
