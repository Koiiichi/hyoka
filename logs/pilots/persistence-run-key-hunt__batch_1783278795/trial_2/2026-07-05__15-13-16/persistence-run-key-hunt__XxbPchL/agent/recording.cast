[71.252008, "i", "cat << 'EOF' > /tmp/baseline_to_file.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ndef log_query(title, query):\n    print(f\"\\n{'='*20} {title} {'='*20}\")\n    cursor.execute(query)\n    rows = cursor.fetchall()\n    print(f\"Returned {len(rows)} rows.\")\n    for r in rows[:100]: # limit to 100 on screen\n        print(r)\n\n# Unique users\nlog_query(\"Users count\", \"SELECT user, COUNT(*) FROM events GROUP BY user ORDER BY 2 DESC\")\n# Unique images\nlog_query(\"Images count\", \"SELECT image, COUNT(*) FROM events GROUP BY image ORDER BY 2 DESC\")\n# Unique target_objects (Registry)\nlog_query(\"Registry Target Objects\", \"SELECT target_object, COUNT(*) FROM events WHERE target_object IS NOT NULL AND target_object != '' GROUP BY target_object ORDER BY 2 DESC\")\n# Unique process_guids\nlog_query(\"Process GUIDs\", \"SELECT process_guid, image, COUNT(*) FROM events WHERE process_guid IS NOT NULL GROUP BY process_guid, image ORDER BY 3 DESC\")\n\nEOF\npython3 /tmp/baseline_to_file.py > /tmp/baseline_res.txt\nhead -n 100 /tmp/baseline_res.txt\n"]
