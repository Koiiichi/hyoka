[12.763816, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's inspect some event_code 4103 and 800 messages to see if there is any suspicious PowerShell\ncursor.execute(\"SELECT event_id, event_code, host, message FROM events WHERE event_code IN (4103, 800) AND message IS NOT NULL AND message != ''\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} PowerShell events with messages.\")\nfor r in rows[:20]:\n    print(\"=\"*50)\n    print(f\"Event ID: {r[0]} | Code: {r[1]} | Host: {r[2]}\")\n    print(r[3][:1000])\n\nEOF\npython3 /tmp/hunt.py\n"]
