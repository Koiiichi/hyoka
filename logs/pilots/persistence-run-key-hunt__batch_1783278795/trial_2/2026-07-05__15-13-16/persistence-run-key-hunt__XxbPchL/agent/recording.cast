[66.348906, "i", "cat << 'EOF' > /tmp/baseline.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's see all unique values in some of these fields to see what is normal\nprint(\"=== Unique users ===\")\ncursor.execute(\"SELECT user, COUNT(*) FROM events GROUP BY user\")\nfor r in cursor.fetchall():\n    print(r)\n\nprint(\"=== Unique images ===\")\ncursor.execute(\"SELECT image, COUNT(*) FROM events GROUP BY image\")\nfor r in cursor.fetchall():\n    print(r)\n\nprint(\"=== Unique target images ===\")\ncursor.execute(\"SELECT target_image, COUNT(*) FROM events GROUP BY target_image\")\nfor r in cursor.fetchall():\n    print(r)\n\nprint(\"=== Unique target objects ===\")\ncursor.execute(\"SELECT target_object, COUNT(*) FROM events GROUP BY target_object\")\nfor r in cursor.fetchall():\n    print(r)\n\nprint(\"=== Pipe events (18) ===\")\ncursor.execute(\"SELECT event_id, host, user, image, details, message FROM events WHERE event_code = 18\")\nfor r in cursor.fetchall():\n    print(r)\n\nprint(\"=== Share/Logon events (4624, 5140, 5145) ===\")\ncursor.execute(\"SELECT event_id, event_code, host, user, target_user, details, message FROM events WHERE event_code IN (4624, 5140, 5145)\")\nfor r in cursor.fetchall():\n    print(f\"ID: {r[0]} | Code: {r[1]} | Host: {r[2]} | User: {r[3]} | TargetUser: {r[4]} | Details: {r[5][:200]} | Msg: {r[6][:200]}\")\n\nEOF\npython3 /tmp/baseline.py\n"]
[66.351607, "o", "cat << 'EOF' > /tmp/baseline.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's see all unique values in some of these fields to see what is normal\r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== Unique users ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT user, COUNT(*) FROM events GROUP BY user\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== Unique images ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT image, COUNT(*) FROM events GROUP BY image\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== Unique target images ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT target_image, COUNT(*) FROM events GROUP BY target_image\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== Unique target objects ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT target_object, COUNT(*) FROM events GROUP BY target_object\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== Pipe events (18) ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, host, user, image, details, message FROM events WHERE event_code = 18\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== Share/Logon events (4624, 5140, 5145) ===\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT event_id, event_code, host, user, target_user, details, message FROM events WHERE event_code IN (4624, 5140, 5145)\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"ID: {r[0]} | Code: {r[1]} | Host: {r[2]} | User: {r[3]} | TargetUser: {r[4]} | Details: {r[5][:200]} | Msg: {r[6][:200]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
