[138.718567, "i", "cat << 'EOF' > /tmp/check_benign.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Read malicious IDs\nwith open('/tmp/mal_events.txt') as f:\n    lines = f.readlines()\nmal_ids = set()\nfor line in lines:\n    if '|' in line:\n        mal_ids.add(line.split('|')[0].strip())\n\n# Query all events on WS-05\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, details, message \n    FROM events \n    WHERE host = 'WS-05.corp.example'\n\"\"\")\nrows = cursor.fetchall()\n\nprint(f\"Benign events on WS-05 (total {len(rows) - len(mal_ids)}):\")\nfor r in rows:\n    if r[0] not in mal_ids:\n        print(f\"ID: {r[0]} | Code: {r[1]} | Time: {r[2]} | Image: {r[4]} | Parent: {r[5]} | Cmd: {r[6]} | Details: {r[7][:100]}\")\n\nEOF\npython3 /tmp/check_benign.py\n"]
[138.718842, "o", "cat << 'EOF' > /tmp/check_benign.py\r\n\u001b[?2004l\r"]
