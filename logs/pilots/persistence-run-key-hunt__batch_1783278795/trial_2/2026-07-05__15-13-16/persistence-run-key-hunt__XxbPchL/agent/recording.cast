[147.512249, "i", "cat << 'EOF' > /tmp/check_counts.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Read malicious IDs\nwith open('/tmp/mal_events.txt') as f:\n    lines = f.readlines()\nmal_ids = set()\nfor line in lines:\n    if '|' in line:\n        mal_ids.add(line.split('|')[0].strip())\n\ncursor.execute(\"\"\"\n    SELECT event_code, \n           COUNT(*) as total,\n           SUM(CASE WHEN event_id IN (SELECT event_id FROM events WHERE event_id IN ({}) ) THEN 1 ELSE 0 END) as mal_count\n    FROM events \n    WHERE host = 'WS-05.corp.example'\n    GROUP BY event_code\n\"\"\".format(\", \".join(f\"'{i}'\" for i in mal_ids)))\n\nprint(\"Code | Total | Malicious | Benign\")\nfor r in cursor.fetchall():\n    print(f\"{r[0]:4} | {r[1]:5} | {r[2]:9} | {r[1]-r[2]:6}\")\n\nEOF\npython3 /tmp/check_counts.py\n"]
[147.512529, "o", "cat << 'EOF' > /tmp/check_counts.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
