[155.07825, "i", "cat << 'EOF' > /tmp/write_json.py\nimport json\n\nwith open('/tmp/mal_events.txt') as f:\n    lines = f.readlines()\n\nmal_ids = set()\nfor line in lines:\n    if '|' in line:\n        mal_ids.add(line.split('|')[0].strip())\n\nmal_list = sorted(list(mal_ids))\nprint(f\"Writing {len(mal_list)} malicious event IDs to /root/findings.json\")\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(mal_list, f)\n\nEOF\npython3 /tmp/write_json.py\n"]
