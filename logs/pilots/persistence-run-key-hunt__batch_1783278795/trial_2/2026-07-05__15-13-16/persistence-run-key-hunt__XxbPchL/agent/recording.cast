[108.904221, "o", "\u001b[?2004hroot@330dbb2b3463:~# "]
[117.776079, "i", "cat << 'EOF' > /tmp/collect_malicious.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's find all events containing {b59756a9-b239-5f17-5307-000000000400} or powershell.exe on WS-05\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, image, parent_image, command_line, message, details \n    FROM events \n    WHERE host = 'WS-05.corp.example'\n\"\"\")\n\nall_rows = cursor.fetchall()\nmalicious_ids = set()\n\n# Let's check which ones are malicious\nfor r in all_rows:\n    eid, ec, ts, img, pimg, cmd, msg, det = r\n    msg = msg or \"\"\n    det = det or \"\"\n    img = img or \"\"\n    pimg = pimg or \"\"\n    cmd = cmd or \"\"\n    \n    is_malicious = False\n    \n    # 1. Any PowerShell events (800, 4103) are malicious on this host\n    if ec in (800, 4103):\n        is_malicious = True\n    \n    # 2. Any event explicitly containing the malicious process GUID\n    if \"{b59756a9-b239-5f17-5307-000000000400}\" in str(r):\n        is_malicious = True\n        \n    # 3. Any event referencing process ID 9076 or hex 0x2374\n    if \"9076\" in msg or \"0x2374\" in msg or \"9076\" in det or \"0x2374\" in det:\n        is_malicious = True\n        \n    # 4. Any event with image as powershell.exe\n    if \"powershell.exe\" in img.lower() or \"powershell.exe\" in pimg.lower() or \"powershell.exe\" in cmd.lower():\n        is_malicious = True\n        \n    if is_malicious:\n        malicious_ids.add((eid, ec, ts))\n\nprint(f\"Found {len(malicious_ids)} malicious events.\")\nmalicious_ids = sorted(list(malicious_ids), key=lambda x: x[2])\nfor m in malicious_ids:\n    print(f\"{m[0]} | {m[1]} | {m[2]}\")\n\nEOF\npython3 /tmp/collect_malicious.py > /tmp/mal_events.txt\nhead -n 50 /tmp/mal_events.txt\n"]
[117.77641, "o", "cat << 'EOF' > /tmp/collect_malicious.py\r\n\u001b[?2004l\r"]
