[76.22749, "i", "cat << 'EOF' > /tmp/search_reg.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, host, user, image, target_object, details, message \n    FROM events \n    WHERE target_object LIKE '%Updater%' \n       OR target_object LIKE '%Debug%' \n       OR target_object LIKE '%VFUProvider%' \n       OR details LIKE '%Updater%' \n       OR details LIKE '%Debug%' \n       OR details LIKE '%VFUProvider%'\n\"\"\")\nfor r in cursor.fetchall():\n    print(\"=\"*50)\n    print(f\"ID: {r[0]} | Code: {r[1]} | Host: {r[2]} | User: {r[3]} | Image: {r[4]}\")\n    print(f\"TargetObj: {r[5]}\")\n    print(f\"Details: {r[6]}\")\n    print(f\"Message: {r[7][:200]}\")\n\nEOF\npython3 /tmp/search_reg.py\n"]
