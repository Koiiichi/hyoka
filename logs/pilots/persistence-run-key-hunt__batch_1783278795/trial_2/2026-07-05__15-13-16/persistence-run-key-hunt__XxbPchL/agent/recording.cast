[35.963254, "i", "cat << 'EOF' > /tmp/search_other.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's inspect events on DC01 and WS-06 first, filtering for non-standard events or system events\n# Wait, let's see how many events are on WS-06 and DC01\ncursor.execute(\"SELECT host, COUNT(*) FROM events GROUP BY host\")\nprint(\"Host event counts:\", cursor.fetchall())\n\nprint(\"\\n--- Events on DC01 ---\")\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, details, message \n    FROM events \n    WHERE host = 'DC01.corp.example' \n    ORDER BY timestamp\n\"\"\")\nfor r in cursor.fetchall()[:50]:\n    print(f\"ID: {r[0]} | Code: {r[1]} | Time: {r[2]} | User: {r[3]} | Image: {r[4]} | Parent: {r[5]} | Cmd: {r[6]} | Details: {r[7][:100]}\")\n\nprint(\"\\n--- Events on WS-06 ---\")\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, details, message \n    FROM events \n    WHERE host = 'WS-06.corp.example' \n    ORDER BY timestamp\n\"\"\")\nfor r in cursor.fetchall()[:50]:\n    print(f\"ID: {r[0]} | Code: {r[1]} | Time: {r[2]} | User: {r[3]} | Image: {r[4]} | Parent: {r[5]} | Cmd: {r[6]} | Details: {r[7][:100]}\")\n\nEOF\npython3 /tmp/search_other.py\n"]
[35.96359, "o", "cat << 'EOF' > /tmp/search_other.py\r\n\u001b[?2004l\r"]
[35.964996, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's inspect events on DC01 and WS-06 first, filtering for non-standard events or system events\r\n\u001b[?2004l\r\u001b[?2004h> # Wait, let's see how many events are on WS-06 and DC01\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT host, COUNT(*) FROM events GROUP BY host\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Host event counts:\", cursor.fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n--- Events on DC01 ---\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, details, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'DC01.corp.example' \r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> for r in cursor.fetchall()[:50]:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"ID: {r[0]} | Code: {r[1]} | Time: {r[2]} | User: {r[3]} | Image: {r[4]} | Parent: {r[5]} | Cmd: {r[6]} | Details: {r[7][:100]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n--- Events on WS-06 ---\")\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, details, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'WS-06.corp.example' \r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
