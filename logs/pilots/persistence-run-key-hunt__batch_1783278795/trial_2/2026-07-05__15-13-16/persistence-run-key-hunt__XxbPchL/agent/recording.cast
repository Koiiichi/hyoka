[117.778746, "o", "\u001b[?2004h>     pimg = pimg or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd or \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[117.778793, "o", "\u001b[?2004l\r\u001b[?2004h>     is_malicious = False\r\n\u001b[?2004l\r"]
[117.779332, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # 1. Any PowerShell events (800, 4103) are malicious on this host\r\n\u001b[?2004l\r\u001b[?2004h>     if ec in (800, 4103):\r\n\u001b[?2004l\r\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.779397, "o", "    # 2. Any event explicitly containing the malicious process GUID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.779578, "o", "    if \"{b59756a9-b239-5f17-5307-000000000400}\" in str(r):\r\n\u001b[?2004l\r\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.779713, "o", "> "]
[117.779872, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.779889, "o", "> "]
[117.779906, "o", "    # 3. Any event referencing process ID 9076 or hex 0x2374\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.780062, "o", "    if \"9076\" in msg or \"0x2374\" in msg or \"9076\" in det or \"0x2374\" in det:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.780493, "o", "        is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # 4. Any event with image as powershell.exe\r\n\u001b[?2004l\r\u001b[?2004h>     if \"powershell.exe\" in img.lower() or \"powershell.exe\" in pimg.lower() or \"powershell.exe\" in cmd.lower():\r\n\u001b[?2004l\r\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     if is_malicious:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add((eid, ec, ts))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(malicious_ids)} malicious events.\")\r\n\u001b[?2004l\r\u001b[?2004h> malicious_ids = sorted(list(malicious_ids), key=lambda x: x[2])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.780863, "o", "for m in malicious_ids:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{m[0]} | {m[1]} | {m[2]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
