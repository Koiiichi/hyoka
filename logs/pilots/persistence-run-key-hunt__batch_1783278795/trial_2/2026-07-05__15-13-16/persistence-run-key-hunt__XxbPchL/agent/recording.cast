[20.858161, "i", "cat << 'EOF' > /tmp/decode.py\nimport base64\nimport sqlite3\n\n# Decode the powershell payload from HostApplication or message\nenc = (\"\")\n# Let's pad it to be valid base64\npadded = enc + \"=\" * ((4 - len(enc) % 4) % 4)\ntry:\n    decoded = base64.b64decode(padded).decode('utf-16le', errors='ignore')\n    print(\"Decoded:\", decoded)\nexcept Exception as e:\n    print(e)\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Let's retrieve all unique process GUIDs, images, users involved in PowerShell execution\ncursor.execute(\"\"\"\n    SELECT DISTINCT event_id, host, user, image, parent_image, command_line, process_guid \n    FROM events \n    WHERE (image LIKE '%powershell%' OR parent_image LIKE '%powershell%' \n       OR command_line LIKE '%powershell%' OR message LIKE '%powershell%')\n\"\"\")\nprint(\"Powershell processes:\")\nfor r in cursor.fetchall():\n    print(r)\nEOF\npython3 /tmp/decode.py\n"]
