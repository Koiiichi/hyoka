[132.466452, "i", "cat << 'EOF' > /tmp/check_dc01.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Find all non-noise events on DC01\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, target_user, image, parent_image, command_line, details, message \n    FROM events \n    WHERE host = 'DC01.corp.example' \n      AND event_code NOT IN (5156, 5158) \n      AND (user IS NULL OR user NOT LIKE 'WEC$') \n      AND (target_user IS NULL OR target_user NOT LIKE 'WEC$')\n      AND (image IS NULL OR image NOT LIKE '%dns.exe%')\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} potentially interesting events on DC01:\")\nfor r in rows:\n    print(f\"ID: {r[0]} | Code: {r[1]} | Time: {r[2]} | User: {r[3]} | TargetUser: {r[4]} | Image: {r[5]} | Cmd: {r[7]}\")\n\nEOF\npython3 /tmp/check_dc01.py\n"]
