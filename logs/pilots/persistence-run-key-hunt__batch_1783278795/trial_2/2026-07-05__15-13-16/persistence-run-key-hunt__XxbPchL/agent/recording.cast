[26.035919, "i", "cat << 'EOF' > /tmp/guid_check.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Find all events associated with process_guid {b59756a9-b239-5f17-5307-000000000400}\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, channel, user, image, parent_image, command_line, dst_ip, dst_port, details, message \n    FROM events \n    WHERE process_guid = '{b59756a9-b239-5f17-5307-000000000400}'\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} events for process_guid {{b59756a9-b239-5f17-5307-000000000400}}\")\nfor r in rows:\n    # Avoid printing huge messages unless needed, show general info first\n    print(f\"ID: {r[0]} | Code: {r[1]} | Time: {r[2]} | User: {r[4]} | Image: {r[5]} | Cmd: {r[7][:100]} | Dst: {r[8]}:{r[9]} | Details: {r[10]}\")\n\nEOF\npython3 /tmp/guid_check.py\n"]
