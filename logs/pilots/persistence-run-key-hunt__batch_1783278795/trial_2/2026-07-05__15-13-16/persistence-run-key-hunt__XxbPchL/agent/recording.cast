[49.266202, "i", "cat << 'EOF' > /tmp/read_details.py\nwith open('/tmp/details.out') as f:\n    content = f.read()\n\n# Let's search for events starting from evt-00220 onwards on WS-06\nprint(\"=== WS-06 AFTER EVT-00220 ===\")\nparts = content.split(\"===\")\nws06_events = parts[1].split(\"----------------------------------------\")\nfor ev in ws06_events:\n    if \"evt-0022\" in ev or \"evt-004\" in ev or \"evt-005\" in ev or \"evt-006\" in ev:\n        print(\"-\"*40)\n        print(ev.strip())\n\nprint(\"=== SUSPICIOUS DC01 EVENTS ===\")\nif len(parts) > 2:\n    dc01_events = parts[2].split(\"----------------------------------------\")\n    print(f\"Total DC01 events: {len(dc01_events)}\")\n    for ev in dc01_events:\n        # Filter for non-standard or interesting ones\n        # Let's filter out WEC$ user or DNS (event_code 3 and C:\\Windows\\System32\\dns.exe)\n        if \"dns.exe\" in ev or \"WEC$\" in ev or \"evt-0000\" in ev or \"evt-0001\" in ev or \"evt-0003\" in ev or \"evt-0004\" in ev or \"evt-0005\" in ev or \"evt-0006\" in ev:\n            continue\n        print(\"-\"*40)\n        print(ev.strip())\nEOF\npython3 /tmp/read_details.py\n"]
