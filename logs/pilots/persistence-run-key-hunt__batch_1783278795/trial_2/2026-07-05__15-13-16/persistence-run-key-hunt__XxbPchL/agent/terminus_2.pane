[?2004l[?2004hroot@330dbb2b3463:~# cat << 'EOF' > /tmp/check_counts.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Read malicious IDs
[?2004l[?2004h> with open('/tmp/mal_events.txt') as f:
[?2004l[?2004h>     lines = f.readlines()
[?2004l[?2004h> mal_ids = set()
[?2004l[?2004h> for line in lines:
[?2004l[?2004h>     if '|' in line:
[?2004l[?2004h>         mal_ids.add(line.split('|')[0].strip())
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT event_code, 
[?2004l[?2004h>            COUNT(*) as total,
[?2004l[?2004h>            SUM(CASE WHEN event_id IN (SELECT event_id FROM events WHERE event_id IN ({}) ) THEN 1 ELSE 0 END) as mal_count
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example'
[?2004l[?2004h>     GROUP BY event_code
[?2004l[?2004h> """.format(", ".join(f"'{i}'" for i in mal_ids)))
[?2004l[?2004h> 
[?2004l[?2004h> print("Code | Total | Malicious | Benign")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(f"{r[0]:4} | {r[1]:5} | {r[2]:9} | {r[1]-r[2]:6}")
[?2004l[?2004h> 
