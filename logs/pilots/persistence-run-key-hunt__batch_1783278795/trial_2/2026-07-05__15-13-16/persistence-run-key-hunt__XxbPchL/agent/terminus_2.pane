[?2004l[?2004h>     eid, ec, ts, img, pimg, cmd, msg, det = r
[?2004l[?2004h>     msg = msg or ""
[?2004l[?2004h>     det = det or ""
[?2004l[?2004h>     img = img or ""
[?2004l[?2004h>     pimg = pimg or ""
[?2004l[?2004h>     cmd = cmd or ""
[?2004l[?2004h>     
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. Any PowerShell events (800, 4103) are malicious on this host
[?2004l[?2004h>     if ec in (800, 4103):
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     
[?2004l[?2004h>     # 2. Any event explicitly containing the malicious process GUID
[?2004l[?2004h>     if "{b59756a9-b239-5f17-5307-000000000400}" in str(r):
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Any event referencing process ID 9076 or hex 0x2374
[?2004l[?2004h>     if "9076" in msg or "0x2374" in msg or "9076" in det or "0x2374" in det:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 4. Any event with image as powershell.exe
[?2004l[?2004h>     if "powershell.exe" in img.lower() or "powershell.exe" in pimg.lower() or "powershell.exe" in cmd.lower():
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         malicious_ids.add((eid, ec, ts))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(malicious_ids)} malicious events.")
[?2004l[?2004h> malicious_ids = sorted(list(malicious_ids), key=lambda x: x[2])
[?2004l[?2004h> for m in malicious_ids:
[?2004l[?2004h>     print(f"{m[0]} | {m[1]} | {m[2]}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
