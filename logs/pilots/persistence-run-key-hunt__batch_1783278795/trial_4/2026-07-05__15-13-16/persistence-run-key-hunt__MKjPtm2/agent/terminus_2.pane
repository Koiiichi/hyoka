[?2004l[?2004h> conn = sqlite3.connect("/root/data/eventlogs.db")
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> curr = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> curr.execute("SELECT event_id, host, timestamp, message FROM events WHERE event_code = 4624")
[?2004l[?2004h> for row in curr:
[?2004l[?2004h>     msg = row['message']
[?2004l[?2004h>     # extract Account Name, Logon Type, Source Network Address
[?2004l[?2004h>     accounts = re.findall(r'Account Name:\s+(\S+)', msg)
[?2004l[?2004h>     logon_type = re.findall(r'Logon Type:\s+(\d+)', msg)
[?2004l[?2004h>     source_ip = re.findall(r'Source Network Address:\s+(\S+)', msg)
[?2004l[?2004h>     # usually there are multiple Account Names, the second one is the target user
[?2004l[?2004h>     target_user = accounts[1] if len(accounts) > 1 else (accounts[0] if accounts else "Unknown")
[?2004l[?2004h>     ltype = logon_type[0] if logon_type else "Unknown"
[?2004l[?2004h>     sip = source_ip[0] if source_ip else "Unknown"
[?2004l[?2004h>     print(f"ID: {row['event_id']} | Host: {row['host']} | Time: {row['timestamp']} | Target User: {target_user} | Logon Type: {ltype} | Src IP: {sip}")
[?2004l[?2004h> EOF
