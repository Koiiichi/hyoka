[?2004l[?2004h> curr = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> curr.execute("SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158)")
[?2004l[?2004h> rows = curr.fetchall()
[?2004l[?2004h> print(f"Total WFP events on WS-05: {len(rows)}")
[?2004l[?2004h> 
[?2004l[?2004h> malicious = []
[?2004l[?2004h> benign = []
[?2004l[?2004h> for row in rows:
[?2004l[?2004h>     msg = row['message'] or ""
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     if "powershell.exe" in msg.lower():
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     elif "9076" in msg:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>     elif "10.10.10.5" in msg:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         malicious.append((row['event_id'], row['event_code'], "powershell"))
[?2004l[?2004h>     else:
[?2004l[?2004h>         benign.append((row['event_id'], row['event_code'], msg))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Malicious WFP count: {len(malicious)}")
[?2004l[?2004h> print(f"Benign WFP count: {len(benign)}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nSample benign messages:")
[?2004l[?2004h> for ev_id, code, msg in benign[:10]:
[?2004l[?2004h>     # extract application name and dst_ip from message if possible
[?2004l[?2004h>     import re
[?2004l[?2004h>     app = re.findall(r'Application Name:\s+(\S+)', msg)
[?2004l[?2004h>     dst = re.findall(r'Destination Address:\s+(\S+)', msg)
[?2004l[?2004h>     dst_port = re.findall(r'Destination Port:\s+(\S+)', msg)
[?2004l[?2004h>     app_str = app[0] if app else "Unknown"
[?2004l[?2004h>     dst_str = f"{dst[0]}:{dst_port[0]}" if dst and dst_port else "None"
[?2004l[?2004h>     print(f"{ev_id} | Code: {code} | App: {app_str} | Dst: {dst_str}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nAll malicious WFP Event IDs:")
