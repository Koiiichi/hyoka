[110.423411, "i", "cat << 'EOF' > /tmp/ws05_registry.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, image, target_object, details, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND event_code IN (12, 13)\n    ORDER BY timestamp ASC\n\"\"\")\nfor row in curr:\n    msg = row['message'] or \"\"\n    det = row['details'] or \"\"\n    print(f\"ID: {row['event_id']} | Code: {row['event_code']} | Time: {row['timestamp']}\")\n    print(f\"  Image: {row['image']}\")\n    print(f\"  Target: {row['target_object']}\")\n    print(f\"  Details/Msg: {det or msg[:300].replace('\\r', '').replace('\\n', ' ')}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/ws05_registry.py\n"]
