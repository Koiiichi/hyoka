[166.604245, "i", "cat << 'EOF' > /tmp/check_ps_session.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT COUNT(*) FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103)\")\ntotal = curr.fetchone()[0]\n\ncurr.execute(\"SELECT COUNT(*) FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103) AND message LIKE '%ca33ee8b-7d2f-4343-83bb-33cd9ad23223%'\")\nmatching = curr.fetchone()[0]\n\nprint(f\"Total PowerShell events: {total}\")\nprint(f\"PowerShell events with matching HostId: {matching}\")\nEOF\npython3 /tmp/check_ps_session.py\n"]
