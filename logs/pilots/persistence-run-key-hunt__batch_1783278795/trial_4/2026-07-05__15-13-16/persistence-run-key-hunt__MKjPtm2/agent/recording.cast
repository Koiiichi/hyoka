[57.269793, "i", "cat << 'EOF' > /tmp/ws06.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT event_id, event_code, timestamp, user, image, target_image, details, message FROM events WHERE host = 'WS-06.corp.example' ORDER BY timestamp ASC\")\nfor row in curr:\n    msg = row['message'] or \"\"\n    print(f\"ID: {row['event_id']} | Code: {row['event_code']} | Time: {row['timestamp']} | User: {row['user']}\")\n    if row['image']: print(f\"  Image: {row['image']}\")\n    if row['target_image']: print(f\"  Target Image: {row['target_image']}\")\n    if row['details']: print(f\"  Details: {row['details']}\")\n    print(f\"  Msg: {msg[:300].replace('\\r', '').replace('\\n', ' ')}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/ws06.py\n"]
