[238.524317, "o", "        # Event code 12, 13 (Sysmon Registry) - check if powershell process_guid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.525373, "o", "        if code in (12, 13) and \"{b59756a9-b239-5f17-5307-000000000400}\" in msg:\r\n\u001b[?2004l\r\u001b[?2004h>             malicious.add(ev_id)\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>         # Event code 5156, 5158 (WFP) - check if powershell\r\n\u001b[?2004l\r\u001b[?2004h>         if code in (5156, 5158) and (\"powershell.exe\" in msg.lower() or \"9076\" in msg or \"10.10.10.5\" in msg):\r\n\u001b[?2004l\r\u001b[?2004h>             malicious.add(ev_id)\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>         # Event code 4656, 4658, 4661, 4663, 4690, 4703 (Audit) - check if powershell\r\n\u001b[?2004l\r\u001b[?2004h>         if code in (4656, 4658, 4661, 4663, 4690, 4703) and (\"powershell.exe\" in msg.lower() or \"0x2374\" in msg.lower()):\r\n\u001b[?2004l\r\u001b[?2004h>             malicious.add(ev_id)\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> malicious_list = sorted(list(malicious))\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(malicious_list)} malicious events.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open(\"/root/findings.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(malicious_list, f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Written findings successfully.\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
