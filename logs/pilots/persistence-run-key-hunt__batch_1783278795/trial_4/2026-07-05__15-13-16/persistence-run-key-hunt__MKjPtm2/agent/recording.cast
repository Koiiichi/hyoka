[143.257904, "o", "\r\nDestination IPs mapped to hosts:\r\nHost: DC01.corp.example -> IP: 172.18.38.6\r\nHost: DC01.corp.example -> IP: 172.18.38.5\r\nHost: WS-05.corp.example -> IP: 10.10.10.5\r\nHost: DC01.corp.example -> IP: 0:0:0:0:0:0:0:1\r\nHost: WS-05.corp.example -> IP: 172.18.38.6\r\nHost: WS-06.corp.example -> IP: 172.18.38.6\r\n"]
