[44.081996, "i", "cat << 'EOF' > /tmp/non_network.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"\n    SELECT event_id, event_code, host, user, image, target_image, command_line, target_object, details, message, granted_access\n    FROM events \n    WHERE event_code IN (5, 7, 9, 10, 11, 12, 13, 18, 4656, 4658, 4661, 4663, 4690, 4703, 5140, 5145)\n    ORDER BY timestamp ASC\n\"\"\")\nrows = curr.fetchall()\nprint(f\"Found {len(rows)} matching events.\")\nfor row in rows:\n    code = row['event_code']\n    print(f\"ID: {row['event_id']} | Code: {code} | Host: {row['host']} | User: {row['user']}\")\n    if row['image']: print(f\"  Image: {row['image']}\")\n    if row['target_image']: print(f\"  Target Image: {row['target_image']}\")\n    if row['target_object']: print(f\"  Target Object: {row['target_object']}\")\n    msg = row['message'] or \"\"\n    det = row['details'] or \"\"\n    if code in (12, 13):\n        print(f\"  Reg Event Details: {det or msg[:300].replace('\\r', '').replace('\\n', ' ')}\")\n    elif code == 10:\n        print(f\"  Target: {row['target_image']} | Access: {row['granted_access']} | CallTrace: {msg[:300].replace('\\r', '').replace('\\n', ' ')}\")\n    elif code == 11:\n        print(f\"  File Create: {msg[:300].replace('\\r', '').replace('\\n', ' ')}\")\n    elif code == 18:\n        print(f\"  Pipe Name: {msg[:300].replace('\\r', '').replace('\\n', ' ')}\")\n    elif code in (5140, 5145):\n        print(f\"  Share: {msg[:300].replace('\\r', '').replace('\\n', ' ')}\")\n    elif code in (9, 4661, 4663):\n        print(f\"  Access: {msg[:300].replace('\\r', '').replace('\\n', ' ')}\")\n    else:\n        print(f\"  Msg: {msg[:150].replace('\\r', '').replace('\\n', ' ')}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/non_network.py > /tmp/non_network.txt\nwc -l /tmp/non_network.txt\ncat /tmp/non_network.txt | grep -v \"WEC\\$\" | head -n 120\n"]
