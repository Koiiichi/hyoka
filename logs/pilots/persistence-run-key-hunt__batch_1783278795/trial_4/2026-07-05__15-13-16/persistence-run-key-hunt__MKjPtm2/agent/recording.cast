16|4658|pgustavo||||The handle to an object was closed.\r\r\n\r\r\nSubject :\r\r\n\tSecurity ID:\t\tS-1-5-21-2253742117-2054739524-205962475-1104\r\r\n\tAccount Name:\t\tpgustavo\r\r\n\tAccount Domain:\t\tCORP\r\r\n\tLogon ID:\t\t0x24579A8\r\r\n\r\r\nObject:\r\r\n\tObject Server:\t\tSecurity\r\r\n\tHandle ID:\t\t0x2318\r\r\n\r\r\nProcess Information:\r\r\n\tProcess ID:\t\t0x2374\r\r\n\tProcess Name:\t\tC:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\r\nevt-00417|4658|pgustavo||||The handle to an object was closed.\r\r\n\r\r\nSubject :\r\r\n\tSecurity ID:\t\tS-1-5-21-2253742117-2054739524-205962475-1104\r\r\n\tAccount Name:\t\tpgustavo\r\r\n\tAccount Domain:\t\tCORP\r\r\n\tLogon ID:\t\t0x24579A8\r\r\n\r\r\nObject:\r\r\n\tObject Server:\t\tSecurity\r\r\n\tHandle ID:\t\t0x1184\r\r\n\r\r\nProcess Information:\r\r\n\tProcess ID:\t\t0x2374\r\r\n\tProcess Name:\t\tC:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\r\n\u001b[?2004hroot@d9cad5995bec:~# "]
[219.537701, "i", "cat << 'EOF' > /tmp/classify_audit.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4656, 4658, 4661, 4663, 4690, 4703)\")\nrows = curr.fetchall()\nprint(f\"Total audit events on WS-05: {len(rows)}\")\n\nmalicious = []\nbenign = []\nfor row in rows:\n    msg = row['message'] or \"\"\n    is_malicious = False\n    if \"powershell.exe\" in msg.lower() or \"0x2374\" in msg.lower():\n        is_malicious = True\n    \n    if is_malicious:\n        malicious.append((row['event_id'], row['event_code']))\n    else:\n        benign.append((row['event_id'], row['event_code'], msg[:300].replace('\\n', ' ')))\n\nprint(f\"Malicious audit count: {len(malicious)}\")\nprint(f\"Benign audit count: {len(benign)}\")\nprint(\"\\nBenign audit events:\")\nfor ev_id, code, msg in benign[:10]:\n    print(f\"{ev_id} | Code: {code} | {msg[:100]}\")\n\nprint(\"\\nAll malicious audit Event IDs:\")\nprint([x[0] for x in malicious])\nEOF\npython3 /tmp/classify_audit.py\n"]
