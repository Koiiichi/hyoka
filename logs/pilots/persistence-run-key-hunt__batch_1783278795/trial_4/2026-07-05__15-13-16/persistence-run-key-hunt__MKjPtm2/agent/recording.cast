[83.821591, "i", "cat << 'EOF' > /tmp/reconstruct_ps.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103) ORDER BY timestamp ASC\")\nrows = curr.fetchall()\nprint(f\"Total PowerShell events: {len(rows)}\")\n\n# Let's write them to a file for review\nwith open(\"/tmp/ps_timeline.txt\", \"w\") as f:\n    for row in rows:\n        f.write(f\"=== ID: {row['event_id']} | Code: {row['event_code']} | Time: {row['timestamp']} ===\\n\")\n        f.write(row['message'])\n        f.write(\"\\n\" + \"-\"*80 + \"\\n\\n\")\nEOF\npython3 /tmp/reconstruct_ps.py\nhead -n 200 /tmp/ps_timeline.txt\n"]
