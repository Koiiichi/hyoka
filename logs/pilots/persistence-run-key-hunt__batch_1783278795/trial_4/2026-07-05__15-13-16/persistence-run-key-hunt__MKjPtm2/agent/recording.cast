[136.728316, "i", "cat << 'EOF' > /tmp/network_conns2.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"\n    SELECT event_id, event_code, host, timestamp, user, image, src_ip, dst_ip, dst_port, message\n    FROM events \n    WHERE event_code IN (3, 5156, 5158) \n      AND (src_ip IN ('10.10.10.5', '172.18.39.5', '172.18.39.6') \n           OR dst_ip IN ('10.10.10.5', '172.18.39.5', '172.18.39.6'))\n    ORDER BY timestamp ASC\n\"\"\")\nrows = curr.fetchall()\nprint(f\"Found {len(rows)} matching connections.\")\nfor row in rows:\n    print(f\"ID: {row['event_id']} | Code: {row['event_code']} | Host: {row['host']} | Time: {row['timestamp']}\")\n    print(f\"  Src: {row['src_ip']} -> Dst: {row['dst_ip']}:{row['dst_port']} | Process: {row['image']}\")\n    msg = row['message'] or \"\"\n    print(f\"  Msg: {msg[:300].replace('\\r', '').replace('\\n', ' ')}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/network_conns2.py\n"]
