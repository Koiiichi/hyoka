[105.209781, "i", "cat << 'EOF' > /tmp/ws05_non_network.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, target_image, details, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code NOT IN (800, 4103, 5156, 5158)\n    ORDER BY timestamp ASC\n\"\"\")\nrows = curr.fetchall()\nprint(f\"Found {len(rows)} non-network events on WS-05.\")\nfor row in rows:\n    msg = row['message'] or \"\"\n    det = row['details'] or \"\"\n    print(f\"ID: {row['event_id']} | Code: {row['event_code']} | Time: {row['timestamp']} | User: {row['user']}\")\n    if row['image']: print(f\"  Image: {row['image']}\")\n    if row['target_image']: print(f\"  Target Image: {row['target_image']}\")\n    if det: print(f\"  Details: {det[:300]}\")\n    print(f\"  Msg: {msg[:300].replace('\\r', '').replace('\\n', ' ')}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/ws05_non_network.py > /tmp/ws05_non_network.txt\nwc -l /tmp/ws05_non_network.txt\ncat /tmp/ws05_non_network.txt | head -n 120\n"]
