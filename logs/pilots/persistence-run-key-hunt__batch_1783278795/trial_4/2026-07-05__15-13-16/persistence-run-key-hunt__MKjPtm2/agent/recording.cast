[143.246592, "i", "cat << 'EOF' > /tmp/map_ips.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\n# Let's search in Sysmon Event ID 3 or WFP events\ncurr.execute(\"\"\"\n    SELECT DISTINCT host, src_ip FROM events WHERE src_ip IS NOT NULL AND src_ip != '' AND src_ip NOT IN ('::1', '127.0.0.1')\n\"\"\")\nprint(\"Source IPs mapped to hosts:\")\nfor row in curr:\n    print(f\"Host: {row['host']} -> IP: {row['src_ip']}\")\n\ncurr.execute(\"\"\"\n    SELECT DISTINCT host, dst_ip FROM events WHERE dst_ip IS NOT NULL AND dst_ip != '' AND dst_ip NOT IN ('::1', '127.0.0.1')\n\"\"\")\nprint(\"\\nDestination IPs mapped to hosts:\")\nfor row in curr:\n    print(f\"Host: {row['host']} -> IP: {row['dst_ip']}\")\nEOF\npython3 /tmp/map_ips.py\n"]
[143.248382, "o", "cat << 'EOF' > /tmp/map_ips.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect(\"/root/data/eventlogs.db\")\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> curr = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's search in Sysmon Event ID 3 or WFP events\r\n\u001b[?2004l\r\u001b[?2004h> curr.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT DISTINCT host, src_ip FROM events WHERE src_ip IS NOT NULL AND src_ip != '' AND src_ip NOT IN ('::1', '127.0.0.1')\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Source IPs mapped to hosts:\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in curr:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Host: {row['host']} -> IP: {row['src_ip']}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> curr.execute(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT DISTINCT host, dst_ip FROM events WHERE dst_ip IS NOT NULL AND dst_ip != '' AND dst_ip NOT IN ('::1', '127.0.0.1')\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nDestination IPs mapped to hosts:\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in curr:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.248843, "o", "    print(f\"Host: {row['host']} -> IP: {row['dst_ip']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.248901, "o", "EOF\r\n\u001b[?2004l\r"]
[143.25023, "o", "\u001b[?2004hroot@d9cad5995bec:~# python3 /tmp/map_ips.py\r\n\u001b[?2004l\r"]
[143.257264, "o", "Source IPs mapped to hosts:\r\nHost: DC01.corp.example -> IP: 172.18.38.5\r\nHost: DC01.corp.example -> IP: 172.18.38.6\r\n"]
[143.257304, "o", "Host: WS-05.corp.example -> IP: 172.18.39.5\r\n"]
