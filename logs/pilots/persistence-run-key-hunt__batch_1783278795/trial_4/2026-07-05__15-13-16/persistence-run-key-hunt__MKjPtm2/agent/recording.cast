[20.506195, "i", "cat << 'EOF' > /tmp/inspect.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\nprint(\"=== Event Codes ===\")\ncurr.execute(\"SELECT event_code, COUNT(*) FROM events GROUP BY event_code ORDER BY 2 DESC\")\nfor row in curr:\n    print(f\"{row[0]}: {row[1]}\")\n\nprint(\"\\n=== Commands executed / Command Lines ===\")\ncurr.execute(\"SELECT event_id, event_code, host, user, image, command_line FROM events WHERE command_line IS NOT NULL AND command_line != ''\")\nfor row in curr:\n    print(dict(row))\n\nprint(\"\\n=== Details containing suspicious terms ===\")\ncurr.execute(\"SELECT event_id, event_code, host, user, image, command_line, details, message FROM events WHERE details LIKE '%mimikatz%' OR details LIKE '%lsass%' OR message LIKE '%mimikatz%' OR message LIKE '%lsass%'\")\for row in curr:\n    print(dict(row))\n\nEOF\npython3 /tmp/inspect.py | head -n 100\n"]
