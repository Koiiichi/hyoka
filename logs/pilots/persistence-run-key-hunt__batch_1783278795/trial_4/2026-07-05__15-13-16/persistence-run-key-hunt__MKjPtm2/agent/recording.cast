[28.520286, "i", "cat << 'EOF' > /tmp/ps_inspect.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT event_id, event_code, host, message FROM events WHERE event_code IN (800, 4103) LIMIT 30\")\nfor row in curr:\n    print(f\"ID: {row['event_id']}, Code: {row['event_code']}, Host: {row['host']}\")\n    # print first 200 chars of message\n    print(row['message'][:300].replace('\\r', '').replace('\\n', ' ')) \n    print(\"-\"*40)\nEOF\npython3 /tmp/ps_inspect.py\n"]
