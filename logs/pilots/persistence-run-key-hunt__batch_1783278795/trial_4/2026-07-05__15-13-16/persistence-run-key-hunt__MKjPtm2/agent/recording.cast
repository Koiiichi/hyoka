[152.569531, "i", "cat << 'EOF' > /tmp/correlate_ps.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\nguid = \"{b59756a9-b239-5f17-5307-000000000400}\"\ncurr.execute(\"\"\"\n    SELECT event_id, event_code, host, timestamp, user, image, message, details \n    FROM events \n    WHERE process_guid = ? \n       OR message LIKE ? \n       OR details LIKE ?\n    ORDER BY timestamp ASC\n\"\"\", (guid, f'%{guid}%', f'%{guid}%'))\n\nrows = curr.fetchall()\nprint(f\"Found {len(rows)} events associated with malicious PowerShell GUID {guid}.\")\nfor row in rows:\n    print(f\"{row['event_id']} | Code: {row['event_code']} | Host: {row['host']} | Time: {row['timestamp']}\")\n    # show some summary\n    msg = row['message'] or \"\"\n    det = row['details'] or \"\"\n    # print first 150 chars of msg/det\n    summary = (det or msg).replace('\\r', '').replace('\\n', ' ')[:150]\n    print(f\"  {summary}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/correlate_ps.py > /tmp/malicious_ps_events.txt\nwc -l /tmp/malicious_ps_events.txt\nhead -n 100 /tmp/malicious_ps_events.txt\n"]
