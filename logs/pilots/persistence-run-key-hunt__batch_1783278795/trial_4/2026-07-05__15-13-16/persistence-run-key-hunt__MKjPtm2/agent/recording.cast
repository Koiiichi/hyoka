[238.522205, "i", "cat << 'EOF' > /tmp/generate_findings.py\nimport sqlite3, json\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT event_id, event_code, host, message FROM events\")\nrows = curr.fetchall()\n\nmalicious = set()\n\nfor row in rows:\n    ev_id = row['event_id']\n    code = row['event_code']\n    host = row['host']\n    msg = row['message'] or \"\"\n    \n    # WS-05 malicious PowerShell\n    if host == 'WS-05.corp.example':\n        # Event code 800 / 4103\n        if code in (800, 4103):\n            malicious.add(ev_id)\n            continue\n        \n        # Event code 3 (Sysmon Network) - check if C2\n        if code == 3 and \"10.10.10.5\" in msg:\n            malicious.add(ev_id)\n            continue\n            \n        # Event code 12, 13 (Sysmon Registry) - check if powershell process_guid\n        if code in (12, 13) and \"{b59756a9-b239-5f17-5307-000000000400}\" in msg:\n            malicious.add(ev_id)\n            continue\n            \n        # Event code 5156, 5158 (WFP) - check if powershell\n        if code in (5156, 5158) and (\"powershell.exe\" in msg.lower() or \"9076\" in msg or \"10.10.10.5\" in msg):\n            malicious.add(ev_id)\n            continue\n            \n        # Event code 4656, 4658, 4661, 4663, 4690, 4703 (Audit) - check if powershell\n        if code in (4656, 4658, 4661, 4663, 4690, 4703) and (\"powershell.exe\" in msg.lower() or \"0x2374\" in msg.lower()):\n            malicious.add(ev_id)\n            continue\n\nmalicious_list = sorted(list(malicious))\nprint(f\"Found {len(malicious_list)} malicious events.\")\n\nwith open(\"/root/findings.json\", \"w\") as f:\n    json.dump(malicious_list, f)\n\nprint(\"Written findings successfully.\")\nEOF\npython3 /tmp/generate_findings.py\n"]
