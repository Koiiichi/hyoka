[68.03352, "i", "cat << 'EOF' > /tmp/proc_access.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute(\"SELECT event_id, host, timestamp, user, image, target_image, message, granted_access FROM events WHERE event_code = 10 ORDER BY timestamp ASC\")\nfor row in curr:\n    msg = row['message'] or \"\"\n    print(f\"ID: {row['event_id']} | Host: {row['host']} | Time: {row['timestamp']}\")\n    print(f\"  Source: {row['image']} ({row['user']}) -> Target: {row['target_image']}\")\n    print(f\"  Access: {row['granted_access']}\")\n    # extract CallTrace from message if present\n    import re\n    trace = re.findall(r'CallTrace:\\s*(\\S+)', msg)\n    if trace: print(f\"  CallTrace: {trace[0][:300]}\")\n    else:\n        # print first few lines of msg\n        print(f\"  Msg: {msg[:150].replace('\\r', '').replace('\\n', ' ')}\")\n    print(\"-\"*80)\nEOF\npython3 /tmp/proc_access.py\n"]
[68.03388, "o", "cat << 'EOF' > /tmp/proc_access.py\r\n\u001b[?2004l\r"]
