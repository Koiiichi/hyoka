Sending keys: ['cat << \'EOF\' > /tmp/unclassified.py\nimport sqlite3\nconn = sqlite3.connect("/root/data/eventlogs.db")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute("SELECT event_id, event_code, host, timestamp, user, image, target_image, message FROM events")\nrows = curr.fetchall()\nprint(f"Total events in database: {len(rows)}")\n\nmalicious = set()\n\n# 1. PowerShell events on WS-05\n# 135 events of code 800 or 4103\n\n# 2. Sysmon events on WS-05 with process_guid \'{b59756a9-b239-5f17-5307-000000000400}\' or involving PID 9076\n# 3. Security WFP events on WS-05 involving powershell.exe / PID 9076 / C2 10.10.10.5\n# 4. Security Audit/Object Access events on WS-05 involving powershell.exe / PID 0x2374\n\nfor row in rows:\n    ev_id = row[\'event_id\']\n    code = row[\'event_code\']\n    host = row[\'host\']\n    msg = row[\'message\'] or ""\n    \n    # WS-05 malicious PowerShell\n    if host == \'WS-05.corp.example\':\n        # Event code 800 / 4103\n        if code in (800, 4103):\n            malicious.add(ev_id)\n            continue\n        \n        # Event code 3 (Sysmon Network) - check if C2\n        if code == 3 and "10.10.10.5" in msg:\n            malicious.add(ev_id)\n            continue\n            \n        # Event code 12, 13 (Sysmon Registry) - check if powershell process_guid\n        if code in (12, 13) and "{b59756a9-b239-5f17-5307-000000000400}" in msg:\n            malicious.add(ev_id)\n            continue\n            \n        # Event code 5156, 5158 (WFP) - check if powershell\n        if code in (5156, 5158) and ("powershell.exe" in msg.lower() or "9076" in msg or "10.10.10.5" in msg):\n            malicious.add(ev_id)\n            continue\n            \n        # Event code 4656, 4658, 4661, 4663, 4690, 4703 (Audit) - check if powershell\n        if code in (4656, 4658, 4661, 4663, 4690, 4703) and ("powershell.exe" in msg.lower() or "0x2374" in msg.lower()):\n            malicious.add(ev_id)\n            continue\n\nprint(f"Malicious events identified: {len(malicious)}")\n\n# Let\'s see what is remaining\nremaining = []\nfor row in rows:\n    if row[\'event_id\'] not in malicious:\n        remaining.append(row)\n\nprint(f"Remaining events: {len(remaining)}")\n# group remaining by host and event_code\nby_host_code = {}\nfor row in remaining:\n    key = (row[\'host\'], row[\'event_code\'])\n    by_host_code[key] = by_host_code.get(key, 0) + 1\n\nprint("\\nRemaining events grouped by host and code:")\nfor k, v in sorted(by_host_code.items()):\n    print(f"Host: {k[0]} | Code: {k[1]} | Count: {v}")\n\n# print sample messages of remaining events from WS-05\nprint("\\nSample remaining WS-05 events:")\ncount = 0\nfor row in remaining:\n    if row[\'host\'] == \'WS-05.corp.example\' and count < 10:\n        print(f"{row[\'event_id\']} | Code: {row[\'event_code\']} | Msg: {(row[\'message\'] or \'\')[:150].replace(\'\\n\', \' \')}")\n        count += 1\n\nEOF\npython3 /tmp/unclassified.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
