Sending keys: ['cat << \'EOF\' > /tmp/classify_wfp.py\nimport sqlite3\nconn = sqlite3.connect("/root/data/eventlogs.db")\nconn.row_factory = sqlite3.Row\ncurr = conn.cursor()\n\ncurr.execute("SELECT event_id, event_code, message FROM events WHERE host = \'WS-05.corp.example\' AND event_code IN (5156, 5158)")\nrows = curr.fetchall()\nprint(f"Total WFP events on WS-05: {len(rows)}")\n\nmalicious = []\nbenign = []\nfor row in rows:\n    msg = row[\'message\'] or ""\n    is_malicious = False\n    if "powershell.exe" in msg.lower():\n        is_malicious = True\n    elif "9076" in msg:\n        is_malicious = True\n    elif "10.10.10.5" in msg:\n        is_malicious = True\n        \n    if is_malicious:\n        malicious.append((row[\'event_id\'], row[\'event_code\'], "powershell"))\n    else:\n        benign.append((row[\'event_id\'], row[\'event_code\'], msg))\n\nprint(f"Malicious WFP count: {len(malicious)}")\nprint(f"Benign WFP count: {len(benign)}")\n\nprint("\\nSample benign messages:")\nfor ev_id, code, msg in benign[:10]:\n    # extract application name and dst_ip from message if possible\n    import re\n    app = re.findall(r\'Application Name:\\s+(\\S+)\', msg)\n    dst = re.findall(r\'Destination Address:\\s+(\\S+)\', msg)\n    dst_port = re.findall(r\'Destination Port:\\s+(\\S+)\', msg)\n    app_str = app[0] if app else "Unknown"\n    dst_str = f"{dst[0]}:{dst_port[0]}" if dst and dst_port else "None"\n    print(f"{ev_id} | Code: {code} | App: {app_str} | Dst: {dst_str}")\n\nprint("\\nAll malicious WFP Event IDs:")\nprint([x[0] for x in malicious])\nEOF\npython3 /tmp/classify_wfp.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
