Sending keys: ['cat << \'EOF\' > /tmp/mal_check.py\nimport sqlite3\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute("SELECT * FROM events ORDER BY timestamp")\nall_events = [dict(r) for r in cur.fetchall()]\n\nmal_ids = set()\n\nfor ev in all_events:\n    eid = ev[\'event_id\']\n    code = ev[\'event_code\']\n    host = ev[\'host\']\n    user = ev[\'user\'] or \'\'\n    guid = ev[\'process_guid\'] or \'\'\n    image = ev[\'image\'] or \'\'\n    msg = ev[\'message\'] or \'\'\n    details = ev[\'details\'] or \'\'\n    tgt = ev[\'target_object\'] or \'\'\n    \n    # Check malicious criteria on WS-05\n    if host == \'WS-05.corp.example\':\n        # 1. Malicious process_guid\n        if guid == \'{b59756a9-b239-5f17-5307-000000000400}\':\n            mal_ids.add(eid)\n            continue\n            \n        # 2. PowerShell logging\n        if code in (800, 4103):\n            mal_ids.add(eid)\n            continue\n            \n        # 3. Registry object access by pgustavo\n        if code in (4656, 4658, 4663, 4690) and user == \'pgustavo\':\n            mal_ids.add(eid)\n            continue\n            \n        # 4. WFP connection/bind associated with PID 9076 or powershell.exe\n        if code in (5156, 5158):\n            is_mal_wfp = False\n            if \'9076\' in msg or \'9076\' in details:\n                is_mal_wfp = True\n            if \'powershell.exe\' in msg.lower() or \'powershell.exe\' in details.lower():\n                is_mal_wfp = True\n            if is_mal_wfp:\n                mal_ids.add(eid)\n                continue\n\n# Let\'s see how many events are flagged\nprint(f"Flagged {len(mal_ids)} malicious events out of {len(all_events)}")\n# What are the unflagged events on WS-05?\nunflagged_ws05 = []\nfor ev in all_events:\n    if ev[\'host\'] == \'WS-05.corp.example\' and ev[\'event_id\'] not in mal_ids:\n        unflagged_ws05.append(ev)\n\nprint(f"Unflagged events on WS-05: {len(unflagged_ws05)}")\nfor ev in unflagged_ws05[:20]:\n    print(f"{ev[\'event_id\']} | Code {ev[\'event_code\']} | Image {ev[\'image\']} | User {ev[\'user\']} | Msg {ev[\'message\'][:100].replace(\'\\n\', \' \')}")\nEOF\npython3 /tmp/mal_check.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
