Sending keys: ['cat << \'EOF\' > /tmp/ws05_check_remaining.py\nimport sqlite3\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let\'s pull all WS-05 events\ncur.execute("SELECT * FROM events WHERE host = \'WS-05.corp.example\' ORDER BY timestamp")\nws05_events = [dict(r) for r in cur.fetchall()]\n\nmalicious_ids = []\nbenign_ids = []\n\nfor ev in ws05_events:\n    eid = ev[\'event_id\']\n    code = ev[\'event_code\']\n    img = ev[\'image\'] or \'\'\n    user = ev[\'user\'] or \'\'\n    tgt = ev[\'target_object\'] or \'\'\n    details = ev[\'details\'] or \'\'\n    cmd = ev[\'command_line\'] or \'\'\n    msg = ev[\'message\'] or \'\'\n    \n    is_malicious = False\n    reason = ""\n    \n    # 1. Any PowerShell script block or module log on WS-05 is malicious (part of C2/agent execution)\n    if code in (800, 4103):\n        is_malicious = True\n        reason = "PowerShell C2 script execution"\n        \n    # 2. Any process_guid matching the malicious powershell\n    elif ev[\'process_guid\'] == \'{b59756a9-b239-5f17-5307-000000000400}\':\n        is_malicious = True\n        reason = "Malicious powershell process_guid"\n        \n    # 3. Object access on Run key by user pgustavo\n    elif code in (4656, 4658, 4663, 4690) and \'Run\' in (tgt or msg or \'\'):\n        is_malicious = True\n        reason = "Persistence registry access"\n        \n    # 4. WFP connection allowed to C2 (10.10.10.5)\n    elif code in (5156, 5158) and \'10.10.10.5\' in msg:\n        is_malicious = True\n        reason = "WFP C2 connection"\n        \n    if is_malicious:\n        malicious_ids.append((eid, code, img or \'powershell\', reason))\n    else:\n        benign_ids.append((eid, code, img, user, tgt[:50], msg[:100].replace(\'\\n\', \' \')))\n\nprint(f"Malicious: {len(malicious_ids)}")\nprint(f"Benign: {len(benign_ids)}")\n\nprint("\\n--- BENIGN EVENTS ON WS-05 ---")\nfor bid in benign_ids:\n    print(f"{bid[0]} | Code {bid[1]} | Image {bid[2]} | User {bid[3]} | Target {bid[4]} | Msg {bid[5][:80]}")\nEOF\npython3 /tmp/ws05_check_remaining.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
