[175.721255, "i", "cat << 'EOF' > /tmp/ws05_benign_inspect_2.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\nrows = [dict(r) for r in cur.fetchall()]\n\nfrom ws05_benign_inspect import is_mal_event\n\nfor r in rows:\n    mal, _ = is_mal_event(r)\n    if not mal:\n        # Print full details\n        print(f\"=== EVENT {r['event_id']} | Code {r['event_code']} | Image {r['image']} | Timestamp {r['timestamp']} ===\")\n        msg = r['message'] or ''\n        for line in msg.split('\\n'):\n            # Print only relevant lines to keep output readable\n            if any(k in line for k in ('Address:', 'Port:', 'Application Name:', 'TargetObject:', 'Details:', 'Process ID:', 'Image:')):\n                print(\"  \" + line.strip())\nEOF\npython3 /tmp/ws05_benign_inspect_2.py\n"]
