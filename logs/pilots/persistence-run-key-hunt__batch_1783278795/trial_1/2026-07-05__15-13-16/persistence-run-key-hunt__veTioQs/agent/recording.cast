[76.578889, "i", "cat << 'EOF' > /tmp/logons.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\nSELECT event_id, event_code, host, user, target_user, logon_type, message\nFROM events\nWHERE event_code = 4624\nORDER BY timestamp\n\"\"\")\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} 4624 logons:\")\nfor r in rows:\n    msg = r['message'] or ''\n    # extract Account Name, Logon Type, Source Network Address\n    tgt_user = \"\"\n    src_ip = \"\"\n    logon_type = \"\"\n    for line in msg.split('\\n'):\n        if 'Account Name:' in line:\n            # sometimes there are multiple Account Names (Subject vs New Logon)\n            # we want the non-empty, non-hyphen ones\n            val = line.split(':')[-1].strip()\n            if val and val != '-':\n                tgt_user = val\n        if 'Logon Type:' in line:\n            logon_type = line.split(':')[-1].strip()\n        if 'Source Network Address:' in line:\n            src_ip = line.split(':')[-1].strip()\n    print(f\"{r['event_id']} | {r['host']} | user: {tgt_user} | type: {logon_type} | src: {src_ip}\")\nEOF\npython3 /tmp/logons.py\n"]
