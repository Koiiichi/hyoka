[204.31158, "i", "cat << 'EOF' > /tmp/ips_check.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\nSELECT event_id, event_code, host, message, details \nFROM events \nWHERE event_code IN (3, 5156, 5158)\n\"\"\")\n\nips = set()\nfor r in cur.fetchall():\n    msg = r['message'] or ''\n    det = r['details'] or ''\n    # parse IP addresses from message/details\n    for line in (msg + '\\n' + det).split('\\n'):\n        if 'Address:' in line or 'Ip:' in line or 'IPAddress' in line:\n            val = line.split(':')[-1].strip()\n            if val and val != '-' and val != '0.0.0.0' and val != '::' and val != '1' and val != '::1' and val != '127.0.0.1':\n                ips.add((r['host'], val))\n\nfor host, ip in sorted(ips):\n    print(f\"{host} | {ip}\")\nEOF\npython3 /tmp/ips_check.py\n"]
