[199.043991, "i", "cat << 'EOF' > /tmp/lolbas.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nkeywords = ['cmd.exe', 'wmic', 'certutil', 'mshta', 'regsvr32', 'schtasks', 'sc.exe', 'net.exe', 'net1.exe', 'psexec', 'mimikatz', 'cobalt', 'winrm']\n\ncur.execute(\"SELECT event_id, event_code, host, image, command_line, message, details FROM events\")\nfor r in cur.fetchall():\n    for kw in keywords:\n        # check if keyword is in image, command_line, message, details\n        img = r['image'] or ''\n        cmd = r['command_line'] or ''\n        msg = r['message'] or ''\n        det = r['details'] or ''\n        if kw in img.lower() or kw in cmd.lower() or kw in msg.lower() or kw in det.lower():\n            # filter out known benign stuff like winrm in standard windows messages or azure network watcher\n            if kw == 'winrm' and ('winrm' in msg.lower() or 'winrm' in det.lower()) and 'microsoft' in msg.lower():\n                continue\n            print(f\"{r['event_id']} | {r['host']} | Code {r['event_code']} | kw: {kw} | {img[:50]} | {cmd[:80]}\")\nEOF\npython3 /tmp/lolbas.py\n"]
[199.044249, "o", "cat << 'EOF' > /tmp/lolbas.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
