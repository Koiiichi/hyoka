[35.733264, "i", "cat << 'EOF' >> /tmp/analyze.py\n\n# Let's inspect Registry Events (12, 13)\nprint(\"\\n--- Registry Events ---\")\nfor ev in events:\n    if ev['event_code'] in (12, 13):\n        print(f\"{ev['event_id']} | {ev['event_code']} | {ev['host']} | {ev['user']} | {ev['image']} | {ev['target_object']} | {ev['details']}\")\n\n# Let's inspect Pipe Events (18)\nprint(\"\\n--- Pipe Events ---\")\nfor ev in events:\n    if ev['event_code'] == 18:\n        print(f\"{ev['event_id']} | {ev['host']} | {ev['user']} | {ev['image']} | {ev['details']}\")\n\n# Let's inspect File Create (11)\nprint(\"\\n--- File Create Events ---\")\nfor ev in events:\n    if ev['event_code'] == 11:\n        print(f\"{ev['event_id']} | {ev['host']} | {ev['user']} | {ev['image']} | {ev['target_object'] or ev['details']}\")\n\n# Let's inspect Process Access (10, 9)\nprint(\"\\n--- Process Access / Raw Access ---\")\nfor ev in events:\n    if ev['event_code'] in (9, 10):\n        print(f\"{ev['event_id']} | {ev['event_code']} | {ev['host']} | {ev['user']} | {ev['image']} | {ev['target_image']} | {ev['granted_access']} | {ev['details']}\")\nEOF\npython3 /tmp/analyze.py\n"]
