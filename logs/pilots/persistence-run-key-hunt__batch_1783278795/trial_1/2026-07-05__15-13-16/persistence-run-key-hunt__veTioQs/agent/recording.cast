[53.49014, "i", "cat << 'EOF' > /tmp/c2.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Find all events mentioning 10.10.10.5, or of type 3 / 5156 / 5158 with 10.10.10.5\ncur.execute(\"\"\"\nSELECT event_id, event_code, host, user, image, src_ip, dst_ip, dst_port, details, message\nFROM events\nWHERE details LIKE '%10.10.10.5%'\n   OR message LIKE '%10.10.10.5%'\n   OR src_ip = '10.10.10.5'\n   OR dst_ip = '10.10.10.5'\nORDER BY timestamp\n\"\"\")\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} events relating to C2 (10.10.10.5):\")\nfor r in rows:\n    sip = r['src_ip'] or ''\n    dip = r['dst_ip'] or ''\n    dport = r['dst_port'] or ''\n    img = r['image'] or ''\n    user = r['user'] or ''\n    print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | {user} | {img} | {sip} -> {dip}:{dport}\")\nEOF\npython3 /tmp/c2.py\n"]
