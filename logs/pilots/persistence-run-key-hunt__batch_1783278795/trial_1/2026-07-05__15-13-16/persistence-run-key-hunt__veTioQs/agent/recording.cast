[64.578267, "i", "cat << 'EOF' > /tmp/ps_logs.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\nSELECT event_id, event_code, host, user, message, timestamp\nFROM events\nWHERE event_code IN (800, 4103, 4104)\nORDER BY timestamp\n\"\"\")\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} PowerShell log events:\")\nfor r in rows:\n    # Let's see some snippet of the message\n    msg = r['message'] or ''\n    # extract command or script block if possible\n    snippet = \"\"\n    if r['event_code'] == 800:\n        # Look for pipeline execution details\n        for line in msg.split('\\n'):\n            if 'Pipeline execution details' in line or 'Command Line' in line or 'Host Application' in line:\n                snippet += line.strip() + \" | \"\n    elif r['event_code'] == 4103:\n        # Look for CommandInvocation\n        for line in msg.split('\\n'):\n            if 'CommandInvocation' in line or 'ParameterBinding' in line or 'Host Application' in line:\n                snippet += line.strip() + \" | \"\n    if len(snippet) > 200:\n        snippet = snippet[:200] + \"...\"\n    print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | {snippet} | {r['timestamp']}\")\nEOF\npython3 /tmp/ps_logs.py\n"]
[64.578698, "o", "cat << 'EOF' > /tmp/ps_logs.py\r\n\u001b[?2004l\r"]
