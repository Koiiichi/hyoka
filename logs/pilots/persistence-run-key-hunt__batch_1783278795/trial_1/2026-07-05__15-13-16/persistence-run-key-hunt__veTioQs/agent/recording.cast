[147.863543, "i", "cat << 'EOF' > /tmp/dc01_inspect.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\ncur.execute(\"\"\"\nSELECT event_id, event_code, user, image, parent_image, command_line, target_object, details, message, timestamp\nFROM events\nWHERE host = 'DC01.corp.example' AND event_code NOT IN (5156, 5158)\nORDER BY timestamp\n\"\"\")\nfor r in cur.fetchall():\n    tgt = r['target_object'] or r['details'] or ''\n    cmd = r['command_line'] or ''\n    img = r['image'] or ''\n    print(f\"{r['event_id']} | {r['event_code']} | {img} | {tgt[:80]} | {cmd[:80]} | {r['timestamp']}\")\nEOF\npython3 /tmp/dc01_inspect.py\n"]
