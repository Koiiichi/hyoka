[109.950198, "i", "cat << 'EOF' > /tmp/dc01_net.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\ncur.execute(\"\"\"\nSELECT event_id, event_code, user, image, src_ip, dst_ip, dst_port \nFROM events \nWHERE host = 'DC01.corp.example' AND event_code IN (3, 5156, 5158)\nORDER BY timestamp\n\"\"\")\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} network events on DC01\")\n# Let's count the distinct destination IPs and ports to see what's there\ncounts = {}\nfor r in rows:\n    dip = r['dst_ip'] or ''\n    dport = r['dst_port'] or ''\n    img = r['image'] or ''\n    key = (img, dip, dport)\n    counts[key] = counts.get(key, 0) + 1\n\nfor k, c in sorted(counts.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{c} times: {k[0]} -> {k[1]}:{k[2]}\")\nEOF\npython3 /tmp/dc01_net.py\n"]
