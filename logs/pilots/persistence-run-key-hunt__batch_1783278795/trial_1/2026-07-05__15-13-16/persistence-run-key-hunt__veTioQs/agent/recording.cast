[139.070332, "i", "cat << 'EOF' > /tmp/ws05_obj.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\nSELECT event_id, event_code, user, target_user, target_object, details, message, timestamp\nFROM events\nWHERE host = 'WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690)\nORDER BY timestamp\n\"\"\")\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} object events on WS-05\")\nfor r in rows[:10]:\n    print(f\"{r['event_id']} | {r['event_code']} | {r['user']} | {r['target_object']} | {r['details']}\")\n\n# Let's see the unique target objects and users\ncounts = {}\nfor r in rows:\n    tgt = r['target_object'] or ''\n    user = r['user'] or ''\n    # check message if target_object is empty\n    if not tgt:\n        msg = r['message'] or ''\n        for line in msg.split('\\n'):\n            if 'Object Name:' in line:\n                tgt = line.split(':')[-1].strip()\n            if 'Account Name:' in line and not user:\n                user = line.split(':')[-1].strip()\n    key = (user, tgt, r['event_code'])\n    counts[key] = counts.get(key, 0) + 1\n\nprint(\"\\nUnique count:\")\nfor k, c in sorted(counts.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{c} times: User {k[0]} | Object {k[1]} | Code {k[2]}\")\nEOF\npython3 /tmp/ws05_obj.py\n"]
