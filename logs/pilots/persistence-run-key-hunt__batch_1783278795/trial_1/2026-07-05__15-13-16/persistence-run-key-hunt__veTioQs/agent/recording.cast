[204.32481, "o", "DC01.corp.example | 168.63.129.16\r\nDC01.corp.example | 169.254.169.254\r\nDC01.corp.example | 172.18.38.5\r\nDC01.corp.example | 172.18.38.6\r\nDC01.corp.example | 23.96.98.40\r\nDC01.corp.example | dbba\r\nWS-05.corp.example | 10.10.10.5\r\nWS-05.corp.example | 169.254.169.254\r\nWS-05.corp.example | 172.18.38.6\r\nWS-05.corp.example | 172.18.39.5\r\nWS-06.corp.example | 172.18.38.6\r\nWS-06.corp.example | 172.18.39.6\r\n"]
[204.32665, "o", "\u001b[?2004hroot@b64900ae1d22:~# "]
[212.588269, "i", "cat << 'EOF' > /tmp/save_findings.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events ORDER BY timestamp\")\nall_events = [dict(r) for r in cur.fetchall()]\n\nmal_ids = []\n\nfor ev in all_events:\n    eid = ev['event_id']\n    code = ev['event_code']\n    host = ev['host']\n    user = ev['user'] or ''\n    guid = ev['process_guid'] or ''\n    image = ev['image'] or ''\n    msg = ev['message'] or ''\n    details = ev['details'] or ''\n    tgt = ev['target_object'] or ''\n    \n    # Check malicious criteria on WS-05\n    if host == 'WS-05.corp.example':\n        # 1. Malicious process_guid\n        if guid == '{b59756a9-b239-5f17-5307-000000000400}':\n            mal_ids.append(eid)\n            continue\n            \n        # 2. PowerShell logging\n        if code in (800, 4103):\n            mal_ids.append(eid)\n            continue\n            \n        # 3. Registry object access by pgustavo\n        if code in (4656, 4658, 4663, 4690) and user == 'pgustavo':\n            mal_ids.append(eid)\n            continue\n            \n        # 4. WFP connection/bind associated with PID 9076 or powershell.exe\n        if code in (5156, 5158):\n            is_mal_wfp = False\n            if '9076' in msg or '9076' in details:\n                is_mal_wfp = True\n            if 'powershell.exe' in msg.lower() or 'powershell.exe' in details.lower():\n                is_mal_wfp = True\n            if is_mal_wfp:\n                mal_ids.append(eid)\n                continue\n\n# Sort findings by event ID numerical order or string order\nmal_ids = sorted(list(set(mal_ids)))\n\nprint(f\"Total flagged malicious events: {len(mal_ids)}\")\nwith open('/root/findings.json', 'w') as f:\n    json.dump(mal_ids, f, indent=2)\n\nprint(\"Saved findings to /root/findings.json\")\nEOF\npython3 /tmp/save_findings.py\n"]
[212.588674, "o", "cat << 'EOF' > /tmp/save_findings.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
