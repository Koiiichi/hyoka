[70.85696, "i", "cat << 'EOF' > /tmp/hosts_ips.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT distinct host, src_ip, dst_ip FROM events\")\nfor r in cur.fetchall():\n    if r['src_ip'] or r['dst_ip']:\n        print(f\"{r['host']} | src_ip: {r['src_ip']} | dst_ip: {r['dst_ip']}\")\nEOF\npython3 /tmp/hosts_ips.py\n"]
