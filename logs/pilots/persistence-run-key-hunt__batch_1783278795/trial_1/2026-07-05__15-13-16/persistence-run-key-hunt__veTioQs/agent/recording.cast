[127.840731, "i", "cat << 'EOF' > /tmp/ws05_proc.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\nSELECT event_id, event_code, user, image, parent_image, command_line, process_guid, timestamp\nFROM events\nWHERE host = 'WS-05.corp.example'\nORDER BY timestamp\n\"\"\")\n\nrows = cur.fetchall()\nprint(f\"WS-05 has {len(rows)} events\")\n\nguids = {}\nfor r in rows:\n    pguid = r['process_guid']\n    if pguid:\n        if pguid not in guids:\n            guids[pguid] = []\n        guids[pguid].append(r)\n\nfor g, evs in guids.items():\n    first_ev = evs[0]\n    print(f\"GUID: {g} | Events count: {len(evs)} | First Image: {first_ev['image']} | Parent: {first_ev['parent_image']} | User: {first_ev['user']}\")\nEOF\npython3 /tmp/ws05_proc.py\n"]
