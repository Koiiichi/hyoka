[85.998825, "i", "cat << 'EOF' > /tmp/non_network.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# We want to exclude 5156, 5158, 800, 4103, 4658, 4690, 4656, 4634\ncur.execute(\"\"\"\nSELECT event_id, event_code, host, user, target_user, image, parent_image, command_line, target_object, details, message, timestamp\nFROM events\nWHERE event_code NOT IN (5156, 5158, 800, 4103, 4658, 4690, 4656, 4634)\nORDER BY timestamp\n\"\"\")\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} interesting non-network/powershell events:\")\nfor r in rows:\n    code = r['event_code']\n    host = r['host']\n    user = r['user'] or ''\n    img = r['image'] or ''\n    tgt = r['target_object'] or r['details'] or ''\n    cmd = r['command_line'] or ''\n    print(f\"{r['event_id']} | {code} | {host} | {user} | {img} | {tgt[:100]} | {cmd[:100]} | {r['timestamp']}\")\nEOF\npython3 /tmp/non_network.py\n"]
