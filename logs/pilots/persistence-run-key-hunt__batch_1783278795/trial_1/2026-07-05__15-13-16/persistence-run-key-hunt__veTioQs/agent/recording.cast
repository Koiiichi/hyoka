[59.136091, "i", "cat << 'EOF' > /tmp/guid.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ntarget_guid = '{b59756a9-b239-5f17-5307-000000000400}'\n\ncur.execute(\"\"\"\nSELECT event_id, event_code, host, user, image, parent_image, process_guid, details, message, timestamp\nFROM events\nWHERE process_guid = ? \n   OR details LIKE ? \n   OR message LIKE ?\nORDER BY timestamp\n\"\"\", (target_guid, f'%{target_guid}%', f'%{target_guid}%'))\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} events relating to GUID {target_guid}:\")\nfor r in rows:\n    img = r['image'] or ''\n    pimg = r['parent_image'] or ''\n    user = r['user'] or ''\n    print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | {user} | {img} | {pimg} | {r['timestamp']}\")\nEOF\npython3 /tmp/guid.py\n"]
