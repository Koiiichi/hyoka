[115.830438, "i", "cat << 'EOF' > /tmp/dc01_wfp.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\nSELECT event_id, event_code, message, details \nFROM events \nWHERE host = 'DC01.corp.example' AND event_code = 5156\n\"\"\")\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} WFP 5156 events on DC01\")\n\nconnections = {}\nfor r in rows:\n    msg = r['message'] or ''\n    sip, dip, dport, direction, app = '', '', '', '', ''\n    for line in msg.split('\\n'):\n        if 'Source Address:' in line:\n            sip = line.split(':')[-1].strip()\n        elif 'Destination Address:' in line:\n            dip = line.split(':')[-1].strip()\n        elif 'Destination Port:' in line:\n            dport = line.split(':')[-1].strip()\n        elif 'Direction:' in line:\n            direction = line.split(':')[-1].strip()\n        elif 'Application Name:' in line:\n            app = line.split(':')[-1].strip()\n    key = (app, sip, dip, dport, direction)\n    connections[key] = connections.get(key, []) + [r['event_id']]\n\nfor k, evs in sorted(connections.items(), key=lambda x: len(x[1]), reverse=True):\n    print(f\"{len(evs)} times: {k[0]} | {k[1]} -> {k[2]}:{k[3]} | {k[4]} | sample event: {evs[0]}\")\nEOF\npython3 /tmp/dc01_wfp.py\n"]
