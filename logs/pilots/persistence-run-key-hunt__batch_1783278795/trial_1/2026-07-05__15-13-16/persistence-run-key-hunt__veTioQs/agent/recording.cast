[21.874108, "o", "\u001b[?2004hroot@b64900ae1d22:~# "]
[27.584943, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\nimport json\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's pull all events to memory to analyze\ncur.execute(\"SELECT * FROM events ORDER BY timestamp\")\nevents = [dict(r) for r in cur.fetchall()]\n\nprint(f\"Total events: {len(events)}\")\n\n# Let's look for known malicious markers, like PowerShell, suspicious processes, lateral movement.\n# Let's inspect processes started, network connections made, registry keys, etc.\n\nfor ev in events:\n    code = ev['event_code']\n    host = ev['host']\n    image = ev['image']\n    cmd = ev['command_line']\n    msg = ev['message']\n    \n    # Let's print out process creations or script blocks that are interesting\n    if code in (1, 4688) or (image and 'powershell' in image.lower()) or (cmd and 'powershell' in cmd.lower()):\n        print(f\"{ev['event_id']} | {code} | {host} | {ev['user']} | {image} | {cmd}\")\n\nEOF\npython3 /tmp/analyze.py\n"]
[27.585303, "o", "cat << 'EOF' > /tmp/analyze.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import base64\r\n\u001b[?2004l\r\u001b[?2004h"]
[27.585394, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
