[120.697723, "i", "cat << 'EOF' > /tmp/reg.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\nSELECT event_id, event_code, host, user, image, target_object, details\nFROM events\nWHERE event_code IN (12, 13)\n\"\"\")\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} registry events\")\n\nfor r in rows:\n    img = r['image'] or ''\n    # filter out standard non-powershell, non-malicious if we want, but let's just print all of them since there are only 32 total\n    print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | {img} | {r['target_object']} | {r['details']}\")\nEOF\npython3 /tmp/reg.py\n"]
