[194.042592, "o", "sqlite3 /root/data/eventlogs.db \"SELECT event_id, event_code, host, image, command_line FROM events WHERE (image LIKE '%powershell%' OR command_line LIKE '%powershell%' OR message LIKE '%powershell%') AND host != 'WS-05.corp.example';\"\r\n\u001b[?2004l\r"]
