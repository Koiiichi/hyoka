[159.734447, "o", "\u001b[?2004hroot@b64900ae1d22:~# "]
[169.597155, "i", "cat << 'EOF' > /tmp/ws05_benign_inspect.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\nrows = [dict(r) for r in cur.fetchall()]\n\n# Let's define our known malicious check function exactly\ndef is_mal_event(ev):\n    eid = ev['event_id']\n    code = ev['event_code']\n    guid = ev['process_guid'] or ''\n    user = ev['user'] or ''\n    tgt = ev['target_object'] or ''\n    msg = ev['message'] or ''\n    details = ev['details'] or ''\n    \n    # 1. Malicious process_guid\n    if guid == '{b59756a9-b239-5f17-5307-000000000400}':\n        return True, \"PowerShell process_guid\"\n    \n    # 2. PowerShell logging\n    if code in (800, 4103):\n        return True, \"PowerShell log\"\n        \n    # 3. Object handle events by user pgustavo (we verified all of them are for the Run key)\n    if code in (4656, 4658, 4663, 4690) and user == 'pgustavo':\n        return True, \"Registry Run key access\"\n        \n    # 4. WFP network connections from our malicious PowerShell. Wait, how do we identify them?\n    # We know the C2 IP is 10.10.10.5. Are there other WFP connections that are malicious?\n    if code in (5156, 5158):\n        if '10.10.10.5' in msg or '10.10.10.5' in details:\n            return True, \"C2 Network connection\"\n            \n    return False, \"\"\n\ncount_mal = 0\ncount_benign = 0\nfor r in rows:\n    mal, reason = is_mal_event(r)\n    if mal:\n        count_mal += 1\n    else:\n        count_benign += 1\n        print(f\"{r['event_id']} | Code {r['event_code']} | User {r['user']} | Image {r['image']} | Tgt {r['target_object']} | Msg {r['message'][:120].replace('\\n', ' ')}\")\n\nprint(f\"\\nSummary: {count_mal} malicious, {count_benign} benign\")\nEOF\npython3 /tmp/ws05_benign_inspect.py\n"]
[169.599354, "o", "cat << 'EOF' > /tmp/ws05_benign_inspect.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
