[35.757565, "o", "\u001b[?2004hroot@b64900ae1d22:~# "]
[42.385502, "i", "cat << 'EOF' > /tmp/network.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\nSELECT event_id, event_code, host, user, image, src_ip, dst_ip, dst_port, details, message\nFROM events \nWHERE event_code IN (3, 5156, 5158)\nORDER BY timestamp\n\"\"\")\n\nrows = cur.fetchall()\nprint(f\"Found {len(rows)} network events.\")\nfor r in rows:\n    # print non-empty dest_ip/src_ip\n    img = r['image'] if r['image'] else ''\n    # check message or details for IP details if src_ip/dst_ip are empty\n    sip = r['src_ip'] or ''\n    dip = r['dst_ip'] or ''\n    dport = r['dst_port'] or ''\n    details = r['details'] or ''\n    \n    # Let's extract IP details if they are in details or message\n    msg = r['message'] or ''\n    if not sip and 'Source Address:' in msg:\n        for line in msg.split('\\n'):\n            if 'Source Address:' in line or 'Source Network Address:' in line:\n                sip = line.split(':')[-1].strip()\n            if 'Destination Address:' in line:\n                dip = line.split(':')[-1].strip()\n            if 'Destination Port:' in line:\n                dport = line.split(':')[-1].strip()\n    \n    if not sip and 'SourceAddress' in details:\n        # parse details if it's JSON or XML or key-value\n        pass \n\n    # Only print interesting ones\n    # Let's filter out known noise, like 127.0.0.1 or ::1 or standard ports if too many\n    if sip in ('127.0.0.1', '::1') and dip in ('127.0.0.1', '::1'):\n        continue\n    \n    print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | {r['user']} | {img} | {sip} -> {dip}:{dport}\")\nEOF\npython3 /tmp/network.py\n"]
