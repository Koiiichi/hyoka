[86.015248, "o", "\u001b[?2004hroot@b64900ae1d22:~# "]
[93.118103, "i", "cat << 'EOF' > /tmp/details.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\nSELECT event_id, event_code, host, user, target_user, image, parent_image, command_line, target_object, details, message, timestamp\nFROM events\nWHERE event_code NOT IN (5156, 5158, 800, 4103, 4658, 4690, 4656, 4634)\nORDER BY timestamp\n\"\"\")\n\nwith open('/tmp/non_network.log', 'w') as f:\n    for r in cur.fetchall():\n        code = r['event_code']\n        host = r['host']\n        user = r['user'] or ''\n        img = r['image'] or ''\n        pimg = r['parent_image'] or ''\n        tgt = r['target_object'] or ''\n        details = r['details'] or ''\n        cmd = r['command_line'] or ''\n        msg = r['message'] or ''\n        \n        f.write(f\"=== EVENT {r['event_id']} | Code {code} | Host {host} | Timestamp {r['timestamp']} ===\\n\")\n        f.write(f\"User: {user} | TargetUser: {r['target_user'] or ''}\\n\")\n        f.write(f\"Image: {img} | Parent: {pimg}\\n\")\n        f.write(f\"CommandLine: {cmd}\\n\")\n        f.write(f\"TargetObject: {tgt} | Details: {details}\\n\")\n        # Just print first 5 lines of message if it exists\n        if msg:\n            msg_lines = msg.split('\\n')[:10]\n            f.write(\"Message:\\n  \" + \"\\n  \".join(msg_lines) + \"\\n\")\n        f.write(\"\\n\")\n\nprint(\"Written detailed log to /tmp/non_network.log\")\nEOF\npython3 /tmp/details.py\n"]
