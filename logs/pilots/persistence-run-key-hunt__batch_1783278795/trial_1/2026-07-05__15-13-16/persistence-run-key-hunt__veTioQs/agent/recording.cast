[27.586921, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's pull all events to memory to analyze\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT * FROM events ORDER BY timestamp\")\r\n\u001b[?2004l\r\u001b[?2004h> events = [dict(r) for r in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total events: {len(events)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's look for known malicious markers, like PowerShell, suspicious processes, lateral movement.\r\n\u001b[?2004l\r\u001b[?2004h> # Let's inspect processes started, network connections made, registry keys, etc.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for ev in events:\r\n\u001b[?2004l\r\u001b[?2004h>     code = ev['event_code']\r\n\u001b[?2004l\r\u001b[?2004h>     host = ev['host']\r\n\u001b[?2004l\r\u001b[?2004h>     image = ev['image']\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = ev['command_line']\r\n\u001b[?2004l\r\u001b[?2004h>     msg = ev['message']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Let's print out process creations or script blocks that are interesting\r\n\u001b[?2004l\r\u001b[?2004h>     if code in (1, 4688) or (image and 'powershell' in image.lower()) or (cmd and 'powershell' in cmd.lower()):\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"{ev['event_id']} | {code} | {host} | {ev['user']} | {image} | {cmd}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
