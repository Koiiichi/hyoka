[?2004l[?2004h> ws05_events = [dict(r) for r in cur.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> malicious_ids = []
[?2004l[?2004h> benign_ids = []
[?2004l[?2004h> 
[?2004l[?2004h> for ev in ws05_events:
[?2004l[?2004h>     eid = ev['event_id']
[?2004l[?2004h>     code = ev['event_code']
[?2004l[?2004h>     img = ev['image'] or ''
[?2004l[?2004h>     user = ev['user'] or ''
[?2004l[?2004h>     tgt = ev['target_object'] or ''
[?2004l[?2004h>     details = ev['details'] or ''
[?2004l[?2004h>     cmd = ev['command_line'] or ''
[?2004l[?2004h>     msg = ev['message'] or ''
[?2004l[?2004h>     
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     reason = ""
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. Any PowerShell script block or module log on WS-05 is malicious (part of C2/agent execution)
[?2004l[?2004h>     if code in (800, 4103):
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         reason = "PowerShell C2 script execution"
[?2004l[?2004h>         
[?2004l[?2004h>     # 2. Any process_guid matching the malicious powershell
[?2004l[?2004h>     elif ev['process_guid'] == '{b59756a9-b239-5f17-5307-000000000400}':
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         reason = "Malicious powershell process_guid"
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Object access on Run key by user pgustavo
[?2004l[?2004h>     elif code in (4656, 4658, 4663, 4690) and 'Run' in (tgt or msg or ''):
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         reason = "Persistence registry access"
[?2004l[?2004h>         
[?2004l[?2004h>     # 4. WFP connection allowed to C2 (10.10.10.5)
[?2004l[?2004h>     elif code in (5156, 5158) and '10.10.10.5' in msg:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         reason = "WFP C2 connection"
[?2004l[?2004h>         
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         malicious_ids.append((eid, code, img or 'powershell', reason))
[?2004l[?2004h>     else:
[?2004l[?2004h>         benign_ids.append((eid, code, img, user, tgt[:50], msg[:100].replace('\n', ' ')))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Malicious: {len(malicious_ids)}")
[?2004l[?2004h> print(f"Benign: {len(benign_ids)}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n--- BENIGN EVENTS ON WS-05 ---")
[?2004l[?2004h> for bid in benign_ids:
[?2004l[?2004h>     print(f"{bid[0]} | Code {bid[1]} | Image {bid[2]} | User {bid[3]} | Target {bid[4]} | Msg {bid[5][:80]}")
[?2004l[?2004h> EOF
