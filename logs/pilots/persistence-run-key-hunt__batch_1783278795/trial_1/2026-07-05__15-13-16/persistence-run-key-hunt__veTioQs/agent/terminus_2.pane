[?2004hroot@b64900ae1d22:~# cat << 'EOF' > /tmp/ws05_benign_inspect.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp")
[?2004l[?2004h> rows = [dict(r) for r in cur.fetchall()]
[?2004l[?2004h> 
[?2004l[?2004h> # Let's define our known malicious check function exactly
[?2004l[?2004h> def is_mal_event(ev):
[?2004l[?2004h>     eid = ev['event_id']
[?2004l[?2004h>     code = ev['event_code']
[?2004l[?2004h>     guid = ev['process_guid'] or ''
[?2004l[?2004h>     user = ev['user'] or ''
[?2004l[?2004h>     tgt = ev['target_object'] or ''
[?2004l[?2004h>     msg = ev['message'] or ''
[?2004l[?2004h>     details = ev['details'] or ''
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. Malicious process_guid
[?2004l[?2004h>     if guid == '{b59756a9-b239-5f17-5307-000000000400}':
[?2004l[?2004h>         return True, "PowerShell process_guid"
[?2004l[?2004h>     
[?2004l[?2004h>     # 2. PowerShell logging
[?2004l[?2004h>     if code in (800, 4103):
[?2004l[?2004h>         return True, "PowerShell log"
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Object handle events by user pgustavo (we verified all of them are for the Run key)
[?2004l[?2004h>     if code in (4656, 4658, 4663, 4690) and user == 'pgustavo':
[?2004l[?2004h>         return True, "Registry Run key access"
[?2004l[?2004h>         
[?2004l[?2004h>     # 4. WFP network connections from our malicious PowerShell. Wait, how do we identify them?
[?2004l[?2004h>     # We know the C2 IP is 10.10.10.5. Are there other WFP connections that are malicious?
[?2004l[?2004h>     if code in (5156, 5158):
[?2004l[?2004h>         if '10.10.10.5' in msg or '10.10.10.5' in details:
[?2004l[?2004h>             return True, "C2 Network connection"
[?2004l[?2004h>             
[?2004l[?2004h>     return False, ""
[?2004l[?2004h> 
[?2004l[?2004h> count_mal = 0
[?2004l[?2004h> count_benign = 0
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     mal, reason = is_mal_event(r)
[?2004l[?2004h>     if mal:
[?2004l[?2004h>         count_mal += 1
[?2004l[?2004h>     else:
[?2004l[?2004h>         count_benign += 1
[?2004l[?2004h>         print(f"{r['event_id']} | Code {r['event_code']} | User {r['user']} | Image {r['image']} | Tgt {r['target_object']} | Msg {r['message'][:120].replace('\n', ' ')}")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nSummary: {count_mal} malicious, {count_benign} benign")
[?2004l[?2004h> EOF
