[?2004hroot@b64900ae1d22:~# cat << 'EOF' > /tmp/logons.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h> SELECT event_id, event_code, host, user, target_user, logon_type, message
[?2004l[?2004h> FROM events
[?2004l[?2004h> WHERE event_code = 4624
[?2004l[?2004h> ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} 4624 logons:")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     # extract Account Name, Logon Type, Source Network Address
[?2004l[?2004h>     tgt_user = ""
[?2004l[?2004h>     src_ip = ""
[?2004l[?2004h>     logon_type = ""
[?2004l[?2004h>     for line in msg.split('\n'):
[?2004l[?2004h>         if 'Account Name:' in line:
[?2004l[?2004h>             # sometimes there are multiple Account Names (Subject vs New Logon)
[?2004l[?2004h>             # we want the non-empty, non-hyphen ones
[?2004l[?2004h>             val = line.split(':')[-1].strip()
[?2004l[?2004h>             if val and val != '-':
[?2004l[?2004h>                 tgt_user = val
[?2004l[?2004h>         if 'Logon Type:' in line:
[?2004l[?2004h>             logon_type = line.split(':')[-1].strip()
[?2004l[?2004h>         if 'Source Network Address:' in line:
[?2004l[?2004h>             src_ip = line.split(':')[-1].strip()
[?2004l[?2004h>     print(f"{r['event_id']} | {r['host']} | user: {tgt_user} | type: {logon_type} | src: {src_ip}")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@b64900ae1d22:~# python3 /tmp/logons.py
