[?2004l[?2004h>     img = r['image'] if r['image'] else ''
[?2004l[?2004h>     # check message or details for IP details if src_ip/dst_ip are empty
[?2004l[?2004h>     sip = r['src_ip'] or ''
[?2004l[?2004h>     dip = r['dst_ip'] or ''
[?2004l[?2004h>     dport = r['dst_port'] or ''
[?2004l[?2004h>     details = r['details'] or ''
[?2004l[?2004h>     
[?2004l[?2004h>     # Let's extract IP details if they are in details or message
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     if not sip and 'Source Address:' in msg:
[?2004l[?2004h>         for line in msg.split('\n'):
[?2004l[?2004h>             if 'Source Address:' in line or 'Source Network Address:' in line:
[?2004l[?2004h>                 sip = line.split(':')[-1].strip()
[?2004l[?2004h>             if 'Destination Address:' in line:
[?2004l[?2004h>                 dip = line.split(':')[-1].strip()
[?2004l[?2004h>             if 'Destination Port:' in line:
[?2004l[?2004h>                 dport = line.split(':')[-1].strip()
[?2004l[?2004h>     
[?2004l[?2004h>     if not sip and 'SourceAddress' in details:
[?2004l[?2004h>         # parse details if it's JSON or XML or key-value
[?2004l[?2004h>         pass 
[?2004l[?2004h> 
[?2004l[?2004h>     # Only print interesting ones
[?2004l[?2004h>     # Let's filter out known noise, like 127.0.0.1 or ::1 or standard ports if too many
