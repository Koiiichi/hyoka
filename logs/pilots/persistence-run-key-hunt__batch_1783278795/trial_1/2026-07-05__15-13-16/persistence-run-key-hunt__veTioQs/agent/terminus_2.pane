[?2004l[?2004h> ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} network events.")
