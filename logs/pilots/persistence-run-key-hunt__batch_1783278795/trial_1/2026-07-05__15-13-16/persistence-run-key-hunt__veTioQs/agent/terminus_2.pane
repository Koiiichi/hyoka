[?2004hroot@b64900ae1d22:~# cat << 'EOF' > /tmp/details.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h> SELECT event_id, event_code, host, user, target_user, image, parent_image, command_line, target_object, details, message, timestamp
[?2004l[?2004h> FROM events
[?2004l[?2004h> WHERE event_code NOT IN (5156, 5158, 800, 4103, 4658, 4690, 4656, 4634)
[?2004l[?2004h> ORDER BY timestamp
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> with open('/tmp/non_network.log', 'w') as f:
[?2004l[?2004h>     for r in cur.fetchall():
[?2004l[?2004h>         code = r['event_code']
[?2004l[?2004h>         host = r['host']
[?2004l[?2004h>         user = r['user'] or ''
[?2004l[?2004h>         img = r['image'] or ''
[?2004l[?2004h>         pimg = r['parent_image'] or ''
[?2004l[?2004h>         tgt = r['target_object'] or ''
[?2004l[?2004h>         details = r['details'] or ''
[?2004l[?2004h>         cmd = r['command_line'] or ''
[?2004l[?2004h>         msg = r['message'] or ''
[?2004l[?2004h>         
[?2004l[?2004h>         f.write(f"=== EVENT {r['event_id']} | Code {code} | Host {host} | Timestamp {r['timestamp']} ===\n")
[?2004l[?2004h>         f.write(f"User: {user} | TargetUser: {r['target_user'] or ''}\n")
[?2004l[?2004h>         f.write(f"Image: {img} | Parent: {pimg}\n")
[?2004l[?2004h>         f.write(f"CommandLine: {cmd}\n")
[?2004l[?2004h>         f.write(f"TargetObject: {tgt} | Details: {details}\n")
[?2004l[?2004h>         # Just print first 5 lines of message if it exists
[?2004l[?2004h>         if msg:
[?2004l[?2004h>             msg_lines = msg.split('\n')[:10]
[?2004l[?2004h>             f.write("Message:\n  " + "\n  ".join(msg_lines) + "\n")
[?2004l[?2004h>         f.write("\n")
[?2004l[?2004h> 
[?2004l[?2004h> print("Written detailed log to /tmp/non_network.log")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@b64900ae1d22:~# python3 /tmp/details.py
[?2004lWritten detailed log to /tmp/non_network.log
