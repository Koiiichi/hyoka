[20.047589, "i", "cat << 'EOF' > parse_ps.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's get all PowerShell script/message content on WS-05\ncur.execute(\"SELECT event_id, timestamp, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (800, 4103) ORDER BY timestamp\")\nfor r in cur.fetchall():\n    msg = r['message']\n    print(f\"=== {r['event_id']} | {r['timestamp']} | {r['event_code']} ===\")\n    print(msg)\nEOF\npython3 parse_ps.py > ps_logs.txt\nhead -n 100 ps_logs.txt\n"]
