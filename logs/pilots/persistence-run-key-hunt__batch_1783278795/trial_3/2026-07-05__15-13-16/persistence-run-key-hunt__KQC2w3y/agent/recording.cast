[125.942144, "i", "cat << 'EOF' > parse_handles.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (4656, 4658, 4690) ORDER BY timestamp\")\nfor r in cur.fetchall():\n    msg = r['message']\n    # Check if powershell (0x2374 / 9076) or Run key or Debug key are in the message\n    if any(kw in msg.lower() for kw in ['powershell', '0x2374', 'currentversion\\\\run', 'debug']):\n        print(f\"{r['event_id']} | {r['event_code']} | {msg[:150].replace('\\n', ' ')}\")\nEOF\npython3 parse_handles.py\n"]
[125.942471, "o", "cat << 'EOF' > parse_handles.py\r\n\u001b[?2004l\r"]
