[39.728394, "i", "cat << 'EOF' > parse_all_hosts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== WS-06 ===\")\ncur.execute(\"SELECT event_id, timestamp, event_code, user, image, command_line, target_image, details, message FROM events WHERE host='WS-06.corp.example' ORDER BY timestamp\")\nfor r in cur.fetchall():\n    d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\n    print(f\"{d.get('event_id')} | {d.get('timestamp')} | {d.get('event_code')} | {d.get('user')} | {d.get('image')} | {d.get('command_line')} | {d.get('target_image')} | {str(d.get('message', ''))[:120].replace('\\n', ' ')}\")\n\nprint(\"\\n=== DC01 ===\")\ncur.execute(\"SELECT event_id, timestamp, event_code, user, image, command_line, target_image, details, message FROM events WHERE host='DC01.corp.example' ORDER BY timestamp\")\nfor r in cur.fetchall():\n    d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\n    # Let's filter DC01 noisy events too. Let's see all unique event_codes on DC01 first.\nEOF\npython3 parse_all_hosts.py | head -n 40\n"]
