[168.582617, "i", "cat << 'EOF' > save_findings.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# We'll fetch all events from WS-05\ncur.execute(\"SELECT * FROM events WHERE host='WS-05.corp.example'\")\nrows = cur.fetchall()\n\nmalicious_ids = []\n\nfor r in rows:\n    d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\n    ev_id = d.get('event_id')\n    ev_code = d.get('event_code')\n    image = d.get('image', '')\n    msg = d.get('message', '')\n    \n    is_malicious = False\n    \n    # 1. PowerShell Script block / pipeline execution\n    if ev_code in [800, 4103]:\n        is_malicious = True\n        \n    # 2. Sysmon Network connection for powershell.exe\n    elif ev_code == 3 and 'powershell.exe' in image:\n        is_malicious = True\n        \n    # 3. Sysmon Registry events for powershell.exe\n    elif ev_code in [12, 13] and 'powershell.exe' in image:\n        is_malicious = True\n        \n    # 4. Security Handle events for powershell.exe\n    elif ev_code in [4656, 4658, 4690] and ('powershell' in msg.lower() or '0x2374' in msg.lower() or '9076' in msg.lower()):\n        is_malicious = True\n        \n    # 5. Security Object access for powershell.exe\n    elif ev_code == 4663 and ('powershell' in msg.lower() or '0x2374' in msg.lower() or '9076' in msg.lower()):\n        is_malicious = True\n        \n    # 6. WFP events for powershell.exe\n    elif ev_code in [5156, 5158] and ('powershell' in msg.lower() or '10.10.10.5' in msg or '9076' in msg.lower()):\n        is_malicious = True\n        \n    if is_malicious:\n        malicious_ids.append(ev_id)\n\n# Sort malicious_ids to ensure consistency\nmalicious_ids.sort()\n\nprint(f\"Saving {len(malicious_ids)} malicious event IDs to /root/findings.json...\")\nwith open('/root/findings.json', 'w') as f:\n    json.dump(malicious_ids, f, indent=2)\nEOF\npython3 save_findings.py\n"]
[168.583478, "o", "cat << 'EOF' > save_findings.py\r\n"]
[168.584794, "o", "\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # We'll fetch all events from WS-05\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\"SELECT * FROM events WHERE host='WS-05.corp.example'\")\r\n\u001b[?2004l\r\u001b[?2004h> rows = cur.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> malicious_ids = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\r\n\u001b[?2004l\r\u001b[?2004h>     ev_id = d.get('event_id')\r\n\u001b[?2004l\r\u001b[?2004h>     ev_code = d.get('event_code')\r\n\u001b[?2004l\r\u001b[?2004h>     image = d.get('image', '')\r\n\u001b[?2004l\r\u001b[?2004h>     msg = d.get('message', '')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     is_malicious = False\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # 1. PowerShell Script block / pipeline execution\r\n\u001b[?2004l\r\u001b[?2004h>     if ev_code in [800, 4103]:\r\n\u001b[?2004l\r\u001b[?2004h>         is_malicious = True\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # 2. Sysmon Network connection for powershell.exe\r\n\u001b[?2004l\r\u001b[?2004h>     elif ev_code == 3 and 'powershell.exe' in image:\r\n\u001b[?2004l\r"]
