[66.912765, "i", "cat << 'EOF' > parse_ws05.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# We'll select all non-noise event codes for WS-05\n# Noise codes: 5156, 5158, 4658, 4656, 4690, 800, 4103\ncur.execute(\"SELECT * FROM events WHERE host='WS-05.corp.example' AND event_code NOT IN (5156, 5158, 4658, 4656, 4690, 800, 4103) ORDER BY timestamp\")\nfor r in cur.fetchall():\n    d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\n    print(f\"{d.get('event_id')} | {d.get('timestamp')} | {d.get('event_code')} | {d.get('user')} | {d.get('image')} | {d.get('command_line')} | {d.get('target_image')} | {d.get('details')} | {str(d.get('message', ''))[:120].replace('\\n', ' ')}\")\nEOF\npython3 parse_ws05.py\n"]
[66.914059, "o", "cat << 'EOF' > parse_ws05.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
