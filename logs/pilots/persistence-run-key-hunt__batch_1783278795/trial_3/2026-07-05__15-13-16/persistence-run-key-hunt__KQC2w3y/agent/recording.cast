[15.751994, "i", "cat << 'EOF' > dump.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events\")\nrows = cur.fetchall()\n\nfor r in rows:\n    d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\n    # Let's see what events have PowerShell messages or details, or uncommon fields\n    if any(kw in str(d).lower() for kw in ['malicious', 'script', 'mimikatz', 'hack', 'bypass', 'cobalt', 'attack', 'powershell', 'download', 'curl', 'wget', 'enc', 'hidden']):\n        print(f\"{d.get('event_id')} | {d.get('event_code')} | {d.get('host')} | {d.get('user')} | {d.get('image')} | {d.get('command_line')} | {d.get('message', '')[:100]}\")\nEOF\npython3 dump.py | head -n 40\n"]
