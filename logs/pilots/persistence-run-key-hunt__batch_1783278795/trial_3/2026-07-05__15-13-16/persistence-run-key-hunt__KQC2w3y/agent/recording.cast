[99.711543, "i", "cat << 'EOF' > check_other_hosts.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT DISTINCT host FROM events\")\nhosts = [r['host'] for r in cur.fetchall()]\n\nfor h in hosts:\n    if h == 'WS-05.corp.example':\n        continue\n    print(f\"=== Checking host {h} ===\")\n    cur.execute(\"SELECT event_id, event_code, image, parent_image, command_line, target_image, message FROM events WHERE host=? ORDER BY timestamp\", (h,))\n    for r in cur.fetchall():\n        d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\n        # Is there any PowerShell, cmd, or other scripting? Or unexpected execution?\n        text = str(d).lower()\n        for kw in ['powershell', 'cmd.exe', 'script', 'bypass', 'psexec', 'wmi', 'schtasks', 'net ', 'net1', 'sc.exe', 'sc ', 'reg ', 'adduser', 'evil']:\n            if kw in text and 'svchost' not in text and 'dns.exe' not in text and 'lsass' not in text and 'adws' not in text and 'wmiprvse' not in text:\n                print(f\"POTENTIAL SUSPICIOUS ON {h}: {d.get('event_id')} | {d.get('event_code')} | {d.get('image')} | {d.get('command_line')} | {str(d.get('message', ''))[:100]}\")\nEOF\npython3 check_other_hosts.py\n"]
[99.711911, "o", "cat << 'EOF' > check_other_hosts.py\r\n\u001b[?2004l\r"]
