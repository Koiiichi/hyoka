[135.365397, "o", "\u001b[?2004hroot@80cfabd02d6f:~# "]
[139.868829, "i", "cat << 'EOF' > parse_registry.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, image, target_object, details FROM events WHERE host='WS-05.corp.example' AND event_code IN (12, 13)\")\nfor r in cur.fetchall():\n    d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\n    print(f\"{d.get('event_id')} | {d.get('event_code')} | {d.get('image')} | {d.get('target_object')} | {str(d.get('details'))[:100]}\")\nEOF\npython3 parse_registry.py\n"]
[139.869187, "o", "cat << 'EOF' > parse_registry.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
