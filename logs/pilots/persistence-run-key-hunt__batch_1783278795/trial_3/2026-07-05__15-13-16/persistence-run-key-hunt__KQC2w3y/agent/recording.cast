[83.645579, "o", "\u001b[?2004hroot@80cfabd02d6f:~# "]
[92.041619, "i", "cat << 'EOF' > test_flagging.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Get all events on WS-05\ncur.execute(\"SELECT * FROM events WHERE host='WS-05.corp.example'\")\nrows = cur.fetchall()\n\nmalicious_ids = []\nfor r in rows:\n    d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\n    ev_id = d.get('event_id')\n    ev_code = d.get('event_code')\n    image = d.get('image', '')\n    \n    # PowerShell scripts\n    if ev_code in [800, 4103]:\n        malicious_ids.append(ev_id)\n        continue\n    \n    # Powershell registry modifications\n    if ev_code in [12, 13] and 'powershell.exe' in image:\n        malicious_ids.append(ev_id)\n        continue\n        \n    # Powershell network connections\n    if ev_code == 3 and 'powershell.exe' in image:\n        malicious_ids.append(ev_id)\n        continue\n\n# Let's count how many we found and check if we missed any other non-noise events on WS-05\nprint(f\"Total malicious events found: {len(malicious_ids)}\")\nprint(f\"Malicious IDs: {malicious_ids}\")\n\n# Let's see non-malicious events on WS-05 to double check\nprint(\"=== BENIGN WS-05 EVENTS ===\")\nfor r in rows:\n    d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\n    ev_id = d.get('event_id')\n    if ev_id not in malicious_ids:\n        # Skip highly noisy event codes to see if there's anything else\n        if d.get('event_code') not in [5156, 5158, 4658, 4656, 4690]:\n            print(f\"{ev_id} | {d.get('event_code')} | {d.get('image')} | {d.get('target_image')} | {str(d.get('message', ''))[:100].replace('\\n', ' ')}\")\nEOF\npython3 test_flagging.py\n"]
[92.041897, "o", "cat << 'EOF' > test_flagging.py\r\n\u001b[?2004l\r"]
