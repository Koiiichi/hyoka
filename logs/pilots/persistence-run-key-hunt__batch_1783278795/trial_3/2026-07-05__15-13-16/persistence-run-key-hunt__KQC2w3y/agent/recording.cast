[77.163026, "i", "cat << 'EOF' > parse_dc01_complete.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host='DC01.corp.example' AND event_code NOT IN (5156, 5158) ORDER BY timestamp\")\nfor r in cur.fetchall():\n    d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\n    print(f\"{d.get('event_id')} | {d.get('timestamp')} | {d.get('event_code')} | {d.get('user')} | {d.get('image')} | {d.get('command_line')} | {d.get('target_image')} | {d.get('service_name')} | {str(d.get('message', ''))[:150].replace('\\n', ' ')}\")\nEOF\npython3 parse_dc01_complete.py > dc01_non_wfp.txt\ncat dc01_non_wfp.txt\n"]
