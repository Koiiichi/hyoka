[33.572023, "i", "cat << 'EOF' > get_timeline.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events ORDER BY timestamp\")\nrows = cur.fetchall()\n\n# Let's inspect host WS-05 first since we saw malicious PowerShell there\nfor r in rows:\n    d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}\n    # Skip noise if possible, but first let's see what hosts we have.\n    host = d.get('host', '')\n    ev_code = d.get('event_code')\n    msg = d.get('message', '')\n    \n    # Print events with detailed process, registry, network or service information\n    # Let's list everything chronologically for WS-05\n    if host == 'WS-05.corp.example':\n        # Filter some very noisy event codes first to make it readable\n        # Event codes like 5156/5158 are Windows Filtering Platform connections. They can be noisy but let's check non-5156/5158 first.\n        if ev_code not in [5156, 5158, 4658, 4656, 4690]: \n            print(f\"{d.get('event_id')} | {d.get('timestamp')} | {ev_code} | {d.get('user')} | {d.get('image')} | {d.get('command_line')} | {d.get('target_image')} | {msg[:120].replace('\\n', ' ')}\")\n\nEOF\npython3 get_timeline.py > ws05_events.txt\nhead -n 50 ws05_events.txt\n"]
