[152.568115, "i", "cat << 'EOF' > parse_wfp.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (5156, 5158)\")\nfor r in cur.fetchall():\n    msg = r['message']\n    if 'powershell' in msg.lower() or '10.10.10.5' in msg:\n        print(f\"{r['event_id']} | {r['event_code']}\")\nEOF\npython3 parse_wfp.py\n"]
[152.568398, "o", "cat << 'EOF' > parse_wfp.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
