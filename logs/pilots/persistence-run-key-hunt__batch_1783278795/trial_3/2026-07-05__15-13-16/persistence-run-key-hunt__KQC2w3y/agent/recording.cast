[130.876148, "i", "cat << 'EOF' > parse_all_handles.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, message FROM events WHERE host='WS-05.corp.example' AND event_code IN (4656, 4658, 4690)\")\nps_count = 0\nother_count = 0\nfor r in cur.fetchall():\n    msg = r['message']\n    if 'powershell' in msg.lower() or '0x2374' in msg.lower():\n        ps_count += 1\n    else:\n        other_count += 1\n        print(f\"OTHER PROCESS HANDLE EVENT: {r['event_id']} | {r['event_code']} | {msg[:120].replace('\\n', ' ')}\")\nprint(f\"PowerShell handle events: {ps_count}, Other handle events: {other_count}\")\nEOF\npython3 parse_all_handles.py\n"]
