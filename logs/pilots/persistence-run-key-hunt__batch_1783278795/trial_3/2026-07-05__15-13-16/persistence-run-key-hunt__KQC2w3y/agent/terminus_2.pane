[?2004hroot@80cfabd02d6f:~# cat << 'EOF' > parse_ws05.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # We'll select all non-noise event codes for WS-05
[?2004l[?2004h> # Noise codes: 5156, 5158, 4658, 4656, 4690, 800, 4103
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE host='WS-05.corp.example' AND event_code NOT IN (5156, 5158, 4658, 4656, 4690, 800, 4103) ORDER BY timestamp")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != ''}
[?2004l[?2004h>     print(f"{d.get('event_id')} | {d.get('timestamp')} | {d.get('event_code')} | {d.get('user')} | {d.get('image')} | {d.get('command_line')} | {d.get('target_image')} | {d.get('details')} | {str(d.get('message', ''))[:120].replace('\n', ' ')}")
[?2004l[?2004h> EOF
