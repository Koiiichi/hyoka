[?2004l[?2004h>     ev_id = d.get('event_id')
[?2004l[?2004h>     ev_code = d.get('event_code')
[?2004l[?2004h>     image = d.get('image', '')
[?2004l[?2004h>     msg = d.get('message', '')
[?2004l[?2004h>     
[?2004l[?2004h>     is_malicious = False
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. PowerShell Script block / pipeline execution
[?2004l[?2004h>     if ev_code in [800, 4103]:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 2. Sysmon Network connection for powershell.exe
[?2004l[?2004h>     elif ev_code == 3 and 'powershell.exe' in image:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Sysmon Registry events for powershell.exe
[?2004l[?2004h>     elif ev_code in [12, 13] and 'powershell.exe' in image:
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 4. Security Handle events for powershell.exe
[?2004l[?2004h>     elif ev_code in [4656, 4658, 4690] and ('powershell' in msg.lower() or '0x2374' in msg.lower() or '9076' in msg.lower()):
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 5. Security Object access for powershell.exe
[?2004l[?2004h>     elif ev_code == 4663 and ('powershell' in msg.lower() or '0x2374' in msg.lower() or '9076' in msg.lower()):
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 6. WFP events for powershell.exe
[?2004l[?2004h>     elif ev_code in [5156, 5158] and ('powershell' in msg.lower() or '10.10.10.5' in msg or '9076' in msg.lower()):
[?2004l[?2004h>         is_malicious = True
[?2004l[?2004h>         
[?2004l[?2004h>     if is_malicious:
[?2004l[?2004h>         malicious.append(d)
[?2004l[?2004h>     else:
[?2004l[?2004h>         benign.append(d)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Malicious count: {len(malicious)}")
[?2004l[?2004h> print(f"Benign count: {len(benign)}")
[?2004l[?2004h> 
[?2004l[?2004h> print("=== BENIGN EVENTS ===")
[?2004l[?2004h> for d in benign:
[?2004l[?2004h>     # Skip highly noisy event codes to keep output readable
[?2004l[?2004h>     if d.get('event_code') not in [5156, 5158, 4658, 4656, 4690]:
