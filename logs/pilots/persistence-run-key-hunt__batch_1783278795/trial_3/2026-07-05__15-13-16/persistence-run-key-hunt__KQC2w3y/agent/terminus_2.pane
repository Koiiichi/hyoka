[?2004l[?2004h> 
[?2004l[?2004h> # We'll fetch all events from WS-05
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE host='WS-05.corp.example'")
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
