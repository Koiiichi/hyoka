[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Get all events on WS-05
[?2004l[?2004h> cur.execute("SELECT * FROM events WHERE host='WS-05.corp.example'")
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> malicious_ids = []
[?2004l[?2004h> for r in rows:
