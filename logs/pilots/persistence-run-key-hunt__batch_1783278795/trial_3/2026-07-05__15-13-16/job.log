Sending keys: ['cat << \'EOF\' > generate_final_list.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# We\'ll fetch all events from WS-05\ncur.execute("SELECT * FROM events WHERE host=\'WS-05.corp.example\'")\nrows = cur.fetchall()\n\nmalicious = []\nbenign = []\n\nfor r in rows:\n    d = {k: r[k] for k in r.keys() if r[k] is not None and r[k] != \'\'}\n    ev_id = d.get(\'event_id\')\n    ev_code = d.get(\'event_code\')\n    image = d.get(\'image\', \'\')\n    msg = d.get(\'message\', \'\')\n    \n    is_malicious = False\n    \n    # 1. PowerShell Script block / pipeline execution\n    if ev_code in [800, 4103]:\n        is_malicious = True\n        \n    # 2. Sysmon Network connection for powershell.exe\n    elif ev_code == 3 and \'powershell.exe\' in image:\n        is_malicious = True\n        \n    # 3. Sysmon Registry events for powershell.exe\n    elif ev_code in [12, 13] and \'powershell.exe\' in image:\n        is_malicious = True\n        \n    # 4. Security Handle events for powershell.exe\n    elif ev_code in [4656, 4658, 4690] and (\'powershell\' in msg.lower() or \'0x2374\' in msg.lower() or \'9076\' in msg.lower()):\n        is_malicious = True\n        \n    # 5. Security Object access for powershell.exe\n    elif ev_code == 4663 and (\'powershell\' in msg.lower() or \'0x2374\' in msg.lower() or \'9076\' in msg.lower()):\n        is_malicious = True\n        \n    # 6. WFP events for powershell.exe\n    elif ev_code in [5156, 5158] and (\'powershell\' in msg.lower() or \'10.10.10.5\' in msg or \'9076\' in msg.lower()):\n        is_malicious = True\n        \n    if is_malicious:\n        malicious.append(d)\n    else:\n        benign.append(d)\n\nprint(f"Malicious count: {len(malicious)}")\nprint(f"Benign count: {len(benign)}")\n\nprint("=== BENIGN EVENTS ===")\nfor d in benign:\n    # Skip highly noisy event codes to keep output readable\n    if d.get(\'event_code\') not in [5156, 5158, 4658, 4656, 4690]:\n        print(f"{d.get(\'event_id\')} | {d.get(\'event_code\')} | {d.get(\'image\')} | {d.get(\'target_image\')} | {str(d.get(\'message\', \'\'))[:100].replace(\'\\n\', \' \')}")\nEOF\npython3 generate_final_list.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
