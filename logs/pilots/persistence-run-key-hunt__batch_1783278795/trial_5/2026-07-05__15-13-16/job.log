Sending keys: ['cat << \'EOF\' > analyze.py\nimport sqlite3\nimport base64\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ndef decode_b64(text):\n    for m in re.finditer(r\'-enc\\s+([A-Za-z0-9+/=]+)\', text, re.I):\n        encoded = m.group(1)\n        try:\n            decoded = base64.b64decode(encoded).decode(\'utf-16le\', errors=\'ignore\')\n            return decoded\n        except Exception as e:\n            try:\n                decoded = base64.b64decode(encoded).decode(\'utf-8\', errors=\'ignore\')\n                return decoded\n            except:\n                pass\n    return None\n\n# Let\'s print unique host applications / command lines from PowerShell events\ncur.execute("SELECT DISTINCT event_id, event_code, host, message FROM events WHERE event_code IN (800, 4103) ORDER BY timestamp")\nprint("=== POWERSHELL EVENTS ===")\nfor r in cur.fetchall():\n    msg = r[\'message\']\n    # Search for HostApplication\n    ha_match = re.search(r\'HostApplication=([^\\r\\n]+)\', msg)\n    if ha_match:\n        ha = ha_match.group(1)\n        decoded = decode_b64(ha)\n        print(f"{r[\'event_id\']} | {r[\'event_code\']} | {r[\'host\']} | HA: {ha[:100]}")\n        if decoded:\n            print(f"  DECODED: {decoded}")\n    else:\n        # Check if there\'s any mention of start-sleep, encoded, or anything else\n        cmd_line_match = re.search(r\'command line:?\\s*([^\\r\\n]+)\', msg, re.I)\n        if cmd_line_match:\n            print(f"{r[\'event_id\']} | {r[\'event_code\']} | {r[\'host\']} | CMD: {cmd_line_match.group(1)}")\n\nEOF\npython3 analyze.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
