Sending keys: ['cat << \'EOF\' > analyze2.py\nimport sqlite3\nimport base64\nimport re\n\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ndef decode_b64(text):\n    m = re.search(r\'-enc\\s+([A-Za-z0-9+/=]+)\', text, re.I)\n    if m:\n        encoded = m.group(1)\n        encoded += "=" * ((4 - len(encoded) % 4) % 4)\n        try:\n            return base64.b64decode(encoded).decode(\'utf-16le\', errors=\'ignore\')\n        except:\n            try:\n                return base64.b64decode(encoded).decode(\'utf-8\', errors=\'ignore\')\n            except:\n                pass\n    return None\n\n# Let\'s find distinct HostApplications and decode them\ncur.execute("SELECT DISTINCT host, message FROM events WHERE event_code IN (800, 4103) ORDER BY timestamp")\nseen = set()\nfor r in cur.fetchall():\n    msg = r[\'message\']\n    ha_match = re.search(r\'HostApplication=([^\\r\\n]+)\', msg)\n    if ha_match:\n        ha = ha_match.group(1)\n        decoded = decode_b64(ha)\n        if decoded and decoded not in seen:\n            seen.add(decoded)\n            print(f"Host: {r[\'host\']}")\n            print(f"Decoded:\\n{decoded}\\n")\n            print("="*80)\n\nEOF\npython3 analyze2.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
