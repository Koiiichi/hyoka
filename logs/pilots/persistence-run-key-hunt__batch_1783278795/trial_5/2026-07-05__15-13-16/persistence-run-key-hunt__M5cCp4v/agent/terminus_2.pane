[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> malicious_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Sysmon events directly associated with the PowerShell stager process GUID
[?2004l[?2004h> cur.execute("SELECT event_id FROM events WHERE process_guid = '{b59756a9-b239-5f17-5307-000000000400}'")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     malicious_ids.add(r['event_id'])
[?2004l[?2004h> 
[?2004l[?2004h> # 2. PowerShell events (800 and 4103) - we verified all 135 are malicious
[?2004l[?2004h> cur.execute("SELECT event_id FROM events WHERE event_code IN (800, 4103)")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     malicious_ids.add(r['event_id'])
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Object Access registry auditing events on WS-05
[?2004l[?2004h> # We've shown all of these on WS-05 are related to process 9076 (powershell) accessing the Run key
[?2004l[?2004h> cur.execute("SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690)")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     malicious_ids.add(r['event_id'])
[?2004l[?2004h> 
[?2004l[?2004h> # 4. WFP connection/bind events on WS-05 where the app is powershell.exe
[?2004l[?2004h> cur.execute("SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158) AND message LIKE '%powershell.exe%'")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     malicious_ids.add(r['event_id'])
[?2004l[?2004h> 
[?2004l[?2004h> print("Total identified malicious events:", len(malicious_ids))
[?2004l[?2004h> print("List of IDs (sorted):", sorted(list(malicious_ids))[:50], "...")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's write the JSON list of these IDs to /root/findings.json
[?2004l[?2004h> with open('/root/findings.json', 'w') as f:
[?2004l[?2004h>     json.dump(sorted(list(malicious_ids)), f)
[?2004l[?2004h> 
