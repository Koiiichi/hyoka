[82.024839, "o", "\u001b[?2004h>     # if there is an IP or other details, let's extract them from the message\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.024863, "o", "> "]
[82.024942, "o", "    msg = r['message']\r\n\u001b[?2004l\r\u001b[?2004h>     if msg:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.025053, "o", "        # let's look for Logon Type, Workstation Name, Source Network Address\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.025222, "o", "        wt = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         src_addr = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.025393, "o", "        for line in msg.split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h>             if \"Logon Type:\" in line:\r\n\u001b[?2004l\r"]
[82.025415, "o", "\u001b[?2004h> "]
[82.025565, "o", "                wt = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>             if \"Source Network Address:\" in line:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.025754, "o", "                src_addr = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if wt or src_addr:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"  {wt} | {src_addr}\")\r\n\u001b[?2004l\r"]
