[57.084892, "i", "cat << 'EOF' > ws06.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host = 'WS-06.corp.example' ORDER BY timestamp\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {r['image']} | {r['target_image']} | {r['user']} | {r['src_ip']} | {r['dst_ip']} | {r['dst_port']} | {r['target_object']}\")\n    if r['message']:\n        print(\"  Msg:\", r['message'][:200].replace('\\n', ' '))\nEOF\npython3 ws06.py\n"]
