[26.353327, "o", "for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     msg = r['message']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.353406, "o", "    # Search for HostApplication\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.353636, "o", "    ha_match = re.search(r'HostApplication=([^\\r\\n]+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     if ha_match:\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.353668, "o", "> "]
[26.35376, "o", "        ha = ha_match.group(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.353784, "o", "        decoded = decode_b64(ha)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.354498, "o", "        print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | HA: {ha[:100]}\")\r\n\u001b[?2004l\r\u001b[?2004h>         if decoded:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"  DECODED: {decoded}\")\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         # Check if there's any mention of start-sleep, encoded, or anything else\r\n\u001b[?2004l\r\u001b[?2004h>         cmd_line_match = re.search(r'command line:?\\s*([^\\r\\n]+)', msg, re.I)\r\n\u001b[?2004l\r\u001b[?2004h>         if cmd_line_match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.354718, "o", "            print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | CMD: {cmd_line_match.group(1)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
