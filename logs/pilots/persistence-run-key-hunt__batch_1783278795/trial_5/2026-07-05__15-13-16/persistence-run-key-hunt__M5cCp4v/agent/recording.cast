[41.752785, "i", "cat << 'EOF' > stats.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT host, event_code, COUNT(*) FROM events GROUP BY host, event_code ORDER BY host, event_code\")\nfor r in cur.fetchall():\n    print(f\"{r['host']} | {r['event_code']} | {r['COUNT(*)']}\")\nEOF\npython3 stats.py\n"]
