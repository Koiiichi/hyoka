[82.022852, "i", "cat << 'EOF' > logons.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, host, timestamp, user, target_user, logon_type, src_ip, details, message FROM events WHERE event_code IN (4624, 4625, 4627, 4672) ORDER BY timestamp\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['host']} | {r['event_code']} | {r['timestamp']} | User: {r['user']} | TargetUser: {r['target_user']} | Type: {r['logon_type']} | SrcIP: {r['src_ip']}\")\n    # if there is an IP or other details, let's extract them from the message\n    msg = r['message']\n    if msg:\n        # let's look for Logon Type, Workstation Name, Source Network Address\n        wt = \"\"\n        src_addr = \"\"\n        for line in msg.split('\\n'):\n            if \"Logon Type:\" in line:\n                wt = line.strip()\n            if \"Source Network Address:\" in line:\n                src_addr = line.strip()\n        if wt or src_addr:\n            print(f\"  {wt} | {src_addr}\")\nEOF\npython3 logons.py\n"]
[82.023703, "o", "cat << 'EOF' > logons.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> "]
