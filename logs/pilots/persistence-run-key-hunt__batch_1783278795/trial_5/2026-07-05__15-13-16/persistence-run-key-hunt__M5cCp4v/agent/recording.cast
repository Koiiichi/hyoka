[20.564323, "i", "cat << 'EOF' > analyze.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Look for any events with 4103 or 4104 or 800\nprint(\"=== POWERSHELL EVENTS ===\")\ncur.execute(\"SELECT event_id, event_code, host, message FROM events WHERE event_code IN (800, 4103, 4104) LIMIT 20\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['event_code']} | {r['host']}\")\n    print(r['message'][:500])\n    print(\"-\"*40)\n\nEOF\npython3 analyze.py | head -n 40\n"]
