[89.925425, "i", "cat << 'EOF' > time_slice.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT event_id, event_code, host, timestamp, user, image, target_image, details, target_object FROM events WHERE timestamp BETWEEN '2026-05-06T00:00:11.000Z' AND '2026-05-06T00:00:15.000Z' ORDER BY timestamp\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['host']} | {r['event_code']} | {r['timestamp']} | Image: {r['image']} | Target: {r['target_image']} | TargetObj: {r['target_object']}\")\nEOF\npython3 time_slice.py\n"]
[89.925771, "o", "cat << 'EOF' > time_slice.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h"]
