[254.42494, "i", "cat << 'EOF' > check_object_access.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, target_object, details, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690) \n    ORDER BY timestamp\n\"\"\")\nfor r in cur.fetchall():\n    print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {r['target_object']}\")\n    # if target_object is empty, check if it's in the message\n    msg = r['message']\n    if msg:\n        # Look for Object Name\n        on = \"\"\n        for line in msg.split('\\n'):\n            if \"Object Name:\" in line or \"Object Value Name:\" in line:\n                print(\"  \", line.strip())\nEOF\npython3 check_object_access.py | head -n 40\n"]
