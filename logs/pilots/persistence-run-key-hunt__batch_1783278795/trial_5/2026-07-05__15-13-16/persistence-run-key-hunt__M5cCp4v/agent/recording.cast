[20.577579, "o", "=== POWERSHELL EVENTS ===\r\nevt-00019 | 800 | WS-05.corp.example\r\nPipeline execution details for command line:             Start-Sleep -Seconds $sleepTime;\r\n. \r\r\n\r\r\nContext Information: \r\r\n\tDetailSequence=1\r\r\n\tDetailTotal=1\r\r\n\r\r\n\tSequenceNumber=11254\r\r\n\r\r\n\tUserId=CORP\\pgustavo\r\r\n\tHostName=ConsoleHost\r\r\n\tHostVersion=5.1.18362.752\r\r\n\tHostId=ca33ee8b-7d2f-4343-83bb-33cd9ad23223\r\r\n\tHostApplication=C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -noP -sta -w 1 -enc SQBGACgAJABQAFMAVgBFAHIAcwBJAG8ATgBUAGEAQgBMAGUALgBQAFMAVgBFAFIAUwBJAE8AbgAuAE0AQQBKAG8AUgAgAC0ARwBlACAA\r\n----------------------------------------\r\nevt-00020 | 800 | WS-05.corp.example\r\nPipeline execution details for command line:         $IV=[BitConverter]::GetBytes($(Get-Random));\r\n. \r\r\n\r\r\nContext Information: \r\r\n\tDetailSequence=1\r\r\n\tDetailTotal=1\r\r\n\r\r\n\tSequenceNumber=11256\r\r\n\r\r\n\tUserId=CORP\\pgustavo\r\r\n\tHostName=ConsoleHost\r\r\n\tHostVersion=5.1.18362.752\r\r\n\tHostId=ca33ee8b-7d2f-4343-83bb-33cd9ad23223\r\r\n\tHostApplication=C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -noP -sta -w 1 -enc SQBGACgAJABQAFMAVgBFAHIAcwBJAG8ATgBUAGEAQgBMAGUALgBQAFMAVgBFAFIAUwBJAE8AbgAuAE0AQQBKAG8AUgAgAC0A\r\n----------------------------------------\r\nevt-00021 | 4103 | WS-05.corp.example\r\nCommandInvocation(Start-Sleep): \"Start-Sleep\"\r\r\nParameterBinding(Start-Sleep): name=\"Seconds\"; value=\"5\"\r\r\n\r\r\n\r\r\nContext:\r\r\n        Severity = Informational\r\r\n"]
[20.579819, "o", "\u001b[?2004hroot@a4a20dd869c0:~# "]
[26.350919, "i", "cat << 'EOF' > analyze.py\nimport sqlite3\nimport base64\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ndef decode_b64(text):\n    for m in re.finditer(r'-enc\\s+([A-Za-z0-9+/=]+)', text, re.I):\n        encoded = m.group(1)\n        try:\n            decoded = base64.b64decode(encoded).decode('utf-16le', errors='ignore')\n            return decoded\n        except Exception as e:\n            try:\n                decoded = base64.b64decode(encoded).decode('utf-8', errors='ignore')\n                return decoded\n            except:\n                pass\n    return None\n\n# Let's print unique host applications / command lines from PowerShell events\ncur.execute(\"SELECT DISTINCT event_id, event_code, host, message FROM events WHERE event_code IN (800, 4103) ORDER BY timestamp\")\nprint(\"=== POWERSHELL EVENTS ===\")\nfor r in cur.fetchall():\n    msg = r['message']\n    # Search for HostApplication\n    ha_match = re.search(r'HostApplication=([^\\r\\n]+)', msg)\n    if ha_match:\n        ha = ha_match.group(1)\n        decoded = decode_b64(ha)\n        print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | HA: {ha[:100]}\")\n        if decoded:\n            print(f\"  DECODED: {decoded}\")\n    else:\n        # Check if there's any mention of start-sleep, encoded, or anything else\n        cmd_line_match = re.search(r'command line:?\\s*([^\\r\\n]+)', msg, re.I)\n        if cmd_line_match:\n            print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | CMD: {cmd_line_match.group(1)}\")\n\nEOF\npython3 analyze.py\n"]
