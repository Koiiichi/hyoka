[276.984599, "o", "\u001b[?2004hroot@a4a20dd869c0:~# "]
[294.20858, "i", "cat << 'EOF' > collect_malicious.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nmalicious_ids = set()\n\n# 1. Sysmon events directly associated with the PowerShell stager process GUID\ncur.execute(\"SELECT event_id FROM events WHERE process_guid = '{b59756a9-b239-5f17-5307-000000000400}'\")\nfor r in cur.fetchall():\n    malicious_ids.add(r['event_id'])\n\n# 2. PowerShell events (800 and 4103) - we verified all 135 are malicious\ncur.execute(\"SELECT event_id FROM events WHERE event_code IN (800, 4103)\")\nfor r in cur.fetchall():\n    malicious_ids.add(r['event_id'])\n\n# 3. Object Access registry auditing events on WS-05\n# We've shown all of these on WS-05 are related to process 9076 (powershell) accessing the Run key\ncur.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690)\")\nfor r in cur.fetchall():\n    malicious_ids.add(r['event_id'])\n\n# 4. WFP connection/bind events on WS-05 where the app is powershell.exe\ncur.execute(\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158) AND message LIKE '%powershell.exe%'\")\nfor r in cur.fetchall():\n    malicious_ids.add(r['event_id'])\n\nprint(\"Total identified malicious events:\", len(malicious_ids))\nprint(\"List of IDs (sorted):\", sorted(list(malicious_ids))[:50], \"...\")\n\n# Let's write the JSON list of these IDs to /root/findings.json\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(malicious_ids)), f)\n\nprint(\"Written findings to /root/findings.json\")\nEOF\npython3 collect_malicious.py\n"]
[294.208959, "o", "cat << 'EOF' > collect_malicious.py\r\n\u001b[?2004l\r"]
