[259.848986, "o", "\u001b[?2004hroot@a4a20dd869c0:~# "]
[267.374157, "i", "cat << 'EOF' > check_wfp.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158) \n\"\"\")\nfor r in cur.fetchall():\n    msg = r['message']\n    app_name = \"\"\n    dest_ip = \"\"\n    dest_port = \"\"\n    for line in msg.split('\\n'):\n        if \"Application Name:\" in line:\n            app_name = line.split(':', 1)[1].strip()\n        if \"Destination Address:\" in line:\n            dest_ip = line.split(':', 1)[1].strip()\n        if \"Destination Port:\" in line:\n            dest_port = line.split(':', 1)[1].strip()\n    print(f\"{r['event_id']} | {r['event_code']} | APP: {app_name} | DST: {dest_ip}:{dest_port}\")\nEOF\npython3 check_wfp.py\n"]
[267.37445, "o", "cat << 'EOF' > check_wfp.py\r\n\u001b[?2004l\r"]
