[26.375159, "o", "\u001b[?2004hroot@a4a20dd869c0:~# "]
[32.036107, "i", "cat << 'EOF' > analyze.py\nimport sqlite3\nimport base64\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ndef decode_b64(text):\n    m = re.search(r'-enc\\s+([A-Za-z0-9+/=]+)', text, re.I)\n    if m:\n        encoded = m.group(1)\n        # Pad base64\n        encoded += \"=\" * ((4 - len(encoded) % 4) % 4)\n        try:\n            return base64.b64decode(encoded).decode('utf-16le', errors='ignore')\n        except:\n            try:\n                return base64.b64decode(encoded).decode('utf-8', errors='ignore')\n            except:\n                pass\n    return None\n\ncur.execute(\"SELECT event_id, event_code, host, user, message FROM events WHERE event_code IN (800, 4103) ORDER BY timestamp\")\nfor r in cur.fetchall():\n    msg = r['message']\n    ha_match = re.search(r'HostApplication=([^\\r\\n]+)', msg)\n    if ha_match:\n        ha = ha_match.group(1)\n        decoded = decode_b64(ha)\n        if decoded:\n            print(f\"{r['event_id']} | {r['host']} | Decoded: {decoded[:200]}\")\n            break # Just need to see one\nEOF\npython3 analyze.py\n"]
[32.036307, "o", "cat << 'EOF' > analyze.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
