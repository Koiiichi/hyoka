[49.215935, "i", "cat << 'EOF' > dump_all.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== WS-05 EVENTS ===\")\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, target_image, command_line, src_ip, dst_ip, dst_port, details, target_object \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code NOT IN (800, 4103, 5156, 5158, 4658, 4656, 4690) \n    ORDER BY timestamp\n\"\"\")\nfor r in cur.fetchall():\n    print(dict(r))\n\nprint(\"\\n=== WS-06 EVENTS ===\")\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, target_image, command_line, src_ip, dst_ip, dst_port, details, target_object \n    FROM events \n    WHERE host = 'WS-06.corp.example' \n    ORDER BY timestamp\n\"\"\")\nfor r in cur.fetchall():\n    print(dict(r))\n\nprint(\"\\n=== DC01 EVENTS ===\")\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, target_user, image, command_line, src_ip, dst_ip, dst_port, details, target_object, logon_type, service_name, service_file_name\n    FROM events \n    WHERE host = 'DC01.corp.example' AND event_code NOT IN (5156, 5158) \n    ORDER BY timestamp\n\"\"\")\nfor r in cur.fetchall():\n    print(dict(r))\nEOF\npython3 dump_all.py > all_events_summary.txt\nhead -n 100 all_events_summary.txt\n"]
