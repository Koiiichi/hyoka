[259.833432, "i", "cat << 'EOF' > check_object_access2.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4690) \n\"\"\")\nfor r in cur.fetchall():\n    msg = r['message']\n    obj_name = \"\"\n    proc_id = \"\"\n    for line in msg.split('\\n'):\n        if \"Object Name:\" in line:\n            obj_name = line.split(':', 1)[1].strip()\n        if \"Process ID:\" in line:\n            proc_id = line.split(':', 1)[1].strip()\n    print(f\"{r['event_id']} | {r['event_code']} | PID: {proc_id} | OBJ: {obj_name}\")\nEOF\npython3 check_object_access2.py\n"]
[259.833785, "o", "cat << 'EOF' > check_object_access2.py\r\n\u001b[?2004l\r"]
