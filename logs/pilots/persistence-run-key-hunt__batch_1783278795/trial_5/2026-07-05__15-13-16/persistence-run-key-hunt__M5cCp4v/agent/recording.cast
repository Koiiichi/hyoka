[70.086406, "o", "\u001b[?2004hroot@a4a20dd869c0:~# "]
[75.697266, "i", "cat << 'EOF' > network_analysis.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT DISTINCT host, event_code, image, user, src_ip, dst_ip, dst_port FROM events WHERE event_code IN (3, 5156, 5158) ORDER BY timestamp\")\nfor r in cur.fetchall():\n    # If dst_ip is a local broadcast, loopback, or local network, maybe skip or keep but summarize\n    dst = r['dst_ip']\n    src = r['src_ip']\n    if dst:\n        # let's print everything first to see\n        print(f\"{r['host']} | {r['event_code']} | {r['image']} | {r['user']} | {src} -> {dst}:{r['dst_port']}\")\nEOF\npython3 network_analysis.py | grep -v -E \"127.0.0.1|::1|172.18.38.5|172.18.38.6|239.255.255.250\"\n"]
[75.697528, "o", "cat << 'EOF' > network_analysis.py\r\n\u001b[?2004l\r\u001b[?2004h"]
