[163.493097, "i", "cat << 'EOF' > extract_and_decode.py\nimport sqlite3\nimport base64\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT details FROM events WHERE event_id = 'evt-00286'\")\nr = cur.fetchone()\ndetails = r['details']\nprint(\"Raw details length:\", len(details))\n\n# Strip spaces or non-b64 chars just in case\nb64_str = re.sub(r'[^A-Za-z0-9+/=]', '', details)\nb64_str += \"=\" * ((4 - len(b64_str) % 4) % 4)\n\ntry:\n    decoded = base64.b64decode(b64_str).decode('utf-16le', errors='ignore')\n    print(\"Decoded Stager:\")\n    print(decoded)\nexcept Exception as e:\n    print(\"Error:\", e)\nEOF\npython3 extract_and_decode.py\n"]
