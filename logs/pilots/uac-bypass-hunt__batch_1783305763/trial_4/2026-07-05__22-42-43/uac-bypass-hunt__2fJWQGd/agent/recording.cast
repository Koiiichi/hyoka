[221.139954, "o", "Detected process PIDs of interest:\r\n0x1a24: \"C:\\windows\\system32\\whoami.exe\" /groups\r\n0xe40: \"C:\\windows\\system32\\whoami.exe\" /groups\r\n0x1468: \"C:\\windows\\system32\\fodhelper.exe\" \r\n0x1134: C:\\windows\\system32\\svchost.exe -k netsvcs -p -s Appinfo\r\n0x17e0: consent.exe 4404 324 000001C45DE25F30\r\n0x1b6c: \"C:\\windows\\system32\\fodhelper.exe\" \r\n0x1e8c: \"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoP -NonI -W Hidden -c $x=$((gp HKCU:So\r\n0x1350: \\??\\C:\\windows\\system32\\conhost.exe 0xffffffff -ForceV1\r\n0xf60: \"C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoP -NonI -W Hidden -enc SQBGACgAJABQAF\r\n0xc14: C:\\windows\\system32\\wbem\\wmiprvse.exe -secured -Embedding\r\n0x1a10: \"LogonUI.exe\" /flags:0x0 /state0:0xa3dcc055 /state1:0x41c64e6d\r\n0x1918: C:\\windows\\system32\\TSTheme.exe -Embedding\r\n0x1dd0: C:\\windows\\system32\\svchost.exe -k appmodel -p -s camsvc\r\n0xeb4: C:\\windows\\system32\\dxgiadaptercache.exe\r\n0x14b0: taskhostw.exe Install $(Arg0)\r\n0x730: C:\\windows\\servicing\\TrustedInstaller.exe\r\n0x1268: C:\\windows\\winsxs\\amd64_microsoft-windows-servicingstack_31bf3856ad364e35_10.0.18362.1012_none_17198\r\n0x1968: \"C:\\windows\\system32\\whoami.exe\"\r\n"]
[221.140863, "o", "\r\nMatching 4689 (exits) events:\r\n"]
