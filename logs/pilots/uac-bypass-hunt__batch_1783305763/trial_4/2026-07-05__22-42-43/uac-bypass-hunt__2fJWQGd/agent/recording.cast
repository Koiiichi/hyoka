[221.123548, "o", "        import re\r\n\u001b[?2004l\r\u001b[?2004h>         m = re.search(r'Process ID:\\s+(0x[0-9a-fA-F]+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>         if m:\r\n\u001b[?2004l\r\u001b[?2004h>             exit_pid = m.group(1)\r\n\u001b[?2004l\r"]
[221.123567, "o", "\u001b[?2004h> "]
[221.123644, "o", "            # If this exit PID matches any of our malicious processes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.123776, "o", "            # Let's check which ones are malicious. Our known malicious commands:\r\n\u001b[?2004l\r\u001b[?2004h>             is_mal = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.12381, "o", ">             cmd = pids_of_interest.get(exit_pid, '')\r\n\u001b[?2004l\r"]
[221.12391, "o", "\u001b[?2004h> "]
[221.124007, "o", "            for kw in ['whoami', 'fodhelper', 'powershell.exe', 'conhost.exe']:\r\n\u001b[?2004l\r\u001b[?2004h>                 if kw in cmd.lower():\r\n"]
[221.12404, "o", "\u001b[?2004l\r\u001b[?2004h>                     is_mal = True\r\n\u001b[?2004l\r"]
[221.124107, "o", "\u001b[?2004h>             if is_mal:\r\n\u001b[?2004l\r"]
[221.124196, "o", "\u001b[?2004h> "]
[221.124325, "o", "                print(f\"{eid} | Exited PID: {exit_pid} | Cmd: {cmd[:100]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
