[102.329487, "i", "cat << 'EOF' > /tmp/get_malicious_events.py\nimport sqlite3\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\nmalicious_guids = {\n    '{3ddc5665-ecfc-5f51-ea02-000000000500}', # whoami 1\n    '{3ddc5665-ecfc-5f51-eb02-000000000500}', # fodhelper 1\n    '{3ddc5665-ecfd-5f51-ed02-000000000500}', # fodhelper 2 (elevated)\n    '{3ddc5665-ed06-5f51-f102-000000000500}', # powershell 1\n    '{3ddc5665-ed06-5f51-f202-000000000500}', # conhost\n    '{3ddc5665-ed08-5f51-f302-000000000500}', # powershell 2\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'  # whoami 2\n}\n\nmalicious_pids = {7820, 3936, 4404, 324} # Add PIDs we saw, wait consent has different PIDs, let's stick to GUIDs first\n\nall_malicious_events = set()\n\n# Let's search by process_guid, parent_process_guid\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, host, user, image, parent_process_guid, process_guid, command_line, target_object, message \n    FROM events\n\"\"\")\nrows = cur.fetchall()\n\nprint(\"--- Correlated Malicious Events ---\")\nfor r in rows:\n    eid, code, ts, host, user, img, p_guid, guid, cmd, tgt_obj, msg = r\n    is_mal = False\n    \n    # Check GUID matching\n    if guid in malicious_guids or p_guid in malicious_guids:\n        is_mal = True\n        \n    # Check Process ID or other indicators in message (e.g. Sysmon 10, Registry 12/13, File 11)\n    # For Registry, let's check if the TargetObject is ms-settings or Update\n    if tgt_obj and ('ms-settings' in tgt_obj or 'Windows\\\\Update' in tgt_obj):\n        is_mal = True\n        \n    # For Process Access (10), let's parse the message for SourceProcessGUID/TargetProcessGUID\n    if code == 10 and msg:\n        for g in malicious_guids:\n            if g in msg:\n                is_mal = True\n                break\n                \n    # Let's inspect PowerShell script block logging (4104) and Pipeline Execution (4103, 800) events\n    if code in (4104, 4103, 800) and msg:\n        # Since powershell 1 has PID 7820 and powershell 2 has PID 3936, let's see if they appear in the message\n        # Or if the commands like 'fodhelper', 'ms-settings', 'Update', 'whoami /groups' or base64 string appear\n        if any(k in msg for k in ['7820', '3936', 'fodhelper', 'ms-settings', 'Update', 'SQBGACgAJABQAFMAVgBFAFIAUwBJAE8AbgBU']):\n            is_mal = True\n\n    # Check whoami commands explicitly (evt-00305, evt-00351, evt-00501, evt-00526, evt-03850, evt-03882)\n    if eid in ['evt-00305', 'evt-00351', 'evt-00501', 'evt-00526', 'evt-03850', 'evt-03882']:\n        is_mal = True\n        \n    if is_mal:\n        all_malicious_events.add(eid)\n        print(f\"{eid} | Code: {code} | TS: {ts} | Image: {img or ''} | Cmd: {cmd or ''} | Target: {tgt_obj or ''}\")\n\nprint(f\"\\nTotal Malicious Events identified: {len(all_malicious_events)}\")\nprint(sorted(list(all_malicious_events)))\nEOF\npython3 /tmp/get_malicious_events.py > /tmp/malicious_list.txt\ncat /tmp/malicious_list.txt | tail -n 20\n"]
