[162.351483, "i", "cat << 'EOF' > /tmp/hunt_timeframe.py\nimport sqlite3\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, target_object, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND timestamp BETWEEN '2026-05-06T00:00:25.000Z' AND '2026-05-06T00:01:10.000Z'\n    ORDER BY timestamp;\n\"\"\")\nrows = cur.fetchall()\n\nprint(f\"Total events in window: {len(rows)}\")\ncode_counts = {}\nfor r in rows:\n    code = r[1]\n    code_counts[code] = code_counts.get(code, 0) + 1\n\nprint(\"--- Code counts ---\")\nfor k, v in sorted(code_counts.items(), key=lambda x: x[1], reverse=True):\n    print(f\"Event Code {k}: {v}\")\n\n# Let's inspect some other Event Codes, e.g. 17/18, 5156/5158, 4673, etc.\nprint(\"\\n--- Other Event Codes ---\")\nfor r in rows:\n    eid, code, ts, user, img, p_img, cmd, tgt_obj, msg = r\n    if code not in (7, 10, 12, 800, 4103, 5156, 5158, 4658, 4656, 4663, 4690):\n        print(f\"{eid} | Code: {code} | TS: {ts} | User: {user} | Image: {img or ''} | Cmd: {cmd or ''} | Target: {tgt_obj or ''}\")\nEOF\npython3 /tmp/hunt_timeframe.py\n"]
