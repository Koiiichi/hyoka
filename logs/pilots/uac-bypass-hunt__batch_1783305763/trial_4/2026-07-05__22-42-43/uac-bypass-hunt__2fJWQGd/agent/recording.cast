[44.759251, "o", "\u001b[?2004hroot@d2abeb10552e:~# "]
[52.183687, "i", "cat << 'EOF' > /tmp/hunt.py\nimport sqlite3, json\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Let's pull all events from WS-05.corp.example between 00:00:25 and 00:00:35\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, target_user, image, parent_image, command_line, target_object, details, src_ip, dst_ip, dst_port, message\n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND timestamp BETWEEN '2026-05-06T00:00:25.000Z' AND '2026-05-06T00:00:35.000Z'\n    ORDER BY timestamp;\n\"\"\")\nrows = cur.fetchall()\n\nprint(f\"Total events in window: {len(rows)}\")\nfor r in rows:\n    eid, code, ts, user, t_user, img, p_img, cmd, tgt_obj, det, s_ip, d_ip, d_port, msg = r\n    # Filtering down to interesting security / sysmon events\n    # Let's inspect everything first but printed concisely\n    print(f\"{eid} | {code} | {ts} | {user or ''} | {img or ''} | {cmd or ''} | {tgt_obj or ''} | {det or ''} | {d_ip or ''}:{d_port or ''}\")\nEOF\npython3 /tmp/hunt.py > /tmp/window_events.txt\nhead -n 50 /tmp/window_events.txt\n"]
