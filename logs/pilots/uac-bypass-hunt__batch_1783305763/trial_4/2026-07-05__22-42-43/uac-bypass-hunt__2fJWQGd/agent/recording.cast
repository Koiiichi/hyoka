[62.252727, "i", "cat << 'EOF' > /tmp/hunt_detail.py\nimport sqlite3\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Let's inspect Event Code 4104 (Script Block Logging)\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, message \n    FROM events \n    WHERE event_code = 4104 \n    ORDER BY timestamp;\n\"\"\")\nprint(\"--- 4104 Script Block Logging ---\")\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3][:300]}...\")\n\n# Let's see if there are any other network connections (Sysmon 3 or Security 5156) associated with the malicious PowerShell process.\n# Process GUID of the malicious powershell process:\n# We can find the process GUID from events where event_id is evt-01020 or evt-01614\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, host, user, image, parent_image, parent_process_guid, process_guid, command_line\n    FROM events \n    WHERE event_id IN ('evt-01020', 'evt-01614', 'evt-00542', 'evt-00704')\n\"\"\")\nprint(\"\\n--- Key Process Events and GUIDs ---\")\nfor r in cur.fetchall():\n    print(r)\n\nEOF\npython3 /tmp/hunt_detail.py\n"]
