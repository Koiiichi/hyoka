[166.056668, "o", "\u001b[?2004hroot@d2abeb10552e:~# "]
[181.88235, "i", "cat << 'EOF' > /tmp/compile_findings.py\nimport sqlite3, json\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Malicious Process GUIDs\nmal_guids = {\n    '{3ddc5665-ecfc-5f51-ea02-000000000500}', # whoami 1\n    '{3ddc5665-ecfc-5f51-eb02-000000000500}', # fodhelper 1\n    '{3ddc5665-ecfd-5f51-ed02-000000000500}', # fodhelper 2 (elevated)\n    '{3ddc5665-ed06-5f51-f102-000000000500}', # powershell 1\n    '{3ddc5665-ed06-5f51-f202-000000000500}', # conhost\n    '{3ddc5665-ed08-5f51-f302-000000000500}', # powershell 2 (payload)\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'  # whoami 2\n}\n\n# Also let's extract the PIDs of these processes to trace them in Security events (where GUIDs might not exist)\n# powershell 1 PID = 7820\n# powershell 2 PID = 3936\n# whoami 1 PID = 3648 (we can find it)\n# fodhelper 1 PID = 4340\n# fodhelper 2 PID = 224\n# whoami 2 PID = 1111 (we can find it)\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, parent_image, parent_process_guid, process_guid, command_line, target_object, message\n    FROM events\n\"\"\")\nrows = cur.fetchall()\n\nfindings = set()\n\n# 1. Add explicitly malicious process creations we identified\nfindings.update([\n    'evt-00305', 'evt-00351', 'evt-00501', 'evt-00526', # whoami 1\n    'evt-00388', # Registry Update payload set\n    'evt-00401', 'evt-00402', 'evt-00403', 'evt-00404', 'evt-00405', 'evt-00408', # ms-settings hijack\n    'evt-00437', 'evt-00542', 'evt-00704', 'evt-00858', # fodhelper\n    'evt-01020', 'evt-01186', # elevated powershell\n    'evt-01024', 'evt-01199', # conhost\n    'evt-01614', # decoded powershell payload\n    'evt-02454', # C2 connection\n    'evt-02498', 'evt-02499', 'evt-02500', 'evt-02501', 'evt-02502', # registry cleanup\n    'evt-03850', 'evt-03882' # whoami 2\n])\n\n# 2. Let's find any other events (like Sysmon 5 process termination, or pipe, or registry) that match the malicious GUIDs\nfor r in rows:\n    eid, code, ts, user, img, p_img, p_guid, guid, cmd, tgt_obj, msg = r\n    \n    # If the event directly matches process_guid or parent_process_guid\n    if guid in mal_guids or p_guid in mal_guids:\n        # But let's avoid standard DLL loads (code 7) and registry reads/opens (code 12 with no creation/deletion of hijack keys) to avoid noise\n        # Let's filter out Event Code 7 (DLL load) and standard Event Code 12/13/14 unless they are ms-settings or Update\n        if code == 7:\n            continue\n        if code in (12, 13) and not (tgt_obj and ('ms-settings' in tgt_obj or 'Windows\\\\Update' in tgt_obj)):\n            continue\n        # Also avoid code 10 (Process access) as it can be noisy system queries\n        if code == 10:\n            continue\n        findings.add(eid)\n\n    # Check for the specific 4104 events we found\n    if eid in ('evt-01537', 'evt-01896'):\n        findings.add(eid)\n\nprint(f\"Compiled findings count: {len(findings)}\")\nprint(sorted(list(findings)))\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(findings)), f)\nEOF\npython3 /tmp/compile_findings.py\n"]
