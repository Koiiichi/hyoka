[221.143052, "o", "\u001b[?2004hroot@d2abeb10552e:~# "]
[231.760015, "i", "cat << 'EOF' > /tmp/compile_findings.py\nimport sqlite3, json\n\ncon = sqlite3.connect('/root/data/eventlogs.db')\ncur = con.cursor()\n\n# Malicious Process GUIDs\nmal_guids = {\n    '{3ddc5665-ecfc-5f51-ea02-000000000500}', # whoami 1\n    '{3ddc5665-ecfc-5f51-eb02-000000000500}', # fodhelper 1\n    '{3ddc5665-ecfd-5f51-ed02-000000000500}', # fodhelper 2 (elevated)\n    '{3ddc5665-ed06-5f51-f102-000000000500}', # powershell 1\n    '{3ddc5665-ed06-5f51-f202-000000000500}', # conhost\n    '{3ddc5665-ed08-5f51-f302-000000000500}', # powershell 2 (payload)\n    '{3ddc5665-ed2e-5f51-fc02-000000000500}'  # whoami 2\n}\n\ncur.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, parent_image, parent_process_guid, process_guid, command_line, target_object, message\n    FROM events\n\"\"\")\nrows = cur.fetchall()\n\nfindings = set()\n\n# 1. Add explicitly malicious process creations, network, registry, and exit events\nfindings.update([\n    'evt-00305', 'evt-00351', 'evt-00501', 'evt-00526', # whoami 1 process creations\n    'evt-00524', 'evt-00539', # whoami 1 process exits (4689)\n    'evt-00388', # Registry Update payload set\n    'evt-00401', 'evt-00402', 'evt-00403', 'evt-00404', 'evt-00405', 'evt-00408', # ms-settings hijack\n    'evt-00437', 'evt-00542', 'evt-00704', 'evt-00858', # fodhelper process creations\n    'evt-00544', 'evt-01022', # fodhelper process exits (4689)\n    'evt-01020', 'evt-01186', # elevated powershell\n    'evt-01024', 'evt-01199', # conhost\n    'evt-01614', # decoded powershell payload (Security 4688)\n    'evt-02454', # C2 connection (Sysmon 3)\n    'evt-02498', 'evt-02499', 'evt-02500', 'evt-02501', 'evt-02502', # registry cleanup\n    'evt-03850', 'evt-03882', # whoami 2 process creations\n    'evt-03888' # whoami 2 process exit (4689)\n])\n\n# 2. Add other matched events by GUID (Sysmon file, pipe, registry, terminate, dns)\nfor r in rows:\n    eid, code, ts, user, img, p_img, p_guid, guid, cmd, tgt_obj, msg = r\n    \n    if guid in mal_guids or p_guid in mal_guids:\n        # Skip standard DLL loads (code 7) and registry reads/opens (code 12) unless ms-settings/Update to keep precise\n        if code == 7:\n            continue\n        if code in (12, 13) and not (tgt_obj and ('ms-settings' in tgt_obj or 'Windows\\\\Update' in tgt_obj)):\n            continue\n        if code == 10: # Skip Process Access\n            continue\n        findings.add(eid)\n\n    # Check for the specific 4104 events we found\n    if eid in ('evt-01537', 'evt-01896'):\n        findings.add(eid)\n\nprint(f\"Final compiled findings count: {len(findings)}\")\nprint(sorted(list(findings)))\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(findings)), f)\nEOF\npython3 /tmp/compile_findings.py\n"]
