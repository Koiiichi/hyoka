[?2004l[?2004h>     # In Security 4688, Process ID is under "New Process ID: 0x..."
[?2004l[?2004h>     # In Sysmon 1, ProcessId is a standard field but here it might be inside message
[?2004l[?2004h>     if msg:
[?2004l[?2004h>         import re
[?2004l[?2004h>         # Find New Process ID in 4688
[?2004l[?2004h>         m = re.search(r'New Process ID:\s+(0x[0-9a-fA-F]+)', msg)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             pid_hex = m.group(1)
[?2004l[?2004h>             pids_of_interest[pid_hex] = cmd or img
[?2004l[?2004h>         # Find ProcessId in Sysmon 1
[?2004l[?2004h>         m = re.search(r'ProcessId:\s+(\d+)', msg)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             pid_dec = m.group(1)
[?2004l[?2004h>             pid_hex = hex(int(pid_dec))
[?2004l[?2004h>             pids_of_interest[pid_hex] = cmd or img
[?2004l[?2004h> 
[?2004l[?2004h> print("Detected process PIDs of interest:")
[?2004l[?2004h> for k, v in pids_of_interest.items():
[?2004l[?2004h>     print(f"{k}: {v[:100]}")
[?2004l[?2004h> 
[?2004l[?2004h> # Now let's find 4689 events that match these PIDs
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example' AND event_code = 4689
[?2004l[?2004h> """)
[?2004l[?2004h> exit_events = cur.fetchall()
[?2004l[?2004h> print("\nMatching 4689 (exits) events:")
[?2004l[?2004h> for r in exit_events:
[?2004l[?2004h>     eid, msg = r
[?2004l[?2004h>     if msg:
[?2004l[?2004h>         import re
[?2004l[?2004h>         m = re.search(r'Process ID:\s+(0x[0-9a-fA-F]+)', msg)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             exit_pid = m.group(1)
[?2004l[?2004h>             # If this exit PID matches any of our malicious processes
