[?2004hroot@d2abeb10552e:~# cat << 'EOF' > /tmp/hunt_timeframe.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> con = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = con.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, target_object, message
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example' AND timestamp BETWEEN '2026-05-06T00:00:25.000Z' AND '2026-05-06T00:01:10.000Z'
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total events in window: {len(rows)}")
[?2004l[?2004h> code_counts = {}
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     code = r[1]
[?2004l[?2004h>     code_counts[code] = code_counts.get(code, 0) + 1
[?2004l[?2004h> 
[?2004l[?2004h> print("--- Code counts ---")
[?2004l[?2004h> for k, v in sorted(code_counts.items(), key=lambda x: x[1], reverse=True):
[?2004l[?2004h>     print(f"Event Code {k}: {v}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect some other Event Codes, e.g. 17/18, 5156/5158, 4673, etc.
[?2004l[?2004h> print("\n--- Other Event Codes ---")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     eid, code, ts, user, img, p_img, cmd, tgt_obj, msg = r
[?2004l[?2004h>     if code not in (7, 10, 12, 800, 4103, 5156, 5158, 4658, 4656, 4663, 4690):
[?2004l[?2004h>         print(f"{eid} | Code: {code} | TS: {ts} | User: {user} | Image: {img or ''} | Cmd: {cmd or ''} | Target: {tgt_obj or ''}")
[?2004l[?2004h> EOF
