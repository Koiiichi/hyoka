[?2004hroot@d2abeb10552e:~# cat << 'EOF' > /tmp/compile_findings.py
[?2004l[?2004h> import sqlite3, json
[?2004l[?2004h> 
[?2004l[?2004h> con = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = con.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious Process GUIDs
[?2004l[?2004h> mal_guids = {
[?2004l[?2004h>     '{3ddc5665-ecfc-5f51-ea02-000000000500}', # whoami 1
[?2004l[?2004h>     '{3ddc5665-ecfc-5f51-eb02-000000000500}', # fodhelper 1
[?2004l[?2004h>     '{3ddc5665-ecfd-5f51-ed02-000000000500}', # fodhelper 2 (elevated)
[?2004l[?2004h>     '{3ddc5665-ed06-5f51-f102-000000000500}', # powershell 1
[?2004l[?2004h>     '{3ddc5665-ed06-5f51-f202-000000000500}', # conhost
[?2004l[?2004h>     '{3ddc5665-ed08-5f51-f302-000000000500}', # powershell 2 (payload)
[?2004l[?2004h>     '{3ddc5665-ed2e-5f51-fc02-000000000500}'  # whoami 2
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Also let's extract the PIDs of these processes to trace them in Security events (where GUIDs might not exist)
[?2004l[?2004h> # powershell 1 PID = 7820
[?2004l[?2004h> # powershell 2 PID = 3936
[?2004l[?2004h> # whoami 1 PID = 3648 (we can find it)
[?2004l[?2004h> # fodhelper 1 PID = 4340
[?2004l[?2004h> # fodhelper 2 PID = 224
[?2004l[?2004h> # whoami 2 PID = 1111 (we can find it)
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, user, image, parent_image, parent_process_guid, process_guid, command_line, target_object, message
[?2004l[?2004h>     FROM events
[?2004l[?2004h> """)
[?2004l[?2004h> rows = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> findings = set()
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Add explicitly malicious process creations we identified
[?2004l[?2004h> findings.update([
[?2004l[?2004h>     'evt-00305', 'evt-00351', 'evt-00501', 'evt-00526', # whoami 1
[?2004l[?2004h>     'evt-00388', # Registry Update payload set
[?2004l[?2004h>     'evt-00401', 'evt-00402', 'evt-00403', 'evt-00404', 'evt-00405', 'evt-00408', # ms-settings hijack
[?2004l[?2004h>     'evt-00437', 'evt-00542', 'evt-00704', 'evt-00858', # fodhelper
[?2004l[?2004h>     'evt-01020', 'evt-01186', # elevated powershell
[?2004l[?2004h>     'evt-01024', 'evt-01199', # conhost
[?2004l[?2004h>     'evt-01614', # decoded powershell payload
[?2004l[?2004h>     'evt-02454', # C2 connection
[?2004l[?2004h>     'evt-02498', 'evt-02499', 'evt-02500', 'evt-02501', 'evt-02502', # registry cleanup
[?2004l[?2004h>     'evt-03850', 'evt-03882' # whoami 2
[?2004l[?2004h> ])
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Let's find any other events (like Sysmon 5 process termination, or pipe, or registry) that match the malicious GUIDs
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     eid, code, ts, user, img, p_img, p_guid, guid, cmd, tgt_obj, msg = r
[?2004l[?2004h>     
[?2004l[?2004h>     # If the event directly matches process_guid or parent_process_guid
[?2004l[?2004h>     if guid in mal_guids or p_guid in mal_guids:
[?2004l[?2004h>         # But let's avoid standard DLL loads (code 7) and registry reads/opens (code 12 with no creation/deletion of hijack keys) to avoid noise
[?2004l[?2004h>         # Let's filter out Event Code 7 (DLL load) and standard Event Code 12/13/14 unless they are ms-settings or Update
[?2004l[?2004h>         if code == 7:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if code in (12, 13) and not (tgt_obj and ('ms-settings' in tgt_obj or 'Windows\\Update' in tgt_obj)):
[?2004l[?2004h>             continue
[?2004l[?2004h>         # Also avoid code 10 (Process access) as it can be noisy system queries
[?2004l[?2004h>         if code == 10:
[?2004l[?2004h>             continue
[?2004l[?2004h>         findings.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h>     # Check for the specific 4104 events we found
[?2004l[?2004h>     if eid in ('evt-01537', 'evt-01896'):
[?2004l[?2004h>         findings.add(eid)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Compiled findings count: {len(findings)}")
[?2004l[?2004h> print(sorted(list(findings)))
[?2004l[?2004h> with open('/root/findings.json', 'w') as f:
[?2004l[?2004h>     json.dump(sorted(list(findings)), f)
[?2004l[?2004h> EOF
