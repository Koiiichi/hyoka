[?2004hroot@d2abeb10552e:~# cat << 'EOF' > /tmp/hunt_correlate.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> con = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = con.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Malicious Process GUIDs (both from Sysmon 1 / 4688, or Registry/Pipe, etc.)
[?2004l[?2004h> # We will trace recursively.
[?2004l[?2004h> # Let's list all process GUIDs we are certain are malicious:
[?2004l[?2004h> # 1. fodhelper.exe
[?2004l[?2004h> # 2. powershell.exe (both instances)
[?2004l[?2004h> # 3. conhost.exe
[?2004l[?2004h> # 4. whoami.exe
[?2004l[?2004h> 
[?2004l[?2004h> # Let's find all process GUIDs and PIDs of interest on WS-05
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, user, image, parent_image, parent_process_guid, process_guid, command_line
[?2004l[?2004h>     FROM events
[?2004l[?2004h>     WHERE host = 'WS-05.corp.example' AND event_code IN (1, 4688)
[?2004l[?2004h> """)
[?2004l[?2004h> all_procs = cur.fetchall()
[?2004l[?2004h> 
[?2004l[?2004h> malicious_guids = set()
[?2004l[?2004h> malicious_pids = set()
[?2004l[?2004h> 
[?2004l[?2004h> # We define our seed malicious commands or processes:
[?2004l[?2004h> seed_keywords = ['whoami', 'fodhelper', 'powershell.exe', 'conhost.exe']
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect processes launched during our timeframe (from 00:00:25 to 00:01:10)
[?2004l[?2004h> # We'll print them out and classify.
[?2004l[?2004h> print("--- Processes in range ---")
[?2004l[?2004h> for p in all_procs:
[?2004l[?2004h>     eid, code, ts, user, img, p_img, p_guid, guid, cmd = p
[?2004l[?2004h>     if ts >= '2026-05-06T00:00:25.000Z' and ts <= '2026-05-06T00:01:10.000Z':
[?2004l[?2004h>         is_mal = any(k in (cmd or '').lower() or k in (img or '').lower() for k in seed_keywords)
[?2004l[?2004h>         print(f"{eid} | Code: {code} | TS: {ts} | User: {user} | Image: {img} | Cmd: {cmd} | GUID: {guid} | P_GUID: {p_guid} | Malicious? {is_mal}")
[?2004l[?2004h>         if is_mal:
[?2004l[?2004h>             if guid: malicious_guids.add(guid)
[?2004l[?2004h>             # also check parent guid
[?2004l[?2004h>             if p_guid: malicious_guids.add(p_guid)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
