[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> con = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> cur = con.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect Event Code 4104 (Script Block Logging)
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, message 
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE event_code = 4104 
[?2004l[?2004h>     ORDER BY timestamp;
[?2004l[?2004h> """)
[?2004l[?2004h> print("--- 4104 Script Block Logging ---")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     print(f"{r[0]} | {r[1]} | {r[2]} | {r[3][:300]}...")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's see if there are any other network connections (Sysmon 3 or Security 5156) associated with the malicious PowerShell process.
[?2004l[?2004h> # Process GUID of the malicious powershell process:
[?2004l[?2004h> # We can find the process GUID from events where event_id is evt-01020 or evt-01614
[?2004l[?2004h> cur.execute("""
[?2004l[?2004h>     SELECT event_id, event_code, timestamp, host, user, image, parent_image, parent_process_guid, process_guid, command_line
[?2004l[?2004h>     FROM events 
[?2004l[?2004h>     WHERE event_id IN ('evt-01020', 'evt-01614', 'evt-00542', 'evt-00704')
[?2004l[?2004h> """)
[?2004l[?2004h> print("\n--- Key Process Events and GUIDs ---")
[?2004l[?2004h> for r in cur.fetchall():
[?2004l[?2004h>     print(r)
