Sending keys: ['cat << \'EOF\' > /tmp/check_exits.py\nimport sqlite3\n\ncon = sqlite3.connect(\'/root/data/eventlogs.db\')\ncur = con.cursor()\n\n# Malicious PIDs (in hex as they appear in the message, and decimal)\n# powershell 1 = 7820 (0x1e8c)\n# powershell 2 = 3936 (0xf60)\n# whoami 1 = 3648 (0xe40)\n# whoami 2 = 6504 (0x1968)\n# Let\'s find other malicious PIDs from process creation events (event_code 1 or 4688)\ncur.execute("""\n    SELECT event_id, event_code, timestamp, image, command_line, message\n    FROM events\n    WHERE host = \'WS-05.corp.example\' AND event_code IN (1, 4688)\n""")\n\n# Let\'s parse all process creations to get a full map of PIDs\npids_of_interest = {}\nfor r in cur.fetchall():\n    eid, code, ts, img, cmd, msg = r\n    # We want to extract Process ID from msg or cmd\n    # In Security 4688, Process ID is under "New Process ID: 0x..."\n    # In Sysmon 1, ProcessId is a standard field but here it might be inside message\n    if msg:\n        import re\n        # Find New Process ID in 4688\n        m = re.search(r\'New Process ID:\\s+(0x[0-9a-fA-F]+)\', msg)\n        if m:\n            pid_hex = m.group(1)\n            pids_of_interest[pid_hex] = cmd or img\n        # Find ProcessId in Sysmon 1\n        m = re.search(r\'ProcessId:\\s+(\\d+)\', msg)\n        if m:\n            pid_dec = m.group(1)\n            pid_hex = hex(int(pid_dec))\n            pids_of_interest[pid_hex] = cmd or img\n\nprint("Detected process PIDs of interest:")\nfor k, v in pids_of_interest.items():\n    print(f"{k}: {v[:100]}")\n\n# Now let\'s find 4689 events that match these PIDs\ncur.execute("""\n    SELECT event_id, message \n    FROM events \n    WHERE host = \'WS-05.corp.example\' AND event_code = 4689\n""")\nexit_events = cur.fetchall()\nprint("\\nMatching 4689 (exits) events:")\nfor r in exit_events:\n    eid, msg = r\n    if msg:\n        import re\n        m = re.search(r\'Process ID:\\s+(0x[0-9a-fA-F]+)\', msg)\n        if m:\n            exit_pid = m.group(1)\n            # If this exit PID matches any of our malicious processes\n            # Let\'s check which ones are malicious. Our known malicious commands:\n            is_mal = False\n            cmd = pids_of_interest.get(exit_pid, \'\')\n            for kw in [\'whoami\', \'fodhelper\', \'powershell.exe\', \'conhost.exe\']:\n                if kw in cmd.lower():\n                    is_mal = True\n            if is_mal:\n                print(f"{eid} | Exited PID: {exit_pid} | Cmd: {cmd[:100]}")\n\nEOF\npython3 /tmp/check_exits.py\n'] min_timeout_sec: 1.5 max_timeout_sec: 180.0
