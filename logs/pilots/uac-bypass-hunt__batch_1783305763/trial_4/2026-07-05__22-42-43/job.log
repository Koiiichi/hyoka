Sending keys: ['cat << \'EOF\' > /tmp/hunt_correlate.py\nimport sqlite3\n\ncon = sqlite3.connect(\'/root/data/eventlogs.db\')\ncur = con.cursor()\n\n# Malicious Process GUIDs (both from Sysmon 1 / 4688, or Registry/Pipe, etc.)\n# We will trace recursively.\n# Let\'s list all process GUIDs we are certain are malicious:\n# 1. fodhelper.exe\n# 2. powershell.exe (both instances)\n# 3. conhost.exe\n# 4. whoami.exe\n\n# Let\'s find all process GUIDs and PIDs of interest on WS-05\ncur.execute("""\n    SELECT event_id, event_code, timestamp, user, image, parent_image, parent_process_guid, process_guid, command_line\n    FROM events\n    WHERE host = \'WS-05.corp.example\' AND event_code IN (1, 4688)\n""")\nall_procs = cur.fetchall()\n\nmalicious_guids = set()\nmalicious_pids = set()\n\n# We define our seed malicious commands or processes:\nseed_keywords = [\'whoami\', \'fodhelper\', \'powershell.exe\', \'conhost.exe\']\n\n# Let\'s inspect processes launched during our timeframe (from 00:00:25 to 00:01:10)\n# We\'ll print them out and classify.\nprint("--- Processes in range ---")\nfor p in all_procs:\n    eid, code, ts, user, img, p_img, p_guid, guid, cmd = p\n    if ts >= \'2026-05-06T00:00:25.000Z\' and ts <= \'2026-05-06T00:01:10.000Z\':\n        is_mal = any(k in (cmd or \'\').lower() or k in (img or \'\').lower() for k in seed_keywords)\n        print(f"{eid} | Code: {code} | TS: {ts} | User: {user} | Image: {img} | Cmd: {cmd} | GUID: {guid} | P_GUID: {p_guid} | Malicious? {is_mal}")\n        if is_mal:\n            if guid: malicious_guids.add(guid)\n            # also check parent guid\n            if p_guid: malicious_guids.add(p_guid)\n\nEOF\npython3 /tmp/hunt_correlate.py\n'] min_timeout_sec: 1.5 max_timeout_sec: 180.0
