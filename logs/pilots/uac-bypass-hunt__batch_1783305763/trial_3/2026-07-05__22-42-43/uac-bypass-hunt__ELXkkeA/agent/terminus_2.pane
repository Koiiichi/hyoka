[?2004l[?2004h> # We can correlate by process ID or timestamp or image/user
[?2004l[?2004h> # Let's inspect Sysmon 5 and Security 4689
[?2004l[?2004h> cur.execute(\"SELECT e5.event_id, e5.timestamp, e5.image, e4689.event_id, e4689.timestamp FROM events e5 JOIN events e4689 ON e5.host = e4689.host AND abs(strftime('%s', e5.timestamp) - strftime('%s', e4689.timestamp)) <= 5 WHERE e5.event_code = 5 AND e4689.event_code = 4689 AND e5.process_guid IN ('{3ddc5665-ed04-5f51-eb02-000000000500}', '{3ddc5665-ed04-5f51-ec02-000000000500}', '{3ddc5665-ed05-5f51-ed02-000000000500}', '{3ddc5665-ed05-5f51-f002-000000000500}', '{3ddc5665-ed06-5f51-f102-000000000500}', '{3ddc5665-ed06-5f51-f202-000000000500}', '{3ddc5665-ed08-5f51-f302-000000000500}', '{3ddc5665-ed2e-5f51-fc02-000000000500}');\")
