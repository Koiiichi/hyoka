[177.406856, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\nprint('--- DC01 Events (Non-Firewall) ---')\ncur.execute(\\\"SELECT timestamp, event_id, event_code, user, image, parent_image, command_line, target_object, details, message FROM events WHERE host = 'DC01.corp.example' AND event_code NOT IN (5156, 5158, 4703) ORDER BY timestamp;\\\")\nfor r in cur.fetchall():\n    print(r[:8]) # Print first few elements cleanly\n\nprint('--- WS-06 Events (Non-Firewall) ---')\ncur.execute(\\\"SELECT timestamp, event_id, event_code, user, image, parent_image, command_line, target_object, details, message FROM events WHERE host = 'WS-06.corp.example' AND event_code NOT IN (5156, 5158, 4703) ORDER BY timestamp;\\\")\nfor r in cur.fetchall():\n    print(r[:8])\n\"\n"]
