[183.800695, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Get all process GUIDs and their commands on WS-05\ncur.execute(\\\"SELECT process_guid, image, command_line, COUNT(*) FROM events WHERE host = 'WS-05.corp.example' AND process_guid IS NOT NULL AND process_guid != '' GROUP BY process_guid;\\\")\nfor r in cur.fetchall():\n    print(r)\n\"\n"]
