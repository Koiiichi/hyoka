[162.790568, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\nprint('--- DC01 Events ---')\ncur.execute(\\\"SELECT timestamp, event_id, event_code, user, image, parent_image, command_line FROM events WHERE host = 'DC01.corp.example' ORDER BY timestamp;\\\")\nfor r in cur.fetchall():\n    print(r)\n\nprint('--- WS-06 Events ---')\ncur.execute(\\\"SELECT timestamp, event_id, event_code, user, image, parent_image, command_line FROM events WHERE host = 'WS-06.corp.example' ORDER BY timestamp;\\\")\nfor r in cur.fetchall():\n    print(r)\n\"\n"]
