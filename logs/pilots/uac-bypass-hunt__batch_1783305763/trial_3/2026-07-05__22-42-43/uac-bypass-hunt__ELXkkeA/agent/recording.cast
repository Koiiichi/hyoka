[255.430566, "i", "python3 -c \"\nimport sqlite3, re\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\\\"SELECT event_id, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4103, 4104, 800);\\\")\nall_ps = cur.fetchall()\nmatched_host_ids = set()\nfor eid, msg in all_ps:\n    h_id = re.search(r'HostId\\s*=\\s*([a-fA-F0-9-]+)', msg)\n    if h_id:\n        matched_host_ids.add(h_id.group(1))\nprint('HostIds found across all:', len(matched_host_ids), matched_host_ids)\n\"\n"]
