[111.149855, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Find processes related to this intrusion\n# We will start with the known malicious guid: {3ddc5665-e80d-5f51-2501-000000000500}\nmalicious_guids = {'{3ddc5665-e80d-5f51-2501-000000000500}'}\nadded = True\nwhile added:\n    added = False\n    cur.execute(\\\"SELECT process_guid, parent_process_guid FROM events WHERE event_code IN (1, 4688);\\\")\n    for p_guid, p_parent in cur.fetchall():\n        if p_guid and p_parent:\n            if p_parent in malicious_guids and p_guid not in malicious_guids:\n                malicious_guids.add(p_guid)\n                added = True\n            elif p_guid in malicious_guids and p_parent not in malicious_guids:\n                # Also trace backwards if needed (parent)\n                # But typically trace forward is enough\n                pass\n\nprint('Malicious process GUIDs found:', len(malicious_guids))\nfor g in malicious_guids:\n    cur.execute(\\\"SELECT DISTINCT image, command_line FROM events WHERE process_guid = ?;\\\", (g,))\n    print(g, cur.fetchall())\n\"\n"]
