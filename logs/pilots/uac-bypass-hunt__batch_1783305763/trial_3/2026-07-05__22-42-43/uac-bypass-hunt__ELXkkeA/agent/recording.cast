[283.644301, "i", "python3 -c \"\nimport sqlite3, re\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nmalicious_pids = {'0x560', '0x1a24', '0xe40', '0x1468', '0x1b6c', '0x1e8c', '0x1350', '0xf60', '0x1968', '1376', '6692', '3648', '5224', '7020', '7820', '4944', '3936', '6504'}\n\ncur.execute(\\\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND event_code NOT IN (4624, 4634, 4672, 4688, 4689);\\\")\nmatched = []\nunmatched = []\nfor eid, code, msg in cur.fetchall():\n    if any(pid in msg for pid in malicious_pids):\n        matched.append((eid, code))\n    else:\n        unmatched.append((eid, code, msg))\n\nprint('Matched other Security/System events:', len(matched))\nprint('Unmatched other Security/System events count:', len(unmatched))\n# Print a summary of unmatched ones to make sure we didn't miss anything\nfrom collections import Counter\nprint('Unmatched by event_code:', Counter([x[1] for x in unmatched]))\n\"\n"]
