[167.815096, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\nprint('DC01 Process Creations:')\ncur.execute(\\\"SELECT timestamp, event_id, event_code, image, parent_image, command_line FROM events WHERE host = 'DC01.corp.example' AND event_code IN (1, 4688) ORDER BY timestamp;\\\")\nfor r in cur.fetchall():\n    print(r)\n\nprint('WS-06 Process Creations:')\ncur.execute(\\\"SELECT timestamp, event_id, event_code, image, parent_image, command_line FROM events WHERE host = 'WS-06.corp.example' AND event_code IN (1, 4688) ORDER BY timestamp;\\\")\nfor r in cur.fetchall():\n    print(r)\n\"\n"]
