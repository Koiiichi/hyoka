[128.448442, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nmalicious_guids = {'{3ddc5665-e80d-5f51-2501-000000000500}', '{3ddc5665-ed04-5f51-eb02-000000000500}', '{3ddc5665-ed04-5f51-ec02-000000000500}', '{3ddc5665-ed05-5f51-ed02-000000000500}', '{3ddc5665-ed05-5f51-f002-000000000500}', '{3ddc5665-ed06-5f51-f102-000000000500}', '{3ddc5665-ed06-5f51-f202-000000000500}', '{3ddc5665-ed08-5f51-f302-000000000500}', '{3ddc5665-ed2e-5f51-fc02-000000000500}'}\n\n# Count events per event_code that match malicious_guids in process_guid or parent_process_guid\ncur.execute(\\\"SELECT event_code, COUNT(*) FROM events WHERE process_guid IN ({}) OR parent_process_guid IN ({}) GROUP BY event_code;\\\".format(','.join(['?']*len(malicious_guids)), ',\\''.join([''])), list(malicious_guids))\nprint('Matching process_guid directly:')\ncur.execute(\\\"SELECT event_code, COUNT(*) FROM events WHERE process_guid IN ({}) GROUP BY event_code;\\\".format(','.join(['?']*len(malicious_guids))), list(malicious_guids))\nfor r in cur.fetchall():\n    print(r)\n\nprint('Matching parent_process_guid:')\ncur.execute(\\\"SELECT event_code, COUNT(*) FROM events WHERE parent_process_guid IN ({}) GROUP BY event_code;\\\".format(','.join(['?']*len(malicious_guids))), list(malicious_guids))\nfor r in cur.fetchall():\n    print(r)\n\"\n"]
