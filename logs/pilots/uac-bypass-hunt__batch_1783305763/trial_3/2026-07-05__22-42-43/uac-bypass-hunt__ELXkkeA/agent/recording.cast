[291.948901, "i", "python3 -c \"\nimport sqlite3, re\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nmalicious_pids = {'0x560', '0x1a24', '0xe40', '0x1468', '0x1b6c', '0x1e8c', '0x1350', '0xf60', '0x1968', '1376', '6692', '3648', '5224', '7020', '7820', '4944', '3936', '6504'}\n\n# Let's inspect the process names for the unmatched Security events\n# Unmatched Security codes we care about: 4656, 4658, 4663, 4670, 4673, 4690, 4703\ncur.execute(\\\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4656, 4658, 4663, 4670, 4673, 4690, 4703);\\\")\nfor eid, code, msg in cur.fetchall():\n    if not any(pid in msg for pid in malicious_pids):\n        # Extract Process Name if present\n        p_name = re.search(r'Process Name:\\s*(.*)', msg)\n        if p_name:\n            # Let's see if any malicious keywords are in process name\n            p_str = p_name.group(1).lower()\n            if any(k in p_str for k in ['powershell', 'whoami', 'fodhelper', 'conhost']):\n                print(f'Malicious unmatched: {eid} | {code} | {p_str}')\n\"\n"]
