[171.679518, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\\\"SELECT host, event_code, COUNT(*) FROM events WHERE host != 'WS-05.corp.example' GROUP BY host, event_code;\\\")\nfor r in cur.fetchall():\n    print(r)\n\"\n"]
