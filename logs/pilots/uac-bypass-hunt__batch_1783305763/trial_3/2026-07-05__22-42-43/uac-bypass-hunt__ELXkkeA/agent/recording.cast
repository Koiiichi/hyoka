[321.433507, "i", "python3 -c \"\nimport sqlite3, json\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nmalicious_guids = {'{3ddc5665-e80d-5f51-2501-000000000500}', '{3ddc5665-ed04-5f51-eb02-000000000500}', '{3ddc5665-ed04-5f51-ec02-000000000500}', '{3ddc5665-ed05-5f51-ed02-000000000500}', '{3ddc5665-ed05-5f51-f002-000000000500}', '{3ddc5665-ed06-5f51-f102-000000000500}', '{3ddc5665-ed06-5f51-f202-000000000500}', '{3ddc5665-ed08-5f51-f302-000000000500}', '{3ddc5665-ed2e-5f51-fc02-000000000500}'}\n\nmalicious_pids = {'0x560', '0x1a24', '0xe40', '0x1468', '0x1b6c', '0x1e8c', '0x1350', '0xf60', '0x1968', '1376', '6692', '3648', '5224', '7020', '7820', '4944', '3936', '6504'}\n\nflagged_events = set()\n\n# 1. Sysmon process_guid matching on WS-05\ncur.execute(\\\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND (process_guid IN ({}) OR parent_process_guid IN ({}));\\\".format(','.join(['?']*len(malicious_guids)), ','.join(['?']*len(malicious_guids))), list(malicious_guids) + list(malicious_guids))\nfor (eid,) in cur.fetchall():\n    flagged_events.add(eid)\n\n# 2. PowerShell logs on WS-05\ncur.execute(\\\"SELECT event_id FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4103, 4104, 800);\\\")\nfor (eid,) in cur.fetchall():\n    flagged_events.add(eid)\n\n# 3. Security logs by PID matching in message on WS-05\ncur.execute(\\\"SELECT event_id, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4624, 4634, 4672, 4688, 4689, 4656, 4658, 4663, 4670, 4673, 4690, 4703);\\\")\nfor eid, msg in cur.fetchall():\n    if any(pid in msg for pid in malicious_pids):\n        flagged_events.add(eid)\n\nfindings = sorted(list(flagged_events))\nprint('Writing', len(findings), 'malicious event IDs to findings.json')\nwith open('/root/findings.json', 'w') as f:\n    json.dump(findings, f)\n\"\n"]
