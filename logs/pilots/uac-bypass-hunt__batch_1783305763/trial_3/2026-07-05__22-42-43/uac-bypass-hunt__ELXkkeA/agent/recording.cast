[232.314251, "i", "python3 -c \"\nimport sqlite3, re\nconn = sqlite3.connect('/root/data/eventlogs.db')\n# Let's count how many PowerShell events contain our malicious PIDs or commands\ncur = conn.cursor()\ncur.execute(\\\"SELECT event_id, event_code, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4103, 4104, 800);\\\")\nall_ps = cur.fetchall()\nmatched = 0\nfor eid, code, msg in all_ps:\n    # Search for PIDs (1376, 7820, 3936) or commands in msg\n    if any(pid in msg for pid in ['1376', '7820', '3936']) or any(term in msg for term in ['DelegateExecute', 'ms-settings', 'fodhelper', 'whoami', 'Windows\\\\Update']):\n        matched += 1\nprint('Matched PowerShell events:', matched, 'out of', len(all_ps))\n\"\n"]
