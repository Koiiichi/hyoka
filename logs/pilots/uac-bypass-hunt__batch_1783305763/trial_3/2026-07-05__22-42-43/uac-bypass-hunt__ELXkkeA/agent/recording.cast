[247.530872, "i", "python3 -c \"\nimport sqlite3, re\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute(\\\"SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4103, 4104, 800);\\\")\nhost_ids = {}\nfor (msg,) in cur.fetchall():\n    h_id = re.search(r'HostId\\s*=\\s*([a-fA-F0-9-]+)', msg)\n    h_app = re.search(r'HostApplication\\s*=\\s*(.*)', msg)\n    if h_id:\n        id_str = h_id.group(1)\n        app_str = h_app.group(1) if h_app else 'Unknown'\n        host_ids[id_str] = app_str\nfor k, v in host_ids.items():\n    print(f'{k}: {v[:100]}')\n\"\n"]
[247.531884, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3, re\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> cur.execute(\\\"SELECT message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (4103, 4104, 800);\\\")\r\n\u001b[?2004l\r\u001b[?2004h> host_ids = {}\r\n\u001b[?2004l\r\u001b[?2004h> for (msg,) in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     h_id = re.search(r'HostId\\s*=\\s*([a-fA-F0-9-]+)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     h_app = re.search(r'HostApplication\\s*=\\s*(.*)', msg)\r\n\u001b[?2004l\r\u001b[?2004h>     if h_id:\r\n\u001b[?2004l\r\u001b[?2004h>         id_str = h_id.group(1)\r\n\u001b[?2004l\r\u001b[?2004h>         app_str = h_app.group(1) if h_app else 'Unknown'\r\n\u001b[?2004l\r\u001b[?2004h>         host_ids[id_str] = app_str\r\n\u001b[?2004l\r\u001b[?2004h> for k, v in host_ids.items():\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{k}: {v[:100]}')\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
