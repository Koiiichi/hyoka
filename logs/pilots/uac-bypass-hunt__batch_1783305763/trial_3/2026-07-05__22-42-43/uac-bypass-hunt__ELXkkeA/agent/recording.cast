[139.715935, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\n# Map Sysmon 1 to Security 4688\ncur.execute(\\\"SELECT e1.event_id, e4688.event_id FROM events e1 JOIN events e4688 ON e1.host = e4688.host AND e1.command_line = e4688.command_line WHERE e1.event_code = 1 AND e4688.event_code = 4688 AND e1.process_guid IN ('{3ddc5665-ed04-5f51-eb02-000000000500}', '{3ddc5665-ed04-5f51-ec02-000000000500}', '{3ddc5665-ed05-5f51-ed02-000000000500}', '{3ddc5665-ed05-5f51-f002-000000000500}', '{3ddc5665-ed06-5f51-f102-000000000500}', '{3ddc5665-ed06-5f51-f202-000000000500}', '{3ddc5665-ed08-5f51-f302-000000000500}', '{3ddc5665-ed2e-5f51-fc02-000000000500}');\\\")\nfor r in cur.fetchall():\n    print('1-4688 match:', r)\n\n# Map Sysmon 5 to Security 4689\n# We can correlate by process ID or timestamp or image/user\n# Let's inspect Sysmon 5 and Security 4689\ncur.execute(\\\"SELECT e5.event_id, e5.timestamp, e5.image, e4689.event_id, e4689.timestamp FROM events e5 JOIN events e4689 ON e5.host = e4689.host AND abs(strftime('%s', e5.timestamp) - strftime('%s', e4689.timestamp)) <= 5 WHERE e5.event_code = 5 AND e4689.event_code = 4689 AND e5.process_guid IN ('{3ddc5665-ed04-5f51-eb02-000000000500}', '{3ddc5665-ed04-5f51-ec02-000000000500}', '{3ddc5665-ed05-5f51-ed02-000000000500}', '{3ddc5665-ed05-5f51-f002-000000000500}', '{3ddc5665-ed06-5f51-f102-000000000500}', '{3ddc5665-ed06-5f51-f202-000000000500}', '{3ddc5665-ed08-5f51-f302-000000000500}', '{3ddc5665-ed2e-5f51-fc02-000000000500}');\\\")\nfor r in cur.fetchall():\n    print('5-4689 match:', r)\n\"\n"]
