[222.239997, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nmalicious_guids = {'{3ddc5665-e80d-5f51-2501-000000000500}', '{3ddc5665-ed04-5f51-eb02-000000000500}', '{3ddc5665-ed04-5f51-ec02-000000000500}', '{3ddc5665-ed05-5f51-ed02-000000000500}', '{3ddc5665-ed05-5f51-f002-000000000500}', '{3ddc5665-ed06-5f51-f102-000000000500}', '{3ddc5665-ed06-5f51-f202-000000000500}', '{3ddc5665-ed08-5f51-f302-000000000500}', '{3ddc5665-ed2e-5f51-fc02-000000000500}'}\n\n# Let's extract PID from Sysmon events (message column usually has ProcessId)\n# Since some GUIDs don't have event 1 in the database, we can also extract from any event that has a process_guid and message.\nfor guid in malicious_guids:\n    cur.execute(\\\"SELECT message FROM events WHERE process_guid = ? AND message LIKE '%ProcessId:%' LIMIT 1;\\\", (guid,))\n    res = cur.fetchone()\n    if res:\n        import re\n        pid_match = re.search(r'ProcessId:\\s*(\\d+)', res[0])\n        if pid_match:\n            pid = int(pid_match.group(1))\n            print(f'Guid: {guid} | Dec PID: {pid} | Hex PID: {hex(pid)}')\n        else:\n            print(f'Guid: {guid} | No PID found in message: {res[0][:100]}')\n    else:\n        # Let's try parsing process_guid to extract PID if possible, or search for other occurrences\n        cur.execute(\\\"SELECT message FROM events WHERE process_guid = ? LIMIT 5;\\\", (guid,))\n        rows = cur.fetchall()\n        pids = set()\n        for row in rows:\n            import re\n            pid_match = re.search(r'ProcessId:\\s*(\\d+)', row[0])\n            if pid_match:\n                pids.add(int(pid_match.group(1)))\n            pid_match_2 = re.search(r'ProcessID:\\s*(\\d+)', row[0])\n            if pid_match_2:\n                pids.add(int(pid_match_2.group(1)))\n        if pids:\n            for pid in pids:\n                print(f'Guid: {guid} | Dec PID: {pid} | Hex PID: {hex(pid)}')\n        else:\n            print(f'Guid: {guid} | No events with ProcessId found.')\n\"\n"]
