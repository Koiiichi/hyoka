[93.219063, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\n# Let's search for whoami executions\nc.execute('SELECT event_id, timestamp, event_code, host, user, image, parent_image, parent_process_guid, process_guid, command_line FROM events WHERE event_code IN (1, 4688) AND command_line LIKE \\\"%whoami%\\\"')\nwhoamis = c.fetchall()\nfor w in whoamis:\n    print('WHOAMI:', w)\n\"\n"]
