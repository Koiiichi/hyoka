[99.562597, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\n# Let's search for processes with GUIDs:\n# {3ddc5665-e80d-5f51-2501-000000000500} (parent of first whoami)\n# {3ddc5665-ed08-5f51-f302-000000000500} (parent of second whoami)\n\nfor guid in ['{3ddc5665-e80d-5f51-2501-000000000500}', '{3ddc5665-ed08-5f51-f302-000000000500}']:\n    c.execute('SELECT event_id, timestamp, event_code, image, command_line, parent_process_guid, process_guid FROM events WHERE process_guid = ? OR parent_process_guid = ?', (guid, guid))\n    print('GUID:', guid)\n    for r in c.fetchall():\n        print('  ', r)\n\"\n"]
