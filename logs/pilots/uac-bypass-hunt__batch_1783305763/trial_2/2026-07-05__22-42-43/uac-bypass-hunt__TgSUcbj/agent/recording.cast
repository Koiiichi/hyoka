[105.03995, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\nguid = '{3ddc5665-ed08-5f51-f302-000000000500}'\nc.execute('SELECT event_id, timestamp, event_code, target_object, details FROM events WHERE process_guid = ? OR parent_process_guid = ?', (guid, guid))\nfor r in c.fetchall():\n    print(r)\n\"\n"]
