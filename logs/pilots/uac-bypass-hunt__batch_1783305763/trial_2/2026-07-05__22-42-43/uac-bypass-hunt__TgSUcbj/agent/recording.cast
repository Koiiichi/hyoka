[158.159487, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nc = conn.cursor()\n\n# Let's inspect events during the active period with event_codes 11, 22, 17, 18, 5156, 5158\nc.execute('''\n    SELECT event_id, timestamp, event_code, channel, image, target_object, details, message \n    FROM events \n    WHERE host = 'WS-05.corp.example' \n      AND timestamp >= '2026-05-06T00:00:25Z' \n      AND timestamp <= '2026-05-06T00:00:35Z' \n      AND event_code IN (11, 22, 17, 18, 5156, 5158)\n    ORDER BY timestamp\n''')\nfor r in c.fetchall():\n    print(r)\n\"\n"]
[158.159907, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
[158.159994, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> c = conn.cursor()\r\n\u001b[?2004l\r"]
