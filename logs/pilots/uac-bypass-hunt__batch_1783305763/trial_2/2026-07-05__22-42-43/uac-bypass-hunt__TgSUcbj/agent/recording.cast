[158.160717, "o", "# Let's inspect events during the active period with event_codes 11, 22, 17, 18, 5156, 5158\r\n\u001b[?2004l\r\u001b[?2004h> c.execute('''\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT event_id, timestamp, event_code, channel, image, target_object, details, message \r\n\u001b[?2004l\r\u001b[?2004h>     FROM events \r\n\u001b[?2004l\r\u001b[?2004h>     WHERE host = 'WS-05.corp.example' \r\n\u001b[?2004l\r\u001b[?2004h>       AND timestamp >= '2026-05-06T00:00:25Z' \r\n\u001b[?2004l\r\u001b[?2004h>       AND timestamp <= '2026-05-06T00:00:35Z' \r\n\u001b[?2004l\r\u001b[?2004h>       AND event_code IN (11, 22, 17, 18, 5156, 5158)\r\n\u001b[?2004l\r\u001b[?2004h>     ORDER BY timestamp\r\n\u001b[?2004l\r\u001b[?2004h> ''')\r\n\u001b[?2004l\r\u001b[?2004h> for r in c.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     print(r)\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
