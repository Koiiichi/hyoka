[250.812734, "i", "cat << 'EOF' > get_ward_security_events.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, channel, user, target_user, image, command_line, message\n    FROM events\n    WHERE host = 'WS-05.corp.example' AND channel = 'Security' AND (user LIKE '%m.ward%' OR target_user LIKE '%m.ward%')\n    ORDER BY timestamp\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Total Security events with m.ward: {len(rows)}\")\nfor r in rows:\n    print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | user={r['user']} | target_user={r['target_user']} | cmd={r['command_line'] or ''} | msg={str(r['message'] or '')[:100]}\")\nEOF\npython3 get_ward_security_events.py\n"]
[250.812985, "o", "cat << 'EOF' > get_ward_security_events.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r"]
