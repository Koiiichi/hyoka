[25.708159, "i", "cat << 'EOF' > explore.py\nimport sqlite3\nimport json\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\n# Get total count of events\ncursor.execute(\"SELECT COUNT(*) FROM events\")\ntotal = cursor.fetchone()[0]\nprint(f\"Total events: {total}\")\n\n# Group by event_code, host\ncursor.execute(\"SELECT event_code, host, COUNT(*) FROM events GROUP BY event_code, host ORDER BY COUNT(*) DESC\")\nprint(\"Event code by host distribution:\")\nfor row in cursor.fetchall()[:30]:\n    print(row)\n\nEOF\npython3 explore.py\n"]
