[121.508481, "i", "cat << 'EOF' > reconstruct_ps.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's extract command lines from event code 800\ncursor.execute(\"SELECT event_id, timestamp, message FROM events WHERE event_code = 800 ORDER BY timestamp\")\nrows = cursor.fetchall()\nprint(f\"Total 800 events: {len(rows)}\")\nfor r in rows:\n    msg = r['message']\n    # extract the pipeline execution details\n    line = \"\"\n    for l in msg.split('\\n'):\n        if \"Pipeline execution details for command line:\" in l:\n            line = l.replace(\"Pipeline execution details for command line:\", \"\").strip()\n        elif \"Context Information:\" in l:\n            break\n        elif line:\n            line += \" \" + l.strip()\n    if line:\n        print(f\"{r['event_id']} | {r['timestamp']} | {line[:120]}\")\nEOF\npython3 reconstruct_ps.py > ps_commands.txt\nhead -n 60 ps_commands.txt\n"]
[121.508813, "o", "cat << 'EOF' > reconstruct_ps.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
