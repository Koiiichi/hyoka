[37.345444, "o", "\u001b[?2004hroot@6b9c25685d4f:~# "]
[42.82946, "i", "cat << 'EOF' > analyze_powershell.py\nimport sqlite3\nimport re\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Get all command lines containing 'enc' or 'encodedcommand' or containing large base64 strings\ncursor.execute(\"SELECT event_id, timestamp, host, user, command_line, message FROM events WHERE command_line LIKE '%enc%' OR message LIKE '%enc%' OR command_line LIKE '%powershell%' OR message LIKE '%powershell%'\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} powershell related events.\")\n\nfor r in rows[:15]:\n    # Check if there is a base64 encoded payload\n    cmd = r['command_line'] or ''\n    msg = r['message'] or ''\n    # extract base64-like strings\n    combined = cmd + \" \" + msg\n    b64_matches = re.findall(r'[A-Za-z0-9+/]{40,}=*', combined)\n    for match in b64_matches:\n        try:\n            decoded = base64.b64decode(match).decode('utf-16le', errors='ignore')\n            if any(k in decoded.lower() for k in ['http', 'bypass', 'download', 'exec', 'shell', 'admin']):\n                print(f\"Event: {r['event_id']} | Host: {r['host']} | Decoded payload snippet:\")\n                print(decoded[:500])\n                print(\"-\"*40)\n        except Exception as e:\n            pass\nEOF\npython3 analyze_powershell.py\n"]
[42.830634, "o", "cat << 'EOF' > analyze_powershell.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> import base64\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get all command lines containing 'enc' or 'encodedcommand' or containing large base64 strings\r\n\u001b[?2004l\r\u001b[?2004h> "]
