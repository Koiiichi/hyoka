[48.100661, "i", "cat << 'EOF' > analyze_powershell.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Get all event_code 4104 (if any) or 4103, or 800, or command lines with powershell\ncursor.execute(\"SELECT event_id, event_code, host, user, command_line, message FROM events WHERE event_code IN (4103, 4104) OR command_line LIKE '%powershell%' ORDER BY timestamp\")\nrows = cursor.fetchall()\nprint(f\"Found {len(rows)} events.\")\n\nfor r in rows:\n    cmd = r['command_line'] or ''\n    msg = r['message'] or ''\n    # check if 'enc' or 'bypass' or 'download' or 'admin' is in there\n    combined = cmd + \" \" + msg\n    if any(k in combined.lower() for k in ['enc', 'bypass', 'download', 'localgroup', 'admin', 'net.exe', 'net1.exe']):\n        # print first 200 chars\n        print(f\"ID: {r['event_id']} | Code: {r['event_code']} | Host: {r['host']} | User: {r['user']}\")\n        print(f\"  Cmd: {cmd[:150]}\")\n        if len(msg) > 50:\n            print(f\"  Msg snippet: {msg[:150]}\")\n        print(\"-\"*30)\nEOF\npython3 analyze_powershell.py\n"]
