[178.915262, "i", "cat << 'EOF' > trace_ws06.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, details, message\n    FROM events\n    WHERE host = 'WS-06.corp.example' AND event_code NOT IN (10, 7, 4673, 5156, 5158)\n    ORDER BY timestamp\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Filtered WS-06 events: {len(rows)}\")\nfor r in rows:\n    print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | img={r['image'] or ''} | parent={r['parent_image'] or ''} | cmd={r['command_line'] or ''} | msg={str(r['message'] or '')[:100]}\")\nEOF\npython3 trace_ws06.py\n"]
