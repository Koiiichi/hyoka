[73.249096, "i", "cat << 'EOF' > trace_timeline.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's inspect all non-powershell events on WS-05 and WS-06 to see if there is any other context.\nprint(\"=== WS-05 Non-PowerShell Events ===\")\ncursor.execute(\"SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, details FROM events WHERE host = 'WS-05.corp.example' AND event_code NOT IN (800, 4103, 4104) ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {r['user'] or ''} | {r['image'] or ''} | {r['parent_image'] or ''} | {r['command_line'] or ''} | {str(r['details'] or '')[:100]}\")\n\nprint(\"\\n=== WS-06 Events (First 30, non-10, non-7) ===\")\ncursor.execute(\"SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, details FROM events WHERE host = 'WS-06.corp.example' AND event_code NOT IN (10, 7) ORDER BY timestamp LIMIT 30\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {r['user'] or ''} | {r['image'] or ''} | {r['parent_image'] or ''} | {r['command_line'] or ''} | {str(r['details'] or '')[:100]}\")\nEOF\npython3 trace_timeline.py > timeline.txt\nhead -n 40 timeline.txt\n"]
