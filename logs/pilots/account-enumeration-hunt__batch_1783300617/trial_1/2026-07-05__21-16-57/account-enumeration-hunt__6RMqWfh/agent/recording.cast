[279.451097, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # 1. PowerShell engine logs (800, 4103, 4104 on WS-05)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.451317, "o", "    if code in (800, 4103, 4104) or prov == 'PowerShell' or 'PowerShell' in channel:\r\n\u001b[?2004l\r\u001b[?2004h>         malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.45153, "o", "    # 2. Events directly with the powershell_guid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.451612, "o", "    if guid == powerpowershell_guid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.451632, "o", "        malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[279.451701, "o", "> "]
[279.451851, "o", "    # 3. Events with any of the malicious net/net1 process_guids\r\n\u001b[?2004l\r\u001b[?2004h>     if guid in net_guids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.451942, "o", "        malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.451965, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[279.452041, "o", "\u001b[?2004h> "]
[279.452104, "o", "    # 4. Sysmon events where image is net.exe or net1.exe\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.45222, "o", "    if 'net.exe' in img.lower() or 'net1.exe' in img.lower():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.452331, "o", "        malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[279.452458, "o", "\u001b[?2004h>     # 5. Security events with user m.ward related to net/net1 execution\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.452614, "o", "    # We saw these occurred during Window 1 (00:00:08 to 00:00:11) and Window 2 (00:07:37 to 00:07:40)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.452747, "o", "    if user == 'm.ward' or tuser == 'm.ward':\r\n\u001b[?2004l\r\u001b[?2004h>         # double check the timestamp or content\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.452843, "o", "        is_window1 = ('2026-05-06T00:00:08' <= r['timestamp'] <= '2026-05-06T00:00:11')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.452991, "o", "        is_window2 = ('2026-05-06T00:07:37' <= r['timestamp'] <= '2026-05-06T00:07:40')\r\n\u001b[?2004l\r"]
[279.4531, "o", "\u001b[?2004h>         if is_window1 or is_window2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.453126, "o", "            malicious_ids.add(eid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.453281, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.453407, "o", "print(f\"Total flagged malicious events: {len(malicious_ids)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's do a sanity check on what we flagged\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.453575, "o", "flagged_events = [r for r in rows if r['event_id'] in malicious_ids]\r\n\u001b[?2004l\r\u001b[?2004h> flagged_events.sort(key=lambda x: x['timestamp'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Group count by event code\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.453603, "o", "from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.453744, "o", "cnt = Counter(r['event_code'] for r in flagged_events)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Flagged counts by event_code:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.453774, "o", "for k, v in cnt.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.453862, "o", "    print(f\"  {k}: {v}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[279.453964, "o", "> # Write to /root/findings.json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.454065, "o", "with open('/root/findings.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(sorted(list(malicious_ids)), f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.454208, "o", "print(\"Successfully wrote /root/findings.json\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[279.455169, "o", "\u001b[?2004hroot@6b9c25685d4f:~# "]
[279.455289, "o", "python3 generate_final_list.py\r\n\u001b[?2004l\r"]
[279.47515, "o", "Total DB events: 2791\r\n"]
[279.477627, "o", "Total flagged malicious events: 476\r\n"]
