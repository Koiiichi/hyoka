[53.256182, "i", "cat << 'EOF' > test_powershell.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"SELECT event_id, event_code, host, user, image, parent_image, command_line, details, message FROM events WHERE event_code IN (4103, 4104) OR command_line LIKE '%powershell%' LIMIT 10\")\nfor r in cursor.fetchall():\n    print(f\"ID: {r['event_id']} | Code: {r['event_code']} | Host: {r['host']} | User: {r['user']}\")\n    print(f\"  Img: {r['image'] or ''} | Parent: {r['parent_image'] or ''}\")\n    print(f\"  Cmd: {r['command_line'] or ''}\")\n    print(f\"  Det: {(r['details'] or '')[:100]}\")\n    print(f\"  Msg: {(r['message'] or '')[:100]}\")\n    print(\"=\"*40)\nEOF\npython3 test_powershell.py\n"]
