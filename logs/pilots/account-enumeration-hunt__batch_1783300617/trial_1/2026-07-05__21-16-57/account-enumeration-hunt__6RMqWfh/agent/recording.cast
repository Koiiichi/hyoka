[148.428934, "i", "cat << 'EOF' > analyze_network.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Unique WFP/Sysmon Network Flows ===\")\ncursor.execute(\"\"\"\n    SELECT event_code, host, image, src_ip, dst_ip, dst_port, COUNT(*)\n    FROM events\n    WHERE event_code IN (3, 5156, 5158)\n    GROUP BY event_code, host, image, src_ip, dst_ip, dst_port\n    ORDER BY COUNT(*) DESC\n\"\"\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_code']} | {r['host']} | {r['image'] or ''} | {r['src_ip'] or ''} -> {r['dst_ip'] or ''}:{r['dst_port'] or ''} | count={r['COUNT(*)']}\")\nEOF\npython3 analyze_network.py\n"]
