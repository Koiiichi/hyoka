[199.479622, "o", "\u001b[?2004hroot@6b9c25685d4f:~# "]
[203.032952, "i", "cat << 'EOF' > check_group_enum.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, event_code, host, timestamp, user, target_user, message FROM events WHERE event_code IN (4798, 4799) ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    msg = r['message'] or ''\n    proc_name = ''\n    for l in msg.split('\\n'):\n        if 'Process Name:' in l:\n            proc_name = l.replace('Process Name:', '').strip()\n            break\n    print(f\"{r['event_id']} | {r['event_code']} | {r['host']} | {r['timestamp']} | user={r['user']} | target_user={r['target_user']} | proc={proc_name}\")\nEOF\npython3 check_group_enum.py\n"]
[203.03331, "o", "cat << 'EOF' > check_group_enum.py\r\n"]
