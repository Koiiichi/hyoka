[90.017648, "i", "cat << 'EOF' > analyze_sysmon.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Sysmon File Creates (Code 11) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, image, target_object, details FROM events WHERE event_code = 11 ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    # wait, target_object or other column?\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image']} | {r['target_object'] or ''} | {r['details'] or ''}\")\n\nprint(\"\\n=== Sysmon Registry Events (Code 12, 13, 14) ===\")\ncursor.execute(\"SELECT event_id, event_code, timestamp, host, image, target_object, details FROM events WHERE event_code IN (12, 13, 14) ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    # let's only print some if they are not benign, or print all if not too many\n    val = f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {r['host']} | {r['image']} | {r['target_object'] or ''} | {r['details'] or ''}\"\n    # let's exclude standard service/system telemetry if possible, but let's see what they look like\n    print(val[:200])\n\nprint(\"\\n=== Sysmon Named Pipes (Code 17, 18) ===\")\ncursor.execute(\"SELECT event_id, event_code, timestamp, host, image, details FROM events WHERE event_code IN (17, 18) ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {r['host']} | {r['image']} | {r['details'] or ''}\")\nEOF\npython3 analyze_sysmon.py > sysmon.txt\nhead -n 50 sysmon.txt\n"]
