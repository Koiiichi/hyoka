[241.255838, "i", "cat << 'EOF' > get_all_associated.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's find all process GUIDs that were executed by m.ward or CORP\\m.ward\ncursor.execute(\"SELECT DISTINCT process_guid, image, command_line FROM events WHERE user LIKE '%m.ward%' AND process_guid IS NOT NULL\")\nprint(\"=== Process GUIDs for m.ward ===\")\nward_guids = set()\nfor r in cursor.fetchall():\n    print(f\"{r['process_guid']} | {r['image']} | {r['command_line']}\")\n    ward_guids.add(r['process_guid'])\n\n# Let's look at all events on WS-05 where user = 'm.ward' or are related to these process GUIDs\nEOF\npython3 get_all_associated.py\n"]
