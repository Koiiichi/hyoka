[285.912428, "i", "sqlite3 /root/data/eventlogs.db \"SELECT event_id, event_code, timestamp, user, target_user, image, command_line FROM events WHERE host = 'WS-05.corp.example' AND (user LIKE '%m.ward%' OR target_user LIKE '%m.ward%') AND event_id NOT IN (SELECT value FROM json_each(readfile('/root/findings.json')));\"\n"]
[285.912861, "o", "sqlite3 /root/data/eventlogs.db \"SELECT event_id, event_code, timestamp, user, target_user, image, command_line FROM events WHERE host = 'WS-05.corp.example' AND (user LIKE '%m.ward%' OR target_user LIKE '%m.ward%') AND event_id NOT IN (SELECT value FROM json_each(readfile('/root/findings.json')));\"\r\n\u001b[?2004l\r"]
