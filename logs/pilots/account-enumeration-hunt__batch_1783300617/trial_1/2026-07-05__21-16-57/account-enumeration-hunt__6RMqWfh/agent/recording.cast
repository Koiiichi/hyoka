[33.548874, "i", "cat << 'EOF' > explore.py\nimport sqlite3\nimport json\nimport base64\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's inspect process creation events\nprint(\"=== Process Creations ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, image, parent_image, command_line FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image'] or ''} | {r['parent_image'] or ''} | {r['command_line'] or ''}\")\n\n# Let's look for service changes or creations\nprint(\"\\n=== Services (4697, 7045) ===\")\ncursor.execute(\"SELECT event_id, event_code, timestamp, host, service_name, service_file_name, details FROM events WHERE event_code IN (4697, 7045, 4673) ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {r['host']} | {r['service_name'] or ''} | {r['service_file_name'] or ''} | {r['details'] or ''}\")\n\n# Let's look for any lateral movement, logon sessions (4624)\nprint(\"\\n=== Logons (4624) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, target_user, logon_type, src_ip, details FROM events WHERE event_code = 4624 ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['target_user']} | {r['logon_type']} | {r['src_ip']} | {r['details'] or ''}\")\n\n# Let's check network connections (3, 5156)\nprint(\"\\n=== Network Connections ===\")\ncursor.execute(\"SELECT event_id, event_code, timestamp, host, user, image, src_ip, dst_ip, dst_port FROM events WHERE event_code IN (3, 5156) ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image']} | {r['src_ip']} | {r['dst_ip']}:{r['dst_port']}\")\n\nEOF\npython3 explore.py > output.txt\nhead -n 50 output.txt\n"]
[33.54923, "o", "cat << 'EOF' > explore.py\r\n\u001b[?2004l\r"]
[33.549515, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import base64\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
