[83.028961, "i", "cat << 'EOF' > analyze_code10.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's inspect ProcessAccess events\nprint(\"=== WS-05 Code 10 (ProcessAccess) ===\")\ncursor.execute(\"SELECT event_id, timestamp, image, target_image, granted_access, details FROM events WHERE host = 'WS-05.corp.example' AND event_code = 10 ORDER BY timestamp\")\nrows = cursor.fetchall()\nprint(f\"Total ProcessAccess events on WS-05: {len(rows)}\")\n# print unique source/target/granted_access combinations\ncombinations = {}\nfor r in rows:\n    key = (r['image'], r['target_image'], r['granted_access'])\n    combinations[key] = combinations.get(key, 0) + 1\nfor k, count in sorted(combinations.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{k} -> {count} times\")\n\nprint(\"\\n=== WS-06 Code 10 (ProcessAccess) ===\")\ncursor.execute(\"SELECT event_id, timestamp, image, target_image, granted_access, details FROM events WHERE host = 'WS-06.corp.example' AND event_code = 10 ORDER BY timestamp\")\nrows = cursor.fetchall()\nprint(f\"Total ProcessAccess events on WS-06: {len(rows)}\")\ncombinations = {}\nfor r in rows:\n    key = (r['image'], r['target_image'], r['granted_access'])\n    combinations[key] = combinations.get(key, 0) + 1\nfor k, count in sorted(combinations.items(), key=lambda x: x[1], reverse=True):\n    print(f\"{k} -> {count} times\")\nEOF\npython3 analyze_code10.py\n"]
