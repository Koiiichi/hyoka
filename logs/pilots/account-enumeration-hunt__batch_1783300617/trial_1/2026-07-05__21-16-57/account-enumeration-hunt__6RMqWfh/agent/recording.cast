[101.8156, "i", "cat << 'EOF' > trace_logons.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\nprint(\"=== Non-System Logons (4624) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, target_user, logon_type, src_ip, dst_port, details FROM events WHERE event_code = 4624 AND target_user NOT LIKE '%$' AND target_user NOT IN ('SYSTEM', 'LOCAL SERVICE', 'NETWORK SERVICE') ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['target_user']} | logon_type={r['logon_type']} | src={r['src_ip']}\")\n\nprint(\"\\n=== Service Creations (4697) or other Service modifications ===\")\ncursor.execute(\"SELECT event_id, event_code, timestamp, host, user, service_name, service_file_name, details FROM events WHERE event_code IN (4697, 7045) ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['service_name']} | {r['service_file_name'] or ''} | {r['details'] or ''}\")\n\nprint(\"\\n=== Network Connections (Event Code 3) ===\")\ncursor.execute(\"SELECT event_id, timestamp, host, user, image, src_ip, dst_ip, dst_port FROM events WHERE event_code = 3 ORDER BY timestamp\")\nfor r in cursor.fetchall():\n    print(f\"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image']} | {r['src_ip']} -> {r['dst_ip']}:{r['dst_port']}\")\n\nEOF\npython3 trace_logons.py\n"]
[101.81588, "o", "cat << 'EOF' > trace_logons.py\r\n\u001b[?2004l\r"]
