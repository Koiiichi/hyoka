[159.023456, "i", "cat << 'EOF' > parse_wfp.py\nimport sqlite3\nimport re\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT event_id, event_code, timestamp, host, message FROM events WHERE event_code IN (5156, 5158)\")\nrows = cursor.fetchall()\nprint(f\"Total WFP events: {len(rows)}\")\n\nfor r in rows:\n    msg = r['message'] or ''\n    app_m = re.search(r'Application Name:\\s*(.+)', msg)\n    dir_m = re.search(r'Direction:\\s*(.+)', msg)\n    src_m = re.search(r'Source Address:\\s*([\\d\\w\\.:]+)', msg)\n    dst_m = re.search(r'Destination Address:\\s*([\\d\\w\\.:]+)', msg)\n    sport_m = re.search(r'Source Port:\\s*(\\d+)', msg)\n    dport_m = re.search(r'Destination Port:\\s*(\\d+)', msg)\n    \n    app = app_m.group(1).strip() if app_m else ''\n    direction = dir_m.group(1).strip() if dir_m else ''\n    src = src_m.group(1).strip() if src_m else ''\n    dst = dst_m.group(1).strip() if dst_m else ''\n    sport = sport_m.group(1).strip() if sport_m else ''\n    dport = dport_m.group(1).strip() if dport_m else ''\n    \n    # check if suspicious\n    is_suspicious = False\n    if 'powershell' in app.lower():\n        is_suspicious = True\n    elif dport in ['4444', '8000', '8080', '8888', '1337']:\n        is_suspicious = True\n    elif dst and not dst.startswith(('127.', '::1', '168.63.129.16', '172.18.')) and dst != '0.0.0.0':\n        is_suspicious = True\n        \n    if is_suspicious or 'net.exe' in app.lower() or 'net1.exe' in app.lower():\n        print(f\"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {r['host']} | {direction} | {src}:{sport} -> {dst}:{dport} | {app}\")\nEOF\npython3 parse_wfp.py\n"]
