[233.406123, "i", "cat << 'EOF' > collect_malicious.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\n# Let's query all events on WS-05\ncursor.execute(\"\"\"\n    SELECT event_id, event_code, timestamp, user, image, parent_image, command_line, process_guid, details\n    FROM events\n    WHERE host = 'WS-05.corp.example'\n    ORDER BY timestamp\n\"\"\")\nrows = cursor.fetchall()\nprint(f\"Total events on WS-05: {len(rows)}\")\n\nsuspicious_ids = set()\npowerpowershell_guid = \"{b34bc01c-2f95-5f69-5f01-000000000900}\"\n\nfor r in rows:\n    eid = r['event_id']\n    code = r['event_code']\n    guid = r['process_guid'] or ''\n    img = r['image'] or ''\n    pimg = r['parent_image'] or ''\n    cmd = r['command_line'] or ''\n    \n    # 1. Any event directly containing the powershell_guid\n    if guid == powerpowershell_guid:\n        suspicious_ids.add(eid)\n        continue\n        \n    # 2. PowerShell engine events (800, 4103, 4104)\n    if code in (800, 4103, 4104):\n        suspicious_ids.add(eid)\n        continue\n        \n    # 3. Spawned processes (net.exe / net1.exe) and their GUIDs\n    if 'net.exe' in img.lower() or 'net1.exe' in img.lower() or 'net.exe' in cmd.lower() or 'net1.exe' in cmd.lower():\n        suspicious_ids.add(eid)\n        continue\n        \n    if pimg == \"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" or pimg == \"C:\\\\Windows\\\\System32\\\\net.exe\":\n        suspicious_ids.add(eid)\n        continue\n        \n    # 4. Local group enumeration event (4799) from net1.exe\n    if code == 4799 and 'net1.exe' in cmd.lower():\n        suspicious_ids.add(eid)\n        continue\n        \nprint(f\"Found {len(suspicious_ids)} suspicious events based on direct association.\")\n\n# Let's examine any WS-05 events NOT yet flagged to see if we missed anything\nprint(\"\\n=== Non-flagged events on WS-05 ===\")\nfor r in rows:\n    eid = r['event_id']\n    if eid not in suspicious_ids:\n        # check if it looks like system/benign\n        print(f\"{eid} | {r['event_code']} | {r['timestamp']} | user={r['user']} | img={r['image']} | cmd={r['command_line']}\")\n\nEOF\npython3 collect_malicious.py > ws05_analysis.txt\nhead -n 50 ws05_analysis.txt\n"]
