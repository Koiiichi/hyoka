[139.809927, "i", "cat << 'EOF' > test_dns.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"SELECT * FROM events WHERE event_code = 22\")\nfor r in cursor.fetchall():\n    print(\"ID:\", r['event_id'])\n    for col in r.keys():\n        if r[col] is not None and str(r[col]).strip() != '':\n            print(f\"  {col}: {r[col]}\")\n    print(\"=\"*40)\nEOF\npython3 test_dns.py\n"]
