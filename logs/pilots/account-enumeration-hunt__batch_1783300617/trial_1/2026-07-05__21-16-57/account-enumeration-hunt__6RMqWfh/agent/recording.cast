[262.679647, "o", "xe | pimg= | cmd=\r\nevt-01103 | 12 | 2026-05-06T00:07:38.282Z | ch=Microsoft-Windows-Sysmon/Operational | user= | img=C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe | pimg= | cmd=\r\nevt-01104 | 11 | 2026-05-06T00:07:38.283Z | ch=Microsoft-Windows-Sysmon/Operational | user= | img=C:\\windows\\system32\\svchost.exe | pimg= | cmd=\r\nevt-01105 | 11 | 2026-05-06T00:07:38.283Z | ch=Microsoft-Windows-Sysmon/Operational | user= | img=C:\\windows\\system32\\svchost.exe | pimg= | cmd=\r\nevt-01106 | 10 | 2026-05-06T00:07:39.283Z | ch=Microsoft-Windows-Sysmon/Operational | user= | img=C:\\windows\\system32\\svchost.exe | pimg= | cmd=\r\nevt-01107 | 10 | 2026-05-06T00:07:39.283Z | ch=Microsoft-Windows-Sysmon/Operational | user= | img=C:\\windows\\system32\\svchost.exe | pimg= | cmd=\r\nevt-01108 | 4688 | 2026-05-06T00:07:39.283Z | ch=security | user=m.ward | img= | pimg= | cmd=\"C:\\windows\\system32\\net.exe\" user\r\nevt-01109 | 4688 | 2026-05-06T00:07:39.284Z | ch=security | user=m.ward | img= | pimg= | cmd=C:\\windows\\system32\\net1 user\r\nevt-01110 | 4690 | 2026-05-06T00:07:39.284Z | ch=security | user=m.ward | img= | pimg= | cmd=\r\nevt-01111 | 4658 | 2026-05-06T00:07:39.284Z | ch=security | user=m.ward | img= | pimg= | cmd=\r\nevt-01112 | 4656 | 2026-05-06T00:07:39.286Z | ch=security | user=m.ward | img= | pimg= | cmd=\r\nevt-01113 | 4663 | 2026-05-06T00:07:39.286Z | ch=security | user=m.ward | img= | pimg= | cmd=\r\nevt-01114 | 4658 | 2026-05-06T00:07:39.286Z | ch=security | user=m.ward | img= | pimg= | cmd=\r\nevt-01115 | 4689 | 2026-05-06T00:07:39.286Z | ch=security | user=m.ward | img= | pimg= | cmd=\r\nevt-01116 | 4689 | 2026-05-06T00:07:39.286Z | ch=security | user=m.ward | img= | pimg= | cmd=\r\n\u001b[?2004hroot@6b9c25685d4f:~# "]
[279.447854, "i", "cat << 'EOF' > generate_final_list.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT * FROM events\")\nrows = cursor.fetchall()\nprint(f\"Total DB events: {len(rows)}\")\n\nmalicious_ids = set()\n\npowerpowershell_guid = \"{b34bc01c-2f95-5f69-5f01-000000000900}\"\nnet_guids = {\n    \"{b34bc01c-34db-5f69-7701-000000000900}\", # net.exe 1\n    \"{b34bc01c-34db-5f69-7801-000000000900}\", # net1.exe 1\n    \"{b34bc01c-369c-5f69-7901-000000000900}\", # net.exe 2\n    \"{b34bc01c-369c-5f69-7a01-000000000900}\"  # net1.exe 2\n}\n\n# Let's check each event in detail\nfor r in rows:\n    eid = r['event_id']\n    host = r['host']\n    code = r['event_code']\n    channel = r['channel'] or ''\n    prov = r['provider'] or ''\n    user = r['user'] or ''\n    tuser = r['target_user'] or ''\n    img = r['image'] or ''\n    pimg = r['parent_image'] or ''\n    cmd = r['command_line'] or ''\n    guid = r['process_guid'] or ''\n    msg = r['message'] or ''\n    \n    # ONLY events on WS-05 can be malicious based on our finding\n    if host != 'WS-05.corp.example':\n        continue\n        \n    # 1. PowerShell engine logs (800, 4103, 4104 on WS-05)\n    if code in (800, 4103, 4104) or prov == 'PowerShell' or 'PowerShell' in channel:\n        malicious_ids.add(eid)\n        continue\n        \n    # 2. Events directly with the powershell_guid\n    if guid == powerpowershell_guid:\n        malicious_ids.add(eid)\n        continue\n        \n    # 3. Events with any of the malicious net/net1 process_guids\n    if guid in net_guids:\n        malicious_ids.add(eid)\n        continue\n        \n    # 4. Sysmon events where image is net.exe or net1.exe\n    if 'net.exe' in img.lower() or 'net1.exe' in img.lower():\n        malicious_ids.add(eid)\n        continue\n        \n    # 5. Security events with user m.ward related to net/net1 execution\n    # We saw these occurred during Window 1 (00:00:08 to 00:00:11) and Window 2 (00:07:37 to 00:07:40)\n    if user == 'm.ward' or tuser == 'm.ward':\n        # double check the timestamp or content\n        is_window1 = ('2026-05-06T00:00:08' <= r['timestamp'] <= '2026-05-06T00:00:11')\n        is_window2 = ('2026-05-06T00:07:37' <= r['timestamp'] <= '2026-05-06T00:07:40')\n        if is_window1 or is_window2:\n            malicious_ids.add(eid)\n            continue\n\nprint(f\"Total flagged malicious events: {len(malicious_ids)}\")\n\n# Let's do a sanity check on what we flagged\nflagged_events = [r for r in rows if r['event_id'] in malicious_ids]\nflagged_events.sort(key=lambda x: x['timestamp'])\n\n# Group count by event code\nfrom collections import Counter\ncnt = Counter(r['event_code'] for r in flagged_events)\nprint(\"Flagged counts by event_code:\")\nfor k, v in cnt.items():\n    print(f\"  {k}: {v}\")\n\n# Write to /root/findings.json\nwith open('/root/findings.json', 'w') as f:\n    json.dump(sorted(list(malicious_ids)), f)\nprint(\"Successfully wrote /root/findings.json\")\nEOF\npython3 generate_final_list.py\n"]
