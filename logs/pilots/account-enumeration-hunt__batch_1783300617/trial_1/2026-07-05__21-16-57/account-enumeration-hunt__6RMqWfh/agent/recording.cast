[152.710794, "i", "cat << 'EOF' > test_wfp.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncursor = conn.cursor()\ncursor.execute(\"SELECT event_id, event_code, host, details, message FROM events WHERE event_code IN (5156, 5158) LIMIT 3\")\nfor r in cursor.fetchall():\n    print(\"ID:\", r['event_id'], \"Code:\", r['event_code'])\n    print(\"Det:\", r['details'])\n    print(\"Msg:\", r['message'][:400] if r['message'] else '')\n    print(\"=\"*40)\nEOF\npython3 test_wfp.py\n"]
