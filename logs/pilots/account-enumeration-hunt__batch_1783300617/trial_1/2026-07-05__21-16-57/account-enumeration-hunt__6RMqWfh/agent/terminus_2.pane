[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect process creation events
[?2004l[?2004h> print("=== Process Creations ===")
[?2004l[?2004h> cursor.execute("SELECT event_id, timestamp, host, user, image, parent_image, command_line FROM events WHERE event_code IN (1, 4688) ORDER BY timestamp")
[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(f"{r['event_id']} | {r['timestamp']} | {r['host']} | {r['user']} | {r['image'] or ''} | {r['parent_image'] or ''} | {r['command_line'] or ''}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's look for service changes or creations
[?2004l[?2004h> print("\n=== Services (4697, 7045) ===")
