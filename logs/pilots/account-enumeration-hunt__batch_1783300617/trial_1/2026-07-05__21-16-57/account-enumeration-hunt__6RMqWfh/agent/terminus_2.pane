[?2004hroot@6b9c25685d4f:~# cat << 'EOF' > reconstruct_ps.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's extract command lines from event code 800
[?2004l[?2004h> cursor.execute("SELECT event_id, timestamp, message FROM events WHERE event_code = 800 ORDER BY timestamp")
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Total 800 events: {len(rows)}")
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     msg = r['message']
[?2004l[?2004h>     # extract the pipeline execution details
[?2004l[?2004h>     line = ""
[?2004l[?2004h>     for l in msg.split('\n'):
[?2004l[?2004h>         if "Pipeline execution details for command line:" in l:
[?2004l[?2004h>             line = l.replace("Pipeline execution details for command line:", "").strip()
[?2004l[?2004h>         elif "Context Information:" in l:
[?2004l[?2004h>             break
[?2004l[?2004h>         elif line:
[?2004l[?2004h>             line += " " + l.strip()
[?2004l[?2004h>     if line:
[?2004l[?2004h>         print(f"{r['event_id']} | {r['timestamp']} | {line[:120]}")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@6b9c25685d4f:~# python3 reconstruct_ps.py > ps_commands.txt
[?2004l[?2004hroot@6b9c25685d4f:~# head -n 60 ps_commands.txt
