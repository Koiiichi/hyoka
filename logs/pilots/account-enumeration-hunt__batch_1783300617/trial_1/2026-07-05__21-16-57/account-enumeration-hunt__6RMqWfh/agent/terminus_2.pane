[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Get all command lines containing 'enc' or 'encodedcommand' or containing large base64 strings
[?2004l[?2004h> cursor.execute("SELECT event_id, timestamp, host, user, command_line, message FROM events WHERE command_line LIKE '%enc%' OR message LIKE '%enc%' OR command_line LIKE '%powershell%' OR message LIKE '%powershell%'")
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Found {len(rows)} powershell related events.")
[?2004l[?2004h> 
[?2004l[?2004h> for r in rows[:15]:
[?2004l[?2004h>     # Check if there is a base64 encoded payload
[?2004l[?2004h>     cmd = r['command_line'] or ''
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     # extract base64-like strings
[?2004l[?2004h>     combined = cmd + " " + msg
[?2004l[?2004h>     b64_matches = re.findall(r'[A-Za-z0-9+/]{40,}=*', combined)
[?2004l[?2004h>     for match in b64_matches:
[?2004l[?2004h>         try:
[?2004l[?2004h>             decoded = base64.b64decode(match).decode('utf-16le', errors='ignore')
[?2004l[?2004h>             if any(k in decoded.lower() for k in ['http', 'bypass', 'download', 'exec', 'shell', 'admin']):
[?2004l[?2004h>                 print(f"Event: {r['event_id']} | Host: {r['host']} | Decoded payload snippet:")
[?2004l[?2004h>                 print(decoded[:500])
[?2004l[?2004h>                 print("-"*40)
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             pass
[?2004l[?2004h> EOF
