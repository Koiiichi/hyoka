[?2004hroot@6b9c25685d4f:~# cat << 'EOF' > generate_final_list.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> cursor.execute("SELECT * FROM events")
[?2004l[?2004h> rows = cursor.fetchall()
[?2004l[?2004h> print(f"Total DB events: {len(rows)}")
[?2004l[?2004h> 
[?2004l[?2004h> malicious_ids = set()
[?2004l[?2004h> 
[?2004l[?2004h> powerpowershell_guid = "{b34bc01c-2f95-5f69-5f01-000000000900}"
[?2004l[?2004h> net_guids = {
[?2004l[?2004h>     "{b34bc01c-34db-5f69-7701-000000000900}", # net.exe 1
[?2004l[?2004h>     "{b34bc01c-34db-5f69-7801-000000000900}", # net1.exe 1
[?2004l[?2004h>     "{b34bc01c-369c-5f69-7901-000000000900}", # net.exe 2
[?2004l[?2004h>     "{b34bc01c-369c-5f69-7a01-000000000900}"  # net1.exe 2
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Let's check each event in detail
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     eid = r['event_id']
[?2004l[?2004h>     host = r['host']
[?2004l[?2004h>     code = r['event_code']
[?2004l[?2004h>     channel = r['channel'] or ''
[?2004l[?2004h>     prov = r['provider'] or ''
[?2004l[?2004h>     user = r['user'] or ''
[?2004l[?2004h>     tuser = r['target_user'] or ''
[?2004l[?2004h>     img = r['image'] or ''
[?2004l[?2004h>     pimg = r['parent_image'] or ''
[?2004l[?2004h>     cmd = r['command_line'] or ''
[?2004l[?2004h>     guid = r['process_guid'] or ''
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     
[?2004l[?2004h>     # ONLY events on WS-05 can be malicious based on our finding
[?2004l[?2004h>     if host != 'WS-05.corp.example':
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 1. PowerShell engine logs (800, 4103, 4104 on WS-05)
[?2004l[?2004h>     if code in (800, 4103, 4104) or prov == 'PowerShell' or 'PowerShell' in channel:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 2. Events directly with the powershell_guid
[?2004l[?2004h>     if guid == powerpowershell_guid:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Events with any of the malicious net/net1 process_guids
[?2004l[?2004h>     if guid in net_guids:
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 4. Sysmon events where image is net.exe or net1.exe
[?2004l[?2004h>     if 'net.exe' in img.lower() or 'net1.exe' in img.lower():
[?2004l[?2004h>         malicious_ids.add(eid)
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # 5. Security events with user m.ward related to net/net1 execution
[?2004l[?2004h>     # We saw these occurred during Window 1 (00:00:08 to 00:00:11) and Window 2 (00:07:37 to 00:07:40)
[?2004l[?2004h>     if user == 'm.ward' or tuser == 'm.ward':
[?2004l[?2004h>         # double check the timestamp or content
[?2004l[?2004h>         is_window1 = ('2026-05-06T00:00:08' <= r['timestamp'] <= '2026-05-06T00:00:11')
[?2004l[?2004h>         is_window2 = ('2026-05-06T00:07:37' <= r['timestamp'] <= '2026-05-06T00:07:40')
[?2004l[?2004h>         if is_window1 or is_window2:
[?2004l[?2004h>             malicious_ids.add(eid)
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total flagged malicious events: {len(malicious_ids)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Let's do a sanity check on what we flagged
[?2004l[?2004h> flagged_events = [r for r in rows if r['event_id'] in malicious_ids]
[?2004l[?2004h> flagged_events.sort(key=lambda x: x['timestamp'])
[?2004l[?2004h> 
[?2004l[?2004h> # Group count by event code
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> cnt = Counter(r['event_code'] for r in flagged_events)
[?2004l[?2004h> print("Flagged counts by event_code:")
[?2004l[?2004h> for k, v in cnt.items():
[?2004l[?2004h>     print(f"  {k}: {v}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write to /root/findings.json
[?2004l[?2004h> with open('/root/findings.json', 'w') as f:
[?2004l[?2004h>     json.dump(sorted(list(malicious_ids)), f)
[?2004l[?2004h> print("Successfully wrote /root/findings.json")
