[?2004l[?2004h> for r in cursor.fetchall():
[?2004l[?2004h>     print(f"{r['event_id']} | {r['event_code']} | {r['timestamp']} | {r['host']} | {r['service_name'] or ''} | {r['service_file_name'] or ''} | {r['details'] or ''}")
[?2004l[?2004h> 
