ws:\n    eid = r[\'event_id\']\n    if eid not in suspicious_ids:\n        # check if it looks like system/benign\n        print(f"{eid} | {r[\'event_code\']} | {r[\'timestamp\']} | user={r[\'user\']} | img={r[\'image\']} | cmd={r[\'command_line\']}")\n\nEOF\npython3 collect_malicious.py > ws05_analysis.txt\nhead -n 50 ws05_analysis.txt\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
