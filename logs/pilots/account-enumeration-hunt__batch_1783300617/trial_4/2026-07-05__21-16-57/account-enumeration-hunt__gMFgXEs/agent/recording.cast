[66.142962, "o", "\u001b[?2004hroot@e219726dbb70:~# "]
[70.926024, "i", "cat << 'EOF' > dump_dc01.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== DC01 PROCESS CREATIONS ===\")\nfor r in cur.execute(\"SELECT event_id, timestamp, event_code, user, image, parent_image, command_line FROM events WHERE host = 'DC01.corp.example' AND event_code IN (1, 4688) ORDER BY timestamp\").fetchall():\n    print(dict(r))\n\nprint(\"\\n=== DC01 LOGONS (4624) ===\")\nfor r in cur.execute(\"SELECT event_id, timestamp, event_code, logon_type, user, target_user, src_ip, message FROM events WHERE host = 'DC01.corp.example' AND event_code = 4624 ORDER BY timestamp\").fetchall():\n    print(dict(r))\n\nprint(\"\\n=== DC01 OTHER NON-FIREWALL ===\")\nfor r in cur.execute(\"SELECT event_id, timestamp, event_code, user, image, target_image, target_object, details, message FROM events WHERE host = 'DC01.corp.example' AND event_code NOT IN (5156, 5158, 4624) ORDER BY timestamp\").fetchall():\n    msg = r['message'] or ''\n    if len(msg) > 150:\n        msg = msg[:100] + \" ... [TRUNCATED] ... \" + msg[-50:]\n    d = dict(r)\n    d['message'] = msg\n    print(d)\nEOF\npython3 dump_dc01.py > dc01_summary.txt\ncat dc01_summary.txt\n"]
[70.926485, "o", "cat << 'EOF' > dump_dc01.py\r\n\u001b[?2004l\r"]
