[56.891827, "i", "cat << 'EOF' > dump_ws05.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== WS-05 EVENTS ===\")\nfor r in cur.execute(\"SELECT event_id, event_code, timestamp, host, user, image, parent_image, target_image, command_line, target_object, details, service_name, service_file_name, logon_type, message FROM events WHERE host = 'WS-05.corp.example' ORDER BY timestamp\").fetchall():\n    d = dict(r)\n    d_filtered = {k: v for k, v in d.items() if v is not None and v != ''}\n    print(d_filtered)\nEOF\npython3 dump_ws05.py > ws05_timeline.txt\nwc -l ws05_timeline.txt\n"]
