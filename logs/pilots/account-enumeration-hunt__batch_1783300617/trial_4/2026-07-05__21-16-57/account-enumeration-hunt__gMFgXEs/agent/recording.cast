[199.703784, "i", "cat << 'EOF' > time_windows.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== WINDOW 1 ===\")\nfor r in cur.execute(\"SELECT event_id, event_code, timestamp, user, image, target_image, target_object, command_line, details FROM events WHERE host = 'WS-05.corp.example' AND timestamp >= '2026-05-06T00:00:08.000Z' AND timestamp <= '2026-05-06T00:00:10.500Z' ORDER BY timestamp\").fetchall():\n    print(dict(r))\n\nprint(\"\\n=== WINDOW 2 ===\")\nfor r in cur.execute(\"SELECT event_id, event_code, timestamp, user, image, target_image, target_object, command_line, details FROM events WHERE host = 'WS-05.corp.example' AND timestamp >= '2026-05-06T00:07:37.000Z' AND timestamp <= '2026-05-06T00:07:39.500Z' ORDER BY timestamp\").fetchall():\n    print(dict(r))\nEOF\npython3 time_windows.py > windows.txt\ncat windows.txt\n"]
