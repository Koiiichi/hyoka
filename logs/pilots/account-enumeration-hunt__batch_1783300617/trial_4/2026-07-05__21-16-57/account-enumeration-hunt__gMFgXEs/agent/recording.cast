[116.100666, "i", "cat << 'EOF' > find_powershell.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nfor col in ['image', 'parent_image', 'command_line', 'message', 'details', 'target_image', 'target_object']:\n    rows = cur.execute(f\"SELECT event_id, event_code, timestamp, host, user, image, parent_image, target_image, command_line, target_object FROM events WHERE {col} LIKE '%powershell.exe%' \").fetchall()\n    if rows:\n        print(f\"=== FOUND POWERSHELL IN {col} ({len(rows)} events) ===\")\n        for r in rows[:10]:\n            print(dict(r))\nEOF\npython3 find_powershell.py\n"]
