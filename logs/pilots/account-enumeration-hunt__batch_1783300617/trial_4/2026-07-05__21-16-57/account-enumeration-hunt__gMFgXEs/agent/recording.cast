[23.949591, "i", "cat << 'EOF' > dump.py\nimport sqlite3\nimport base64\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let's count event codes in the database first\nprint(\"=== Event Counts ===\")\nfor row in cur.execute(\"SELECT event_code, COUNT(*) FROM events GROUP BY event_code ORDER BY 2 DESC\").fetchall():\n    print(dict(row))\n\n# Let's inspect event code 3 (Network)\nprint(\"\\n=== Event Code 3 (Network Connection) ===\")\nfor row in cur.execute(\"SELECT event_id, timestamp, event_code, host, user, image, src_ip, dst_ip, dst_port FROM events WHERE event_code = 3\").fetchall():\n    print(dict(row))\n\n# Let's inspect event code 10 (ProcessAccess)\nprint(\"\\n=== Event Code 10 (Process Access) ===\")\nfor row in cur.execute(\"SELECT event_id, timestamp, host, user, source_image, target_image, granted_access, details FROM (SELECT event_id, timestamp, host, user, image as source_image, target_image, granted_access, details FROM events WHERE event_code = 10) LIMIT 20\").fetchall():\n    print(dict(row))\n\nEOF\npython3 dump.py\n"]
