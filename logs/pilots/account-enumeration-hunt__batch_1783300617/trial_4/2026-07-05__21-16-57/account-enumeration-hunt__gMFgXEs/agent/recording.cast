[38.85768, "i", "cat << 'EOF' > find_lsass.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nfor col in ['target_image', 'target_object', 'image', 'message', 'details', 'command_line', 'service_file_name']:\n    rows = cur.execute(f\"SELECT event_id, event_code, timestamp, host, user, image, target_image, command_line, message FROM events WHERE {col} LIKE '%lsass%' \").fetchall()\n    if rows:\n        print(f\"=== FOUND LSASS IN {col} ({len(rows)} events) ===\")\n        for r in rows[:10]:\n            print(dict(r))\nEOF\npython3 find_lsass.py\n"]
