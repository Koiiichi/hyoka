[159.117801, "i", "cat << 'EOF' > search_powershell_clean.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nkeywords = ['localgroup', 'Administrators', 'net.exe', 'net1.exe']\nfor keyword in keywords:\n    rows = cur.execute(\"SELECT event_id, event_code, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103) AND message LIKE ?\", (f'%{keyword}%',)).fetchall()\n    if rows:\n        print(f\"=== KEYWORD: {keyword} ===\")\n        for r in rows:\n            # extract the actual command line if possible\n            msg = r['message'] or ''\n            # find lines containing the keyword\n            for line in msg.split('\\n'):\n                if keyword in line:\n                    print(r['event_id'], r['event_code'], r['timestamp'], line.strip())\nEOF\npython3 search_powershell_clean.py\n"]
[159.118262, "o", "cat << 'EOF' > search_powershell_clean.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
