[62.151705, "i", "cat << 'EOF' > summarize_ws05.py\nimport json\n\nwith open('ws05_timeline.txt', 'r') as f:\n    for line in f:\n        line = line.strip()\n        if not line: continue\n        try:\n            d = eval(line)\n        except:\n            continue\n        \n        ev_code = d.get('event_code')\n        if ev_code in [7, 12, 13, 14, 10]: # skip noise\n            continue\n        if ev_code in [5156, 5158]: # skip firewall noise\n            continue\n            \n        # Let's see what we have\n        print(f\"ID: {d.get('event_id')} | Code: {ev_code} | User: {d.get('user') or d.get('target_user')} | Image: {d.get('image')} | Cmd: {d.get('command_line')} | Service: {d.get('service_name')} | Msg: {str(d.get('message'))[:200]}\")\nEOF\npython3 summarize_ws05.py\n"]
