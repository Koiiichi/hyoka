[30.351207, "i", "cat << 'EOF' > dump2.py\nimport sqlite3\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Network connection events\nprint(\"=== NETWORK CONNECTIONS (3) ===\")\nfor r in cur.execute(\"SELECT event_id, timestamp, host, user, image, src_ip, dst_ip, dst_port FROM events WHERE event_code = 3\").fetchall():\n    print(dict(r))\n\n# PowerShell 4103, 800\nprint(\"\\n=== POWERSHELL EVENTS ===\")\nfor r in cur.execute(\"SELECT event_id, timestamp, event_code, host, message FROM events WHERE event_code IN (4103, 800, 4104)\").fetchall():\n    msg = r['message'] or ''\n    # abbreviate long messages to prevent terminal spam but keep relevant commands\n    if len(msg) > 300:\n        msg = msg[:150] + \" ... [TRUNCATED] ... \" + msg[-150:]\n    print(f\"ID: {r['event_id']}, Time: {r['timestamp']}, Code: {r['event_code']}, Host: {r['host']}, Msg: {msg}\")\n\n# Lsass access (Event code 10 with target_image = lsass.exe)\nprint(\"\\n=== LSASS ACCESS ===\")\nfor r in cur.execute(\"SELECT event_id, timestamp, host, user, image, target_image, granted_access, details FROM events WHERE event_code = 10 AND target_image LIKE '%lsass.exe'\").fetchall():\n    print(dict(r))\n\n# Service creation or modification (e.g. event code 7045 or service events, wait 4697, or Registry service creation)\nprint(\"\\n=== SERVICE / REGISTRY EVENTS ===\")\nfor r in cur.execute(\"SELECT event_id, timestamp, event_code, host, user, target_object, details FROM events WHERE target_object LIKE '%Services%' OR service_name IS NOT NULL\").fetchall():\n    print(dict(r))\n\n# Logon events (4624)\nprint(\"\\n=== LOGONS (4624) ===\")\nfor r in cur.execute(\"SELECT event_id, timestamp, host, user, target_user, logon_type, src_ip FROM events WHERE event_code = 4624\").fetchall():\n    print(dict(r))\n\nEOF\npython3 dump2.py > out.txt\nhead -n 50 out.txt\n"]
