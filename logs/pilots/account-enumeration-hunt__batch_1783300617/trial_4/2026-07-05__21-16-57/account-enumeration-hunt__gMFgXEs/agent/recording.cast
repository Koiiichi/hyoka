[49.970761, "i", "cat << 'EOF' > summarize_timeline.py\nimport json\n\nwith open('ws06_timeline.txt', 'r') as f:\n    for line in f:\n        line = line.strip()\n        if not line: continue\n        try:\n            # Need to carefully evaluate the printed dictionary representation\n            d = eval(line)\n        except Exception as e:\n            continue\n        \n        # Filter out common benign events\n        ev_code = d.get('event_code')\n        if ev_code in [7]: # ignore dll loads\n            continue\n        if ev_code in [12, 13, 14] and 'svchost.exe' in d.get('image', ''):\n            continue\n        if ev_code == 10 and 'svchost.exe' in d.get('image', '') and 'svchost.exe' in d.get('target_image', ''):\n            continue\n        # Print the rest\n        print(f\"ID: {d.get('event_id')} | Code: {ev_code} | User: {d.get('user')} | Image: {d.get('image')} | TargetImage: {d.get('target_image')} | Cmd: {d.get('command_line')} | TargetObj: {d.get('target_object')} | Details: {d.get('details')}\")\n\nEOF\npython3 summarize_timeline.py\n"]
