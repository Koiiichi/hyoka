[87.229811, "i", "cat << 'EOF' > parse_firewall.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nfor r in cur.execute(\"SELECT event_id, timestamp, event_code, host, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158) ORDER BY timestamp\").fetchall():\n    msg = r['message'] or ''\n    # extract application name, source/destination address, port\n    app = \"\"\n    direction = \"\"\n    src = \"\"\n    dst = \"\"\n    port = \"\"\n    for line in msg.split('\\n'):\n        line = line.strip()\n        if \"Application Name:\" in line or \"Application:\" in line or \"Application Information:\" in line:\n            # look for the next line or in the same line\n            pass\n        if \"\\\\device\\\\\" in line:\n            app = line\n        if \"Direction:\" in line:\n            direction = line\n        if \"Source Address:\" in line:\n            src = line\n        if \"Destination Address:\" in line:\n            dst = line\n        if \"Destination Port:\" in line:\n            port = line\n    print(f\"ID: {r['event_id']} | Code: {r['event_code']} | App: {app} | Dir: {direction} | Src: {src} | Dst: {dst} | Port: {port}\")\nEOF\npython3 parse_firewall.py | head -n 40\n"]
[87.23003, "o", "cat << 'EOF' > parse_firewall.py\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
