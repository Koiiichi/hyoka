[45.332906, "i", "cat << 'EOF' > dump_ws06.py\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=== WS-06 EVENTS ===\")\nfor r in cur.execute(\"SELECT event_id, event_code, timestamp, host, user, image, parent_image, target_image, command_line, target_object, details, service_name, service_file_name, logon_type, message FROM events WHERE host = 'WS-06.corp.example' AND timestamp >= '2026-05-06T00:08:15' AND timestamp <= '2026-05-06T00:08:26' ORDER BY timestamp\").fetchall():\n    d = dict(r)\n    # filter out some empty keys to save screen space\n    d_filtered = {k: v for k, v in d.items() if v is not None and v != ''}\n    print(d_filtered)\nEOF\npython3 dump_ws06.py > ws06_timeline.txt\ncat ws06_timeline.txt | head -n 40\n"]
