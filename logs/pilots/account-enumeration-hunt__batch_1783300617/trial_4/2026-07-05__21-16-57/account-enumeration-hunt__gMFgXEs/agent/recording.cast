[205.072563, "o", "\u001b[?2004hroot@e219726dbb70:~# "]
[213.402076, "i", "cat << 'EOF' > parse_windows1.py\nwith open('windows.txt', 'r') as f:\n    print_on = False\n    for line in f:\n        line = line.strip()\n        if \"=== WINDOW 1 ===\" in line:\n            print_on = True\n            continue\n        if \"=== WINDOW 2 ===\" in line:\n            print_on = False\n            break\n        if not print_on or not line:\n            continue\n        try:\n            d = eval(line)\n        except:\n            continue\n        \n        image = d.get('image') or ''\n        target_image = d.get('target_image') or ''\n        ev_code = d.get('event_code')\n        \n        if 'svchost' in image or 'svchost' in target_image:\n            continue\n        if 'csrss' in image or 'csrss' in target_image:\n            continue\n        if 'conhost' in image or 'conhost' in target_image:\n            continue\n        if 'WaAppAgent' in image or 'WaAppAgent' in target_image:\n            continue\n        if 'WindowsAzure' in image or 'WindowsAzure' in target_image:\n            continue\n        if ev_code in [7, 12, 13, 14]:\n            continue\n            \n        print(f\"ID: {d.get('event_id')} | Code: {ev_code} | Time: {d.get('timestamp')} | User: {d.get('user')} | Image: {image} | Target: {target_image} | Cmd: {d.get('command_line')}\")\nEOF\npython3 parse_windows1.py\n"]
[213.404121, "o", "cat << 'EOF' > parse_windows1.py\r\n\u001b[?2004l\r\u001b[?2004h> with open('windows.txt', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     print_on = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[213.404173, "o", "    for line in f:\r\n\u001b[?2004l\r"]
