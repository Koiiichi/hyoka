[116.102864, "o", ">     rows = cur.execute(f\"SELECT event_id, event_code, timestamp, host, user, image, parent_image, target_image, command_line, target_object FROM events WHERE {col} LIKE '%powershell.exe%' \").fetchall()\r\n\u001b[?2004l\r\u001b[?2004h>     if rows:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"=== FOUND POWERSHELL IN {col} ({len(rows)} events) ===\")\r\n\u001b[?2004l\r\u001b[?2004h>         for r in rows[:10]:\r\n\u001b[?2004l\r\u001b[?2004h>             print(dict(r))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
