[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's count event codes in the database first
[?2004l[?2004h> print("=== Event Counts ===")
[?2004l[?2004h> for row in cur.execute("SELECT event_code, COUNT(*) FROM events GROUP BY event_code ORDER BY 2 DESC").fetchall():
[?2004l[?2004h>     print(dict(row))
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect event code 3 (Network)
[?2004l[?2004h> print("\n=== Event Code 3 (Network Connection) ===")
[?2004l[?2004h> for row in cur.execute("SELECT event_id, timestamp, event_code, host, user, image, src_ip, dst_ip, dst_port FROM events WHERE event_code = 3").fetchall():
[?2004l[?2004h>     print(dict(row))
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect event code 10 (ProcessAccess)
[?2004l[?2004h> print("\n=== Event Code 10 (Process Access) ===")
