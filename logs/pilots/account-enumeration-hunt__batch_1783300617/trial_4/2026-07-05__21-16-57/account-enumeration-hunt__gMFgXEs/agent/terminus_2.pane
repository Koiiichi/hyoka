[?2004l[?2004h>         if 'csrss' in image or 'csrss' in target_image:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if 'conhost' in image or 'conhost' in target_image:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if 'WaAppAgent' in image or 'WaAppAgent' in target_image:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if 'WindowsAzure' in image or 'WindowsAzure' in target_image:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if ev_code in [7, 12, 13, 14]: # standard DLL load or registry connections
[?2004l[?2004h>             # wait, registry open by powershell can be noisy. 
[?2004l[?2004h>             # let's keep it if we want, but for now skip
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         print(f"ID: {d.get('event_id')} | Code: {ev_code} | Time: {d.get('timestamp')} | User: {d.get('user')} | Image: {image} | Target: {target_image} | Cmd: {d.get('command_line')}")
