[?2004hroot@e219726dbb70:~# cat << 'EOF' > parse_windows1.py
[?2004l[?2004h> with open('windows.txt', 'r') as f:
[?2004l[?2004h>     print_on = False
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if "=== WINDOW 1 ===" in line:
[?2004l[?2004h>             print_on = True
[?2004l[?2004h>             continue
[?2004l[?2004h>         if "=== WINDOW 2 ===" in line:
[?2004l[?2004h>             print_on = False
[?2004l[?2004h>             break
[?2004l[?2004h>         if not print_on or not line:
[?2004l[?2004h>             continue
[?2004l[?2004h>         try:
[?2004l[?2004h>             d = eval(line)
[?2004l[?2004h>         except:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         image = d.get('image') or ''
[?2004l[?2004h>         target_image = d.get('target_image') or ''
[?2004l[?2004h>         ev_code = d.get('event_code')
