[?2004hroot@e219726dbb70:~# cat << 'EOF' > parse_firewall.py
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> for r in cur.execute("SELECT event_id, timestamp, event_code, host, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (5156, 5158) ORDER BY timestamp").fetchall():
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     # extract application name, source/destination address, port
[?2004l[?2004h>     app = ""
[?2004l[?2004h>     direction = ""
[?2004l[?2004h>     src = ""
[?2004l[?2004h>     dst = ""
[?2004l[?2004h>     port = ""
[?2004l[?2004h>     for line in msg.split('\n'):
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if "Application Name:" in line or "Application:" in line or "Application Information:" in line:
[?2004l[?2004h>             # look for the next line or in the same line
[?2004l[?2004h>             pass
[?2004l[?2004h>         if "\\device\\" in line:
[?2004l[?2004h>             app = line
[?2004l[?2004h>         if "Direction:" in line:
[?2004l[?2004h>             direction = line
[?2004l[?2004h>         if "Source Address:" in line:
[?2004l[?2004h>             src = line
[?2004l[?2004h>         if "Destination Address:" in line:
[?2004l[?2004h>             dst = line
[?2004l[?2004h>         if "Destination Port:" in line:
[?2004l[?2004h>             port = line
[?2004l[?2004h>     print(f"ID: {r['event_id']} | Code: {r['event_code']} | App: {app} | Dir: {direction} | Src: {src} | Dst: {dst} | Port: {port}")
[?2004l[?2004h> EOF
