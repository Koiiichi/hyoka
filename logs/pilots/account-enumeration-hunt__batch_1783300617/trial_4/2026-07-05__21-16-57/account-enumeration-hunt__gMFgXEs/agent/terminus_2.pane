[?2004l[?2004h> import sqlite3
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> keywords = ['localgroup', 'Administrators', 'net.exe', 'net1.exe']
[?2004l[?2004h> for keyword in keywords:
[?2004l[?2004h>     rows = cur.execute("SELECT event_id, event_code, timestamp, message FROM events WHERE host = 'WS-05.corp.example' AND event_code IN (800, 4103) AND message LIKE ?", (f'%{keyword}%',)).fetchall()
[?2004l[?2004h>     if rows:
[?2004l[?2004h>         print(f"=== KEYWORD: {keyword} ===")
[?2004l[?2004h>         for r in rows:
[?2004l[?2004h>             # extract the actual command line if possible
[?2004l[?2004h>             msg = r['message'] or ''
[?2004l[?2004h>             # find lines containing the keyword
[?2004l[?2004h>             for line in msg.split('\n'):
[?2004l[?2004h>                 if keyword in line:
[?2004l[?2004h>                     print(r['event_id'], r['event_code'], r['timestamp'], line.strip())
[?2004l[?2004h> EOF
