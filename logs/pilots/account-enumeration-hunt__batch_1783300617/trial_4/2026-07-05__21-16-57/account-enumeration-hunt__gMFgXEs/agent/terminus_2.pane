[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/root/data/eventlogs.db')
[?2004l[?2004h> conn.row_factory = sqlite3.Row
[?2004l[?2004h> cur = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Network connection events
[?2004l[?2004h> print("=== NETWORK CONNECTIONS (3) ===")
[?2004l[?2004h> for r in cur.execute("SELECT event_id, timestamp, host, user, image, src_ip, dst_ip, dst_port FROM events WHERE event_code = 3").fetchall():
[?2004l[?2004h>     print(dict(r))
[?2004l[?2004h> 
[?2004l[?2004h> # PowerShell 4103, 800
[?2004l[?2004h> print("\n=== POWERSHELL EVENTS ===")
[?2004l[?2004h> for r in cur.execute("SELECT event_id, timestamp, event_code, host, message FROM events WHERE event_code IN (4103, 800, 4104)").fetchall():
[?2004l[?2004h>     msg = r['message'] or ''
[?2004l[?2004h>     # abbreviate long messages to prevent terminal spam but keep relevant commands
[?2004l[?2004h>     if len(msg) > 300:
[?2004l[?2004h>         msg = msg[:150] + " ... [TRUNCATED] ... " + msg[-150:]
[?2004l[?2004h>     print(f"ID: {r['event_id']}, Time: {r['timestamp']}, Code: {r['event_code']}, Host: {r['host']}, Msg: {msg}")
[?2004l[?2004h> 
[?2004l[?2004h> # Lsass access (Event code 10 with target_image = lsass.exe)
[?2004l[?2004h> print("\n=== LSASS ACCESS ===")
[?2004l[?2004h> for r in cur.execute("SELECT event_id, timestamp, host, user, image, target_image, granted_access, details FROM events WHERE event_code = 10 AND target_image LIKE '%lsass.exe'").fetchall():
[?2004l[?2004h>     print(dict(r))
[?2004l[?2004h> 
[?2004l[?2004h> # Service creation or modification (e.g. event code 7045 or service events, wait 4697, or Registry service creation)
[?2004l[?2004h> print("\n=== SERVICE / REGISTRY EVENTS ===")
[?2004l[?2004h> for r in cur.execute("SELECT event_id, timestamp, event_code, host, user, target_object, details FROM events WHERE target_object LIKE '%Services%' OR service_name IS NOT NULL").fetchall():
[?2004l[?2004h>     print(dict(r))
[?2004l[?2004h> 
[?2004l[?2004h> # Logon events (4624)
[?2004l[?2004h> print("\n=== LOGONS (4624) ===")
[?2004l[?2004h> for r in cur.execute("SELECT event_id, timestamp, host, user, target_user, logon_type, src_ip FROM events WHERE event_code = 4624").fetchall():
[?2004l[?2004h>     print(dict(r))
[?2004l[?2004h> 
[?2004l[?2004h> EOF
