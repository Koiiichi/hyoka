Sending keys: ['python3 -c "\nimport sqlite3\nconn = sqlite3.connect(\'/root/data/eventlogs.db\')\ncur = conn.cursor()\n\n# Malicious process guids on WS-05\nmal_guids = [\n    \'{b34bc01c-2f95-5f69-5f01-000000000900}\', # PowerShell\n    \'{b34bc01c-34db-5f69-7701-000000000900}\', # net.exe localgroup Admins\n    \'{b34bc01c-34db-5f69-7801-000000000900}\', # net1.exe localgroup Admins\n    \'{b34bc01c-369c-5f69-7901-000000000900}\', # net.exe user\n    \'{b34bc01c-369c-5f69-7a01-000000000900}\'  # net1.exe user\n]\n\n# Get all directly linked events via process_guid on WS-05\ncur.execute(\'SELECT event_id FROM events WHERE process_guid IN ({})\'.format(\',\'.join(\'?\'*len(mal_guids))), mal_guids)\nws05_direct = [r[0] for r in cur.fetchall()]\n\n# Get PowerShell events (800, 4103) on WS-05\ncur.execute(\'SELECT event_id FROM events WHERE host=\\\'WS-05.corp.example\\\' AND event_code IN (800, 4103)\')\nws05_powershell = [r[0] for r in cur.fetchall()]\n\n# Get Security Process creations (4688) on WS-05 for net/net1\ncur.execute(\'SELECT event_id FROM events WHERE host=\\\'WS-05.corp.example\\\' AND event_code=4688 AND (command_line LIKE \\\'%net.exe%\\\' OR command_line LIKE \\\'%net1.exe%\\\')\')\nws05_sec_proc = [r[0] for r in cur.fetchall()]\n\nprint(f\'Directly linked: {len(ws05_direct)}\')\nprint(f\'PowerShell: {len(ws05_powershell)}\')\nprint(f\'Sec Proc: {len(ws05_sec_proc)}\')\nprint(ws05_sec_proc)\n"\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
