[187.06013, "i", "python3 -c \"\nimport sqlite3, re\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute('SELECT event_id, timestamp, message FROM events WHERE host=\\'WS-05.corp.example\\' AND event_code=800 AND timestamp BETWEEN \\'2026-05-06T00:08:10.000Z\\' AND \\'2026-05-06T00:08:18.000Z\\' ORDER BY timestamp')\nfor eid, ts, msg in cur.fetchall():\n    if not msg: continue\n    match = re.search(r'command line:\\s*(.*?)\\n\\.', msg, re.DOTALL)\n    if match:\n        cmd = match.group(1).strip().replace('\\n', ' ')\n        print(f'{eid} | {ts} | {cmd[:200]}')\n\"\n"]
