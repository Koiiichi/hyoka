[228.933943, "i", "python3 -c \"\nimport re\nwith open('/tmp/wfp_connections.txt') as f:\n    content = f.read()\nevents = content.split('evt-')\nfor ev in events:\n    if not ev.strip(): continue\n    eid = 'evt-' + ev.split('|')[0]\n    sip_match = re.search(r'Source Address:\\s*(\\S+)', ev)\n    dip_match = re.search(r'Destination Address:\\s*(\\S+)', ev)\n    dport_match = re.search(r'Destination Port:\\s*(\\S+)', ev)\n    app_match = re.search(r'Application Name:\\s*(.*)', ev)\n    sip = sip_match.group(1) if sip_match else 'None'\n    dip = dip_match.group(1) if dip_match else 'None'\n    dport = dport_match.group(1) if dport_match else 'None'\n    app = app_match.group(1).strip() if app_match else 'None'\n    print(f'{eid} | {sip} -> {dip}:{dport} | {app}')\n\"\n"]
