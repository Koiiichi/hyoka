[259.393016, "o", "with open('/tmp/wfp_connections.txt') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     content = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> parts = content.split('evt-')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.393054, "o", "seen = set()\r\n\u001b[?2004l\r"]
[259.393096, "o", "\u001b[?2004h> for p in parts:\r\n\u001b[?2004l\r\u001b[?2004h>     if not p.strip(): continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.393154, "o", "    eid = 'evt-' + p.split('|')[0]\r\n\u001b[?2004l\r"]
[259.393205, "o", "\u001b[?2004h> "]
[259.393291, "o", "    sip = re.search(r'Source Address:\\s*(\\S+)', p)\r\n\u001b[?2004l\r\u001b[?2004h>     dip = re.search(r'Destination Address:\\s*(\\S+)', p)\r\n\u001b[?2004l\r"]
[259.393433, "o", "\u001b[?2004h>     dport = re.search(r'Destination Port:\\s*(\\S+)', p)\r\n\u001b[?2004l\r"]
[259.393508, "o", "\u001b[?2004h> "]
[259.39378, "o", "    app = re.search(r'Application Name:\\s*(.*)', p)\r\n\u001b[?2004l\r\u001b[?2004h>     if sip and dip and dport:\r\n\u001b[?2004l\r"]
[259.393941, "o", "\u001b[?2004h>         s = sip.group(1)\r\n\u001b[?2004l\r\u001b[?2004h>         d = dip.group(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.394115, "o", "        dp = dport.group(1)\r\n\u001b[?2004l\r\u001b[?2004h>         ap = app.group(1).strip() if app else 'None'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.39432, "o", "        if s != d and '168.63.' not in s and '168.63.' not in d and '255' not in d and dp not in ('53', '123'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.394423, "o", "            item = f'{eid} | {s} -> {d}:{dp} | {ap}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.394559, "o", "            if item not in seen:\r\n\u001b[?2004l\r\u001b[?2004h>                 print(item)\r\n\u001b[?2004l\r"]
[259.394613, "o", "\u001b[?2004h> "]
[259.394711, "o", "                seen.add(item)\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
