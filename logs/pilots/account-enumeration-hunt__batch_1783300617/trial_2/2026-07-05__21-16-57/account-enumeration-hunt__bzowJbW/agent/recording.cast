[135.987554, "i", "python3 -c \"\nimport sqlite3, re\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\ncur.execute('SELECT event_id, event_code, message FROM events WHERE host=\"WS-05.corp.example\" AND event_code IN (800, 4103)')\nhost_apps = {}\nfor eid, ecode, msg in cur.fetchall():\n    if not msg: continue\n    match = re.search(r'HostApplication=(.*)', msg)\n    if match:\n        app = match.group(1).strip()\n        host_apps[app] = host_apps.get(app, 0) + 1\nfor app, cnt in host_apps.items():\n    print(f'{cnt} times: {app[:200]}')\n\"\n"]
