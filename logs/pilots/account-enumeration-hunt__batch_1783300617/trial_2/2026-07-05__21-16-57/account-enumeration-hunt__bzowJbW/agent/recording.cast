[242.691589, "i", "python3 -c \"\nwith open('/tmp/wfp_connections.txt') as f:\n    content = f.read()\nparts = content.split('evt-')\nseen = set()\nfor p in parts:\n    if not p.strip(): continue\n    eid = 'evt-' + p.split('|')[0]\n    # Extract fields\n    import re\n    sip = re.search(r'Source Address:\\s*(\\S+)', p)\n    dip = re.search(r'Destination Address:\\s*(\\S+)', p)\n    dport = re.search(r'Destination Port:\\s*(\\S+)', p)\n    app = re.search(r'Application Name:\\s*(.*)', p)\n    if sip and dip and dport:\n        s = sip.group(1)\n        d = dip.group(1)\n        dp = dport.group(1)\n        ap = app.group(1).strip() if app else 'None'\n        if s.startswith('172.18.') and d.startswith('172.18.'):\n            item = f'{eid} | {s} -> {d}:{dp} | {ap}'\n            if item not in seen:\n                print(item)\n                seen.add(item)\n\"\n"]
