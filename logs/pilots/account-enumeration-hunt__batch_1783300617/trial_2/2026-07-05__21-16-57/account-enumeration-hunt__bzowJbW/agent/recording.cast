meLow\r\nevt-00984|12|C:\\windows\\system32\\lsass.exe|HKLM\\System\\CurrentControlSet\\Services\\W32Time\\SecureTimeLimits\\RunTime\r\nevt-00985|13|C:\\windows\\system32\\lsass.exe|HKLM\\System\\CurrentControlSet\\Services\\W32Time\\SecureTimeLimits\\RunTime\\SecureTimeTickCount\r\nevt-00986|13|C:\\windows\\system32\\lsass.exe|HKLM\\System\\CurrentControlSet\\Services\\W32Time\\SecureTimeLimits\\RunTime\\SecureTimeConfidence\r\nevt-00987|12|C:\\windows\\System32\\svchost.exe|HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-01013|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-01103|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-01104|11|C:\\windows\\system32\\svchost.exe|\r\nevt-01105|11|C:\\windows\\system32\\svchost.exe|\r\nevt-01128|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-01154|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-01180|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-01198|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-01226|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-01249|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-01276|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1"]
[298.306325, "o", "032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-01487|12|C:\\windows\\System32\\svchost.exe|HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\VFUProvider\r\nevt-01490|13|C:\\windows\\System32\\svchost.exe|HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\VFUProvider\\StartTime\r\nevt-01630|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-02433|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-02624|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\nevt-02644|11|C:\\windows\\System32\\svchost.exe|\r\nevt-02745|12|C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe|HKU\\S-1-5-21-4228717743-1032521047-1810997296-1104\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections\r\n"]
[298.306594, "o", "\u001b[?2004hroot@ce2a21066e34:~# "]
[319.880344, "i", "python3 -c \"\nimport sqlite3, json\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\n\nfindings = set()\n\n# 1. WS-05 Malicious processes directly linked by process_guid\nmal_guids = [\n    '{b34bc01c-2f95-5f69-5f01-000000000900}', # PowerShell\n    '{b34bc01c-34db-5f69-7701-000000000900}', # net.exe localgroup Admins\n    '{b34bc01c-34db-5f69-7801-000000000900}', # net1.exe localgroup Admins\n    '{b34bc01c-369c-5f69-7901-000000000900}', # net.exe user\n    '{b34bc01c-369c-5f69-7a01-000000000900}'  # net1.exe user\n]\ncur.execute('SELECT event_id FROM events WHERE process_guid IN ({})'.format(','.join('?'*len(mal_guids))), mal_guids)\nfor r in cur.fetchall(): findings.add(r[0])\n\n# 2. WS-05 PowerShell events (800, 4103)\ncur.execute('SELECT event_id FROM events WHERE host=\\'WS-05.corp.example\\' AND event_code IN (800, 4103)')\nfor r in cur.fetchall(): findings.add(r[0])\n\n# 3. WS-05 Security Process Creations (4688) for net/net1\nfor eid in ['evt-00172', 'evt-00173', 'evt-01108', 'evt-01109']:\n    findings.add(eid)\n\n# 4. WS-05 Security Process Exits (4689) and Sysmon exits (5) for net/net1\nfor eid in ['evt-00140', 'evt-00143', 'evt-01098', 'evt-01099', 'evt-00184', 'evt-00185', 'evt-01115', 'evt-01116']:\n    findings.add(eid)\n\n# 5. WS-05 Process Access (10) for net/net1/powershell\nws05_mal_proc_access = [\n    'evt-00085', 'evt-00090', 'evt-00100', 'evt-00114', 'evt-00115', 'evt-00123', 'evt-00139',\n    'evt-01030', 'evt-01033', 'evt-01051', 'evt-01069', 'evt-01070', 'evt-01077'\n]\nfor eid in ws05_mal_proc_access:\n    findings.add(eid)\n\n# 6. WS-05 C2 Network connections (Sysmon 3 and WFP 5156)\nfindings.add('evt-00921') # Sysmon 3 to 52.114.158.53\nfindings.add('evt-00906') # WFP 5156 to 52.114.158.53\n\n# 7. WS-05 RPC connections to DC01\nws05_rpc = ['evt-00155', 'evt-00156', 'evt-00181', 'evt-00183']\nfor eid in ws05_rpc:\n    findings.add(eid)\n\n# 8. WS-06 WMI activity and MOF compilation\nws06_wmi = [\n    'evt-01326', 'evt-01455', 'evt-02377', 'evt-02443', # WmiPrvSE creations\n    'evt-02487', 'evt-02492', 'evt-02495', 'evt-02499', 'evt-02503', 'evt-02505', 'evt-02507', 'evt-02509', 'evt-02511', 'evt-02513' # MOF compilations\n]\nfor eid in ws06_wmi:\n    findings.add(eid)\n\n# 9. WS-06 network connections to DC01 (Sysmon 3)\nws06_sysmon3 = ['evt-01910', 'evt-01911', 'evt-01912', 'evt-01913', 'evt-01945']\nfor eid in ws06_sysmon3:\n    findings.add(eid)\n\n# 10. WS-06 WFP connections to DC01 (5156)\nws06_wfp5156 = [\n    'evt-01614', 'evt-01616', 'evt-01618', 'evt-01622', 'evt-01624',\n    'evt-01759', 'evt-01760', 'evt-01761', 'evt-01762', 'evt-01763', 'evt-01764',\n    'evt-01780', 'evt-01781', 'evt-01785', 'evt-01789', 'evt-01792', 'evt-01817'\n]\nfor eid in ws06_wfp5156:\n    findings.add(eid)\n\n# 11. WS-06 DNS queries (22)\nfindings.add('evt-01589')\nfindings.add('evt-02043')\n\n# 12. DC01 auth / share access from WS-06\ndc01_auth = [\n    'evt-01765', # 4769\n    'evt-01766', 'evt-01782', 'evt-01786', # 4624\n    'evt-01767', 'evt-01783', 'evt-01787', # 4627\n    'evt-01768', # 5140 IPC$\n    'evt-01769', 'evt-01774', 'evt-01779', 'evt-01790', # 5145\n    'evt-01784' # 4634\n]\nfor eid in dc01_auth:\n    findings.add(eid)\n\n# 13. DC01 remote SAMR query auditing\ndc01_samr = [\n    'evt-01770', 'evt-01771', 'evt-01775', 'evt-01776' # 4661\n]\nfor eid in dc01_samr:\n    findings.add(eid)\n# Event 16968 (remote SAM calls)\ncur.execute('SELECT event_id FROM events WHERE host=\\'DC01.corp.example\\' AND event_code=16968')\nfor r in cur.fetchall(): findings.add(r[0])\n\nfindings_list = sorted(list(findings))\nprint(f'Total malicious events identified: {len(findings_list)}')\nwith open('/root/findings.json', 'w') as f:\n    json.dump(findings_list, f)\n\"\n"]
