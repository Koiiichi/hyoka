[127.402209, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\nmalicious_guids = [\n    '{b34bc01c-2f95-5f69-5f01-000000000900}',\n    '{b34bc01c-34db-5f69-7701-000000000900}',\n    '{b34bc01c-34db-5f69-7801-000000000900}',\n    '{b34bc01c-369c-5f69-7901-000000000900}',\n    '{b34bc01c-369c-5f69-7a01-000000000900}'\n]\nplaceholders = ','.join('?' for _ in malicious_guids)\ncur.execute(f'SELECT event_id, event_code, image FROM events WHERE process_guid IN ({placeholders})', malicious_guids)\nrows = cur.fetchall()\nprint(f'Total events directly linked: {len(rows)}')\nfor row in sorted(rows, key=lambda x: x[0])[:20]:\n    print(row)\n\"\n"]
