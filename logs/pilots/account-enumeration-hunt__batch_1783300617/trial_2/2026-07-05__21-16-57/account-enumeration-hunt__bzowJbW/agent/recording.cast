[334.466243, "i", "python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncur = conn.cursor()\neids = [\n    'evt-01614', 'evt-01616', 'evt-01618', 'evt-01622', 'evt-01624',\n    'evt-01759', 'evt-01760', 'evt-01761', 'evt-01762', 'evt-01763', 'evt-01764',\n    'evt-01780', 'evt-01781', 'evt-01785', 'evt-01789', 'evt-01792', 'evt-01817'\n]\ncur.execute('SELECT event_id, image, message FROM events WHERE event_id IN ({})'.format(','.join('?'*len(eids))), eids)\nfor eid, img, msg in cur.fetchall():\n    print(f'{eid} | {img} | {msg[:100].replace(\"\\\\n\", \" \") if msg else \"\"}')\n\"\n"]
