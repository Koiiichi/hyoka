[331.029731, "i", "python3 -c '\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"\"\"\nSELECT event_id, timestamp, event_code, user, target_user, message \nFROM events \nWHERE host=\"WS-05.corp.example\" \n  AND channel=\"security\"\n  AND ( (timestamp BETWEEN \"2026-05-06T00:00:07\" AND \"2026-05-06T00:00:12\") \n     OR (timestamp BETWEEN \"2026-05-06T00:07:36\" AND \"2026-05-06T00:07:41\") )\nORDER BY timestamp;\"\"\")\n\nfor r in cur.fetchall():\n    print(f\"{r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5][:80]}\")\n'\n"]
