[37.476557, "i", "python3 -c '\nimport sqlite3, re, base64\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\ncur = conn.cursor()\ncur.execute(\"SELECT message FROM events WHERE event_code=800 AND message LIKE \\\"%-enc%\\\"\")\nfor row in cur.fetchall():\n    msg = row[0]\n    match = re.search(r\"-enc\\s+([A-Za-z0-9+/=\\s]+)\", msg)\n    if match:\n        b64 = match.group(1).replace(\"\\n\", \"\").replace(\" \", \"\").strip()\n        print(\"Length:\", len(b64))\n        try:\n            dec = base64.b64decode(b64 + \"=\" * (4 - len(b64) % 4)).decode(\"utf-16-le\", errors=\"ignore\")\n            print(dec[:400])\n        except Exception as e:\n            print(e)\n'\n"]
