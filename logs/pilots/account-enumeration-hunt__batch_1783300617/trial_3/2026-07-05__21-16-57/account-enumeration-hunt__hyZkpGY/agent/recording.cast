[294.018231, "i", "python3 -c '\nimport sqlite3, json\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nwith open(\"/tmp/ids.json\") as f:\n    mal_ids = set(json.load(f))\n\ncur.execute(\"SELECT * FROM events WHERE host=\\\"WS-05.corp.example\\\"\")\nrows = cur.fetchall()\n\nbenign_by_code = {}\nfor r in rows:\n    id = r[\"event_id\"]\n    if id not in mal_ids:\n        code = r[\"event_code\"]\n        benign_by_code[code] = benign_by_code.get(code, 0) + 1\n        # Print first few of each benign code\n        if benign_by_code[code] <= 3:\n            print(f\"Benign Event {id} (Code {code}): img={r[\\\"image\\\"]}, target_object={r[\\\"target_object\\\"]}, ts={r[\\\"timestamp\\\"]}, msg={str(r[\\\"message\\\"])[:100]}\")\n\nprint(\"Benign counts by code:\", benign_by_code)\n'\n"]
