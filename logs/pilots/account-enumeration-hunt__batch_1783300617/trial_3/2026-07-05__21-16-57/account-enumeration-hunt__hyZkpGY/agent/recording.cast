[256.171524, "i", "python3 -c '\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Let us categorize the events on WS-05\ncur.execute(\"SELECT * FROM events WHERE host=\\\"WS-05.corp.example\\\"\")\nrows = cur.fetchall()\n\nmalicious_ids = []\n\nfor r in rows:\n    id = r[\"event_id\"]\n    code = r[\"event_code\"]\n    img = r[\"image\"] or \"\"\n    pimg = r[\"parent_image\"] or \"\"\n    pguid = r[\"process_guid\"] or \"\"\n    tgt = r[\"target_image\"] or \"\"\n    user = r[\"user\"] or \"\"\n    msg = r[\"message\"] or \"\"\n    \n    # 1. PowerShell operational logs on WS-05 are all part of the C2 loop\n    if code in (800, 4103):\n        malicious_ids.append(id)\n        continue\n        \n    # 2. Any event where powershell.exe is the active image or parent of malicious actions\n    if \"powershell.exe\" in img or \"powershell.exe\" in pimg or pguid == \"{b34bc01c-2f95-5f69-5f01-000000000900}\":\n        malicious_ids.append(id)\n        continue\n        \n    # 3. Any net.exe / net1.exe process creations, image loads, pipe connections, terminations, and process accesses\n    if \"net.exe\" in img or \"net1.exe\" in img or \"net.exe\" in pimg or \"net1.exe\" in pimg:\n        malicious_ids.append(id)\n        continue\n        \n    # 4. Security audit events tracking the execution of net.exe / net1.exe\n    # We know that the attacker ran: \"net localgroup Administrators\" and \"net user\"\n    # Let\\'s look at Security events (4688, 4689, 4799, 4656, 4658, 4663, 4690) that occur during the execution windows of these two commands.\n    # The first execution is from 00:00:08 to 00:00:11.\n    # The second execution is from 00:07:37 to 00:07:40.\n    if code in (4688, 4689, 4799, 4656, 4658, 4663, 4690):\n        # check if it falls within the execution times\n        ts = r[\"timestamp\"]\n        if (\"2026-05-06T00:00:08\" <= ts <= \"2026-05-06T00:00:11\") or (\"2026-05-06T00:07:37\" <= ts <= \"2026-05-06T00:07:40\"):\n            malicious_ids.append(id)\n            continue\n\nprint(\"Found malicious events count:\", len(malicious_ids))\n'\n"]
