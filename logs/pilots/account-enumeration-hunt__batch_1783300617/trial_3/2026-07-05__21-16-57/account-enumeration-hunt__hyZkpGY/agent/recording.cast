[67.044981, "i", "python3 -c '\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\ncur.execute(\"SELECT * FROM events WHERE event_code=7 AND image LIKE \\\"%sppsvc%\\\" LIMIT 5\")\nfor row in cur.fetchall():\n    print({k: row[k] for k in row.keys() if row[k] is not None and row[k] != \"\"})\n'\n"]
