[145.708595, "i", "python3 -c '\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\ncur = conn.cursor()\ncur.execute(\"SELECT message FROM events WHERE host=\\\"WS-05.corp.example\\\" AND event_code=800\")\ncmds = set()\nfor row in cur.fetchall():\n    msg = row[0]\n    if \"Pipeline execution details for command line:\" in msg:\n        parts = msg.split(\"Pipeline execution details for command line:\")\n        if len(parts) > 1:\n            cmd_part = parts[1].split(\"\\n.\")[0].strip()\n            if \"HostApplication\" not in cmd_part:\n                cmds.add(cmd_part)\nfor c in sorted(cmds):\n    print(c)\n'\n"]
