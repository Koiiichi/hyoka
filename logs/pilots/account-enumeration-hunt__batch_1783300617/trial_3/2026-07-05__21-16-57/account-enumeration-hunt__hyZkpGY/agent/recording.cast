[339.193956, "o", "evt-00172|A new process has been created.\r\r\n\r\r\nCreator Subject:\r\r\n\tSecurity ID:\t\tS-1-5-21-4228717743-1032521047-1810997296-1104\r\r\n\tAccount Name:\t\tm.ward\r\r\n\tAccount Domain:\t\tCORP\r\r\n\tLogon ID:\t\t0x10A7DF\r\r\n\r\r\nTarget Subject:\r\r\n\tSecurity ID:\t\tS-1-0-0\r\r\n\tAccount Name:\t\t-\r\r\n\tAccount Domain:\t\t-\r\r\n\tLogon ID:\t\t0x0\r\r\n\r\r\nProcess Information:\r\r\n\tNew Process ID:\t\t0x1744\r\r\n\tNew Process Name:\tC:\\Windows\\System32\\net.exe\r\r\n\tToken Elevation Type:\t%%1937\r\r\n\tMandatory Label:\t\tS-1-16-12288\r\r\n\tCreator Process ID:\t0x1d20\r\r\n\tCreator Process Name:\tC:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\r\r\n\tProcess Command Line:\t\"C:\\windows\\system32\\net.exe\" localgroup Administrators\r\r\n\r\r\nToken Elevation Type indicates the type of token that was assigned to the new process in accordance with User Account Control policy.\r\r\n\r\r\nType 1 is a full token with no privileges removed or groups disabled.  A full token is only used if User Account Control is disabled or if the user is the built-in Administrator account or a service account.\r\r\n\r\r\nType 2 is an elevated token with no privileges removed or groups disabled.  An elevated token is used when User Account Control is enabled and the user chooses to start the program using Run as administrator.  An elevated token is also used when an application is configured to always require administrative privilege or to always require maximum privilege, and the user is a member of the Administrators group.\r\r\n\r\r\nType 3 is a limited token with administrative privileges removed and administrative groups disabled.  The limited token is used when User Account Control is enabled, the application does not require administrative privilege, and the user does not choose to start the program using Run as administrator.\r\nevt-00173|A new process has been created.\r\r\n\r\r\nCreator Subject:\r\r\n\tSecurity ID:\t\tS-1-5-21-4228717743-1032521047-1810997296-1104\r\r\n\tAccount Name:\t\tm.ward\r\r\n\tAccount Domain:\t\tCORP\r\r\n\tLogon ID:\t\t0x10A7DF\r\r\n\r\r\nTarget Subject:\r\r\n\tSecurity ID:\t\tS-1-0-0\r\r\n\tAccount Name:\t\t-\r\r\n\tAccount Domain:\t\t-\r\r\n\tLogon ID:\t\t0x0\r\r\n\r\r\nProcess Information:\r\r\n\tNew Process ID:\t\t0x1f68\r\r\n\tNew Process Name:\tC:\\Windows\\System32\\net1.exe\r\r\n\tToken Elevation Type:\t%%1937\r\r\n\tMandatory Label:\t\tS-1-16-12288\r\r\n\tCreator Process ID:\t0x1744\r\r\n\tCreator Process Name:\tC:\\Windows\\System32\\net.exe\r\r\n\tProcess Command Line:\tC:\\windows\\system32\\net1 localgroup Administrators\r\r\n\r\r\nToken Elevation Type indicates the type of token that was assigned to the new process in accordance with User Account Control policy.\r\r\n\r\r\nType 1 is a full token with no privileges removed or groups disabled.  A full token is only used if User Account Control is disabled or if the user is the built-in Administrator account or a service account.\r\r\n\r\r\nType 2 is an elevated token with no privileges removed or groups disabled.  An elevated token is used when User Account Control is enabled and the user chooses to start the program using Run as administrator.  An elevated token is also used when an application is configured to always require administrative privilege or to always require maximum privilege, and the user is a member of the Administrators group.\r\r\n\r\r\nType 3 is a limited token with administrative privileges removed and administrative groups disabled.  The limited token is used when User Account Control is enabled, the application does not require administrative privilege, and the user does not choose to start the program using Run as administrator.\r\n"]
[339.195423, "o", "\u001b[?2004hroot@f91035219499:~# "]
[350.742868, "i", "cat << 'EOF' > /tmp/generate_findings.py\nimport sqlite3\nimport json\n\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host='WS-05.corp.example'\")\nrows = cur.fetchall()\n\nmalicious_ids = set()\n\n# Malicious Process GUID of powershell.exe\nps_guid = \"{b34bc01c-2f95-5f69-5f01-000000000900}\"\n\n# Explicit lists of verified malicious events\n# 1. PowerShell operational event codes on WS-05\n# 2. Sysmon events belonging to powershell.exe, net.exe, net1.exe\n# 3. Security events for process creation/termination and localgroup/user queries\nfor r in rows:\n    id = r[\"event_id\"]\n    code = r[\"event_code\"]\n    img = r[\"image\"] or \"\"\n    pimg = r[\"parent_image\"] or \"\"\n    pguid = r[\"process_guid\"] or \"\"\n    ts = r[\"timestamp\"]\n    channel = r[\"channel\"] or \"\"\n    \n    # PowerShell logs are 100% malicious\n    if code in (800, 4103):\n        malicious_ids.add(id)\n        continue\n        \n    # Sysmon events for powershell.exe\n    if \"powershell.exe\" in img or pguid == ps_guid:\n        malicious_ids.add(id)\n        continue\n        \n    # Sysmon events for net.exe and net1.exe\n    if \"net.exe\" in img or \"net1.exe\" in img or \"net.exe\" in pimg or \"net1.exe\" in pimg:\n        # Exclude any svchost image loads or other benign stuff\n        if \"svchost.exe\" not in img:\n            malicious_ids.add(id)\n            continue\n            \n    # Security Audit Events for net.exe and net1.exe executions\n    if channel == \"security\" and code in (4688, 4689, 4799, 4656, 4658, 4663, 4690):\n        # First net.exe/net1.exe window\n        if \"2026-05-06T00:00:09\" <= ts <= \"2026-05-06T00:00:11\":\n            malicious_ids.add(id)\n            continue\n        # Second net.exe/net1.exe window\n        if \"2026-05-06T00:07:38\" <= ts <= \"2026-05-06T00:07:40\":\n            malicious_ids.add(id)\n            continue\n\n# Let's print out what we found\nprint(f\"Found {len(malicious_ids)} malicious event IDs\")\n\n# Write findings to /root/findings.json\nwith open(\"/root/findings.json\", \"w\") as f:\n    json.dump(sorted(list(malicious_ids)), f, indent=2)\nprint(\"Saved findings to /root/findings.json\")\nEOF\n"]
