[266.675254, "i", "cat << 'EOF' > /tmp/analyze.py\nimport sqlite3\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\ncur.execute(\"SELECT * FROM events WHERE host='WS-05.corp.example'\")\nrows = cur.fetchall()\n\nmalicious_ids = []\n\nfor r in rows:\n    id = r[\"event_id\"]\n    code = r[\"event_code\"]\n    img = r[\"image\"] or \"\"\n    pimg = r[\"parent_image\"] or \"\"\n    pguid = r[\"process_guid\"] or \"\"\n    ts = r[\"timestamp\"]\n    \n    # 1. PowerShell operational logs on WS-05\n    if code in (800, 4103):\n        malicious_ids.append(id)\n        continue\n        \n    # 2. Any event where powershell.exe is the active image or parent of malicious actions\n    if \"powershell.exe\" in img or \"powershell.exe\" in pimg or pguid == \"{b34bc01c-2f95-5f69-5f01-000000000900}\":\n        malicious_ids.append(id)\n        continue\n        \n    # 3. Any net.exe / net1.exe process creations, image loads, pipe connections, terminations, and process accesses\n    if \"net.exe\" in img or \"net1.exe\" in img or \"net.exe\" in pimg or \"net1.exe\" in pimg:\n        malicious_ids.append(id)\n        continue\n        \n    # 4. Security audit events tracking the execution of net.exe / net1.exe\n    if code in (4688, 4689, 4799, 4656, 4658, 4663, 4690):\n        if (\"2026-05-06T00:00:07\" <= ts <= \"2026-05-06T00:00:12\") or (\"2026-05-06T00:07:36\" <= ts <= \"2026-05-06T00:07:41\"):\n            malicious_ids.append(id)\n            continue\n\nprint(\"Found malicious events count:\", len(malicious_ids))\nimport json\nwith open(\"/tmp/ids.json\", \"w\") as f:\n    json.dump(sorted(malicious_ids), f)\nEOF\n"]
