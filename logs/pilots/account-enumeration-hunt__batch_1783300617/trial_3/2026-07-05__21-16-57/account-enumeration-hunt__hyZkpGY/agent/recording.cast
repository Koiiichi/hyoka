[131.002634, "i", "python3 -c '\nimport sqlite3, re\nconn = sqlite3.connect(\"/root/data/eventlogs.db\")\ncur = conn.cursor()\ncur.execute(\"SELECT message FROM events WHERE host=\\\"WS-05.corp.example\\\" AND event_code=800\")\ncmds = set()\nfor row in cur.fetchall():\n    msg = row[0]\n    match = re.search(r\"Pipeline execution details for command line:\\\\s*(.*?)\\\\s*\\\\n\\\\s*\\\\.\\\\s*\\\\n\\\\s*Context Information\", msg, re.DOTALL)\n    if match:\n        cmds.add(match.group(1).strip())\n    else:\n        first_line = msg.split(\"\\\\n\")[0]\n        cmds.add(first_line)\nfor c in sorted(cmds):\n    print(c)\n'\n"]
[131.002966, "o", "python3 -c '\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3, re\r\n\u001b[?2004l\r"]
