[317.834266, "i", "python3 -c \"\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/root/data/eventlogs.db')\ncursor = conn.cursor()\n\nquery = \\\"\\\"\\\"\nSELECT event_id FROM events \nWHERE host = 'WS-05.corp.example' \nAND (\n  event_code IN (800, 4103, 4799) \n  OR (event_code IN (1, 5, 4688, 4689) AND (image LIKE '%net.exe%' OR image LIKE '%net1.exe%' OR command_line LIKE '%net%' OR message LIKE '%net.exe%' OR message LIKE '%net1.exe%'))\n  OR (event_code = 7 AND NOT image LIKE '%svchost%')\n  OR (event_code IN (12, 13) AND image LIKE '%powershell.exe%')\n  OR (event_code IN (17, 18) AND (image LIKE '%powershell.exe%' OR image LIKE '%net1.exe%'))\n  OR (event_code = 10 AND NOT (image LIKE '%svchost.exe%' AND target_image LIKE '%svchost.exe%'))\n  OR (event_code IN (4656, 4658, 4663, 4690))\n);\n\\\"\\\"\\\"\n\ncursor.execute(query)\nrows = cursor.fetchall()\nevent_ids = [row[0] for row in rows]\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(event_ids, f)\n\nprint(f'Wrote {len(event_ids)} event IDs to /root/findings.json')\n\"\n"]
