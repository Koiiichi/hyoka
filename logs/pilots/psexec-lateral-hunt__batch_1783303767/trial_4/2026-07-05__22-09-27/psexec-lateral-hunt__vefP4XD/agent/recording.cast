[284.274838, "o", "    \"evt-01229\", # Security 5156 outbound WFP connection allowed\r\n\u001b[?2004l\r\u001b[?2004h>     \"evt-01232\", # Security 5156 outbound WFP connection allowed\r\n\u001b[?2004l\r\u001b[?2004h>     \"evt-01236\", # Security 5156 outbound WFP connection allowed\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # --- DC01 (Kerberos Ticket Granting) ---\r\n\u001b[?2004l\r\u001b[?2004h>     \"evt-01222\", # Security 4769 Kerberos service ticket request for target WS-06$\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # --- WS-06 (Target Machine) ---\r\n\u001b[?2004l\r\u001b[?2004h>     \"evt-01205\", # Security 5156 inbound WFP connection allowed\r\n\u001b[?2004l\r\u001b[?2004h>     \"evt-01206\", # Security 5156 inbound WFP connection allowed\r\n\u001b[?2004l\r\u001b[?2004h>     \"evt-01207\", # Security 5156 inbound WFP connection allowed\r\n\u001b[?2004l\r\u001b[?2004h> "]
