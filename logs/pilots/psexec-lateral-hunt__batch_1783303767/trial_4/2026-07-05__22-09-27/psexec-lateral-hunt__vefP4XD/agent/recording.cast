[284.270683, "i", "cat << 'EOF' > /tmp/gen_findings.py\nimport json\n\nevents = [\n    # --- WS-05 (Attacker's Pivot) ---\n    \"evt-01295\", # PowerShell 800 lateral movement trigger command \"Invoke-PsExec\"\n    \"evt-01361\", # PowerShell 4103 lateral movement operational log\n    \"evt-01363\", # PowerShell 4103 lateral movement operational log\n    \"evt-01365\", # Sysmon 22 DNS query for lateral movement\n    \"evt-01367\", # Sysmon 3 outbound TCP connection to target port 135\n    \"evt-01370\", # Sysmon 3 outbound TCP connection to target port 49726\n    \"evt-01372\", # Sysmon 3 outbound Kerberos authentication request to DC\n    \"evt-01225\", # Security 5156 outbound WFP connection allowed\n    \"evt-01229\", # Security 5156 outbound WFP connection allowed\n    \"evt-01232\", # Security 5156 outbound WFP connection allowed\n    \"evt-01236\", # Security 5156 outbound WFP connection allowed\n\n    # --- DC01 (Kerberos Ticket Granting) ---\n    \"evt-01222\", # Security 4769 Kerberos service ticket request for target WS-06$\n\n    # --- WS-06 (Target Machine) ---\n    \"evt-01205\", # Security 5156 inbound WFP connection allowed\n    \"evt-01206\", # Security 5156 inbound WFP connection allowed\n    \"evt-01207\", # Security 5156 inbound WFP connection allowed\n    \"evt-01209\", # Security 4624 remote network logon from WS-05\n    \"evt-01213\", # Security 4697 Service installation \"Updater\"\n    \"evt-01251\", # System 7045 Service installation \"Updater\"\n    \"evt-01253\", # System 7009 Service startup timeout\n    \"evt-01254\", # System 7000 Service startup failure\n    \"evt-01364\", # Sysmon 3 inbound RPC connection from WS-05\n    \"evt-01366\", # Sysmon 3 inbound SCM connection from WS-05\n    \"evt-01057\", # Sysmon 1 cmd.exe spawned by services.exe\n    \"evt-01226\", # Security 4688 cmd.exe spawned by services.exe\n    \"evt-01087\", # Sysmon 1 conhost.exe spawned by cmd.exe\n    \"evt-01240\", # Security 4688 conhost.exe spawned by cmd.exe\n    \"evt-01238\", # Security 4688 powershell.exe stager execution\n    \"evt-01827\", # PowerShell 4104 Script block logging\n    \"evt-02513\", # Sysmon 3 outbound TCP C2 connection to 10.10.10.5:80\n    \"evt-02367\", # Security 5156 outbound WFP C2 connection allowed\n    \"evt-02901\", # Sysmon 1 whoami.exe spawned by powershell.exe\n    \"evt-02955\", # Security 4688 whoami.exe spawned by powershell.exe\n    \"evt-02902\"  # Sysmon 10 ProcessAccess to whoami.exe\n]\n\n# Ensure no duplicates and sort\nevents = sorted(list(set(events)))\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(events, f)\n\nprint(f\"Successfully wrote {len(events)} events to findings.json\")\nEOF\n"]
