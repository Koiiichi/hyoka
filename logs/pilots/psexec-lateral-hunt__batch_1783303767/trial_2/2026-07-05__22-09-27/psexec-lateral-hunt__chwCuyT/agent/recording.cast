[323.436714, "o", "\u001b[?2004h> for evt in ws05_events:\r\n\u001b[?2004l\r\u001b[?2004h>     event_ids.add(evt)\r\n\u001b[?2004l\r"]
[323.436792, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
