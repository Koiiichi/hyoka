[323.432759, "i", "cat << 'EOF' > /tmp/build_findings.py\nimport json\n\nevent_ids = set()\n\n# Read event IDs from files\nfor filename in ['/tmp/host_ws06.txt', '/tmp/proc_powershell.txt', '/tmp/proc_cmd.txt', '/tmp/proc_whoami.txt']:\n    with open(filename, 'r') as f:\n        for line in f:\n            evt = line.strip()\n            if evt:\n                event_ids.add(evt)\n\n# Add individual specific events on WS-05.corp.example\nws05_events = [\n    'evt-01221', 'evt-01223', 'evt-01225', 'evt-01227', 'evt-01229', \n    'evt-01231', 'evt-01232', 'evt-01234', 'evt-01236', 'evt-01282', \n    'evt-01295', 'evt-01361', 'evt-01363', 'evt-01365', 'evt-01367', \n    'evt-01370', 'evt-01372'\n]\nfor evt in ws05_events:\n    event_ids.add(evt)\n\n# Add individual specific events on DC01.corp.example\ndc01_events = [\n    'evt-01218', 'evt-01219', 'evt-01222'\n]\nfor evt in dc01_events:\n    event_ids.add(evt)\n\n# Add individual specific events on WS-06.corp.example (not in the process_guid sets)\nws06_events = [\n    'evt-01206', 'evt-01207', 'evt-01364', 'evt-01366', # inbound net\n    'evt-01208', 'evt-01209', 'evt-01210', 'evt-03552', # logon/logoff\n    'evt-01211', 'evt-01212', 'evt-01213', 'evt-01214', # service creation\n    'evt-01251', 'evt-01253', 'evt-01254',             # service creation system\n    'evt-01827',                                         # powershell script block\n    'evt-01240'                                          # conhost\n]\nfor evt in ws06_events:\n    event_ids.add(evt)\n\noutput_list = sorted(list(event_ids))\nprint(f\"Total unique malicious events: {len(output_list)}\")\n\nwith open('/root/findings.json', 'w') as f:\n    json.dump(output_list, f)\nEOF\n"]
[323.434661, "o", "cat << 'EOF' > /tmp/build_findings.py\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> event_ids = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Read event IDs from files\r\n\u001b[?2004l\r\u001b[?2004h"]
[323.434759, "o", "> for filename in ['/tmp/host_ws06.txt', '/tmp/proc_powershell.txt', '/tmp/proc_cmd.txt', '/tmp/proc_whoami.txt']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[323.435431, "o", "    with open(filename, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>             evt = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>             if evt:\r\n\u001b[?2004l\r\u001b[?2004h>                 event_ids.add(evt)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[323.435559, "o", "> "]
